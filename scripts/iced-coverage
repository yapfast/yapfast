#!/usr/bin/env python3
"""Checks that the iced interface's task list ports every Slint component,
that no two tasks own the same files, and that every file of the writers'
crates has its task.

Usage: scripts/iced-coverage [--list] [--owners]

Reads each `component Name` of ui/*.slint and ui/yapfast/*.slint and looks
for `Name` (in backticks) in docs/iced/tasks.md and docs/iced/tasks/*.md.
Prints the count, and each component no task names; with --list, also which
task names each. Then reads each task's **Owns:** paths (every `{a,b}`
expanded) and prints each path two tasks own, or one owns inside another's
folder. Last, it walks the files of crates/anomi-* but anomi-app (whose
spine the integration tasks share in turn) and prints each file no task
owns, or more than one does. A task owns a file it names, a file inside a
folder it names (`x/`), the folder `x/` of a file `x.rs` it names, and,
with a view-model module `anomi-vm/src/<path>.rs` (or a folder
`anomi-vm/src/<path>/`), its fixtures `anomi-vm/src/fixtures/<path>.rs` and
its screens crate's tests `tests/areas/<name>.rs` (docs/iced/tasks.md); with
--owners, it prints each file's owner. Exits non-zero when a component is
missing (a component upstream adds needs a task) or a path is owned twice
or not at all.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COMPONENT = re.compile(r"^\s*(?:export\s+)?component\s+([A-Za-z0-9_-]+)", re.M)
TASK = re.compile(r"^### ([A-Z]\d+) ", re.M)
# Files of the writers' crates no task owns on purpose, and why.
ELSEWHERE = {
    "anomi-screens/tests/patterns.rs": "the task that moves the iced pin (iced-notes.md)",
}
# Which screens crate tests a view-model folder's modules.
TESTED_IN = {"chat": "anomi-chat", "people": "anomi-people", "voice": "anomi-voice",
             "settings": "anomi-settings"}


def components():
    found = []
    for path in sorted([*(ROOT / "ui").glob("*.slint"), *(ROOT / "ui/yapfast").glob("*.slint")]):
        source = path.read_text(encoding="utf-8")
        for match in COMPONENT.finditer(source):
            line = source.count("\n", 0, match.start()) + 1
            found.append((match[1], f"{path.relative_to(ROOT)}:{line}"))
    return found


def tasks():
    """Each task's id and text, from every task file."""
    texts = {}
    for path in [ROOT / "docs/iced/tasks.md", *sorted((ROOT / "docs/iced/tasks").glob("*.md"))]:
        source = path.read_text(encoding="utf-8")
        starts = list(TASK.finditer(source))
        for index, start in enumerate(starts):
            end = starts[index + 1].start() if index + 1 < len(starts) else len(source)
            texts[start[1]] = source[start.start():end]
    return texts


def expand(code):
    """`a/{b,c}/{d,e}.rs` as its four paths."""
    braces = re.search(r"\{([^{}]*)\}", code)
    if not braces:
        return [code]
    paths = []
    for part in braces[1].split(","):
        paths += expand(code[:braces.start()] + part.strip() + code[braces.end():])
    return paths


def owned_paths(text):
    """The paths a task's **Owns:** line names, with every `{a,b}` expanded."""
    found = re.search(r"\*\*Owns:\*\* (.*)", text)
    paths = []
    for code in re.findall(r"`([^`]+)`", found[1] if found else ""):
        if "/" in code:
            paths += expand(code)
    return paths


def overlaps(listed):
    """Each path two tasks own, or one owns inside another's folder."""
    owners = {}
    for task, text in listed.items():
        for path in owned_paths(text):
            owners.setdefault(path, set()).add(task)
    clashes = []
    for path, tasks_owning in sorted(owners.items()):
        if len(tasks_owning) > 1:
            clashes.append(f"{path} is owned by {', '.join(sorted(tasks_owning))}")
        for folder, folder_owners in owners.items():
            inside = folder.endswith("/") and path != folder and path.startswith(folder)
            if inside and not tasks_owning <= folder_owners:
                clashes.append(f"{path} ({', '.join(sorted(tasks_owning))}) is inside {folder} "
                               f"({', '.join(sorted(folder_owners))})")
    return clashes


def implied(path):
    """What owning a view-model module brings: its fixtures and its tests."""
    match = re.fullmatch(r"anomi-vm/src/(.+?)(?:\.rs|/)", path)
    if not match or match[1].startswith("fixtures") or match[1] == "lib":
        return []
    module = match[1].removesuffix("/mod")
    paths = [f"anomi-vm/src/fixtures/{module}.rs"]
    folder, _, name = module.rpartition("/")
    crate = TESTED_IN.get(folder.split("/")[0], "anomi-screens")
    if name != "mod":
        paths.append(f"{crate}/tests/areas/{name or module}.rs")
    return paths


def unowned(listed):
    """Each file of the writers' crates owned by no task, or by several."""
    owns = []
    for task, text in listed.items():
        for path in owned_paths(text):
            owns.append((path, task))
            if path.endswith(".rs"):
                owns.append((path[:-3] + "/", task))
            owns += [(extra, task) for extra in implied(path)]
    problems, owners_of = [], {}
    crates = ROOT / "crates"
    for file in sorted(crates.glob("anomi-*/**/*")):
        relative = file.relative_to(crates).as_posix()
        if not file.is_file() or relative.startswith("anomi-app/"):
            continue
        if relative in ELSEWHERE:
            owners_of[relative] = {ELSEWHERE[relative]}
            continue
        owners = {task for path, task in owns
                  if path == relative or (path.endswith("/") and relative.startswith(path))}
        owners_of[relative] = owners
        if not owners:
            problems.append(f"no task owns {relative}")
        elif len(owners) > 1:
            problems.append(f"{relative} is owned by {', '.join(sorted(owners))}")
    return problems, owners_of


def main():
    listed = tasks()
    missing = []
    for name, place in components():
        owners = [task for task, text in listed.items() if f"`{name}`" in text]
        if not owners:
            missing.append((name, place))
        elif "--list" in sys.argv:
            print(f"{name} ({place}): {', '.join(owners)}")
    total = len(components())
    print(f"{total - len(missing)} of {total} Slint components are in a task; {len(listed)} tasks.")
    for name, place in missing:
        print(f"no task ports {name} ({place})")
    clashes = overlaps(listed)
    for clash in clashes:
        print(f"owned twice: {clash}")
    problems, owners_of = unowned(listed)
    if "--owners" in sys.argv:
        for file, owners in owners_of.items():
            print(f"{file}: {', '.join(sorted(owners)) or '-'}")
    for problem in problems:
        print(problem)
    print(f"{len(owners_of)} files in the writers' crates, each with one owner"
          if not problems else f"{len(problems)} files without exactly one owner")
    return 1 if missing or clashes or problems else 0


sys.exit(main())
