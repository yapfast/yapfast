#!/usr/bin/env bash
# Builds Yapfast for this Mac and puts it in target/dist/macos as Yapfast.app,
# ready to run, plus a zip of it to send to someone.
#
#   scripts/build-macos              a release build, the one people run
#   scripts/build-macos --fast       the fast profile: symbols, incremental
#   scripts/build-macos --dmg        also make a disk image
#   scripts/build-macos --full       with Matrix as well as Discord
#
# The app is signed ad hoc, so it runs on the machine that built it and, once
# Gatekeeper is got past, on others. A download people can open without a
# warning needs a Developer ID and notarisation, which costs $99 a year; see
# docs/macos.md.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

profile=release
flags=(--release)
dmg=no
features=desktop,discord
while (($#)); do
    case "$1" in
        --fast) profile=fast; flags=(--profile fast); shift ;;
        --dmg) dmg=yes; shift ;;
        --full) features=desktop,discord,matrix; shift ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done

# The build scripts read the libwebrtc archive from one place, rather than each
# downloading its own copy and racing.
scripts/fetch-libwebrtc-mac
# shellcheck disable=SC1091
source scripts/macos-env.sh

echo "=== cargo build --features $features ($profile)"
# `--locked` keeps Cargo.lock's versions, which is what the Linux and Windows
# releases are built from.
cargo build "${flags[@]}" --locked --no-default-features --features "$features"

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
arch=$(uname -m)
dist="target/dist/macos"
app="$dist/Yapfast.app"
binary="target/$profile/yapfast"

echo "=== packing $app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/Yapfast"
cp packaging/macos/AppIcon.icns "$app/Contents/Resources/AppIcon.icns"
sed "s/@VERSION@/$version/g" packaging/macos/Info.plist >"$app/Contents/Info.plist"
printf 'APPL????' >"$app/Contents/PkgInfo"

# Ad hoc, without the hardened runtime: it would refuse the microphone and the
# camera until each had an entitlement, and an ad-hoc signature can't have the
# ones that matter for notarisation anyway.
echo "=== signing ad hoc"
codesign --force --timestamp=none --sign - "$app"
codesign --verify --verbose=1 "$app" 2>&1 | tail -1

name="Yapfast-$version-macos-$arch"
echo "=== zipping $dist/$name.zip"
rm -f "$dist/$name.zip"
ditto -c -k --keepParent "$app" "$dist/$name.zip"

if [[ $dmg == yes ]]; then
    echo "=== making $dist/$name.dmg"
    rm -f "$dist/$name.dmg"
    stage="$dist/.dmg"
    rm -rf "$stage"; mkdir -p "$stage"
    cp -R "$app" "$stage/"
    ln -sf /Applications "$stage/Applications"
    hdiutil create -quiet -volname Yapfast -srcfolder "$stage" -ov -format UDZO "$dist/$name.dmg"
    rm -rf "$stage"
fi

sha256sum "$dist/$name.zip" >"$dist/$name.zip.sha256" 2>/dev/null ||
    shasum -a 256 "$dist/$name.zip" >"$dist/$name.zip.sha256"

echo
echo "built:  $app"
echo "        $dist/$name.zip"
echo "run it: open $app"
