#!/usr/bin/env python3
"""Compares the text the code marks for translation with lang/*.po.

Usage: scripts/check-translations [--unused]

Lists, per language, the texts of `@tr("…")` in ui/ and of `tr!("…")`,
`trn!("…", "…", n)` and `yapfast_lang::text("…")` in Rust that the language's
file doesn't translate; such text shows in English. English is the code's own
text, so its file is checked only for the texts that name Yapfast, which it
gives this fork's name. --unused also lists the
entries no such text matches: most are stale, but text from a table, which
`yapfast_lang::text(entry.name)` translates, is found only in the file.
Exits non-zero when a text lacks a translation.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STRING = r'"((?:[^"\\]|\\.)*)"'
SLINT = re.compile(
    r"@tr\(\s*(?:" + STRING + r"\s*=>\s*)?" + STRING + r"(?:\s*\|\s*" + STRING + r")?"
)
RUST = re.compile(r"\b(?:tr!|trn!|yapfast_lang::text|lang::text|text_in\(\s*\"[^\"]*\",)\(?\s*" + STRING)


def plain(text, rust):
    """A string literal without its escapes."""
    if rust:
        # A backslash at a line's end joins the next line, less its indent.
        text = re.sub(r"\\\n\s*", "", text)
    escapes = {"n": "\n", "t": "\t", '"': '"', "\\": "\\"}
    return re.sub(r"\\(.)", lambda found: escapes.get(found[1], found[1]), text)


def marked():
    """Each text marked in the code, with where it first is."""
    texts = {}
    for path in sorted((ROOT / "ui").rglob("*.slint")):
        source = path.read_text(encoding="utf-8")
        for found in SLINT.finditer(source):
            line = source.count("\n", 0, found.start()) + 1
            texts.setdefault(plain(found[2], False), f"{path.relative_to(ROOT)}:{line}")
    rust = [*(ROOT / "src").rglob("*.rs"), *(ROOT / "crates").rglob("*.rs")]
    for path in sorted(rust):
        if "yapfast-lang" in path.parts:
            continue
        source = path.read_text(encoding="utf-8")
        for found in RUST.finditer(source):
            line = source.count("\n", 0, found.start()) + 1
            texts.setdefault(plain(found[1], True), f"{path.relative_to(ROOT)}:{line}")
    return texts


def translated(path):
    """The texts a gettext file translates."""
    texts = set()
    text = None
    field = None
    done = False
    for line in [*path.read_text(encoding="utf-8").splitlines(), ""]:
        line = line.strip()
        found = re.fullmatch(r"(?:(\S+)\s+)?" + STRING, line)
        if not found:
            if text and done:
                texts.add(text)
            text, field, done = None, None, False
            continue
        field = found[1] or field
        part = plain(found[2], False)
        if field == "msgid":
            if found[1] and text and done:
                texts.add(text)
            if found[1]:
                done = False
            text = part if found[1] else (text or "") + part
        elif field and field.startswith("msgstr") and part:
            done = True
    return texts


def main():
    unused = "--unused" in sys.argv[1:]
    texts = marked()
    missing = 0
    for path in sorted((ROOT / "lang").glob("*.po")):
        have = translated(path)
        wanted = {
            text: where for text, where in texts.items() if path.stem != "en" or "Yapfast" in text
        }
        lacking = sorted((where, text) for text, where in wanted.items() if text not in have)
        missing += len(lacking)
        print(f"{path.name}: {len(have)} translated, {len(lacking)} of {len(wanted)} marked texts lack one")
        for where, text in lacking:
            print(f"  {where}: {text!r}")
        if unused:
            for text in sorted(have - texts.keys()):
                print(f"  unused: {text!r}")
    sys.exit(1 if missing else 0)


if __name__ == "__main__":
    main()
