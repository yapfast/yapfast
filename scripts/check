#!/usr/bin/env bash
# Formatting, doc links, Clippy, tests and a smoke run of the default build,
# Discord on the desktop; then the plugin system as yapfast-core builds it with
# the `plugins` feature and no network feature beside it. --matrix adds the
# builds with Matrix.
# Usage: scripts/check [--fast] [--matrix]
# --fast builds with the `fast` profile, which local work uses. Each step
# prints `=== step` and `rc=N` when it ends; its full output is in
# target/check/. The script exits non-zero when any step failed, after running
# them all.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Without Nix, it uses the tools already installed.
if [[ -z "${IN_NIX_SHELL:-}" ]] && command -v nix >/dev/null; then
  exec nix develop path:./nix --command "$0" "$@"
fi

profile=()
profile_dir=debug
matrix=
for argument in "$@"; do
  case $argument in
    --fast) profile=(--profile fast) profile_dir=fast ;;
    --matrix) matrix=1 ;;
    *) echo "usage: scripts/check [--fast] [--matrix]" >&2; exit 2 ;;
  esac
done

logs=target/check
mkdir -p "$logs"
rm -f "$logs"/*.log "$logs"/*.rc

# Runs a step and prints its report.
run() {
  local name=$1
  shift
  local start=$SECONDS
  "$@" >"$logs/$name.log" 2>&1
  local rc=$?
  echo "$rc" >"$logs/$name.rc"
  local report
  report="=== $name: $*"$'\n'"rc=$rc ($((SECONDS - start)) s)"
  if [[ $rc -ne 0 ]]; then
    # Rust's own diagnostics, without the C compilers' warnings around them,
    # or the end of the output when there are none.
    report+=$'\n'$(grep -E -A12 '^(error|warning)(\[|:)|^test .* FAILED|panicked at' "$logs/$name.log" | head -80 ||
      tail -20 "$logs/$name.log")
    report+=$'\n'"(full output: $logs/$name.log)"
  fi
  printf '%s\n' "$report"
}

clippy=(cargo clippy --locked "${profile[@]}" --all-targets)
# feature-union is for the Matrix steps below; with it, the default build would
# resolve as the full one and compile Slint apart from `cargo build`.
workspace=(--workspace --exclude feature-union)
steps=(fmt doc-links fixtures clippy test build smoke)

run fmt cargo fmt --all -- --check
run doc-links scripts/check-doc-links
# No compile: it hashes the committed modules against the record of the sources
# they were built from, so a fixture that went stale fails here in a second
# instead of passing tests that load yesterday's module.
run fixtures scripts/check-plugin-fixtures
# yapfast-ui is outside the workspace (see Cargo.toml), so Clippy checks it
# only as a dependency, with plain rustc: it neither lints the generated
# interface nor checks it a second time in test mode, as --all-targets would
# a member despite its `test = false`.
run clippy "${clippy[@]}" "${workspace[@]}" -- -D warnings
run test cargo test --locked "${profile[@]}" "${workspace[@]}"
run build cargo build --locked "${profile[@]}" "${workspace[@]}"
# The binary the build step made: `cargo run` would resolve the dependencies'
# features for yapfast alone, not the workspace, and compile it again.
if [[ "$(cat "$logs/build.rc")" == 0 ]]; then
  run smoke "target/$profile_dir/yapfast" --smoke-test
else
  echo "=== smoke: skipped, as the build failed"
fi

# The plugin system without the networks it shares code with. The steps above
# already carry `plugins`: it is in the workspace's default features, so their
# Clippy and tests check the plugin code with `discord` beside it, and `cargo
# test` builds yapfast-plugin-host's binary, because that package has integration
# tests, so the plugin tests that run the helper run there too. The two plugin
# crates need no step of their own, since both are workspace members. What none
# of them compiles is `plugins` on its own: the Matrix and headless steps below
# take `--no-default-features` and turn plugins off with it. So these two do, and
# they are what a build that wanted plugins and neither network would catch. See
# docs/plugins/.
run clippy-plugins "${clippy[@]}" -p yapfast-core --no-default-features --features plugins -- -D warnings
# Compiled, not run: the `test` step above already ran these tests, with the same
# `plugins` on through yapfast's default features, and a second run would pay
# their 31 s sleep and six helper startups to assert the same things again. What
# this combination alone adds is that the tests compile without `discord`.
run test-plugins cargo test --locked "${profile[@]}" -p yapfast-core --no-default-features --features plugins --no-run
steps+=(clippy-plugins test-plugins)
# The plugin tests the `test` step ran are the real ones: they run the real
# yapfast-plugins, which that step's build made in target/$profile_dir/. A helper
# that isn't there fails them with the command that builds it, rather than
# passing having run nothing. The gate's one test that needs DNS is #[ignore]d,
# so it doesn't run here; .github/workflows/tests.yml runs it in its by-hand job.
# The other direction is the Matrix steps', and only theirs: those select
# yapfast-core with --no-default-features, `clippy-matrix-only` itself and
# `clippy-headless` as yapfast's dependency, so both build it with `plugins`
# off. Both need --matrix, so no step of a plain run compiles yapfast-core
# without the feature. After changing what it gates, run
# `cargo check -p yapfast-core`: it builds that configuration without waiting
# for a --matrix run. A step for it isn't here because it costs a compile of
# the whole crate in a second feature set, which a plain run would pay on
# every Rust edit.

# The builds with Matrix: Matrix beside Discord, with its tests; Matrix
# alone, in the desktop and in the shared core with its tests; and the
# headless build. With feature-union, the crates below Slint resolve the same
# in the first two, so the second reuses the first's check of the UI crate
# instead of compiling its own; Clippy uplifts no binary, so they can share
# target/<profile>/. They run after the steps above, not beside them: a
# compile of the UI crate takes several GiB, and two or three at once ran the
# machine out of memory.
if [[ $matrix ]]; then
  full=(--features yapfast/matrix,yapfast-core/matrix)
  run clippy-matrix "${clippy[@]}" --workspace "${full[@]}" -- -D warnings
  run test-matrix cargo test --locked "${profile[@]}" --workspace "${full[@]}"
  run clippy-matrix-only "${clippy[@]}" -p yapfast -p yapfast-core -p feature-union \
    --no-default-features --features yapfast/desktop,yapfast/matrix,yapfast-core/matrix -- -D warnings
  # The headless build, in a target directory of its own, so its binary stays
  # out of target/<profile>/.
  export CARGO_TARGET_DIR=target/check-combinations
  run clippy-headless "${clippy[@]}" -p yapfast --no-default-features --features matrix,discord -- -D warnings
  run smoke-headless cargo run --locked "${profile[@]}" --no-default-features --features matrix,discord -- --smoke-test
  steps+=(clippy-matrix test-matrix clippy-matrix-only clippy-headless smoke-headless)
fi

failed=()
for name in "${steps[@]}"; do
  # A step without a result was skipped.
  [[ ! -e "$logs/$name.rc" || "$(cat "$logs/$name.rc")" == 0 ]] || failed+=("$name")
done
if [[ ${#failed[@]} -gt 0 ]]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "All checks passed."
