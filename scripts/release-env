# Sourced before building a binary people download: `source scripts/release-env
# TARGET`, then plain `cargo build --target TARGET`. Rust embeds source paths for panic messages, and C's __FILE__ ends
# up in error messages too; they'd name the folders of the machine that built
# it, its owner's home folder among them. These flags name none.
# CARGO_ENCODED_RUSTFLAGS replaces .cargo/config.toml's rustflags, so a
# target's own come along here.
yapfast_release_target=${1:?usage: source scripts/release-env TARGET}
yapfast_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Widest first: rustc and Clang take the last mapping that matches.
yapfast_maps=("$HOME=/home" "${CARGO_HOME:-$HOME/.cargo}=/cargo" "$yapfast_root=/yapfast")
yapfast_rust=()
yapfast_c=()
for map in "${yapfast_maps[@]}"; do
  yapfast_rust+=("--remap-path-prefix=$map")
  yapfast_c+=("-ffile-prefix-map=$map")
done
case "$yapfast_release_target" in
  x86_64-pc-windows-msvc)
    # Match LiveKit's Windows runtime linkage, as .cargo/config.toml does.
    yapfast_rust=(-Ctarget-feature=+crt-static "${yapfast_rust[@]}")
    # cargo-xwin compiles C with clang-cl, which takes Clang's flags this way.
    yapfast_c=("${yapfast_c[@]/#//clang:}") ;;
  x86_64-unknown-linux-gnu) ;;
  aarch64-apple-darwin)
    # libwebrtc's ScreenCaptureKit symbols, as .cargo/config.toml leaves them.
    yapfast_rust=(-Clink-arg=-Wl,-U,_OBJC_CLASS_\$_SCContentSharingPicker
      -Clink-arg=-Wl,-U,_SCStreamFrameInfoBoundingRect
      -Clink-arg=-Wl,-U,_SCStreamFrameInfoPresenterOverlayContentRect "${yapfast_rust[@]}") ;;
  *) echo "scripts/release-env: no flags known for $yapfast_release_target" >&2; return 2 ;;
esac
CARGO_ENCODED_RUSTFLAGS=$(IFS=$'\x1f'; printf '%s' "${yapfast_rust[*]}")
export CARGO_ENCODED_RUSTFLAGS
# The cc crate reads only the first of CFLAGS_<target> and its fallbacks, and
# `cargo xwin build` sets that one, so take its environment, which adds to
# these rustflags, and add the C flags to what it sets.
yapfast_target_flags=${yapfast_release_target//-/_}
if [[ "$yapfast_release_target" == *-windows-msvc ]]; then
  eval "$(cargo xwin env --target "$yapfast_release_target")"
fi
yapfast_cflags="CFLAGS_$yapfast_target_flags" yapfast_cxxflags="CXXFLAGS_$yapfast_target_flags"
export "$yapfast_cflags=${!yapfast_cflags:-} ${yapfast_c[*]}"
export "$yapfast_cxxflags=${!yapfast_cxxflags:-} ${yapfast_c[*]}"
unset yapfast_release_target yapfast_root yapfast_maps yapfast_rust yapfast_c map \
  yapfast_target_flags yapfast_cflags yapfast_cxxflags
