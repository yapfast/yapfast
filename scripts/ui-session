#!/usr/bin/env python3
"""Run Yapfast on a private Weston display and drive it, for screenshots and UI checks.

  scripts/ui-session start [--discord [--fake-args '--servers 3 --dms 50']] [--live]
                           [--size 1120x760] [--renderer software|gpu] [--tray]
                           [--zoom 1.2] [--cursor [SIZE]] [--desktop] [--profile fast|measure]
                           [--bin PATH | --no-build]
                           [-- YAPFAST_ARGS...]
  scripts/ui-session do 'click X Y' 'type Hello' 'key enter' 'shot NAME' ...
  scripts/ui-session relaunch [-- YAPFAST_ARGS...]   rebuild, then restart Yapfast
                                  on the same display, with these arguments added
                                  this once, such as -- --background
  scripts/ui-session status
  scripts/ui-session stop

start builds Yapfast with the `fast` profile (Discord-only with --discord, which
also starts testing/fake_discord.ts on a free port; otherwise the default
build with --preview) and runs a copy of it, so later builds don't disturb it.
After a --discord build, target/fast/yapfast is the Discord-only build until the
next default build.
--profile measure builds with the `measure` profile instead, which optimizes the
Slint interface too: for measuring memory or CPU. relaunch keeps the profile.
--live builds with the live-preview feature: the window loads ui/*.slint at
runtime and reloads it a moment after each save, keeping its state, so a UI edit
needs no rebuild. A save that renames a new file over the old one, as sed -i and
Claude's Edit tool do, goes unnoticed; touch the file after it. Rust changes, and properties or callbacks
Rust code newly uses, still take a relaunch.
The display is the window's size, so coordinates are window coordinates (but see --desktop).
--tray also runs testing/tray_host.rs, a stand-in tray on the session's bus,
which Yapfast's tray icon registers with; without it there is no tray.
--zoom opens Yapfast zoomed to one of its levels, as Ctrl and + would, with the
level in its layout.json: 0.5 to 1.5 in steps of 0.05, then to 2 in 0.1.
--desktop runs Weston's desktop shell instead of its kiosk shell, which makes the
window full screen: the window can then be moved, resized and maximized, as for
Yapfast's own title bar on Linux. The display is then 240x160 larger than --size,
for Weston's panel and room around the window, and coordinates are the display's.
--cursor shows the pointer, 24 pixels tall unless SIZE says; without it
screenshots and videos have none.
start also builds testing/record_host.rs, which `record` runs.

do commands, run in order; the first error stops the rest:
  click X Y [MODIFIERS] [glide [SECONDS]] | rightclick X Y | middleclick X Y | move X Y |
      drag X Y TO_X TO_Y (left button); click's modifiers are held through
      it, as shift or ctrl+shift; with glide the pointer glides there first
  glide X Y [SECONDS]   moves the pointer along an eased path, 60 steps a
      second; by default in .3 to 1 s, by the distance
  press X Y [middle] | release [middle]   hold the left (or middle) button
      down, for what happens meanwhile
  scroll PIXELS [SECONDS] (negative scrolls up), at once or eased over SECONDS
  key NAME|CODE, with modifiers as ctrl+a (names: enter esc tab backspace
      delete space up down left right home end pageup pagedown f10 menu,
      a-z, 0-9)
  keydown NAME|CODE | keyup NAME|CODE   holds a key down until keyup, as
      push to talk's key is held
  type TEXT (US layout letters, digits and common punctuation)
  sleep SECONDS | pid
  shot NAME [X Y W H]   saves .local/ui-session/shots/NAME.png, cropped if asked
  pick avatar|banner|icon|server-banner|splash|role-icon|emoji|sticker PATH
      chooses the picture in the profile editor, or a server's icon, banner,
      invite background, open role's icon, new emoji or new sticker in its
      settings, as the file chooser would; PATH as for stage
  stage PATH   adds the file to the composer's next message, as a paste would;
      PATH is relative to the repository, outside .local/ui-session, which
      start empties
  stage-aside PATH   adds the file to the next message of the thread beside
      the channel, as stage does to the channel's
  theme ID   chooses a theme, such as yap, sakura or custom:1, as Appearance does
  window close|open|destroy|create|hide|show|trim|stats   acts on the window:
      close as its close button does (to the tray, or quit without one),
      open as the tray's Open Yapfast; stats writes glibc's heap to yapfast.log
  tray activate [TOKEN [after]] | menu | click LABEL | icon NAME | off | on
      with --tray: clicks the icon (with an xdg-activation token sent before
      the click, or 5 ms after), prints or chooses its menu's items, saves
      its picture to shots/NAME.png, or stops and starts the stand-in tray
  control NAME | get NAME   POST or GET /_control/NAME on the fake Discord
  record start NAME | record stop   records the display at 60 frames a second
      to .local/ui-session/videos/NAME.mp4 (H.264); stop prints its length and
      how many frames were fresh captures and how many repeats. Weston
      repaints for each capture, still window or not, at most about 58.5
      times a second, so about one frame in 40 repeats. stop, or the
      session's end, finishes the file. Videos stay across start
Without arguments, do reads one command per line from standard input.

Logs: .local/ui-session/{yapfast,fake,session,build,record}.log. Yapfast's PID is in
.local/ui-session/yapfast.pid. Nothing reaches the desktop or a real account.
"""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / '.local/ui-session'
SESSION_PID = STATE / 'session.pid'
SETTINGS = STATE / 'settings.json'


def running():
    try:
        pid = int(SESSION_PID.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def tail(path, lines=20):
    if path.exists():
        print(f'--- {path.relative_to(ROOT)}', file=sys.stderr)
        print('\n'.join(path.read_text(errors='replace').splitlines()[-lines:]), file=sys.stderr)


def build(discord, profile, live=False, yapfast=True, tray=False, record=False):
    features = ['--no-default-features', '--features', 'desktop,discord'] if discord else []
    features += ['--features', 'live-preview'] if live else []
    targets = [*(['--bin', 'yapfast'] if yapfast else []), *(['--example', 'tray_host'] if tray else []),
               *(['--example', 'record_host'] if record else [])]
    command = ['nix', 'develop', 'path:./nix', '--command', 'cargo', 'build', '--locked', '--profile', profile,
               *features, *targets]
    print('Building:', shlex.join(command[4:]), flush=True)
    log = STATE / 'build.log'
    result = subprocess.run(command, cwd=ROOT, stdout=log.open('wb'), stderr=subprocess.STDOUT)
    if result.returncode != 0:
        tail(log, 40)
        raise SystemExit(f'The build failed; see {log.relative_to(ROOT)}')
    # Replace, never overwrite, so a running copy keeps its file.
    built = [('yapfast', f'target/{profile}/yapfast')] if yapfast else []
    built += [('tray-host', f'target/{profile}/examples/tray_host')] if tray else []
    built += [('record-host', f'target/{profile}/examples/record_host')] if record else []
    for name, path in built:
        copy = STATE / f'{name}.new'
        shutil.copy2(ROOT / path, copy)
        os.replace(copy, STATE / name)


def send(commands, timeout=60):
    """Sends commands one at a time and prints their output; stops at the first error."""
    if not running():
        raise SystemExit('No UI session is running; start one with scripts/ui-session start.')
    results = STATE / 'results'
    for command in commands:
        identifier = uuid.uuid4().hex[:8]
        with (STATE / 'commands').open('a') as pending:
            pending.write(f'{identifier}\t{command}\n')
        wait = timeout + (float(command.split()[1]) if command.startswith('sleep ') else 0)
        deadline = time.monotonic() + wait
        while True:
            answer = next((line.split('\t', 2) for line in
                           (results.read_text().splitlines() if results.exists() else [])
                           if line.startswith(identifier + '\t')), None)
            if answer:
                break
            if not running():
                tail(STATE / 'session.log')
                raise SystemExit('The UI session ended.')
            if time.monotonic() > deadline:
                raise SystemExit(f'No answer to {command!r} within {wait:.0f} s; see .local/ui-session/session.log')
            time.sleep(.05)
        _, status, output = answer
        output = json.loads(output)
        if status != 'ok':
            raise SystemExit(f'{command}: {output}')
        print(f'{command}: {output}' if output else command)


def zoom_level(text):
    """One of Yapfast's zoom levels, as src/zoom.rs lists them; Yapfast ignores others."""
    percent = round(float(text) * 100)
    if abs(float(text) * 100 - percent) > .01 or not (
            50 <= percent <= 150 and percent % 5 == 0 or 150 < percent <= 200 and percent % 10 == 0):
        raise argparse.ArgumentTypeError('Yapfast zooms from 0.5 to 1.5 in steps of 0.05, then to 2 in 0.1')
    return percent / 100


def start(args):
    if running():
        raise SystemExit('A UI session is already running; stop it first.')
    width, height = map(int, args.size.split('x'))
    if args.desktop:
        # Room around the window for Weston's panel and for moving it.
        width, height = width + 240, height + 160
    if STATE.exists():
        for entry in STATE.iterdir():
            if entry.name not in ('yapfast', 'tray-host', 'record-host', 'build.log', 'videos'):
                shutil.rmtree(entry) if entry.is_dir() else entry.unlink()
    STATE.mkdir(parents=True, exist_ok=True)
    if args.zoom is not None:
        # Yapfast reads the level from its layout at start; see `Layout` in src/ui.rs.
        (STATE / 'data').mkdir()
        (STATE / 'data/layout.json').write_text(json.dumps({'zoom': args.zoom}))
    if args.bin:
        shutil.copy2(args.bin, STATE / 'yapfast')
    if not (args.bin or args.no_build):
        build(args.discord, args.profile, args.live, tray=args.tray, record=True)
    else:
        tray = args.tray and not (args.no_build and (STATE / 'tray-host').exists())
        record = not (args.no_build and (STATE / 'record-host').exists())
        if tray or record:
            build(args.discord, args.profile, yapfast=False, tray=tray, record=record)
    if not (STATE / 'yapfast').exists():
        raise SystemExit('No Yapfast binary yet; start without --no-build.')
    yapfast_args = args.yapfast_args[1:] if args.yapfast_args[:1] == ['--'] else args.yapfast_args
    if not args.discord and '--preview' not in yapfast_args:
        yapfast_args = ['--preview', *yapfast_args]
    SETTINGS.write_text(json.dumps({'discord': args.discord, 'live': args.live, 'profile': args.profile,
                                    'build': not (args.bin or args.no_build)}))
    driver = ['python3', 'testing/ui_session.py', '--state', str(STATE), '--bin', str(STATE / 'yapfast'),
              '--size', args.size, '--renderer', args.renderer,
              *(['--discord', '--fake-args', args.fake_args] if args.discord else []),
              *(['--tray', str(STATE / 'tray-host')] if args.tray else []),
              '--record', str(STATE / 'record-host'),
              *(['--cursor', str(args.cursor)] if args.cursor else []), '--', *yapfast_args]
    display = (f'scripts/run-framework-isolated --audio --alsa-plugins "$YAPFAST_FRAMEWORK_ALSA_PLUGINS" '
               f'--no-services {"" if args.desktop else "--kiosk "}--width {width} --height {height} --repaint-window 17 '
               f'--compositor-log {shlex.quote(str(STATE / "weston.log"))} -- {shlex.join(driver)}')
    session = subprocess.Popen(['nix-shell', '--impure', 'testing/display/shell.nix', '--run', display],
                               cwd=ROOT, stdin=subprocess.DEVNULL, stdout=(STATE / 'session.log').open('wb'),
                               stderr=subprocess.STDOUT, start_new_session=True)
    SESSION_PID.write_text(f'{session.pid}\n')
    deadline = time.monotonic() + 180
    while not (STATE / 'ready').exists():
        if session.poll() is not None or time.monotonic() > deadline:
            tail(STATE / 'session.log')
            tail(STATE / 'yapfast.log')
            tail(STATE / 'fake.log')
            stop()
            raise SystemExit('The UI session did not start.')
        time.sleep(.2)
    print(f'Yapfast is running on a private {width}x{height} display, PID {(STATE / "yapfast.pid").read_text().strip()}.')
    print('Drive it with scripts/ui-session do; shots go to .local/ui-session/shots/, videos to videos/.')


def relaunch():
    if not running():
        raise SystemExit('No UI session is running.')
    settings = json.loads(SETTINGS.read_text())
    if settings['build']:
        build(settings['discord'], settings.get('profile', 'fast'), settings.get('live', False))
    extra = args.yapfast_args[1:] if args.yapfast_args[:1] == ['--'] else args.yapfast_args
    send([' '.join(['relaunch', *extra])])


def stop():
    pid = running()
    if pid:
        try:
            send(['quit'], timeout=10)
        except SystemExit:
            pass
        deadline = time.monotonic() + 15
        while running() and time.monotonic() < deadline:
            time.sleep(.2)
        if running():
            os.killpg(pid, signal.SIGTERM)
            time.sleep(5)
            if running():
                os.killpg(pid, signal.SIGKILL)
    SESSION_PID.unlink(missing_ok=True)


parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
actions = parser.add_subparsers(dest='action', required=True)
starting = actions.add_parser('start')
starting.add_argument('--discord', action='store_true', help='Discord-only build against the fake Discord')
starting.add_argument('--live', action='store_true', help='reload ui/*.slint on each save, without a rebuild')
starting.add_argument('--fake-args', default='', help="arguments for testing/fake_discord.ts, such as '--dms 50'")
starting.add_argument('--size', default='1120x760')
starting.add_argument('--renderer', choices=['software', 'gpu'], default='software')
starting.add_argument('--profile', choices=['fast', 'measure'], default='fast',
                      help='Cargo profile to build with; measure optimizes the interface too')
starting.add_argument('--tray', action='store_true', help='run a stand-in tray on the private bus')
starting.add_argument('--desktop', action='store_true', help="Weston's desktop shell rather than kiosk: the window isn't full screen")
starting.add_argument('--zoom', type=zoom_level, help="open Yapfast zoomed to this level, such as 1.2")
starting.add_argument('--cursor', type=int, nargs='?', const=24, metavar='SIZE',
                      help='show the pointer, this many pixels tall (24)')
binary = starting.add_mutually_exclusive_group()
binary.add_argument('--bin', type=Path, help='run this Yapfast binary instead of building')
binary.add_argument('--no-build', action='store_true', help='run the copy from the last start')
starting.add_argument('yapfast_args', nargs=argparse.REMAINDER, help='after --, arguments for Yapfast')
doing = actions.add_parser('do')
doing.add_argument('commands', nargs='*')
actions.add_parser('relaunch').add_argument('yapfast_args', nargs=argparse.REMAINDER,
                                            help='after --, arguments for Yapfast this once')
actions.add_parser('status')
actions.add_parser('stop')
args = parser.parse_args()

if args.action == 'start':
    start(args)
elif args.action == 'do':
    send(args.commands or [line.strip() for line in sys.stdin if line.strip()])
elif args.action == 'relaunch':
    relaunch()
elif args.action == 'status':
    pid = running()
    print(f'Running; Yapfast PID {(STATE / "yapfast.pid").read_text().strip()}.' if pid else 'Not running.')
else:
    stop()
