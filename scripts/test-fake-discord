#!/usr/bin/env bash
# Runs crates/yapfast-discord/tests/fake_server/, fake_interactions.rs and
# fake_commands.rs, then yapfast-core's ignored Discord text, voice and
# sticker picker tests, against testing/fake_discord.ts, then
# crates/yapfast-discord/tests/fake_env.rs against it with an environment.
# Usage: scripts/test-fake-discord [FILTER…], test names or parts of them
# (`scripts/test-fake-discord forum`).
# Each fake_server test starts a fake of its own, logging to
# target/fake-discord-TEST.log; `grep -rn '^async fn'
# crates/yapfast-discord/tests/fake_server` lists them. cargo nextest
# runs them side by side, eight at a time (.config/nextest.toml); without
# it, cargo test runs them one after another.
# For the yapfast-core tests it starts one fake, waits until it answers,
# runs them one at a time with the selected Cargo profile (default: `fast`), then stops it; its log is
# target/fake-discord.log. Then it does the same for fake_env.rs, against
# a fake running testing/envs/example.json, whose log is
# target/fake-discord-env.log.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# CI sets this to ci so these tests share its cheap, cacheable artifacts.
# Local runs keep using the fast profile unless explicitly overridden.
profile=${YAPFAST_CARGO_PROFILE:-fast}

# Without Nix, it uses the tools already installed.
if [[ -z "${IN_NIX_SHELL:-}" ]] && command -v nix >/dev/null; then
  exec nix develop path:./nix --command "$0" "$@"
fi

mkdir -p target
fakes=()
# Stops every fake: a stopped one's status fails `wait`, which mustn't end
# the trap before the next.
trap 'for fake in "${fakes[@]}"; do kill "$fake" 2>/dev/null || true; wait "$fake" 2>/dev/null || true; done' EXIT

# Starts the fake on a free port, logging to the file given first, with the
# other arguments, and waits until it answers; sets $server to its address.
free_port() {
  python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

start_fake() {
  local log=$1
  shift
  local port
  port=$(free_port)
  bun testing/fake_discord.ts --port "$port" "$@" >"$log" 2>&1 &
  local fake=$!
  fakes+=("$fake")
  for _ in $(seq 100); do
    curl -fsS --max-time 1 "http://127.0.0.1:$port/_control/health" >/dev/null 2>&1 && break
    if ! kill -0 "$fake" 2>/dev/null; then
      echo "The fake Discord exited before it was ready:" >&2
      tail -20 "$log" >&2
      exit 1
    fi
    sleep 0.1
  done
  curl -fsS --max-time 1 "http://127.0.0.1:$port/_control/health" >/dev/null || {
    echo "The fake Discord did not answer on port $port; see $log" >&2
    exit 1
  }
  server="http://127.0.0.1:$port"
}

if command -v cargo-nextest >/dev/null; then
  nextest=(cargo nextest run --locked --cargo-profile "$profile" --run-ignored only --no-fail-fast)
  no_tests=()
  if [[ $# -gt 0 ]]; then
    # A filter can match only the core or example environment tests below.
    no_tests=(--no-tests=pass)
  fi
  "${nextest[@]}" -p yapfast-discord --test fake_server --test fake_interactions --test fake_commands \
    -E 'not test(=waits_as_detected_game)' "${no_tests[@]}" "$@"

  # The core's tests share a fake. Run them serially across Nextest's processes.
  start_fake target/fake-discord.log
  YAPFAST_DISCORD_TEST_SERVER=$server "${nextest[@]}" -p yapfast-core --lib --test-threads 1 \
    -E 'test(discord_text::tests::) | test(discord_voice::tests::) | test(application::tests::pickers::)' \
    "${no_tests[@]}" "$@"

  start_fake target/fake-discord-env.log --env testing/envs/example.json
  YAPFAST_DISCORD_TEST_SERVER=$server "${nextest[@]}" -p yapfast-discord --test fake_env \
    "${no_tests[@]}" "$@"
  exit 0
fi

cargo test --locked --profile "$profile" -p yapfast-discord --test fake_server -- --ignored \
  --skip waits_as_detected_game "$@"
cargo test --locked --profile "$profile" -p yapfast-discord --test fake_interactions -- --ignored "$@"
cargo test --locked --profile "$profile" -p yapfast-discord --test fake_commands -- --ignored "$@"
# Libtest combines name filters with OR. Match them against the ignored
# tests in these modules before giving libtest the exact names to run.
core=(cargo test --locked --profile "$profile" -p yapfast-core --lib)
listed=$("${core[@]}" -- --ignored --list --format terse \
  discord_text::tests:: discord_voice::tests:: application::tests::pickers::)
core_tests=()
while IFS= read -r line; do
  line=${line%$'\r'}
  [[ $line == *': test' ]] || continue
  name=${line%: test}
  if [[ $# == 0 ]]; then
    core_tests+=("$name")
    continue
  fi
  for filter in "$@"; do
    if [[ $name == *"$filter"* ]]; then
      core_tests+=("$name")
      break
    fi
  done
done <<< "$listed"
if [[ ${#core_tests[@]} -gt 0 ]]; then
  start_fake target/fake-discord.log
  YAPFAST_DISCORD_TEST_SERVER=$server "${core[@]}" -- --ignored --test-threads 1 --exact "${core_tests[@]}"
fi
# The example environment, in a fake of its own.
start_fake target/fake-discord-env.log --env testing/envs/example.json
YAPFAST_DISCORD_TEST_SERVER=$server \
  cargo test --locked --profile "$profile" -p yapfast-discord --test fake_env -- --ignored "$@"
