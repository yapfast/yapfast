#!/usr/bin/env bash
# Signs a stable release's SHA256SUMS.txt, as the updater asks of every
# release that isn't a nightly: `scripts/sign-release target/dist/release-0.4.0 v0.4.0`.
# Run it on the machine that holds the stable key, once the sums are final,
# whether the files were built here or downloaded from a draft release. It
# asks for the key's password, writes SHA256SUMS.txt.minisig beside the sums,
# and checks it with the public keys the app carries. YAPFAST_SIGNING_KEY
# names another key file, the backup's say. See docs/packaging.md.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
usage="usage: scripts/sign-release DIR TAG"
dir=${1:?$usage} tag=${2:?$usage}
key=${YAPFAST_SIGNING_KEY:-$HOME/.minisign/yapfast-stable.key}
if [[ $tag != v* || $tag == *-nightly.* ]]; then
  echo "scripts/sign-release: $tag isn't the tag of a release the stable key signs" >&2
  exit 2
fi
sums=$dir/SHA256SUMS.txt
[[ -f $sums ]] || {
  echo "scripts/sign-release: no $sums" >&2
  exit 2
}
minisign() {
  if type -P minisign >/dev/null; then
    command minisign "$@"
  else nix shell nixpkgs#minisign -c minisign "$@"; fi
}
comment="yapfast $tag SHA256SUMS.txt"
minisign -S -s "$key" -m "$sums" -t "$comment" -c "Yapfast $tag"
for public in packaging/keys/stable.pub packaging/keys/stable-backup.pub; do
  if [[ $(minisign -V -p "$public" -m "$sums" -Q 2>/dev/null) == "$comment" ]]; then
    echo "Signed $sums for $tag, checked with $public."
    exit 0
  fi
done
echo "scripts/sign-release: the signature doesn't check with the stable keys in packaging/keys" >&2
rm -f "$sums.minisig"
exit 1
