#!/usr/bin/env python3
"""Fails when a Markdown link in the docs names a file or heading that doesn't exist."""
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent


def anchor(heading):
    """GitHub's anchor for a heading: lower case, punctuation dropped, spaces as hyphens."""
    return re.sub(r'[^\w\- ]', '', heading.strip().lower()).replace(' ', '-')


documents = [ROOT / name for name in ('README.md', 'CLAUDE.md', 'CONTRIBUTING.md')]
documents += sorted((ROOT / 'docs').rglob('*.md'))
broken = []
for document in documents:
    if not document.exists():
        continue
    for line_number, line in enumerate(document.read_text().splitlines(), 1):
        for target in re.findall(r'\]\(([^)\s]+)\)', line):
            if re.match(r'[a-z]+:', target):
                continue
            path, _, fragment = target.partition('#')
            destination = (document.parent / path).resolve() if path else document
            where = f'{document.relative_to(ROOT)}:{line_number}: {target}'
            if not destination.exists():
                broken.append(f'{where} (no such file)')
            elif fragment and destination.suffix == '.md':
                headings = re.findall(r'^#+ (.*)$', destination.read_text(), re.M)
                if fragment not in {anchor(heading) for heading in headings}:
                    broken.append(f'{where} (no such heading)')
print('\n'.join(broken) or 'Every link resolves.')
sys.exit(1 if broken else 0)
