#!/usr/bin/env python3
"""Sample one Linux process. CPU percentages use one core as 100 percent.

Wakeups are the times its threads went to sleep and were woken again
(voluntary context switches), a second: the main thread's, where the
interface's timers and drawing run, and all threads' together. A thread that
ends during the run takes its count with it. The main thread's CPU is given
too, and each thread's CPU and wakeups by its name, threads of one name
(a pool's) together, the busiest first."""

import argparse
import json
import os
from pathlib import Path
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("pid", type=int)
parser.add_argument("--seconds", type=int, default=30)
args = parser.parse_args()
if args.pid < 1 or args.seconds < 1:
    parser.error("PID and duration must be positive")
process = Path("/proc") / str(args.pid)


def ticks():
    fields = (process / "stat").read_text().rsplit(")", 1)[1].split()
    return int(fields[11]) + int(fields[12])


def wakeups():
    """Voluntary context switches by thread id."""
    counts = {}
    for task in (process / "task").iterdir():
        try:
            for line in (task / "status").read_text().splitlines():
                if line.startswith("voluntary_ctxt_switches:"):
                    counts[task.name] = int(line.split()[1])
        except OSError:
            continue
    return counts


def thread_ticks():
    """CPU ticks and name by thread id."""
    found = {}
    for task in (process / "task").iterdir():
        try:
            name, _, rest = (task / "stat").read_text().partition(" (")[2].rpartition(")")
            fields = rest.split()
            found[task.name] = (name, int(fields[11]) + int(fields[12]))
        except (OSError, IndexError, ValueError):
            continue
    return found


def memory():
    result = {}
    for line in (process / "smaps_rollup").read_text().splitlines():
        key, _, value = line.partition(":")
        if key in ("Rss", "Pss"):
            result[key.lower()] = int(value.split()[0]) / 1024
    return result


def gpu_counters():
    clients = {}
    for path in (process / "fdinfo").iterdir():
        try:
            values = dict(line.split(":", 1) for line in path.read_text().splitlines() if ":" in line)
        except (OSError, ValueError):
            continue
        client = values.get("drm-client-id")
        if client is None:
            continue
        key = (values.get("drm-pdev", ""), client)
        clients[key] = {
            k: int(v.split()[0])
            for k, v in values.items()
            if k.startswith("drm-engine-") and v.strip().endswith(" ns")
        }
    result = {}
    for client in clients.values():
        for engine, nanoseconds in client.items():
            result[engine] = result.get(engine, 0) + nanoseconds
    return result


started = time.monotonic()
start_ticks = ticks()
start_wakeups = wakeups()
start_threads = thread_ticks()
start_gpu = gpu_counters()
samples = [memory()]
for _ in range(args.seconds):
    time.sleep(1)
    samples.append(memory())
end_ticks = ticks()
end_wakeups = wakeups()
end_threads = thread_ticks()
end_gpu = gpu_counters()
elapsed = time.monotonic() - started
gpu = {
    engine: (end_gpu[engine] - value) / (elapsed * 1e9) * 100
    for engine, value in start_gpu.items()
    if engine in end_gpu
}
woken = {thread: count - start_wakeups.get(thread, 0) for thread, count in end_wakeups.items()}
hertz = os.sysconf("SC_CLK_TCK")
by_name = {}
for thread, (name, ticks_now) in end_threads.items():
    entry = by_name.setdefault(name, {"cpu_percent": 0.0, "wakeups_per_second": 0.0, "threads": 0})
    entry["cpu_percent"] += (ticks_now - start_threads.get(thread, (name, 0))[1]) / hertz / elapsed * 100
    entry["wakeups_per_second"] += woken.get(thread, 0) / elapsed
    entry["threads"] += 1
main = end_threads.get(str(args.pid), ("", 0))[1] - start_threads.get(str(args.pid), ("", 0))[1]
print(json.dumps({
    "pid": args.pid,
    "duration_seconds": round(elapsed, 3),
    "cpu_percent_one_core": round((end_ticks - start_ticks) / os.sysconf("SC_CLK_TCK") / elapsed * 100, 3),
    "cpu_percent_main_thread": round(main / hertz / elapsed * 100, 3),
    "wakeups_per_second_main_thread": round(woken.get(str(args.pid), 0) / elapsed, 1),
    "wakeups_per_second_all_threads": round(sum(woken.values()) / elapsed, 1),
    "rss_mib_mean": round(sum(sample["rss"] for sample in samples) / len(samples), 3),
    "rss_mib_peak": round(max(sample["rss"] for sample in samples), 3),
    "pss_mib_mean": round(sum(sample["pss"] for sample in samples) / len(samples), 3),
    "threads_by_name": {
        name: {key: round(value, 2) if isinstance(value, float) else value for key, value in entry.items()}
        for name, entry in sorted(by_name.items(), key=lambda item: (-item[1]["cpu_percent"], -item[1]["wakeups_per_second"]))
        if entry["cpu_percent"] or entry["wakeups_per_second"]
    },
    "gpu_engine_percent": {engine: round(value, 3) for engine, value in gpu.items()},
    "gpu_measurement": "DRM per-process engine counters" if gpu else "Counters unavailable; GPU utilization not measured",
}, indent=2))
