 "motion": {
  "about": "motion-reactive stills swapped on the real system cursor. Hotspot stays on the red centre point (32,32) in every frame.",
  "directions": [
   "e",
   "se",
   "s",
   "sw",
   "w",
   "nw",
   "n",
   "ne"
  ],
  "direction_pick": "theta = atan2(vy, vx) in screen space (y down, 0 = moving right); dir = DIRS[round(theta / 45deg) mod 8]",
  "velocity": "pointer motion events -> instantaneous px/s, smoothed with an exponential moving average, tau 40 ms",
  "speed_px_per_s": {
   "still_below": 60,
   "slow_from": 60,
   "fast_from": 700,
   "hysteresis": 60,
   "note": "logical px. Enter fast above 700, drop back to slow below 640; enter slow above 60, count as stopped below 40 for 60 ms"
  },
  "move": {
   "default": "move/{dir}-{slow|fast}.png (+@2x)",
   "pointer": "move-pointer/{dir}-{slow|fast}.png (+@2x)",
   "amounts": {
    "default": {
     "slow": {
      "tilt_deg": 13,
      "back_px": 0.3,
      "stretch": 1.03,
      "squash": 0.98
     },
     "fast": {
      "tilt_deg": 30,
      "back_px": 1.0,
      "stretch": 1.09,
      "squash": 0.95
     }
    },
    "pointer": {
     "slow": {
      "tilt_deg": 11,
      "back_px": 0.25,
      "stretch": 1.02,
      "squash": 0.985
     },
     "fast": {
      "tilt_deg": 24,
      "back_px": 0.8,
      "stretch": 1.06,
      "squash": 0.96
     }
    }
   },
   "look": "swing, like something light dragged by its top: moving right tilts clockwise (bottom corner trails left), moving left tilts anticlockwise; tilt scales with the horizontal part of travel (diagonals ~70%, straight up/down only a small stretch/squash). Fast keeps a hint of brackets trailing behind the red point.",
   "rule": "swap frame whenever dir or speed band changes; no tweening needed"
  },
  "settle": {
   "default": "settle/{dir}-{slow|fast}/NN.png",
   "pointer": "settle-pointer/{dir}-{slow|fast}/NN.png",
   "ms": [
    30,
    40,
    40,
    40,
    50,
    55,
    60,
    70,
    85
   ],
   "mode": "once",
   "amplitude": [
    0.72,
    0.252,
    -0.118,
    -0.29,
    -0.26,
    -0.087,
    0.058,
    0.077,
    0.0
   ],
   "rule": "when the mouse stops, play settle/{last dir}-{last band} from frame 0: a damped swing back past centre (two small overshoots), last frame = rest. Moving again cancels it."
  },
  "idle": {
   "rule": "after settle ends and the mouse has been still 600 ms, loop idle/ (idle-pointer/ over clickables). Any move cancels it straight to move/."
  },
  "priority": "wait > press/release > to-pointer/to-default morph > move > settle > idle > static rest frame. Morph plays even while moving; move frames resume after it ends.",
  "rest_frames": {
   "default": "to-default/07.png (= ../default.png geometry)",
   "pointer": "to-pointer/11.png (= ../pointer.png geometry)"
  }
 }
