{
  "theme_api": 1,
  "id": "com.example.template",
  "name": "Template",
  "version": "1.0.0",
  "description": "A starting point: copy this folder, change the id and name, and make it yours.",
  "authors": ["Your Name"],
  "license": "CC0-1.0",
  "source": "https://github.com/your-name/your-theme",
  "preview": ["preview.png"],

  "shape": {
    "button": { "radius": 8 },
    "field": { "radius": 8 },
    "composer": { "radius": 12 },
    "card": { "radius": 14, "shadow": { "blur": 24, "y": 8, "colour": "#00000066" } },
    "menu": { "radius": 10 },
    "dialog": { "radius": 14 },
    "chip": { "radius": 999 },
    "toggle": { "radius": 999 },
    "avatar": { "radius": 50 },
    "actions": { "radius": 10, "shadow": { "blur": 12, "y": 4, "colour": "#00000055" } },
    "row": { "radius": 6, "inset": [8, 1] },
    "radii": { "small": 4, "medium": 8, "large": 12 },
    "outline_width": 1,
    "borders": { "tile": "dashed", "divider": { "style": "dotted", "gap": 4 }, "actions": "solid" }
  },
  "type": {
    "body": { "size": 15 },
    "headings": { "weight": 800, "letter_spacing": 0.2 },
    "names": { "weight": 600, "style": "ransom",
               "papers": [["#f5f1e8", "#141414"], ["#141414", "#f5f1e8"]] },
    "labels": { "letter_spacing": 1 }
  },
  "spacing": {
    "density": "default",
    "message_group_gap": 18,
    "avatar_size": 40
  },
  "motion": {
    "quick": 140,
    "popup": 160,
    "curve": "ease-out",
    "hover": "lift",
    "press": "scale",
    "open": "zoom",
    "close": "reverse"
  },
  "animations": [
    { "name": "unread breathes", "slot": "unread", "property": "opacity",
      "values": [1, 0.55, 1], "period": 2400, "easing": "ease-in-out" }
  ],
  "effects": {
    "channel.name": { "effect": "decrypt", "duration": 500 }
  },
  "art": {
    "surfaces": {
      "chat": { "texture": "paper", "colour": "#ffffff", "opacity": 0.05, "blend": "screen" },
      "sidebar": [{ "texture": "noise", "colour": "#000000", "opacity": 0.12, "scale": 2 }],
      "account": { "texture": "grain", "colour": "#ffffff", "opacity": 0.04 },
      "actions": { "texture": "grain", "colour": "#ffffff", "opacity": 0.04 }
    },
    "overlays": [
      { "kind": "vignette", "opacity": 0.25 },
      { "kind": "scanlines", "size": 3, "opacity": 0.04, "on": "chat" }
    ],
    "glass": { "surfaces": ["menu", "dialog"], "blur": 16, "opacity": 0.85, "highlight": "#ffffff26" },
    "text": {
      "headings": { "shadow": { "blur": 0, "x": 0, "y": 1, "colour": "#00000099" } },
      "names": { "glow": { "colour": "#7aa2ff66", "size": 2 } }
    },
    "particles": [
      { "preset": "sparkles", "on": "message.sent", "colours": ["#7aa2ff", "#ffffff"], "count": 10 }
    ],
    "events": { "click": "ripple", "hover": "gloss", "select": { "effect": "highlighter", "colour": "#7aa2ff" }, "reaction": "stamp", "row": "none",
                "name_hover": "decrypt" },
    "foil": { "surfaces": ["card"], "opacity": 0.12 },
    "transition": { "kind": "fade", "duration": 260 }
  },
  "sounds": {
    "send": "sounds/send.wav",
    "hover": { "file": "sounds/tick.wav", "volume": 0.6 }
  },
  "icons": {
    "hash": "icons/hash.svg",
    "send-horizontal": { "file": "icons/send.svg", "colour": "accent-text" }
  },
  "cursors": {
    "default": { "image": ["cursors/default.png", "cursors/default@2x.png"], "hotspot": [16, 16] },
    "pointer": { "image": ["cursors/pointer.png", "cursors/pointer@2x.png"], "hotspot": [16, 16] },
    "hidpi": "@2x",
    "wait": { "frames": ["cursors/default.png", "cursors/move/n-slow.png"], "ms": 400, "hotspot": [16, 16] },
    "transitions": {
      "default>pointer": { "frames": ["cursors/move/s-slow.png", "cursors/pointer.png"], "ms": 40, "hotspot": [16, 16] },
      "pointer>default": { "frames": ["cursors/move/n-slow.png", "cursors/default.png"], "ms": 40, "hotspot": [16, 16] },
      "press": { "frames": ["cursors/move/s-fast.png", "cursors/move/s-slow.png"], "ms": [50, 80], "hotspot": [16, 16] }
    },
    "motion": {
      "slow": 60, "fast": 700,
      "default": {
        "move": "cursors/move/{dir}-{speed}.png", "hotspot": [16, 16],
        "settle": { "frames": ["cursors/move/{dir}-slow.png", "cursors/default.png"], "ms": [50, 70], "slow_start": 1 },
        "idle": { "frames": ["cursors/default.png", "cursors/move/n-slow.png"], "ms": 900 },
        "idle_after": 1500
      }
    },
    "trail": { "sheet": "cursors/trail.png", "cell": 16, "sprites": [[0, 0], [16, 0]], "life": 900,
               "every": 12, "per_step": 1, "jitter": 8, "count": 48, "press": 4, "opacity": 0.5 }
  },
  "layout": {
    "rail": "left",
    "members": "right",
    "composer": "bottom",
    "messages": "flat",
    "chat_avatars": true,
    "irc": { "time_width": 56, "nick_width": 120, "separator": "│" },
    "bubbles": { "max_width": 72, "radius": 18 },
    "cards": { "tilt": 0, "gap": 8, "padding": 12,
               "shadow": { "blur": 0, "x": 4, "y": 4, "colour": "#00000040" },
               "art": [{ "texture": "paper", "colour": "#f5f1e8", "opacity": 0.8, "position": "top",
                         "size": [72, 18], "rotation": -3 }] },
    "rail_tiles": { "shape": "square", "width": 48, "height": 48, "radius": 12, "gap": 8, "pad": 4, "tilt": 0,
                    "label": "none", "hover": "lift", "hover_amount": 2, "hover_ms": 120,
                    "selected": { "offset": [0, 0] }, "pill": true, "focus": "tile" },
    "channel_rows": { "height": 34, "gap": 2, "inset": 8,
                      "separator": { "colour": "#2a2c33", "width": 1, "inset": [8, 8] },
                      "selected": { "underline": { "colour": "#7aa2ff", "width": 2, "offset": 2 } },
                      "meta": { "unread": "badge", "voice": "voice · {n}" },
                      "headers": { "case": "upper", "text": "{name}" } },
    "member_rows": { "height": 42, "status": "dot",
                     "meta": { "idle": "away", "listening": "listening · {detail|name}", "playing": "playing · {name}", "max_width": 120 },
                     "headers": { "text": "{role} — {n}" } }
  },
  "content": {
    "media": { "tint": { "colour": "#7aa2ff", "amount": 0.2 } },
    "avatars": { "shape": { "rounded": 10 }, "decorations": "keep", "ring": { "colour": "#7aa2ff", "width": 2 },
                 "mode": "initial", "initial": { "font": "headings", "size": 0.8, "border": { "colour": "#7aa2ff", "width": 1 },
                                                 "hover": "picture", "members": false } },
    "names": { "colours": "clamp", "styles": "keep", "nameplates": "tint" },
    "profiles": { "themes": "theme", "effects": "keep" },
    "embeds": "theme",
    "activity": "theme"
  },
  "chrome": {
    "labels": { "members_group": "{role} — {n}", "new": "New", "composer": "Message #{channel}",
                "typing": "{name} typing…", "reaction": "(+{n})" },
    "prefix": { "channel": "", "author": "" },
    "suffix": { "author": "" },
    "time": "HH:MM",
    "hide": [],
    "rail": { "mode": "icons", "width": 150 },
    "composer": { "style": "console", "caret": "block", "prompt": "", "line": "#3a3d46", "focus_line": "#7aa2ff",
                  "caret_colour": "#7aa2ffcc", "draw": 420, "typing": 38 },
    "font": "code",
    "topbar": { "workspaces": 5, "from": "servers", "centre": "{name}@{server}", "right": "{now_playing}  {time}",
                "height": 26, "size": 12, "underline": "#7aa2ff", "effect": "decrypt" },
    "members": { "columns": {} },
    "tree": { "lists": [], "colour": "faint" },
    "folders": { "open": "▾", "closed": "▸", "suffix": "/" }
  },

  "variants": {
    "dark": {
      "base": "yap",
      "colours": {
        "accent": "#7aa2ff",
        "accent-hover": "#93b4ff",
        "on-accent": "#0b1020",
        "accent-text": "#93b4ff",
        "selection": "#7aa2ff59",
        "account": "#1a1d27",
        "actions": "#23262f",
        "actions-hover": "#7aa2ff33"
      }
    },
    "light": {
      "base": "sakura",
      "colours": {
        "accent": "#3558c9",
        "accent-hover": "#2a48ad",
        "on-accent": "#ffffff",
        "accent-text": "#2a48ad"
      }
    }
  }
}
