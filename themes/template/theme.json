{
  "theme_api": 1,
  "id": "com.example.template",
  "name": "Template",
  "version": "1.0.0",
  "description": "A starting point: copy this folder, change the id and name, and make it yours.",
  "authors": ["Your Name"],
  "license": "CC0-1.0",
  "source": "https://github.com/your-name/your-theme",
  "preview": ["preview.png"],

  "shape": {
    "button": { "radius": 8 },
    "field": { "radius": 8 },
    "composer": { "radius": 12 },
    "card": { "radius": 14, "shadow": { "blur": 24, "y": 8, "colour": "#00000066" } },
    "menu": { "radius": 10 },
    "dialog": { "radius": 14 },
    "chip": { "radius": 999 },
    "toggle": { "radius": 999 },
    "avatar": { "radius": 50 },
    "radii": { "small": 4, "medium": 8, "large": 12 },
    "outline_width": 1,
    "borders": { "tile": "dashed", "divider": { "style": "dotted", "gap": 4 } }
  },
  "type": {
    "body": { "size": 15 },
    "headings": { "weight": 800, "letter_spacing": 0.2 },
    "names": { "weight": 600, "style": "ransom",
               "papers": [["#f5f1e8", "#141414"], ["#141414", "#f5f1e8"]] },
    "labels": { "letter_spacing": 1 }
  },
  "spacing": {
    "density": "default",
    "message_group_gap": 18,
    "avatar_size": 40
  },
  "motion": {
    "quick": 140,
    "popup": 160,
    "curve": "ease-out",
    "hover": "lift",
    "press": "scale",
    "open": "zoom",
    "close": "reverse"
  },
  "animations": [
    { "name": "unread breathes", "slot": "unread", "property": "opacity",
      "values": [1, 0.55, 1], "period": 2400, "easing": "ease-in-out" }
  ],
  "effects": {
    "channel.name": { "effect": "decrypt", "duration": 500 }
  },
  "art": {
    "surfaces": {
      "chat": { "texture": "paper", "colour": "#ffffff", "opacity": 0.05, "blend": "screen" },
      "sidebar": [{ "texture": "noise", "colour": "#000000", "opacity": 0.12, "scale": 2 }],
      "account": { "texture": "grain", "colour": "#ffffff", "opacity": 0.04 }
    },
    "overlays": [
      { "kind": "vignette", "opacity": 0.25 },
      { "kind": "scanlines", "size": 3, "opacity": 0.04, "on": "chat" }
    ],
    "glass": { "surfaces": ["menu", "dialog"], "blur": 16, "opacity": 0.85, "highlight": "#ffffff26" },
    "text": {
      "headings": { "shadow": { "blur": 0, "x": 0, "y": 1, "colour": "#00000099" } },
      "names": { "glow": { "colour": "#7aa2ff66", "size": 2 } }
    },
    "particles": [
      { "preset": "sparkles", "on": "message.sent", "colours": ["#7aa2ff", "#ffffff"], "count": 10 }
    ],
    "events": { "click": "ripple", "hover": "gloss", "select": { "effect": "highlighter", "colour": "#7aa2ff" }, "reaction": "stamp" },
    "foil": { "surfaces": ["card"], "opacity": 0.12 },
    "transition": { "kind": "fade", "duration": 260 }
  },
  "sounds": {
    "send": "sounds/send.wav",
    "hover": { "file": "sounds/tick.wav", "volume": 0.6 }
  },
  "icons": {
    "hash": "icons/hash.svg",
    "send-horizontal": { "file": "icons/send.svg", "colour": "accent-text" }
  },
  "layout": {
    "rail": "left",
    "members": "right",
    "composer": "bottom",
    "messages": "flat",
    "chat_avatars": true,
    "irc": { "time_width": 56, "nick_width": 120, "separator": "│" },
    "bubbles": { "max_width": 72, "radius": 18 },
    "cards": { "tilt": 0, "gap": 8, "padding": 12 }
  },

  "variants": {
    "dark": {
      "base": "yap",
      "colours": {
        "accent": "#7aa2ff",
        "accent-hover": "#93b4ff",
        "on-accent": "#0b1020",
        "accent-text": "#93b4ff",
        "selection": "#7aa2ff59",
        "account": "#1a1d27"
      }
    },
    "light": {
      "base": "sakura",
      "colours": {
        "accent": "#3558c9",
        "accent-hover": "#2a48ad",
        "on-accent": "#ffffff",
        "accent-text": "#2a48ad"
      }
    }
  }
}
