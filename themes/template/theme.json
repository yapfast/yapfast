{
  "theme_api": 1,
  "id": "com.example.template",
  "name": "Template",
  "version": "1.0.0",
  "description": "A starting point: copy this folder, change the id and name, and make it yours.",
  "authors": ["Your Name"],
  "license": "CC0-1.0",
  "source": "https://github.com/your-name/your-theme",
  "preview": ["preview.png"],

  "shape": {
    "button": { "radius": 8 },
    "field": { "radius": 8 },
    "composer": { "radius": 12 },
    "card": { "radius": 14, "shadow": { "blur": 24, "y": 8, "colour": "#00000066" } },
    "menu": { "radius": 10 },
    "dialog": { "radius": 14 },
    "chip": { "radius": 999 },
    "toggle": { "radius": 999 },
    "avatar": { "radius": 50 },
    "actions": { "radius": 10, "shadow": { "blur": 12, "y": 4, "colour": "#00000055" } },
    "row": { "radius": 6, "inset": [8, 1], "stripe": { "colour": "#ffffff05", "lists": ["members"] } },
    "label": { "radius": 6, "case": "as written" },
    "header": { "border": 0 },
    "card_section": { "radius": 8, "bar": "#ffffff0d" },
    "radii": { "small": 4, "medium": 8, "large": 12 },
    "outline_width": 1,
    "borders": { "tile": "dashed", "divider": { "style": "dotted", "gap": 4 }, "actions": "solid" }
  },
  "type": {
    "body": { "size": 15 },
    "headings": { "weight": 800, "letter_spacing": 0.2 },
    "names": { "weight": 600, "style": "ransom",
               "papers": [["#f5f1e8", "#141414"], ["#141414", "#f5f1e8"]] },
    "labels": { "letter_spacing": 1 },
    "small": { "size": 13 },
    "time": { "size": 12, "weight": 500 }
  },
  "spacing": {
    "density": "default",
    "message_group_gap": 18,
    "avatar_size": 40
  },
  "motion": {
    "quick": 140,
    "popup": 160,
    "curve": "ease-out",
    "hover": "lift",
    "press": "scale",
    "open": "zoom",
    "close": "reverse"
  },
  "animations": [
    { "name": "unread breathes", "slot": "unread", "property": "opacity",
      "values": [1, 0.55, 1], "period": 2400, "easing": "ease-in-out" }
  ],
  "effects": {
    "channel.name": { "effect": "decrypt", "duration": 500 }
  },
  "art": {
    "surfaces": {
      "chat": { "texture": "paper", "colour": "#ffffff", "opacity": 0.05, "blend": "screen" },
      "sidebar": [{ "texture": "noise", "colour": "#000000", "opacity": 0.12, "scale": 2 }],
      "account": { "texture": "grain", "colour": "#ffffff", "opacity": 0.04 },
      "actions": { "texture": "grain", "colour": "#ffffff", "opacity": 0.04 },
      "footer": { "texture": "halftone", "colour": "#7aa2ff", "opacity": 0.06 }
    },
    "footer_height": 48,
    "overlays": [
      { "kind": "vignette", "opacity": 0.25 },
      { "kind": "scanlines", "size": 3, "opacity": 0.04, "on": "chat" }
    ],
    "glass": { "surfaces": ["menu", "dialog"], "blur": 16, "opacity": 0.85, "highlight": "#ffffff26" },
    "text": {
      "headings": { "shadow": { "blur": 0, "x": 0, "y": 1, "colour": "#00000099" } },
      "names": { "glow": { "colour": "#7aa2ff66", "size": 2 } },
      "body": { "glow": { "colour": "#7aa2ff1a", "size": 1 } }
    },
    "particles": [
      { "preset": "sparkles", "on": "message.sent", "colours": ["#7aa2ff", "#ffffff"], "count": 10 }
    ],
    "events": { "click": "ripple", "hover": "gloss", "select": { "effect": "highlighter", "colour": "#7aa2ff" }, "reaction": "stamp", "row": "none" },
    "foil": { "surfaces": ["card"], "opacity": 0.12 },
    "transition": { "kind": "fade", "duration": 260 }
  },
  "sounds": {
    "send": "sounds/send.wav",
    "hover": { "file": "sounds/tick.wav", "volume": 0.6 }
  },
  "icons": {
    "hash": "icons/hash.svg",
    "send-horizontal": { "file": "icons/send.svg", "colour": "accent-text" }
  },
  "cursors": {
    "default": { "image": ["cursors/default.png", "cursors/default@2x.png"], "hotspot": [16, 16] },
    "pointer": { "image": ["cursors/pointer.png", "cursors/pointer@2x.png"], "hotspot": [16, 16] }
  },
  "layout": {
    "rail": "left",
    "members": "right",
    "composer": "bottom",
    "messages": "flat",
    "chat_avatars": true,
    "members_style": "list",
    "grid": { "columns": 3, "size": 56 },
    "tree": { "expand": "one", "root": "~/", "dms": "dm" },
    "irc": { "time_width": 56, "nick_width": 120, "separator": "│", "rule": false },
    "bubbles": { "max_width": 72, "radius": 18 },
    "cards": { "tilt": 0, "gap": 8, "padding": 12,
               "shadow": { "blur": 0, "x": 4, "y": 4, "colour": "#00000040" },
               "art": [{ "texture": "paper", "colour": "#f5f1e8", "opacity": 0.8, "position": "top",
                         "size": [72, 18], "rotation": -3 }],
               "tab": { "text": "{name}", "font": "labels", "size": 11, "colour": "#141414" } }
  },
  "content": {
    "media": { "tint": { "colour": "#7aa2ff", "amount": 0.2 } },
    "avatars": { "shape": { "rounded": 10 }, "decorations": "keep", "ring": { "colour": "#7aa2ff", "width": 2 } },
    "names": { "colours": "clamp", "styles": "keep", "nameplates": "tint" },
    "profiles": { "themes": "theme", "effects": "keep" },
    "embeds": "theme",
    "activity": "theme"
  },
  "chrome": {
    "labels": { "members_group": "{role} — {n}", "new": "New", "composer": "Message #{channel}",
                "typing": "{name} typing…", "reaction": "(+{n})",
                "topic": "{topic}", "member_count": "", "day": "{date}" },
    "prefix": { "channel": "", "author": "", "member_by_role": [""] },
    "system": { "join": "", "leave": "", "notice": "" },
    "status": { "text": "{channel} · {typing}", "position": "below" },
    "suffix": { "author": "" },
    "time": "HH:MM",
    "hide": [],
    "rail": { "mode": "icons", "width": 150 },
    "composer": { "caret": "line", "prompt": "" },
    "members": { "columns": {} },
    "tree": { "lists": [], "colour": "faint", "counts": { "mentions": "", "unread": "" } },
    "box": { "panes": [], "chars": "┌┐└┘─│", "title": "[ {name} ]", "titles": { "members": "[ {name}: {n} ]" },
             "colour": "faint", "size": 14 },
    "folders": { "open": "▾", "closed": "▸", "suffix": "/" }
  },

  "variants": {
    "dark": {
      "base": "yap",
      "content": { "names": { "palette": ["#7aa2ff", "#93e0b3", "#f5c27a", "#e79bd8"] } },
      "colours": {
        "accent": "#7aa2ff",
        "accent-hover": "#93b4ff",
        "on-accent": "#0b1020",
        "accent-text": "#93b4ff",
        "selection": "#7aa2ff59",
        "account": "#1a1d27",
        "actions": "#23262f",
        "actions-hover": "#7aa2ff33",
        "mention-chip": "#93b4ff"
      }
    },
    "light": {
      "base": "sakura",
      "content": { "media": { "dither": { "palette": ["#2b2140", "#9a6fb0", "#fbeef3"], "matrix": 4, "scale": 1 } } },
      "colours": {
        "accent": "#3558c9",
        "accent-hover": "#2a48ad",
        "on-accent": "#ffffff",
        "accent-text": "#2a48ad"
      }
    }
  }
}
