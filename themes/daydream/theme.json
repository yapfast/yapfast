      "property": "scale",
      "values": [
        1,
        1.12,
        1,
        1.12,
        1,
        1.12,
        1
      ],
      "period": 4800,
      "easing": "ease-in-out",
      "repeat": "once"
    },
    {
      "name": "typing dots float",
      "slot": "typing",
      "property": "y",
      "values": [
        0,
        -1.5,
        0
      ],
      "period": 1400,
      "easing": "ease-in-out",
      "steps": 6
    },
    {
      "name": "own avatar floats",
      "slot": "own.avatar",
      "property": "y",
      "values": [
        0,
        -1.5,
        0
      ],
      "period": 5200,
      "easing": "ease-in-out",
      "delay": 900,
      "steps": 12
    },
    {
      "name": "server bubbles bob, out of step",
      "slot": "rail.icon",
      "property": "y",
      "values": [
        0,
        -2,
        0
      ],
      "period": 4200,
      "easing": "ease-in-out",
      "phase": 350,
      "steps": 8
    }
