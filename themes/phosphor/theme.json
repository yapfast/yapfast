  "layout": {
    "messages": "irc",
    "chat_avatars": false,
    "irc": {
      "time_width": 64,
      "nick_width": 100,
      "separator": "│",
      "rule": true
    },
    "rail": "tree",
    "tree": {
      "expand": "one",
      "root": "~/",
      "dms": "dm"
    }
  },
  "chrome": {
    "labels": {
      "members_title": "$ who",
      "members_group": "{role}/ ({n})",
      "composer": "⠀msg #{channel}",
      "new": "─── new ───",
      "typing": "-!- {name} is typing",
      "welcome": "*** now talking in #{channel}",
      "start": "-!- start of #{channel} log",
      "rail_title": "~/servers",
      "rail_home": "~/dm",
      "rail_footer": "$ cd {server}",
      "tree_root": "~/{server}",
      "reaction": "(+{n})",
      "day": "-- Day changed to {date} --",
      "member_count": "[{n} users]",
      "topic": "[{topic}]"
    },
    "prefix": {
      "author": "<",
      "member_by_role": [
        "@",
        "+"
      ]
    },
    "suffix": {
      "author": ">",
      "server": "/"
    },
    "time": "[HH:MM]",
    "folders": {
      "open": "▾",
      "closed": "▸",
      "suffix": "/"
    },
    "hide": [
      "member-avatars",
      "header-buttons",
      "account-avatar",
      "reaction-chips",
      "activity-cards"
    ],
    "rail": {
      "mode": "text",
      "width": 168
    },
    "composer": {
      "caret": "block",
      "prompt": "$"
    },
    "members": {
      "columns": {
        "online": "pts/{n}",
        "idle": "idle",
        "dnd": "busy",
        "offline": "-",
        "streaming": "live"
      }
    },
    "tree": {
      "lists": [
        "channels",
        "members",
        "dms",
        "rail",
        "replies"
      ],
      "colour": "faint",
      "counts": {
        "mentions": "[{n}!]",
        "unread": "(*)",
        "colour": "loud"
      }
    },
    "box": {
      "title": "[ {name} ]",
      "titles": {
        "members": "[ who: {n} ]"
      },
      "colour": "muted",
      "size": 14
    },
    "status": {
      "text": "[{time}] [{name}] [{server}/{channel}] {typing} [act: {unread_channels}]",
      "position": "below"
    },
    "system": {
      "join": "-->",
      "leave": "<--",
      "notice": "-!-"
    }
  },
  "content": {
    "media": {
      "dither": {
        "palette": [
          "#020A04",
          "#1F5530",
          "#4FC46E",
