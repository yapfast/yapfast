    (call $store_u8 (i64.add (local.get $buffer) (i64.const 35)) (i32.const 101))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 36)) (i32.const 100))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 37)) (i32.const 45))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 38)) (i32.const 114))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 39)) (i32.const 111))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 40)) (i32.const 111))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 41)) (i32.const 109))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 42)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 43)) (i32.const 44))
