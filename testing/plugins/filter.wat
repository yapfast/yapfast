;; A filter: the plugin an outgoing message stops at, and the one a chain
;; rewrites the text in. `yf_hook` answers with a draft of its own, which the
;; chain carries forward and the send then goes out with.
;;
;; A hand-written fixture can't read the JSON it was handed, so the draft it
;; answers with is fixed: the room and the body both come from here rather than
;; from the composer. That is what a test asserts it sees, so a fixture that
;; names its own room makes the point stronger rather than weaker — everything
;; about the message is the chain's answer, and nothing of the draft the person
;; typed.
;;
;; The answer is this, 81 bytes of it:
;;   {"changed":{"draft":{"room":"filtered-room","body":"filtered","attachments":[]}}}
;;
;; Extism calls an export with no arguments and reads the answer out of the
;; guest's memory, so every export here takes nothing and returns a status: 0
;; means the call succeeded. The bytes go in one at a time, which is the whole
;; of what `store_u8` does and all a fixture this size needs.
(module
  (import "extism:host/env" "alloc" (func $alloc (param i64) (result i64)))
  (import "extism:host/env" "store_u8" (func $store_u8 (param i64 i32)))
  (import "extism:host/env" "output_set" (func $output_set (param i64 i64)))

  (func $answer_filtered
    (local $buffer i64)
    (local.set $buffer (call $alloc (i64.const 81)))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 0)) (i32.const 123))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 1)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 2)) (i32.const 99))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 3)) (i32.const 104))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 4)) (i32.const 97))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 5)) (i32.const 110))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 6)) (i32.const 103))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 7)) (i32.const 101))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 8)) (i32.const 100))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 9)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 10)) (i32.const 58))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 11)) (i32.const 123))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 12)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 13)) (i32.const 100))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 14)) (i32.const 114))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 15)) (i32.const 97))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 16)) (i32.const 102))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 17)) (i32.const 116))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 18)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 19)) (i32.const 58))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 20)) (i32.const 123))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 21)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 22)) (i32.const 114))
