    (call $store_u8 (i64.add (local.get $buffer) (i64.const 68)) (i32.const 104))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 69)) (i32.const 109))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 70)) (i32.const 101))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 71)) (i32.const 110))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 72)) (i32.const 116))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 73)) (i32.const 115))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 74)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 75)) (i32.const 58))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 76)) (i32.const 91))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 77)) (i32.const 93))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 78)) (i32.const 125))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 79)) (i32.const 125))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 80)) (i32.const 125))
    (call $output_set (local.get $buffer) (i64.const 81)))

  (func (export "yf_activate") (result i32) (i32.const 0))
  (func (export "yf_deactivate") (result i32) (i32.const 0))
  (func (export "yf_event") (result i32) (i32.const 0))
  (func (export "yf_hook")
    (result i32)
    (call $answer_filtered)
    (i32.const 0))
  (func (export "yf_command") (result i32) (i32.const 0))
  (func (export "yf_decorate") (result i32) (i32.const 0))
)
