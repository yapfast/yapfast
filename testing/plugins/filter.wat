    (call $store_u8 (i64.add (local.get $buffer) (i64.const 47)) (i32.const 100))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 48)) (i32.const 121))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 49)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 50)) (i32.const 58))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 51)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 52)) (i32.const 102))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 53)) (i32.const 105))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 54)) (i32.const 108))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 55)) (i32.const 116))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 56)) (i32.const 101))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 57)) (i32.const 114))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 58)) (i32.const 101))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 59)) (i32.const 100))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 60)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 61)) (i32.const 44))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 62)) (i32.const 34))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 63)) (i32.const 97))
    (call $store_u8 (i64.add (local.get $buffer) (i64.const 64)) (i32.const 116))
