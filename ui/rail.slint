import { DmHeading } from "yapfast/dm-heading.slint";
import { NewTag } from "yapfast/new-tags.slint";
import { ClientStyle } from "yapfast/style.slint";
import { ListView } from "scrollview.slint";
import { Theme, Tip, Middle, Label } from "theme.slint";
import { Avatar, Nameplate, PictureStore, StatusText, StyledName, NameStyleRow, VoiceSpot, ServerTagChip } from "controls.slint";
import { DiscordBadge } from "discord.slint";
import { PersonRow, LivePill } from "voice.slint";

/// A server in a closed folder's tile: its icon, or its initial.
export struct FolderServer { initial: string, picture-url: string }

export struct ServerRow {
    id: string, name: string, initial: string, picture: image, selected: bool, unread: bool, discord: bool,
    /// A Discord server out of reach in an outage, shown as last known.
    unavailable: bool,
    /// Mentions waiting in its channels, such as "3" or "99+"; empty for none.
    badge: string,
    /// This account is in a call in one of its voice channels; on a closed
    /// folder, in one of its servers'.
    call: bool,
    picture-url: string,
    /// A folder of servers rather than a server: `id` is the folder's, `name`
    /// its tooltip, and `selected`, `unread` and `badge` sum up its servers.
    /// Open, its servers follow it, `nested`, the last of them `last`.
    folder: bool, open: bool, nested: bool, last: bool,
    /// The folder's colour, on a folder and its servers.
    tint: color,
    /// A closed folder's first four servers.
    preview: [FolderServer],
    /// An unread DM above the servers, as in Discord: `id` is its room's,
    /// `picture-url` its avatar or group icon, and `badge` its unread messages.
    dm: bool,
    /// The line between those DMs and the servers.
    divider: bool,
}

export struct RoomRow {
    id: string, name: string, heading: string, icon: image, selected: bool, unread: bool, badge: string,
    voice: bool, direct: bool, initial: string, tint: color,
    /// A voice channel with a chat to open.
    chat: bool,
    /// A DM's avatar or group icon, and whether it's a Discord DM.
    picture: image, discord: bool,
    picture-url: string,
    /// The address of the decoration around a one-to-one DM's avatar, its
    /// person's nameplate's picture with its palette's colours on a dark theme
    /// and a light one, and how their name is drawn.
    decoration-url: string, nameplate-url: string, nameplate-color: color, nameplate-light: color, name-style: [NameStyleRow],
    /// Listed but not open to join, such as a Discord channel the account's roles keep it out of.
    locked: bool,
    /// A one-to-one DM, whose other person has a profile.
    person: bool,
    /// Who is in a Discord voice channel, shown without joining it.
    people: [PersonRow],
    /// A DM with a call going on.
    call: bool,
    /// The server tag a one-to-one DM's person wears, and its badge's address.
    tag: string, tag-badge: string,
    /// Discord's own account, marked OFFICIAL.
    official: bool,
    /// The person's id when no one has written in this one-to-one DM yet, so a
    /// Wave button is offered; empty otherwise.
    wave: string,
    /// A one-to-one Discord DM's other person: "online", "mobile", "idle",
    /// "dnd" or "offline", empty when unknown; and their custom status or what
    /// they're doing, or a group DM's size, and the address of the picture of
    /// the status's custom emoji.
    presence: string,
    detail: string, detail-emoji: string,
    /// The server voice channel a one-to-one Discord DM's other person is
    /// in, by room id, with its name and its server's; the room is empty
    /// when they're in none.
    voice-room: string, voice-channel: string, voice-server: string,
    /// Its heading's category is collapsed; and the row is only that heading,
    /// for a category with nothing left showing.
    collapsed: bool,
    hidden: bool,
    /// What its heading folds by: a Discord category's room id, which tells
    /// apart categories of the same name, or else the heading.
    category: string,
    /// A DM pinned to the top of the list, or a Discord channel, or its
    /// thread, among its server's pinned channels; and a DM or channel whose
    /// notifications are muted.
    pinned: bool,
    muted: bool,
    /// A Discord thread, listed under its channel, and whether another of
    /// that channel's threads follows it.
    thread: bool,
    thread-continues: bool,
    /// Where its channel, and its heading's category, come among the rows
    /// a Discord channel list drags and drops, counting from 1; 0 for
    /// neither, such as a thread or a pinned channel.
    place: int, heading-place: int,
}

// A call going on in a server: a white speaker on green, on a thin ring of
// the rail's colour, at the top right of its icon. The speaker is drawn bold,
// and a dark copy of it a pixel lower is its shadow, which the light green
// needs at this size.
component CallBubble inherits Rectangle {
    width: 20px; height: 20px; border-radius: self.width / 2;
    background: Theme.rail;
    Rectangle {
        width: 16px; height: 16px; border-radius: self.width / 2;
        background: Theme.live;
        Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 + 1px;
            source: @image-url("icons/volume-2-bold.svg"); width: 12px; height: 12px;
            colorize: #000000; opacity: 0.45;
        }
        Image { source: @image-url("icons/volume-2-bold.svg"); width: 12px; height: 12px; colorize: #ffffff; }
    }
}

// A server or the DM home: a circle that becomes a squircle, with a pill at the rail edge.
export component RailItem inherits Rectangle {
    in property <string> label;
    /// The tooltip; the accessible label may add state such as "unread".
    in property <string> tip: root.label;
    in property <string> initial;
    in property <image> icon;
    /// The icon's colour and size while the item isn't lit.
    in property <color> icon-color: Theme.text;
    in property <length> icon-size: 24px;
    /// The server's own icon, filling the item instead of the initial.
    in property <image> picture;
    in property <string> picture-url;
    property <image> shown-picture: root.picture-url != "" ? PictureStore.picture(root.picture-url, PictureStore.revision(root.picture-url)) : root.picture;
    function request-picture() {
        if root.picture-url != "" && root.shown-picture.width == 0 {
            PictureStore.request(root.picture-url);
        }
    }
    init => { root.request-picture(); }
    changed picture-url => { root.request-picture(); }
    changed shown-picture => { root.request-picture(); }
    in property <bool> selected;
    in property <bool> unread;
    /// Mentions waiting, at the bottom right as in Discord; empty for none.
    in property <string> badge;
    /// In a call here, shown at the top right.
    in property <bool> call;
    /// Marks a Discord server.
    in property <bool> discord;
    callback clicked;
    /// A right click, or the Menu key or Shift+F10 when focused: where to open
    /// a menu in the window.
    callback context-menu(length, length);
    property <length> tile-size: ClientStyle.rail-tile;
    property <length> tile-left: (root.width - root.tile-size) / 2;
    width: 72px; height: root.tile-size;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <bool> lit: root.selected || pointer.has-hover;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 4px;
        height: root.selected ? 40px : pointer.has-hover ? 20px : root.unread ? 8px : 0px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px;
        background: Theme.text;
        animate height { duration: 200ms; easing: ease-out; }
    }
    // A picture only changes shape when lit, as in Discord.
    tile := Rectangle {
        x: root.tile-left; width: root.tile-size; height: root.tile-size;
        border-radius: ClientStyle.enabled ? 12px : root.lit ? 16px : 24px;
        background: root.lit && root.shown-picture.width == 0 ? Theme.accent : Theme.raised;
        animate border-radius, background { duration: 160ms; easing: ease-out; }
        clip: true;
        if root.shown-picture.width > 0: Image {
            source: root.shown-picture; width: root.tile-size; height: root.tile-size; image-fit: cover;
        }
        if root.icon.width > 0: Image {
            source: root.icon; width: root.icon-size; height: root.icon-size;
            colorize: root.lit ? Theme.on-accent : root.icon-color;
        }
        if root.icon.width == 0 && root.shown-picture.width == 0: Text {
            text: root.initial; font-size: ClientStyle.enabled ? 16px : 17px; font-weight: ClientStyle.enabled ? 500 : 700;
            color: root.lit ? Theme.on-accent : Theme.text;
        }
        // The focus ring, drawn over the picture.
        Rectangle {
            width: root.tile-size; height: root.tile-size; border-radius: tile.border-radius;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.text;
        }
    }
    // Discord's logo on its blurple, at the top left on a ring of the rail's
    // colour so it reads as a tag.
    if root.discord: DiscordBadge {
        x: root.tile-left - 2px; y: (parent.height - root.tile-size) / 2 - 2px;
        size: 16px; ring: Theme.rail;
    }
    if root.call: CallBubble { x: root.tile-left + root.tile-size + 3px - self.width; y: (parent.height - root.tile-size) / 2 - 3px; }
    // The mention count, on a ring of the rail's colour.
    if root.badge != "": Rectangle {
        x: root.tile-left + root.tile-size + 4px - self.width; y: (parent.height + root.tile-size) / 2 + 4px - self.height;
        width: max(16px, badge-text.preferred-width + 8px) + 6px; height: 16px + 6px; border-radius: self.height / 2;
        background: Theme.rail;
        Rectangle {
            width: parent.width - 6px; height: parent.height - 6px; border-radius: self.height / 2;
            background: Theme.danger;
            badge-text := Text { text: root.badge; color: Theme.on-danger; font-size: 12px; font-weight: 700; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-menu(self.absolute-position.x + 60px, self.absolute-position.y + 24px);
                return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.tip;
                    Tip.side = 1;
                    Tip.x = root.absolute-position.x + root.width;
                    Tip.y = root.absolute-position.y + root.height / 2;
                } else if Tip.text == root.tip {
                    Tip.text = "";
                }
            }
        }
    }
}

// A folder of servers, as in Discord: closed, a tile of its colour holding its
// first four servers' icons; open, a folder in its colour, with its servers
// below it. Clicking opens or closes it.
component FolderItem inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> open;
    in property <color> tint;
    in property <[FolderServer]> servers;
    /// One of its servers is selected, which shows while it's closed.
    in property <bool> selected;
    in property <bool> unread;
    in property <string> badge;
    /// In a call in one of its servers, shown at the top right while closed.
    in property <bool> call;
    callback clicked;
    /// A right click, or the Menu key or Shift+F10 when focused: where to open
    /// a menu in the window.
    callback context-menu(length, length);
    property <length> tile-size: ClientStyle.folder-tile;
    property <length> tile-left: (root.width - root.tile-size) / 2;
    width: 72px; height: root.tile-size;
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }
    accessible-action-expand => { root.clicked(); }
    forward-focus: focus;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 4px;
        height: root.open ? 0px : root.selected ? 40px : pointer.has-hover ? 20px : root.unread ? 8px : 0px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px;
        background: Theme.text;
        animate height { duration: 200ms; easing: ease-out; }
    }
    tile := Rectangle {
        x: root.tile-left; width: root.tile-size; height: root.tile-size; border-radius: ClientStyle.folder-radius;
        background: root.open ? transparent : root.tint.with-alpha(pointer.has-hover ? 0.55 : 0.4);
        animate background { duration: 160ms; easing: ease-out; }
        if root.open: Image {
            source: @image-url("icons/folder.svg"); width: 24px; height: 24px; colorize: root.tint;
        }
        if !root.open: Rectangle {
            for server[index] in root.servers: Avatar {
                x: (ClientStyle.enabled ? 4px : 6px) + Math.mod(index, 2) * (ClientStyle.enabled ? 21px : 20px); y: (ClientStyle.enabled ? 4px : 6px) + floor(index / 2) * (ClientStyle.enabled ? 21px : 20px);
                size: ClientStyle.enabled ? 19px : 16px; corner: ClientStyle.enabled ? 4px : -1px;
                corner-tl: ClientStyle.enabled && index == 0 ? 13px : -1px; corner-tr: ClientStyle.enabled && index == 1 ? 13px : -1px;
                corner-bl: ClientStyle.enabled && index == 2 ? 13px : -1px; corner-br: ClientStyle.enabled && index == 3 ? 13px : -1px;
                initial: server.initial; picture-url: server.picture-url; tint: Theme.raised;
            }
        }
        Rectangle {
            width: root.tile-size; height: root.tile-size; border-radius: ClientStyle.folder-radius;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.text;
        }
    }
    // Its servers are Discord's, so it carries Discord's mark as they do.
    if !root.open: DiscordBadge {
        x: root.tile-left - 2px; y: (parent.height - root.tile-size) / 2 - 2px;
        size: 16px; ring: Theme.rail;
    }
    if root.call && !root.open: CallBubble { x: root.tile-left + root.tile-size + 3px - self.width; y: (parent.height - root.tile-size) / 2 - 3px; }
    if root.badge != "" && !root.open: Rectangle {
        x: root.tile-left + root.tile-size + 4px - self.width; y: (parent.height + root.tile-size) / 2 + 4px - self.height;
        width: max(16px, badge-text.preferred-width + 8px) + 6px; height: 16px + 6px; border-radius: self.height / 2;
        background: Theme.rail;
        Rectangle {
            width: parent.width - 6px; height: parent.height - 6px; border-radius: self.height / 2;
            background: Theme.danger;
            badge-text := Text { text: root.badge; color: Theme.on-danger; font-size: 12px; font-weight: 700; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-menu(self.absolute-position.x + 60px, self.absolute-position.y + 24px);
                return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.tip;
                    Tip.side = 1;
                    Tip.x = root.absolute-position.x + root.width;
                    Tip.y = root.absolute-position.y + root.height / 2;
                } else if Tip.text == root.tip {
                    Tip.text = "";
                }
            }
        }
    }
}

// A presence dot on a ring cut from the background, as in Discord: green when
// online, a green phone standing up from it when online only on a phone, a
// moon when idle, a bar when they don't want to be disturbed, and a grey ring
// when offline. Anything else counts as offline.
export component StatusDot inherits Rectangle {
    in property <string> presence;
    in property <color> ring;
    property <bool> mobile: root.presence == "mobile";
    property <bool> online: root.presence == "online" || root.mobile || root.presence == "idle" || root.presence == "dnd";
    width: 16px; height: 16px; border-radius: 8px;
    background: root.mobile ? transparent : root.ring;
    accessible-role: image;
    accessible-label: root.presence == "dnd" ? "Do not disturb" : root.presence == "idle" ? "Idle" : root.presence == "online" ? "Online" : root.mobile ? "Online on mobile" : "Offline";
    // Idle is Discord's yellow whatever the accent is, and its moon a size larger.
    if !root.mobile: Rectangle {
        width: root.presence == "idle" ? 12px : 10px; height: self.width; border-radius: self.width / 2;
        background: root.presence == "dnd" ? #f23f43 : root.presence == "idle" ? #f0b232 : root.presence == "online" ? Theme.live : Theme.faint;
    }
    if !root.online: Rectangle {
        width: 4px; height: 4px; border-radius: 2px; background: root.ring;
    }
    if root.presence == "idle": Rectangle {
        x: 1px; y: 1px; width: 7px; height: 7px; border-radius: 3.5px; background: root.ring;
    }
    if root.presence == "dnd": Rectangle {
        width: 6px; height: 2px; border-radius: 1px; background: root.ring;
    }
    // The phone keeps the dot's ring and bottom edge, and stands taller.
    if root.mobile: Rectangle {
        y: root.height - self.height; height: root.height + 5px;
        border-radius: 4px; background: root.ring;
        Rectangle {
            width: 10px; height: 15px; border-radius: 2px; background: Theme.live;
            Rectangle { x: 2px; y: 2px; width: 6px; height: 9px; border-radius: 1px; background: root.ring; }
            Rectangle { x: 4px; y: 12px; width: 2px; height: 2px; border-radius: 1px; background: root.ring; }
        }
    }
}

// A channel or DM in the sidebar.
export component ChannelRow inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> person;
    in property <string> initial;
    in property <color> tint;
    in property <image> picture;
    in property <string> picture-url;
    in property <string> decoration-url;
    in property <[NameStyleRow]> name-style;
    /// As RoomRow has them.
    in property <string> nameplate-url;
    in property <color> nameplate-color;
    in property <color> nameplate-light;
    /// Marks a Discord DM, as the rail marks Discord servers.
    in property <bool> discord;
    in property <bool> selected;
    /// Red, as a settings sidebar's Delete Channel or Delete Server.
    in property <bool> danger;
    in property <bool> unread;
    in property <string> badge;
    /// Marks a settings page with something new on it.
    in property <bool> fresh;
    /// A channel this account may not join: drawn faint.
    in property <bool> locked;
    /// A DM with a call going on.
    in property <bool> call;
    /// Their person's server tag, as RoomRow has it, whether they are Discord's
    /// own account, and a Wave button for an empty DM (the person's id).
    in property <string> tag;
    in property <string> tag-badge;
    in property <bool> official;
    in property <string> wave;
    callback waved;
    /// A DM pinned to the top of the list.
    in property <bool> pinned;
    /// A DM or channel whose notifications are muted: drawn faint until it's selected or pointed at.
    in property <bool> muted;
    /// A DM person's presence, as RoomRow has it, and a line under the name.
    in property <string> presence;
    in property <string> detail;
    in property <string> detail-emoji;
    /// The server voice channel their person is in, as RoomRow has it.
    in property <string> voice-channel;
    in property <string> voice-server;
    /// A Discord thread, which the line from its channel marks in place of an icon.
    in property <bool> thread;
    /// A voice channel with a chat, which a button on the row opens.
    in property <bool> chat;
    /// It may be dragged: once the pointer has moved a few pixels with the
    /// button down, `start-drag` asks whether it may, given how far down
    /// the row it was pressed, `dragged` says where the pointer is in the
    /// window, and `dropped` that the button went up, which doesn't click
    /// it.
    in property <bool> draggable;
    callback start-drag(length) -> bool;
    callback dragged(length);
    callback dropped;
    /// Another row is being dragged, which may have scrolled out of the
    /// list and stopped following the pointer: this row says where the
    /// pointer is and when the button goes up in its place.
    in property <bool> tracking;
    property <bool> dragging;
    // Refused until the button goes down again.
    property <bool> refused;
    callback clicked;
    /// Their person's voice channel was clicked, to go to it.
    callback open-voice;
    callback open-chat;
    /// A right click, or the Menu key or Shift+F10 when focused: where to open
    /// a menu in the window.
    callback context-menu(length, length);
    property <bool> in-voice: root.voice-channel != "";
    property <bool> has-detail: root.detail != "" || root.detail-emoji != "";
    property <bool> offers-wave: root.wave != "" && (pointer.has-hover || root.selected);
    height: root.person ? ClientStyle.dm-row-height : ClientStyle.channel-row-height;
    border-radius: 6px;
    background: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.danger ? Theme.danger : root.locked ? (root.selected ? Theme.muted : Theme.faint) : root.selected || root.unread ? Theme.text : pointer.has-hover ? Theme.secondary : Theme.muted;
    // Discord's client draws a DM row's plate only while the row is selected,
    // pointed at or focused, so a long list holds none. It stops short of the
    // focus ring.
    if root.nameplate-url != "" && (root.selected || pointer.has-hover || focus.has-focus): Nameplate {
        x: root.border-width; y: root.border-width;
        width: root.width - root.border-width * 2; height: root.height - root.border-width * 2;
        radius: root.border-radius - root.border-width; channel: true;
        picture-url: root.nameplate-url; palette: Theme.dark ? root.nameplate-color : root.nameplate-light;
        hovered: pointer.has-hover; selected: root.selected; animate: pointer.has-hover;
        ground: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : Theme.sidebar;
        content-width: text-column.x + min(text-column.preferred-width, text-column.width);
    }
    // Unread activity is marked at the sidebar's edge, as on the server rail.
    if root.unread && !root.selected: Rectangle {
        // A thread sits further in, past the line from its channel.
        x: root.thread ? -36px : -8px; y: (parent.height - self.height) / 2; width: 4px; height: 8px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: Theme.text;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-menu(self.absolute-position.x + 16px, self.absolute-position.y + self.height);
                return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            // Slint reports the click before the button going up, which
            // ends a drag.
            clicked => {
                if !root.dragging { root.clicked(); }
            }
            moved => {
                if self.pressed && root.draggable && !root.dragging && !root.refused && abs(self.mouse-y - self.pressed-y) > 4px {
                    root.dragging = root.start-drag(self.pressed-y);
                    root.refused = !root.dragging;
                }
                if root.dragging { root.dragged(self.absolute-position.y + self.mouse-y); }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.refused = false;
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && (root.dragging || root.tracking) {
                    root.dragging = false;
                    root.dropped();
                }
                if event.kind == PointerEventKind.move && root.tracking && !root.dragging {
                    root.dragged(self.absolute-position.y + self.mouse-y);
                }
            }
            // The row's contents sit in its pointer area, so a voice spot in
            // them takes its own clicks while the row stays hovered.
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: root.person ? 12px : 8px;
                opacity: root.muted && !root.selected && !pointer.has-hover ? 0.5 : 1;
                if root.person: Middle {
                    Avatar {
                        size: 32px; initial: root.initial; tint: root.tint; picture: root.picture; picture-url: root.picture-url;
                        decoration-url: root.decoration-url; animate: pointer.has-hover;
                        if root.discord: DiscordBadge {
                            x: -2px; y: -2px; size: 13px;
                            ring: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : Theme.sidebar;
                        }
                        if root.presence != "": StatusDot {
                            x: 20px; y: 20px; presence: root.presence;
                            ring: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : Theme.sidebar;
                        }
                    }
                }
                if !root.person && !root.thread: Image { source: root.icon; width: 20px; image-fit: contain; colorize: root.danger ? Theme.danger : root.selected && ClientStyle.enabled ? Theme.text : root.selected || root.unread ? Theme.secondary : Theme.faint; }
                text-column := VerticalLayout {
                    alignment: center; spacing: 0px; horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start; spacing: 4px;
                        if root.name-style.length == 0: Text {
                            text: root.text; color: root.ink; font-size: ClientStyle.text-size; font-weight: ClientStyle.enabled ? 500 : root.unread ? 700 : root.selected ? 700 : 500;
                            vertical-alignment: center; overflow: elide; horizontal-stretch: 0;
                        }
                        if root.name-style.length > 0: StyledName {
                            text: root.text; styles: root.name-style; ink: root.ink; font-size: ClientStyle.text-size; font-weight: ClientStyle.enabled ? 500 : root.unread ? 700 : root.selected ? 700 : 500;
                        }
                        if root.tag != "": Middle { ServerTagChip { text: root.tag; badge: root.tag-badge; } }
                        if root.official: Middle {
                            Rectangle {
                                // Discord's verified-style badge: blurple, 16px, a check and OFFICIAL.
                                height: 16px; width: official-text.preferred-width + 24px; border-radius: 4px; background: Theme.accent;
                                accessible-role: AccessibleRole.text; accessible-label: "OFFICIAL";
                                HorizontalLayout {
                                    padding-left: 4px; padding-right: 4px; spacing: 2px; alignment: center;
                                    Middle { Image { source: @image-url("icons/check.svg"); width: 12px; height: 12px; colorize: Theme.on-accent; accessible-role: none; } }
                                    official-text := Text { text: "OFFICIAL"; color: Theme.on-accent; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.official && !root.has-detail && !root.in-voice: Text {
                        text: "Official Discord Message"; color: Theme.muted; font-size: 12px; overflow: elide;
                    }
                    // Their voice channel in full when nothing else is said here,
                    // else a speaker before what is, as the friends list has it.
                    if root.in-voice && !root.has-detail: HorizontalLayout {
                        alignment: start;
                        VoiceSpot {
                            channel: root.voice-channel; server: root.voice-server; font-size: 12px;
                            clicked => { root.open-voice(); }
                        }
                    }
                    if root.has-detail: HorizontalLayout {
                        spacing: 4px;
                        if root.in-voice: VoiceSpot {
                            channel: root.voice-channel; server: root.voice-server; font-size: 12px; compact: true;
                            clicked => { root.open-voice(); }
                        }
                        StatusText { text: root.detail; emoji-url: root.detail-emoji; font-size: 12px; }
                    }
                }
                // Discord offers to wave at someone in a DM nobody has written in yet.
                if root.offers-wave: Middle {
                    Rectangle {
                        height: 24px; width: wave-label.preferred-width + 40px; border-radius: 4px;
                        background: wave-touch.has-hover ? Theme.accent-hover : Theme.accent;
                        accessible-role: button; accessible-label: "Wave";
                        accessible-action-default => { root.waved(); }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                            Middle { Image { source: @image-url("icons/hand.svg"); width: 14px; height: 14px; colorize: Theme.on-accent; accessible-role: none; } }
                            wave-label := Text { text: "Wave"; color: Theme.on-accent; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                        }
                        wave-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.waved(); }
                        }
                    }
                }
                if root.call: Image {
                    source: @image-url("icons/phone.svg"); width: 16px; image-fit: contain; colorize: Theme.live;
                    accessible-role: image; accessible-label: "In a call";
                }
                if root.pinned: Image {
                    source: @image-url("icons/pin.svg"); width: 14px; image-fit: contain; colorize: Theme.faint;
                }
                if root.fresh: Middle { NewTag { } }
                if root.badge != "": Middle {
                    Rectangle {
                        width: max(18px, badge-text.preferred-width + 10px); height: 18px; border-radius: 9px; background: Theme.danger;
                        badge-text := Text { text: root.badge; color: Theme.on-danger; font-size: 11px; font-weight: 700; }
                    }
                }
                // A voice channel's chat opens without joining it, from a
                // button shown on hover as in Discord. Like a voice spot, it
                // takes no focus, which goes to the chat's composer; the
                // row's menu opens the chat from the keyboard.
                if root.chat && (pointer.has-hover || root.selected): Middle {
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 6px;
                        background: chat-pointer.has-hover ? Theme.overlay.with-alpha(0.08) : transparent;
                        accessible-role: button;
                        accessible-label: "Open chat";
                        accessible-action-default => { root.open-chat(); }
                        chat-icon := Image {
                            source: @image-url("icons/message-square-text.svg"); width: 16px; height: 16px;
                            colorize: chat-pointer.has-hover ? Theme.text : Theme.secondary;
                        }
                        chat-pointer := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { Tip.text = ""; root.open-chat(); }
                            changed has-hover => {
                                if self.has-hover {
                                    Tip.text = "Open chat";
                                    Tip.side = 0;
                                    Tip.x = chat-icon.absolute-position.x + chat-icon.width / 2;
                                    Tip.y = chat-icon.absolute-position.y;
                                } else if Tip.text == "Open chat" {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Where a channel or category dragged in the channel list would drop: a
// line across the edge of the row it's over, as Discord draws it.
component DropLine inherits Rectangle {
    height: 4px; border-radius: 2px; background: Theme.live;
    drop-shadow-blur: 3px; drop-shadow-color: #00000066;
}

// Someone listed under a voice channel: a click opens their profile and a
// right click their menu. They may be dragged as ChannelRow may, once the
// pointer has moved a few pixels with the button down: `start-drag` asks
// whether they may, `dragged` says where the pointer is in the window, and
// `dropped` that the button went up, which doesn't click. While another
// row or person is dragged, `tracking` reports the pointer over this one,
// as ChannelRow's does.
component PersonTouch inherits TouchArea {
    callback open-profile;
    callback open-menu(length, length);
    callback start-drag() -> bool;
    callback dragged(length, length);
    callback dropped;
    in property <bool> tracking;
    property <bool> dragging;
    // Asked and refused, until the button goes down again.
    property <bool> refused;
    mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
    // Slint reports the click before the button going up, which ends a drag.
    clicked => {
        if !root.dragging { root.open-profile(); }
    }
    moved => {
        if self.pressed && !root.dragging && !root.refused && abs(self.mouse-y - self.pressed-y) > 4px {
            root.dragging = root.start-drag();
            root.refused = !root.dragging;
        }
        if root.dragging { root.dragged(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
    pointer-event(event) => {
        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
            root.open-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            root.refused = false;
        }
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && (root.dragging || root.tracking) {
            root.dragging = false;
            root.dropped();
        }
        if event.kind == PointerEventKind.move && root.tracking && !root.dragging {
            root.dragged(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

// A channel category's heading. Clicking it collapses the category, or opens
// it again; a right click, or the Menu key or Shift+F10, opens its menu.
component CategoryHeading inherits Rectangle {
    in property <string> text;
    in property <bool> collapsed;
    /// It may be dragged, as ChannelRow may.
    in property <bool> draggable;
    callback start-drag(length) -> bool;
    callback dragged(length);
    callback dropped;
    in property <bool> tracking;
    property <bool> dragging;
    property <bool> refused;
    callback toggled;
    callback context-menu(length, length);
    // Discord keeps 17px above a category's name, then 21px for its line.
    height: 38px;
    accessible-role: button;
    accessible-label: root.text + (root.collapsed ? ", collapsed" : ", expanded");
    accessible-action-default => { root.toggled(); }
    forward-focus: focus;
    /// This account may create a channel in it, which a "+" offers while the
    /// pointer is over it.
    in property <bool> can-create;
    callback create;
    property <color> ink: touch.has-hover ? Theme.secondary : Theme.muted;
    HorizontalLayout {
        padding-left: 16px; padding-right: 8px; padding-top: 17px; spacing: 4px;
        Text {
            text: root.text; color: root.ink; font-size: 14px; font-weight: 600; letter-spacing: 0px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 0;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            width: 12px; image-fit: contain; colorize: root.ink;
            transform-rotation: root.collapsed ? -90deg : 0deg;
            animate transform-rotation { duration: 120ms; easing: ease-out; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.toggled(); return accept;
            }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-menu(self.absolute-position.x + 16px, self.absolute-position.y + self.height);
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            // Slint reports the click before the button going up, which
            // ends a drag.
            clicked => {
                if !root.dragging { root.toggled(); }
            }
            moved => {
                if self.pressed && root.draggable && !root.dragging && !root.refused && abs(self.mouse-y - self.pressed-y) > 4px {
                    root.dragging = root.start-drag(self.pressed-y);
                    root.refused = !root.dragging;
                }
                if root.dragging { root.dragged(self.absolute-position.y + self.mouse-y); }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.refused = false;
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && (root.dragging || root.tracking) {
                    root.dragging = false;
                    root.dropped();
                }
                if event.kind == PointerEventKind.move && root.tracking && !root.dragging {
                    root.dragged(self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
    // Discord's "+", at the right while the pointer is over the heading.
    add := Rectangle {
        x: parent.width - self.width - 8px; y: 16px; width: 24px; height: 24px;
        opacity: root.can-create && (touch.has-hover || add-touch.has-hover) ? 1 : 0;
        Image {
            source: @image-url("icons/plus.svg"); width: 16px; height: 16px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            colorize: add-touch.has-hover ? Theme.text : Theme.muted; accessible-role: none;
        }
        add-touch := TouchArea {
            enabled: root.can-create;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.create(); }
        }
    }
    Rectangle {
        border-radius: 4px; border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
    }
}

// A Discord server's name at the top of its channel list, as in Discord: it
// opens the server's menu below it, and its chevron turns over while that's
// open. The Menu key or Shift+F10 opens it too.
export component ServerHeader inherits Rectangle {
    in property <string> name;
    in property <bool> open;
    /// A Community server, whose header starts with Discord's badge.
    in property <bool> community;
    /// Verified or partnered, which Discord marks with a green badge before
    /// the name.
    in property <bool> verified;
    /// The name sits over the server's banner, in white.
    in property <bool> on-banner;
    callback clicked;
    border-radius: 6px;
    background: touch.has-hover || root.open ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.name + ", server menu";
    accessible-action-default => { root.clicked(); }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: ClientStyle.enabled && (root.verified || root.community) ? 10px : 8px; padding-right: 8px;
        spacing: ClientStyle.enabled ? 10px : 6px; alignment: start;
        // Discord marks a verified server with its green badge, and one that is
        // only a Community server with the Community badge.
        if root.community && !(ClientStyle.enabled && root.verified): VerticalLayout {
            alignment: center;
            Image { source: @image-url("icons/community.svg"); width: ClientStyle.enabled ? 16px : 20px; height: ClientStyle.enabled ? 16px : 20px; colorize: Theme.text; accessible-role: none; }
        }
        if ClientStyle.enabled && root.verified: VerticalLayout {
            alignment: center;
            Image { source: @image-url("icons/verified.svg"); width: 16px; height: 16px; accessible-role: none; }
        }
        // Discord's chevron follows the name closely, small and light.
        HorizontalLayout {
            spacing: ClientStyle.enabled ? 0px : 6px;
            Text {
                text: root.name; font-size: ClientStyle.text-size;
                font-weight: ClientStyle.enabled ? 600 : 700;
                color: root.on-banner ? #ffffff : Theme.text;
                vertical-alignment: center; overflow: elide;
            }
            Image {
                source: @image-url("icons/chevron-down.svg"); width: ClientStyle.enabled ? 16px : 20px; height: ClientStyle.enabled ? 16px : 20px; y: (parent.height - self.height) / 2;
                colorize: root.on-banner ? #ffffff : ClientStyle.enabled ? Theme.secondary : Theme.muted; transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: 120ms; easing: ease-out; }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { keys.focus(); root.clicked(); }
    }
    if keys.has-focus: Rectangle {
        border-radius: root.border-radius; border-width: 2px; border-color: Theme.accent;
    }
}

// The server rail: the DM home, the DMs with unread messages, then each server.
export component ServerRail inherits Rectangle {
    in property <bool> dms-selected;
    in property <bool> dms-unread;
    /// DM mentions and incoming friend requests, as a badge on the DM home.
    in property <string> dms-badge;
    in property <[ServerRow]> servers;
    /// Without Matrix every server is Discord's, so names don't say so.
    in property <bool> matrix-build: true;
    callback navigate-dms;
    callback navigate-server(string);
    callback toggle-folder(string);
    /// An unread DM was clicked: open it.
    callback open-dm(string);
    /// A server's, folder's or DM's menu was asked for: its id, and where in
    /// the window.
    callback open-server-menu(string, length, length);
    /// Whether the "+" at the foot offers to join a Discord server.
    in property <bool> can-join;
    callback join-server;
    width: 72px; background: Theme.rail;
    VerticalLayout {
        padding-top: ClientStyle.enabled ? 0px : 12px; padding-bottom: 12px; spacing: 8px;
        RailItem {
            // The app's logo, as Discord puts its own here.
            icon: @image-url("icons/logo.svg"); icon-color: Theme.accent; icon-size: ClientStyle.enabled ? 24px : 32px;
            label: "Direct messages" + (root.dms-badge != "" ? ", " + root.dms-badge + " waiting" : root.dms-unread ? ", unread" : "");
            tip: "Direct messages";
            selected: root.dms-selected; unread: root.dms-unread; badge: root.dms-badge;
            clicked => { root.navigate-dms(); }
        }
        if ClientStyle.enabled: Rectangle {
            height: 1px;
            Rectangle { width: 32px; height: 1px; background: Theme.outline; }
        }
        // A list view makes only the servers in sight, which
        // matters on accounts in many servers. Unread DMs scroll with them.
        ListView {
            vertical-stretch: 1;
            for server[index] in root.servers: Rectangle {
                // Home already has a pinned separator. Keep the model's line
                // only when it separates unread DMs from servers below them.
                height: server.divider ? (ClientStyle.enabled && index == 0 ? 0px : (ClientStyle.enabled ? 1px : 2px) + 8px) : (server.folder ? ClientStyle.folder-tile : ClientStyle.rail-tile) + (ClientStyle.enabled && ((server.folder && server.open) || (server.nested && server.last)) ? 4px : 0px) + (ClientStyle.enabled && server.folder && server.open ? 0px : 8px);
                if server.divider && (!ClientStyle.enabled || index > 0): Rectangle {
                    x: (72px - self.width) / 2; y: 0px; width: 32px; height: ClientStyle.enabled ? 1px : 2px; border-radius: ClientStyle.enabled ? 0px : 1px; background: ClientStyle.enabled ? Theme.outline : Theme.line;
                }
                // An open folder's servers sit on a strip of its colour,
                // from its folder down to its last server.
                if server.open || server.nested: Rectangle {
                    x: (72px - ClientStyle.folder-tile) / 2; y: 0px; width: ClientStyle.folder-tile; height: server.last ? ClientStyle.rail-tile + (ClientStyle.enabled ? 4px : 0px) : parent.height;
                    border-top-left-radius: server.open ? (ClientStyle.enabled ? 12px : 16px) : 0px;
                    border-top-right-radius: self.border-top-left-radius;
                    border-bottom-left-radius: server.last ? (ClientStyle.enabled ? 12px : 16px) : 0px;
                    border-bottom-right-radius: self.border-bottom-left-radius;
                    background: server.tint.with-alpha(0.16);
                }
                if server.folder: FolderItem {
                    y: 0px;
                    label: server.name + " folder, " + (server.open ? "open" : "closed") + (server.call && !server.open ? ", in a call" : "")
                        + (server.badge != "" ? ", " + server.badge + " mentions" : server.unread ? ", unread" : "");
                    tip: server.name;
                    open: server.open; tint: server.tint; servers: server.preview;
                    selected: server.selected; unread: server.unread; badge: server.badge; call: server.call;
                    clicked => { root.toggle-folder(server.id); }
                    context-menu(x, y) => { root.open-server-menu(server.id, x, y); }
                }
                if server.dm: RailItem {
                    y: 0px;
                    initial: server.initial; picture-url: server.picture-url;
                    label: server.name + (server.discord && root.matrix-build ? ", Discord" : "")
                        + (server.badge != "" ? ", " + server.badge + " unread" : ", unread");
                    tip: server.discord && root.matrix-build ? server.name + " (Discord)" : server.name;
                    unread: true; badge: server.badge; discord: server.discord;
                    clicked => { root.open-dm(server.id); }
                    context-menu(x, y) => { root.open-server-menu(server.id, x, y); }
                }
                if !server.folder && !server.dm && !server.divider: RailItem {
                    y: 0px;
                    initial: server.initial; picture: server.picture; picture-url: server.picture-url;
                    label: server.name + (server.discord && root.matrix-build ? ", Discord" : "") + (server.unavailable ? ", unavailable" : "")
                        + (server.call ? ", in a call" : "")
                        + (server.badge != "" ? ", " + server.badge + " mentions" : server.unread ? ", unread" : "");
                    tip: server.unavailable ? server.name + " (unavailable in a Discord outage)" : server.discord && root.matrix-build ? server.name + " (Discord)" : server.name;
                    selected: server.selected; unread: server.unread; badge: server.badge; discord: server.discord;
                    call: server.call;
                    opacity: server.unavailable ? 0.5 : 1;
                    clicked => { root.navigate-server(server.id); }
                    context-menu(x, y) => { root.open-server-menu(server.id, x, y); }
                }
            }
        }
        if root.can-join: RailItem {
            icon: @image-url("icons/circle-plus.svg"); icon-color: Theme.accent; icon-size: 24px;
            label: "Join a server"; tip: "Join a server";
            clicked => { root.join-server(); }
        }
    }
}

// The sidebar's conversations: on the DM home, the friends list and requests
// first; then each room, with who is in its voice channel under it.
// The friends list, and friend requests, message requests and spam, which
// open on their own screens, at the top of the DM list.
component DmScreenLinks inherits VerticalLayout {
    in property <bool> friends-open;
    in property <bool> requests-current;
    in property <string> requests-badge;
    callback open-friends;
    callback open-requests;
    padding-top: 6px; padding-bottom: 6px; spacing: 2px;
    ChannelRow {
        text: "Friends";
        icon: @image-url("icons/users.svg");
        selected: root.friends-open;
        clicked => { root.open-friends(); }
    }
    ChannelRow {
        text: "Requests";
        label: "Requests" + (root.requests-badge != "" ? ", " + root.requests-badge + " waiting" : "");
        icon: @image-url("icons/inbox.svg");
        selected: root.requests-current; badge: root.requests-badge;
        clicked => { root.open-requests(); }
    }
}

// Browse Channels, at the top of a Community server's channel list, as in
// Discord's client.
component BrowseLink inherits VerticalLayout {
    in property <bool> browsing;
    callback open-browse;
    padding-top: 6px; padding-bottom: 6px;
    ChannelRow {
        text: "Browse channels";
        icon: @image-url("icons/hash.svg");
        selected: root.browsing;
        clicked => { root.open-browse(); }
    }
}

export component RoomList inherits Rectangle {
    in property <[RoomRow]> rooms;
    in property <bool> dms-selected;
    in property <bool> discord-linked;
    in property <bool> preview;
    in property <bool> friends-open;
    /// The requests screen, or a request from it, is on screen.
    in property <bool> requests-current;
    /// Requests waiting for an answer, as a badge.
    in property <string> requests-badge;
    /// The voice channel this account is connected to, whose participants are listed under it.
    in property <string> voice-channel;
    in property <[PersonRow]> participants;
    /// Said under the rooms, such as when none match the filter.
    in property <string> sidebar-empty;
    callback select-room(string);
    /// A DM person's voice channel was clicked: its room id.
    callback open-voice(string);
    /// Wave at a DM's person (their id), by the button an empty DM offers.
    callback wave(string);
    /// A voice channel's chat button was clicked: its room id.
    callback open-chat(string);
    callback open-add-friend;
    callback open-new-dm;
    callback open-friends;
    callback open-requests;
    /// A Community server's list opens Browse Channels, which is on screen
    /// while `browsing`.
    in property <bool> browse-offered;
    in property <bool> browsing;
    callback open-browse;
    /// A conversation's menu was asked for: its id, and where in the window.
    callback open-room-menu(string, length, length);
    /// A right click on someone in a voice channel: the channel's id,
    /// theirs, and where it was in the window.
    callback open-voice-menu(string, PersonRow, length, length);
    /// Someone's LIVE tag in a voice channel was clicked: the channel's id
    /// and theirs.
    callback show-voice-person(string, string);
    /// Someone in a voice channel was clicked: their row, and where it is
    /// in the window, which their profile opens beside.
    callback open-voice-profile(PersonRow, length, length, length, length);
    /// A category's heading was clicked, by the row's category: collapse or
    /// open it.
    callback toggle-category(string);
    /// Whether this account may create a channel in a category heading's category, by room id, and a "+" asking to.
    pure callback may-create(string) -> bool;
    callback create-channel(string);
    /// A category's menu was asked for, by its first channel's id.
    callback open-category-menu(string, length, length);
    /// Dragging a Discord server's channels and categories, by their rows'
    /// places: `start-arranging` asks whether one may be dragged, and
    /// `arranging` is the one being dragged, 0 for none, with the places it
    /// may drop on, from the first, in `droppable`. `arrange` drops it on a
    /// place, and `stop-arranging` nowhere.
    in property <int> arranging;
    in property <[bool]> droppable;
    callback start-arranging(int) -> bool;
    callback arrange(int);
    callback stop-arranging;
    /// Dragging someone from under a voice channel onto another, which
    /// moves them as their menu's Move to does: `start-moving` asks whether
    /// they may be dragged, by the channel's room id and their user id, and
    /// `moving` says they are, with the rows they may drop on, by index, in
    /// `move-droppable`. `move-person` drops them on a voice channel, by
    /// room id, and `stop-moving` nowhere.
    in property <bool> moving;
    in property <[bool]> move-droppable;
    callback start-moving(string, string) -> bool;
    callback move-person(string);
    callback stop-moving;
    // Where the pointer is in the window while dragging, the place it's
    // over, and whether a voice channel or a category is dragged, which
    // dims the rows it can't drop among. Each step of scrolling counts,
    // as it moves the rows under a pointer that stays still.
    property <length> drag-y;
    property <int> hovered;
    property <bool> dragged-voice;
    property <bool> dragged-category;
    property <int> scrolled;
    // The dragged row, which follows the pointer up and down faintly,
    // held where it was pressed.
    property <RoomRow> dragged-row;
    property <length> grab-y;
    // A row or someone is being dragged, and the rows that aren't follow it.
    property <bool> dragging: root.arranging > 0 || root.moving;
    // Who is dragged from a voice channel, and the row they're over, by
    // index from 1.
    property <PersonRow> dragged-person;
    property <int> move-hovered;
    // Across, too, for someone dragged, who drops only over the list. A
    // channel's row reports only how far down the pointer is, over itself,
    // so in the list.
    property <length> drag-x;
    pure function over-list() -> bool {
        return root.drag-x >= list.absolute-position.x && root.drag-x < list.absolute-position.x + list.width
            && root.drag-y >= list.absolute-position.y && root.drag-y < list.absolute-position.y + list.height;
    }
    function follow(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
    }
    function begin-moving(room: string, person: PersonRow) -> bool {
        if person.person == "" { return false; }
        root.dragged-person = person;
        root.move-hovered = 0;
        if !root.start-moving(room, person.person) { return false; }
        // Their tooltip, such as "Connected on another client", would
        // cover the list for the rest of the drag.
        Tip.text = "";
        return true;
    }
    function begin(place: int, row: RoomRow, category: bool, grab-y: length) -> bool {
        root.dragged-voice = row.voice && !category;
        root.dragged-category = category;
        root.dragged-row = row;
        root.grab-y = grab-y;
        root.hovered = place;
        return root.start-arranging(place);
    }
    // Drops what's dragged on the place it's over, if it may drop there and
    // the pointer is still over the list.
    function finish() {
        if root.moving {
            if root.move-hovered > 0 && root.move-droppable[root.move-hovered - 1] && root.over-list() {
                root.move-person(root.rooms[root.move-hovered - 1].id);
            } else {
                root.stop-moving();
            }
        } else if root.hovered > 0 && root.hovered != root.arranging && root.droppable[root.hovered - 1]
            && root.drag-y >= list.absolute-position.y && root.drag-y < list.absolute-position.y + list.height {
            root.arrange(root.hovered);
        } else {
            root.stop-arranging();
        }
        root.hovered = 0;
        root.move-hovered = 0;
    }
    pure function aimed(place: int) -> bool {
        return root.arranging > 0 && place > 0 && root.hovered == place && place != root.arranging && root.droppable[place - 1];
    }
    pure function dimmed(voice: bool) -> bool {
        return root.arranging > 0 && (root.dragged-category || voice != root.dragged-voice);
    }
    // Someone dragged may drop on the row at this index, which the pointer
    // is over; the rows they may not drop on dim.
    pure function move-aimed(index: int) -> bool {
        return root.moving && root.move-hovered == index + 1 && root.move-droppable[index];
    }
    pure function unfit(index: int) -> bool {
        return root.moving && !root.move-droppable[index];
    }
    // Near the list's top or bottom, it scrolls while dragging.
    Timer {
        interval: 16ms;
        running: root.dragging && (root.drag-y < list.absolute-position.y + 40px || root.drag-y > list.absolute-position.y + list.height - 40px);
        triggered => {
            if root.drag-y < list.absolute-position.y + 40px {
                list.content-y = min(0px, list.content-y + 8px);
            } else {
                list.content-y = max(list.visible-height - list.content-height, list.content-y - 8px);
            }
            root.scrolled += 1;
        }
    }
    min-height: 96px; vertical-stretch: 1;
    property <bool> screens: root.dms-selected && root.discord-linked && !root.preview;
    VerticalLayout {
        // With no rooms the list is empty; what it would start with shows above it.
        if root.rooms.length == 0 && (root.screens || root.browse-offered || root.sidebar-empty != ""): VerticalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 2px;
            if root.screens: DmScreenLinks {
                friends-open: root.friends-open; requests-current: root.requests-current; requests-badge: root.requests-badge;
                open-friends => { root.open-friends(); }
                open-requests => { root.open-requests(); }
            }
            if ClientStyle.enabled && root.dms-selected && !root.preview: DmHeading {
                discord-linked: root.discord-linked;
                add-friend => { root.open-add-friend(); }
                new-message => { root.open-new-dm(); }
            }
            if root.browse-offered: BrowseLink {
                browsing: root.browsing;
                open-browse => { root.open-browse(); }
            }
            if root.sidebar-empty != "": HorizontalLayout { padding: 8px; Label { text: root.sidebar-empty; } }
        }
        // A list view makes only the rows in sight, which matters with hundreds of DMs.
        list := ListView {
            vertical-stretch: 1;
            for room[index] in root.rooms: VerticalLayout {
                padding-left: 8px; padding-right: 8px;
                padding-bottom: index == root.rooms.length - 1 ? 12px : 2px;
                spacing: 2px;
                if index == 0 && root.screens: DmScreenLinks {
                    friends-open: root.friends-open; requests-current: root.requests-current; requests-badge: root.requests-badge;
                    open-friends => { root.open-friends(); }
                    open-requests => { root.open-requests(); }
                }
                if index == 0 && ClientStyle.enabled && root.dms-selected && !root.preview: DmHeading {
                    discord-linked: root.discord-linked;
                    add-friend => { root.open-add-friend(); }
                    new-message => { root.open-new-dm(); }
                }
                if index == 0 && root.browse-offered: BrowseLink {
                    browsing: root.browsing;
                    open-browse => { root.open-browse(); }
                }
                // A server's pinned channels end with a line, as in Discord.
                if index > 0 && !room.direct && !room.pinned && root.rooms[index - 1].pinned: Rectangle {
                    height: 9px;
                    Rectangle { height: 1px; background: Theme.line; }
                }
                // Their heading neither folds nor has a menu.
                if room.heading != "" && room.pinned && !room.direct: HorizontalLayout {
                    height: 36px; padding-left: 16px;
                    Text {
                        text: room.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                        vertical-alignment: center; overflow: elide; accessible-role: text;
                    }
                }
                if room.heading != "" && !(room.pinned && !room.direct): CategoryHeading {
                    text: room.heading; collapsed: room.collapsed;
                    can-create: root.may-create(room.id);
                    create => { root.create-channel(room.id); }
                    toggled => { root.toggle-category(room.category); }
                    context-menu(x, y) => { root.open-category-menu(room.id, x, y); }
                    draggable: room.heading-place > 0; tracking: root.dragging;
                    start-drag(y) => { return root.begin(room.heading-place, room, true, y); }
                    dragged(y) => { root.follow(list.absolute-position.x, y); }
                    dropped => { root.finish(); }
                    // The pointer is over it, or the gap above it.
                    property <bool> over: root.arranging > 0 && room.heading-place > 0 && root.scrolled >= 0
                        && root.drag-y >= self.absolute-position.y - 2px && root.drag-y < self.absolute-position.y + self.height;
                    changed over => {
                        if self.over { root.hovered = room.heading-place; }
                        else if root.hovered == room.heading-place { root.hovered = 0; }
                    }
                    // Dragged up, it drops above the row; dragged down, below.
                    if root.aimed(room.heading-place): DropLine {
                        x: 8px; width: parent.width - 8px;
                        // The list's first row has no gap above it to draw in.
                        y: room.heading-place > root.arranging ? parent.height - 1px : index == 0 && !root.browse-offered ? 0px : -3px;
                    }
                }
                // A thread hangs from its channel's icon on a line that runs on
                // to the next of its threads.
                if !room.hidden && room.thread: HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: 28px;
                        Path {
                            x: 0px; y: -2px; width: 28px; height: 38px;
                            viewbox-width: 28; viewbox-height: 38;
                            commands: room.thread-continues ? "M 18 0 L 18 38 M 18 13 Q 18 19 24 19 L 28 19" : "M 18 0 L 18 13 Q 18 19 24 19 L 28 19";
                            stroke: Theme.faint; stroke-width: 1.5px;
                        }
                    }
                    ChannelRow {
                        text: room.name; thread: true;
                        opacity: root.dimmed(false) || root.unfit(index) ? 0.3 : 1;
                        tracking: root.dragging;
                        dragged(y) => { root.follow(list.absolute-position.x, y); }
                        dropped => { root.finish(); }
                        label: room.name + ", thread" + (room.muted ? ", muted" : "")
                            + (room.badge != "" ? ", " + room.badge + " mentions" : room.unread ? ", unread" : "");
                        selected: room.selected; unread: room.unread; badge: room.badge; muted: room.muted;
                        clicked => { root.select-room(room.id); }
                        context-menu(x, y) => { root.open-room-menu(room.id, x, y); }
                    }
                }
                if !room.hidden && !room.thread: ChannelRow {
                    text: room.name;
                    label: room.name + (room.discord ? ", Discord" : "")
                        + (room.presence == "dnd" ? ", do not disturb" : room.presence == "mobile" ? ", online on mobile" : room.presence != "" ? ", " + room.presence : "")
                        + (room.voice-room != "" ? ", in " + room.voice-channel + " in " + room.voice-server : "")
                        + (room.detail != "" ? ", " + room.detail : "")
                        + (room.pinned ? ", pinned" : "") + (room.muted ? ", muted" : "")
                        + (room.locked ? ", locked" : "") + (room.call ? ", in a call" : "") + (room.badge != "" ? ", " + room.badge + " mentions" : room.unread ? ", unread" : "");
                    icon: room.icon; person: room.direct; initial: room.initial; tint: room.tint;
                    chat: room.chat;
                    open-chat => { root.open-chat(room.id); }
                    picture: room.picture; picture-url: room.picture-url; discord: room.discord;
                    decoration-url: room.decoration-url; nameplate-url: room.nameplate-url;
                    nameplate-color: room.nameplate-color; nameplate-light: room.nameplate-light; name-style: room.name-style;
                    tag: room.tag; tag-badge: room.tag-badge; official: room.official; wave: room.wave;
                    waved => { root.wave(room.wave); }
                    selected: room.selected; unread: room.unread; badge: room.badge; locked: room.locked;
                    call: room.call; presence: room.presence; detail: room.detail; detail-emoji: room.detail-emoji;
                    voice-channel: room.voice-channel; voice-server: room.voice-server;
                    // Discord doesn't dim a muted voice channel, only a text one.
                    pinned: room.pinned && room.direct; muted: room.muted && !room.voice;
                    clicked => { root.select-room(room.id); }
                    open-voice => { root.open-voice(room.voice-room); }
                    context-menu(x, y) => { root.open-room-menu(room.id, x, y); }
                    opacity: root.dimmed(room.voice) || root.unfit(index) ? 0.3 : 1;
                    draggable: room.place > 0; tracking: root.dragging;
                    start-drag(y) => { return root.begin(room.place, room, false, y); }
                    dragged(y) => { root.follow(list.absolute-position.x, y); }
                    dropped => { root.finish(); }
                    // Who is in a voice channel lists under it, as part of it.
                    property <length> people: !room.voice ? 0px
                        : room.id == root.voice-channel ? root.participants.length * 30px + 4px
                        : room.people.length > 0 ? room.people.length * 30px + 4px : 0px;
                    property <bool> over: root.arranging > 0 && room.place > 0 && root.scrolled >= 0
                        && root.drag-y >= self.absolute-position.y - 2px && root.drag-y < self.absolute-position.y + self.height + self.people;
                    changed over => {
                        if self.over { root.hovered = room.place; }
                        else if root.hovered == room.place { root.hovered = 0; }
                    }
                    // The same, for someone dragged from a voice channel.
                    property <bool> move-over: root.moving && root.scrolled >= 0 && root.over-list()
                        && root.drag-y >= self.absolute-position.y - 2px && root.drag-y < self.absolute-position.y + self.height + self.people;
                    changed move-over => {
                        if self.move-over { root.move-hovered = index + 1; }
                        else if root.move-hovered == index + 1 { root.move-hovered = 0; }
                    }
                    // Where someone dragged would drop, outlined in the drop line's colour.
                    if root.move-aimed(index): Rectangle {
                        border-radius: 6px; border-width: 2px; border-color: Theme.live;
                    }
                    if root.aimed(room.place): DropLine {
                        x: 8px; width: parent.width - 8px;
                        y: room.place < root.arranging ? -3px : parent.height + parent.people - 1px;
                    }
                }
                // Discord reports who is in every voice channel; Matrix
                // only shows the call Yapfast is in, below.
                if room.voice && room.id != root.voice-channel && room.people.length > 0: VerticalLayout {
                    padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                    for person in room.people: Rectangle {
                        // A click opens their profile beside the row and a right
                        // click their menu, as in Discord; their LIVE tag watches
                        // their stream. This account in the call on another
                        // client is dimmed until hovered, without its icons.
                        // They may be dragged onto another voice channel.
                        property <string> tip: person.elsewhere ? "Connected on another client" : "";
                        height: 30px; border-radius: 4px;
                        background: person-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: 90ms; }
                        opacity: person.elsewhere && !person-touch.has-hover ? 0.5 : 1;
                        accessible-role: button;
                        accessible-label: person.elsewhere ? person.name + ", connected on another client" : person.name;
                        accessible-description: "Show their profile";
                        accessible-action-default => {
                            root.open-voice-profile(person, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        }
                        person-touch := PersonTouch {
                            tracking: root.dragging;
                            open-profile => {
                                root.open-voice-profile(person, parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                            }
                            open-menu(x, y) => { root.open-voice-menu(room.id, person, x, y); }
                            start-drag => { return root.begin-moving(room.id, person); }
                            dragged(x, y) => { root.follow(x, y); }
                            dropped => { root.finish(); }
                            changed has-hover => {
                                if self.has-hover && parent.tip != "" {
                                    Tip.text = parent.tip; Tip.side = 0;
                                    Tip.x = parent.absolute-position.x + parent.width / 2; Tip.y = parent.absolute-position.y;
                                } else if parent.tip != "" && Tip.text == parent.tip {
                                    Tip.text = "";
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px; padding-left: 4px; padding-right: 8px;
                            Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; } }
                            Text {
                                text: person.name; font-size: 15px; font-weight: 500; color: Theme.secondary;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                            if person.video && !person.elsewhere: Image {
                                source: @image-url("icons/video.svg"); width: 16px; image-fit: contain;
                                colorize: Theme.muted; accessible-role: image; accessible-label: person.name + "'s camera is on";
                            }
                            if person.live && !person.elsewhere: Middle {
                                LivePill {
                                    clickable: !person.local; label: "Watch " + person.name + "'s stream";
                                    clicked => { root.show-voice-person(room.id, person.id); }
                                }
                            }
                            if (person.muted || person.deafened) && !person.elsewhere: Image {
                                source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                colorize: person.server-muted ? Theme.danger : Theme.muted; accessible-role: image;
                                accessible-label: person.name + (person.server-muted ? " is server muted" : " is muted");
                            }
                            if person.deafened && !person.elsewhere: Image {
                                source: @image-url("icons/headphone-off.svg"); width: 16px; image-fit: contain;
                                colorize: person.server-deafened ? Theme.danger : Theme.muted; accessible-role: image;
                                accessible-label: person.name + (person.server-deafened ? " is server deafened" : " is deafened");
                            }
                        }
                    }
                }
                if room.voice && room.id == root.voice-channel: VerticalLayout {
                    padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                    for person in root.participants: Rectangle {
                        // A click opens their profile and a right click their
                        // menu, and they may be dragged, as above.
                        height: 30px; border-radius: 4px;
                        background: participant-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: 90ms; }
                        accessible-role: button; accessible-label: person.name;
                        accessible-description: "Show their profile";
                        accessible-action-default => {
                            root.open-voice-profile(person, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        }
                        participant-touch := PersonTouch {
                            tracking: root.dragging;
                            open-profile => {
                                root.open-voice-profile(person, parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                            }
                            open-menu(x, y) => { root.open-voice-menu(root.voice-channel, person, x, y); }
                            start-drag => { return root.begin-moving(root.voice-channel, person); }
                            dragged(x, y) => { root.follow(x, y); }
                            dropped => { root.finish(); }
                        }
                        HorizontalLayout {
                            spacing: 8px; padding-left: 4px; padding-right: 8px;
                            Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; speaking: person.speaking; } }
                            Text {
                                text: person.name; font-size: 15px; font-weight: person.speaking ? 700 : 500;
                                color: person.speaking ? Theme.text : person.connected ? Theme.secondary : Theme.muted;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                            if person.video: Image {
                                source: @image-url("icons/video.svg"); width: 16px; image-fit: contain;
                                colorize: Theme.muted; accessible-role: image; accessible-label: person.name + "'s camera is on";
                            }
                            if person.live: Middle {
                                LivePill {
                                    clickable: !person.local; label: "Watch " + person.name + "'s stream";
                                    clicked => { root.show-voice-person(room.id, person.id); }
                                }
                            }
                            if person.muted || person.deafened: Image {
                                source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                colorize: person.server-muted ? Theme.danger : Theme.muted; accessible-role: image;
                                accessible-label: person.name + (person.server-muted ? " is server muted" : " is muted");
                            }
                            if person.deafened: Image {
                                source: @image-url("icons/headphone-off.svg"); width: 16px; image-fit: contain;
                                colorize: person.server-deafened ? Theme.danger : Theme.muted; accessible-role: image;
                                accessible-label: person.name + (person.server-deafened ? " is server deafened" : " is deafened");
                            }
                        }
                    }
                }
            }
        }
    }
    // Someone dragged follows the pointer the same way, just below it, so the
    // name of the channel they'd drop on stays readable.
    if root.moving: Rectangle {
        x: 40px; y: root.drag-y - root.absolute-position.y + 12px;
        width: root.width - 48px; height: 30px; border-radius: 4px;
        background: Theme.active; opacity: 0.6;
        HorizontalLayout {
            spacing: 8px; padding-left: 4px; padding-right: 8px;
            Middle { Avatar { size: 22px; initial: root.dragged-person.initial; tint: root.dragged-person.tint; picture: root.dragged-person.picture; } }
            Text {
                text: root.dragged-person.name; font-size: 15px; font-weight: 500; color: Theme.text;
                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            }
        }
    }
    // What's dragged follows the pointer, faint, as a browser draws it.
    if root.arranging > 0: Rectangle {
        x: 8px; y: root.drag-y - root.absolute-position.y - root.grab-y;
        width: root.width - 16px; height: root.dragged-category ? 36px : (root.dragged-row.person ? ClientStyle.dm-row-height : ClientStyle.channel-row-height);
        border-radius: root.dragged-category ? 4px : 6px;
        background: Theme.active; opacity: 0.6;
        if root.dragged-category: HorizontalLayout {
            padding-left: 2px; spacing: 2px;
            Image {
                source: root.dragged-row.collapsed ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg");
                width: 12px; image-fit: contain; colorize: Theme.secondary;
            }
            Text {
                text: root.dragged-row.heading; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            }
        }
        if !root.dragged-category: HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            Image { source: root.dragged-row.icon; width: 20px; image-fit: contain; colorize: Theme.secondary; }
            Text {
                text: root.dragged-row.name; color: Theme.text; font-size: 16px; font-weight: 500;
                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            }
        }
    }
}
