import { ListView } from "scrollview.slint";
import { Theme, Tip, Middle, Label } from "theme.slint";
import { ActionButton, TextField } from "controls.slint";
import { SettingsSwitch } from "settings.slint";

/// A channel, or a category's heading, in Discord's Browse Channels.
export struct BrowseRow {
    /// Its room id.
    id: string,
    name: string,
    /// What the channel is for, as plain text.
    topic: string,
    icon: image,
    /// A category's heading, with its Follow category switch.
    category: bool,
    voice: bool,
    forum: bool,
    /// Its box is ticked, or a category's switch on.
    followed: bool,
    /// Followed through its category, so its box changes only with it.
    by-category: bool,
}

// A channel in Browse Channels: clicking it ticks its box or clears it, and
// its button opens it, as in Discord's client.
component BrowseItem inherits Rectangle {
    in property <BrowseRow> channel;
    callback toggled(bool);
    callback view;
    property <string> locked-tip: @tr("You must unfollow this category to add or remove specific channels.");
    height: 56px;
    border-radius: 8px;
    background: pointer.has-hover && !root.channel.by-category ? Theme.raised : transparent;
    accessible-role: checkbox;
    accessible-label: root.channel.name;
    accessible-description: root.channel.topic;
    accessible-checkable: true;
    accessible-checked: root.channel.followed;
    accessible-enabled: !root.channel.by-category;
    accessible-action-default => { root.toggle(); }
    function toggle() {
        if !root.channel.by-category { root.toggled(!root.channel.followed); }
    }
    pointer := TouchArea {
        mouse-cursor: root.channel.by-category ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.toggle(); }
        changed has-hover => {
            if root.channel.by-category && self.has-hover {
                Tip.text = root.locked-tip;
                Tip.side = 0;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = self.absolute-position.y;
            } else if Tip.text == root.locked-tip {
                Tip.text = "";
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        Middle {
            Image { source: root.channel.icon; width: 20px; height: 20px; image-fit: contain; colorize: Theme.muted; }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text {
                text: root.channel.name; font-size: 15px; font-weight: 600; overflow: elide;
                color: root.channel.by-category ? Theme.muted : Theme.text;
            }
            if root.channel.topic != "": Text {
                text: root.channel.topic; font-size: 12px; color: Theme.muted; overflow: elide;
            }
        }
        Middle {
            ActionButton {
                small: true;
                text: root.channel.voice ? @tr("Join") : root.channel.forum ? @tr("Open") : @tr("View");
                label: self.text + " " + root.channel.name;
                clicked => { root.view(); }
            }
        }
        Middle {
            Rectangle {
                width: 20px; height: 20px; border-radius: 4px;
                opacity: root.channel.by-category ? 0.5 : 1;
                background: root.channel.followed ? Theme.accent : transparent;
                border-width: root.channel.followed ? 0px : 1.5px; border-color: Theme.muted;
                if root.channel.followed: Image {
                    width: 14px; height: 14px; image-fit: contain;
                    source: @image-url("icons/check.svg"); colorize: Theme.on-accent;
                }
            }
        }
    }
}

// Discord's Browse Channels for a Community server, in place of a
// conversation: its channels by category, each with a box ticked while the
// channel list follows it, and each category with a switch that follows
// every channel in it.
export component BrowseScreen inherits Rectangle {
    in property <[BrowseRow]> rows;
    in-out property <string> filter;
    callback filter-edited;
    /// A box or switch was flipped: the room id, and whether to follow it.
    callback follow(string, bool);
    /// A channel's button was clicked, to open it: its room id.
    callback view(string);
    VerticalLayout {
        padding: 16px; padding-bottom: 0px; spacing: 8px;
        TextField {
            min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken; ring: false;
            placeholder: @tr("Search channels"); label: @tr("Search channels"); text <=> root.filter;
            edited => { root.filter-edited(); }
        }
        if root.rows.length == 0: HorizontalLayout {
            padding-left: 8px; padding-top: 8px;
            Label { text: root.filter != "" ? @tr("No channel's name matches that.") : @tr("There are no channels to browse."); }
        }
        ListView {
            vertical-stretch: 1;
            for row[index] in root.rows: VerticalLayout {
                padding-top: row.category && index > 0 ? 16px : 0px;
                padding-bottom: index == root.rows.length - 1 ? 16px : 2px;
                if row.category: HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; height: 44px; spacing: 12px;
                    Text {
                        text: row.name; font-size: 17px; font-weight: 700; color: Theme.text;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        accessible-role: text;
                    }
                    Middle {
                        SettingsSwitch {
                            width: 172px; horizontal-stretch: 0;
                            text: @tr("Follow category"); controlled: true; checked: row.followed;
                            toggled(on) => { root.follow(row.id, on); }
                        }
                    }
                }
                if !row.category: BrowseItem {
                    channel: row;
                    toggled(on) => { root.follow(row.id, on); }
                    view => { root.view(row.id); }
                }
            }
        }
    }
}
