import { Theme, Tip } from "theme.slint";
import { IconButton, TextField, Picture } from "controls.slint";

/// A tile of the GIF picker's grid, placed by the adapter as Discord's
/// masonry places it. `kind`: 0 a GIF, 1 the Favorites tile, 2 "Trending
/// GIFs", 3 a trending term, 4 a placeholder while GIFs load.
export struct GifTile {
    kind: int,
    label: string,
    /// A GIF's page, which a click sends; a term's name.
    url: string,
    x: length, y: length, w: length, h: length,
    image: image, frames: [image], delays: [int],
    /// The GIF is a favourite.
    favorite: bool,
    tint: color,
}

// Which GIFs are favourites, by page, for the stars on GIFs in messages,
// which are asked as they show rather than built into the rows.
export global GifFavorites {
    in property <int> revision;
    pure callback is-favorite(string, int) -> bool;
    /// A message's GIF's star, by item and attachment.
    callback toggle(string, int);
    /// A star is about to be used: the favourites load, if they haven't.
    callback wanted();
}

// A GIF's star, shown while the pointer is over the GIF, as Discord's: at a
// tile's top right in the picker, at a message's GIF's top left.
export component FavoriteStar inherits Rectangle {
    in property <bool> on;
    in property <bool> shown;
    callback clicked;
    width: 32px; height: 32px; border-radius: 5px;
    background: Theme.panel;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.on ? "Remove from Favorites" : "Add to Favorites";
    accessible-action-default => { root.clicked(); }
    Image {
        width: 20px; height: 20px;
        source: root.on ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
        colorize: root.on ? #f0b232 : touch.has-hover ? Theme.text : Theme.secondary;
    }
    touch := TouchArea {
        enabled: root.shown; mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                GifFavorites.wanted();
                Tip.text = root.accessible-label; Tip.side = 0;
                Tip.x = root.absolute-position.x + root.width / 2; Tip.y = root.absolute-position.y;
            } else if Tip.text == root.accessible-label {
                Tip.text = "";
            }
        }
    }
}

// The GIF picker, as Discord's: a search over Klipy, a home of the
// Favorites tile, "Trending GIFs" and the trending terms, and the GIFs
// found, in columns. A click sends a GIF; Shift and a click puts it in the
// message. The star keeps it among the favourites.
export component GifPicker inherits VerticalLayout {
    /// 0 the home, 1 trending, 2 favourites, 3 a search's results.
    in property <int> view;
    in-out property <string> query;
    in property <[GifTile]> tiles;
    /// How tall the grid is, and where the suggestions go below it.
    in property <length> grid-height;
    in property <string> note;
    in property <[string]> suggestions;
    in property <bool> has-favorites;
    callback search(string);
    callback show-view(int);
    callback category(string);
    callback pick(string, bool);
    callback favorite(string);
    /// How far the grid is scrolled and how tall it shows, for the adapter
    /// to load the pictures in sight.
    callback scrolled-to(length, length);
    /// The picker changed width, as its left edge dragged it: the grid's
    /// columns are placed again.
    callback resized;
    callback close;
    property <length> scrolled: -grid.content-y;
    property <length> shown-height: grid.height;
    function report() { root.scrolled-to(root.scrolled, root.shown-height); }
    init => { root.report(); }
    changed scrolled => { root.report(); }
    changed shown-height => { root.report(); }
    changed width => { root.resized(); }
    changed view => { grid.content-y = 0; root.report(); }
    // Typing searches after a quarter second's pause, as Discord's does.
    pause := Timer {
        interval: 250ms; running: false;
        triggered => { self.running = false; root.search(root.query); }
    }
    // The search takes the keys once the picker shows.
    Timer {
        interval: 1ms; running: true;
        triggered => { self.running = false; field.focus-input(); }
    }
    function back() {
        root.query = "";
        root.show-view(0);
    }
    spacing: 0px;
    keys := FocusScope {
        vertical-stretch: 0;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.view != 0 { root.back(); } else { root.close(); }
                return accept;
            }
            if (event.text == "g" || event.text == "G") && event.modifiers.control {
                root.close();
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; padding-bottom: 12px; spacing: 8px;
            if root.view != 0: IconButton {
                icon: @image-url("icons/chevron-left.svg"); label: "Back"; size: 34px;
                clicked => { root.back(); }
            }
            if root.view == 1: Text {
                text: "Trending GIFs"; color: Theme.text; font-size: 16px; font-weight: 700;
                vertical-alignment: center; horizontal-stretch: 1;
            }
            // Out of sight in Trending, where typing still searches.
            field := TextField {
                max-width: root.view == 1 ? 0px : 100000px; visible: root.view != 1;
                min-height: 34px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                placeholder: root.view == 2 ? "Search Favorites" : "Search Klipy";
                label: self.placeholder;
                text <=> root.query;
                edited(text) => {
                    if root.view == 2 {
                        root.search(text);
                    } else {
                        pause.running = false;
                        pause.running = true;
                    }
                }
                accepted => { pause.running = false; root.search(root.query); }
            }
        }
    }
    grid := Flickable {
        vertical-stretch: 1;
        content-height: max(root.grid-height, root.note != "" ? 96px : 0px) + (root.suggestions.length > 0 ? footer.preferred-height + 12px : 0px);
        for tile in root.tiles: Rectangle {
            x: tile.x; y: tile.y; width: tile.w; height: tile.h;
            border-radius: 5px; clip: true;
            background: tile.tint;
            accessible-role: button;
            accessible-label: tile.kind == 0 ? "GIF" : tile.label;
            accessible-action-default => {
                if tile.kind == 0 { root.pick(tile.url, false); }
                else if tile.kind == 1 { root.show-view(2); }
                else if tile.kind == 2 { root.show-view(1); }
                else if tile.kind == 3 { root.category(tile.url); }
            }
            Picture { width: parent.width; height: parent.height; still: tile.image; frames: tile.frames; delays: tile.delays; image-fit: cover; }
            touch := TouchArea {
                enabled: tile.kind != 4;
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.kind != PointerEventKind.up || event.button != PointerEventButton.left || !self.has-hover { return; }
                    if tile.kind == 0 { root.pick(tile.url, event.modifiers.shift); }
                    else if tile.kind == 1 { root.show-view(2); }
                    else if tile.kind == 2 { root.show-view(1); }
                    else if tile.kind == 3 { root.category(tile.url); }
                }
                // The home's tiles are labelled over a dimmed picture, dimmer
                // under the pointer.
                if tile.kind >= 1 && tile.kind <= 3: Rectangle {
                    background: tile.kind == 1 ? Theme.accent.with-alpha(0.8) : #00000080;
                    Rectangle {
                        background: touch.has-hover ? #00000050 : transparent;
                        animate background { duration: Theme.quick; }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        if tile.kind == 1: Image { y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("icons/star-filled.svg"); colorize: #ffffff; }
                        if tile.kind == 2: Image { y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("icons/trending-up.svg"); colorize: #ffffff; }
                        Text {
                            text: tile.label; color: #ffffff; font-size: 16px; font-weight: 600;
                            vertical-alignment: center; overflow: elide;
                        }
                    }
                }
                if tile.kind == 0: FavoriteStar {
                    x: parent.width - self.width - 4px; y: 4px;
                    on: tile.favorite; shown: touch.has-hover;
                    clicked => { root.favorite(tile.url); }
                }
            }
        }
        footer := VerticalLayout {
            visible: root.suggestions.length > 0;
            x: 12px; y: root.note != "" ? 96px : root.grid-height + 4px; width: parent.width - 24px; height: self.preferred-height;
            spacing: 10px;
            Text {
                text: "Your perfect GIF is in another castle. Try the suggested keywords below!";
                color: Theme.secondary; font-size: 14px; wrap: word-wrap; horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center; spacing: 8px;
                for term in root.suggestions: Rectangle {
                    height: 28px; width: term-text.preferred-width + 20px; border-radius: 4px;
                    background: term-touch.has-hover ? Theme.hover : Theme.sunken;
                    accessible-role: button; accessible-label: term;
                    accessible-action-default => { root.category(term); }
                    term-text := Text { text: term; color: Theme.text; font-size: 13px; font-weight: 500; }
                    term-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.category(term); } }
                }
            }
        }
        if root.note != "": Text {
            x: 24px; y: 40px; width: parent.width - 48px;
            text: root.note; color: Theme.muted; font-size: 15px; wrap: word-wrap; horizontal-alignment: center;
        }
    }
}

// A tab of the picker above the composer: GIFs or Emoji.
export component PickerTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    width: label.preferred-width + 24px; height: 30px; border-radius: 6px;
    background: root.selected ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab; accessible-label: root.text; accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text; font-size: 14px; font-weight: 600;
        color: root.selected || touch.has-hover ? Theme.text : Theme.secondary;
    }
    touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}
