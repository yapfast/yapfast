import { Theme, Badges } from "theme.slint";
import { ActionButton, TextField } from "controls.slint";

// Marks something from Discord: its logo, white on blurple, on a ring of the
// colour behind it.
export component DiscordBadge inherits Rectangle {
    in property <length> size;
    in property <color> ring;
    visible: Badges.discord;
    width: root.size + 4px; height: self.width; border-radius: self.width / 2;
    background: root.ring;
    Rectangle {
        width: root.size; height: root.size; border-radius: root.size / 2;
        background: #5865f2;
        Image {
            source: @image-url("icons/discord.svg");
            width: root.size * 0.62; height: self.width; image-fit: contain;
            colorize: white;
        }
    }
}

// Linking Discord by QR code: the risk to the account first, then the code to
// scan with the phone app, then who scanned it while they confirm. A token
// pasted instead links without the phone. The phase is 0 before linking, 1
// while Yapfast gets a code, 2 showing it, 3 once it's scanned, 4 when linking
// failed, 5 while Discord's captcha waits in the browser, and 6 while Discord
// checks a token.
export component DiscordLinkPanel inherits VerticalLayout {
    in property <int> phase;
    in property <image> code;
    in property <string> name;
    in property <string> note;
    callback begin;
    // Opens the captcha's page in the browser again.
    callback reopen;
    callback link-token(string);
    // Kept here, outside the phases, so a token Discord refused stays to fix.
    property <bool> token-open;
    property <string> token;
    spacing: 16px;
    if root.phase == 0 || root.phase == 4: VerticalLayout {
        spacing: 12px;
        Rectangle {
            min-height: warning.preferred-height;
            background: Theme.danger.with-alpha(0.1); border-radius: 8px;
            border-width: 1px; border-color: Theme.danger.with-alpha(0.35);
            warning := HorizontalLayout {
                padding: 12px; spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    Image { source: @image-url("icons/triangle-alert.svg"); width: 18px; height: 18px; colorize: Theme.danger; }
                }
                Text {
                    text: @tr("Discord doesn't allow apps like Yapfast on personal accounts. Linking puts your account at some risk of being suspended.");
                    color: Theme.text; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1;
                }
            }
        }
        if root.phase == 4: Text { text: root.note; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; spacing: 8px;
            ActionButton {
                text: root.phase == 4 && !root.token-open ? @tr("Try again") : @tr("Show the code"); primary: !root.token-open;
                clicked => { root.begin(); }
            }
            if !root.token-open: ActionButton {
                text: @tr("Use a token");
                clicked => { root.token-open = true; }
            }
        }
        if root.token-open: VerticalLayout {
            spacing: 8px;
            Text { text: @tr("TOKEN"); color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    text <=> root.token; password: true; placeholder: @tr("Discord token"); label: @tr("Discord token");
                    init => { self.focus-input(); }
                    accepted => { root.link-token(root.token); }
                }
                ActionButton { text: @tr("Link"); primary: true; enabled: root.token != ""; clicked => { root.link-token(root.token); } }
            }
            Text {
                text: @tr("Anyone with your token can use your account. Paste it only here, and never share it.");
                color: Theme.secondary; font-size: 13px; wrap: word-wrap;
            }
        }
    }
    if root.phase == 6: Text { text: @tr("Checking the token..."); color: Theme.secondary; font-size: 15px; wrap: word-wrap; }
    if root.phase == 5: VerticalLayout {
        spacing: 8px;
        Text { text: @tr("Solve the captcha in your browser"); color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
        Text {
            text: @tr("Discord wants to check you're a person before it links your account. Yapfast opened the check in your browser; linking finishes once it's solved.");
            color: Theme.secondary; font-size: 14px; wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start; padding-top: 8px;
            ActionButton { text: @tr("Open it again"); clicked => { root.reopen(); } }
        }
    }
    if root.phase >= 1 && root.phase <= 3: HorizontalLayout {
        spacing: 20px;
        Rectangle {
            width: 184px; height: 184px; border-radius: 12px;
            background: root.phase == 2 ? #ffffff : Theme.sunken;
            if root.phase == 2: Image {
                source: root.code; width: 176px; height: 176px; image-rendering: pixelated;
                accessible-role: image; accessible-label: @tr("QR code that links Discord");
            }
            if root.phase == 1: Text { text: @tr("Getting a code..."); color: Theme.muted; font-size: 14px; }
            if root.phase == 3: VerticalLayout {
                alignment: center; spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/check.svg"); width: 40px; height: 40px; colorize: Theme.live; }
                }
                Text { text: @tr("Scanned"); color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 8px; horizontal-stretch: 1;
            Text {
                text: root.phase == 3 ? @tr("Confirm on your phone") : @tr("Scan it with the Discord app");
                color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap;
            }
            Text {
                text: root.phase == 3
                    ? @tr("Linking {}. Tap Log in on your phone to finish.", root.name)
                    : @tr("On your phone, open Discord, go to Settings, tap Scan QR Code, and point the camera here. A new code replaces this one after a couple of minutes.");
                color: Theme.secondary; font-size: 14px; wrap: word-wrap;
            }
        }
    }
}
