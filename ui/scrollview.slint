// Yapfast's ScrollView and ListView: the Fluent style's, with a scrollbar thumb that
// stays under the pointer while it's dragged.
//
// The Fluent bar starts its drag over whenever `maximum` changes. In a ListView
// that happens all through a drag, as each newly measured row changes the
// estimate of the content's height, and every restart drops part of the
// pointer's travel, so the thumb falls behind it. This bar instead places the
// thumb where the pointer has moved it to since the drag began, as a share of
// the track, and scrolls the viewport to the same share of `maximum` as it is
// at that moment.
//
// The Slint compiler virtualizes the rows of any component named `ListView`
// that has `content-y`, `content-height`, `content-width`, `visible-height` and
// `visible-width` lengths, so this ListView is virtualized as the std-widgets
// one is.
import { Theme } from "theme.slint";

component ScrollBarButton inherits TouchArea {
    in property <image> icon;
    in property <bool> horizontal;

    width: root.horizontal ? 6px : 8px;
    height: root.horizontal ? 8px : 6px;

    icon := Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        source: root.icon;
        colorize: Theme.dark ? #FFFFFF14 : #00000073;
        accessible-role: none;

        animate colorize, opacity { duration: 150ms; }
        animate width, height { duration: 150ms; easing: ease-out; }
    }

    states [
        pressed when root.pressed : {
            opacity: 1;
            icon.width: root.width - 2px;
        }
        hover when root.has-hover : {
            opacity: 1;
            icon.colorize: Theme.dark ? #FFFFFFC9 : #00000099;
        }
    ]
}

component ScrollBar inherits Rectangle {
    in-out property <bool> horizontal;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> enabled;

    callback scrolled();

    property <length> offset: 16px;
    property <length> size: 2px;
    property <length> track-size: root.horizontal ? root.width - 2 * root.offset : root.height - 2 * offset;
    property <length> step-size: 10px;
    property <length> thumb-length: root.maximum <= 0phx ? 0phx
        : max(min(16px, root.horizontal ? root.width : root.height), root.track-size * root.page-size / (root.maximum + root.page-size));
    // How far the thumb can move along the track.
    property <length> travel: root.track-size - root.thumb-length;
    property <float> share: root.maximum <= 0phx ? 0 : -root.value / root.maximum;

    border-width: 1px;
    border-radius: 7px;
    // Under a pixel is a fractional width's rounding, not something to scroll.
    visible: (self.policy == ScrollBarPolicy.always-on) || (self.policy == ScrollBarPolicy.as-needed && self.maximum > 1px);
    clip: true;

    states [
        hover when touch-area.has-hover || down-scroll-button.has-hover || up-scroll-button.has-hover : {
            root.background: Theme.dark ? #2C2C2C : #f0f0f0;
            root.size: 6px;
            up-scroll-button.opacity: 1;
            down-scroll-button.opacity: 1;
        }
    ]

    animate size { duration: 150ms; easing: ease-out; }

    // A ListView's rows, measured as they come into view, change its estimate of
    // their height all through a drag; the thumb stays with the pointer.
    changed maximum => { touch-area.follow(); }

    thumb := Rectangle {
        width: !root.horizontal ? root.size : root.thumb-length;
        height: root.horizontal ? root.size : root.thumb-length;
        x: !root.horizontal ? parent.width - 4px - self.width : root.offset + root.travel * root.share;
        y: root.horizontal ? parent.height - 4px - self.height : root.offset + root.travel * root.share;
        border-radius: (root.horizontal ? self.height : self.width) / 2;
        background: Theme.dark ? #FFFFFF14 : #00000073;

        animate width, height { duration: 150ms; easing: ease-out; }
    }

    touch-area := TouchArea {
        // Where the thumb and the pointer were along the track when the drag began.
        property <length> pressed-thumb;
        property <length> pressed-pointer;

        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-thumb = root.travel * root.share;
                self.pressed-pointer = root.horizontal ? self.mouse-x : self.mouse-y;
            }
        }

        // Puts the thumb where the pointer has moved it, and the viewport with it.
        function follow() {
            if (self.enabled && self.pressed && root.travel > 0px) {
                root.value = -root.maximum * max(0, min(1,
                    (self.pressed-thumb + (root.horizontal ? self.mouse-x : self.mouse-y) - self.pressed-pointer) / root.travel));
                root.scrolled();
            }
        }

        moved => { self.follow(); }

        scroll-event(event) => {
            if (root.horizontal && event.delta-x != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-x));
                return accept;
            } else if (!root.horizontal && event.delta-y != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-y));
                return accept;
            }
            reject
        }
    }

    up-scroll-button := ScrollBarButton {
        opacity: 0;
        x: !root.horizontal ? (parent.width - self.width) / 2 : 4px;
        y: root.horizontal ? (parent.height - self.height) / 2 : 4px;
        icon: root.horizontal ? @image-url("icons/scroll-left.svg") : @image-url("icons/scroll-up.svg");
        horizontal: root.horizontal;

        clicked => {
            root.value = min(0px, root.value + root.step-size);
        }
    }

    down-scroll-button := ScrollBarButton {
        opacity: 0;
        x: !root.horizontal ? (parent.width - self.width) / 2 : root.width - self.width - 4px;
        y: root.horizontal ? (parent.height - self.height) / 2 : root.height - self.height - 4px;
        icon: root.horizontal ? @image-url("icons/scroll-right.svg") : @image-url("icons/scroll-down.svg");
        horizontal: root.horizontal;

        clicked => {
            root.value = max(-root.maximum, root.value - root.step-size);
        }
    }
}

export component ScrollView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-x <=> flickable.content-x;
    in-out property <length> content-y <=> flickable.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy <=> vertical-bar.policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy <=> horizontal-bar.policy;
    in property <bool> mouse-drag-pan-enabled <=> flickable.mouse-drag-pan-enabled;

    callback scrolled <=> flickable.flicked;

    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;

    flickable := Flickable {
        mouse-drag-pan-enabled: false;
        content-y <=> vertical-bar.value;
        content-x <=> horizontal-bar.value;
        width: parent.width;
        height: parent.height;

        @children
    }

    vertical-bar := ScrollBar {
        enabled: root.enabled;
        width: 14px;
        x: flickable.width + flickable.x - self.width;
        y: flickable.y;
        height: horizontal-bar.visible ? parent.height - horizontal-bar.height : parent.height;
        horizontal: false;
        maximum: flickable.content-height - flickable.height;
        page-size: flickable.height;

        scrolled => { root.scrolled() }
    }

    horizontal-bar := ScrollBar {
        enabled: root.enabled;
        width: vertical-bar.visible ? parent.width - vertical-bar.width : parent.width;
        height: 14px;
        y: flickable.height + flickable.y - self.height;
        x: flickable.x;
        horizontal: true;
        maximum: flickable.content-width - flickable.width;
        page-size: flickable.width;

        scrolled => { root.scrolled() }
    }
}

export component ListView inherits ScrollView {
    @children
    accessible-role: list;
    accessible-orientation: Orientation.vertical;
}

// Where an autoscroll began, which Slint's core reports to the application:
// see `yapfast_autoscroll` in vendor/i-slint-core.
export global Autoscroll {
    in-out property <bool> shown;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> vertical;
    in-out property <bool> horizontal;
}

component AutoscrollArrow inherits Path {
    in property <bool> horizontal;

    width: root.horizontal ? 5px : 8px;
    height: root.horizontal ? 8px : 5px;
    viewbox-width: root.horizontal ? 5 : 8;
    viewbox-height: root.horizontal ? 8 : 5;
    fill: Theme.secondary;
}

// A circle at the click, with arrows the ways the list can go, as browsers mark it.
export component AutoscrollMarker inherits Rectangle {
    x: Autoscroll.x - self.width / 2;
    y: Autoscroll.y - self.height / 2;
    width: 30px;
    height: 30px;
    border-radius: self.width / 2;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000060;
    drop-shadow-offset-y: 2px;

    Rectangle {
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.secondary;
    }

    if Autoscroll.vertical: AutoscrollArrow { y: 5px; commands: "M 0 5 L 4 0 L 8 5 Z"; }
    if Autoscroll.vertical: AutoscrollArrow { y: parent.height - self.height - 5px; commands: "M 0 0 L 4 5 L 8 0 Z"; }
    if Autoscroll.horizontal: AutoscrollArrow { horizontal: true; x: 5px; commands: "M 5 0 L 0 4 L 5 8 Z"; }
    if Autoscroll.horizontal: AutoscrollArrow { horizontal: true; x: parent.width - self.width - 5px; commands: "M 0 0 L 5 4 L 0 8 Z"; }
}
