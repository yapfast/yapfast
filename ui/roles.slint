import { Theme, Middle, Label, Tip } from "theme.slint";
import { ActionButton, Avatar, IconButton, TextField, PictureStore } from "controls.slint";
import { SettingsTitle, SettingsHeading, SettingsSwitch } from "settings.slint";
import { ListView } from "scrollview.slint";

/// A role as Roles lists it.
export struct RoleRow {
    id: string,
    name: string,
    /// Its colour, or Discord's grey for none.
    color: color,
    icon-url: string,
    emoji: string,
    /// How many members hold it.
    members: string,
    /// This account can't change it, and why: Discord's words.
    locked: bool,
    lock-text: string,
    /// What gives it, such as "BOT", when people don't.
    badge: string,
    /// Duplicate Role and Delete show for it.
    may-copy: bool,
    /// Its place in the list, 0 the top.
    index: int,
}

/// A row of the Permissions tab: a group's heading, or a permission's
/// switch, by its bit.
export struct PermissionRow {
    heading: bool,
    title: string,
    description: string,
    /// A warning after the description, in bold.
    warning: string,
    bit: int,
    on: bool,
    /// Why the switch can't change, in Discord's words; empty when it can.
    lock-text: string,
}

/// A member on Manage Members or in Add Members.
export struct RoleMemberRow {
    id: string,
    name: string,
    username: string,
    avatar-url: string,
    initial: string,
    /// Picked in Add Members.
    chosen: bool,
}

/// One of Discord's role colours.
export struct RoleSwatch {
    color: color,
    chosen: bool,
}

/// What Roles shows.
export struct RolesPrompt {
    // The list.
    everyone-id: string,
    everyone-name: string,
    rows: [RoleRow],
    /// "Roles – 3".
    heading: string,
    /// What the searches hold, for their fields made again.
    search: string,
    permission-search: string,
    member-search: string,
    /// Dragging works: the search hides no role.
    may-drag: bool,
    /// The highest place a role can move to, below the locked ones.
    first-movable: int,
    may-create: bool,
    // The editor.
    open: bool,
    open-id: string,
    /// "Edit Role — Mods".
    title: string,
    everyone: bool,
    /// 0 Display, 1 Permissions, 2 Manage Members.
    tab: int,
    locked: bool,
    /// Why the role can't change, or what manages it.
    notice: string,
    /// The role has no colour, Discord's default, or one of these, a
    /// bright row then a dark one.
    default-color: bool,
    bright: [RoleSwatch],
    dark: [RoleSwatch],
    color: color,
    /// The colour as "#rrggbb", for the custom colour's field, and whether
    /// it's none of Discord's.
    hex: string,
    custom-color: bool,
    hoist: bool,
    mentionable: bool,
    icon-url: string,
    icon-new: image,
    emoji: string,
    has-icon: bool,
    /// "Unlocks at Level 2", until the server's level gives roles icons.
    icon-locked: string,
    permissions: [PermissionRow],
    may-clear: bool,
    clear-lock: string,
    /// "Manage Members (3)".
    members-title: string,
    members-loading: bool,
    members-error: string,
    members: [RoleMemberRow],
    /// More hold the role than Discord listed.
    not-all: bool,
    may-add: bool,
    // What Roles asks: 0 nothing, 1 Delete Role, 2 Remove member.
    confirm: int,
    confirm-role: string,
    confirm-member: string,
    // Add Members, while it's open.
    adding: bool,
    candidates: [RoleMemberRow],
    picked: int,
}

// A role's colour dot, or its icon or emoji in its place.
component RoleMark inherits Rectangle {
    in property <RoleRow> role;
    property <image> icon: root.role.icon-url != "" ? PictureStore.picture(root.role.icon-url, PictureStore.revision(root.role.icon-url)) : @image-url("");
    // Only while it isn't loaded: a request refreshes the list, which
    // makes the row again.
    init => { if root.role.icon-url != "" && root.icon.width == 0 { PictureStore.request(root.role.icon-url); } }
    width: 20px; height: 20px;
    if root.icon.width > 0: Image { width: 20px; height: 20px; source: root.icon; image-fit: contain; }
    if root.icon.width == 0 && root.role.emoji != "": Text { text: root.role.emoji; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
    if root.icon.width == 0 && root.role.emoji == "": Rectangle {
        width: 14px; height: 14px; border-radius: 7px; background: root.role.color;
    }
}

// A role in the list: its handle to drag by, its mark, name and members,
// and Edit and More. Dragging it a row's height or more moves it there.
component RoleListRow inherits Rectangle {
    in property <RoleRow> role;
    in property <bool> may-drag;
    in property <int> count;
    in property <int> first-movable;
    callback open;
    callback moved(int);
    callback copy;
    callback delete;
    property <length> offset: 0px;
    property <bool> dragging;
    property <length> row-height: 52px;
    height: root.row-height;
    states [
        dragged when root.dragging: { inner.background: Theme.raised; }
    ]
    inner := Rectangle {
        y: root.offset; height: root.row-height;
        border-radius: 6px;
        background: pointer.has-hover ? Theme.overlay.with-alpha(0.05) : transparent;
        pointer := TouchArea { clicked => { root.open(); } }
        HorizontalLayout {
            padding-left: 4px; padding-right: 8px; spacing: 10px;
            // The handle: two columns of three dots.
            handle := Rectangle {
                width: 20px;
                property <bool> usable: root.may-drag && !root.role.locked;
                opacity: self.usable ? (drag.has-hover || root.dragging ? 1 : 0.5) : 0;
                for dot in 6: Rectangle {
                    x: 6px + mod(dot, 2) * 6px; y: parent.height / 2 - 7px + floor(dot / 2) * 6px;
                    width: 3px; height: 3px; border-radius: 1.5px; background: Theme.muted;
                }
                drag := TouchArea {
                    enabled: parent.usable;
                    mouse-cursor: self.enabled ? MouseCursor.grab : MouseCursor.default;
                    moved => {
                        if self.pressed {
                            root.dragging = true;
                            root.offset = self.mouse-y - self.pressed-y;
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up && root.dragging {
                            root.dragging = false;
                            root.moved(root.role.index + round(root.offset / root.row-height));
                            root.offset = 0px;
                        }
                    }
                }
            }
            Middle { RoleMark { role: root.role; } }
            if root.role.locked: Middle {
                Image {
                    width: 14px; height: 14px; source: @image-url("icons/lock.svg"); colorize: Theme.muted;
                    accessible-role: image; accessible-label: root.role.lock-text;
                    TouchArea {
                        changed has-hover => {
                            if self.has-hover {
                                Tip.text = root.role.lock-text;
                                Tip.side = 0;
                                Tip.x = self.absolute-position.x + self.width / 2;
                                Tip.y = self.absolute-position.y;
                            } else if Tip.text == root.role.lock-text {
                                Tip.text = "";
                            }
                        }
                    }
                }
            }
            Middle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Text { text: root.role.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                    if root.role.badge != "": Middle {
                        Rectangle {
                            height: 16px; width: badge.preferred-width + 8px; border-radius: 3px; background: Theme.accent;
                            badge := Text { text: root.role.badge; color: #ffffff; font-size: 10px; font-weight: 700; }
                        }
                    }
                }
            }
            Middle {
                width: 80px;
                HorizontalLayout {
                    spacing: 4px; alignment: start;
                    Text { text: root.role.members; color: Theme.secondary; font-size: 14px; vertical-alignment: center; }
                    Middle { Image { width: 16px; height: 16px; source: @image-url("icons/user.svg"); colorize: Theme.secondary; } }
                }
            }
            Middle {
                IconButton {
                    icon: root.role.locked ? @image-url("icons/eye.svg") : @image-url("icons/pencil.svg");
                    label: root.role.locked ? @tr("View") : @tr("Edit"); fill: Theme.raised; radius: 16px;
                    clicked => { root.open(); }
                }
            }
            Middle {
                IconButton {
                    icon: @image-url("icons/ellipsis.svg"); label: @tr("More"); fill: Theme.raised; radius: 16px;
                    enabled: root.role.may-copy;
                    opacity: self.enabled ? 1 : 0.4;
                    clicked => { more.show(); }
                }
            }
        }
    }
    more := PopupWindow {
        x: root.width - 200px; y: root.row-height - 4px; width: 180px;
        Rectangle {
            background: Theme.raised; border-radius: 6px; drop-shadow-blur: 12px; drop-shadow-color: #00000066;
            VerticalLayout {
                padding: 6px; spacing: 2px;
                for item[index] in [
                    { text: @tr("Move Up"), danger: false, enabled: root.may-drag && !root.role.locked && root.role.index > root.first-movable },
                    { text: @tr("Move Down"), danger: false, enabled: root.may-drag && !root.role.locked && root.role.index < root.count - 1 },
                    { text: @tr("Duplicate Role"), danger: false, enabled: root.role.may-copy },
                    { text: @tr("Delete"), danger: true, enabled: root.role.may-copy },
                ]: Rectangle {
                    height: 32px; border-radius: 4px;
                    background: area.has-hover && item.enabled ? (item.danger ? Theme.danger : Theme.accent) : transparent;
                    Text {
                        x: 8px; text: item.text; font-size: 14px; vertical-alignment: center;
                        color: !item.enabled ? Theme.faint : area.has-hover ? #ffffff : item.danger ? Theme.danger : Theme.text;
                    }
                    area := TouchArea {
                        enabled: item.enabled;
                        clicked => {
                            if index == 0 { root.moved(root.role.index - 1); }
                            if index == 1 { root.moved(root.role.index + 1); }
                            if index == 2 { root.copy(); }
                            if index == 3 { root.delete(); }
                        }
                    }
                }
            }
        }
    }
}

// A tab of the role editor.
component RoleTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px; width: label.preferred-width + 8px;
    accessible-role: tab; accessible-label: root.text;
    label := Text {
        y: 6px; text: root.text; font-size: 15px; font-weight: 600;
        color: !root.enabled ? Theme.faint : root.selected ? Theme.text : (area.has-hover ? Theme.text : Theme.secondary);
    }
    Rectangle {
        y: parent.height - 2px; height: 2px; background: root.selected ? Theme.accent : transparent;
    }
    area := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// A member on Manage Members: avatar, names, and the button that takes the
// role from them.
component RoleMemberLine inherits Rectangle {
    in property <RoleMemberRow> member;
    in property <bool> removable;
    callback remove;
    height: 44px;
    HorizontalLayout {
        spacing: 10px; padding-right: 4px;
        Middle { Avatar { size: 32px; initial: root.member.initial; picture-url: root.member.avatar-url; } }
        Middle {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px; alignment: start;
                Text { text: root.member.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: root.member.username; color: Theme.muted; font-size: 14px; overflow: elide; }
            }
        }
        Middle {
            IconButton {
                icon: @image-url("icons/x.svg"); label: root.removable ? @tr("Remove member") : @tr("Members cannot be manually added or removed from this role");
                enabled: root.removable; opacity: self.enabled ? 1 : 0.4;
                clicked => { root.remove(); }
            }
        }
    }
}

// Roles, as Discord's page has it: the roles in their order, which dragging
// changes, and the editor of one, with its Display, Permissions and Manage
// Members tabs.
export component RolesSection inherits VerticalLayout {
    in property <RolesPrompt> page;
    in property <bool> saving;
    in property <bool> reading;
    in-out property <string> name;
    /// A text written: 0 the list's search, 1 the role's name, 2 the
    /// permissions' search, 3 the members' search; 5 an emoji for the icon
    /// and 6 a colour as hex, once entered.
    callback write(int, string);
    /// Open a role by id, or go back to the list with "".
    callback open(string);
    callback tab(int);
    /// A colour: -1 Discord's default, else one of the swatches.
    callback color(int);
    /// 0 separate members, 1 mentionable, 2 clear permissions.
    callback toggle(int);
    callback permission(int);
    callback move(string, int);
    /// 0 Create Role, 1 Duplicate Role, 2 Delete, 3 Remove member,
    /// 6 Add Members; by the role's or member's id.
    callback act(int, string);
    callback pick-icon;
    callback remove-icon;
    property <bool> ready: !root.saving;
    property <bool> editable: root.ready && !root.page.locked;
    spacing: 16px;
    if !root.page.open: VerticalLayout {
        spacing: 16px;
        SettingsTitle { text: @tr("Roles"); }
        Label { text: @tr("Use roles to group your server members and assign permissions."); }
        // @everyone's card.
        Rectangle {
            height: 64px; border-radius: 8px;
            background: everyone.has-hover ? Theme.raised.brighter(0.1) : Theme.raised;
            accessible-role: button; accessible-label: @tr("Default Permissions");
            everyone := TouchArea { clicked => { root.open(root.page.everyone-id); } }
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 12px;
                Middle {
                    Rectangle {
                        width: 36px; height: 36px; border-radius: 18px; background: Theme.field;
                        Image { width: 20px; height: 20px; source: @image-url("icons/users.svg"); colorize: Theme.secondary; }
                    }
                }
                Middle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Default Permissions"); color: Theme.text; font-size: 15px; font-weight: 600; }
                        Text { text: @tr("{} • applies to all server members", root.page.everyone-name); color: Theme.secondary; font-size: 13px; }
                    }
                }
                Middle { Image { width: 18px; height: 18px; source: @image-url("icons/chevron-right.svg"); colorize: Theme.secondary; } }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            TextField {
                placeholder: @tr("Search Roles"); label: @tr("Search Roles"); text-size: 14px; text: root.page.search;
                edited(text) => { root.write(0, text); }
            }
            ActionButton {
                text: @tr("Create Role"); primary: true; enabled: root.ready && root.page.may-create;
                clicked => { root.act(0, ""); }
            }
        }
        Label { text: @tr("Members use the color of the highest role they have on this list. Drag roles to reorder them."); }
        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding-left: 4px; padding-right: 8px; padding-bottom: 6px; spacing: 10px;
                Rectangle { width: 20px; }
                SettingsHeading { text: root.page.heading; horizontal-stretch: 1; }
                SettingsHeading { text: @tr("MEMBERS"); width: 80px + 32px + 32px + 20px; }
            }
            Rectangle { height: 1px; background: Theme.line; }
            if root.page.rows.length == 0: Label { text: @tr("No roles"); }
            for role in root.page.rows: RoleListRow {
                role: role; may-drag: root.page.may-drag && root.ready; count: root.page.rows.length;
                first-movable: root.page.first-movable;
                open => { root.open(role.id); }
                moved(to) => { root.move(role.id, to); }
                copy => { root.act(1, role.id); }
                delete => { root.act(2, role.id); }
            }
        }
    }
    if root.page.open: VerticalLayout {
        spacing: 16px; vertical-stretch: 1;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: back.preferred-width + 24px; height: 28px;
                accessible-role: button; accessible-label: @tr("Back");
                HorizontalLayout {
                    spacing: 4px;
                    Middle { Image { width: 16px; height: 16px; source: @image-url("icons/chevron-left.svg"); colorize: back-area.has-hover ? Theme.text : Theme.secondary; } }
                    back := Text { text: @tr("Back"); font-size: 14px; font-weight: 600; vertical-alignment: center; color: back-area.has-hover ? Theme.text : Theme.secondary; }
                }
                back-area := TouchArea { clicked => { root.open(""); } }
            }
        }
        SettingsTitle { text: root.page.title; }
        if root.page.notice != "": Rectangle {
            border-radius: 6px; background: Theme.raised; height: notice.preferred-height + 20px;
            notice := Text { x: 12px; width: parent.width - 24px; text: root.page.notice; color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: 24px; alignment: start;
            RoleTabButton { text: @tr("Display"); selected: root.page.tab == 0; enabled: !root.page.everyone; clicked => { root.tab(0); } }
            RoleTabButton { text: @tr("Permissions"); selected: root.page.tab == 1; clicked => { root.tab(1); } }
            RoleTabButton { text: root.page.members-title; selected: root.page.tab == 2; enabled: !root.page.everyone; clicked => { root.tab(2); } }
        }
        Rectangle { height: 1px; background: Theme.line; }
        if root.page.tab == 0: VerticalLayout {
            spacing: 20px;
            VerticalLayout {
                spacing: 8px;
                SettingsHeading { text: @tr("ROLE NAME"); }
                TextField {
                    text <=> root.name; label: @tr("Role name"); enabled: root.editable;
                    edited(text) => { root.write(1, text); }
                }
            }
            VerticalLayout {
                spacing: 8px;
                SettingsHeading { text: @tr("ROLE COLOR"); }
                Label { text: @tr("Members use the color of the highest role they have on the roles list."); }
                HorizontalLayout {
                    spacing: 10px; alignment: start;
                    // Discord's default, then its colours in two rows.
                    Rectangle {
                        width: 66px; height: 50px; border-radius: 4px; background: #99aab5;
                        accessible-role: button; accessible-label: @tr("Default");
                        if root.page.default-color: Image { width: 20px; height: 20px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
                        TouchArea { enabled: root.editable; clicked => { root.color(-1); } }
                    }
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            for swatch[index] in root.page.bright: Rectangle {
                                width: 20px; height: 20px; border-radius: 4px; background: swatch.color;
                                accessible-role: button; accessible-label: @tr("Color {}", (index + 1));
                                if swatch.chosen: Image { width: 14px; height: 14px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
                                TouchArea { enabled: root.editable; clicked => { root.color(index); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            for swatch[index] in root.page.dark: Rectangle {
                                width: 20px; height: 20px; border-radius: 4px; background: swatch.color;
                                accessible-role: button; accessible-label: @tr("Color {}", (index + 11));
                                if swatch.chosen: Image { width: 14px; height: 14px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
                                TouchArea { enabled: root.editable; clicked => { root.color(index + 10); } }
                            }
                        }
                    }
                    // Any other colour, as hex, in place of Discord's picker.
                    Rectangle {
                        width: 50px; height: 50px; border-radius: 4px; background: root.page.color;
                        accessible-role: image; accessible-label: @tr("Custom color");
                        if root.page.custom-color: Image { width: 20px; height: 20px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
                    }
                    VerticalLayout {
                        alignment: center;
                        hex := TextField {
                            property <string> shown: root.page.hex;
                            changed shown => { self.text = self.shown; }
                            init => { self.text = self.shown; }
                            width: 110px; min-height: 36px; text-size: 14px; pad: 10px;
                            placeholder: "#99aab5"; label: @tr("Custom color"); enabled: root.editable;
                            accepted => { root.write(6, self.text); }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                SettingsHeading { text: @tr("ROLE ICON"); }
                Label { text: @tr("Upload an image under 256 KB or use an emoji. We recommend at least 64x64 pixels. Members will see the icon for their highest role if they have multiple roles."); }
                HorizontalLayout {
                    spacing: 16px; alignment: start;
                    Rectangle {
                        width: 64px; height: 64px; border-radius: 8px; background: Theme.sunken;
                        property <image> shown: root.page.icon-url != "" ? PictureStore.picture(root.page.icon-url, PictureStore.revision(root.page.icon-url)) : root.page.icon-new;
                        init => { if root.page.icon-url != "" && self.shown.width == 0 { PictureStore.request(root.page.icon-url); } }
                        if self.shown.width > 0: Image { width: 48px; height: 48px; source: parent.shown; image-fit: contain; }
                        if self.shown.width == 0 && root.page.emoji != "": Text { text: root.page.emoji; font-size: 36px; }
                        if self.shown.width == 0 && root.page.emoji == "": Image { width: 24px; height: 24px; source: @image-url("icons/image.svg"); colorize: Theme.muted; }
                    }
                    VerticalLayout {
                        spacing: 8px; alignment: center;
                        if root.page.icon-locked != "": Label { text: root.page.icon-locked; }
                        if root.reading: Label { text: @tr("Reading the picture..."); }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            ActionButton {
                                text: @tr("Choose Image"); enabled: root.editable && !root.reading && root.page.icon-locked == "";
                                clicked => { root.pick-icon(); }
                            }
                            if root.page.has-icon: ActionButton {
                                text: @tr("Remove Icon"); ghost: true; enabled: root.editable && root.page.icon-locked == "";
                                clicked => { root.remove-icon(); }
                            }
                        }
                        // An emoji typed or pasted, in place of Discord's
                        // emoji picker.
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            emoji := TextField {
                                width: 110px; min-height: 36px; text-size: 14px; pad: 10px;
                                placeholder: @tr("Emoji"); label: @tr("Role icon emoji");
                                enabled: root.editable && root.page.icon-locked == "";
                                // The preview shows what was used; the field
                                // empties for another.
                                accepted => { root.write(5, self.text); self.text = ""; }
                            }
                            ActionButton {
                                text: @tr("Use Emoji"); ghost: true;
                                enabled: root.editable && root.page.icon-locked == "" && emoji.text != "";
                                clicked => { root.write(5, emoji.text); emoji.text = ""; }
                            }
                        }
                    }
                }
            }
            SettingsSwitch {
                text: @tr("Display role members separately from online members");
                checked: root.page.hoist; controlled: true; enabled: root.editable;
                toggled => { root.toggle(0); }
            }
            SettingsSwitch {
                text: @tr("Allow anyone to @mention this role");
                description: @tr("Note: Members with the \"Mention @everyone, @here, and All Roles\" permission will always be able to ping this role.");
                checked: root.page.mentionable; controlled: true; enabled: root.editable;
                toggled => { root.toggle(1); }
            }
        }
        if root.page.tab == 1: VerticalLayout {
            spacing: 16px; vertical-stretch: 1;
            HorizontalLayout {
                spacing: 12px;
                TextField {
                    placeholder: @tr("Search permissions"); label: @tr("Search permissions"); text-size: 14px; text: root.page.permission-search;
                    edited(text) => { root.write(2, text); }
                }
                clear := ActionButton {
                    text: @tr("Clear permissions"); ghost: true; enabled: root.editable && root.page.may-clear;
                    clicked => { root.toggle(2); }
                    if root.page.clear-lock != "": TouchArea {
                        changed has-hover => {
                            if self.has-hover {
                                Tip.text = root.page.clear-lock;
                                Tip.side = 0;
                                Tip.x = self.absolute-position.x + self.width / 2;
                                Tip.y = self.absolute-position.y;
                            } else if Tip.text == root.page.clear-lock {
                                Tip.text = "";
                            }
                        }
                    }
                }
            }
            if root.page.permissions.length == 0: Label { text: @tr("No permissions found"); }
            // Only the rows in sight are made: all of them took 1.4 MiB.
            ListView {
                vertical-stretch: 1; min-height: 120px;
                for row in root.page.permissions: VerticalLayout {
                    spacing: 6px; padding-right: 12px; padding-top: row.heading ? 16px : 4px; padding-bottom: row.heading ? 8px : 0px;
                    if row.heading: SettingsHeading { text: row.title; }
                    if !row.heading: VerticalLayout {
                        spacing: 4px; padding-bottom: 12px;
                        SettingsSwitch {
                            text: row.title; description: row.description;
                            checked: row.on; controlled: true; enabled: root.editable && row.lock-text == "";
                            locked-tip: root.page.locked ? root.page.notice : row.lock-text;
                            toggled => { root.permission(row.bit); }
                        }
                        if row.warning != "": Text { text: row.warning; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                        Rectangle { height: 1px; background: Theme.line; }
                    }
                }
            }
        }
        if root.page.tab == 2: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                TextField {
                    placeholder: @tr("Search Members"); label: @tr("Search Members"); text-size: 14px; text: root.page.member-search;
                    edited(text) => { root.write(3, text); }
                }
                ActionButton {
                    text: @tr("Add Members"); primary: true; enabled: root.ready && root.page.may-add;
                    clicked => { root.act(6, ""); }
                }
            }
            if root.page.not-all: Label { text: @tr("Not all members are shown, use Search to find specific members"); }
            if root.page.members-loading: Label { text: @tr("Loading..."); }
            if root.page.members-error != "": Text { text: root.page.members-error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
            if !root.page.members-loading && root.page.members-error == "" && root.page.members.length == 0: Label { text: @tr("No members were found."); }
            for member in root.page.members: RoleMemberLine {
                member: member; removable: root.ready && root.page.may-add;
                remove => { root.act(3, member.id); }
            }
        }
    }
}

// What Roles asks before deleting a role or taking it from a member, over
// the screen.
export component RoleConfirmDialog inherits Rectangle {
    in property <RolesPrompt> page;
    callback confirm;
    callback cancel;
    background: #000000aa;
    TouchArea { clicked => { root.cancel(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 12px;
                Text {
                    text: root.page.confirm == 1 ? @tr("Delete Role") : @tr("Remove member");
                    color: Theme.text; font-size: 20px; font-weight: 700;
                }
                Text {
                    text: root.page.confirm == 1
                        ? @tr("Are you sure you want to delete the {} role? This action cannot be undone.", root.page.confirm-role)
                        : @tr("Remove {0} from role {1}?", root.page.confirm-member, root.page.confirm-role);
                    color: Theme.secondary; font-size: 15px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; clicked => { root.cancel(); } }
                    ActionButton {
                        text: root.page.confirm == 1 ? @tr("Delete") : @tr("Remove"); danger: true;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

// Add Members, over the screen: a search of the server's members and those
// picked, up to 30.
export component AddMembersDialog inherits Rectangle {
    in property <RolesPrompt> page;
    in property <string> role-name;
    callback search(string);
    callback pick(string);
    callback add;
    callback close;
    background: #000000aa;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: min(520px, root.height - 80px);
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: @tr("Add members"); color: Theme.text; font-size: 20px; font-weight: 700; }
                Text { text: @tr("Select up to 30 members to add to role {}", root.role-name); color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                field := TextField {
                    placeholder: @tr("Search members"); label: @tr("Search members"); text-size: 14px;
                    init => { self.focus-input(); }
                    edited(text) => { root.search(text); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        for member in root.page.candidates: Rectangle {
                            height: 44px; border-radius: 4px;
                            background: area.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
                            accessible-role: checkbox; accessible-label: member.name; accessible-checked: member.chosen;
                            area := TouchArea { clicked => { root.pick(member.id); } }
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; spacing: 10px;
                                Middle {
                                    Rectangle {
                                        width: 18px; height: 18px; border-radius: 4px;
                                        border-width: 1px; border-color: Theme.line;
                                        background: member.chosen ? Theme.accent : transparent;
                                        if member.chosen: Image { width: 14px; height: 14px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
                                    }
                                }
                                Middle { Avatar { size: 28px; initial: member.initial; picture-url: member.avatar-url; } }
                                Middle {
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Text { text: member.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                        Text { text: member.username; color: Theme.muted; font-size: 14px; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                    ActionButton {
                        text: @tr("Add"); primary: true; enabled: root.page.picked > 0 && root.page.picked <= 30;
                        clicked => { root.add(); }
                    }
                }
            }
        }
    }
}
