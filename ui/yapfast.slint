            preview(id) => { root.preview-soundboard(id); }
            favorite(id, on) => { root.favorite-soundboard(id, on); }
            close => { soundboard-menu.close(); }
        }
    }
    share-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        // Wider for the screens' pictures.
