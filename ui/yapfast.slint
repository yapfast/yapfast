        open-captcha => { root.open-join-captcha(); }
        open-form => { root.open-join-form(); }
        close => { root.close-join(); }
    }
    event-motion := PopupMotion { open: root.event-open; }
    if event-motion.shown: EventDialog {
        motion: event-motion.amount;
        prompt: root.event-prompt;
        toggle-interest => { root.toggle-event-interest(); }
        close => { root.close-event(); }
    }
    gift-motion := PopupMotion { open: root.gift-open; }
    if gift-motion.shown: GiftDialog {
        motion: gift-motion.amount;
        prompt: root.gift-prompt;
        redeem => { root.redeem-gift(); }
        open-in-browser => { root.open-gift-in-browser(); }
        close => { root.close-gift(); }
    }
    oauth-motion := PopupMotion { open: root.oauth-open; }
    if oauth-motion.shown: OAuthDialog {
        motion: oauth-motion.amount;
        prompt: root.oauth-prompt; guilds: root.oauth-guilds; guild-chosen: root.oauth-guild-chosen;
        choose-guild(index) => { root.choose-oauth-guild(index); }
        authorize => { root.authorize-oauth(); }
        copy(address) => { root.copy-text(address); }
        close => { root.close-oauth(); }
    }
    channel-motion := PopupMotion { open: root.channel-open; }
    if channel-motion.shown: ChannelDialog {
        motion: channel-motion.amount;
        prompt: root.channel-prompt; name <=> root.channel-name; kind <=> root.channel-kind;
        save => { root.save-channel(); }
        close => { root.close-channel(); }
    }
    profile-editor-motion := PopupMotion { open: root.profile-editor-open; }
    if profile-editor-motion.shown: ProfileEditorDialog {
        open-link(url) => { root.open-link(url); }
