    property <bool> input-open: input-menu.is-open;
    property <bool> output-open: output-menu.is-open;
    changed input-open => { root.input-level = 0; root.meter-note = ""; root.metering(root.input-open); }
    Timer { interval: 50ms; running: root.input-open; triggered => { root.meter-tick(); } }
