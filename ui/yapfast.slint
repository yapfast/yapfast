        add-friend-name <=> root.add-friend-name;
        add-friend-sending: root.add-friend-sending; add-friend-sent: root.add-friend-sent; add-friend-note: root.add-friend-note;
        add-friend(name) => { root.add-friend(name); }
        close-add-friend => { root.close-add-friend(); }
    }
    // A Discord server's or channel's invite link; see InviteDialog.
    invite-motion := PopupMotion { open: root.invite-open; }
