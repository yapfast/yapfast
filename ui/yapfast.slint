        pick(kind) => { root.pick-profile-picture(kind); }
        reset(kind) => { root.reset-profile-picture(kind); }
        unlock-nitro => { root.unlock-nitro(); }
        undo => { root.undo-profile(); }
        save => { root.save-profile(); }
        close => { root.close-profile-editor(); }
    }
    move-sync-motion := PopupMotion { open: root.move-sync-open; }
    if move-sync-motion.shown: ChannelDialog {
        motion: move-sync-motion.amount;
        prompt: root.move-sync-prompt;
        save => { root.answer-move-sync(true); }
        alternative => { root.answer-move-sync(false); }
        close => { root.close-move-sync(); }
    }
    leave-motion := PopupMotion { open: root.leave-open; }
    if leave-motion.shown: ChannelDialog {
        motion: leave-motion.amount;
        prompt: root.leave-prompt;
        save => { root.confirm-leave(); }
        tick => { root.toggle-silent-leave(); }
        close => { root.close-leave(); }
    }
    // About a DM's other person; see PersonDialog.
    person-motion := PopupMotion { open: root.person-open; }
    if person-motion.shown: PersonDialog {
        motion: person-motion.amount;
        prompt: root.person-prompt; text <=> root.person-text; ticked <=> root.skip-call-prompt;
        tick(skip) => { root.skip-call-prompt-toggled(skip); }
        answer(text) => { root.answer-person(text); }
        choose(index) => { root.choose-person-option(index); }
        close => { root.close-person(); }
    }
    // The custom status; see StatusDialog.
    status-motion := PopupMotion { open: root.status-open; }
    if status-motion.shown: StatusDialog {
        motion: status-motion.amount;
        status-text <=> root.status-text; status-emoji <=> root.status-emoji; status-clear-after <=> root.status-clear-after;
        has-custom-status: root.has-custom-status; status-saving: root.status-saving; status-error: root.status-error;
        emoji-font: root.emoji-font;
        pick-emoji => { root.open-picker("yapfast:status"); }
        pick-emoji-beside(x, y, width, height) => {
            root.anchor(x, y, width, height, true);
            root.open-picker("yapfast:status");
        }
        save-status => { root.save-status(); }
        clear-status => { root.clear-status(); }
        close-status => { root.close-status(); }
    }
    // Making a poll; see PollDialog.
    poll-motion := PopupMotion { open: root.poll-open; }
    if poll-motion.shown: PollDialog {
        motion: poll-motion.amount;
        question <=> root.poll-question; question-count: root.poll-question-count;
        answers: root.poll-answers; duration: root.poll-duration; multiselect: root.poll-multiselect;
        can-add: root.poll-can-add; can-post: root.poll-can-post; posting: root.poll-posting;
        problem: root.poll-problem; emoji-font: root.emoji-font;
        question-edited(text) => { root.poll-question-edited(text); }
        answer-edited(index, text) => { root.poll-answer-edited(index, text); }
        pick-emoji(index, x, y, width, height) => {
            root.poll-emoji-answer = index;
            root.anchor(x, y, width, height, true);
            root.open-picker("yapfast:poll");
        }
        remove-emoji(index) => { root.poll-answer-emoji(index, ""); }
        add-answer => { root.poll-add-answer(); }
        remove-answer(index) => { root.poll-remove-answer(index); }
        choose-duration(index) => { root.poll-duration-chosen(index); }
        set-multiselect(on) => { root.poll-multiselect-set(on); }
        post => { root.post-poll(); }
        close => { root.close-poll(); }
    }
    // Starting a DM; see NewDmDialog.
    new-dm-motion := PopupMotion { open: root.new-dm-open; }
    if new-dm-motion.shown: NewDmDialog {
        motion: new-dm-motion.amount;
        new-dm-query <=> root.new-dm-query; matrix: root.matrix-build;
        new-dm-people: root.new-dm-people; new-dm-starting: root.new-dm-starting; new-dm-note: root.new-dm-note;
        new-dm-search => { root.new-dm-search(); }
        start-dm(index) => { root.start-dm(index); }
        close-new-dm => { root.close-new-dm(); }
    }
    // A message's reactions and who reacted; see ReactionsDialog.
    reactions-motion := PopupMotion { open: root.reactions-open; }
    if reactions-motion.shown: ReactionsDialog {
        motion: reactions-motion.amount;
        reaction-pills: root.reaction-pills; reactions-key: root.reactions-key;
        reactor-rows: root.reactor-rows; reactors-loading: root.reactors-loading;
        reactors-more: root.reactors-more; reactors-error: root.reactors-error;
        voters: root.reactions-voters; emoji-font: root.emoji-font;
        select-reaction(key) => { root.select-reaction(key); }
        more-reactors => { root.more-reactors(); }
        remove-reactor(id) => { root.remove-reactor(id); }
        close-reactions => { root.close-reactions(); }
    }
    // Forwarding a message; see ForwardDialog.
    forward-motion := PopupMotion { open: root.forward-open; }
    if forward-motion.shown: ForwardDialog {
        motion: forward-motion.amount;
        forward-preview: root.forward-preview; forward-targets: root.forward-targets;
        forward-query <=> root.forward-query; forward-note <=> root.forward-note;
        forward-chosen: root.forward-chosen; forward-limit: root.forward-limit;
        forward-empty: root.forward-empty; forward-slowmode: root.forward-slowmode;
        forward-error: root.forward-error;
        forward-search => { root.forward-search(); }
        forward-choose(id) => { root.forward-choose(id); }
        forward-send(note) => { root.forward-send(note); }
        close-forward => { root.close-forward(); }
    }
    // A masked link, before it opens; see LeavingDialog.
    leaving-motion := PopupMotion { open: root.leaving-link != ""; }
    if leaving-motion.shown: LeavingDialog {
        motion: leaving-motion.amount;
        link: root.leaving-link; site: root.leaving-site;
        visit => { root.visit-leaving-link(); }
        close => { root.close-leaving-link(); }
    }
    // The zoom level, for a moment after it changes.
    if root.zoom-note != "": Rectangle {
        x: (root.width - self.width) / 2; y: root.title-height + 12px;
        width: zoom-text.preferred-width + 28px; height: 36px;
        border-radius: 18px; background: Theme.tooltip;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        accessible-role: text; accessible-label: "Zoom " + root.zoom-note;
        zoom-text := Text { text: root.zoom-note; color: Theme.text; font-size: 15px; font-weight: 700; }
    }
    // Who reacted, over the reaction the pointer stays on: its emoji, then
    // the names, wrapping. Clicking it opens the Reactions window there.
    property <string> hovered-reaction: ReactionHover.item + " " + ReactionHover.key;
    changed hovered-reaction => { root.hover-reaction(ReactionHover.item, ReactionHover.key); }
    // It goes a moment after the pointer leaves both the chip and the tooltip.
    Timer {
        interval: 200ms;
        running: ReactionHover.key != "" && !ReactionHover.on-chip && !ReactionHover.on-tip;
        triggered => { ReactionHover.item = ""; ReactionHover.key = ""; ReactionHover.on-tip = false; }
    }
    reaction-measure := Text { visible: false; text: root.reaction-tip-text; font-size: 14px; font-weight: 500; }
    if ReactionHover.key != "" && root.reaction-tip-text != "": Rectangle {
        property <length> words-width: min(288px - 32px - 44px, reaction-measure.preferred-width);
        property <length> w: words-width + 32px + 44px;
        property <length> h: max(32px, reaction-words.preferred-height) + 32px;
        x: max(8px, min(root.width - self.w - 8px, ReactionHover.x - self.w / 2));
        y: max(4px, ReactionHover.y - self.h - 6px);
        width: self.w; height: self.h;
        border-radius: 6px; background: Theme.tooltip;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        accessible-role: button;
        accessible-label: root.reaction-tip-text;
        accessible-action-default => { root.view-reactions(ReactionHover.item, ReactionHover.key); }
        Text {
            x: 16px; y: (parent.height - 32px) / 2; width: 32px; height: 32px;
            text: Twemoji.text(root.reaction-tip-emoji); font-family: root.emoji-font; font-size: 26px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        reaction-words := Text {
            x: 60px; y: 16px; width: parent.words-width; height: parent.height - 32px;
            text: root.reaction-tip-text; color: Theme.text; font-size: 14px; font-weight: 500;
            wrap: word-wrap; vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            changed has-hover => { ReactionHover.on-tip = self.has-hover; }
            clicked => {
                root.view-reactions(ReactionHover.item, ReactionHover.key);
                ReactionHover.item = ""; ReactionHover.key = ""; ReactionHover.on-tip = false;
            }
        }
    }
    // Files dragged over the window, as Discord shows them: a card over the
    // dimmed window saying where they'll go. A drop it refuses says why
    // until Got It, a click, or the next drag.
    if root.dragging || root.drop-refusal != "": Rectangle {
        background: #000000a6;
        accessible-role: groupbox;
        accessible-label: root.dragging ? "Upload to " + root.drop-destination : root.drop-refusal;
        TouchArea { clicked => { root.drop-refusal = ""; } }
        // Over the part the files go to: the thread beside, or the rest.
        property <length> aside-part: root.workspace && root.aside-docked ? root.aside-shown : 0px;
        drop-card := Rectangle {
            x: root.drop-aside ? parent.width - parent.aside-part + (parent.aside-part - self.width) / 2 : (parent.width - parent.aside-part - self.width) / 2;
            y: (parent.height - self.height) / 2;
            animate x { duration: 120ms; easing: ease-out; }
            width: 310px; height: drop-lines.preferred-height + 16px;
            border-radius: 10px; background: root.drop-refusal != "" && !root.dragging ? Theme.danger : Theme.accent;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            Rectangle {
                x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                border-radius: 6px; border-width: 2px; border-color: Theme.on-accent.with-alpha(0.6);
            }
            drop-lines := VerticalLayout {
                x: 8px; y: 8px; width: parent.width - 16px;
                padding: 20px; padding-top: 24px; spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/file.svg"); width: 40px; height: 40px; colorize: Theme.on-accent; }
                }
                if root.dragging: HorizontalLayout {
                    alignment: center;
                    Text { text: "Upload to "; color: Theme.on-accent; font-size: 20px; font-weight: 400; }
                    Text { text: root.drop-destination; color: Theme.on-accent; font-size: 20px; font-weight: 700; overflow: elide; }
                }
                if root.dragging: Text {
                    text: "You can add comments before uploading.";
                    color: Theme.on-accent; font-size: 15px; horizontal-alignment: center; wrap: word-wrap;
                }
                if !root.dragging: Text {
                    text: root.drop-refusal; color: Theme.on-accent; font-size: 20px; font-weight: 700;
                    horizontal-alignment: center; wrap: word-wrap;
                }
                if !root.dragging: Text {
                    text: root.drop-refusal-help; color: Theme.on-accent; font-size: 15px;
                    horizontal-alignment: center; wrap: word-wrap;
                }
                if !root.dragging: HorizontalLayout {
                    alignment: center; padding-top: 8px;
                    ActionButton { text: "Got It"; clicked => { root.drop-refusal = ""; } }
                }
            }
        }
    }
    // Discord's quick switcher; see QuickSwitcher.
    switcher-motion := PopupMotion { open: root.switcher-open; }
    if switcher-motion.shown: QuickSwitcher {
        motion: switcher-motion.amount;
        switcher-places: root.switcher-places; switcher-query <=> root.switcher-query;
        switcher-search(query) => { root.switcher-search(query); }
        switch-to(id) => { root.switch-to(id); }
        close-switcher => { root.close-switcher(); }
    }
    // Over everything, as the request it confirms may come from anywhere.
    if root.bot-modal-open: BotModalDialog {
        heading: root.bot-modal-heading; fields: root.bot-modal-fields; supported: root.bot-modal-supported;
        saving: root.bot-modal-saving; error: root.bot-modal-error;
        field-edited(index, value) => { root.bot-modal-field-edited(index, value); }
        open-select(index) => { root.bot-modal-open-select(index); }
        submit => { root.bot-modal-submit(); }
        close => { root.bot-modal-close(); }
    }
    if root.bot-select-open: BotSelectDialog {
        heading: root.bot-select-heading; choices: root.bot-select-choices;
        query: root.bot-select-query;
        min-values: root.bot-select-min; max-values: root.bot-select-max;
        toggle(index) => { root.bot-select-toggle(index); }
        search(query) => { root.bot-select-search(query); }
        submit => { root.bot-select-submit(); }
        close => { root.bot-select-close(); }
    }
    mfa-motion := PopupMotion { open: root.mfa-open; }
    if mfa-motion.shown: MfaDialog {
        motion: mfa-motion.amount;
        prompt: root.mfa-prompt; code <=> root.mfa-code;
        choose(method) => { root.choose-mfa(method); }
        write(code) => { root.write-mfa(code); }
        resend => { root.resend-mfa(); }
        confirm => { root.confirm-mfa(); }
        cancel => { root.cancel-mfa(); }
    }
    // The title bar and the edges that resize the window, above all but the
    // tooltips, while Yapfast draws them.
    if root.title-height > 0 && !ClientStyle.enabled: TitleBar {
        x: 0px; y: 0px; width: root.width;
        place: root.workspace ? root.sidebar-title : "Yapfast";
        focused: root.window-focused; maximized: root.window-maximized;
        move-window => { root.move-window(); }
        minimize-window => { root.minimize-window(); }
        maximize-window => { root.maximize-window(); }
        close-window => { root.close-window(); }
    }
    if root.title-height > 0 && ClientStyle.enabled && root.workspace && root.inbox-open: TouchArea {
        x: 0px; y: root.title-height; width: root.width; height: root.height - root.title-height;
        clicked => { root.inbox-open = false; }
    }
    if root.title-height > 0 && ClientStyle.enabled && root.workspace && root.inbox-open: InboxPopout {
        x: root.width - self.width - 8px; y: root.title-height + 4px;
        height: min(560px, root.height - root.title-height - 16px);
        rows: root.inbox-rows;
        tab <=> root.inbox-tab;
        changed-tab => { root.inbox-opened(); }
        open(id) => {
            root.inbox-open = false;
            root.switch-to(id);
        }
        close => { root.inbox-open = false; }
    }
    if root.title-height > 0 && ClientStyle.enabled: WindowBar {
        x: 0px; y: 0px; width: root.width;
        place: root.workspace ? (root.dms-selected ? "Direct Messages" : root.sidebar-title) : "Yapfast";
        workspace: root.workspace;
        can-go-back: root.workspace && !root.settings-open && root.can-go-back;
        can-go-forward: root.workspace && !root.settings-open && root.can-go-forward;
        inbox-open: root.inbox-open;
        go-back => { root.go-back(); }
        go-forward => { root.go-forward(); }
        toggle-inbox => {
            root.inbox-open = !root.inbox-open;
            if root.inbox-open { root.inbox-opened(); }
        }
        open-help => { root.open-link("https://support.discord.com"); }
        focused: root.window-focused; maximized: root.window-maximized;
        move-window => { root.move-window(); }
        minimize-window => { root.minimize-window(); }
        maximize-window => { root.maximize-window(); }
        close-window => { root.close-window(); }
    }
    if root.title-height > 0 && !root.window-maximized: ResizeEdges {
        resize-window(direction) => { root.resize-window(direction); }
    }
    if Tip.text != "": tip-card := Rectangle {
        property <length> w: tip-text.preferred-width + 20px;
        property <length> h: 32px;
        x: Tip.side == 1 ? Tip.x + 10px : max(8px, min(root.width - self.w - 8px, Tip.x - self.w / 2));
        y: Tip.side == 1 ? Tip.y - self.h / 2 : Tip.side == 0 ? max(4px, Tip.y - self.h - 6px) : Tip.y + 6px;
        width: self.w; height: self.h;
        property <bool> shown: !Tip.pop;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        transform-scale: self.shown ? 1 : 0.95;
        transform-origin: { x: self.w / 2, y: self.h };
        animate transform-scale { duration: 120ms; easing: ease-out; }
        Timer {
            interval: 16ms;
            running: Tip.pop && !tip-card.shown;
            triggered => { tip-card.shown = true; }
        }
        border-radius: 6px; background: Theme.tooltip;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 14px; font-weight: 700; }
    }
    if BadgeTip.title != "": BadgeTipCard {
        x: max(8px, min(root.width - self.width - 8px, BadgeTip.x - self.width / 2));
        y: max(4px, BadgeTip.y - self.height - 10px);
    }
    if Autoscroll.shown: AutoscrollMarker {}
}
