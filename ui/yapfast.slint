    function open-share-menu(x: length, y: length) {
        root.menu-x = x; root.menu-y = y;
        root.pick-source = 0;
        root.pick-resolution = root.share-resolution;
        root.pick-fps = root.share-fps;
        root.pick-high-quality = root.share-high-quality;
        root.pick-switch = root.sharing;
        // Shown once the list is in, so it opens at its full height.
