    // line is 20px down the row, so it's out of view once the row is that far up.
    property <length> unread-y;
    out property <bool> unread-above: root.unread-index >= 0
        && (root.unread-index < root.top-index || (root.unread-index == root.top-index && root.unread-y < -20px));
    out property <bool> unread-below: root.unread-index >= 0 && root.bottom-index >= 0 && root.unread-index > root.bottom-index;
    // Earlier messages load as the timeline nears its top, a page at a time,
    // until the first message. After a failure they wait for Retry.
    property <bool> wants-earlier: root.room-ready && !root.preview && !root.busy && !root.voice-panel
        && root.messages.length > 0 && !root.loading-history && !root.history-start && !root.history-failed
        && (root.jump-item == "" || root.jump-placed) && -timeline.content-y < timeline.height;
    // Only once that holds for a moment, and not while a jump's row is still
