        remake(age, uses) => { root.make-invite(age, uses); }
        close => { root.close-invite(); }
    }
    join-motion := PopupMotion { open: root.join-open; }
    if join-motion.shown: JoinDialog {
        motion: join-motion.amount;
        prompt: root.join-prompt; link <=> root.join-link;
        find(link) => { root.find-invite(link); }
