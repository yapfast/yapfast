    public function show-message(index: int, item: string, lit: bool) {
        root.follow-latest = false;
        root.jump-item = item;
        root.jump-lit = lit;
        root.jump-placed = false;
        root.estimate-jump(index);
        root.jump-tick += 1;
    }
    /// Places the jump's row again, at `index` now. Until the row is built and places
    /// itself, the estimate is made again: the list may not have measured anything
    /// yet when the jump starts, and history loaded above moves the row on.
    public function settle-jump(index: int) {
        if !root.jump-placed && index >= 0 { root.estimate-jump(index); }
        root.jump-tick += 1;
    }
    property <bool> jump-placed;
    function estimate-jump(index: int) {
        timeline.content-y = max(min(0px, timeline.height - timeline.content-height),
            min(0px, (root.jump-lit ? timeline.height / 3 : 0px) - timeline.content-height * index / max(1, root.messages.length)));
    }
    public function scroll-to-latest() {
        root.follow-latest = true;
        timeline.content-y = min(0px, timeline.height - timeline.content-height);
    }
    // While the newest message is in view, keep it there as rows grow, for example
