        property <length> top: root.anchor-y + context-menu-content.main-height <= root.height - 8px
            ? root.anchor-y : max(8px, root.anchor-y - context-menu-content.main-height);
        width: context-menu-content.content-width; height: context-menu-content.content-height;
        x: max(8px, min(root.width - context-menu-content.menu-width - 8px, root.anchor-x))
            - (context-menu-content.flip ? context-menu-content.content-width - context-menu-content.menu-width : 0px);
        y: self.top - context-menu-content.lift;
        close-policy: PopupClosePolicy.close-on-click-outside;
        context-menu-content := ContextMenu {
            rows: root.menu-rows; submenus: root.menu-submenus;
            room: root.width - 8px - root.anchor-x; tallest: root.height - 16px;
            room-below: root.height - 8px - context-menu.top;
            chose(id) => {
                if root.menu-person { root.profile-at-pointer = true; }
                root.choose-menu(root.menu-target, root.menu-person, id);
                context-menu.close();
            }
            toggled(id) => { root.choose-menu(root.menu-target, root.menu-person, id); }
            close => { context-menu.close(); }
        }
    }
    // The status menu opens above the account panel, along its left edge.
    property <bool> account-status-expanded;
    function open-status-menu() {
        root.account-status-expanded = false;
        root.menu-x = account-panel.absolute-position.x + (ClientStyle.enabled ? 0px : 8px);
        root.menu-y = account-panel.absolute-position.y;
        root.game-duration-due();
        status-menu.show();
    }
    // The composer's +, where threads can start: upload a file or start one.
    plus-menu := PopupWindow {
        width: 224px; height: plus-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.menu-x));
        y: max(8px, root.menu-y - self.height - 8px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            plus-content := VerticalLayout {
                padding: 6px; spacing: 2px;
                MenuItem {
                    text: "Upload a File"; icon: @image-url("icons/file.svg"); disabled: !root.can-attach;
                    clicked => { if root.can-attach { plus-menu.close(); root.attach(); } }
                }
                // Closing the menu takes these away, so they act first.
                if root.can-start-threads: MenuItem {
                    text: "Create Thread"; icon: @image-url("icons/thread.svg");
                    clicked => { root.new-thread("", "plus"); plus-menu.close(); }
                }
                if root.can-create-polls: MenuItem {
                    text: "Create Poll"; icon: @image-url("icons/chart-bar.svg");
                    clicked => { root.open-poll(); plus-menu.close(); }
                }
            }
        }
    }
    status-menu := PopupWindow {
        width: ClientStyle.enabled ? 300px : 248px; height: status-menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.menu-x));
        y: max(8px, root.menu-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        status-menu-content := VerticalLayout {
            if ClientStyle.enabled: AccountPopover {
                available-height: max(120px, root.menu-y - 12px);
                name: root.account-name; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture;
                user-id: root.account-user-id; profile: root.account-profile;
                opened => { root.account-opened(); }
                open-link(link) => { root.open-link(link); status-menu.close(); }
                status: root.discord-status; has-custom-status: root.has-custom-status;
                custom-text: root.account-status; custom-emoji: root.account-status-emoji;
                game-name: root.game-activity-name; game-duration: root.game-activity-duration;
                expanded <=> root.account-status-expanded;
                game-duration-due => { root.game-duration-due(); }
                choose(status) => { root.set-status(status); status-menu.close(); }
                custom-status => { root.open-status(); status-menu.close(); }
                edit-profile => { root.edit-profile(); status-menu.close(); }
                copy-id => { root.copy-text(root.account-user-id); status-menu.close(); }
                settings => { root.settings-section = 0; root.settings-open = true; status-menu.close(); }
            }
            if !ClientStyle.enabled: StatusMenu {
                status: root.discord-status; has-custom-status: root.has-custom-status;
                game-name: root.game-activity-name; game-duration: root.game-activity-duration;
                game-duration-due => { root.game-duration-due(); }
                choose(status) => { root.set-status(status); status-menu.close(); }
                custom-status => { root.open-status(); status-menu.close(); }
                edit-profile => { root.edit-profile(); status-menu.close(); }
            }
        }
    }

    function open-menu(message: MessageRow) {
        root.open-message-menu(message, -1, false);
    }
    // A message's menu, with what can be done with its picture or video at
    // this index of its attachments, or with a link in its text, from a right
    // click on it.
    property <int> menu-media: -1;
    property <bool> menu-video;
    property <string> menu-link;
    // Read as the menu opens: the press on its item clears the selection.
    property <string> menu-selection;
    function open-message-menu(message: MessageRow, media: int, video: bool) {
        root.menu-message = message;
        root.menu-selection = root.selection-at(root.anchor-x, root.anchor-y);
        root.menu-aside = false;
        root.aside-composer-last = false;
        root.menu-media = media;
        root.menu-video = video;
        root.menu-link = media >= 0 ? root.attachment-link(message.item, media) : root.link-at(root.anchor-x, root.anchor-y);
        message-menu.show();
    }
    property <bool> picker-open: emoji-picker.is-open;
    // A picker that opens as another closes shares the grid, so it goes with the last.
    changed picker-open => {
        if !root.picker-open {
            if !root.expressions-open { root.emoji-picker-closed(); }
            if root.react-item == "yapfast:composer" { root.focus-composer(); }
            root.react-item = "";
        }
    }
    property <EmojiCell> emoji-hover;
    // The status dialog borrows the picker for its emoji.
    function pick(cell: EmojiCell) {
        if root.react-item == "yapfast:status" {
            root.status-emoji = cell;
        } else if root.react-item == "yapfast:poll" {
            root.poll-answer-emoji(root.poll-emoji-answer, cell.key);
        } else if root.react-item == "yapfast:composer" {
            root.insert-emoji(cell.key);
        } else {
            root.react(root.react-item, cell.key);
        }
        emoji-picker.close();
        expressions.close();
    }
    // The picker above the composer: the GIFs, the emoji and the stickers.
    // Each lets go of its pictures when it closes or another shows.
    property <int> expression-tab;
    function open-expressions(tab: int) {
        root.react-item = "yapfast:composer";
        root.emoji-query = "";
        root.emoji-hover = { glyph: "", name: "" };
        root.expression-tab = tab;
        root.emoji-panel-width = root.picker-shown;
        root.emoji-search("");
        if tab == 0 { root.open-gifs(); }
        if tab == 2 { root.open-stickers(); }
        expressions.show();
    }
    function show-expression-tab(tab: int) {
        if tab == root.expression-tab { return; }
        root.expression-tab = tab;
        // Every grid's columns follow the width the picker was dragged to
        // while another tab showed.
        if tab == 0 { root.open-gifs(); } else { root.close-gifs(); }
        if tab == 1 {
            root.emoji-panel-width = root.picker-shown;
            root.emoji-reflow();
        }
        if tab == 2 { root.open-stickers(); } else { root.close-stickers(); }
    }
    property <bool> expressions-open: expressions.is-open;
    changed expressions-open => {
        if !root.expressions-open {
            root.close-gifs();
            if !root.picker-open { root.emoji-picker-closed(); }
            root.close-stickers();
            root.focus-composer();
            root.react-item = "";
        }
    }
    // The popup spans all the room the picker could take, so that dragging its
    // left edge never moves or resizes the popup itself: Slint moves a popup a
    // moment after its width changes, and in between it draws the picker the
    // wider width from the place it had, which walked it right. The panel
    // inside it is what shows, its right edge against the popup's.
    expressions := PopupWindow {
        width: root.picker-room; height: 486px;
        x: max(8px, min(root.width - self.width - 8px, emoji-button.absolute-position.x + emoji-button.width - self.width));
        y: max(8px, emoji-button.absolute-position.y - self.height - 8px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        // A click beside the picker, in the room it could have taken, closes
        // it as one outside the popup does. It covers only that room: under
        // the panel it would take the clicks that fall through the panel's
        // own empty places.
        TouchArea {
            width: parent.width - panel.width; x: 0px;
            clicked => { expressions.close(); }
        }
        // The GIFs and the emoji share the window, so both show at the width
        // its left edge was dragged to, and each grid fits its columns to that.
        panel := Rectangle {
            width: root.picker-shown;
            x: parent.width - self.width;
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            clip: true;
            accessible-role: groupbox; accessible-label: "Expression Picker";
            VerticalLayout {
                padding-top: 16px; spacing: 12px;
                HorizontalLayout {
                    padding-left: 16px; spacing: 8px; alignment: start;
                    PickerTab { text: "GIFs"; selected: root.expression-tab == 0; clicked => { root.show-expression-tab(0); } }
                    PickerTab { text: "Emoji"; selected: root.expression-tab == 1; clicked => { root.show-expression-tab(1); } }
                    PickerTab { text: "Stickers"; selected: root.expression-tab == 2; clicked => { root.show-expression-tab(2); } }
                }
                if root.expression-tab == 0: GifPicker {
                    view: root.gif-view; query <=> root.gif-query; tiles: root.gif-tiles;
                    grid-height: root.gif-grid-height; note: root.gif-note; suggestions: root.gif-suggestions;
                    has-favorites: root.gif-has-favorites;
                    search(text) => { root.gif-search(text); }
                    show-view(view) => { root.gif-view-chosen(view); }
                    category(name) => { root.gif-category(name); }
                    pick(url, insert) => { root.gif-pick(url, insert); expressions.close(); }
                    favorite(url) => { root.gif-favorite(url); }
                    scrolled-to(top, height) => { root.gifs-scrolled(top, height); }
                    resized => { root.gif-picker-resized(); }
                    close => { expressions.close(); }
                }
                if root.expression-tab == 2: StickerPicker {
                    bare: true;
                    tiles: root.sticker-tiles; sections: root.sticker-sections; font: root.emoji-font;
                    grid-height: root.sticker-grid-height; note: root.sticker-note;
                    query <=> root.sticker-query; first-id: root.sticker-first-id;
                    search(text) => { root.sticker-search(text); }
                    pick(id) => { root.sticker-pick(id); expressions.close(); }
                    favorite(id) => { root.sticker-favorite(id); }
                    unlock-nitro => { root.unlock-nitro(); }
                    scrolled-to(top, height) => { root.stickers-scrolled(top, height); }
                    close => { expressions.close(); }
                }
                if root.expression-tab == 1: EmojiPicker {
                    bare: true;
                    emoji-rows: root.emoji-rows; emoji-sections: root.emoji-sections; rail-sections: root.emoji-rail-sections;
                    emoji-tiles: root.emoji-tiles; emoji-headings: root.emoji-headings; grid-height: root.emoji-grid-height;
                    emoji-query <=> root.emoji-query; emoji-hover <=> root.emoji-hover;
                    emoji-font: root.emoji-font; react-item: root.react-item; columns: root.emoji-columns;
                    emoji-search(text) => { root.emoji-search(text); }
                    favorite(key) => { root.emoji-favorite(key); }
                    pick(cell) => { root.pick(cell); }
                    unlock-nitro => { root.unlock-nitro(); }
                    close-picker => { expressions.close(); }
                    scrolled-to(top, height) => { root.emoji-scrolled-to(top, height); }
                }
            }
            // The picker's left edge drags it wider, as Discord's: the right
            // edge and the height stay, and it stops just past the server
            // list. Both tabs drag it, as they share the width. Letting go
            // keeps the width for the next start, if the drag changed it.
            edge := TouchArea {
                // The width the drag started from.
                property <length> from;
                x: 0px; y: 0px; width: 8px; height: parent.height;
                mouse-cursor: ew-resize;
                moved => {
                    if self.pressed {
                        root.picker-width = root.drag-width(self.mouse-x, self.pressed-x);
                    }
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        self.from = root.picker-shown;
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                        && root.picker-shown != self.from {
                        root.picker-width-chosen(root.picker-shown);
                    }
                }
                Rectangle {
                    x: 3px; width: 2px; height: parent.height;
                    background: edge.pressed ? Theme.faint : Theme.line;
                    opacity: edge.has-hover || edge.pressed ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }
            }
        }
    }
    emoji-picker := PopupWindow {
        width: root.emoji-popup-width; height: 432px;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        EmojiPicker {
            emoji-rows: root.emoji-rows; emoji-sections: root.emoji-sections; rail-sections: root.emoji-rail-sections;
            emoji-query <=> root.emoji-query; emoji-hover <=> root.emoji-hover;
            emoji-tiles: root.emoji-tiles; emoji-headings: root.emoji-headings; grid-height: root.emoji-grid-height;
            emoji-font: root.emoji-font; react-item: root.react-item; columns: root.emoji-columns;
            emoji-search(text) => { root.emoji-search(text); }
            favorite(key) => { root.emoji-favorite(key); }
            pick(cell) => { root.pick(cell); }
            unlock-nitro => { root.unlock-nitro(); }
            close-picker => { emoji-picker.close(); }
            scrolled-to(top, height) => { root.emoji-scrolled-to(top, height); }
        }
    }
    // A message's actions, from its hover bar's "More" button or a right click.
    property <bool> menu-can-react: root.menu-message.can-react
        && (root.menu-aside ? root.aside-new-reactions-enabled : root.new-reactions-enabled);
    call-link-menu := PopupWindow {
        width: 320px; height: call-link-content.content-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        call-link-content := CallLinkCard { copy(text) => { root.copy-text(text); } }
    }
    // The volumes sit above the menu, as wide as it. It opens below the
    // pointer, or above it if it doesn't fit; submenus open beside it, as
    // in the context menu.
    voice-menu := PopupWindow {
        property <length> head: root.voice-menu-volume ? volume-content.content-height + (root.voice-menu-rows ? 4px : 0px) : 0px;
        property <length> main: root.voice-menu-rows ? voice-menu-content.main-height : 0px;
        property <length> menu-width: root.voice-menu-rows ? voice-menu-content.menu-width : 260px;
        property <bool> flip: root.voice-menu-rows && voice-menu-content.flip;
        property <length> lift: root.voice-menu-rows ? voice-menu-content.lift : 0px;
        property <length> top: root.anchor-y + self.head + self.main <= root.height - 8px
            ? root.anchor-y : max(8px, root.anchor-y - self.head - self.main);
        width: root.voice-menu-rows ? voice-menu-content.content-width : self.menu-width;
        height: self.head + (root.voice-menu-rows ? voice-menu-content.content-height : 0px);
        x: max(8px, min(root.width - self.menu-width - 8px, root.anchor-x))
            - (self.flip ? voice-menu-content.content-width - self.menu-width : 0px);
        y: self.top - self.lift;
        close-policy: PopupClosePolicy.close-on-click-outside;
        volume-content := VolumeMenu {
            visible: root.voice-menu-volume;
            x: voice-menu.flip ? voice-menu-content.content-width - voice-menu.menu-width : 0px;
            y: voice-menu.lift;
            width: voice-menu.menu-width; height: self.content-height;
            volume-person: root.volume-person; volume-name: root.volume-name; volume-live: root.volume-live;
            voice-volume <=> root.voice-volume; stream-volume <=> root.stream-volume;
            volume-changed(person, stream, volume, last) => { root.volume-changed(person, stream, volume, last); }
        }
        voice-menu-content := ContextMenu {
            visible: root.voice-menu-rows;
            x: 0px; y: voice-menu.head;
            narrowest: 260px;
            rows: root.menu-rows; submenus: root.menu-submenus;
            room: root.width - 8px - root.anchor-x; tallest: root.height - 16px - voice-menu.head;
            room-below: root.height - 8px - voice-menu.top - voice-menu.head;
            chose(id) => {
                root.profile-at-pointer = true;
                root.choose-menu(root.menu-target, root.menu-person, id);
                voice-menu.close();
            }
            toggled(id) => { root.choose-menu(root.menu-target, root.menu-person, id); }
            close => { voice-menu.close(); }
        }
    }
    // From a button, the menu opens left of it, level with its top, or right of
    // it when there isn't room.
    message-menu := PopupWindow {
        width: 224px; height: menu-content.content-height;
        x: root.anchor-pointer ? max(8px, min(root.width - self.width - 8px, root.anchor-x))
            : root.anchor-x - self.width - 8px >= 8px ? root.anchor-x - self.width - 8px
            : max(8px, min(root.width - self.width - 8px, root.anchor-x + root.anchor-width + 8px));
        y: !root.anchor-pointer ? max(8px, min(root.height - self.height - 8px, root.anchor-y))
            : root.anchor-y + 4px + self.height <= root.height - 8px ? root.anchor-y : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        menu-content := MessageMenu {
            menu-message: root.menu-message; selection: root.menu-selection; menu-can-react: root.menu-can-react; menu-reactions: root.menu-reactions;
            can-start-thread: root.can-start-threads && !root.menu-aside;
            start-thread(item) => { root.new-thread(item, "message"); message-menu.close(); }
            view-thread(room) => { root.open-aside(room); message-menu.close(); }
            view-reactions(item) => { root.view-reactions(item, ""); message-menu.close(); }
            emoji-font: root.emoji-font; composer-enabled: root.composer-enabled; forward-allowed: root.forward-allowed; preview: root.preview;
            react(item, key) => { root.react(item, key); message-menu.close(); }
            open-picker(item) => { root.open-picker(item); message-menu.close(); }
            edit(item) => { root.edit(item); root.focus-composer-of-menu(); message-menu.close(); }
            reply(item) => { root.reply(item); root.focus-composer-of-menu(); message-menu.close(); }
            start-forward(item) => { root.start-forward(item); message-menu.close(); }
            copy-text(text) => { root.copy-text(text); message-menu.close(); }
            pin-message(item) => { root.pin-message(item); message-menu.close(); }
            // Shift and a click deletes at once, as Discord's menu does; a
            // plain click asks first.
            request-delete(item) => {
                if root.shift-held { root.delete-now(item); } else { root.request-delete(item); }
                message-menu.close();
            }
            end-poll(item) => { Polls.ask-end(item); message-menu.close(); }
            media-index: root.menu-media; media-video: root.menu-video; link: root.menu-link;
            copy-image(item, index) => { root.copy-attachment(item, index); message-menu.close(); }
            save-attachment(item, index) => { root.save-attachment(item, index); message-menu.close(); }
            open-link(link) => { root.open-link(link); message-menu.close(); }
        }
    }

    // Sign in; see SignInScreen.
    SignInScreen {
        y: root.title-height; height: root.height - root.title-height;
        visible: !root.workspace;
        busy: root.busy; notice: root.notice; restore-available: root.restore-available; matrix-build: root.matrix-build;
        link-phase: root.link-phase; link-code: root.link-code; link-name: root.link-name; link-note: root.link-note;
        sign-in-focus: root.sign-in-focus;
        graphics-notice <=> root.graphics-notice;
        homeserver <=> root.homeserver; username <=> root.username; password <=> root.password;
        login => { root.login(); }
        restore => { root.restore(); }
        explore-preview => { root.explore-preview(); }
        link-discord => { root.link-discord(); }
        link-discord-token(token) => { root.link-discord-token(token); }
        open-discord-captcha => { root.open-discord-captcha(); }
    }

    HorizontalLayout {
        y: root.title-height; height: root.height - root.title-height;
        visible: root.workspace;
        spacing: 0px;
        // Navigation: the rail and the sidebar, with the voice and account dock across both.
        Rectangle {
            width: 72px + root.sidebar-shown; background: Theme.rail;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    // Server rail.
                    ServerRail {
                        dms-selected: root.dms-selected; dms-unread: root.dms-unread; dms-badge: root.dms-badge; servers: root.servers;
                        matrix-build: root.matrix-build;
                        navigate-dms => { root.navigate-dms(); }
                        navigate-server(id) => { root.navigate-server(id); }
                        toggle-folder(id) => { root.toggle-folder(id); }
                        open-dm(id) => { root.open-conversation(id); }
                        open-server-menu(id, x, y) => { root.open-context-menu(id, false, x, y); }
                        can-join: root.can-join-server;
                        join-server => { root.open-join-server(); }
                    }
                    // Channel sidebar: a lighter sheet held by the rail and the dock.
                    Rectangle {
                        width: root.sidebar-shown; background: Theme.sidebar;
                        border-top-left-radius: ClientStyle.enabled ? 12px : 10px; border-bottom-left-radius: ClientStyle.enabled ? 0px : 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            header-box := Rectangle {
                                property <bool> banner: ClientStyle.enabled && root.header-server != "" && root.header-banner != "";
                                height: ClientStyle.header-height + (header-box.banner ? 81px : 0px);
                                if header-box.banner: Image {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    source: PictureStore.picture(root.header-banner, PictureStore.revision(root.header-banner));
                                    image-fit: cover; accessible-role: none;
                                    init => { PictureStore.request(root.header-banner); }
                                }
                                if header-box.banner: Rectangle {
                                    x: 0px; y: 0px; width: parent.width; height: ClientStyle.header-height;
                                    background: @linear-gradient(180deg, #00000099 0%, #00000000 100%);
                                }
                                if root.header-server == "" && !(ClientStyle.enabled && root.dms-selected): Text { x: 16px; width: parent.width - (root.dms-selected && !root.preview ? (root.discord-linked ? 88px : 56px) : 32px); text: root.sidebar-title; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                if root.header-server != "": server-header := ServerHeader {
                                    x: 8px; y: 8px; width: parent.width - 16px - (root.header-invite ? 40px : 0px); height: 32px;
                                    name: root.sidebar-title; open: root.header-menu-open; community: root.header-community;
                                    verified: root.header-verified; on-banner: header-box.banner;
                                    clicked => { root.open-header-menu(self.absolute-position.x, self.absolute-position.y + self.height + 6px); }
                                }
                                if root.header-server != "" && root.header-invite: IconButton {
                                    x: parent.width - self.width - 8px; y: 8px;
                                    icon: @image-url("icons/user-plus.svg"); label: "Invite people"; size: 32px; glyph: 20px; tip-side: 2;
                                    clicked => { root.open-invite(root.header-server); }
                                }
                                if !ClientStyle.enabled && root.dms-selected && !root.preview && root.discord-linked: IconButton {
                                    x: parent.width - 2 * self.width - 14px;
                                    icon: @image-url("icons/user-plus.svg"); label: "Add a friend"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-add-friend(); }
                                }
                                if !ClientStyle.enabled && root.dms-selected && !root.preview: IconButton {
                                    x: parent.width - self.width - 10px;
                                    icon: @image-url("icons/square-pen.svg"); label: "New message"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-new-dm(); }
                                }
                                if ClientStyle.enabled && root.dms-selected: TextField {
                                    x: 8px; y: 8px; width: parent.width - 16px; height: 32px;
                                    text-size: 13px; pad: 10px; fill: Theme.field; ring: false;
                                    placeholder: "Find a conversation"; text <=> root.filter; label: "Find a conversation";
                                    edited => { root.filter-edited(); }
                                }
                                if !header-box.banner: Rectangle { y: parent.height - 1px; height: 1px; background: ClientStyle.enabled ? Theme.outline : Theme.edge; }
                            }
                            // Discord's boost goal bar under the server's name: a pill 26px
                            // tall, its fill the share of the goal the boosts reach.
                            if ClientStyle.enabled && root.header-server != "" && root.header-boosts >= 0: boost-bar := Rectangle {
                                height: 39px;
                                property <float> share: min(1.0, root.header-boosts / 33.0);
                                pill := Rectangle {
                                    x: 12px; y: 4px; width: parent.width - 16px; height: 26px;
                                    background: Theme.hover;
                                    border-radius: 13px;
                                    if boost-bar.share > 0: Rectangle {
                                        x: 2px; y: 2px; height: parent.height - 4px;
                                        width: (parent.width - 4px) * boost-bar.share;
                                        border-radius: 11px;
                                        background: @linear-gradient(270deg, #ff73fa66, #ff73fa1a);
                                    }
                                    Text {
                                        x: 8px; width: parent.width - 40px; height: parent.height;
                                        text: "Boost Goal"; font-size: 14px; font-weight: 600; color: Theme.text;
                                        vertical-alignment: center; overflow: elide;
                                    }
                                    Text {
                                        x: parent.width - self.width - 26px; width: self.preferred-width; height: parent.height;
                                        text: root.header-boosts + "/33 Boosts"; font-size: 14px; font-weight: 500;
                                        color: Theme.text.transparentize(0.3);
                                        vertical-alignment: center;
                                    }
                                    Image {
                                        x: parent.width - 8px - self.width; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
                                        source: @image-url("icons/chevron-right.svg"); colorize: Theme.muted; accessible-role: none;
                                    }
                                }
                                Rectangle { x: 8px; y: parent.height - 1px; width: parent.width - 8px; height: 1px; background: Theme.outline; }
                                accessible-role: text;
                                accessible-label: "Boost Goal, " + root.header-boosts + " of 33 boosts";
                            }
                            // Discord's "N Events" row under the server's name.
                            if ClientStyle.enabled && root.header-server != "" && root.header-events-row: events-row := Rectangle {
                                height: 60px;
                                Image { x: 16px; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("icons/calendar.svg"); colorize: Theme.muted; accessible-role: none; }
                                Text {
                                    x: 44px; width: parent.width - 60px; height: parent.height;
                                    text: root.header-events == 0 ? "Events" : root.header-events == 1 ? "1 Event" : root.header-events + " Events";
                                    font-size: 14px; font-weight: 500; color: Theme.muted;
                                    vertical-alignment: center; overflow: elide;
                                }
                                Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 32px; height: 1px; background: Theme.outline; }
                                events-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.open-events-menu(parent.absolute-position.x + 8px, parent.absolute-position.y + parent.height - 8px); }
                                }
                                if events-touch.has-hover: Rectangle { background: Theme.hover; border-radius: 6px; x: 8px; width: parent.width - 16px; y: 8px; height: parent.height - 16px; z: -1; }
                                accessible-role: button;
                                accessible-label: root.header-events + " events";
                                accessible-action-default => { root.open-events-menu(self.absolute-position.x + 8px, self.absolute-position.y + self.height - 8px); }
                            }
                            // Discord's channel list starts at its first category: Ctrl+K finds channels.
                            if !ClientStyle.enabled: HorizontalLayout {
                                padding: 10px; padding-bottom: 6px;
                                TextField {
                                    min-height: 30px; text-size: 14px; pad: 8px; fill: Theme.sunken; ring: false;
                                    placeholder: root.filter-placeholder; text <=> root.filter; label: root.filter-placeholder;
                                    edited => { root.filter-edited(); }
                                }
                            }
                            RoomList {
                                open-add-friend => { root.open-add-friend(); }
                                open-new-dm => { root.open-new-dm(); }
                                rooms: root.rooms; dms-selected: root.dms-selected; discord-linked: root.discord-linked; preview: root.preview;
                                friends-open: root.friends-open; requests-current: root.requests-current; requests-badge: root.requests-badge;
                                browse-offered: root.browse-offered && !ClientStyle.enabled; browsing: root.browse-open;
                                open-browse => { root.open-browse(); }
                                voice-channel: root.voice-channel; participants: root.participants; sidebar-empty: root.sidebar-empty;
                                select-room(id) => { root.select-room(id); }
                                open-voice(id) => { root.open-conversation(id); }
                                wave(user) => { root.message-from-profile(user, "\u{1F44B}"); }
                                open-chat(id) => { root.open-chat(id); }
                                open-friends => { root.open-friends(); }
                                open-requests => { root.open-requests(); }
                                open-room-menu(id, x, y) => { root.open-context-menu(id, false, x, y); }
                                open-voice-menu(room, person, x, y) => { root.open-voice-menu(room, person, x, y); }
                                show-voice-person(room, id) => { root.show-voice-person(room, id); }
                                open-voice-profile(person, x, y, width, height) => {
                                    if person.person != "" {
                                        root.anchor(x, y, width, height, false);
                                        root.profile-at-pointer = true;
                                        root.show-profile(person.person);
                                    }
                                }
                                arranging: root.room-arranging; droppable: root.room-droppable;
                                start-arranging(place) => { return root.start-arranging(place); }
                                arrange(place) => { root.arrange-room(place); }
                                stop-arranging => { root.stop-arranging(); }
                                moving: root.person-moving; move-droppable: root.person-droppable;
                                start-moving(room, user) => { return root.start-moving-person(room, user); }
                                move-person(room) => { root.move-person(room); }
                                stop-moving => { root.stop-moving-person(); }
                                toggle-category(category) => { root.toggle-category(category); }
                                may-create(id) => { return root.may-create-channel(root.category-of(id)); }
                                create-channel(id) => {
                                    if root.category-of(id) != "" { root.choose-menu(root.category-of(id), false, "create-channel"); }
                                }
                                open-category-menu(id, x, y) => {
                                    if root.category-of(id) != "" { root.open-context-menu(root.category-of(id), false, x, y); }
                                }
                            }
                        }
                        // Discord's outline: the top and left edges meet in a 12px rounded corner,
                        // and the left line runs down to the account panel. There is no line
                        // between the sidebar and the conversation: only their grounds differ.
                        if ClientStyle.enabled: Rectangle {
                            x: 0px; y: 0px; width: parent.width + 16px; height: parent.height + 16px;
                            border-width: 1px; border-color: Theme.outline; border-radius: 12px; background: transparent;
                        }
                    }
                }
                // The dock spans the rail and the sidebar. Its avatar and voice icon sit on the
                // rail's axis, 36px from the left; names and status start at 64px.
                if root.voice-visible: VoiceDock {
                    voice-status: root.voice-status; voice-time: root.voice-time; voice-detail: root.voice-detail; voice-name: root.voice-name;
                    voice-color: root.voice-color;
                    voice-active: root.voice-active; voice-ready: root.voice-ready; voice-leaving: root.voice-leaving;
                    voice-warning: root.voice-warning; voice-error: root.voice-error;
                    can-share: root.can-share; sharing: root.sharing; share-live: root.share-live; share-status: root.share-status;
                    share-watchers: root.share-viewers.length;
                    can-film: root.can-film; camera-on: root.camera-on; camera-starting: root.camera-starting;
                    can-soundboard: root.can-soundboard;
                    noise-on: root.noise-suppression != 2; can-noise: root.voice-discord;
                    toggle-noise => { root.toggle-noise(); }
                    leave-voice => { root.leave-voice(); }
                    dismiss-voice-error => { root.dismiss-voice-error(); }
                    toggle-camera => { root.toggle-camera(); }
                    toggle-share => { root.toggle-share(); }
                    open-share-menu(x, y) => { root.open-share-menu(x, y); }
                    open-soundboard(x, y) => { root.open-soundboard(x, y); }
                    open-call-link(x, y, width, height) => { root.open-call-link(x, y, width, height); }
                    open-call => { root.open-call(); }
                }
                // Inset the account card while preserving the inherited controls.
                VerticalLayout {
                    padding: ClientStyle.account-inset; padding-top: 0px;
                    account-panel := Rectangle {
                        // Anywhere on the card brightens its nameplate; each part lights only itself.
                        property <bool> hot: account-touch.has-hover || avatar-touch.has-hover || mic.hovered || ear.hovered || cog.hovered;
                        height: ClientStyle.account-height; background: Theme.panel;
                        border-radius: ClientStyle.enabled ? 8px : 0px;
                        // The nameplate fills the card, a pixel beyond it above and below.
                        if AccountLook.nameplate-url != "": Nameplate {
                            x: 0px; y: -1px; width: parent.width + 1px; height: parent.height + 2px;
                            radius: ClientStyle.enabled ? 8px : 0px; account: true; hovered: account-panel.hot; animate: account-panel.hot; picture-url: AccountLook.nameplate-url; palette: Theme.dark ? AccountLook.nameplate-color : AccountLook.nameplate-light;
                        }
                        if root.voice-visible: Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            // Discord's controls sit 3px further apart and 6px further from the edge.
                            padding-right: ClientStyle.enabled ? 14px : 8px; spacing: ClientStyle.enabled ? 5px : 2px;
                            Rectangle {
                                width: ClientStyle.enabled ? 50px : 58px;
                                Avatar { x: ClientStyle.enabled ? 8px : 19px; y: (parent.height - self.height) / 2; size: ClientStyle.enabled ? 40px : 34px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; speaking: root.account-speaking; decoration-url: AccountLook.decoration-url; animate: account-panel.hot; }
                                if root.account-presence != "": StatusDot {
                                    x: ClientStyle.enabled ? 34px : 40px; y: parent.height / 2 + 3px; presence: root.account-presence; ring: Theme.panel;
                                }
                                if root.account-presence == "": Rectangle {
                                    x: ClientStyle.enabled ? 35px : 41px; y: parent.height / 2 + 4px; width: 14px; height: 14px; border-radius: 7px; background: Theme.panel;
                                    Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px;
                                        background: root.preview ? Theme.accent : root.online ? Theme.live : Theme.faint;
                                    }
                                }
                                avatar-touch := TouchArea {
                                    enabled: root.discord-linked; mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.open-status-menu(); }
                                }
                            }
                            // With Discord linked, the avatar and name open the status menu.
                            Rectangle {
                                horizontal-stretch: 1; y: 6px; height: parent.height - 12px; border-radius: 6px;
                                // Discord's light, see-through fill, so the nameplate shows through.
                                background: account-touch.has-hover || avatar-touch.has-hover ? Theme.overlay.with-alpha(account-touch.pressed || avatar-touch.pressed ? 0.12 : 0.08) : transparent;
                                animate background { duration: Theme.quick; }
                                accessible-role: button;
                                accessible-enabled: root.discord-linked;
                                accessible-label: root.account-name + ", " + root.account-status + (root.discord-linked ? ". Set your status" : "");
                                accessible-action-default => { if root.discord-linked { root.open-status-menu(); } }
                                VerticalLayout {
                                    alignment: center; padding-left: 6px; padding-right: 6px;
                                    Text { text: root.account-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                    // Under the pointer the status gives way to the username, as Discord's does.
                                    if (account-touch.has-hover || avatar-touch.has-hover) && root.account-username != "": Text {
                                        text: root.account-username; color: Theme.muted; font-size: 13px; overflow: elide;
                                    }
                                    if !((account-touch.has-hover || avatar-touch.has-hover) && root.account-username != ""): StatusText { text: root.account-status; emoji-url: root.account-status-emoji; icon: root.account-activity-icon; bullet: root.account-activity-bullet; }
                                }
                                account-touch := TouchArea {
                                    enabled: root.discord-linked; mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.open-status-menu(); }
                                }
                            }
                            mic := DeviceToggle {
                                icon: root.shown-muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                                label: root.voice-active ? (root.muted ? "Unmute" : "Mute") : root.shown-muted ? "Join calls unmuted" : "Join calls muted";
                                alert: root.shown-muted;
                                // Discord's glyphs are white and a little larger than the default.
                                tint: ClientStyle.enabled ? Theme.text : Theme.secondary;
                                menu-label: "Input options"; open: root.input-open;
                                enabled: root.voice-ready || !root.voice-active;
                                clicked => { root.toggle-mute(); }
                                menu => {
                                    root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                    root.refresh-devices(); input-menu.show();
                                }
                            }
                            ear := DeviceToggle {
                                icon: root.shown-deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                                label: root.voice-active ? (root.deafened ? "Undeafen" : "Deafen") : root.deafen-on-join ? "Join calls undeafened" : "Join calls deafened";
                                alert: root.shown-deafened;
                                glyph: ClientStyle.enabled ? 21px : 20px;
                                tint: ClientStyle.enabled ? Theme.text : Theme.secondary;
                                menu-label: "Output options"; open: root.output-open;
                                enabled: root.voice-ready || !root.voice-active;
                                clicked => { root.toggle-deafen(); }
                                menu => {
                                    root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                    root.refresh-devices(); output-menu.show();
                                }
                            }
                            if !root.preview && !root.online: IconButton {
                                icon: @image-url("icons/refresh-cw.svg"); label: "Reconnect"; enabled: !root.busy;
                                clicked => { root.retry-sync(); }
                            }
                            cog := IconButton {
                                icon: @image-url("icons/settings.svg"); label: "Settings"; radius: 4px;
                                glyph: ClientStyle.enabled ? 24px : 20px;
                                tint: ClientStyle.enabled ? Theme.text : Theme.secondary;
                                clicked => { root.settings-open = true; root.refresh-devices(); }
                            }
                        }
                        // Discord's thin outline around the card.
                        if ClientStyle.enabled: Rectangle {
                            width: parent.width; height: parent.height; border-radius: 8px;
                            border-width: 1px; border-color: Theme.overlay.with-alpha(0.02); background: transparent;
                        }
                    }
                }
            }
        }
        // Conversation.
        Rectangle {
            background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: ClientStyle.header-height;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        if root.room-direct: Middle {
                            Rectangle {
                                width: 26px; height: 26px;
                                Avatar { size: 26px; initial: root.room-initial; tint: root.room-tint; picture: root.room-picture; }
                                if root.room-presence != "": StatusDot {
                                    x: 14px; y: 14px; width: 14px; height: 14px; presence: root.room-presence; ring: Theme.chat;
                                }
                            }
                        }
                        // A thread follows its channel, which leads back to it.
                        if root.room-parent != "" && root.room-selected: Image {
                            source: root.room-parent-forum ? @image-url("icons/message-square-text.svg") : @image-url("icons/hash.svg");
                            width: 22px; image-fit: contain; colorize: Theme.muted;
                        }
                        if root.room-parent != "" && root.room-selected: parent-name := Text {
                            text: root.room-parent; font-size: 16px; font-weight: 700; vertical-alignment: center;
                            color: parent-touch.has-hover ? Theme.text : Theme.secondary;
                            accessible-role: button; accessible-label: "Back to " + root.room-parent;
                            accessible-action-default => { root.select-room(root.room-parent-id); }
                            parent-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.select-room(root.room-parent-id); }
                            }
                        }
                        if root.room-parent != "" && root.room-selected: Image { source: @image-url("icons/chevron-right.svg"); width: 16px; image-fit: contain; colorize: Theme.faint; }
                        if !root.room-direct && root.room-selected: Image { source: root.room-icon; width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.requests-open: Image { source: @image-url("icons/inbox.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.friends-open: Image { source: @image-url("icons/users.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.browse-open: Image { source: @image-url("icons/hash.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        Text {
                            text: root.room-selected ? root.room-name : root.requests-open ? "Requests" : root.friends-open ? "Friends" : root.browse-open ? "Browse Channels" : root.sidebar-title;
                            color: root.room-selected || root.requests-open || root.friends-open || root.browse-open ? Theme.text : Theme.secondary;
                            font-size: 16px; font-weight: 700; overflow: elide; vertical-alignment: center;
                            // The name gives way to what follows it, and fills the bar when nothing does.
                            horizontal-stretch: (root.room-has-activity && root.room-direct) || root.friends-open || root.has-topic ? 0 : 1;
                        }
                        // A server channel's topic, after a rule, as Discord shows it:
                        // one line, cut short, and in full once clicked.
                        if root.has-topic && !ClientStyle.enabled: Middle { Rectangle { width: 1px; height: 24px; background: Theme.line; } }
                        // Discord's is a small round dot, with room either side.
                        if root.has-topic && ClientStyle.enabled: Middle { Rectangle { width: 9px; height: 3px; Rectangle { width: 3px; height: 3px; x: 2px; border-radius: 1.5px; background: Theme.faint.with-alpha(0.75); } } }
                        if root.has-topic: topic-area := Rectangle {
                            horizontal-stretch: 1; min-width: 40px;
                            accessible-role: button;
                            accessible-label: "Channel topic";
                            accessible-action-default => { root.topic-open = true; }
                            StyledText {
                                width: parent.width; height: parent.height;
                                text: root.room-topic; default-color: topic-touch.has-hover ? Theme.secondary : Theme.muted;
                                link-color: Theme.link; default-font-size: 14px; max-lines: 1; vertical-alignment: center;
                            }
                            // Over the line, whose text would take the press to select: its
                            // links open from the full topic.
                            topic-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.popover-x = topic-area.absolute-position.x;
                                    root.popover-y = topic-area.absolute-position.y + topic-area.height;
                                    root.topic-open = !root.topic-open;
                                }
                            }
                        }
                        // What they're up to, as a bubble beside their name.
                        if root.room-direct && root.room-has-activity: Middle {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 24px; border-radius: 12px; background: Theme.raised;
                                    accessible-role: text; accessible-label: "Status: " + root.room-activity;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        Middle {
                                            StatusText {
                                                text: root.room-activity; emoji-url: root.room-activity-emoji;
                                                color: Theme.secondary; font-weight: 500;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.friends-open: Middle { Rectangle { width: 1px; height: 24px; background: Theme.line; } }
                        if root.friends-open: Middle {
                            HeaderTab { text: "Online"; selected: !root.friends-all; clicked => { root.friends-all = false; } }
                        }
                        if root.friends-open: Middle {
                            HeaderTab { text: "All"; selected: root.friends-all; clicked => { root.friends-all = true; } }
                        }
                        if root.friends-open: Middle {
                            ActionButton { text: "Add Friend"; small: true; primary: true; clicked => { root.open-add-friend(); } }
                        }
                        if root.friends-open: Rectangle { horizontal-stretch: 1; }
                        if root.dm-friend == 1 || root.dm-friend == 3: Middle {
                            ActionButton {
                                icon: @image-url("icons/user-plus.svg");
                                text: root.dm-friend == 1 ? "Add Friend" : "Accept Friend Request";
                                label: root.dm-friend == 1 ? "Send friend request" : "Accept friend request";
                                small: true; primary: root.dm-friend == 3;
                                clicked => { root.befriend(root.dm-person); }
                            }
                        }
                        if root.has-voice-chat: Middle {
                            IconButton {
                                icon: root.voice-chat ? @image-url("icons/volume-2.svg") : @image-url("icons/message-square-text.svg");
                                label: root.voice-chat ? "Show voice channel" : "Open chat";
                                tip-side: 2;
                                clicked => { root.show-voice-chat(!root.voice-chat); }
                            }
                        }
                        if root.can-call: Middle {
                            IconButton {
                                icon: @image-url("icons/phone.svg"); label: root.call-going ? "Join Voice Call" : "Start Voice Call";
                                size: 32px; glyph: 20px; enabled: root.can-join; tip-side: 2;
                                clicked => { root.start-call(); }
                            }
                        }
                        if root.can-call && !root.call-going: Middle {
                            IconButton {
                                icon: @image-url("icons/video.svg"); label: "Start Video Call";
                                size: 32px; glyph: 20px; enabled: root.can-join; tip-side: 2;
                                clicked => { root.start-video-call(); }
                            }
                        }
                        if root.can-list-threads: Middle {
                            IconButton {
                                icon: @image-url("icons/thread.svg"); label: "Threads";
                                size: 32px; glyph: 20px; tip-side: 2;
                                tint: root.threads-open ? Theme.text : Theme.secondary;
                                clicked => {
                                    root.popover-x = self.absolute-position.x + self.width;
                                    root.popover-y = self.absolute-position.y + self.height;
                                    root.show-threads(!root.threads-open);
                                }
                            }
                        }
                        if root.can-notify: Middle {
                            IconButton {
                                icon: root.room-muted ? @image-url("icons/bell-off.svg") : @image-url("icons/bell.svg");
                                label: root.room-muted ? "Notification settings, muted" : "Notification settings";
                                size: 32px; glyph: 20px; tip-side: 2;
                                clicked => {
                                    root.open-context-menu("notifications:" + root.room-id, false,
                                        self.absolute-position.x, self.absolute-position.y + self.height + 6px);
                                }
                            }
                        }
                        if root.can-pin: Middle {
                            IconButton {
                                icon: @image-url("icons/pin.svg"); label: "Pinned messages";
                                size: 32px; glyph: 20px; tip-side: 2;
                                tint: root.pins-open ? Theme.text : Theme.secondary;
                                // Where the pins open from elsewhere, such as a pin's notice.
                                property <length> anchor-x: self.absolute-position.x + self.width;
                                property <length> anchor-y: self.absolute-position.y + self.height;
                                init => { root.pins-anchor-x = self.anchor-x; root.pins-anchor-y = self.anchor-y; }
                                changed anchor-x => { root.pins-anchor-x = self.anchor-x; }
                                changed anchor-y => { root.pins-anchor-y = self.anchor-y; }
                                clicked => {
                                    root.popover-x = self.anchor-x;
                                    root.popover-y = self.anchor-y;
                                    root.show-pins(!root.pins-open);
                                }
                            }
                        }
                        if root.can-add-people: Middle {
                            IconButton {
                                icon: @image-url("icons/user-plus.svg");
                                label: root.add-people-one-to-one ? "Add friends to DM" : "Add friends to the group";
                                size: 32px; glyph: 20px; tip-side: 2;
                                tint: root.add-people-open ? Theme.text : Theme.secondary;
                                clicked => {
                                    root.popover-x = self.absolute-position.x + self.width;
                                    root.popover-y = self.absolute-position.y + self.height;
                                    if root.add-people-open { root.close-add-people(); } else { root.open-add-people(); }
                                }
                            }
                        }
                        // The call's signal, in the conversation it's in, as in
                        // Discord's voice panel.
                        if root.voice-here && root.voice-ready && CallLink.measured: Middle {
                            Rectangle {
                                width: 32px; height: 32px;
                                accessible-role: button; accessible-label: "Voice details";
                                SignalIcon { width: 20px; height: 20px; quality: CallLink.quality; }
                                LinkTouch {
                                    tip-side: 2;
                                    open(x, y, width, height) => { root.open-call-link(x, y, width, height); }
                                }
                            }
                        }
                        if root.members-available && root.room-direct: Middle {
                            HeaderToggle {
                                icon: @image-url("icons/users.svg"); text: root.members; open: root.member-list;
                                label: root.member-list ? "Hide member list" : "Show member list";
                                clicked => { root.toggle-members(); }
                            }
                        }
                        // A server channel's, as Discord's: the icon alone, bright while
                        // the list shows.
                        if root.members-available && !root.room-direct: Middle {
                            IconButton {
                                icon: @image-url("icons/users.svg");
                                label: root.member-list ? "Hide member list" : "Show member list";
                                size: 32px; glyph: 20px; tip-side: 2;
                                tint: root.member-list ? Theme.text : Theme.secondary;
                                clicked => { root.toggle-members(); }
                            }
                        }
                        // A thread's, after its member list, as in Discord's toolbar.
                        if root.room-parent != "" && root.room-selected: Middle {
                            IconButton {
                                icon: @image-url("icons/ellipsis.svg"); label: "More";
                                size: 32px; glyph: 20px; tip-side: 2;
                                clicked => {
                                    root.open-context-menu("thread-toolbar:" + root.room-id, false,
                                        self.absolute-position.x, self.absolute-position.y + self.height + 6px);
                                }
                            }
                        }
                        if root.profile-available: Middle {
                            IconButton {
                                icon: @image-url("icons/user.svg"); label: root.profile-panel ? "Hide profile" : "Show profile";
                                size: 32px; glyph: 20px; tip-side: 2;
                                tint: root.profile-panel ? Theme.text : Theme.secondary;
                                clicked => { root.toggle-profile-panel(); }
                            }
                        }
                        if root.can-search: Middle {
                            HeaderSearch {
                                text <=> root.search-text;
                                placeholder: root.search-placeholder;
                                search(text) => { root.search(text); }
                                clear => { root.search-text = ""; root.search(""); }
                            }
                        }
                        if !root.members-available && !root.profile-available && root.members != "": HorizontalLayout {
                            spacing: 6px;
                            Image { source: @image-url("icons/users.svg"); width: 18px; image-fit: contain; colorize: Theme.muted; }
                            Text { text: root.members; color: Theme.muted; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: ClientStyle.enabled ? Theme.outline-chat : Theme.edge; }
                }
                HorizontalLayout {
                    spacing: 0px;
                    VerticalLayout {
                        spacing: 0px; horizontal-stretch: 1;
                        if root.preview: Rectangle {
                            min-height: preview-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            preview-content := HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; padding-top: 7px; padding-bottom: 7px; spacing: 10px;
                                Image { source: @image-url("icons/triangle-alert.svg"); width: 16px; image-fit: contain; colorize: Theme.accent; }
                                Text {
                                    text: "Local preview: sample data. Nothing leaves this computer.";
                                    color: Theme.secondary; font-size: 14px; font-weight: 500; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }
                        if !root.preview && !root.trusted: VerifyBanner {
                            busy: root.busy; recovery <=> root.recovery;
                            recover => { root.recover(); }
                            refresh-trust => { root.refresh-trust(); }
                        }
                        if root.graphics-notice != "": Banner { text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                        if root.notice != "": Banner { text: root.notice; dismissed => { root.dismiss-notice(); } }
                        // Voice channel: a stage of participants, or an invitation to join.
                        // A DM's call shows the same above its messages.
                        if root.voice-panel || root.call-shown: Rectangle {
                            // Above a DM's messages, a call takes less than half the room,
                            // more while watching a stream, and little while offering to join.
                            vertical-stretch: root.voice-panel ? 1 : !root.voice-here ? 0 : root.call-focus >= 0 ? 1.8 : 0.8;
                            min-height: root.voice-panel ? 0px : root.voice-here ? 260px : 210px;
                            max-height: root.voice-panel || root.voice-here ? 100000px : 210px;
                            background: Theme.stage;
                            if !root.voice-here && !root.voice-panel: CallInvite {
                                call-people: root.call-people; call-note: root.call-note; call-incoming: root.call-incoming;
                                call-room: root.call-room; can-join: root.can-join;
                                answer-call(room, accept) => { root.answer-call(room, accept); }
                            }
                            if !root.voice-panel: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            if !root.voice-here && root.voice-panel: JoinVoice {
                                room-name: root.room-name; voice-description: root.voice-description; preview: root.preview;
                                call-encrypted: root.call-encrypted; voice-active: root.voice-active; can-join: root.can-join;
                                join-voice => { root.join-voice(); }
                            }
                            if root.voice-here: VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    padding: 16px; padding-bottom: 0px;
                                    Text { text: root.voice-description; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                                }
                                if !root.stage-full: ParticipantGrid {
                                    participants: root.participants; frames: root.participant-frames;
                                    camera-starting: root.camera-starting; sharing: root.sharing; share-live: root.share-live;
                                    share-status: root.share-status; share-frame: root.share-frame;
                                    share-viewers: root.share-viewers; share-viewer-names: root.share-viewer-names;
                                    stream-tiles: root.stream-tiles; watch-user: root.watch-user; watch-frame: root.watch-frame;
                                    watch-status: root.watch-status; watch-viewers: root.watch-viewers; watch-viewer-names: root.watch-viewer-names;
                                    focused: root.call-focus;
                                    focus-tile(slot) => { root.focus-tile(slot); }
                                    full-screen(on) => { root.stage-full = on; }
                                    watch-stream(id) => { root.watch-stream(id); }
                                    stop-watching => { root.stop-watching(); }
                                    open-volume(person, x, y) => { root.open-voice-menu(root.voice-channel, person, x, y); }
                                    tiles(columns, width, height, gap, top, scrolled, shown, focused, focus-width, focus-height) => {
                                        root.call-tiles(columns, width, height, gap, top, scrolled, shown, focused, focus-width, focus-height);
                                    }
                                }
                                CallControls {
                                    muted: root.muted; deafened: root.deafened; voice-ready: root.voice-ready; voice-leaving: root.voice-leaving;
                                    can-share: root.can-share; sharing: root.sharing;
                                    can-film: root.can-film; camera-on: root.camera-on; camera-starting: root.camera-starting;
                                    can-soundboard: root.can-soundboard;
                                    toggle-camera => { root.toggle-camera(); }
                                    toggle-mute => { root.toggle-mute(); }
                                    toggle-deafen => { root.toggle-deafen(); }
                                    toggle-share => { root.toggle-share(); }
                                    open-share-menu(x, y) => { root.open-share-menu(x, y); }
                                    open-soundboard(x, y) => { root.open-soundboard(x, y); }
                                    leave-voice => { root.leave-voice(); }
                                }
                            }
                        }
                        // A forum post's bar, as Discord shows it: react to the post, and
                        // follow it or copy its link.
                        if ClientStyle.enabled && root.forum-post && !root.voice-panel && !root.room-forum: Rectangle {
                            height: 45px; vertical-stretch: 0;
                            background: Theme.chat;
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.outline-chat; }
                            if root.forum-post-item != "": react-pill := Rectangle {
                                x: 16px; y: 7px; height: 31px; width: react-row.preferred-width + 24px;
                                border-radius: 8px;
                                background: react-touch.has-hover ? Theme.field : Theme.raised;
                                react-row := HorizontalLayout {
                                    x: 12px; spacing: 8px; alignment: start;
                                    Middle { Image { source: @image-url("icons/smile.svg"); width: 18px; height: 18px; colorize: Theme.text; accessible-role: none; } }
                                    Text { text: "React to post"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                react-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.anchor(react-pill.absolute-position.x, react-pill.absolute-position.y, react-pill.width, react-pill.height, false);
                                        root.open-picker(root.forum-post-item);
                                    }
                                }
                                accessible-role: button; accessible-label: "React to post";
                                accessible-action-default => {
                                    root.anchor(react-pill.absolute-position.x, react-pill.absolute-position.y, react-pill.width, react-pill.height, false);
                                    root.open-picker(root.forum-post-item);
                                }
                            }
                            HorizontalLayout {
                                alignment: end; padding-right: 16px; padding-top: 7px; padding-bottom: 7px; spacing: 4px;
                                if root.forum-post-follow > 0: Rectangle {
                                    width: follow-row.preferred-width + 24px;
                                    border-radius: 8px;
                                    background: follow-touch.has-hover ? Theme.field : Theme.raised;
                                    follow-row := HorizontalLayout {
                                        x: 12px; spacing: 6px; alignment: start;
                                        if root.forum-post-follow == 2: Middle { Image { source: @image-url("icons/check.svg"); width: 18px; height: 18px; colorize: Theme.text; accessible-role: none; } }
                                        if root.forum-post-follow == 1: Middle { Image { source: @image-url("icons/plus.svg"); width: 18px; height: 18px; colorize: Theme.text; accessible-role: none; } }
                                        Text { text: root.forum-post-follow == 2 ? "Following" : "Follow"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                    }
                                    follow-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.choose-menu(root.room-id, false, root.forum-post-follow == 2 ? "leave-thread" : "join-thread"); }
                                    }
                                    accessible-role: button; accessible-label: root.forum-post-follow == 2 ? "Following" : "Follow";
                                    accessible-action-default => { root.choose-menu(root.room-id, false, root.forum-post-follow == 2 ? "leave-thread" : "join-thread"); }
                                }
                                Rectangle {
                                    width: 32px; border-radius: 8px;
                                    background: link-touch.has-hover ? Theme.field : Theme.raised;
                                    Image { source: @image-url("icons/link.svg"); width: 18px; height: 18px; colorize: Theme.text; accessible-role: none; }
                                    link-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.choose-menu(root.room-id, false, "copy-link"); }
                                    }
                                    accessible-role: button; accessible-label: "Copy link";
                                    accessible-action-default => { root.choose-menu(root.room-id, false, "copy-link"); }
                                }
                            }
                        }
                        // A forum's posts, in place of its messages.
                        if root.room-forum && !root.voice-panel: ForumPanel {
                            vertical-stretch: 1;
                            rows: root.post-rows; note: root.posts-note; empty: root.posts-empty;
                            searching: root.posts-searching; searchable: root.posts-searchable;
                            query <=> root.posts-query;
                            more: root.posts-more; loading: root.posts-loading;
                            can-post: root.can-post; composing: root.post-composing;
                            post-title <=> root.post-title; post-body <=> root.post-body;
                            chosen-tags: root.post-chosen-tags; tag-choices: root.post-tag-choices;
                            tag-required: root.post-tag-required; more-tags: root.post-more-tags;
                            guidelines: root.post-guidelines; has-guidelines: root.post-has-guidelines;
                            staged: root.staged; can-attach: root.can-attach; can-mark-spoilers: root.can-mark-spoilers;
                            posting: root.posting; post-error: root.post-error; leaving: root.post-leaving;
                            search(text) => { root.search-posts(text); }
                            more-posts => { root.more-posts(); }
                            open(room, beside) => { root.open-listed-thread(room, beside); }
                            new-post => { root.new-post(); }
                            post-title-edited(text) => { root.post-title-edited(text); }
                            post-body-edited(text) => { root.post-body-edited(text); }
                            toggle-tag(id) => { root.toggle-post-tag(id); }
                            attach => { root.attach(); }
                            unstage(index) => { root.unstage(index); }
                            toggle-spoiler(index) => { root.toggle-spoiler(index); }
                            create-post => { root.create-post(); }
                            close-post => { root.close-post(); }
                            leave-post => { root.leave-post(); }
                            stay-post => { root.stay-post(); }
                            open-link(link) => { root.open-link(link); }
                        }
                        // Text conversation.
                        Rectangle {
                            visible: !root.voice-panel && !root.room-forum;
                            min-height: 0px;
                            max-height: root.voice-panel || root.room-forum ? 0px : 100000px;
                            vertical-stretch: root.voice-panel || root.room-forum ? 0 : 1;
                            // Up and Down step through messages; R replies, E edits, Delete deletes,
                            // C copies, F forwards, + reacts, Enter opens the menu, Escape returns
                            // to the composer.
                            timeline-keys := FocusScope {
                                width: parent.width; height: parent.height;
                                focus-on-click: false;
                                accessible-role: list;
                                accessible-label: "Messages";
                                key-pressed(event) => {
                                    if root.messages.length == 0 { return reject; }
                                    if root.confirm-delete != "" && root.confirm-delete == root.active-item {
                                        if event.text == Key.Return { root.confirm-delete-message(); return accept; }
                                        if event.text == Key.Escape { root.cancel-delete(); return accept; }
                                    }
                                    if event.text == Key.UpArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index - 1); return accept; }
                                    if event.text == Key.DownArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index + 1); return accept; }
                                    if event.text == Key.PageUp { root.step-message(root.active-index - 5); return accept; }
                                    if event.text == Key.PageDown { root.step-message(root.active-index + 5); return accept; }
                                    if event.text == Key.Home { root.step-message(0); return accept; }
                                    if event.text == Key.End { root.step-message(root.messages.length - 1); return accept; }
                                    if event.text == Key.Escape { root.focus-composer(); return accept; }
                                    if root.active-index < 0 || root.active-index >= root.messages.length { return reject; }
                                    if root.keyed-message.deleted || root.keyed-message.delivery != "" { return reject; }
                                    if event.text == Key.Return || event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                                        root.keyboard-popup = "menu"; return accept;
                                    }
                                    if (event.text == "+" || event.text == "=") && root.keyed-message.can-react && root.new-reactions-enabled {
                                        root.keyboard-popup = "react"; return accept;
                                    }
                                    if (event.text == "r" || event.text == "R") && root.keyed-message.can-reply && root.composer-enabled {
                                        root.reply(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == "e" || event.text == "E") && root.keyed-message.own && root.keyed-message.can-edit && root.composer-enabled {
                                        root.edit(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == Key.Delete || event.text == Key.Backspace) && root.keyed-message.can-delete && root.composer-enabled {
                                        root.request-delete(root.keyed-message.item); return accept;
                                    }
                                    if (event.text == "c" || event.text == "C") && root.keyed-message.body != "" {
                                        root.copy-text(root.keyed-message.body); return accept;
                                    }
                                    if (event.text == "f" || event.text == "F") && root.keyed-message.can-forward && root.forward-allowed {
                                        root.start-forward(root.keyed-message.item); return accept;
                                    }
                                    return reject;
                                }
                                // Leaving the timeline puts the last hovered message's bar away, as
                                // Discord does, unless something opened from it still needs it. The
                                // list takes the pointer when a press starts, which only ends its
                                // rows' hover, not this.
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    changed has-hover => {
                                        if !self.has-hover && !root.browsing && root.menu-item == "" && root.react-item == "" && root.confirm-delete == "" {
                                            root.active-item = "";
                                        }
                                    }
                                    timeline := ListView {
                                        width: parent.width; height: parent.height;
                                        scrolled => { root.follow-latest = false; }
                                        for message[index] in root.messages: Rectangle {
                                            property <bool> lit: root.active-item == message.item;
                                            property <bool> jumped: root.jump-item != "" && root.jump-item == message.item;
                                            property <int> jump-tick: root.jump-tick;
                                            changed jump-tick => {
                                                if self.jumped {
                                                    root.jump-placed = true;
                                                    timeline.content-y = max(min(0px, timeline.height - timeline.content-height),
                                                        min(0px, (root.jump-lit ? timeline.height / 3 : 0px) - self.y - self.top));
                                                    // The list may have been at its end before the jump and be there after,
                                                    // so `reading-latest` needn't change, but the application stopped counting
                                                    // on it when it asked for the jump.
                                                    root.reading-changed(root.reading-latest);
                                                }
                                            }
                                            // The keyboard's message stays in view, with room for the next one,
                                            // so stepping on finds it built.
                                            changed lit => {
                                                if self.lit && root.browsing {
                                                    root.active-index = index;
                                                    if self.y + timeline.content-y < root.keyboard-margin {
                                                        root.follow-latest = false;
                                                        timeline.content-y = min(0px, root.keyboard-margin - self.y);
                                                    } else if self.y + self.height + timeline.content-y > timeline.height - root.keyboard-margin {
                                                        timeline.content-y = max(min(0px, timeline.height - timeline.content-height), timeline.height - root.keyboard-margin - self.y - self.height);
                                                    }
                                                }
                                            }
                                            property <bool> keyed: self.lit && root.keyboard-popup != "";
                                            changed keyed => {
                                                if self.keyed {
                                                    root.anchor(self.absolute-position.x + self.width - 16px, self.absolute-position.y + self.body - 16px, 0px, 32px, false);
                                                    if root.keyboard-popup == "menu" { root.open-menu(message); } else { root.open-picker(message.item); }
                                                    root.keyboard-popup = "";
                                                }
                                            }
                                            // Where it is in the view, for `top-index` and `bottom-index`.
                                            property <length> view-y: self.y + timeline.content-y;
                                            property <int> view-tick: root.view-tick;
                                            property <int> row-index: index;
                                            function report-view() {
                                                if self.view-y <= 0px && self.view-y + self.height > 0px {
                                                    root.top-index = index; root.top-item = message.item; root.top-edge = self.view-y + self.height;
                                                }
                                                if self.view-y < timeline.height && (self.view-y + self.height >= timeline.height || index == root.messages.length - 1) { root.bottom-index = index; }
                                                if message.unread-start { root.unread-y = self.view-y + self.top; }
                                            }
                                            init => { root.view-tick += 1; }
                                            changed view-y => { self.report-view(); }
                                            changed height => { self.report-view(); }
                                            changed view-tick => { self.report-view(); }
                                            changed row-index => { self.report-view(); }
                                            // The space that holds a short history down stays outside the row.
                                            property <length> top: index == 0 ? root.lead : 0px;
                                            height: col.preferred-height + self.top;
                                            // The last row's tints stop above the space it leaves at the end,
                                            // where the typing line sits on the chat's own colour.
                                            property <length> tail: index == root.messages.length - 1 ? (root.detached ? 74px : 20px) : 0px;
                                            // Where the message itself starts: its tint, hover bar and edge
                                            // leave out the history notice and the dividers above it.
                                            property <length> head: (index == 0 && root.room-ready ? (ClientStyle.enabled && root.history-start && root.intro-kind != "" ? (root.intro-kind == "server" ? ClientStyle.intro-server-height : ClientStyle.intro-channel-height) : 42px) : 0px)
                                                + (message.day != "" || message.unread-start ? 26px : 0px);
                                            property <length> body: self.top + (self.head > 0px ? col.padding-top + self.head : 0px);
                                            Rectangle {
                                                y: parent.body; height: parent.height - parent.body - parent.tail;
                                                background: parent.jumped && root.jump-lit ? Theme.accent.transparentize(0.86) : parent.lit ? Theme.row-hover : transparent;
                                                animate background { duration: 400ms; }
                                            }
                                            // A message that calls on this account is tinted marigold with a
                                            // marigold edge, below the history notice and the dividers above it:
                                            // a mention always, a reply to its message while it's new.
                                            if message.highlighted: Rectangle {
                                                y: parent.body;
                                                height: parent.height - self.y - parent.tail;
                                                background: row-pointer.has-hover ? Theme.mentioned-hover : Theme.mentioned;
                                                Rectangle { x: 0px; width: 2px; background: Theme.accent; }
                                            }
                                            // The keyboard's message has a marigold edge.
                                            if self.lit && root.browsing: Rectangle { x: 0px; y: parent.body; width: 3px; height: parent.height - parent.body; background: Theme.accent; }
                                            // The pointer area wraps the row, so hovering selectable text still counts.
                                            // The last hovered or clicked message keeps its actions: the list takes
                                            // the pointer when a press starts, which ends hover, so a hover-only bar
                                            // would vanish before its button saw the click.
                                            row-pointer := TouchArea {
                                                y: parent.top; height: parent.height - parent.top;
                                                // The notice and dividers above the message aren't it: the pointer
                                                // over them doesn't call up its bar.
                                                property <bool> on-body: self.mouse-y >= parent.body - parent.top;
                                                changed has-hover => { if self.has-hover && self.on-body { root.active-item = message.item; root.active-index = index; } }
                                                clicked => { root.active-item = message.item; root.active-index = index; }
                                                // A right click opens the same menu as the hover bar's More button.
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.move && parent.head > 0px {
                                                        if self.on-body {
                                                            if root.active-item != message.item { root.active-item = message.item; root.active-index = index; }
                                                        } else if root.active-item == message.item && !root.browsing && root.menu-item == "" && root.react-item == "" && root.confirm-delete == "" {
                                                            root.active-item = "";
                                                        }
                                                    }
                                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                                        && !message.deleted && message.delivery == "" {
                                                        root.active-item = message.item;
                                                        root.anchor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0px, 0px, true);
                                                        root.open-menu(message);
                                                    }
                                                }
                                                col := VerticalLayout {
                                                    padding-top: message.day != "" || message.unread-start ? 12px : message.first ? ClientStyle.message-group-gap : 1px;
                                                    // The last row leaves room for the bar over a window's end.
                                                    padding-bottom: index == root.messages.length - 1 ? (root.detached ? 52px : 20px) : 1px;
                                                    spacing: 0px;
                                                    // History starts with what's before it: earlier messages
                                                    // loading, or the conversation's start.
                                                    if index == 0 && root.room-ready: HistoryEdge {
                                                        loading: root.loading-history; failed: root.history-failed; start: root.history-start;
                                                        enabled: !root.busy && !root.preview; room-direct: root.room-direct; room-name: root.room-name;
                                                        room-thread: root.room-parent != "";
                                                        intro: root.intro-kind; intro-welcome: root.intro-welcome; intro-title: root.intro-title; intro-text: root.intro-text;
                                                        earlier => { root.earlier(); }
                                                    }
                                                    // A new day's date, and the "New" divider in marigold above
                                                    // the first unread message, in the middle of one line, the
                                                    // date and "New" together when both are here.
                                                    if message.day != "" || message.unread-start: HorizontalLayout {
                                                        padding-left: 16px; padding-right: 16px; padding-bottom: 6px; spacing: 10px; height: 26px;
                                                        Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: message.unread-start ? Theme.accent : Theme.line; } }
                                                        if message.day != "": Text { text: message.day; color: Theme.muted; font-size: ClientStyle.enabled ? 12px : 13px; font-weight: ClientStyle.enabled ? 600 : 700; vertical-alignment: center; }
                                                        if message.day != "" && message.unread-start: Text { text: "·"; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                        if message.unread-start: Rectangle {
                                                            width: new-text.preferred-width + 10px;
                                                            accessible-role: text; accessible-label: "New messages start here";
                                                            Rectangle {
                                                                height: 18px; border-radius: 4px; background: Theme.accent;
                                                                new-text := Text {
                                                                    text: "New"; color: Theme.on-accent; font-size: 12px; font-weight: 800;
                                                                    horizontal-alignment: center; vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: message.unread-start ? Theme.accent : Theme.line; } }
                                                    }
                                                    MessageContent {
                                                        message: message; active-item: root.active-item; preview: root.preview; reactions-enabled: root.reactions-enabled; bot-busy-item: root.bot-busy-item; bot-failed-item: root.bot-failed-item; bot-failed-text: root.bot-failed-text;
                                                        emoji-font: root.emoji-font; message-font-size: root.message-font-size;
                                                        collapse-long: root.collapse-long;
                                                        // The view keeps the message's top: it stops following
                                                        // the newest, and Show less on a message whose top is
                                                        // above the view brings its top back into it.
                                                        fold(item, whole, y) => {
                                                            root.follow-latest = false;
                                                            if !whole && y < timeline.absolute-position.y {
                                                                timeline.content-y += timeline.absolute-position.y - y;
                                                            }
                                                            root.fold-message(item, whole);
                                                        }
                                                        author-card(item, sender, x, y, width, height) => { root.author-card(item, sender, x, y, width, height); }
                                                        author-menu(item, sender, x, y) => { root.author-menu(item, sender, x, y); }
                                                        jump-to(item) => { root.jump-to(item); }
                                                        // A mention's card opens beside the pointer.
                                                        link-clicked(link) => {
                                                            root.anchor(row-pointer.absolute-position.x + row-pointer.mouse-x, row-pointer.absolute-position.y + row-pointer.mouse-y, 0px, 0px, true);
                                                            root.open-link(link);
                                                        }
                                                        open-link(link) => { root.open-link(link); }
                                                        use-button(item, id) => { root.use-button(item, id); }
                                                        open-select(item, id) => { root.open-select(item, id); }
                                                        open-thread(room) => { root.open-aside(room); }
                                                        react(item, key) => { root.react(item, key); }
                                                        retry(item) => { root.retry(item); }
                                                        cancel-send(item) => { root.cancel-send(item); }
                                                        reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                                                        view-image(id, index) => { root.view-image(id, index); }
                                                        open-sticker(item, index, x, y, width, height) => {
                                                            root.anchor(x, y, width, height, false);
                                                            root.open-sticker(item, index);
                                                        }
                                                        save-attachment(id, index) => { root.save-attachment(id, index); }
                                                        // A right click on a picture opens the message's menu with it.
                                                        media-menu(id, index, video, x, y) => {
                                                            if !message.deleted && message.delivery == "" {
                                                                root.active-item = message.item;
                                                                root.anchor(x, y, 0px, 0px, true);
                                                                root.open-message-menu(message, index, video);
                                                            }
                                                        }
                                                    }
                                                    // A window of older messages ends with what's after it: newer
                                                    // messages loading, or a way to load them.
                                                    if index == root.messages.length - 1 && root.detached && root.room-ready: HistoryEdge {
                                                        newer: true; loading: root.loading-later; failed: root.later-failed;
                                                        enabled: !root.busy && !root.preview;
                                                        earlier => { root.later(); }
                                                    }
                                                }
                                            }
                                            // Actions, the reaction picker and delete confirmation float over the
                                            // row's top edge, so opening them never moves the timeline.
                                            if (self.lit || root.react-item == message.item || root.menu-item == message.item || root.confirm-delete == message.item) && !message.deleted && message.delivery == "": message-bar := Rectangle {
                                                x: parent.width - self.width - 16px; y: parent.body + (index == 0 && parent.head == 0px ? 4px : -16px);
                                                width: actions.preferred-width; height: actions.preferred-height;
                                                background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                                drop-shadow-blur: 10px; drop-shadow-color: #00000059; drop-shadow-offset-y: 2px;
                                                // Holding Shift swaps the frequent reactions for Pin, Create Thread
                                                // and, on your own message, Reply, adds Forward, and swaps More for a
                                                // Delete that doesn't ask, as in Discord's client; not while the
                                                // picker or menu is open.
                                                property <bool> quick: root.shift-held && root.react-item != message.item && root.menu-item != message.item;
                                                property <bool> deletes: self.quick && message.can-delete && root.composer-enabled;
                                                actions := HorizontalLayout {
                                                    padding: 3px; spacing: 0px;
                                                    if root.confirm-delete == message.item: HorizontalLayout {
                                                        spacing: 4px; padding-left: 8px;
                                                        Text { text: "Delete for everyone?"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                        ActionButton { text: "Delete"; danger: true; small: true; clicked => { root.confirm-delete-message(); } }
                                                        ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-delete(); } }
                                                    }
                                                    // Frequent reactions, then the picker, Edit on your own message or
                                                    // Reply on someone else's, and everything else under More.
                                                    if root.confirm-delete != message.item: HorizontalLayout {
                                                        spacing: 0px;
                                                        if message-bar.quick && message.can-pin: IconButton {
                                                            icon: message.pinned ? @image-url("icons/pin-off.svg") : @image-url("icons/pin.svg");
                                                            label: message.pinned ? "Unpin" : "Pin";
                                                            clicked => { root.pin-message(message.item); }
                                                        }
                                                        if message-bar.quick && root.can-start-threads && message.can-reply && message.thread-room == "": IconButton {
                                                            icon: @image-url("icons/thread.svg"); label: "Create Thread";
                                                            clicked => { root.new-thread(message.item, "message"); }
                                                        }
                                                        if message-bar.quick && message.own && message.can-edit && message.can-reply && root.composer-enabled: IconButton {
                                                            icon: @image-url("icons/reply.svg"); label: "Reply";
                                                            clicked => { root.reply(message.item); root.focus-composer(); }
                                                        }
                                                        if message.can-react && root.new-reactions-enabled: HorizontalLayout {
                                                            spacing: 0px;
                                                            if !message-bar.quick: HorizontalLayout {
                                                                spacing: 0px;
                                                                for cell in root.bar-reactions: EmojiButton {
                                                                    animation-key: cell.key;
                                                                    emoji: cell; font: root.emoji-font;
                                                                    clicked => { root.react(message.item, cell.key); }
                                                                }
                                                                Rectangle {
                                                                    width: 9px;
                                                                    Rectangle { width: 1px; height: 20px; background: Theme.line; }
                                                                }
                                                            }
                                                            IconButton {
                                                                icon: @image-url("icons/smile-plus.svg"); label: "Add reaction";
                                                                clicked => {
                                                                    root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                                    root.open-picker(message.item);
                                                                }
                                                            }
                                                        }
                                                        if message.own && message.can-edit && root.composer-enabled: IconButton { icon: @image-url("icons/pencil.svg"); label: "Edit"; clicked => { root.edit(message.item); root.focus-composer(); } }
                                                        if !(message.own && message.can-edit) && message.can-reply && root.composer-enabled: IconButton { icon: @image-url("icons/reply.svg"); label: "Reply"; clicked => { root.reply(message.item); root.focus-composer(); } }
                                                        // Beside Reply, as in Discord, whether or not Shift is held.
                                                        if message.can-forward && root.forward-allowed: IconButton {
                                                            icon: @image-url("icons/forward.svg"); label: "Forward";
                                                            clicked => { root.start-forward(message.item); }
                                                        }
                                                        if message-bar.deletes: IconButton {
                                                            icon: @image-url("icons/trash-2.svg"); label: "Delete"; danger: true;
                                                            clicked => { root.delete-now(message.item); }
                                                        }
                                                        if !message-bar.deletes: IconButton {
                                                            icon: @image-url("icons/ellipsis.svg"); label: "More";
                                                            clicked => {
                                                                root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                                root.open-menu(message);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // While the "New" divider is out of view, until the newest message is
                            // read, a bar at the top jumps to it.
                            if root.room-selected && !root.requests-open && !root.friends-open && !root.caught-up
                                && (root.unread-above || root.unread-below): UnreadBar {
                                x: (parent.width - self.width) / 2; y: 12px;
                                label: root.unread-label; above: root.unread-above;
                                jump => { root.jump-to-unread(); }
                            }
                            // A window of older messages says so over its end, with the way back.
                            if root.room-selected && root.detached && !root.requests-open && !root.friends-open: PresentBar {
                                x: 16px; width: parent.width - 32px; y: parent.height - self.height - 8px;
                                jump => { root.jump-to-present(); }
                            }
                            if root.requests-open: RequestsScreen {
                                width: parent.width; height: parent.height;
                                incoming: root.requests-incoming;
                                sent: root.requests-sent;
                                spam: root.requests-spam;
                                accept(id) => { root.befriend(id); }
                                remove(id) => { root.remove-friend-request(id); }
                                open(id) => { root.select-room(id); }
                            }
                            if root.friends-open: FriendsScreen {
                                width: parent.width; height: parent.height;
                                rows: root.friends-all ? root.friends : root.friends-online;
                                all: root.friends-all; total: root.friend-count;
                                filter <=> root.friend-filter;
                                filter-edited => { root.friend-filter-edited(); }
                                message(id) => { root.message-friend(id); }
                                open-voice(id) => { root.open-conversation(id); }
                                add-friend => { root.open-add-friend(); }
                                open-friend-menu(id, x, y) => { root.open-context-menu(id, true, x, y); }
                            }
                            // The conversation's opening, or what to do when none is chosen.
                            if root.browse-open: BrowseScreen {
                                width: parent.width; height: parent.height;
                                rows: root.browse-rows;
                                filter <=> root.browse-filter;
                                filter-edited => { root.browse-filter-edited(); }
                                follow(id, on) => { root.browse-follow(id, on); }
                                view(id) => { root.select-room(id); }
                            }
                            if !root.room-selected && !root.requests-open && !root.friends-open && !root.browse-open: NoConversation {
                                width: parent.width; height: parent.height;
                            }
                            if root.room-selected && root.messages.length == 0 && !root.room-ready: MessagesSkeleton {
                                width: parent.width; height: parent.height;
                            }
                            if root.room-selected && root.messages.length == 0 && root.room-ready: ConversationStart {
                                width: parent.width; height: parent.height;
                                room-selected: root.room-selected; room-ready: root.room-ready; room-direct: root.room-direct; room-name: root.room-name;
                                room-thread: root.room-parent != "";
                                room-icon: root.room-icon; room-initial: root.room-initial; room-tint: root.room-tint; room-picture: root.room-picture;
                            }
                            // Who else is typing, just above the composer in the room the
                            // last message leaves under it, so the timeline doesn't move.
                            // Its text lines up with the messages' (16px, a 40px avatar
                            // and 16px in), and it breathes gently while they type, as
                            // animations play: `animation-tick()` repaints every frame, so
                            // with them held still it holds still too.
                            if root.typing != "" && root.room-selected && !root.voice-panel: Rectangle {
                                x: 72px - 4px; y: parent.height - self.height;
                                width: min(parent.width - 72px - 12px, typing-text.preferred-width + 8px); height: 20px;
                                background: Theme.chat;
                                typing-text := Text {
                                    x: 4px; width: parent.width - 8px;
                                    text: root.typing; color: Theme.text; font-size: 13px; font-weight: 500;
                                    vertical-alignment: center; overflow: elide;
                                    opacity: Motion.playing ? 0.75 + 0.25 * sin(animation-tick() / 1ms * 0.25deg) : 1;
                                }
                            }
                            // Under the avatars, three dots rise and brighten in turn, or
                            // sit still in a row while animations don't play.
                            if root.typing != "" && root.room-selected && !root.voice-panel: Rectangle {
                                x: 36px - self.width / 2; y: parent.height - self.height;
                                width: 32px; height: 20px;
                                background: Theme.chat;
                                for dot in 3: Rectangle {
                                    property <float> wave: Motion.playing ? sin(animation-tick() / 1ms * 0.3deg - dot * 70deg) : 0;
                                    x: 4px + dot * 9px; y: (parent.height - self.height) / 2 - 1.5px * self.wave;
                                    width: 6px; height: 6px; border-radius: 3px;
                                    background: Theme.muted;
                                    opacity: 0.6 + 0.4 * self.wave;
                                }
                            }
                        }
                        // Composer.
                        VerticalLayout {
                            visible: !root.voice-panel && !root.room-forum && root.room-selected;
                            min-height: 0px;
                            max-height: root.voice-panel || root.room-forum || !root.room-selected ? 0px : 100000px;
                            padding-left: ClientStyle.composer-gutter; padding-right: ClientStyle.composer-gutter; padding-top: 0px; padding-bottom: 0px;
                            spacing: 0px; vertical-stretch: 0;
                            if root.room-request: RequestBar {
                                request-title: root.request-title;
                                accept-request => { root.accept-request(); }
                                ignore-request => { root.ignore-request(); }
                            }
                            if root.compose-label != "": Rectangle {
                                height: 36px; background: Theme.sidebar;
                                border-top-left-radius: 10px; border-top-right-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 4px; spacing: 8px;
                                    Image { source: root.is-editing ? @image-url("icons/pencil.svg") : @image-url("icons/reply.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                                    Text { text: root.compose-label; color: Theme.secondary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    if !root.is-editing: VerticalLayout { alignment: center; PingToggle { on: root.reply-ping; toggled => { root.toggle-reply-ping(); } } }
                                    IconButton { icon: @image-url("icons/x.svg"); label: root.is-editing ? "Cancel editing" : "Cancel reply"; size: 28px; glyph: 16px; clicked => { root.cancel-compose(); } }
                                }
                            }
                            if root.composer-locked && !root.room-request: Rectangle {
                                height: ClientStyle.composer-height;
                                background: Theme.field; border-width: 1px; border-color: Theme.outline-field; border-radius: 10px;
                                accessible-role: text; accessible-label: root.composer-locked-text;
                                Text {
                                    x: 16px; width: parent.width - 32px; height: parent.height;
                                    text: root.composer-locked-text; color: Theme.muted; font-size: 16px;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            composer-box := Rectangle {
                                visible: !root.room-request && !root.composer-locked;
                                min-height: root.room-request || root.composer-locked ? 0px : ClientStyle.composer-height; max-height: root.room-request || root.composer-locked ? 0px : 100000px;
                                background: ClientStyle.enabled ? Theme.composer : Theme.field;
                                // Discord's outline: faint, and a notch lighter with the keys.
                                border-width: 1px;
                                border-color: composer.focused ? Theme.muted.with-alpha(0.55) : ClientStyle.enabled ? Theme.outline-field : Theme.line;
                                animate border-color { duration: Theme.quick; }
                                border-radius: 10px;
                                border-top-left-radius: root.compose-label != "" ? 0px : 10px;
                                border-top-right-radius: root.compose-label != "" ? 0px : 10px;
                                VerticalLayout {
                                    spacing: 0px;
                                    // Files waiting to go with the message, in a row that scrolls sideways.
                                    if root.staged.length > 0: Flickable {
                                        height: 152px;
                                        content-width: max(self.width, staged-row.preferred-width);
                                        staged-row := HorizontalLayout {
                                            padding: 10px; padding-bottom: 2px; spacing: 8px; alignment: start;
                                            for file[index] in root.staged: StagedTile {
                                                file: file; can-spoil: root.can-mark-spoilers;
                                                remove => { root.unstage(index); }
                                                toggle-spoiler => { root.toggle-spoiler(index); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 8px; spacing: 6px;
                                        // The buttons stay on the last line as the composer grows.
                                        VerticalLayout {
                                            alignment: end; padding-bottom: ClientStyle.composer-button-inset;
                                            // Where threads can start, it opens Discord's menu
                                            // of uploading a file or starting a thread.
                                            IconButton {
                                                // Discord's is a plain 18px plus, not a circled one.
                                                icon: ClientStyle.enabled ? @image-url("icons/plus.svg") : @image-url("icons/circle-plus.svg");
                                                label: root.can-start-threads || root.can-create-polls ? "More options" : "Attach files";
                                                glyph: ClientStyle.enabled ? 27px : 22px;
                                                enabled: root.can-attach || root.can-start-threads || root.can-create-polls;
                                                clicked => {
                                                    if root.can-start-threads || root.can-create-polls {
                                                        root.menu-x = self.absolute-position.x;
                                                        root.menu-y = self.absolute-position.y;
                                                        plus-menu.show();
                                                    } else {
                                                        root.attach();
                                                    }
                                                }
                                            }
                                        }
                                        composer := Composer {
                                            pad: ClientStyle.composer-padding; min-height: ClientStyle.composer-height;
                                            text <=> root.draft; enabled: root.composer-enabled; label: "Message";
                                            placeholder: root.is-editing ? "Edit your message" : root.compose-label != "" ? "Write a reply" : root.room-selected ? root.composer-placeholder : "Write a message";
                                            edited(text) => { root.draft-edited(text); }
                                            accepted => { root.send(); }
                                            suggesting: !root.suggesting-aside && (root.mentions.length > 0 || root.emoji-suggestions.length > 0);
                                            caret(text, offset) => { root.composer-caret(text, offset); }
                                            suggestion-moved(step) => {
                                                if root.mentions.length > 0 {
                                                    root.mention-index = Math.mod(root.mention-index + step + root.mentions.length, root.mentions.length);
                                                } else {
                                                    root.emoji-suggestion-index = Math.mod(root.emoji-suggestion-index + step + root.emoji-suggestions.length, root.emoji-suggestions.length);
                                                }
                                            }
                                            suggestion-chosen => {
                                                if root.mentions.length > 0 { root.mention-chosen(root.mention-index); }
                                                else { root.emoji-suggestion-chosen(root.emoji-suggestion-index); }
                                            }
                                            suggestion-dismissed => {
                                                if root.mentions.length > 0 { root.mention-dismissed(); } else { root.emoji-suggestion-dismissed(); }
                                            }
                                            up-from-empty => { root.edit-last(); }
                                            up-to-messages => { root.browse-messages(); }
                                            escaped => { return root.escape-composing(); }
                                            got-focus => { root.aside-composer-last = false; }
                                            paste => { root.paste-into-composer(); }
                                            expressions(tab) => {
                                                if tab == 0 && !root.can-pick-gifs { return; }
                                                root.anchor(emoji-button.absolute-position.x, emoji-button.absolute-position.y, emoji-button.width, emoji-button.height, false);
                                                if root.can-pick-gifs {
                                                    root.open-expressions(tab);
                                                } else {
                                                    root.open-picker("yapfast:composer");
                                                }
                                            }
                                        }
                                        // As Discord's: the GIFs, the stickers, then the emoji,
                                        // in one picker.
                                        if root.can-pick-gifs: VerticalLayout {
                                            alignment: end; padding-bottom: ClientStyle.composer-button-inset;
                                            gif-button := IconButton {
                                                icon: @image-url("icons/gif.svg"); label: "Open GIF picker";
                                                glyph: 22px; enabled: root.composer-enabled;
                                                tint: root.expressions-open && root.expression-tab == 0 ? Theme.text : Theme.secondary;
                                                clicked => {
                                                    root.anchor(emoji-button.absolute-position.x, emoji-button.absolute-position.y, emoji-button.width, emoji-button.height, false);
                                                    root.open-expressions(0);
                                                }
                                            }
                                        }
                                        if root.can-pick-stickers: VerticalLayout {
                                            alignment: end; padding-bottom: ClientStyle.composer-button-inset;
                                            sticker-button := IconButton {
                                                icon: @image-url("icons/sticker.svg"); label: "Open sticker picker";
                                                glyph: 22px; enabled: root.composer-enabled;
                                                tint: root.expressions-open && root.expression-tab == 2 ? Theme.text : Theme.secondary;
                                                clicked => {
                                                    root.anchor(emoji-button.absolute-position.x, emoji-button.absolute-position.y, emoji-button.width, emoji-button.height, false);
                                                    root.open-expressions(2);
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: end; padding-bottom: ClientStyle.composer-button-inset;
                                            emoji-button := IconButton {
                                                icon: @image-url("icons/smile.svg"); label: "Add an emoji";
                                                glyph: 22px; enabled: root.composer-enabled;
                                                tint: root.react-item == "yapfast:composer" && (!root.expressions-open || root.expression-tab == 1) ? Theme.text : Theme.secondary;
                                                clicked => {
                                                    root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                    if root.can-pick-gifs {
                                                        root.open-expressions(1);
                                                    } else {
                                                        root.open-picker("yapfast:composer");
                                                    }
                                                }
                                            }
                                        }
                                        if !ClientStyle.enabled: VerticalLayout {
                                            alignment: end; padding-bottom: ClientStyle.composer-button-inset;
                                            IconButton {
                                                icon: @image-url("icons/send-horizontal.svg");
                                                label: root.sending ? "Sending..." : root.is-editing ? "Save" : "Send";
                                                enabled: root.can-send; emphasis: root.can-send;
                                                clicked => { root.send(); }
                                            }
                                        }
                                    }
                                }
                            }
                            // A hint under the field when there is one; otherwise as much
                            // room below it as beside it.
                            if root.composer-hint != "": HorizontalLayout {
                                height: 22px; spacing: 6px; padding-left: 4px;
                                if root.room-encrypted || root.preview: Image { source: @image-url("icons/lock.svg"); width: 12px; image-fit: contain; colorize: Theme.muted; }
                                Text { text: root.composer-hint; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            if root.composer-hint == "": Rectangle { height: ClientStyle.composer-gutter; }
                        }
                    }
                    if root.search-open: SearchPanel {
                        width: 420px;
                        results: root.search-results; heading: root.search-heading; note: root.search-note;
                        more: root.search-more; loading: root.search-loading;
                        jump(room, item) => { root.jump-in-room(room, item); }
                        open-link(link) => { root.open-link(link); }
                        more-results => { root.more-results(); }
                        close => { root.search-text = ""; root.search(""); }
                    }
                    if root.aside-docked && root.new-thread-open: NewThreadPanel {
                        width: root.aside-shown;
                        from-message: root.new-thread-from-message; starter: root.new-thread-starter;
                        name <=> root.new-thread-name; name-placeholder: root.new-thread-placeholder;
                        body <=> root.new-thread-body;
                        can-private: root.new-thread-can-private; only-private: root.new-thread-only-private;
                        private: root.new-thread-private; starting: root.new-thread-starting;
                        error: root.new-thread-error; leaving: root.new-thread-leaving;
                        typing-tick: root.aside-typing-tick;
                        composer-focused => { root.aside-composer-last = true; }
                        escape-composing => { return root.escape-composing(); }
                        init => { self.focus-composer(); }
                        name-edited(text) => { root.new-thread-name-edited(text); }
                        body-edited(text) => { root.new-thread-body-edited(text); }
                        private-changed(private) => { root.set-thread-private(private); }
                        create => { root.create-thread(); }
                        close => { root.close-new-thread(); }
                        leave => { root.leave-new-thread(); }
                        stay => { root.stay-in-new-thread(); }
                        jump-to(item) => { root.jump-to(item); }
                        open-link(link) => { root.open-link(link); }
                    }
                    if root.aside-docked && !root.new-thread-open: ThreadPanel {
                        width: root.aside-shown;
                        name: root.aside-name; messages: root.aside-messages; ready: root.aside-ready;
                        loading: root.aside-loading; start: root.aside-start; failed: root.aside-failed;
                        focus-tick: root.aside-focus-tick;
                        typing-tick: root.aside-typing-tick;
                        composer-focused => { root.aside-composer-last = true; }
                        escape-composing => { return root.escape-composing(); }
                        busy: root.busy; bot-busy-item: root.bot-busy-item; bot-failed-item: root.bot-failed-item; bot-failed-text: root.bot-failed-text; composer-enabled: root.aside-composer-enabled; can-send: root.aside-can-send;
                        reactions-enabled: root.aside-reactions-enabled; new-reactions-enabled: root.aside-new-reactions-enabled;
                        sending: root.sending; compose-label: root.aside-compose-label; draft <=> root.aside-draft;
                        reply-ping: root.aside-reply-ping; toggle-reply-ping => { root.aside-toggle-reply-ping(); }
                        staged: root.aside-staged; can-attach: root.aside-can-attach; can-mark-spoilers: root.aside-can-mark-spoilers;
                        paste-tick: root.aside-paste-tick;
                        attach => { root.aside-attach(); }
                        unstage(index) => { root.aside-unstage(index); }
                        toggle-spoiler(index) => { root.aside-toggle-spoiler(index); }
                        paste => { root.aside-paste(); }
                        emoji-font: root.emoji-font; message-font-size: root.message-font-size; bar-reactions: root.bar-reactions;
                        active-item <=> root.active-item; react-item: root.react-item; menu-item: root.menu-item; confirm-delete: root.confirm-delete;
                        shift-held: root.shift-held;
                        forward-allowed: root.forward-allowed;
                        pin-message(item) => { root.pin-message(item); }
                        start-forward(item) => { root.start-forward(item); }
                        delete-now(item) => { root.delete-now(item); }
                        close => { root.aside-close(); }
                        expand => { root.aside-expand(); }
                        more(x, y) => { root.open-context-menu("thread-sidebar:" + root.aside-room, false, x, y); }
                        earlier => { root.aside-earlier(); }
                        draft-edited(text) => { root.aside-draft-edited(text); }
                        caret-tick: root.aside-caret-tick; caret-offset: root.aside-caret-offset;
                        mentions: root.suggesting-aside ? root.mentions : [];
                        mention-index: root.mention-index;
                        emoji-suggestions: root.suggesting-aside ? root.emoji-suggestions : [];
                        emoji-suggestion-query: root.emoji-suggestion-query;
                        emoji-suggestion-index: root.emoji-suggestion-index;
                        caret(text, offset) => { root.aside-composer-caret(text, offset); }
                        suggestion-moved(step) => {
                            if root.mentions.length > 0 {
                                root.mention-index = Math.mod(root.mention-index + step + root.mentions.length, root.mentions.length);
                            } else {
                                root.emoji-suggestion-index = Math.mod(root.emoji-suggestion-index + step + root.emoji-suggestions.length, root.emoji-suggestions.length);
                            }
                        }
                        suggestion-chosen => {
                            if root.mentions.length > 0 { root.mention-chosen(root.mention-index); }
                            else { root.emoji-suggestion-chosen(root.emoji-suggestion-index); }
                        }
                        suggestion-dismissed => {
                            if root.mentions.length > 0 { root.mention-dismissed(); } else { root.emoji-suggestion-dismissed(); }
                        }
                        mention-chosen(index) => { root.mention-chosen(index); }
                        emoji-suggestion-chosen(index) => { root.emoji-suggestion-chosen(index); }
                        send => { root.aside-send(); }
                        cancel-compose => { root.aside-cancel-compose(); }
                        viewport(top, bottom) => { root.aside-viewport(top, bottom); }
                        reply(item) => { root.reply(item); }
                        edit(item) => { root.edit(item); }
                        react(item, key) => { root.react(item, key); }
                        open-picker(item, x, y, width, height) => { root.anchor(x, y, width, height, false); root.open-picker(item); }
                        open-menu(message, x, y, width, height) => { root.anchor(x, y, width, height, width == 0px); root.open-menu(message); root.menu-aside = true; root.aside-composer-last = true; }
                        open-media-menu(message, index, video, x, y) => { root.anchor(x, y, 0px, 0px, true); root.open-message-menu(message, index, video); root.menu-aside = true; root.aside-composer-last = true; }
                        confirm-delete-message => { root.confirm-delete-message(); }
                        cancel-delete => { root.cancel-delete(); }
                        author-card(item, sender, x, y, width, height) => { root.author-card(item, sender, x, y, width, height); }
                        author-menu(item, sender, x, y) => { root.author-menu(item, sender, x, y); }
                        jump-to(item) => { root.jump-to(item); }
                        link-clicked(link, x, y) => { root.anchor(x, y, 0px, 0px, true); root.open-link(link); }
                        open-link(link) => { root.open-link(link); }
                        use-button(item, id) => { root.use-button(item, id); }
                        open-select(item, id) => { root.open-select(item, id); }
                        open-thread(room) => { root.open-aside(room); }
                        retry(item) => { root.retry(item); }
                        cancel-send(item) => { root.cancel-send(item); }
                        reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                        view-image(id, index) => { root.view-image(id, index); }
                        open-sticker(item, index, x, y, width, height) => {
                            root.anchor(x, y, width, height, false);
                            root.open-sticker(item, index);
                        }
                        save-attachment(id, index) => { root.save-attachment(id, index); }
                        collapse-long: root.collapse-long;
                        fold(item, whole) => { root.fold-message(item, whole); }
                    }
                    if root.members-docked: MemberPanel {
                        width: ClientStyle.members-width; rows: root.roster; activity-rows: root.roster-activity; note: root.roster-note; selected: root.profile-member; boost-gems: root.boost-gems;
                        activity-hidden <=> root.activity-cards-hidden;
                        activity-hidden-toggled(hidden) => { root.activity-cards-hidden-toggled(hidden); }
                        activity-clock => { root.activity-clock(); }
                        open-profile(id, y) => { root.profile-y = y; root.profile-at-pointer = false; root.show-profile(id); }
                        open-member-menu(id, x, y) => { root.open-context-menu(id, true, x, y); }
                    }
                    if root.profile-docked: Rectangle {
                        width: ClientStyle.profile-width;
                        ProfileCard {
                            x: ClientStyle.profile-inset; y: ClientStyle.profile-inset;
                            docked: true; width: parent.width - 2 * ClientStyle.profile-inset; height: parent.height - 2 * ClientStyle.profile-inset;
                            data: root.panel-profile;
                            enlarge => { root.enlarge-panel-profile(); }
                            befriend => { root.befriend(root.panel-profile.id); }
                            more(x, y) => { root.open-context-menu("profile-more:" + root.panel-profile.id, true, x, y); }
                            send-message(text) => { root.message-from-profile(root.panel-profile.id, text); }
                            edit-profile => { root.edit-profile(); }
                            open-link(link) => { root.open-link(link); }
                            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
                            open-friend(id, x, y, width, height) => {
                                root.anchor(x, y, width, height, false);
                                root.profile-at-pointer = true;
                                root.show-friend-profile(id, false);
                            }
                        }
                    }
                }
            }
            // The window's top outline carries on over the conversation to its right edge.
            if ClientStyle.enabled: Rectangle { y: 0px; height: 1px; background: Theme.outline; }
            // The header casts a soft shadow over the conversation.
            if !ClientStyle.enabled: Rectangle {
                y: 48px; height: 6px;
                background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
            }
        }
    }
    // The edge between sidebar and conversation resizes the sidebar. A double-click
    // restores the default width.
    if root.workspace: TouchArea {
        x: 72px + root.sidebar-shown - 4px; y: root.title-height; width: 8px; height: root.height - root.title-height;
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.sidebar-width = max(180px, min(380px, root.width - 72px - 420px - root.docked-width, root.sidebar-shown + self.mouse-x - self.pressed-x));
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up { root.sidebar-resized(root.sidebar-shown); }
        }
        double-clicked => { root.sidebar-width = ClientStyle.sidebar-width; root.sidebar-resized(root.sidebar-width); }
        Rectangle {
            x: 3px; width: 2px;
            background: parent.pressed ? Theme.faint : Theme.line;
            opacity: parent.has-hover || parent.pressed ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }
    // So does the edge of the thread beside the conversation, below the header.
    if root.workspace && root.aside-docked: TouchArea {
        x: root.width - root.aside-shown - 4px; y: root.title-height + ClientStyle.header-height; width: 8px; height: root.height - root.title-height - ClientStyle.header-height;
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.aside-width = max(320px, min(800px, root.width - 72px - root.sidebar-shown - 420px, root.aside-shown - (self.mouse-x - self.pressed-x)));
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up { root.aside-resized(root.aside-shown); }
        }
        double-clicked => { root.aside-width = 420px; root.aside-resized(420px); }
        Rectangle {
            x: 3px; width: 2px;
            background: parent.pressed ? Theme.faint : Theme.line;
            opacity: parent.has-hover || parent.pressed ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }

    // The stream being watched, this account's own or a camera, in a corner
    // while the call is off screen; see StreamPip. It starts at the top right
    // of the conversation and stays in the corner it's dragged nearest.
    property <bool> call-on-screen: root.voice-here && (root.voice-panel || root.call-shown);
    property <bool> pip-left;
    property <bool> pip-bottom;
    if root.pip-shown: StreamPip {
        property <length> left: 72px + root.sidebar-shown + 16px;
        property <length> right: root.width - self.width - 16px;
        property <length> top: root.title-height + ClientStyle.header-height + 16px;
        property <length> bottom: root.height - self.height - 16px;
        x: (root.pip-left ? self.left : self.right) + self.drag-x;
        y: (root.pip-bottom ? self.bottom : self.top) + self.drag-y;
        animate x, y { duration: self.dragging ? 0ms : 180ms; easing: ease-out; }
        title: root.pip-kind == 1 ? root.watch-title : root.pip-kind == 2 ? "Your screen" : root.participants[root.pip-person].name;
        status: root.pip-kind == 1 ? root.watch-status : root.pip-kind == 2 ? root.share-status : "";
        frame: root.pip-kind == 1 ? root.watch-frame : root.pip-kind == 2 ? root.share-frame : root.participant-frames[root.pip-person];
        live: root.pip-kind == 2 && root.share-live;
        stop-icon: root.pip-kind == 1 ? @image-url("icons/x.svg") : @image-url("icons/screen-share-off.svg");
        stop-label: root.pip-kind == 1 ? "Stop watching" : root.pip-kind == 2 ? "Stop sharing" : "";
        viewers: root.pip-kind == 1 ? root.watch-viewers : root.pip-kind == 2 ? root.share-viewers : [];
        viewer-names: root.pip-kind == 1 ? root.watch-viewer-names : root.pip-kind == 2 ? root.share-viewer-names : "";
        open-call => {
            root.focus-tile(root.pip-slot);
            root.open-conversation(root.voice-channel);
        }
        stop => { if root.pip-kind == 1 { root.stop-watching(); } else if root.pip-kind == 2 { root.toggle-share(); } }
        dropped => {
            root.pip-left = self.x + self.width / 2 < (self.left + self.right + self.width) / 2;
            root.pip-bottom = self.y + self.height / 2 >= (self.top + self.bottom + self.height) / 2;
            self.drag-x = 0px;
            self.drag-y = 0px;
        }
    }

    // The call's large tile over the whole window, in full screen, until
    // Escape, its button or a double click.
    if root.stage-full && root.voice-active && root.call-focus >= 0: Rectangle {
        background: #000000;
        TouchArea { }
        FocusScope {
            width: parent.width; height: parent.height;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.stage-full = false; return accept; }
                return reject;
            }
            ParticipantGrid {
                width: parent.width; height: parent.height;
                full: true;
                participants: root.participants; frames: root.participant-frames;
                camera-starting: root.camera-starting; sharing: root.sharing; share-live: root.share-live;
                share-status: root.share-status; share-frame: root.share-frame;
                share-viewers: root.share-viewers; share-viewer-names: root.share-viewer-names;
                stream-tiles: root.stream-tiles; watch-user: root.watch-user; watch-frame: root.watch-frame;
                watch-status: root.watch-status; watch-viewers: root.watch-viewers; watch-viewer-names: root.watch-viewer-names;
                focused: root.call-focus;
                full-screen(on) => { root.stage-full = on; }
                stop-watching => { root.stop-watching(); }
                open-volume(person, x, y) => { root.open-voice-menu(root.voice-channel, person, x, y); }
                tiles(columns, width, height, gap, top, scrolled, shown, focused, focus-width, focus-height) => {
                    root.call-tiles(columns, width, height, gap, top, scrolled, shown, focused, focus-width, focus-height);
                }
            }
        }
    }

    // A call ringing this account elsewhere, at the top until it's answered or stops.
    if root.incoming-open: IncomingCall {
        x: (root.width - self.width) / 2; y: root.title-height + 64px;
        incoming-room: root.incoming-room; incoming-name: root.incoming-name; incoming-detail: root.incoming-detail;
        incoming-initial: root.incoming-initial; incoming-tint: root.incoming-tint; incoming-picture: root.incoming-picture;
        answer-call(room, accept) => { root.answer-call(room, accept); }
    }

    property <bool> switching: root.switch-prompt != "";
    property <string> switch-text;
    changed switch-prompt => { if root.switch-prompt != "" { root.switch-text = root.switch-prompt; } }
    changed switching => { if root.switching { switch-dialog.focus-keys(); } else { switch-dialog.release-keys(); } }
    // Switching voice channels asks first; see SwitchDialog.
    switch-dialog := SwitchDialog {
        switching: root.switching; switch-text: root.switch-text; joins: root.switch-joins;
        cancel-switch => { root.cancel-switch(); }
        confirm-switch => { root.confirm-switch(); }
    }
    // Mention suggestions, just above the composer and as wide as it, over a
    // reply's or an edit's bar; see MentionList.
    if root.mentions.length > 0 && root.composer-enabled && !root.suggesting-aside: MentionList {
        x: composer-box.absolute-position.x;
        width: composer-box.width;
        y: composer-box.absolute-position.y - (root.compose-label != "" ? 36px : 0px) - self.height - 8px;
        mentions: root.mentions; mention-index: root.mention-index;
        mention-chosen(index) => { root.mention-chosen(index); }
    }
    // Emoji suggestions, in the same place; see EmojiSuggestions.
    if root.emoji-suggestions.length > 0 && root.mentions.length == 0 && root.composer-enabled && !root.suggesting-aside: EmojiSuggestions {
        x: composer-box.absolute-position.x;
        width: composer-box.width;
        y: composer-box.absolute-position.y - (root.compose-label != "" ? 36px : 0px) - self.height - 8px;
        emoji: root.emoji-suggestions; query: root.emoji-suggestion-query;
        emoji-index: root.emoji-suggestion-index; emoji-font: root.emoji-font;
        emoji-chosen(index) => { root.emoji-suggestion-chosen(index); }
    }
    // Settings over the window, showing one section.
    settings-motion := PopupMotion { open: root.settings-open; }
    if settings-motion.shown: SettingsScreen {
        y: ClientStyle.enabled ? 0px : root.title-height; height: root.height - self.y;
        motion: settings-motion.amount;
        account-name: root.account-name; account-initial: root.account-initial;
        account-tint: root.account-tint; account-picture: root.account-picture;
        may-edit-profile: root.discord-linked;
        edit-profile => { root.settings-open = false; root.edit-profile(); }
        settings-section <=> root.settings-section;
        discord-build: root.discord-build; preview: root.preview;
        close => { root.settings-open = false; }
        refresh-devices => { root.refresh-devices(); }
        copy-text(text) => { root.copy-text(text); }
        if root.settings-section == 0: AccountSettings {
            account-name: root.account-name; account-status: root.account-status; account-status-emoji: root.account-status-emoji;
            account-initial: root.account-initial; account-tint: root.account-tint; account-picture: root.account-picture;
            storage: root.storage; preview: root.preview; online: root.online; busy: root.busy; sending: root.sending;
            discord-linked: root.discord-linked; has-custom-status: root.has-custom-status;
            retry-sync => { root.retry-sync(); }
            set-custom-status => { root.settings-open = false; root.open-status(); }
            edit-profile => { root.settings-open = false; root.edit-profile(); }
            sign-out => { root.settings-open = false; root.logout(); }
        }
        if root.settings-section == 7: AppearanceSettings {
            themes: root.themes; theme-id: root.theme-id;
            editor: root.theme-editor; colours: root.theme-colours;
            theme-name <=> root.theme-name; theme-dark <=> root.theme-dark;
            editing-saved: root.theme-editing-saved; starts: root.theme-starts; start-index: root.theme-start;
            can-save: root.theme-can-save;
            system-title-bar <=> root.system-title-bar; title-bar-choice: root.title-bar-choice;
            title-bar-toggled => { root.title-bar-toggled(); }
            show-nameplates <=> root.show-nameplates;
            preferences-changed => { root.preferences-changed(); }
            choose-theme(id) => { root.choose-theme(id); }
            new-theme => { root.new-theme(); }
            edit-theme(id) => { root.edit-theme(id); }
            start-chosen(index) => { root.theme-start-chosen(index); }
            colour-edited(index, text) => { root.theme-colour-edited(index, text); }
            dark-toggled(dark) => { root.theme-dark-toggled(dark); }
            save-theme => { root.save-theme(); }
            cancel-theme => { root.cancel-theme(); }
            delete-theme => { root.delete-theme(); }
        }
        if root.settings-section == 1: VoiceSettings {
            microphones: root.microphones; microphone-index <=> root.microphone-index;
            speakers: root.speakers; speaker-index <=> root.speaker-index;
            cameras: root.cameras; camera-index <=> root.camera-index;
            camera-testing <=> root.camera-testing; camera-preview: root.camera-preview; camera-note: root.camera-note;
            unmute-on-join <=> root.unmute-on-join; level-voice <=> root.level-voice;
            noise-suppression <=> root.noise-suppression; noise-strength <=> root.noise-strength; dereverb <=> root.dereverb; discord: root.discord-linked;
            windows-effects <=> root.windows-effects; windows-effects-choice: root.windows-effects-choice;
            sensitivity <=> root.sensitivity; gate-level: root.gate-level; gate-sending: root.gate-sending; gate-meter-note: root.gate-meter-note;
            input-mode <=> root.input-mode; talk-key: root.talk-key; talk-recording <=> root.talk-recording;
            talk-delay <=> root.talk-delay; talk-note: root.talk-note;
            microphone-volume <=> root.microphone-volume; speaker-volume <=> root.speaker-volume;
            soundboard-volume <=> root.soundboard-volume; entrance-servers: root.entrance-servers;
            entrance-server <=> root.entrance-server; entrance-sound: root.entrance-sound;
            entrance-rows: root.entrance-rows; nitro: root.discord-nitro; emoji-font: root.emoji-font;
            soundboard-volume-committed(value) => { root.soundboard-volume-committed(value); }
            entrance-sounds-wanted => { root.entrance-sounds-wanted(); }
            entrance-server-chosen(index) => { root.entrance-server-chosen(index); }
            choose-entrance-sound(id) => { root.choose-entrance-sound(id); }
            call-volumes-changed => { root.call-volumes-changed(); }
            record-talk-key(on) => { root.record-talk-key(on); }
            select-microphone(index) => { root.select-microphone(index); }
            select-speaker(index) => { root.select-speaker(index); }
            select-camera(index) => { root.select-camera(index); }
            refresh-devices => { root.refresh-devices(); }
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 2: MessageSettings {
            message-font-size: root.message-font-size;
            twelve-hour-clock <=> root.twelve-hour-clock; clock-seconds <=> root.clock-seconds; date-format <=> root.date-format; text-size <=> root.text-size;
            link-previews <=> root.link-previews; boost-gems <=> root.boost-gems; share-typing <=> root.share-typing;
            animate <=> root.animate;
            reply-ping <=> root.reply-ping-default; strip-tracking <=> root.strip-tracking;
            collapse-long <=> root.collapse-long;
            matrix: root.matrix-build; discord: root.discord-linked;
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 3: NotificationSettings {
            notifications <=> root.notifications; notification-text <=> root.notification-text;
            flash-taskbar <=> root.flash-taskbar;
            matrix: root.matrix-build; discord: root.discord-linked;
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 5: SoundSettings {
            sound-set <=> root.sound-set; volume <=> root.sound-volume;
            adjust-each <=> root.adjust-each-sound; each: root.each-sound;
            preferences-changed => { root.preferences-changed(); }
            each-changed(index, percent) => { root.each-sound-changed(index, percent); }
            play(index) => { root.play-sound(index); }
        }
        if root.settings-section == 6: AdvancedSettings {
            gpu-rendering <=> root.gpu-rendering; gpu-running: root.gpu-running;
            gpu-encoding <=> root.gpu-encoding;
            close-to-tray <=> root.close-to-tray; tray-available: root.tray-available;
            multiple-windows <=> root.multiple-windows;
            developer-mode <=> root.developer-mode;
            start-on-sign-in <=> root.start-on-sign-in; autostart-available: root.autostart-available;
            discord-links <=> root.discord-links; discord-links-available: root.discord-links-available;
            preferences-changed => { root.preferences-changed(); }
            restart => { root.restart(); }
        }
        if root.settings-section == 9: AboutSettings {
            copy-text(text) => { root.copy-text(text); }
        }
        if root.settings-section == 8: GameActivitySettings {
            shown: root.show-game; linked: root.discord-linked; executables: root.game-executables;
            toggled(shown) => { root.show-game-toggled(shown); }
            save(index, executable, text) => { return root.save-game-executable(index, executable, text); }
            remove(index) => { root.remove-game-executable(index); }
        }
        if root.settings-section == 4 && !root.discord-linked: DiscordLinkSettings {
            link-phase: root.link-phase; link-code: root.link-code; link-name: root.link-name; link-note: root.link-note;
            link-discord => { root.link-discord(); }
            link-discord-token(token) => { root.link-discord-token(token); }
            open-discord-captcha => { root.open-discord-captcha(); }
        }
        if root.settings-section == 4 && root.discord-linked: DiscordSettings {
            matrix-build: root.matrix-build;
            show-hidden-channels: root.show-hidden-channels; sync-discord-reads: root.sync-discord-reads;
            show-idle: root.show-idle;
            unlink-discord => { root.unlink-discord(); }
            show-idle-toggled(shown) => { root.show-idle = shown; root.show-idle-toggled(shown); }
            hide-blocked: root.hide-blocked;
            hide-blocked-toggled(hide) => { root.hide-blocked = hide; root.hide-blocked-toggled(hide); }
            blocked: root.blocked-people;
            unblock(id) => { root.unblock(id); }
            show-hidden-channels-toggled(shown) => { root.show-hidden-channels = shown; root.show-hidden-channels-toggled(shown); }
            sync-discord-reads-toggled(sync) => { root.sync-discord-reads = sync; root.sync-discord-reads-toggled(sync); }
        }
    }
    // A Discord server's settings, and a channel's, on the same card.
    server-settings-motion := PopupMotion { open: root.server-settings-open; }
    if server-settings-motion.shown: ServerSettingsScreen {
        motion: server-settings-motion.amount;
        y: root.title-height; height: root.height - root.title-height;
        prompt: root.server-settings-prompt;
        name <=> root.server-settings-name; description <=> root.server-settings-description;
        role-name <=> root.server-settings-role-name;
        choose(section) => { root.server-settings-section(section); }
        role(what, text, number) => { root.role-input(what, text, number); }
        ban(what, text, number) => { root.ban-input(what, text, number); }
        audit-log(what, number) => { root.audit-log-input(what, number); }
        member(what, text, number) => { root.members-input(what, text, number); }
        invite(what, text, number) => { root.invites-input(what, text, number); }
        emoji(what, id, name) => { root.emoji-input(what, id, name); }
        sticker(what, text) => { root.stickers-input(what, text); }
        ownership(what, text) => { root.ownership-input(what, text); }
        member-menu(id, x, y) => { root.open-context-menu(id, true, x, y); }
        write(field, text) => { root.write-server-setting(field, text); }
        toggle(which) => { root.toggle-server-setting(which); }
        pick-choice(list, index) => { root.choose-server-setting(list, index); }
        pick-picture(kind) => { root.pick-server-picture(kind); }
        remove-picture(kind) => { root.remove-server-picture(kind); }
        undo => { root.undo-server-settings(); }
        save => { root.save-server-settings(); }
        close => { root.close-server-settings(); }
    }
    channel-settings-motion := PopupMotion { open: root.channel-settings-open; }
    if channel-settings-motion.shown: ChannelSettingsScreen {
        motion: channel-settings-motion.amount;
        y: root.title-height; height: root.height - root.title-height;
        prompt: root.channel-settings-prompt; channel: root.channel-settings-channel;
        name <=> root.channel-settings-name; topic <=> root.channel-settings-topic;
        input(what, text, number) => { root.channel-settings-input(what, text, number); }
    }
    // A server channel's topic in full, under the header's line of it.
    // Escape or a click outside closes it.
    topic-motion := PopupMotion { open: root.topic-open && root.has-topic; }
    if topic-motion.shown: Rectangle {
        TouchArea { clicked => { root.topic-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.topic-open = false; return accept; }
                return reject;
            }
        }
        TopicPopover {
            opacity: Popup.opacity(topic-motion.amount); transform-scale: Popup.scale(topic-motion.amount);
            x: max(8px, min(root.width - self.width - 8px, root.popover-x));
            y: root.popover-y + 6px;
            most: min(400px, root.height - self.y - 16px);
            name: root.room-name; topic: root.room-topic-full;
            open-link(link) => { root.open-link(link); }
            close => { root.topic-open = false; }
        }
    }
    // The open DM's pinned messages, under the pin button. Jumping to one
    // closes them, as does Escape or a click outside.
    pins-motion := PopupMotion { open: root.pins-open; }
    if pins-motion.shown: Rectangle {
        TouchArea { clicked => { root.show-pins(false); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.show-pins(false); return accept; }
                return reject;
            }
        }
        PinsPopover {
            opacity: Popup.opacity(pins-motion.amount); transform-scale: Popup.scale(pins-motion.amount);
            x: max(8px, min(root.width - self.width - 8px, root.popover-x - self.width));
            y: root.popover-y + 6px;
            // As tall as its pins, up to 560px, within the window.
            height: min(self.fit, 560px, root.height - self.y - 16px);
            pins: root.pins; note: root.pins-note;
            jump(item) => { root.show-pins(false); root.jump-to(item); }
            open-link(link) => { root.open-link(link); }
            close => { root.show-pins(false); }
        }
    }
    // The open channel's threads, under the Threads button. Opening one
    // closes them, as does Escape or a click outside.
    threads-motion := PopupMotion { open: root.threads-open; }
    if threads-motion.shown: Rectangle {
        TouchArea { clicked => { root.show-threads(false); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.show-threads(false); return accept; }
                return reject;
            }
            ThreadsPopover {
                opacity: Popup.opacity(threads-motion.amount); transform-scale: Popup.scale(threads-motion.amount);
                x: max(8px, min(root.width - self.width - 8px, root.popover-x - self.width));
                y: root.popover-y + 6px;
                // As Discord's: 35% of the window wide, from 480px to 600px,
                // and as tall as its rows, from 400px to 80% of the window.
                width: min(max(480px, root.width * 35%), 600px, root.width - 16px);
                height: min(max(400px, self.fit), root.height * 80%, root.height - self.y - 16px);
                rows: root.thread-rows; headings: root.threads-headings;
                note: root.threads-note; empty: root.threads-empty;
                searchable: root.threads-searchable; query <=> root.threads-query;
                more: root.threads-more; loading: root.threads-loading; can-create: root.threads-can-create;
                search(text) => { root.search-threads(text); }
                create(from) => { root.new-thread("", from); }
                // Opening first, as it may use what the list found.
                open(room, beside) => { root.open-listed-thread(room, beside); root.show-threads(false); }
                more-threads => { root.more-threads(); }
                close => { root.show-threads(false); }
            }
        }
    }
    // Friends to add to the open DM, under the add button.
    add-people-motion := PopupMotion { open: root.add-people-open; }
    if add-people-motion.shown: Rectangle {
        TouchArea { clicked => { root.close-add-people(); } }
        AddPeoplePopover {
            opacity: Popup.opacity(add-people-motion.amount); transform-scale: Popup.scale(add-people-motion.amount);
            x: max(8px, min(root.width - self.width - 8px, root.popover-x - self.width));
            y: root.popover-y + 6px;
            height: min(520px, root.height - self.y - 16px);
            query <=> root.add-people-query; people: root.add-people;
            room: root.add-people-room; chosen: root.add-people-chosen;
            one-to-one: root.add-people-one-to-one; adding: root.add-people-adding; note: root.add-people-note;
            query-edited => { root.add-people-search(); }
            choose(id) => { root.choose-person(id); }
            add => { root.confirm-add-people(); }
            close => { root.close-add-people(); }
        }
    }
    // A role mentioned in a message: who Yapfast knows has it. Clicking someone opens
    // their card over it; Escape or a click outside closes it.
    role-motion := PopupMotion { open: root.role-open; }
    if role-motion.shown: Rectangle {
        TouchArea { clicked => { root.close-role(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-role(); return accept; }
                return reject;
            }
        }
        RoleCard {
            opacity: Popup.opacity(role-motion.amount); transform-scale: Popup.scale(role-motion.amount);
            x: root.beside(root.role-x, root.role-width, self.width);
            y: max(root.title-height + 8px, min(root.height - self.height - 8px, root.role-y - 8px));
            limit: root.height - root.title-height - 16px;
            role-name: root.role-name; role-color: root.role-color; role-has-color: root.role-has-color;
            role-members: root.role-members; role-note: root.role-note;
            open-member(id, x, y, width, height) => {
                root.anchor(x, y, width, height, true);
                root.profile-at-pointer = true;
                root.show-profile(id);
            }
            choose-member(id) => { root.profile-at-pointer = true; root.show-profile(id); }
        }
    }
    // A member's card, beside the member list. Escape or a click outside closes it.
    // A card closed from the keyboard goes from under the pointer, which then
    // never leaves its badge to hide the tooltip.
    profile-motion := PopupMotion {
        open: root.profile-open && !root.profile-large;
        changed shown => { root.hide-badge-tips(); }
    }
    if profile-motion.shown: Rectangle {
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileCard {
            opacity: Popup.opacity(profile-motion.amount); transform-scale: Popup.scale(profile-motion.amount);
            width: 300px; limit: root.height - root.title-height - 16px;
            x: root.profile-at-pointer
                ? root.beside(root.anchor-x, root.anchor-width, self.width)
                : root.width - ClientStyle.members-width - 8px - self.width;
            y: max(root.title-height + 8px, min(root.height - self.height - 8px, (root.profile-at-pointer ? root.anchor-y - 8px : root.profile-y - 16px)));
            data: root.profile;
            enlarge => { root.enlarge-profile(); }
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            more(x, y) => { root.open-context-menu("profile-more:" + root.profile.id, true, x, y); }
            open-link(link) => { root.open-link(link); }
            send-message(text) => { root.message-from-profile(root.profile.id, text); }
            edit-profile => { root.close-profile(); root.edit-profile(); }
        }
    }
    // A full profile over the window, as the viewer shows images.
    large-profile-motion := PopupMotion {
        open: root.profile-open && root.profile-large;
        changed shown => { root.hide-badge-tips(); }
    }
    if large-profile-motion.shown: Rectangle {
        background: rgba(0, 0, 0, 0.7 * large-profile-motion.amount);
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileModal {
            opacity: Popup.opacity(large-profile-motion.amount); transform-scale: Popup.scale(large-profile-motion.amount);
            width: min(max(root.width * 0.7, 720px), root.width - 32px); height: min(max(root.height * 0.75, 520px), root.height - 32px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            data: root.profile;
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            message-person(user) => { root.close-profile(); root.message-person(user); }
            save-note(user, note) => { root.save-note(user, note); }
            more(x, y) => { root.open-context-menu("profile-more:" + root.profile.id, true, x, y); }
            open-link(link) => { root.open-link(link); }
            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
            // In the full profile, a friend's opens full too.
            open-friend(id, x, y, width, height) => { root.show-friend-profile(id, true); }
            tab-opened(page) => { root.profile-tab-opened(page); }
            edit-profile => { root.close-profile(); root.edit-profile(); }
        }
    }
    // A mutual server's card, over the profile that lists it. Clicking
    // outside or Escape closes it.
    server-card-motion := PopupMotion { open: root.server-card-open; }
    if server-card-motion.shown: Rectangle {
        TouchArea { clicked => { root.server-card-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.server-card-open = false; return accept; }
                return reject;
            }
        }
        ServerCard {
            opacity: Popup.opacity(server-card-motion.amount); transform-scale: Popup.scale(server-card-motion.amount);
            width: 300px;
            x: root.beside(root.anchor-x, root.anchor-width, self.width);
            y: max(root.title-height + 8px, min(root.height - self.height - 8px, root.anchor-y - 8px));
            server: root.server-card;
            open => {
                root.server-card-open = false;
                root.close-profile();
                root.navigate-server(root.server-card.id);
            }
        }
    }
    // An emoji's card, under the emoji a message's text was clicked on. A click
