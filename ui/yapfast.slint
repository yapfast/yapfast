    property <length> anchor-y;
    property <length> anchor-width;
    property <length> anchor-height;
    property <bool> anchor-pointer;
    function anchor(x: length, y: length, width: length, height: length, pointer: bool) {
        root.anchor-x = x; root.anchor-y = y; root.anchor-width = width; root.anchor-height = height;
        root.anchor-pointer = pointer;
    }
    // The picker's width, which its left edge drags wider: 498px unless
