import { AccountPopover } from "yapfast/account-popover.slint";
import { ClientStyle } from "yapfast/style.slint";
import { WindowBar } from "yapfast/window-bar.slint";
import { Palette } from "std-widgets.slint";
import { ListView, Autoscroll, AutoscrollMarker } from "scrollview.slint";
// The UI's typeface, Atkinson Hyperlegible Next; ExtraBold serves weight 900.
import "fonts/DMSans[opsz,wght].ttf";
import "fonts/DMSans-Italic[opsz,wght].ttf";
import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-Italic.ttf";
import "fonts/AtkinsonHyperlegibleNext-Medium.ttf";
import "fonts/AtkinsonHyperlegibleNext-Bold.ttf";
import "fonts/AtkinsonHyperlegibleNext-BoldItalic.ttf";
import "fonts/AtkinsonHyperlegibleNext-ExtraBold.ttf";
// The fonts of Discord's eleven display name styles; see fonts/README.md.
import "fonts/DisplayName-Sakura.ttf";
import "fonts/DisplayName-Jellybean.ttf";
import "fonts/DisplayName-Modern.ttf";
import "fonts/DisplayName-Medieval.otf";
import "fonts/DisplayName-8Bit.ttf";
import "fonts/DisplayName-Vampyre.ttf";
import "fonts/DisplayName-Tempo.ttf";
import "fonts/DisplayName-MonkeyBars.ttf";
import "fonts/DisplayName-Mainframe.ttf";
import "fonts/DisplayName-Headbang.ttf";
import "fonts/DisplayName-Journal.ttf";
// The second choice, Satoshi, isn't in the repository (fonts/README.md): to
// switch back, download it into fonts/, import these instead, set
// `default-font-family` below to "Satoshi", and use Satoshi's metrics in
// src/emoji_font.rs.
// import "fonts/Satoshi-Regular.ttf";
// import "fonts/Satoshi-Italic.ttf";
// import "fonts/Satoshi-Medium.ttf";
// import "fonts/Satoshi-Bold.ttf";
// import "fonts/Satoshi-BoldItalic.ttf";
// import "fonts/Satoshi-Black.ttf";

// Yapfast's window. Its parts live beside it, by area: theme.slint, controls.slint,
// discord.slint, voice.slint, rail.slint, composer.slint, messages.slint,
// settings.slint, people.slint, friends.slint, dialogs.slint and sign-in.slint.
import { Theme, Tip, BadgeTip, ReactionHover, Middle, Popup, PopupMotion, Twemoji } from "theme.slint";
import { TitleBar, ResizeEdges } from "title_bar.slint";
import { InboxRow, InboxPopout } from "yapfast/inbox.slint";
import { GifPicker, GifTile, PickerTab } from "gifs.slint";
import { StickerPicker, StickerGridTile } from "stickers.slint";
import { ActionButton, IconButton, Motion, PingToggle, DeviceToggle, Avatar, TextField, MessagesSkeleton, ContextMenu, MenuItem, MenuRow, QuickDeviceMenu, HeaderToggle, Banner, StatusText, Nameplate, AccountLook, PictureStore } from "controls.slint";
import { PersonRow, CallLink, CallLinkCard, LinkTouch, SignalIcon, VoiceDock, StreamPip, CallInvite, JoinVoice, ParticipantGrid, CallControls, IncomingCall, SwitchDialog, InputLevel, ShareMenu, ShareScreen, VolumeMenu, Soundboard, SoundRow } from "voice.slint";
import { ServerRow, RoomRow, StatusDot, ServerRail, ServerHeader, RoomList } from "rail.slint";
import { StagedFile, StagedTile, Composer, MentionRow, MentionList, EmojiSuggestions, RequestBar } from "composer.slint";
import { EmojiCell, EmojiRow, EmojiTile, EmojiSection, RailSection, EmojiCard, EmojiCardView, MessageStickerCard, MessageStickerCardView, MessageRow, ReactionToggle, EmojiButton, EmojiPicker, MessageMenu, MessageGallery, MessageStickers, FileCard, MessageContent, EmbedView, BotTag, NoConversation, ConversationStart, HistoryEdge, UnreadBar, PresentBar, ImageViewer, VideoViewer, VideoPlayer, VoicePlayer, Polls } from "messages.slint";
import { Choices, SettingsRow, SettingsScreen, AccountSettings, AppearanceSettings, ThemeCard, ThemeColour, VoiceSettings, MessageSettings, NotificationSettings, SoundSettings, AdvancedSettings, DiscordLinkSettings, DiscordSettings, BlockedRow, GameActivitySettings, GameExecutable, AboutSettings } from "settings.slint";
import { MemberRow, MemberActivityRow, ProfileData, BadgeTipCard, ProfileServerRow, MemberPanel, ProfileCard, ProfileModal, ServerCard, RoleCard } from "people.slint";
import { RequestRow, FriendRow, FriendsScreen, HeaderTab, RequestsScreen, AddFriendDialog } from "friends.slint";
import { ContactRow, PlaceRow, ReactionPill, ReactorRow, StatusDialog, NewDmDialog, ForwardDialog, QuickSwitcher, ReactionsDialog, StatusMenu, PersonPrompt, PersonDialog, LeavingDialog, PollAnswerDraft, PollDialog } from "dialogs.slint";
import { InvitePrompt, InviteDialog, JoinPrompt, JoinDialog, EventPrompt, EventDialog, GiftPrompt, GiftDialog, OAuthPrompt, OAuthDialog, ChannelPrompt, ChannelDialog, ProfileEditorPrompt, ProfileEditorDialog } from "server.slint";
import { SignInScreen, VerifyBanner } from "sign-in.slint";
import { BoostPicture, BoostPrompt, EngagementPrompt, ServerProfilePrompt, ServerSettingsPrompt, ServerSettingsScreen } from "server_settings.slint";
import { PermissionRow, RoleMemberRow, RoleRow, RoleSwatch, RolesPrompt } from "roles.slint";
import { BansPrompt, SafetyOption, SafetyPrompt } from "moderation.slint";
import { ChannelSettingsPrompt, ChannelSettingsScreen, OverwriteRow, ThreeStateRow } from "channel_settings.slint";
import { MfaChoice, MfaPrompt, MfaDialog } from "mfa.slint";
import { FoundRow, PickRow, ThreadRow, HeaderSearch, PinsPopover, ThreadsPopover, AddPeoplePopover, SearchPanel, TopicPopover } from "header.slint";
import { ThreadPanel, NewThreadPanel } from "thread.slint";
import { BotSelectDialog, BotModalDialog, SelectChoice, ModalField } from "interactions.slint";
import { PostTag, PostRow, PostTagChoice, ForumPanel } from "forum.slint";
import { BrowseRow, BrowseScreen } from "browse.slint";

// Rust sees these, besides YapfastWindow.
export { ClientStyle } from "yapfast/style.slint";
export { BuildInfo, Updates, UpdateStatus } from "yapfast/build-info.slint";
import { NewTags } from "yapfast/new-tags.slint";
export { NewTags } from "yapfast/new-tags.slint";
export { InboxRow } from "yapfast/inbox.slint";
export { Theme, Badges, Popup, Twemoji, Looks } from "theme.slint";
export { Autoscroll } from "scrollview.slint";
export { PersonRow, CallLink, ShareScreen } from "voice.slint";
export { ServerRow, RoomRow, FolderServer } from "rail.slint";
export { PictureStore, EmojiAnimations, Motion, AccountLook, NameStyleRow, NameLetter, EffectLayer, NameStyles } from "controls.slint";
export { ServerTagRow } from "server.slint";
export { ProfileTheme } from "people.slint";
export { StagedFile, MentionRow } from "composer.slint";
export { EmojiCell, EmojiRow, EmojiTile, EmojiSection, RailSection, EmojiCard, MessageStickerCard, EmojiFavorites, ReactionChip, ImageCell, FileCell, EmbedField, EmbedFieldRow, EmbedCard, CardButtonStyle, CardButton, TextBlock, CardRowKind, CardRow, ComponentCard, MessageRow, VideoPlayer, VoicePlayer, PollAction, PollAnswerRow, PollCard, Polls } from "messages.slint";
export { MemberRow, MemberActivityRow, ProfileRole, ProfileRoleRow, ProfileServerRow, ProfileFriendRow, ProfileBadgeRow, ProfileData, ActivityRow, ActivityClock, ProfileGameRow, ProfileWidgetRow, ProfileWishlistRow, ProfileRecentRow } from "people.slint";
export { RequestRow, FriendRow } from "friends.slint";
export { ContactRow, PlaceRow, ReactionPill, ReactorRow, PollAnswerDraft } from "dialogs.slint";
export { FoundRow, PickRow } from "header.slint";
export { GifTile, GifFavorites } from "gifs.slint";
export { SelectChoice, ModalField } from "interactions.slint";

export component YapfastWindow inherits Window {
    /// "Yapfast", or "(3) Yapfast" with mentions and DMs waiting, as a browser
    /// tab's title counts them, so the taskbar shows it.
    in property <string> window-title: "Yapfast";
    title: root.window-title;
    preferred-width: 1120px; preferred-height: 760px;
    min-width: 800px; min-height: 560px;
    /// Yapfast draws the title bar and the edges that resize the window,
    /// rather than the desktop; see docs/chat-ui.md.
    in property <bool> own-title-bar;
    in property <bool> window-maximized;
    no-frame: root.own-title-bar;
    /// How far the title bar moves the window's content down: nothing while
    /// the desktop draws it, or in full screen.
    property <length> title-height: root.own-title-bar && !root.full-screen ? 32px : 0px;
    callback move-window();
    callback resize-window(int);
    callback minimize-window();
    callback maximize-window();
    callback close-window();
    background: Theme.chat;
    default-font-family: ClientStyle.font-family;
    // default-font-family: "Satoshi";
    // Both faces' x-heights are about half their size, small, so text
    // defaults to 16px.
    default-font-size: ClientStyle.text-size;
    // The std-widgets (ComboBoxes) follow only the colour scheme,
    // so it follows the theme.
    property <bool> dark-theme: Theme.dark;
    changed dark-theme => { Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    in property <bool> workspace;
    in property <bool> preview;
    in property <bool> busy;
    in property <bool> trusted;
    in property <bool> online;
    in property <bool> restore-available;
    in property <bool> dms-selected;
    in property <bool> dms-unread;
    in property <string> dms-badge;
    // The dialog for starting a DM: who it found, and whether one is starting.
    // Adding a Discord friend by username: whether the request went, and what to say.
    in property <bool> add-friend-open;
    in property <bool> add-friend-sending;
    in property <string> add-friend-note;
    in property <bool> add-friend-sent;
    in-out property <string> add-friend-name;
    callback open-add-friend;
    callback add-friend(string);
    callback close-add-friend;
    // A dialog from a DM's or a member's menu about its person: what it
    // asks, the note, nickname or reason written, the option picked, and
    // the answer.
    in property <bool> person-open;
    in property <PersonPrompt> person-prompt;
    in-out property <string> person-text;
    callback answer-person(string);
    callback choose-person-option(int);
    callback close-person;
    // The Discord custom status and its dialog. Clear-after picks from
    // never, 30 minutes, an hour, four hours and today.
    in property <bool> has-custom-status;
    in property <bool> status-open;
    in property <bool> status-saving;
    in property <string> status-error;
    in-out property <string> status-text;
    in-out property <EmojiCell> status-emoji;
    in-out property <int> status-clear-after;
    callback open-status;
    /// Set the Discord status: "online", "idle", "dnd" or "invisible".
    callback set-status(string);
    /// The Discord status as its settings keep it, for the status menu.
    in property <string> discord-status;
    callback save-status;
    callback clear-status;
    callback close-status;
    in property <bool> new-dm-open;
    in-out property <string> new-dm-query;
    in property <[ContactRow]> new-dm-people;
    in property <bool> new-dm-starting;
    in property <string> new-dm-note;
    callback open-new-dm;
    callback new-dm-search;
    callback start-dm(int);
    callback close-new-dm;
    in property <string> sidebar-title;
    /// The Discord server whose name heads the sidebar and opens its menu;
    /// empty for DMs and Matrix servers. Its invite button shows when this
    /// account may invite to it.
    in property <string> header-server;
    in property <bool> header-invite;
    /// The server in the header is a Community server.
    in property <bool> header-community;
    /// Verified or partnered: a green badge before the name.
    in property <bool> header-verified;
    /// The address of the server's banner, which fills the top of its sidebar.
    in property <string> header-banner;
    /// How many scheduled events the server has; the "N Events" row opens them.
    in property <int> header-events;
    /// Whether the header's server shows Discord's Events row, which a
    /// Community server has without events.
    in property <bool> header-events-row;
    /// The boosts of the header's server, or -1 where the progress bar
    /// above its channels is off.
    in property <int> header-boosts: -1;
    // A Discord server's or channel's invite dialog: the link, and the
    // choices for another, as indices into each list it offers.
    in property <bool> invite-open;
    in property <InvitePrompt> invite-prompt;
    in-out property <int> invite-age;
    in-out property <int> invite-uses;
    callback open-invite(string);
    callback make-invite(int, int);
    callback close-invite;
    // Join a Server, from the "+" at the foot of the server rail or a
    // clicked invite link; see JoinDialog.
    in property <bool> can-join-server;
    in property <bool> join-open;
    in property <JoinPrompt> join-prompt;
    in-out property <string> join-link;
    callback open-join-server;
    callback find-invite(string);
    callback join-server;
    callback open-join-captcha;
    callback open-join-form;
    callback close-join;
    // An application a clicked authorization link opened; see OAuthDialog.
    in property <bool> oauth-open;
    in property <OAuthPrompt> oauth-prompt;
    in property <[string]> oauth-guilds;
    in property <int> oauth-guild-chosen;
    callback choose-oauth-guild(int);
    callback authorize-oauth;
    callback close-oauth;
    // A gift a clicked gift link opened; see GiftDialog.
    in property <bool> gift-open;
    in property <GiftPrompt> gift-prompt;
    callback redeem-gift;
    callback open-gift-in-browser;
    callback close-gift;
    // A scheduled event a clicked event link opened; see EventDialog.
    in property <bool> event-open;
    in property <EventPrompt> event-prompt;
    callback toggle-event-interest;
    callback close-event;
    // A dialog that makes, copies or deletes a Discord channel or category,
    // with what's written in it; see ChannelDialog.
    in property <bool> channel-open;
    in property <ChannelPrompt> channel-prompt;
    in-out property <string> channel-name;
    in-out property <int> channel-kind;
    callback save-channel;
    callback close-channel;
    // The editor of this account's Discord profile, its main one or a
    // server's; see ProfileEditorDialog.
    in property <bool> profile-editor-open;
    in property <ProfileEditorPrompt> profile-editor-prompt;
    in-out property <string> profile-editor-name;
    in-out property <string> profile-editor-pronouns;
    in-out property <string> profile-editor-bio;
    in-out property <string> profile-editor-colour;
    /// Opens the editor of the main Discord profile, as Edit Profile does.
    callback edit-profile;
    /// The account's card opened, which asks for its own profile.
    callback account-opened;
    /// The account's own profile, which its card draws its banner, theme,
    /// name and badges from; empty until it's come.
    in property <ProfileData> account-profile;
    callback open-profile-wishlist;
    callback write-profile(int, string);
    callback choose-name-style(int, int, string);
    callback edit-own-note;
    callback choose-server-tag(string);
    pure callback parse-hex(string) -> color;
    pure callback format-hex(color) -> string;
    pure callback key-part(string, int) -> string;
    pure callback key-colour(string, int) -> color;
    callback pick-profile-picture(int);
    callback reset-profile-picture(int);
    callback unlock-nitro;
    callback undo-profile;
    callback save-profile;
    callback close-profile-editor;
    // A Discord server's settings; see ServerSettingsScreen.
    in property <bool> server-settings-open;
    in property <ServerSettingsPrompt> server-settings-prompt;
    in-out property <string> server-settings-name;
    in-out property <string> server-settings-description;
    in-out property <string> server-settings-role-name;
    callback server-settings-section(int);
    /// Something done on Roles; see ServerSettingsScreen.
    callback role-input(int, string, int);
    /// Something done on Bans; see ServerSettingsScreen.
    callback ban-input(int, string, int);
    /// Something done on Audit Log; see ServerSettingsScreen.
    callback audit-log-input(int, int);
    callback members-input(int, string, int);
    callback invites-input(int, string, int);
    /// Something done on Emoji or Stickers; see ServerSettingsScreen.
    callback emoji-input(int, string, string);
    callback stickers-input(int, string);
    callback ownership-input(int, string);
    callback write-server-setting(int, string);
    callback toggle-server-setting(int);
    callback choose-server-setting(int, int);
    callback pick-server-picture(int);
    callback remove-server-picture(int);
    callback undo-server-settings;
    callback save-server-settings;
    callback close-server-settings;
    // A Discord channel's or category's settings, with its name, and what's
    // written in Overview; see ChannelSettingsScreen.
    in property <bool> channel-settings-open;
    in property <ChannelSettingsPrompt> channel-settings-prompt;
    in property <string> channel-settings-channel;
    in-out property <string> channel-settings-name;
    in-out property <string> channel-settings-topic;
    callback channel-settings-input(int, string, int);
    // Confirming a request Discord holds back; see MfaDialog.
    in property <bool> mfa-open;
    in property <MfaPrompt> mfa-prompt;
    in-out property <string> mfa-code;
    callback choose-mfa(int);
    callback write-mfa(string);
    callback resend-mfa;
    callback confirm-mfa;
    callback cancel-mfa;
    // Asks before leaving a Discord server, in a ChannelDialog.
    // Asks whether a channel dragged into a category takes its
    // permissions, in a ChannelDialog: `answer-move-sync` with whether it
    // does, and closing it leaves the channel where it was.
    in property <bool> move-sync-open;
    in property <ChannelPrompt> move-sync-prompt;
    callback answer-move-sync(bool);
    callback close-move-sync;
    in property <bool> leave-open;
    in property <ChannelPrompt> leave-prompt;
    callback confirm-leave;
    callback toggle-silent-leave;
    callback close-leave;
    in property <string> filter-placeholder;
    in property <string> sidebar-empty;
    in property <[ServerRow]> servers;
    in property <[RoomRow]> rooms;
    in property <[MessageRow]> messages;
    in property <string> account;
    in property <string> account-name;
    /// The account's username, which the account card shows while the pointer is on its name.
    in property <string> account-username;
    in property <string> account-user-id;
    in property <string> account-initial;
    /// The Discord-only build's own status for the account's dot, as
    /// StatusDot takes it; empty to show the connection instead.
    in property <string> account-presence;
    in property <color> account-tint;
    in property <image> account-picture;
    /// The account is speaking in the call, unmuted, as its own row there shows.
    in property <bool> account-speaking;
    in property <string> account-status;
    /// A small icon before the status, 1 for a game, and a bullet after it, as Discord's account panel has.
    in property <int> account-activity-icon;
    in property <bool> account-activity-bullet;
    /// The game the Discord account shows it plays, and for how long, which
    /// the window asks for with `game-duration-due` while the menu shows it.
    in property <string> game-activity-name;
    in property <string> game-activity-duration;
    callback game-duration-due();
    /// The address of the picture of the custom emoji in the account's status.
    in property <string> account-status-emoji;
    in property <string> storage;
    in property <string> notice;
    in-out property <string> graphics-notice;
    in property <string> room-name;
    /// A Discord thread's channel: its name, and its room id to go back to.
    in property <string> room-parent;
    in property <string> room-parent-id;
    /// The thread's channel is a forum, and the thread one of its posts.
    in property <bool> room-parent-forum;
    /// The open thread is a Discord forum post. Above its messages Discord
    /// puts a bar to react to the post and to follow it; `forum-post-item`
    /// is the post's first message once loaded, and `forum-post-follow` 0
    /// when the post can't be followed, 1 to follow it, 2 when it is.
    in property <bool> forum-post;
    in property <string> forum-post-item;
    in property <int> forum-post-follow;
    in property <image> room-icon;
    in property <bool> room-direct;
    in property <string> room-initial;
    in property <color> room-tint;
    in property <image> room-picture;
    /// The open room's id, which its header's menus name.
    in property <string> room-id;
    /// A Discord server channel's topic: on one line in the header, and in
    /// full under it once clicked.
    in property <bool> has-topic;
    in property <styled-text> room-topic;
    in property <styled-text> room-topic-full;
    property <bool> topic-open;
    changed room-id => { root.topic-open = false; }
    /// The open Discord server channel's notifications, which the header's
    /// bell offers, slashed while the channel is muted.
    in property <bool> can-notify;
    in property <bool> room-muted;
    in property <string> members;
    /// The open room lists its members: a text channel or a group DM.
    /// The zoom level, such as "110%", shown for a moment after it changes.
    in property <string> zoom-note;
    in property <bool> members-available;
    /// A one-to-one DM is open, whose other person's profile can show beside it.
    in property <bool> profile-available;
    /// Whether it does: shown until someone hides it.
    in-out property <bool> profile-panel: true;
    callback profile-panel-toggled(bool);
    /// That profile, once Yapfast has it.
    in property <bool> panel-profile-shown;
    in property <ProfileData> panel-profile;
    callback enlarge-panel-profile;
    /// A one-to-one DM's other person, as in RoomRow: whether they're around,
    /// and their custom status or what they're doing.
    in property <string> room-presence;
    in property <string> room-activity;
    /// The address of the picture of the custom emoji in the DM's status.
    in property <string> room-activity-emoji;
    property <bool> room-has-activity: root.room-activity != "" || root.room-activity-emoji != "";
    in property <[MemberRow]> roster;
    in property <[MemberActivityRow]> roster-activity;
    in-out property <bool> activity-cards-hidden;
    callback activity-cards-hidden-toggled(bool);
    callback activity-clock();
    in property <string> roster-note;
    /// Whether the member list is wanted beside the conversation; Yapfast stores it.
    in-out property <bool> member-list: true;
    callback member-list-toggled(bool);
    /// A Discord account is linked, so its settings show.
    in property <bool> discord-linked;
    // Which networks this build carries.
    in property <bool> discord-build;
    in property <bool> matrix-build: true;
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    callback link-discord-token(string);
    callback open-discord-captcha;
    callback cancel-discord-link;
    callback unlink-discord;
    in-out property <bool> show-hidden-channels;
    callback show-hidden-channels-toggled(bool);
    /// A link in a message was clicked.
    callback open-link(string);
    callback use-button(string, string);
    callback open-select(string, string);
    in property <bool> bot-select-open;
    /// The message whose bot control waits, and the one whose control
    /// failed, with why.
    in property <string> bot-busy-item;
    in property <string> bot-failed-item;
    in property <string> bot-failed-text;
    in property <string> bot-select-heading;
    in property <[SelectChoice]> bot-select-choices;
    in property <string> bot-select-query;
    in property <int> bot-select-min;
    in property <int> bot-select-max;
    callback bot-select-toggle(int);
    callback bot-select-search(string);
    callback bot-select-submit;
    callback bot-select-close;
    in property <bool> bot-modal-open;
    in property <string> bot-modal-heading;
    in property <[ModalField]> bot-modal-fields;
    in property <bool> bot-modal-supported;
    in property <bool> bot-modal-saving;
    in property <string> bot-modal-error;
    callback bot-modal-field-edited(int, string);
    callback bot-modal-open-select(int);
    callback bot-modal-submit;
    callback bot-modal-close;
    in-out property <bool> sync-discord-reads;
    callback sync-discord-reads-toggled(bool);
    in-out property <bool> show-idle: true;
    callback show-idle-toggled(bool);
    /// The Discord account shares the game it plays, as its settings say.
    in property <bool> show-game;
    in property <[GameExecutable]> game-executables;
    callback show-game-toggled(bool);
    callback save-game-executable(int, string, string) -> bool;
    callback remove-game-executable(int);
    in-out property <bool> hide-blocked;
    callback hide-blocked-toggled(bool);
    /// A call from someone's menu starts without asking first; Yapfast stores it.
    in-out property <bool> skip-call-prompt;
    callback skip-call-prompt-toggled(bool);
    /// Those the Discord account blocked, for Settings, and unblocking one
    /// by user id.
    in property <[BlockedRow]> blocked-people;
    callback unblock(string);
    in property <bool> room-selected;
    in property <bool> room-ready;
    in property <bool> room-encrypted;
    in property <bool> voice-room;
    /// The selected voice channel shows its chat in place of its call, and
    /// whether it has one to show.
    in property <bool> voice-chat;
    in property <bool> has-voice-chat;
    /// A call here would be end-to-end encrypted.
    in property <bool> call-encrypted;
    /// A voice room shows its call, rather than its chat.
    property <bool> voice-panel: root.voice-room && !root.voice-chat;
    in property <bool> composer-enabled;
