    emoji-card-motion := PopupMotion { open: root.emoji-card-open; }
    if emoji-card-motion.shown: Rectangle {
        TouchArea { clicked => { root.emoji-card-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.emoji-card-open = false; return accept; }
                return reject;
            }
        }
        EmojiCardView {
            opacity: Popup.opacity(emoji-card-motion.amount); transform-scale: Popup.scale(emoji-card-motion.amount);
            x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
            y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
                ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
            card: root.emoji-card;
            open-server(server) => {
                root.emoji-card-open = false;
                root.navigate-server(server);
            }
        }
    }
    // A sticker's card, under the sticker a message was clicked on, as an
    // emoji's opens. A click outside or Escape closes it.
    sticker-card-motion := PopupMotion { open: root.sticker-card-open; }
    if sticker-card-motion.shown: Rectangle {
        TouchArea { clicked => { root.sticker-card-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.sticker-card-open = false; return accept; }
                return reject;
            }
        }
        MessageStickerCardView {
            opacity: Popup.opacity(sticker-card-motion.amount); transform-scale: Popup.scale(sticker-card-motion.amount);
            x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
            y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
                ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
            card: root.sticker-card;
            open-server(server) => {
                root.sticker-card-open = false;
                root.navigate-server(server);
            }
        }
    }
    // An image shown large over everything; see ImageViewer.
    if root.viewer-open: ImageViewer {
        y: root.title-height; height: root.height - root.title-height;
        viewer-image: root.viewer-image; viewer-frames: root.viewer-frames; viewer-delays: root.viewer-delays;
        viewer-width: root.viewer-width; viewer-height: root.viewer-height; viewer-name: root.viewer-name;
        viewer-position: root.viewer-position; viewer-note: root.viewer-note;
        viewer-item: root.viewer-item; viewer-index: root.viewer-index; preview: root.preview;
        close-image => { root.close-image(); }
        step-image(step) => { root.step-image(step); }
        save-attachment(item, index) => { root.save-attachment(item, index); }
        copy-attachment(item, index) => { root.copy-attachment(item, index); }
        copy-text(text) => { root.copy-text(text); }
        open-link(link) => { root.open-link(link); }
        attachment-link(item, index) => { return root.attachment-link(item, index); }
    }
    // The video playing, shown large over everything; see VideoViewer.
    if VideoPlayer.expanded && VideoPlayer.item != "": VideoViewer {
