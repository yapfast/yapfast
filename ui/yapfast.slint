    }
    function open-soundboard(x: length, y: length) {
        root.menu-x = x; root.menu-y = y;
        root.soundboard-opened();
        soundboard-menu.show();
    }
    soundboard-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: board.width; height: board.height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        board := Soundboard {
            rows: root.soundboard-rows; note: root.soundboard-note; emoji-font: root.emoji-font;
