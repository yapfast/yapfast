    /// Opens the share menu once its lists are in. Switching where the
    /// system's dialog picks and there's no camera goes straight to the dialog.
    public function show-share-menu() {
        if root.pick-switch && !root.share-lists && root.share-cameras.length == 0 {
            root.switch-live(0);
        } else {
            share-menu.show();
        }
    }
