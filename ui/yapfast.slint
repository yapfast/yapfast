        root.react-item = item;
        root.emoji-query = "";
        root.emoji-hover = { glyph: "", name: "" };
        root.emoji-panel-width = root.emoji-popup-width;
        root.emoji-search("");
        emoji-picker.show();
    }
    // The message whose menu is open.
    property <MessageRow> menu-message;
    property <string> menu-item: menu-open ? root.menu-message.item : "";
    property <bool> menu-open: message-menu.is-open;
    // The server, conversation or person whose menu is open. A profile chosen
    // from a person's menu opens where the menu did.
    property <string> menu-target;
    property <bool> menu-person;
    // A message author's card, beside their avatar or name, and their menu.
    function author-card(item: string, sender: string, x: length, y: length, width: length, height: length) {
        root.active-item = item;
        root.anchor(x, y, width, height, false);
        root.profile-at-pointer = true;
        root.show-profile(sender);
    }
    function author-menu(item: string, sender: string, x: length, y: length) {
        root.active-item = item;
        root.open-context-menu(sender, true, x, y);
    }
    // The menu open is the one a server's header opened, whose chevron turns.
    property <bool> header-menu;
    property <bool> header-menu-open: root.header-menu && context-menu.is-open;
    function open-header-menu(x: length, y: length) {
        root.open-context-menu("header:" + root.header-server, false, x, y);
        root.header-menu = true;
    }
    function open-events-menu(x: length, y: length) {
        root.open-context-menu("events:" + root.header-server, false, x, y);
    }
    function open-context-menu(id: string, person: bool, x: length, y: length) {
        root.header-menu = false;
        root.anchor(x, y, 0px, 0px, true);
        root.menu-target = id;
        root.menu-person = person;
        root.prepare-menu(id, person);
        if root.menu-rows.length > 0 { context-menu.show(); }
    }
    // The popup spans the menu and room for its submenus, which open to the
    // menu's right, or its left near the window's right edge. The menu opens
    // below the pointer, or above it if it doesn't fit, and stays there
