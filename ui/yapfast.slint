        choose-name-style(font, effect, colours) => { root.choose-name-style(font, effect, colours); }
        copy-id => { root.copy-text(root.account-user-id); }
        open-wishlist => { root.open-profile-wishlist(); }
        edit-note => { root.edit-own-note(); }
        choose-tag(server) => { root.choose-server-tag(server); }
        edit-status => { root.open-status(); }
        has-status: root.has-custom-status; status-text: root.account-status; status-emoji: root.account-status-emoji;
        parse-hex(text) => { return root.parse-hex(text); }
        format-hex(colour) => { return root.format-hex(colour); }
        key-part(key, index) => { return root.key-part(key, index); }
        key-colour(key, index) => { return root.key-colour(key, index); }
