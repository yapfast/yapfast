    /// The settings show over the window, one section at a time: 0 account, 1 voice and
    /// audio, 2 messages, 3 notifications, 4 Discord, 5 sounds, 8 game activity.
    in-out property <bool> settings-open;
    // Closing settings stops linking Discord there.
    changed settings-open => {
        root.track-new();
        if !self.settings-open && self.link-phase != 0 { self.cancel-discord-link(); }
        if !self.settings-open { self.camera-testing = false; }
        if !self.settings-open && self.theme-editor { self.cancel-theme(); }
    }
    in-out property <int> settings-section;
    // The section whose NEW tags are showing, so leaving it can say they were seen.
    property <int> new-viewing: -1;
    function track-new() {
        if root.new-viewing != (root.settings-open ? root.settings-section : -1) {
            if root.new-viewing >= 0 { NewTags.left(root.new-viewing); }
            root.new-viewing = root.settings-open ? root.settings-section : -1;
        }
    }
    /// Preferences people set in the settings; preferences-changed reports any change.
