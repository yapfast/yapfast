    public function copy-text(text: string) { clipboard.text = text; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    // A tooltip must not outlive the toolbar that showed it.
    function hide-badge-tips() { Tip.text = ""; Tip.pop = false; BadgeTip.title = ""; }
    changed active-item => { root.hide-badge-tips(); }

    // The member list is a second sidebar, on the right of the conversation.
    property <bool> members-docked: root.members-available && root.member-list && !root.search-open && !root.aside-docked;
    // A thread opened beside the channel takes the place of the member list
