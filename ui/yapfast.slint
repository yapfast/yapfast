    public function paste-composer-text() { composer.paste-text(); }
    in property <string> confirm-delete;
    in-out property <string> react-item;
    in-out property <string> active-item;
    // Where the active message is in the timeline, so the keyboard can step from it.
    in-out property <int> active-index: -1;
    // The message list has the keyboard: Up and Down step through messages and
    // letters act on the active one.
    out property <bool> browsing: timeline-keys.has-focus;
    // A popup the keyboard asked for, "menu" or "react", which the active row opens
    // beside itself.
    property <string> keyboard-popup;
    property <MessageRow> keyed-message: root.active-index >= 0 && root.active-index < root.messages.length ? root.messages[root.active-index] : {};
    // Room kept around the keyboard's message, so the next one is in view.
    property <length> keyboard-margin: min(160px, timeline.height / 3);
    callback edit-last;
    // Moves the keyboard to the newest message, from the composer.
    public function browse-messages() {
        if root.messages.length > 0 {
            root.step-message(root.messages.length - 1);
            timeline-keys.focus();
        }
    }
    function step-message(index: int) {
        root.active-index = max(0, min(root.messages.length - 1, index));
        root.active-item = root.messages[root.active-index].item;
    }
