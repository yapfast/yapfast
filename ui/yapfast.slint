    in-out property <bool> deafen-on-join;
    in-out property <bool> level-voice: true;
    in-out property <int> noise-suppression;
    /// The suppression the call panel's toggle turns back on: the one last
    /// used before Off, DeepFilterNet unless another was, however it was
    /// chosen.
    property <int> noise-last: 0;
    changed noise-suppression => {
        if self.noise-suppression != 2 {
            self.noise-last = self.noise-suppression;
        }
    }
    /// Turns noise suppression off, or back on to the kind last used, and
    /// saves it, as the call panel's toggle does.
    public function toggle-noise() {
        if root.noise-suppression == 2 {
            root.noise-suppression = root.noise-last;
        } else {
            root.noise-last = root.noise-suppression;
            root.noise-suppression = 2;
        }
        root.preferences-changed();
    }
