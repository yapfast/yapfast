    changed gate-metered => { root.gate-level = -100; root.gate-sending = false; root.gate-meter-note = ""; root.gate-metering(self.gate-metered); }
    Timer { interval: 50ms; running: root.gate-metered; triggered => { root.gate-meter-tick(); } }
