    in property <bool> drop-aside;
    /// Whether a point of the window is over the thread beside the channel,
    /// below the header.
    pure public function over-aside(x: length, y: length) -> bool {
        root.workspace && root.aside-docked && !root.new-thread-open
            && x >= root.width - root.aside-shown && y >= root.title-height + ClientStyle.header-height
    }
    /// Why the last files dropped were refused, and more, until dismissed.
