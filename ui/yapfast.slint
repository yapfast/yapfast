    public function focus-composer() { composer.focus-input(); }
    // Something over the conversation that typing and Escape mustn't reach
    // behind, as Discord's focus locks, modals and layers stop them: the
    // settings, a full profile or a card, a dialog, a panel such as the pins,
    // the image viewer or the call in full screen. Those with a field of their
    // own take the text first.
    property <bool> composer-covered: root.settings-open || root.server-settings-open
        || root.channel-settings-open || root.profile-editor-open || root.profile-open
        || root.role-open || root.server-card-open || root.emoji-card-open || root.topic-open
        || root.pins-open || root.threads-open || root.add-people-open || root.viewer-open
        || (VideoPlayer.expanded && VideoPlayer.item != "") || root.stage-full
        || root.switcher-open || root.mfa-open || root.add-friend-open || root.invite-open
        || root.join-open || root.event-open || root.gift-open || root.oauth-open
        || root.channel-open || root.move-sync-open || root.leave-open || root.person-open
        || root.status-open || root.poll-open || root.new-dm-open || root.reactions-open
        || root.forward-open || root.leaving-link != "" || root.switch-prompt != ""
        || root.confirm-delete != "" || root.incoming-open;
    // The channel has no composer here: a call, a forum, a message request, the
    // friends list, the friend requests or Browse Channels.
    property <bool> composer-missing: !root.room-selected || root.voice-panel || root.room-forum
        || root.room-request || root.friends-open || root.requests-open || root.browse-open;
    // Typing goes to the composer used last, as in Discord: the panel's from
    // when it opens, until the channel's takes the keyboard.
    property <bool> aside-composer-last;
    changed aside-docked => { root.aside-composer-last = root.aside-docked; }
    property <int> aside-typing-tick;
    /// A key was typed with nothing focused: focuses the composer it goes to,
    /// with its caret at the end; whether there is one.
    public function type-into-composer() -> bool {
        if !root.workspace || root.composer-covered { return false; }
        if root.aside-docked && root.aside-composer-last {
            if !root.new-thread-open && !root.aside-composer-enabled { return false; }
            root.aside-typing-tick += 1;
            return true;
        }
        if !root.composer-enabled || root.composer-missing { return false; }
        composer.focus-input();
        composer.place-caret(1000000);
        return true;
    }
    /// Escape that nothing above took, from anywhere, in Discord's order: the
    /// search, then a reply or an edit in the channel, then in the thread
    /// beside it, then the new thread's form; whether it did anything.
    public function escape-composing() -> bool {
        if !root.workspace || root.composer-covered { return false; }
        if root.search-open { root.search-text = ""; root.search(""); return true; }
        if root.compose-label != "" { root.cancel-compose(); return true; }
        if !root.aside-docked { return false; }
        if root.new-thread-open { root.close-new-thread(); return true; }
        if root.aside-compose-label == "" { return false; }
        root.aside-cancel-compose();
        return true;
    }
    // The menu is open on a message of the thread beside, whose composer
    // its Reply and Edit focus.
    property <bool> menu-aside;
    property <int> aside-focus-tick;
    public function focus-aside-composer() { root.aside-focus-tick += 1; }
    function focus-composer-of-menu() {
        if root.menu-aside { root.aside-focus-tick += 1; } else { root.focus-composer(); }
    }
    public function place-composer-caret(offset: int) { composer.place-caret(offset); }
    // The Matrix sign-in, which only a build with Matrix has, focuses its first
    // field each time this counts up.
    property <int> sign-in-focus;
    public function focus-sign-in() { root.sign-in-focus += 1; }
    public function timeline-at-end() -> bool { return root.follow-latest; }
    // Yapfast's window has the keyboard focus.
    in property <bool> window-focused;
    /// Shift is held, which turns a message's hover bar into its quick
    /// actions, as in Discord's client.
    in property <bool> shift-held;
    // The newest message was read since the "New" divider was placed, so the bar
    // that jumps back to it is gone.
    in property <bool> caught-up;
    // The newest message is in view, with the window in front and no jump settling,
    // which reads the conversation. A jump that placed its row with the list at its
    // end, as to the "New" divider of a short unread stretch, reads it at once
    // rather than once the jump lets go.
    property <bool> reading-latest: root.room-selected && !root.requests-open && !root.friends-open
        && root.window-focused
        && ((root.follow-latest && root.jump-item == "")
            || (root.jump-item != "" && root.jump-placed && !root.detached
                && root.timeline-position <= min(0px, root.timeline-viewport - root.timeline-content) + 0.5px));
    changed reading-latest => { root.reading-changed(self.reading-latest); }
    public function reading() -> bool { return root.reading-latest; }
    // How far the newest message is below the view; zero at the end.
    public function timeline-below() -> length { return max(0px, timeline.content-y - min(0px, timeline.height - timeline.content-height)); }
    public function timeline-extent() -> length { return timeline.content-height; }
    /// Where in the window the link just clicked is, so a card it opens sits beside it.
    public function anchor-link(x: length, y: length, width: length, height: length) {
        root.anchor(x, y, width, height, false);
    }
