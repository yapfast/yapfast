        call-link-menu.show();
    }
    // Someone's menu in a call or under a voice channel, by the channel's
    // room id: their volumes on top, then what their menu offers there.
    property <bool> voice-menu-volume;
    property <bool> voice-menu-rows: root.menu-rows.length > 0;
    function open-voice-menu(room: string, person: PersonRow, x: length, y: length) {
        if person.person == "" { return; }
        root.header-menu = false;
        root.anchor(x, y, 0px, 0px, true);
        root.voice-menu-volume = !person.local;
        root.volume-person = person.person;
        root.volume-name = person.name;
        root.volume-live = person.live;
        root.voice-volume = root.volume-of(person.person, false);
        root.stream-volume = root.volume-of(person.person, true);
        root.menu-target = "in-voice:" + room + "/" + person.person;
        root.menu-person = true;
        root.prepare-menu(root.menu-target, true);
        if root.voice-menu-volume || root.voice-menu-rows { voice-menu.show(); }
    }
