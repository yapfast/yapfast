import { Theme, Middle, Label } from "theme.slint";
import { ActionButton, Avatar, IconButton, TextField, PictureStore } from "controls.slint";
import { SettingsTitle, SettingsHeading } from "settings.slint";
import { ListView } from "scrollview.slint";

/// A row of Emoji's list: a table's heading, or an emoji.
export struct ServerEmojiRow {
    /// "Emoji" or "Animated Emoji" heading its table, with its slots.
    heading: string,
    slots: string,
    id: string,
    name: string,
    picture-url: string,
    uploader: string,
    uploader-avatar: string,
    uploader-initial: string,
    /// This account may rename and delete it.
    may-change: bool,
}

/// What Emoji shows.
export struct EmojiPrompt {
    /// Each kind's slots, for Discord's words above the list.
    slots: int,
    /// Both tables, newest first, each under its heading.
    rows: [ServerEmojiRow],
    /// Upload Emoji shows: this account may, and a slot is free.
    may-upload: bool,
    /// The upload dialog, while open: the picture, its name, and whether
    /// it's animated.
    uploading: bool,
    preview: image,
    name: string,
    animated: bool,
    saving: bool,
    may-finish: bool,
    error: string,
}

/// A sticker on Stickers' cards.
export struct StickerTile {
    id: string,
    name: string,
    picture-url: string,
    uploader: string,
    may-change: bool,
}

/// One of Discord's cards: Free Slots, then Levels 1 to 3.
export struct StickerCard {
    title: string,
    /// "3 of 5 slots available", or the boosts a locked level takes.
    status: string,
    unlocked: bool,
    /// Upload Sticker shows here, where the next goes.
    next: bool,
    tiles: [StickerTile],
}

/// What Stickers shows.
export struct StickersPrompt {
    cards: [StickerCard],
    may-upload: bool,
    /// The sticker form, while open: a new sticker's, or one edited.
    form: bool,
    editing: bool,
    preview: image,
    preview-url: string,
    has-file: bool,
    file-name: string,
    name: string,
    tags: string,
    description: string,
    saving: bool,
    may-save: bool,
    error: string,
}

// A picture by its address, as the picture store has it.
component UrlPicture inherits Image {
    in property <string> url;
    source: root.url != "" ? PictureStore.picture(root.url, PictureStore.revision(root.url)) : @image-url("");
    image-fit: contain;
    init => { if root.url != "" && self.source.width == 0 { PictureStore.request(root.url); } }
}

// Emoji: the server's emoji and animated emoji, each renamed in place or
// deleted at once, and Upload Emoji, as Discord's page has them.
export component EmojiSection inherits VerticalLayout {
    in property <EmojiPrompt> page;
    /// 0 rename an emoji by id to a text, 1 delete one by id.
    callback act(int, string, string);
    callback upload;
    spacing: 16px;
    SettingsTitle { text: @tr("Emoji"); }
    Label {
        text: @tr("Add up to {} custom emojis that anyone can use in this server. Animated GIF emojis may be used by members with Discord Nitro. Emoji names must be at least 2 characters long and can only contain alphanumeric characters and underscores. Emoji must be under 256 KB in size.", root.page.slots);
    }
    if root.page.may-upload: HorizontalLayout {
        alignment: start;
        ActionButton { text: @tr("Upload Emoji"); primary: true; clicked => { root.upload(); } }
    }
    if root.page.rows.length == 0: VerticalLayout {
        alignment: center; vertical-stretch: 1; spacing: 8px;
        Text { text: @tr("No Emoji"); color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
        Text { text: @tr("Get the party started by uploading an emoji"); color: Theme.secondary; font-size: 15px; horizontal-alignment: center; }
    }
    if root.page.rows.length > 0: ListView {
        vertical-stretch: 1; min-height: 120px;
        for row in root.page.rows: Rectangle {
            height: row.heading != "" ? 72px : 52px;
            background: row.heading == "" && hover.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
            border-radius: 6px;
            hover := TouchArea { }
            if row.heading != "": VerticalLayout {
                padding-top: 16px; padding-left: 8px; padding-right: 8px; spacing: 8px;
                HorizontalLayout {
                    spacing: 6px; alignment: start;
                    Text { text: row.heading; color: Theme.text; font-size: 16px; font-weight: 700; }
                    Text { text: "– " + row.slots; color: Theme.secondary; font-size: 16px; }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Text { width: 48px; text: @tr("IMAGE"); color: Theme.secondary; font-size: 12px; font-weight: 700; }
                    HorizontalLayout {
                        preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; padding-left: 8px;
                        Text { text: @tr("NAME"); color: Theme.secondary; font-size: 12px; font-weight: 700; }
                    }
                    Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; text: @tr("UPLOADED BY"); color: Theme.secondary; font-size: 12px; font-weight: 700; }
                    Rectangle { width: 32px; }
                }
            }
            if row.heading == "": HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 16px;
                Middle { width: 48px; UrlPicture { width: 32px; height: 32px; url: row.picture-url; accessible-role: image; accessible-label: row.name; } }
                if row.may-change: Middle {
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1;
                    name := TextField {
                        text: row.name; text-size: 14px; label: @tr("Emoji name"); min-height: 34px; pad: 8px;
                        fill: self.focused || hover.has-hover ? Theme.sunken : transparent;
                        accepted => { root.act(0, row.id, self.text); self.text = row.name; }
                        changed focused => {
                            if !self.focused && self.text != row.name {
                                root.act(0, row.id, self.text);
                                self.text = row.name;
                            }
                        }
                    }
                }
                if !row.may-change: HorizontalLayout {
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; padding-left: 8px;
                    Text { text: row.name; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                }
                HorizontalLayout {
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; spacing: 8px;
                    if row.uploader != "": Middle { Avatar { size: 24px; initial: row.uploader-initial; picture-url: row.uploader-avatar; } }
                    Text { text: row.uploader; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                }
                Middle {
                    IconButton {
                        icon: @image-url("icons/x.svg"); label: @tr("Delete"); size: 32px; glyph: 18px; danger: true;
                        enabled: row.may-change;
                        opacity: row.may-change && (hover.has-hover || self.hovered) ? 1 : 0;
                        clicked => { root.act(1, row.id, ""); }
                    }
                }
            }
        }
    }
}

// The upload dialog: the emoji as chat will show it and its name, over the
// screen.
export component EmojiUploadDialog inherits Rectangle {
    in property <EmojiPrompt> page;
    /// 2 the name typed, 3 upload, 4 cancel.
    callback act(int, string);
    background: #000000aa;
    TouchArea { clicked => { if !root.page.saving { root.act(4, ""); } } }
    // The field follows the name as Discord's makes it.
    property <string> wanted: root.page.name;
    changed wanted => { if name.text != self.wanted { name.text = self.wanted; } }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.act(4, ""); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            accessible-role: groupbox; accessible-label: @tr("Upload Emoji");
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 14px;
                Text { text: @tr("Upload Emoji"); color: Theme.text; font-size: 20px; font-weight: 700; }
                Rectangle {
                    height: 144px; border-radius: 8px; background: Theme.sunken;
                    HorizontalLayout {
                        alignment: center; spacing: 24px;
                        for size in [128px, 48px, 22px]: Middle {
                            Image { width: size; height: size; source: root.page.preview; image-fit: contain; accessible-role: none; }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    SettingsHeading { text: @tr("NAME"); }
                    name := TextField {
                        text: root.page.name; label: @tr("Emoji name"); enabled: !root.page.saving;
                        init => { self.focus-input(); }
                        edited(text) => { root.act(2, text); }
                        accepted => { root.act(3, ""); }
                    }
                }
                if root.page.error != "": Text { text: root.page.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; enabled: !root.page.saving; clicked => { root.act(4, ""); } }
                    ActionButton {
                        text: root.page.saving ? @tr("Uploading...") : @tr("Upload"); primary: true;
                        enabled: root.page.may-finish && !root.page.saving;
                        clicked => { root.act(3, ""); }
                    }
                }
            }
        }
    }
}

// A sticker on its card: its picture, name and uploader, with its pencil
// and X on hover.
component StickerTileView inherits Rectangle {
    in property <StickerTile> tile;
    callback edit;
    callback delete;
    border-radius: 8px;
    background: hover.has-hover ? Theme.overlay.with-alpha(0.08) : Theme.overlay.with-alpha(0.03);
    accessible-role: groupbox; accessible-label: root.tile.name;
    hover := TouchArea { }
    VerticalLayout {
        padding: 10px; spacing: 6px;
        HorizontalLayout { alignment: center; UrlPicture { width: 80px; height: 80px; url: root.tile.picture-url; accessible-role: image; accessible-label: root.tile.name; } }
        Text { text: root.tile.name; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
        Text { text: root.tile.uploader; color: Theme.secondary; font-size: 12px; horizontal-alignment: center; overflow: elide; }
    }
    if root.tile.may-change: HorizontalLayout {
        x: parent.width - self.preferred-width - 4px; y: 4px; width: self.preferred-width; height: 28px;
        spacing: 2px;
        opacity: hover.has-hover || edit.hovered || delete.hovered ? 1 : 0;
        edit := IconButton { icon: @image-url("icons/pencil.svg"); label: @tr("Edit"); size: 28px; glyph: 16px; fill: Theme.raised; clicked => { root.edit(); } }
        delete := IconButton { icon: @image-url("icons/x.svg"); label: @tr("Delete"); size: 28px; glyph: 16px; danger: true; fill: Theme.raised; clicked => { root.delete(); } }
    }
}

// Stickers: the server's stickers on its boost levels' cards, each edited
// or deleted, and Upload Sticker where the next one goes, as Discord's page
// has them.
export component StickersSection inherits VerticalLayout {
    in property <StickersPrompt> page;
    /// 0 open the form for a new sticker, 1 edit one by id, 7 delete one.
    callback act(int, string);
    spacing: 16px;
    SettingsTitle { text: @tr("Stickers"); }
    Label { text: @tr("Stickers can be static (JPG, PNG) or animated (APNG, GIF). Stickers must be exactly 320 x 320 pixels and no larger than 512 KB. We will automatically resize static JPG, PNG and animated GIF stickers for you."); }
    for card in root.page.cards: Rectangle {
        border-radius: 8px; background: Theme.overlay.with-alpha(0.03);
        border-width: 1px; border-color: Theme.line;
        height: inner.preferred-height;
        inner := VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                if !card.unlocked: Middle { Image { source: @image-url("icons/lock.svg"); width: 16px; height: 16px; colorize: Theme.secondary; } }
                Text { text: card.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: card.status; color: Theme.secondary; font-size: 14px; vertical-alignment: center; }
            }
            // The tiles wrap, 140 px each.
            property <int> count: card.tiles.length + (card.next && root.page.may-upload ? 1 : 0);
            property <int> columns: max(1, floor((self.width - 32px + 12px) / 152px));
            if self.count > 0: Rectangle {
                height: ceil(inner.count / inner.columns) * 172px - 12px;
                for tile[index] in card.tiles: StickerTileView {
                    x: mod(index, inner.columns) * 152px; y: floor(index / inner.columns) * 172px;
                    width: 140px; height: 160px;
                    tile: tile;
                    edit => { root.act(1, tile.id); }
                    delete => { root.act(7, tile.id); }
                }
                if card.next && root.page.may-upload: Rectangle {
                    x: mod(card.tiles.length, inner.columns) * 152px; y: floor(card.tiles.length / inner.columns) * 172px;
                    width: 140px; height: 160px; border-radius: 8px;
                    border-width: 2px; border-color: add.has-hover ? Theme.secondary : Theme.line;
                    accessible-role: button; accessible-label: @tr("Upload Sticker");
                    accessible-action-default => { root.act(0, ""); }
                    add := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act(0, ""); } }
                    VerticalLayout {
                        alignment: center; spacing: 8px;
                        HorizontalLayout { alignment: center; Image { source: @image-url("icons/circle-plus.svg"); width: 32px; height: 32px; colorize: Theme.secondary; } }
                        Text { text: @tr("Upload Sticker"); color: Theme.secondary; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
}

// The sticker form: a new sticker's file, related emoji, name and
// description, or those of one edited, over the screen.
export component StickerDialog inherits Rectangle {
    in property <StickersPrompt> page;
    /// 2 the name typed, 3 the related emoji, 4 the description, 5 save,
    /// 6 cancel.
    callback act(int, string);
    callback browse;
    background: #000000aa;
    TouchArea { clicked => { if !root.page.saving { root.act(6, ""); } } }
    // The fields follow the form as the core cuts it.
    property <string> wanted-name: root.page.name;
    property <string> wanted-tags: root.page.tags;
    property <string> wanted-description: root.page.description;
    changed wanted-name => { if name.text != self.wanted-name { name.text = self.wanted-name; } }
    changed wanted-tags => { if tags.text != self.wanted-tags { tags.text = self.wanted-tags; } }
    changed wanted-description => { if description.text != self.wanted-description { description.text = self.wanted-description; } }
    FocusScope {
        // The keys come here, so Escape closes the form, not the settings.
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.act(6, ""); return accept; }
            return reject;
        }
        Rectangle {
            width: 520px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            accessible-role: groupbox; accessible-label: @tr("Upload Sticker");
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 14px;
                Text { text: root.page.editing ? @tr("Edit Sticker") : @tr("Upload Sticker"); color: Theme.text; font-size: 20px; font-weight: 700; }
                Rectangle {
                    height: 180px; border-radius: 8px; background: Theme.sunken;
                    if root.page.preview-url != "": UrlPicture { width: 160px; height: 160px; url: root.page.preview-url; accessible-role: image; accessible-label: @tr("Preview"); }
                    if root.page.preview-url == "" && root.page.has-file: Image { width: 160px; height: 160px; source: root.page.preview; image-fit: contain; accessible-role: image; accessible-label: @tr("Preview"); }
                    if root.page.preview-url == "" && !root.page.has-file: Text { text: @tr("Preview"); color: Theme.muted; font-size: 14px; }
                }
                // An edit can't change the file.
                if !root.page.editing: VerticalLayout {
                    spacing: 6px;
                    SettingsHeading { text: @tr("FILE"); }
                    HorizontalLayout {
                        spacing: 8px;
                        Middle {
                            horizontal-stretch: 1;
                            Text {
                                text: root.page.has-file ? root.page.file-name : @tr("File should be APNG, JPG, PNG or GIF (512 KB max)");
                                color: root.page.has-file ? Theme.text : Theme.secondary; font-size: 13px; overflow: elide;
                            }
                        }
                        ActionButton { text: @tr("Browse"); enabled: !root.page.saving; clicked => { root.browse(); } }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    SettingsHeading { text: @tr("RELATED EMOJI"); }
                    tags := TextField {
                        text: root.page.tags; label: @tr("Related Emoji"); placeholder: @tr("Type or paste an emoji"); enabled: !root.page.saving;
                        edited(text) => { root.act(3, text); }
                        accepted => { root.act(5, ""); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    SettingsHeading { text: @tr("STICKER NAME"); }
                    name := TextField {
                        text: root.page.name; label: @tr("Sticker Name"); placeholder: @tr("e.g.: cat hug"); enabled: !root.page.saving;
                        edited(text) => { root.act(2, text); }
                        accepted => { root.act(5, ""); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    SettingsHeading { text: @tr("DESCRIPTION"); }
                    description := TextField {
                        text: root.page.description; label: @tr("Description"); enabled: !root.page.saving;
                        edited(text) => { root.act(4, text); }
                        accepted => { root.act(5, ""); }
                    }
                    Text { text: @tr("Descriptions are optional but must be more than 1 character."); color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                }
                if root.page.error != "": Text { text: root.page.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; enabled: !root.page.saving; clicked => { root.act(6, ""); } }
                    ActionButton {
                        text: root.page.saving ? @tr("Saving...") : root.page.editing ? @tr("Update") : @tr("Upload"); primary: true;
                        enabled: root.page.may-save && !root.page.saving;
                        clicked => { root.act(5, ""); }
                    }
                }
            }
        }
    }
}
