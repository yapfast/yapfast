// A Discord channel's or category's settings, covering the window as Discord's
// do: Overview, its name and a text channel's topic, slowmode and age
// restriction; and Permissions, its overwrites, each permission allowed,
// denied or left to the roles for a role or member.
import { Theme, Middle, Label, Tip } from "theme.slint";
import { ActionButton, Avatar, IconButton, TextField } from "controls.slint";
import { SettingsCard, SettingsFrame, SettingsRow, SettingsTitle, SettingsHeading, SettingsSwitch, UnsavedBar } from "settings.slint";
import { ListView } from "scrollview.slint";
import { RoleMemberRow } from "roles.slint";

/// A role or member with an overwrite, in Permissions' list, or one to add.
export struct OverwriteRow {
    id: string,
    name: string,
    member: bool,
    /// Its role's colour; transparent for none.
    color: color,
    selected: bool,
}

/// A permission as the shown overwrite has it, or a group's heading.
export struct ThreeStateRow {
    heading: bool,
    title: string,
    description: string,
    bit: int,
    /// 0 denied, 1 left to the roles, 2 allowed.
    state: int,
    /// Why it can't change, in Discord's words; empty when it can.
    lock-text: string,
}

/// What a channel's settings show besides what's written in them.
export struct ChannelSettingsPrompt {
    rows: [SettingsRow],
    /// 0 Overview, 1 Permissions.
    section: int,
    loading: bool,
    loaded: bool,
    saving: bool,
    error: string,
    problem: string,
    changed: bool,
    may-save: bool,
    nudge: int,
    // Overview.
    /// 0 text, 1 voice, 2 category.
    kind: int,
    /// An index into the slowmodes offered.
    slowmode: int,
    nsfw: bool,
    // Permissions.
    title: string,
    subtitle: string,
    /// The category it's in, for the sync notice: 0 none, 1 synced, 2 not.
    sync: int,
    category: string,
    private: bool,
    private-title: string,
    private-text: string,
    private-lock: string,
    overwrites: [OverwriteRow],
    shown-name: string,
    shown-everyone: bool,
    permissions: [ThreeStateRow],
    /// This account may change the overwrites at all.
    may-edit: bool,
    /// Add's picker: the roles without an overwrite, and the members found.
    adding: bool,
    roles-to-add: [OverwriteRow],
    members-found: [RoleMemberRow],
    /// What it asks: 0 nothing, 1 removing the shown overwrite, 2 syncing,
    /// 3 a change refused for taking the permission from this account.
    confirm: int,
    confirm-name: string,
}

// Deny, neither, allow: Discord's three buttons, the chosen one filled.
component ThreeState inherits Rectangle {
    in property <int> state;
    in property <bool> enabled;
    in property <string> title;
    callback chose(int);
    width: 108px; height: 28px; border-radius: 6px;
    border-width: 1px; border-color: Theme.line;
    HorizontalLayout {
        for choice[index] in [
            { icon: @image-url("icons/x.svg"), label: @tr("Deny"), fill: Theme.danger },
            { icon: @image-url("icons/slash.svg"), label: @tr("Passthrough"), fill: Theme.faint },
            { icon: @image-url("icons/check.svg"), label: @tr("Allow"), fill: Theme.live },
        ]: Rectangle {
            border-radius: 5px;
            background: root.state == index ? choice.fill : area.has-hover && root.enabled ? Theme.hover : transparent;
            accessible-role: button; accessible-label: root.title + ", " + choice.label;
            accessible-checked: root.state == index;
            Image {
                width: 16px; height: 16px; source: choice.icon;
                colorize: root.state == index ? #ffffff : root.enabled ? Theme.secondary : Theme.faint;
            }
            area := TouchArea {
                enabled: root.enabled;
                clicked => { root.chose(index); }
            }
        }
    }
}

// A permission's row: its title, description and three buttons, with a lock
// whose tooltip says why when it can't change.
component ThreeStateLine inherits VerticalLayout {
    in property <ThreeStateRow> permission;
    in property <bool> enabled;
    callback chose(int);
    spacing: 4px; padding-bottom: 12px; padding-right: 12px;
    HorizontalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 6px; alignment: start; horizontal-stretch: 1;
            Text {
                text: root.permission.title; font-size: 15px; vertical-alignment: center; wrap: word-wrap;
                color: root.enabled && root.permission.lock-text == "" ? Theme.text : Theme.muted;
            }
            if root.permission.lock-text != "": Middle {
                Image {
                    width: 14px; height: 14px; source: @image-url("icons/lock.svg"); colorize: Theme.muted;
                    accessible-role: image; accessible-label: root.permission.lock-text;
                    TouchArea {
                        changed has-hover => {
                            if self.has-hover {
                                Tip.text = root.permission.lock-text;
                                Tip.side = 0;
                                Tip.x = self.absolute-position.x + self.width / 2;
                                Tip.y = self.absolute-position.y;
                            } else if Tip.text == root.permission.lock-text {
                                Tip.text = "";
                            }
                        }
                    }
                }
            }
        }
        Middle {
            ThreeState {
                state: root.permission.state; title: root.permission.title;
                enabled: root.enabled && root.permission.lock-text == "";
                chose(state) => { root.chose(state); }
            }
        }
    }
    Text { text: root.permission.description; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
    Rectangle { height: 1px; background: Theme.line; }
}

// Overview: the name, and a text channel's topic, slowmode and age restriction.
component OverviewSection inherits VerticalLayout {
    in property <ChannelSettingsPrompt> prompt;
    in-out property <string> name;
    in-out property <string> topic;
    /// 0 the name, 1 the topic.
    callback write(int, string);
    callback slowmode(int);
    callback nsfw(bool);
    property <[string]> slowmodes: [@tr("Off"), "5s", "10s", "15s", "30s", "1m", "2m", "5m", "10m", "15m", "30m", "1h", "2h", "6h"];
    spacing: 20px;
    SettingsTitle { text: @tr("Overview"); }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: root.prompt.kind == 2 ? @tr("CATEGORY NAME") : @tr("CHANNEL NAME"); }
        TextField {
            text <=> root.name; label: root.prompt.kind == 2 ? @tr("Category name") : @tr("Channel name");
            enabled: !root.prompt.saving;
            edited(text) => { root.write(0, text); }
        }
    }
    if root.prompt.kind == 0: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("CHANNEL TOPIC"); }
        TextField {
            text <=> root.topic; label: @tr("Channel topic"); enabled: !root.prompt.saving;
            placeholder: @tr("Let everyone know how to use this channel!");
            edited(text) => { root.write(1, text); }
        }
    }
    if root.prompt.kind == 0: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("SLOWMODE"); }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            IconButton {
                icon: @image-url("icons/chevron-left.svg"); label: @tr("Shorter slowmode"); size: 32px; glyph: 18px;
                clicked => { root.slowmode(max(0, root.prompt.slowmode - 1)); }
            }
            Text {
                min-width: 48px; text: root.slowmodes[root.prompt.slowmode]; color: Theme.text; font-size: 15px;
                horizontal-alignment: center; vertical-alignment: center;
                accessible-role: text; accessible-label: @tr("Slowmode {}", self.text);
            }
            IconButton {
                icon: @image-url("icons/chevron-right.svg"); label: @tr("Longer slowmode"); size: 32px; glyph: 18px;
                clicked => { root.slowmode(min(root.slowmodes.length - 1, root.prompt.slowmode + 1)); }
            }
        }
        Label { text: @tr("Members will be restricted to sending one message and creating one thread per this interval, unless they have Bypass Slowmode, Manage Channel or Manage Messages permissions."); }
    }
    if root.prompt.kind == 0: SettingsSwitch {
        text: @tr("Age-Restricted Channel");
        description: @tr("Users will need to confirm they are of over legal age to view the content in this channel. Age-restricted channels are exempt from the explicit content filter.");
        checked: root.prompt.nsfw; controlled: true; enabled: !root.prompt.saving;
        toggled(on) => { root.nsfw(on); }
    }
}

// Permissions: the sync notice, Private Channel, and the overwrites beside the
// shown one's permissions, which a list view makes only in sight.
component PermissionsSection inherits VerticalLayout {
    in property <ChannelSettingsPrompt> prompt;
    /// What was done; see ChannelSettingsScreen's `input`.
    callback input(int, string, int);
    spacing: 16px; vertical-stretch: 1;
    SettingsTitle { text: root.prompt.title; }
    Label { text: root.prompt.subtitle; }
    if root.prompt.sync != 0: Rectangle {
        border-radius: 6px; background: Theme.raised; height: sync.preferred-height;
        sync := HorizontalLayout {
            padding: 10px; padding-left: 12px; spacing: 12px;
            Text {
                text: (root.prompt.sync == 1 ? @tr("Permissions synced with category: ") : @tr("Permissions not synced with category: ")) + root.prompt.category;
                color: Theme.secondary; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
            }
            if root.prompt.sync == 2: ActionButton {
                text: @tr("Sync Now"); primary: true; enabled: root.prompt.may-edit && !root.prompt.saving;
                clicked => { root.input(25, "", 0); }
            }
        }
    }
    Rectangle {
        border-radius: 8px; background: Theme.raised; height: private.preferred-height;
        private := HorizontalLayout {
            padding: 14px;
            SettingsSwitch {
                text: root.prompt.private-title; description: root.prompt.private-text;
                checked: root.prompt.private; controlled: true;
                enabled: root.prompt.may-edit && !root.prompt.saving && root.prompt.private-lock == "";
                locked-tip: root.prompt.private-lock;
                toggled(on) => { root.input(15, "", on ? 1 : 0); }
            }
        }
    }
    SettingsHeading { text: @tr("ADVANCED PERMISSIONS"); }
    HorizontalLayout {
        spacing: 16px; vertical-stretch: 1;
        VerticalLayout {
            width: 180px; spacing: 4px;
            HorizontalLayout {
                height: 28px;
                Text { text: @tr("ROLES/MEMBERS"); color: Theme.muted; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton {
                    icon: @image-url("icons/circle-plus.svg"); label: @tr("Add a role or member"); size: 28px; glyph: 16px;
                    enabled: root.prompt.may-edit && !root.prompt.saving;
                    clicked => { root.input(20, "", 0); }
                }
            }
            ListView {
                vertical-stretch: 1;
                for row in root.prompt.overwrites: Rectangle {
                    height: 32px; border-radius: 4px;
                    background: row.selected ? Theme.active : area.has-hover ? Theme.hover : transparent;
                    accessible-role: button; accessible-label: row.name;
                    area := TouchArea { clicked => { root.input(13, row.id, 0); } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        if !row.member: Middle {
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: row.color; }
                        }
                        if row.member: Middle {
                            Image { width: 14px; height: 14px; source: @image-url("icons/user.svg"); colorize: Theme.muted; }
                        }
                        Text {
                            text: row.name; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            color: row.selected ? Theme.text : Theme.secondary;
                        }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1;
            ListView {
                vertical-stretch: 1;
                for row in root.prompt.permissions: VerticalLayout {
                    padding-top: row.heading ? 12px : 4px;
                    if row.heading: SettingsHeading { text: row.title; }
                    if !row.heading: ThreeStateLine {
                        permission: row; enabled: root.prompt.may-edit && !root.prompt.saving;
                        chose(state) => { root.input(14, "", row.bit * 3 + state); }
                    }
                }
            }
            if !root.prompt.shown-everyone: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: @tr("Remove {}", root.prompt.shown-name); danger: true; ghost: true;
                    enabled: root.prompt.may-edit && !root.prompt.saving;
                    clicked => { root.input(24, "", 0); }
                }
            }
        }
    }
}

// What Permissions asks or tells, over the screen.
component OverwriteConfirmDialog inherits Rectangle {
    in property <ChannelSettingsPrompt> prompt;
    in property <string> channel;
    callback confirm;
    callback cancel;
    background: #000000aa;
    TouchArea { clicked => { root.cancel(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 12px;
                Text {
                    text: root.prompt.confirm == 1 ? @tr("Delete Permission Settings")
                        : root.prompt.confirm == 2 ? @tr("Sync permissions?")
                        : @tr("Pretty sure you don't want to do this");
                    color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap;
                }
                Text {
                    text: root.prompt.confirm == 1
                        ? @tr("Are you sure you want to delete {} permissions? This action cannot be undone.", root.prompt.confirm-name)
                        : root.prompt.confirm == 2
                        ? @tr("Would you like to sync {0} permissions with {1}?", root.channel, root.prompt.category)
                        : @tr("You cannot deny this permission to {} because it will deny it to you as well. Allow another role or yourself before trying again.", root.prompt.confirm-name);
                    color: Theme.secondary; font-size: 15px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton {
                        text: root.prompt.confirm == 2 ? @tr("Keep Current Permissions") : root.prompt.confirm == 3 ? @tr("Okay") : @tr("Cancel");
                        ghost: root.prompt.confirm != 3; primary: root.prompt.confirm == 3;
                        clicked => { root.cancel(); }
                    }
                    if root.prompt.confirm != 3: ActionButton {
                        text: root.prompt.confirm == 1 ? @tr("Delete") : @tr("Sync Permissions");
                        danger: root.prompt.confirm == 1; primary: root.prompt.confirm == 2;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

// Add's picker, over the screen: the roles without an overwrite, then the
// members whose names start with what's typed; choosing one adds it at once.
component AddOverwriteDialog inherits Rectangle {
    in property <ChannelSettingsPrompt> prompt;
    callback search(string);
    callback role(string);
    callback member(string);
    callback close;
    background: #000000aa;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        Rectangle {
            width: 400px; height: min(480px, root.height - 80px);
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: @tr("Add:"); color: Theme.text; font-size: 20px; font-weight: 700; }
                TextField {
                    placeholder: @tr("Role/Member"); label: @tr("Role or member"); text-size: 14px;
                    init => { self.focus-input(); }
                    edited(text) => { root.search(text); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        if root.prompt.roles-to-add.length > 0: SettingsHeading { text: @tr("ROLES"); }
                        for role in root.prompt.roles-to-add: Rectangle {
                            height: 36px; border-radius: 4px;
                            background: role-area.has-hover ? Theme.hover : transparent;
                            accessible-role: button; accessible-label: role.name;
                            role-area := TouchArea { clicked => { root.role(role.id); } }
                            HorizontalLayout {
                                padding-left: 8px; spacing: 10px;
                                Middle { Rectangle { width: 10px; height: 10px; border-radius: 5px; background: role.color; } }
                                Text { text: role.name; color: Theme.text; font-size: 15px; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        if root.prompt.members-found.length > 0: SettingsHeading { text: @tr("MEMBERS"); }
                        for member in root.prompt.members-found: Rectangle {
                            height: 40px; border-radius: 4px;
                            background: member-area.has-hover ? Theme.hover : transparent;
                            accessible-role: button; accessible-label: member.name;
                            member-area := TouchArea { clicked => { root.member(member.id); } }
                            HorizontalLayout {
                                padding-left: 6px; spacing: 10px;
                                Middle { Avatar { size: 26px; initial: member.initial; picture-url: member.avatar-url; } }
                                Middle {
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Text { text: member.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                        Text { text: member.username; color: Theme.muted; font-size: 14px; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                }
            }
        }
    }
}

// A channel's settings, on a card over the window: its pages down the left, the
// chosen one on the right, and Discord's bar once the page has unsaved
// changes.
export component ChannelSettingsScreen inherits Rectangle {
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    in property <ChannelSettingsPrompt> prompt;
    in property <string> channel;
    in-out property <string> name;
    in-out property <string> topic;
    /// What was done: 0 the name written, 1 the topic, 2 Add's search;
    /// 10 a page chosen, 11 a slowmode, 12 age restriction; 13 an overwrite
    /// shown, by id; 14 a permission set, as its bit times 3 plus 0 deny, 1
    /// neither or 2 allow; 15 private; 20 Add opened, 21 closed, 22 a role
    /// added, 23 a member, by id; 24 Remove, 25 Sync Now, 26 confirmed, 27
    /// cancelled; 30 Reset, 31 Save, 32 closed.
    callback input(int, string, int);
    property <bool> bar: root.prompt.changed || root.prompt.saving;
    SettingsCard {
        motion: root.motion;
        close => { root.input(32, "", 0); }
        frame := SettingsFrame {
            rows: root.prompt.rows; selected: root.prompt.section; label: @tr("Channel settings");
            bottom: root.bar ? 140px : 56px;
            fill: root.prompt.loaded && root.prompt.section == 1;
            chose(id) => { root.input(10, "", id); }
            close => { root.input(32, "", 0); }
            if root.prompt.loading: Label { text: @tr("Loading..."); }
            if root.prompt.loaded && root.prompt.section == 0: OverviewSection {
                prompt: root.prompt; name <=> root.name; topic <=> root.topic;
                write(field, text) => { root.input(field, text, 0); }
                slowmode(index) => { root.input(11, "", index); }
                nsfw(on) => { root.input(12, "", on ? 1 : 0); }
            }
            if root.prompt.loaded && root.prompt.section == 1: PermissionsSection {
                prompt: root.prompt;
                input(what, text, number) => { root.input(what, text, number); }
            }
            if root.prompt.problem != "": Text { text: root.prompt.problem; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
            if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        }
        if root.bar: UnsavedBar {
            x: frame.content-x + 24px; width: min(700px, frame.content-width - 48px);
            y: frame.height - self.height - 24px;
            border-radius: 8px; drop-shadow-blur: 16px; drop-shadow-color: #00000066; drop-shadow-offset-y: 4px;
            saving: root.prompt.saving; may-save: root.prompt.may-save; nudge: root.prompt.nudge;
            undo => { frame.focus-keys(); root.input(30, "", 0); }
            save => { frame.focus-keys(); root.input(31, "", 0); }
        }
    }
    if root.prompt.confirm != 0: OverwriteConfirmDialog {
        prompt: root.prompt; channel: root.channel;
        confirm => { root.input(26, "", 0); frame.focus-keys(); }
        cancel => { root.input(27, "", 0); frame.focus-keys(); }
    }
    if root.prompt.adding: AddOverwriteDialog {
        prompt: root.prompt;
        search(text) => { root.input(2, text, 0); }
        role(id) => { root.input(22, id, 0); frame.focus-keys(); }
        member(id) => { root.input(23, id, 0); frame.focus-keys(); }
        close => { root.input(21, "", 0); frame.focus-keys(); }
    }
}
