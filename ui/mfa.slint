import { Theme, Label, Popup } from "theme.slint";
import { ActionButton, IconButton, MenuItem, TextField } from "controls.slint";

/// A way to confirm that the prompt lists, by its id: 0 an authenticator
/// app, 1 a text, 2 the password, 3 a backup code.
export struct MfaChoice { id: int, text: string }

/// What the two-factor prompt shows.
export struct MfaPrompt {
    /// Which prompt it is: one waiting after another starts its own wait.
    id: int,
    /// Listing the ways to confirm, as "Verify with something else" does,
    /// rather than using one.
    listing: bool,
    /// Discord's warning before a backup code, "Slow down! Are you sure?",
    /// which Confirm goes past.
    warning: bool,
    /// What it asks for, and the field's placeholder; no field when Discord
    /// offers only a passkey.
    text: string,
    field: string,
    password: bool,
    /// The ways to confirm; with more than one, another may be chosen.
    choices: [MfaChoice],
    /// A text's code may be sent again.
    resend: bool,
    busy: bool,
    ready: bool,
    error: string,
}

// Discord's "Multi-Factor Authentication" prompt, for a request Discord holds
// back until this account confirms: a code from an authenticator app or a
// text, the password, or a backup code, then the request goes again.
// Cancelling fails the request.
export component MfaDialog inherits Rectangle {
    in property <MfaPrompt> prompt;
    in-out property <string> code;
    callback choose(int);
    callback write(string);
    callback resend;
    callback confirm;
    callback cancel;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    // The warning's button waits ten seconds, as Discord's does, each time
    // it shows.
    property <bool> warning: root.prompt.warning;
    property <int> wait: 10;
    property <int> shown: root.prompt.id;
    changed warning => { if self.warning { self.wait = 10; keys.focus(); } }
    changed shown => { self.wait = 10; }
    Timer { interval: 1s; running: root.warning && root.wait > 0; triggered => { root.wait -= 1; } }
    TouchArea { }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: @tr("Multi-Factor Authentication");
        TouchArea { }
        keys := FocusScope {
            init => { if root.prompt.listing || root.prompt.warning || root.prompt.field == "" { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { root.cancel(); return accept; }
                return reject;
            }
            content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: @tr("Multi-Factor Authentication"); color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel"); size: 28px; glyph: 18px; clicked => { root.cancel(); } }
                }
                if root.prompt.listing: VerticalLayout {
                    spacing: 2px;
                    Label { text: @tr("Choose how to confirm it's you."); }
                    for choice in root.prompt.choices: MenuItem {
                        text: choice.text;
                        clicked => { root.choose(choice.id); }
                    }
                }
                // Discord's warning before a backup code.
                if root.prompt.warning: Text { text: @tr("Slow down! Are you sure?"); color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                if root.prompt.warning: Label { text: @tr("Backup codes can only be used one time each and are for emergency access to your account!"); }
                if root.prompt.warning && root.prompt.choices.length > 1: Label { text: @tr("If you have access to any of your other methods, select ‘Verify with something else’ to go back."); }
                if root.prompt.warning: Label {
                    text: root.wait > 0
                        ? @tr("If you do not have access to any other methods, the button below will activate in {} seconds.", root.wait)
                        : @tr("If you do not have access to any other methods, use the other button below to proceed.");
                }
                // Its button on a row of its own, as Discord's fills the width.
                if root.prompt.warning: ActionButton {
                    text: @tr("I’m sure, use a backup code"); primary: true; enabled: root.wait == 0;
                    clicked => { root.confirm(); }
                }
                if !root.prompt.listing && !root.prompt.warning: Label { text: root.prompt.text; }
                if !root.prompt.listing && !root.prompt.warning && root.prompt.field != "": TextField {
                    init => { self.focus-input(); }
                    enabled: !root.prompt.busy; password: root.prompt.password;
                    min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: root.prompt.field; label: root.prompt.field;
                    text <=> root.code;
                    edited(text) => { root.write(text); }
                    accepted => { if root.prompt.ready { root.confirm(); } }
                }
                if root.prompt.error != "": Text {
                    text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    if !root.prompt.listing && root.prompt.choices.length > 1: ActionButton {
                        text: @tr("Verify with something else"); ghost: true; small: true; enabled: !root.prompt.busy;
                        clicked => { root.choose(-1); }
                    }
                    if !root.prompt.listing && root.prompt.resend: ActionButton {
                        text: @tr("Resend Code"); ghost: true; small: true; enabled: !root.prompt.busy;
                        clicked => { root.resend(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { text: @tr("Cancel"); ghost: true; clicked => { root.cancel(); } }
                    if !root.prompt.listing && !root.prompt.warning && root.prompt.field != "": ActionButton {
                        text: root.prompt.busy ? @tr("Confirming...") : @tr("Confirm"); primary: true;
                        enabled: root.prompt.ready;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}
