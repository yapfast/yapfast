import { Theme, Middle, Label, Tip } from "theme.slint";
import { ActionButton, Avatar, TextField } from "controls.slint";
import { Picker, SettingsTitle, SettingsHeading, SettingsSwitch } from "settings.slint";
import { ListView } from "scrollview.slint";
import { RoleMemberRow } from "roles.slint";

/// A choice of Safety Setup's: a verification level or a content filter.
export struct SafetyOption {
    value: int,
    title: string,
    description: string,
    /// Discord's colour for it, or transparent for none.
    color: color,
    /// Discord offers it: a Community server can't have the lowest.
    enabled: bool,
}

/// What Safety Setup shows.
export struct SafetyPrompt {
    verification-options: [SafetyOption],
    verification: int,
    filter-options: [SafetyOption],
    filter: int,
    /// Explains the verification level, as Discord words it for the kind of
    /// server.
    verification-text: string,
    /// Moderators need two-factor authentication; the switch's words, why
    /// it can't move, and a note under it for an owner without 2FA.
    mfa-on: bool,
    mfa-text: string,
    mfa-lock: string,
    mfa-note: string,
}

/// What Bans shows.
export struct BansPrompt {
    /// The bans on the page shown.
    rows: [RoleMemberRow],
    /// From 0, and how many there are.
    page: int,
    pages: int,
    /// Discord is sending a batch or a search's bans.
    fetching: bool,
    /// A ban shown in its dialog: the username, the reason, and why
    /// Discord didn't lift it.
    open: bool,
    open-name: string,
    open-reason: string,
    open-error: string,
    unbanning: bool,
    /// This account may lift bans: Ban Members.
    may-unban: bool,
}

/// A row of Audit Log: who did what, and when.
export struct AuditRow {
    initial: string,
    avatar-url: string,
    title: styled-text,
    time: string,
    /// 0 made something, 1 changed it, 2 removed it, which colours the
    /// lines' numbers.
    kind: int,
    /// It has lines to open.
    expandable: bool,
}

/// A line of the open row, or an item under one, such as a permission.
export struct AuditLineRow {
    /// "01" and on; empty for an item.
    number: string,
    text: styled-text,
}

/// What Audit Log shows.
export struct AuditLogPrompt {
    rows: [AuditRow],
    /// The row whose lines show, by its place, or -1, and its lines.
    open: int,
    lines: [AuditLineRow],
    /// The filters' choices, everyone and every action first, and the
    /// chosen ones.
    users: [string],
    user: int,
    actions: [string],
    action: int,
    fetching: bool,
    /// Discord may have older entries.
    older: bool,
    /// Discord didn't send the newest.
    failed: bool,
}

// Choices as Discord's Safety Setup lists them: each with its title in its
// colour and what it means, the chosen one marked.
component SafetyChoices inherits VerticalLayout {
    in property <[SafetyOption]> options;
    in property <int> chosen;
    in property <bool> enabled;
    in property <string> label;
    callback choose(int);
    spacing: 4px;
    accessible-role: list;
    accessible-label: root.label;
    for option in root.options: choice := Rectangle {
        property <bool> usable: root.enabled && option.enabled;
        property <bool> on: option.value == root.chosen;
        height: line.preferred-height;
        border-radius: 6px;
        background: self.on ? Theme.overlay.with-alpha(0.08) : area.has-hover && self.usable ? Theme.overlay.with-alpha(0.05) : transparent;
        opacity: option.enabled ? 1 : 0.5;
        accessible-role: checkbox; accessible-label: option.title; accessible-checked: self.on;
        accessible-description: option.description;
        accessible-action-default => { if choice.usable { root.choose(option.value); } }
        area := TouchArea { enabled: choice.usable; clicked => { root.choose(option.value); } }
        line := HorizontalLayout {
            padding: 10px; spacing: 12px;
            Middle {
                Rectangle {
                    width: 20px; height: 20px; border-radius: 10px;
                    border-width: 2px; border-color: choice.on ? Theme.accent : Theme.secondary;
                    if choice.on: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
                }
            }
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1;
                Text {
                    text: option.title; font-size: 15px; font-weight: 600;
                    color: option.color.alpha > 0 ? option.color : Theme.text;
                }
                Text { text: option.description; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
            }
        }
    }
}

// Safety Setup: the verification level, whether moderators need two-factor
// authentication, and the sensitive content filter, each saved as it's chosen,
// as Discord's page has them.
export component SafetySection inherits VerticalLayout {
    in property <SafetyPrompt> page;
    in property <bool> saving;
    /// 0 a verification level, 1 a content filter, 2 two-factor on or off;
    /// by its value.
    callback choose(int, int);
    spacing: 16px;
    SettingsTitle { text: @tr("Safety Setup"); }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("VERIFICATION LEVEL"); }
        Label { text: root.page.verification-text; }
        SafetyChoices {
            label: @tr("Verification Level"); options: root.page.verification-options;
            chosen: root.page.verification; enabled: !root.saving;
            choose(value) => { root.choose(0, value); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsSwitch {
            text: @tr("Require 2FA for moderator actions"); description: root.page.mfa-text;
            checked: root.page.mfa-on; controlled: true;
            enabled: !root.saving && root.page.mfa-lock == "";
            locked-tip: root.page.mfa-lock;
            toggled(on) => { root.choose(2, on ? 1 : 0); }
        }
        if root.page.mfa-note != "": Rectangle {
            border-radius: 6px; background: Theme.sunken;
            height: note.preferred-height + 20px;
            note := Text {
                x: 12px; width: parent.width - 24px;
                text: root.page.mfa-note; color: Theme.secondary; font-size: 14px; wrap: word-wrap;
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("SENSITIVE CONTENT FILTERS"); }
        Label { text: @tr("Choose if server members can share image-based media detected by Discord's sensitive content filters. This setting will apply to channels that are not age-restricted."); }
        SafetyChoices {
            label: @tr("Sensitive content filters"); options: root.page.filter-options;
            chosen: root.page.filter; enabled: !root.saving;
            choose(value) => { root.choose(1, value); }
        }
    }
}

// Bans: the server's ban list, a page at a time, with Discord's search by
// username or id.
export component BansSection inherits VerticalLayout {
    in property <BansPrompt> page;
    property <string> query;
    /// 0 the search's text, 1 search, 2 go to a page, 3 show a ban by id.
    callback act(int, string, int);
    spacing: 16px;
    SettingsTitle { text: @tr("Server Ban List"); }
    Label { text: @tr("Bans by default are by account and IP.\nA user can circumvent an IP ban by using a proxy.\nBan circumvention can be made very hard by enabling phone verification in Safety Setup."); }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            text <=> root.query; placeholder: @tr("Search Bans by User Id or Username");
            label: @tr("Search Bans by User Id or Username"); text-size: 14px;
            edited(text) => { root.act(0, text, 0); }
            accepted => { root.act(1, "", 0); }
        }
        ActionButton {
            text: @tr("Search"); primary: true; enabled: !root.page.fetching;
            clicked => { root.act(1, "", 0); }
        }
    }
    if root.page.rows.length == 0 && !root.page.fetching: VerticalLayout {
        alignment: center; spacing: 8px; vertical-stretch: 1;
        Text { text: @tr("No Bans"); color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
        Text { text: @tr("You haven't banned anybody...\nbut if and when you must, do not hesitate!"); color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
    }
    if root.page.rows.length == 0 && root.page.fetching: Label { text: @tr("Loading..."); vertical-stretch: 1; }
    if root.page.rows.length > 0: ListView {
        vertical-stretch: 1; min-height: 120px;
        for ban in root.page.rows: Rectangle {
            height: 60px; border-radius: 6px;
            background: area.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
            accessible-role: button; accessible-label: ban.name;
            accessible-action-default => { root.act(3, ban.id, 0); }
            area := TouchArea { clicked => { root.act(3, ban.id, 0); } }
            HorizontalLayout {
                padding-left: 8px; padding-right: 12px; spacing: 12px;
                Middle { Avatar { size: 40px; initial: ban.initial; picture-url: ban.avatar-url; } }
                Middle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: ban.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                        if ban.username != "": Text { text: ban.username; color: Theme.secondary; font-size: 14px; overflow: elide; }
                    }
                }
            }
        }
    }
    if root.page.pages > 1: HorizontalLayout {
        spacing: 12px; alignment: center;
        ActionButton {
            text: @tr("Previous"); ghost: true; enabled: root.page.page > 0;
            clicked => { root.act(2, "", root.page.page - 1); }
        }
        Middle { Text { text: @tr("Page {0} of {1}", (root.page.page + 1), root.page.pages); color: Theme.secondary; font-size: 14px; } }
        ActionButton {
            text: @tr("Next"); ghost: true; enabled: root.page.page + 1 < root.page.pages;
            clicked => { root.act(2, "", root.page.page + 1); }
        }
    }
}

// A ban, over the screen: who, why, and Revoke Ban for someone who may.
export component BanDialog inherits Rectangle {
    in property <BansPrompt> page;
    callback unban;
    callback close;
    background: #000000aa;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            accessible-role: groupbox; accessible-label: root.page.open-name;
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: root.page.open-name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("Ban Reason"); color: Theme.text; font-size: 15px; font-weight: 500; }
                    Text { text: root.page.open-reason; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                }
                if root.page.open-error != "": Text { text: root.page.open-error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                if root.page.may-unban: HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton {
                        text: root.page.unbanning ? @tr("Revoking...") : @tr("Revoke Ban"); danger: true; enabled: !root.page.unbanning;
                        clicked => { root.unban(); }
                    }
                    ActionButton { text: @tr("Done"); primary: true; clicked => { root.close(); } }
                }
            }
        }
    }
}

// A filter of Audit Log's: a label over a list.
component AuditFilter inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> chosen;
    in property <bool> enabled;
    callback choose(int);
    spacing: 4px; width: 230px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; font-weight: 700; }
    Picker {
        model: root.options; chosen: root.chosen; enabled: root.enabled;
        accessible-label: root.label;
        selected => { root.choose(self.current-index); }
    }
}

// Audit Log: who did what in the server, newest first, with Discord's
// filters by user and by action. A row's arrow opens its numbered lines;
// older entries load at the end of the list.
export component AuditLogSection inherits VerticalLayout {
    in property <AuditLogPrompt> page;
    /// 0 filter by user and 1 by action, by index; 2 load older entries;
    /// 3 open or close a row, by its place.
    callback act(int, int);
    spacing: 16px;
    HorizontalLayout {
        spacing: 16px;
        Middle { horizontal-stretch: 1; SettingsTitle { text: @tr("Audit Log"); } }
        // Discord's client ignores a filter while it's fetching.
        AuditFilter {
            label: @tr("Filter by User"); options: root.page.users; chosen: root.page.user;
            enabled: !root.page.fetching;
            choose(index) => { root.act(0, index); }
        }
        AuditFilter {
            label: @tr("Filter by Action"); options: root.page.actions; chosen: root.page.action;
            enabled: !root.page.fetching;
            choose(index) => { root.act(1, index); }
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    if root.page.rows.length == 0 && root.page.fetching: Label { text: @tr("Loading..."); vertical-stretch: 1; }
    if root.page.rows.length == 0 && !root.page.fetching: VerticalLayout {
        alignment: center; spacing: 8px; vertical-stretch: 1;
        Text {
            text: root.page.failed ? @tr("This is Awkward") : @tr("No Logs Yet");
            color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center;
        }
        Text {
            text: root.page.failed ? @tr("We broke something. Come back later.") : @tr("Once moderators begin moderating, you can moderate the moderation here.");
            color: Theme.secondary; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
        }
    }
    if root.page.rows.length > 0: list := ListView {
        vertical-stretch: 1; min-height: 120px;
        // The end of the list loads older entries, as Discord's does.
        changed content-y => {
            if root.page.older && !root.page.fetching && self.content-y <= self.visible-height - self.content-height + 8px {
                root.act(2, 0);
            }
        }
        for row[index] in root.page.rows: VerticalLayout {
            property <bool> open: index == root.page.open;
            padding-bottom: 8px;
            Rectangle {
                border-radius: 8px; border-width: 1px; border-color: Theme.line;
                background: Theme.overlay.with-alpha(0.02);
                VerticalLayout {
                    Rectangle {
                        height: head.preferred-height;
                        background: area.has-hover && row.expandable ? Theme.overlay.with-alpha(0.04) : transparent;
                        border-radius: 8px;
                        accessible-role: button;
                        accessible-label: row.time;
                        accessible-expandable: row.expandable;
                        accessible-expanded: open;
                        accessible-action-default => { if row.expandable { root.act(3, index); } }
                        head := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            Middle { Avatar { size: 40px; initial: row.initial; picture-url: row.avatar-url; } }
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                StyledText { text: row.title; default-color: Theme.secondary; default-font-size: 15px; max-lines: 1; }
                                Text { text: row.time; color: Theme.muted; font-size: 13px; overflow: elide; }
                            }
                            if row.expandable: Middle {
                                Image {
                                    source: open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                                    width: 18px; height: 18px; colorize: Theme.muted;
                                }
                            }
                        }
                        // Over the sentence, which would take the click.
                        area := TouchArea {
                            enabled: row.expandable; mouse-cursor: row.expandable ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { root.act(3, index); }
                        }
                    }
                    if open: Rectangle { height: 1px; background: Theme.line; }
                    if open: VerticalLayout {
                        padding: 12px; spacing: 4px;
                        for line in root.page.lines: HorizontalLayout {
                            spacing: 6px;
                            padding-left: line.number == "" ? 52px : 0px;
                            if line.number != "": Text {
                                text: line.number + "—"; font-size: 14px; font-weight: 600;
                                color: row.kind == 0 ? Theme.live : row.kind == 2 ? Theme.danger : Theme.accent;
                            }
                            StyledText {
                                horizontal-stretch: 1; text: line.text;
                                default-color: line.number == "" ? Theme.muted : Theme.secondary;
                                default-font-size: line.number == "" ? 13px : 14px;
                            }
                        }
                    }
                }
            }
        }
    }
    if root.page.rows.length > 0 && root.page.older: HorizontalLayout {
        alignment: center;
        ActionButton {
            text: root.page.fetching ? @tr("Loading...") : @tr("Load More"); enabled: !root.page.fetching;
            clicked => { root.act(2, 0); }
        }
    }
}
