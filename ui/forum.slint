import { ListView } from "scrollview.slint";
import { Theme, Middle } from "theme.slint";
import { PictureStore, IconButton, ActionButton, TextField } from "controls.slint";
import { HeaderSearch } from "header.slint";
import { Composer, StagedTile, StagedFile } from "composer.slint";

/// A forum's tag, or an emoji, as a post's card shows it: a Unicode emoji's
/// text, or a custom one's picture.
export struct PostTag {
    name: string,
    emoji: string, emoji-url: string,
}

/// An entry of a forum's list of posts: a heading, or a post's card, as
/// Discord's client shows them.
export struct PostRow {
    /// The post's room id; empty for a heading alone.
    room: string,
    /// A heading, such as "Older posts", above the post if it has a room.
    heading: string,
    name: string,
    /// Pinned to the top; made since the forum was last read and never
    /// opened; opened, with messages to read.
    pinned: bool, new: bool, unread: bool,
    /// Its first tags, and how many more it has, as "+2".
    tags: [PostTag], more-tags: string,
    /// Who wrote its first message, in their role colour, and its text; or
    /// what to say for none, such as that it was deleted.
    person: string, color: color, has-color: bool,
    text: string,
    /// The reaction most given, or the forum's own for none, without a count.
    reaction: PostTag, reaction-count: string, has-reaction: bool,
    /// Its replies, as "3", and when it was last active or made.
    replies: string,
    time: string,
    /// Its first picture, as a thumbnail, and whether it's a spoiler.
    picture-url: string, spoiler: bool,
}

// A picture the window keeps by address, as avatars are, asked for as it
// shows.
component StoredImage inherits Image {
    in property <string> url;
    source: PictureStore.picture(root.url, PictureStore.revision(root.url));
    function request() {
        if root.url != "" && self.source.width == 0 { PictureStore.request(root.url); }
    }
    init => { root.request(); }
    changed url => { root.request(); }
}

/// A tag the form for a post offers, and whether the post has it.
export struct PostTagChoice {
    id: string,
    tag: PostTag,
    chosen: bool,
}

// An emoji on a tag or a reaction.
component PostEmoji inherits HorizontalLayout {
    in property <PostTag> emoji;
    in property <length> size: 14px;
    if root.emoji.emoji-url != "": Middle {
        StoredImage { url: root.emoji.emoji-url; width: root.size; height: root.size; image-fit: contain; }
    }
    if root.emoji.emoji-url == "" && root.emoji.emoji != "": Middle {
        Text { text: root.emoji.emoji; font-size: root.size * 0.95; vertical-alignment: center; }
    }
}

// A tag on a post's card, as a pill.
component TagPill inherits Rectangle {
    in property <PostTag> tag;
    height: 20px; border-radius: 10px;
    background: Theme.raised;
    width: row.preferred-width;
    row := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 4px;
        if root.tag.emoji != "" || root.tag.emoji-url != "": PostEmoji { emoji: root.tag; size: 12px; }
        Middle { Text { text: root.tag.name; color: Theme.secondary; font-size: 12px; font-weight: 600; } }
    }
}

// A post's card, as Discord's client lays one out in a list: its tags, its
// title, who wrote its first message and how it starts, then its top
// reaction, its replies and when it was last active; its first picture on
// the right. Clicking opens it beside the forum; with Shift, in its place.
component PostCard inherits Rectangle {
    in property <PostRow> entry;
    in property <bool> first;
    callback open(bool);
    property <bool> shift;
    property <bool> has-tags: root.entry.pinned || root.entry.tags.length > 0;
    property <length> card: root.has-tags ? 120px : 96px;
    height: (root.entry.heading != "" ? (root.first ? 32px : 56px) : (root.first ? 16px : 0px))
        + (root.entry.room != "" ? root.card + 8px : 0px);
    if root.entry.heading != "": Text {
        x: 16px; y: root.first ? 8px : 32px; height: 24px; width: root.width - 32px;
        text: root.entry.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.4px;
        vertical-alignment: center; overflow: elide;
    }
    if root.entry.room != "": Rectangle {
        y: root.height - root.card - 8px; height: root.card; x: 16px; width: root.width - 32px;
        border-radius: 8px; border-width: 1px;
        background: pointer.has-hover ? Theme.raised : Theme.hover;
        border-color: pointer.has-hover ? Theme.active : Theme.line;
        accessible-role: button;
        accessible-label: @tr("{0}{1}{2}, {3} replies, {4}", root.entry.name, (root.entry.new ? @tr(", new") : ""), (root.entry.pinned ? @tr(", pinned") : ""), root.entry.replies, root.entry.time);
        accessible-action-default => { root.open(false); }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { root.shift = event.modifiers.shift; }
            }
            clicked => { root.open(!root.shift); }
        }
        HorizontalLayout {
            padding: 12px; padding-left: 16px; spacing: 16px;
            VerticalLayout {
                spacing: 6px; horizontal-stretch: 1; alignment: center;
                if root.has-tags: HorizontalLayout {
                    spacing: 6px; height: 20px;
                    if root.entry.pinned: Middle {
                        Image { source: @image-url("icons/pin.svg"); width: 14px; height: 14px; colorize: Theme.muted; accessible-label: @tr("Pinned"); }
                    }
                    for tag in root.entry.tags: Middle { TagPill { tag: tag; } }
                    if root.entry.more-tags != "": Middle {
                        Text { text: root.entry.more-tags; color: Theme.muted; font-size: 12px; font-weight: 600; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.entry.name; font-size: 16px; font-weight: 700; overflow: elide;
                        color: root.entry.unread || root.entry.new ? Theme.text : Theme.secondary;
                        horizontal-stretch: 1; max-width: self.preferred-width;
                    }
                    if root.entry.new: Middle {
                        Rectangle {
                            width: badge.preferred-width + 10px; height: 16px; border-radius: 8px; background: Theme.accent;
                            badge := Text { text: @tr("NEW"); color: #ffffff; font-size: 10px; font-weight: 800; letter-spacing: 0.3px; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 0px; height: 18px;
                    if root.entry.person != "": Text {
                        text: root.entry.person; color: root.entry.has-color ? root.entry.color : Theme.secondary;
                        font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 0;
                    }
                    Text {
                        text: (root.entry.person != "" && root.entry.text != "" ? ": " : "") + root.entry.text;
                        color: Theme.muted; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px; height: 22px;
                    if root.entry.has-reaction: Middle {
                        Rectangle {
                            height: 22px; width: reaction.preferred-width; border-radius: 6px;
                            background: Theme.raised; border-width: 1px; border-color: Theme.line;
                            reaction := HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; spacing: 4px;
                                PostEmoji { emoji: root.entry.reaction; size: 14px; }
                                if root.entry.reaction-count != "": Middle {
                                    Text { text: root.entry.reaction-count; color: Theme.secondary; font-size: 13px; font-weight: 600; }
                                }
                            }
                        }
                    }
                    Middle {
                        Image { source: @image-url("icons/message-circle.svg"); width: 14px; height: 14px; colorize: Theme.muted; }
                    }
                    Middle { Text { text: root.entry.replies; color: Theme.muted; font-size: 13px; font-weight: 600; } }
                    Middle { Text { text: "•"; color: Theme.faint; font-size: 13px; } }
                    Middle { Text { text: root.entry.time; color: Theme.muted; font-size: 13px; } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.entry.picture-url != "": Middle {
                Rectangle {
                    width: 72px; height: 72px; border-radius: 8px; clip: true; background: Theme.raised;
                    StoredImage { url: root.entry.picture-url; width: 72px; height: 72px; image-fit: cover; }
                    if root.entry.spoiler: Rectangle {
                        background: Theme.raised;
                        Text { text: @tr("SPOILER"); color: Theme.muted; font-size: 10px; font-weight: 800; }
                    }
                }
            }
        }
    }
}

// A Discord forum in place of a channel's messages, as Discord's client
// shows it: a search of its posts' titles, then its posts as cards, the
// active ones first and older ones a page at a time as the list scrolls,
// or what a search found. Enter searches, and clearing it shows the posts
// again.
// The form for a post, as Discord's at the top of a forum: a title, up to
// five of the forum's tags, its post guidelines, and a first message with
// files. Enter in the message posts; closing after writing asks first.
component NewPostForm inherits Rectangle {
    in-out property <string> title;
    in-out property <string> body;
    /// The tags chosen, in the order they were, and those the post may take.
    in property <[PostTagChoice]> chosen-tags;
    in property <[PostTagChoice]> tag-choices;
    in property <bool> tag-required;
    /// Fewer than five tags are chosen.
    in property <bool> more-tags;
    in property <styled-text> guidelines;
    in property <bool> has-guidelines;
    in property <[StagedFile]> staged;
    in property <bool> can-attach;
    in property <bool> can-mark-spoilers;
    in property <bool> posting;
    in property <string> error;
    in property <bool> leaving;
    callback title-edited(string);
    callback body-edited(string);
    callback toggle-tag(string);
    callback attach;
    callback unstage(int);
    callback toggle-spoiler(int);
    callback create;
    callback close;
    callback leave;
    callback stay;
    callback open-link(string);
    public function focus-title() { title-field.focus-input(); }
    property <bool> show-guidelines: true;
    // Where the menu of tags opens: under its button.
    property <length> menu-x;
    property <length> menu-y;
    accessible-role: groupbox;
    accessible-label: @tr("New Post");
    VerticalLayout {
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                Middle { Image { source: @image-url("icons/thread.svg"); width: 18px; height: 18px; colorize: Theme.muted; } }
                Text { text: @tr("New Post"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: max(self.height, fields.preferred-height);
            fields := VerticalLayout {
                width: parent.width;
                padding: 16px; spacing: 16px; alignment: start;
                VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("POST TITLE"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                    title-field := TextField {
                        text <=> root.title; placeholder: @tr("Title"); label: @tr("Post title");
                        enabled: !root.posting;
                        edited(text) => { root.title-edited(text); }
                        accepted => { message.focus-input(); }
                    }
                }
                if root.tag-choices.length > 0: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: root.tag-required ? @tr("TAGS (REQUIRED)") : @tr("TAGS");
                        color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                    }
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        for choice in root.chosen-tags: Rectangle {
                            height: 28px; border-radius: 14px; background: Theme.raised;
                            width: chip.preferred-width;
                            accessible-role: button;
                            accessible-label: @tr("Remove tag {}", choice.tag.name);
                            accessible-action-default => { root.toggle-tag(choice.id); }
                            chip := HorizontalLayout {
                                padding-left: 10px; padding-right: 6px; spacing: 4px;
                                if choice.tag.emoji != "" || choice.tag.emoji-url != "": PostEmoji { emoji: choice.tag; size: 14px; }
                                Middle { Text { text: choice.tag.name; color: Theme.text; font-size: 13px; font-weight: 600; } }
                                Middle { Image { source: @image-url("icons/x.svg"); width: 14px; height: 14px; colorize: Theme.muted; } }
                            }
                            TouchArea {
                                enabled: !root.posting;
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.toggle-tag(choice.id); }
                            }
                        }
                        add-tags := ActionButton {
                            text: @tr("Add tags"); icon: @image-url("icons/circle-plus.svg"); ghost: true; small: true;
                            enabled: !root.posting && root.more-tags;
                            clicked => {
                                root.menu-x = self.absolute-position.x - root.absolute-position.x;
                                root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                                tags-menu.show();
                            }
                        }
                    }
                }
                if root.has-guidelines: Rectangle {
                    border-radius: 8px; background: Theme.sidebar; border-width: 1px; border-color: Theme.line;
                    VerticalLayout {
                        padding: 12px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: @tr("Post Guidelines"); color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            Middle {
                                IconButton {
                                    icon: root.show-guidelines ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                                    label: root.show-guidelines ? @tr("Hide post guidelines") : @tr("Show post guidelines");
                                    size: 24px; glyph: 16px;
                                    clicked => { root.show-guidelines = !root.show-guidelines; }
                                }
                            }
                        }
                        if root.show-guidelines: Flickable {
                            height: min(220px, guidelines-text.preferred-height);
                            content-height: guidelines-text.preferred-height;
                            guidelines-text := StyledText {
                                width: parent.width;
                                text: root.guidelines; default-color: Theme.secondary; link-color: Theme.link; default-font-size: 14px;
                                link-clicked(link) => { root.open-link(link); }
                            }
                        }
                    }
                }
                Rectangle {
                    min-height: 48px; background: Theme.field; border-radius: 10px;
                    VerticalLayout {
                        // Files to go with the post, in a row that scrolls sideways.
                        if root.staged.length > 0: Flickable {
                            height: 152px;
                            content-width: max(self.width, staged-row.preferred-width);
                            staged-row := HorizontalLayout {
                                padding: 10px; padding-bottom: 2px; spacing: 8px; alignment: start;
                                for file[index] in root.staged: StagedTile {
                                    file: file; can-spoil: root.can-mark-spoilers;
                                    remove => { root.unstage(index); }
                                    toggle-spoiler => { root.toggle-spoiler(index); }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                            VerticalLayout {
                                alignment: end; padding-bottom: 8px;
                                IconButton {
                                    icon: @image-url("icons/circle-plus.svg"); label: @tr("Attach files"); glyph: 22px;
                                    enabled: root.can-attach && !root.posting;
                                    clicked => { root.attach(); }
                                }
                            }
                            message := Composer {
                                text <=> root.body; enabled: !root.posting; label: @tr("Message");
                                placeholder: @tr("Enter a message...");
                                edited(text) => { root.body-edited(text); }
                                accepted => { root.create(); }
                                paste => { self.paste-text(); }
                            }
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    ActionButton {
                        text: root.posting ? @tr("Posting...") : @tr("Post"); primary: true;
                        enabled: !root.posting;
                        clicked => { root.create(); }
                    }
                }
            }
        }
    }
    tags-menu := PopupWindow {
        width: min(root.width - 32px, 320px);
        x: max(16px, min(root.width - self.width - 16px, root.menu-x));
        y: max(8px, min(root.height - self.height - 8px, root.menu-y));
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.sidebar; border-radius: 8px; border-width: 1px; border-color: Theme.edge;
            drop-shadow-blur: 16px; drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    Text { text: @tr("Select up to 5 tags"); color: Theme.muted; font-size: 12px; font-weight: 700; height: 28px; vertical-alignment: center; }
                }
                for choice in root.tag-choices: tag-row := Rectangle {
                    property <bool> enabled: choice.chosen || root.more-tags;
                    height: 36px; border-radius: 4px;
                    background: row-touch.has-hover && self.enabled ? Theme.hover : transparent;
                    accessible-role: checkbox;
                    accessible-label: choice.tag.name;
                    accessible-checked: choice.chosen;
                    accessible-enabled: self.enabled;
                    accessible-action-default => { if self.enabled { root.toggle-tag(choice.id); } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        if choice.tag.emoji != "" || choice.tag.emoji-url != "": PostEmoji { emoji: choice.tag; size: 16px; }
                        Text {
                            text: choice.tag.name; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1;
                            color: tag-row.enabled ? Theme.text : Theme.faint;
                        }
                        Middle {
                            Rectangle {
                                width: 18px; height: 18px; border-radius: 4px;
                                border-width: choice.chosen ? 0px : 2px; border-color: Theme.muted;
                                background: choice.chosen ? Theme.accent : transparent;
                                if choice.chosen: Image { source: @image-url("icons/check.svg"); width: 14px; height: 14px; colorize: Theme.on-accent; }
                            }
                        }
                    }
                    row-touch := TouchArea {
                        enabled: parent.enabled;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.toggle-tag(choice.id); }
                    }
                }
            }
        }
    }
    // Leaving what was written, as Discord's client asks.
    if root.leaving: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 440px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            height: ask.preferred-height;
            background: Theme.sidebar; border-radius: 10px; border-width: 1px; border-color: Theme.edge;
            ask := VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: @tr("Are you sure you want to go?"); color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                Text { text: @tr("Any changes you made will be lost if you exit now."); color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 6px;
                    ActionButton { text: @tr("Back to editing"); ghost: true; clicked => { root.stay(); } }
                    ActionButton { text: @tr("Exit"); danger: true; clicked => { root.leave(); } }
                }
            }
        }
    }
}

export component ForumPanel inherits Rectangle {
    in property <[PostRow]> rows;
    /// Said instead of the list: while it loads, or why it failed.
    in property <string> note;
    /// There are no posts, or a search found none.
    in property <bool> empty;
    in property <bool> searching;
    /// The titles can be searched, as with Read Message History.
    in property <bool> searchable;
    in-out property <string> query;
    /// More cards are still to come, and a page of older ones is on its way.
    in property <bool> more;
    in property <bool> loading;
    /// This account may post here, and the form for a post is open.
    in property <bool> can-post;
    in property <bool> composing;
    in-out property <string> post-title;
    in-out property <string> post-body;
    in property <[PostTagChoice]> chosen-tags;
    in property <[PostTagChoice]> tag-choices;
    in property <bool> tag-required;
    in property <bool> more-tags;
    in property <styled-text> guidelines;
    in property <bool> has-guidelines;
    in property <[StagedFile]> staged;
    in property <bool> can-attach;
    in property <bool> can-mark-spoilers;
    in property <bool> posting;
    in property <string> post-error;
    in property <bool> leaving;
    callback search(string);
    callback open(string, bool);
    callback more-posts;
    callback new-post;
    callback post-title-edited(string);
    callback post-body-edited(string);
    callback toggle-tag(string);
    callback attach;
    callback unstage(int);
    callback toggle-spoiler(int);
    callback create-post;
    callback close-post;
    callback leave-post;
    callback stay-post;
    callback open-link(string);
    accessible-role: groupbox;
    accessible-label: @tr("Posts");
    /// The list was scrolled by hand since it opened.
    property <bool> scrolled-by-hand;
    if root.composing: NewPostForm {
        title <=> root.post-title; body <=> root.post-body;
        chosen-tags: root.chosen-tags; tag-choices: root.tag-choices;
        tag-required: root.tag-required; more-tags: root.more-tags;
        guidelines: root.guidelines; has-guidelines: root.has-guidelines;
        staged: root.staged; can-attach: root.can-attach; can-mark-spoilers: root.can-mark-spoilers;
        posting: root.posting; error: root.post-error; leaving: root.leaving;
        title-edited(text) => { root.post-title-edited(text); }
        body-edited(text) => { root.post-body-edited(text); }
        toggle-tag(id) => { root.toggle-tag(id); }
        attach => { root.attach(); }
        unstage(index) => { root.unstage(index); }
        toggle-spoiler(index) => { root.toggle-spoiler(index); }
        create => { root.create-post(); }
        close => { root.close-post(); }
        leave => { root.leave-post(); }
        stay => { root.stay-post(); }
        open-link(link) => { root.open-link(link); }
        init => { self.focus-title(); }
    }
    if !root.composing: VerticalLayout {
        if root.searchable || root.can-post: Rectangle {
            height: 60px;
            if root.searchable: HeaderSearch {
                x: 16px; y: 16px; height: 36px;
                width: parent.width - 32px - (root.can-post ? new-post.width + 8px : 0px);
                text <=> root.query;
                placeholder: @tr("Search posts");
                search(text) => { root.search(text); }
                clear => { root.query = ""; root.search(""); }
            }
            new-post := ActionButton {
                visible: root.can-post;
                x: parent.width - 16px - self.width; y: 16px;
                width: self.min-width; height: 36px;
                text: @tr("New Post"); icon: @image-url("icons/thread.svg"); primary: true;
                clicked => { root.new-post(); }
            }
        }
        if root.note != "": VerticalLayout {
            padding: 24px; vertical-stretch: 1; alignment: center;
            Text { text: root.note; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
        }
        if root.note == "" && root.empty: VerticalLayout {
            padding: 32px; spacing: 8px; vertical-stretch: 1; alignment: center;
            Image { source: @image-url("icons/thread.svg"); height: 48px; image-fit: contain; colorize: Theme.faint; }
            Text {
                text: root.searching ? @tr("No results found") : @tr("There are no posts yet.");
                color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center;
            }
        }
        if root.note == "" && !root.empty: Rectangle {
            vertical-stretch: 1;
            ListView {
                width: parent.width; height: parent.height;
                // More load when a scroll ends near the end, as Discord's
                // do; a list too short to scroll loads no more. The flag is
                // set first, as a wheel scroll is reported before its
                // animation moves the list.
                scrolled => { root.scrolled-by-hand = true; }
                changed content-y => {
                    if root.scrolled-by-hand && root.more && !root.loading
                        && -self.content-y + self.visible-height >= self.content-height - 200px {
                        root.more-posts();
                    }
                }
                for row[index] in root.rows: PostCard {
                    entry: row; first: index == 0;
                    open(beside) => { root.open(row.room, beside); }
                }
            }
        }
        if root.note == "" && !root.empty && root.loading: HorizontalLayout {
            padding: 8px; alignment: center;
            Text { text: @tr("Loading..."); color: Theme.muted; font-size: 13px; }
        }
    }
}
