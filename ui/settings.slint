import { ComboBox } from "std-widgets.slint";
import { ScrollView } from "scrollview.slint";
import { Theme, Middle, Label, Tip, Popup } from "theme.slint";
import { ActionButton, IconButton, Avatar, SensitivitySlider, VolumeSlider, TextField, StatusText } from "controls.slint";
import { DiscordLinkPanel } from "discord.slint";
import { ChannelRow } from "rail.slint";
import { Soundboard, SoundRow } from "voice.slint";

// Settings: a section's title, a group's heading, a switch with what it does, and
// a row of exclusive choices with the current one raised.
export component SettingsTitle inherits Text {
    color: Theme.text; font-size: 20px; font-weight: 700;
}

export component SettingsHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// A marigold switch, with its label beside it and what it does below. A click on
// either, or Space or Enter with the keyboard, toggles it.
export component SettingsSwitch inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    /// Why it can't change, shown while the pointer is on the switch.
    in property <string> locked-tip;
    /// Its owner sets `checked`, from what a flip asks for: the switch only
    /// says it was flipped, so a binding to it stays.
    in property <bool> controlled;
    callback toggled(bool);
    height: column.preferred-height;
    function toggle() {
        if root.enabled {
            if root.controlled {
                root.toggled(!root.checked);
                return;
            }
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    column := VerticalLayout {
        spacing: 4px;
        row := HorizontalLayout {
            spacing: 12px;
            Middle {
                Rectangle {
                    width: 40px; height: 22px; border-radius: 11px;
                    background: !root.enabled ? Theme.field : root.checked ? (pointer.has-hover ? Theme.accent-hover : Theme.accent) : (pointer.has-hover ? Theme.active : Theme.field);
                    border-width: focus.has-focus ? 2px : 1px;
                    border-color: focus.has-focus ? Theme.text : root.checked && root.enabled ? transparent : Theme.line;
                    animate background { duration: Theme.quick; }
                    Rectangle {
                        x: root.checked ? parent.width - self.width - 3px : 3px;
                        width: 16px; height: 16px; border-radius: 8px;
                        background: !root.enabled ? Theme.faint : root.checked ? Theme.on-accent : Theme.secondary;
                        animate x, background { duration: Theme.quick; easing: ease-out; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px; alignment: start; horizontal-stretch: 1;
                Text {
                    text: root.text; color: root.enabled ? Theme.text : Theme.muted; font-size: 15px;
                    vertical-alignment: center; wrap: word-wrap;
                }
                // Discord's lock after the title, with why on hover.
                if !root.enabled && root.locked-tip != "": Middle {
                    Image {
                        width: 14px; height: 14px; source: @image-url("icons/lock.svg"); colorize: Theme.muted;
                        accessible-role: image; accessible-label: root.locked-tip;
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    Tip.text = root.locked-tip;
                                    Tip.side = 0;
                                    Tip.x = self.absolute-position.x + self.width / 2;
                                    Tip.y = self.absolute-position.y;
                                } else if Tip.text == root.locked-tip {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.description != "": Label { text: root.description; }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: root.width; height: row.height;
        enabled: root.enabled;
        accessible-role: switch;
        accessible-label: root.text;
        accessible-description: root.description;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.toggle(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggle(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
            clicked => { root.toggle(); }
        }
    }
    // Outside the focus scope, which disabled takes no pointer.
    if !root.enabled && root.locked-tip != "": TouchArea {
        x: 0px; y: (row.height - 22px) / 2; width: 40px; height: 22px;
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.locked-tip;
                Tip.side = 0;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = self.absolute-position.y;
            } else if Tip.text == root.locked-tip {
                Tip.text = "";
            }
        }
    }
}

export component Choices inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> current;
    /// `current` follows what Rust shows, and a click only reports the
    /// choice: assigning it would drop the binding, and Reset or a live
    /// update would no longer show.
    in property <bool> controlled;
    callback chosen(int);
    height: 36px; max-width: 360px;
    border-radius: 8px; background: Theme.sunken;
    accessible-role: groupbox;
    accessible-label: root.label;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for option[index] in root.options: Rectangle {
            border-radius: 6px;
            background: index == root.current ? Theme.active : choice.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-role: button;
            accessible-label: index == root.current ? option + ", chosen" : option;
            accessible-action-default => { if !root.controlled { root.current = index; } root.chosen(index); }
            Text {
                text: option; font-size: 14px;
                color: index == root.current ? Theme.text : Theme.secondary;
                font-weight: index == root.current ? 700 : 500;
            }
            choice := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { if !root.controlled { root.current = index; } root.chosen(index); }
            }
        }
    }
}

// A ComboBox showing `chosen`, which Rust keeps: a pick assigns
// `current-index`, which drops a binding to it, so each change of `chosen` is
// assigned again, as after Reset or a live update.
export component Picker inherits ComboBox {
    in property <int> chosen;
    current-index: root.chosen;
    changed chosen => { root.current-index = root.chosen; }
}

// Discord's bar once a draft differs from what Discord has: Reset puts it back,
// and Save Changes sends it. Each time leaving is refused for the changes,
// `nudge` goes up, and the bar shakes red, as Discord's does.
export component UnsavedBar inherits Rectangle {
    in property <bool> saving;
    in property <bool> may-reset: true;
    in property <bool> may-save: true;
    in property <int> nudge;
    in property <length> pad: 12px;
    callback undo;
    callback save;
    /// Shakes left to go, and the red that lasts a little longer.
    property <int> shakes;
    property <bool> red;
    changed nudge => { root.shakes = 6; root.red = true; }
    Timer { interval: 60ms; running: root.shakes > 0; triggered => { root.shakes -= 1; } }
    Timer { interval: 1200ms; running: root.red; triggered => { root.red = false; } }
    height: 60px;
    background: root.red ? Theme.danger : Theme.raised;
    animate background { duration: Theme.quick; }
    Rectangle { y: 0px; height: 1px; background: Theme.edge; }
    bar := HorizontalLayout {
        x: root.shakes == 0 ? 0px : Math.mod(root.shakes, 2) == 0 ? -6px : 6px;
        animate x { duration: 50ms; }
        width: root.width;
        padding: 12px; padding-left: root.pad; spacing: 8px;
        Middle {
            Text {
                text: "Careful — you have unsaved changes!"; font-size: 14px; font-weight: 600; overflow: elide;
                color: root.red ? Theme.on-danger : Theme.text;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        ActionButton {
            text: "Reset"; ghost: true; enabled: root.may-reset && !root.saving;
            clicked => { root.undo(); }
        }
        ActionButton {
            text: root.saving ? "Saving..." : "Save Changes"; primary: true;
            enabled: root.may-save && !root.saving;
            clicked => { root.save(); }
        }
    }
}

/// A row of a settings sidebar: a group's heading, a line between groups
/// for a heading without text, or a page, red for a dangerous one.
export struct SettingsRow { heading: bool, text: string, icon: image, id: int, danger: bool }

// Settings, on a SettingsCard: sections on the left, under their groups'
// headings, and the chosen one, given as children, on the right. Escape or the
// close button returns to the conversation.
export component SettingsFrame inherits Rectangle {
    in property <[SettingsRow]> rows;
    in property <int> selected;
    in property <string> label: "Settings";
    /// Room below the section, for a bar over its bottom.
    in property <length> bottom: 56px;
    /// The page fills the frame's height instead of scrolling in it, for
    /// a page with a list view of its own, which makes only the rows in
    /// sight.
    in property <bool> fill;
    /// Where the section's column starts and how wide it is, for such a bar.
    out property <length> content-x: content.x;
    out property <length> content-width: content.width;
    callback chose(int);
    callback close;
    /// Takes the keys back, for Escape, once what had them is gone.
    public function focus-keys() { keys.focus(); }
    background: Theme.chat;
    accessible-role: groupbox;
    accessible-label: root.label;
    TouchArea { }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        HorizontalLayout {
            Rectangle {
                background: Theme.sidebar; horizontal-stretch: 0; min-width: 232px;
                HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        width: 232px; padding: 16px; padding-top: 56px; spacing: 2px; alignment: start;
                        for row[index] in root.rows: VerticalLayout {
                            if row.heading && row.text != "": HorizontalLayout {
                                padding-left: 8px; padding-bottom: 6px; padding-top: index == 0 ? 0px : 16px;
                                SettingsHeading { text: row.text; overflow: elide; }
                            }
                            if row.heading && row.text == "": VerticalLayout {
                                padding-left: 8px; padding-right: 8px; padding-top: 12px; padding-bottom: 12px;
                                Rectangle { height: 1px; background: Theme.line; }
                            }
                            if !row.heading: ChannelRow {
                                text: row.text; icon: row.icon; danger: row.danger;
                                selected: root.selected == row.id; clicked => { root.chose(row.id); }
                            }
                        }
                    }
                }
            }
            content := Rectangle {
                horizontal-stretch: 2; min-width: 440px;
                scroll := ScrollView {
                    content-height: root.fill ? self.visible-height : page.preferred-height;
                    page := HorizontalLayout {
                        height: root.fill ? scroll.visible-height : self.preferred-height;
                        padding-left: 40px; padding-right: 96px; padding-top: 56px; padding-bottom: root.bottom;
                        VerticalLayout {
                            max-width: 660px; horizontal-stretch: 1; spacing: 16px;
                            alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
                            @children
                        }
                    }
                }
                VerticalLayout {
                    x: parent.width - 80px; y: 48px; width: 56px; height: self.preferred-height; spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/x.svg"); label: "Close " + root.label; size: 36px; glyph: 18px; radius: 18px;
                            fill: Theme.raised; clicked => { root.close(); }
                        }
                    }
                    Text { text: "ESC"; color: Theme.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Settings on a card over the dimmed window, as Discord shows them, which
// opens as popups do; see Popup. A click outside closes them.
export component SettingsCard inherits Rectangle {
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    callback close;
    Rectangle { background: #000000b3; opacity: root.motion; }
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(1080px, root.width - 80px); height: min(800px, root.height - 80px);
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        border-radius: 12px; border-width: 1px; border-color: Theme.edge;
        // The shadow shows once the card is open: a card this large costs
        // a blurred image as large to draw again each frame it grows.
        drop-shadow-blur: 24px; drop-shadow-color: root.motion == 1 ? #00000080 : transparent; drop-shadow-offset-y: 8px;
        Rectangle {
            border-radius: 12px; clip: true;
            @children
        }
    }
}

// This device's settings, in a SettingsFrame on a SettingsCard.
export component SettingsScreen inherits Rectangle {
    /// The section showing: 0 account, 1 voice and video, 2 messages,
    /// 3 notifications, 4 Discord, 5 sounds, 6 advanced, 7 appearance,
    /// 8 game activity.
    in-out property <int> settings-section;
    in property <bool> discord-build;
    in property <bool> preview;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    callback close;
    callback refresh-devices;
    property <[SettingsRow]> with-discord: [
        { heading: true, text: "SETTINGS" },
        { text: "My account", icon: @image-url("icons/user.svg"), id: 0 },
        { text: "Appearance", icon: @image-url("icons/palette.svg"), id: 7 },
        { text: "Voice & video", icon: @image-url("icons/headphones.svg"), id: 1 },
        { text: "Messages", icon: @image-url("icons/message-circle.svg"), id: 2 },
        { text: "Notifications", icon: @image-url("icons/bell.svg"), id: 3 },
        { text: "Sounds", icon: @image-url("icons/volume-2.svg"), id: 5 },
        { text: "Discord", icon: @image-url("icons/discord.svg"), id: 4 },
        { text: "Game activity", icon: @image-url("icons/play.svg"), id: 8 },
        { text: "Advanced", icon: @image-url("icons/settings.svg"), id: 6 },
    ];
    property <[SettingsRow]> without-discord: [
        { heading: true, text: "SETTINGS" },
        { text: "My account", icon: @image-url("icons/user.svg"), id: 0 },
        { text: "Appearance", icon: @image-url("icons/palette.svg"), id: 7 },
        { text: "Voice & video", icon: @image-url("icons/headphones.svg"), id: 1 },
        { text: "Messages", icon: @image-url("icons/message-circle.svg"), id: 2 },
        { text: "Notifications", icon: @image-url("icons/bell.svg"), id: 3 },
        { text: "Sounds", icon: @image-url("icons/volume-2.svg"), id: 5 },
        { text: "Advanced", icon: @image-url("icons/settings.svg"), id: 6 },
    ];
    SettingsCard {
        motion: root.motion;
        close => { root.close(); }
        SettingsFrame {
            rows: root.discord-build && !root.preview ? root.with-discord : root.without-discord;
            selected: root.settings-section;
            chose(id) => {
                root.settings-section = id;
                if id == 1 { root.refresh-devices(); }
            }
            close => { root.close(); }
            @children
        }
    }
}

export component AccountSettings inherits VerticalLayout {
    in property <string> account-name;
    in property <string> account-status;
    in property <string> account-status-emoji;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> storage;
    in property <bool> preview;
    in property <bool> online;
    in property <bool> busy;
    in property <bool> sending;
    in property <bool> discord-linked;
    in property <bool> has-custom-status;
    callback retry-sync;
    callback set-custom-status;
    callback edit-profile;
    callback sign-out;
    spacing: 16px;
    SettingsTitle { text: "My account"; }
    Rectangle {
        background: Theme.sidebar; border-radius: 8px;
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            Middle { Avatar { size: 64px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; } }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                Text { text: root.account-name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                StatusText { text: root.account-status; emoji-url: root.account-status-emoji; }
            }
        }
    }
    if root.storage != "": Label { text: root.storage; }
    HorizontalLayout {
        spacing: 8px;
        if !root.preview && !root.online: ActionButton {
            text: "Reconnect"; icon: @image-url("icons/refresh-cw.svg"); enabled: !root.busy;
            clicked => { root.retry-sync(); }
        }
        if root.discord-linked: ActionButton {
            text: "Edit profile"; icon: @image-url("icons/user-pen.svg");
            clicked => { root.edit-profile(); }
        }
        if root.discord-linked: ActionButton {
            text: root.has-custom-status ? "Change custom status" : "Set a custom status"; icon: @image-url("icons/smile-plus.svg");
            clicked => { root.set-custom-status(); }
        }
        ActionButton {
            text: root.preview ? "Back to sign in" : "Sign out"; icon: @image-url("icons/log-out.svg");
            danger: !root.preview; enabled: !root.busy && !root.sending;
            clicked => { root.sign-out(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// Settings: the audio devices and camera, and how calls start and sound.
export component VoiceSettings inherits VerticalLayout {
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <[string]> cameras;
    /// The chosen devices, bound both ways: a ComboBox sets its own index
    /// as it's used, which would undo a one-way binding and leave it
    /// showing another device once the list changes.
    in-out property <int> microphone-index;
    in-out property <int> speaker-index;
    in-out property <int> camera-index;
    /// Filming to try the camera, and what it films; and why it can't, if
    /// it couldn't start.
    in-out property <bool> camera-testing;
    in property <image> camera-preview;
    in property <string> camera-note;
    in-out property <bool> unmute-on-join;
    in-out property <bool> level-voice;
    /// What suppresses noise in Discord calls: 0 DeepFilterNet, 1 RNNoise, 2
    /// nothing; and how far: 0 full, 1 medium, 2 light.
    in-out property <int> noise-suppression;
    in-out property <int> noise-strength;
    /// Discord calls take the room's reverb out of the microphone.
    in-out property <bool> dereverb;
    /// The quietest speech Discord calls send, in dBFS; and the microphone as
    /// the voice gate hears it, refreshed while this shows.
    in-out property <int> sensitivity: -60;
    in property <float> gate-level: -100;
    in property <bool> gate-sending;
    /// Why the gate's level can't be shown, if it can't.
    in property <string> gate-meter-note;
    /// How calls send the microphone: 0 voice activity, 1 push to talk.
    in-out property <int> input-mode;
    /// The push-to-talk key's name, empty while there's none, and whether
    /// the next key pressed becomes it.
    in property <string> talk-key;
    in-out property <bool> talk-recording;
    /// How long the microphone keeps sending after the key comes up, in ms.
    in-out property <int> talk-delay: 20;
    /// Where the key works: in every app, or only in Yapfast and why.
    in property <string> talk-note;
    /// Discord is linked, so its calls' noise suppression shows.
    in property <bool> discord;
    /// How loud every call sends the microphone and plays, as sliders'
    /// percentages from 0% to 200%. Dragging plays each step through
    /// call-volumes-changed, and letting go saves the last.
    in-out property <int> microphone-volume: 100;
    in-out property <int> speaker-volume: 100;
    /// How loud the Discord soundboard plays, on its slider from 0% to
    /// 100%, for every client of the account.
    in-out property <int> soundboard-volume: 100;
    /// Entrance sounds: the servers to choose one for, "All servers" first,
    /// the one chosen, its sound's name or empty, and the sounds to choose
    /// from, which need Nitro.
    in property <[string]> entrance-servers;
    in-out property <int> entrance-server;
    in property <string> entrance-sound;
    in property <[SoundRow]> entrance-rows;
    in property <bool> nitro;
    in property <string> emoji-font;
    callback soundboard-volume-committed(int);
    /// The entrance sounds' names and choices are wanted.
    callback entrance-sounds-wanted;
    callback entrance-server-chosen(int);
    /// Sets the chosen server's entrance sound, or takes it away with "".
    callback choose-entrance-sound(string);
    callback call-volumes-changed;
    callback select-microphone(int);
    callback select-speaker(int);
    callback select-camera(int);
    callback refresh-devices;
    callback preferences-changed;
    /// Starts or stops recording the push-to-talk key.
    callback record-talk-key(bool);
    spacing: 16px;
    SettingsTitle { text: "Voice & video"; }
    // Each row's two columns take half the width each, whatever is in them:
    // a column starts at its least width and stretches from there, so none
    // has one.
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: "MICROPHONE"; }
            ComboBox { model: root.microphones; current-index <=> root.microphone-index; enabled: root.microphones.length > 0; accessible-label: "Microphone device"; selected => { root.select-microphone(self.current-index); } }
            VolumeSlider {
                label: "Microphone volume"; value <=> root.microphone-volume;
                changed => { root.call-volumes-changed(); }
                committed => { root.preferences-changed(); }
            }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: "SPEAKERS"; }
            ComboBox { model: root.speakers; current-index <=> root.speaker-index; enabled: root.speakers.length > 0; accessible-label: "Speaker device"; selected => { root.select-speaker(self.current-index); } }
            VolumeSlider {
                label: "Speaker volume"; value <=> root.speaker-volume;
                changed => { root.call-volumes-changed(); }
                committed => { root.preferences-changed(); }
            }
        }
    }
    if root.microphones.length == 0 && root.speakers.length == 0: Label { text: "No audio devices found. Connect one, then refresh."; }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0; alignment: start;
            SettingsHeading { text: "CAMERA"; }
            ComboBox { model: root.cameras; current-index <=> root.camera-index; enabled: root.cameras.length > 0; accessible-label: "Camera device"; selected => { root.select-camera(self.current-index); } }
            if root.cameras.length == 0: Label { text: "No camera found. Connect one, then refresh."; }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: "PREVIEW"; }
            Rectangle {
                height: self.width * 9 / 16; border-radius: 8px; background: #000000; clip: true;
                accessible-role: image; accessible-label: root.camera-testing ? "Your camera" : "Camera preview, off";
                if root.camera-testing: Image { width: parent.width; height: parent.height; source: root.camera-preview; image-fit: contain; }
                // Black in every theme, as a camera's picture.
                if !root.camera-testing || root.camera-preview.width == 0: VerticalLayout {
                    alignment: center; spacing: 10px; padding: 12px;
                    Image { height: 30px; source: @image-url("icons/video.svg"); image-fit: contain; colorize: #b5b8c1; }
                    Text {
                        text: root.camera-note != "" ? root.camera-note : root.camera-testing ? "Starting your camera..." : "Your camera is off.";
                        color: #b5b8c1; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                ActionButton {
                    text: root.camera-testing ? "Stop video" : "Test video"; small: true; enabled: root.cameras.length > 0;
                    clicked => { root.camera-testing = !root.camera-testing; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    HorizontalLayout {
        ActionButton { text: "Refresh devices"; icon: @image-url("icons/refresh-cw.svg"); ghost: true; small: true; clicked => { root.refresh-devices(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: "Turn on your microphone when you join a call";
        description: "Otherwise you join muted, and unmute when you're ready.";
        checked <=> root.unmute-on-join;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Even out your voice";
        description: "Keeps your voice steady as you lean towards the microphone or away from it. Whispers and shouts still come through as they are.";
        checked <=> root.level-voice;
        toggled => { root.preferences-changed(); }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "NOISE SUPPRESSION IN DISCORD CALLS"; }
        Choices {
            label: "Noise suppression in Discord calls"; options: ["DeepFilterNet", "RNNoise", "Off"];
            current <=> root.noise-suppression;
            chosen => { root.preferences-changed(); }
        }
        Label { text: "DeepFilterNet also takes out typing and other sudden noise. RNNoise uses less processing. Off sends your microphone as it is, for a quiet room. A call going on switches straight away."; }
    }
    if root.discord && root.noise-suppression != 2: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "NOISE SUPPRESSION STRENGTH"; }
        Choices {
            label: "Noise suppression strength"; options: ["Full", "Medium", "Light"];
            current <=> root.noise-strength;
            chosen => { root.preferences-changed(); }
        }
        Label { text: "Full takes out the most noise, but can cut off giggles and breathy laughs. Medium and Light leave a little of the room's sound in, which can sound more natural, and let a little more noise through."; }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "SOUNDBOARD VOLUME"; }
        VolumeSlider {
            label: "Soundboard volume"; value <=> root.soundboard-volume; maximum: 100;
            committed(value) => { root.soundboard-volume-committed(value); }
        }
        Label { text: "How loud soundboard sounds play in Discord calls, yours and everyone else's. Discord keeps it for all your devices."; }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        init => { root.entrance-sounds-wanted(); }
        SettingsHeading { text: "ENTRANCE SOUNDS"; }
        HorizontalLayout {
            spacing: 8px;
            Picker {
                width: 200px; model: root.entrance-servers; chosen: root.entrance-server;
                accessible-label: "Entrance sound for";
                selected => { root.entrance-server = self.current-index; root.entrance-server-chosen(self.current-index); }
            }
            Rectangle {
                horizontal-stretch: 1; min-width: 0; height: 36px; border-radius: 8px; background: Theme.sunken;
                accessible-role: text; accessible-label: "Entrance sound";
                accessible-value: root.entrance-sound != "" ? root.entrance-sound : "None";
                Text {
                    x: 12px; width: parent.width - 24px; overflow: elide; font-size: 14px;
                    text: root.entrance-sound != "" ? root.entrance-sound : "None";
                    color: root.entrance-sound != "" ? Theme.text : Theme.muted;
                }
            }
            choose := ActionButton {
                text: "Choose"; enabled: root.nitro;
                clicked => { chooser.show(); }
            }
            if root.entrance-sound != "": ActionButton {
                text: "Remove"; ghost: true;
                clicked => { root.choose-entrance-sound(""); }
            }
        }
        Label {
            text: root.nitro ? "Plays to everyone in a voice channel or DM call as you join it, outside stage channels. A server's own comes before the one for all servers."
                : "Entrance sounds play to everyone as you join a voice channel. They need Nitro.";
        }
        chooser := PopupWindow {
            x: choose.x + choose.width - self.width; y: choose.y + choose.height + 6px;
            width: board.width; height: board.height;
            close-policy: PopupClosePolicy.close-on-click-outside;
            board := Soundboard {
                title: "Choose an entrance sound"; extras: false; verb: "Choose";
                rows: root.entrance-rows; emoji-font: root.emoji-font;
                play(id) => { root.choose-entrance-sound(id); chooser.close(); }
                close => { chooser.close(); }
            }
        }
    }
    if root.discord: SettingsSwitch {
        text: "Take out your room's echo in Discord calls";
        description: "For a bare or echoey room that makes your voice sound far away. Uses a little more processing, and your voice goes out 10 ms later.";
        checked <=> root.dereverb;
        toggled => { root.preferences-changed(); }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "INPUT MODE"; }
        Choices {
            label: "Input mode"; options: ["Voice activity", "Push to talk"];
            current <=> root.input-mode;
            chosen => { root.preferences-changed(); }
        }
        Label {
            text: root.input-mode == 0 ? "Yapfast sends your voice when it hears you speak."
                : "Yapfast sends your microphone only while you hold a key.";
        }
    }
    if root.input-mode == 1: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "PUSH TO TALK KEYBIND"; }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Rectangle {
                width: 200px; height: 36px; border-radius: 8px; background: Theme.sunken;
                border-width: root.talk-recording ? 2px : 0px; border-color: Theme.accent;
                accessible-role: text;
                accessible-label: "Push to talk keybind";
                accessible-value: root.talk-key != "" ? root.talk-key : "No keybind set";
                Text {
                    x: 12px; width: parent.width - 24px; overflow: elide; font-size: 14px;
                    text: root.talk-recording ? "Press a key..." : root.talk-key != "" ? root.talk-key : "No keybind set";
                    color: root.talk-key != "" && !root.talk-recording ? Theme.text : Theme.muted;
                    font-weight: root.talk-key != "" && !root.talk-recording ? 600 : 400;
                }
            }
            ActionButton {
                text: root.talk-recording ? "Stop recording" : root.talk-key == "" ? "Record keybind" : "Edit keybind";
                danger: root.talk-recording;
                clicked => { root.record-talk-key(!root.talk-recording); }
            }
        }
        Label {
            text: root.talk-recording ? "Press the key to hold while you talk. Escape stops without changing it."
                : root.talk-key == "" ? "Push to talk is on, but no keybind is set, so your microphone sends nothing."
                : root.talk-note;
        }
    }
    if root.input-mode == 1: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "PUSH TO TALK RELEASE DELAY"; }
        VolumeSlider {
            label: "Push to talk release delay"; value <=> root.talk-delay; maximum: 2000; step: 10; full-mark: false;
            shown: self.value >= 1000 ? (self.value / 1000).to-fixed(2) + " s" : self.value + " ms";
            committed => { root.preferences-changed(); }
        }
        Label { text: "How long your microphone keeps sending after you let go of the key, so the end of a word isn't cut off."; }
    }
    if root.discord && root.input-mode == 0: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "INPUT SENSITIVITY IN DISCORD CALLS"; }
        SensitivitySlider {
            label: "Input sensitivity"; value <=> root.sensitivity;
            level: root.gate-level; sending: root.gate-sending;
            committed => { root.preferences-changed(); }
        }
        Label {
            text: root.gate-meter-note != "" ? root.gate-meter-note
                : "Yapfast sends your voice when it's louder than the handle, and other sounds when they're 18 dB louder still. The bar is your microphone after noise suppression and at its volume, as Yapfast hears it to decide.";
        }
    }
}

/// A theme as Appearance offers it: its name, and the colours of its preview.
export struct ThemeCard {
    id: string,
    name: string,
    /// One of the person's own, which can be edited.
    custom: bool,
    rail: color,
    sidebar: color,
    chat: color,
    raised: color,
    accent: color,
    text: color,
    muted: color,
}

/// A colour in the theme editor: its name, the colour, and its field's text,
/// wrong when that isn't a colour.
export struct ThemeColour {
    name: string,
    colour: color,
    hex: string,
    wrong: bool,
}

// A theme to choose: a small window drawn in its own colours, with its name
// below. The current one has an accent ring and a check; the person's own
// themes have a pencil that edits them.
component ThemeTile inherits Rectangle {
    in property <ThemeCard> card;
    in property <bool> current;
    callback choose();
    callback edit();
    border-radius: 10px;
    border-width: root.current || focus.has-focus ? 2px : 1px;
    border-color: root.current || focus.has-focus ? Theme.accent : pointer.has-hover ? Theme.faint : Theme.line;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background, border-color { duration: Theme.quick; }
    preview := Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 78px;
        border-radius: 6px; clip: true; background: root.card.chat;
        // The rail with three servers, the first selected.
        Rectangle {
            x: 0px; width: 16px; background: root.card.rail;
            for index in 3: Rectangle {
                x: 3px; y: 6px + index * 13px; width: 10px; height: 10px; border-radius: index == 0 ? 3px : 5px;
                background: index == 0 ? root.card.accent : root.card.raised;
            }
        }
        // The sidebar's channels, one of them open.
        Rectangle {
            x: 16px; width: 38px; background: root.card.sidebar;
            for index in 4: Rectangle {
                x: 6px; y: 8px + index * 11px; height: 4px; border-radius: 2px;
                width: index == 1 ? 24px : 18px + mod(index, 2) * 4px;
                background: index == 1 ? root.card.text : root.card.muted;
            }
        }
        // Two messages and the composer.
        for index in 2: Rectangle {
            x: 60px; y: 8px + index * 22px; width: parent.width - 66px; height: 16px;
            Rectangle { x: 0px; y: 0px; width: 10px; height: 10px; border-radius: 5px; background: index == 0 ? root.card.accent : root.card.muted; }
            Rectangle { x: 14px; y: 1px; width: index == 0 ? 22px : 16px; height: 4px; border-radius: 2px; background: root.card.text; }
            Rectangle { x: 14px; y: 8px; width: min(parent.width - 14px, index == 0 ? 52px : 40px); height: 3px; border-radius: 1.5px; background: root.card.muted; }
        }
        Rectangle {
            x: 60px; y: parent.height - 18px; width: parent.width - 66px; height: 12px;
            border-radius: 4px; background: root.card.raised;
            Rectangle { x: parent.width - 10px; width: 6px; height: 6px; border-radius: 3px; background: root.card.accent; }
        }
    }
    HorizontalLayout {
        x: 10px; y: preview.y + preview.height + 6px; width: parent.width - 20px - (root.card.custom ? 26px : 0px); height: 24px; spacing: 6px;
        Text {
            text: root.card.name; color: root.current ? Theme.text : Theme.secondary; font-size: 14px;
            font-weight: root.current ? 700 : 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
        if root.current: Image {
            width: 16px; source: @image-url("icons/check.svg"); colorize: Theme.accent; image-fit: contain;
        }
    }
    focus := FocusScope {
        accessible-role: button;
        accessible-label: root.current ? root.card.name + ", chosen" : root.card.name;
        accessible-action-default => { root.choose(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.choose(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.choose(); }
        }
    }
    if root.card.custom: IconButton {
        x: parent.width - 8px - self.width; y: preview.y + preview.height + 6px; height: 24px;
        icon: @image-url("icons/pencil.svg"); label: "Edit " + root.card.name; size: 24px; glyph: 14px;
        clicked => { root.edit(); }
    }
}

// A colour in the theme editor: a swatch, its name, and its hex in a field
// that says when it holds no colour.
component ThemeColourRow inherits HorizontalLayout {
    in property <ThemeColour> colour;
    callback edited(string);
    spacing: 10px;
    Middle {
        Rectangle {
            width: 28px; height: 28px; border-radius: 6px; background: root.colour.colour;
            border-width: 1px; border-color: Theme.line;
        }
    }
    VerticalLayout {
        alignment: center; horizontal-stretch: 1;
        Text { text: root.colour.name; color: Theme.text; font-size: 14px; overflow: elide; }
        if root.colour.wrong: Text { text: "Not a colour"; color: Theme.danger; font-size: 12px; overflow: elide; }
    }
    Middle {
        TextField {
            width: 116px; min-height: 34px; text-size: 14px; pad: 8px;
            fill: root.colour.wrong ? Theme.danger.with-alpha(0.16) : Theme.sunken;
            text: root.colour.hex; label: root.colour.name;
            edited(text) => { root.edited(text); }
        }
    }
}

// Settings: the window's colours, from the themes Yapfast comes with and the
// person's own. A click shows one at once. New theme opens the editor, whose
// changes show at once too; Save keeps them, Cancel restores the theme from
// before.
export component AppearanceSettings inherits VerticalLayout {
    in property <[ThemeCard]> themes;
    in property <string> theme-id;
    /// The editor, while it's open: the colours, the name, whether the theme
    /// is dark, and whether it edits a saved theme rather than making one,
    /// from the theme at start-index among the starts.
    in property <bool> editor;
    in property <[ThemeColour]> colours;
    in-out property <string> theme-name;
    in-out property <bool> theme-dark;
    in property <bool> editing-saved;
    in property <[string]> starts;
    in property <int> start-index;
    in property <bool> can-save;
    callback choose-theme(string);
    callback new-theme();
    callback edit-theme(string);
    callback start-chosen(int);
    callback colour-edited(int, string);
    callback dark-toggled(bool);
    callback save-theme();
    callback cancel-theme();
    callback delete-theme();
    /// The desktop draws the window's title bar; offered where Yapfast can
    /// draw its own.
    in-out property <bool> system-title-bar;
    in property <bool> title-bar-choice;
    callback title-bar-toggled();
    spacing: 16px;
    SettingsTitle { text: "Appearance"; }
    if !root.editor: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            SettingsHeading { text: "THEME"; vertical-alignment: center; horizontal-stretch: 1; }
            ActionButton {
                text: "New theme"; small: true; icon: @image-url("icons/circle-plus.svg");
                clicked => { root.new-theme(); }
            }
        }
        // As many 150px or wider cards across as fit, in rows.
        Rectangle {
            property <length> gap: 12px;
            property <int> columns: max(1, floor((self.width + self.gap) / (150px + self.gap)));
            property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
            property <length> card-height: 124px;
            height: ceil(root.themes.length / self.columns) * (self.card-height + self.gap) - self.gap;
            accessible-role: list; accessible-label: "Themes";
            for card[index] in root.themes: ThemeTile {
                x: mod(index, parent.columns) * (parent.card-width + parent.gap);
                y: floor(index / parent.columns) * (parent.card-height + parent.gap);
                width: parent.card-width; height: parent.card-height;
                card: card; current: card.id == root.theme-id;
                choose => { root.choose-theme(card.id); }
                edit => { root.edit-theme(card.id); }
            }
        }
    }
    if !root.editor && root.title-bar-choice: SettingsSwitch {
        text: "Use the system title bar";
        description: "Your desktop draws the window's title bar and buttons, as on its other windows. Off, Yapfast draws its own.";
        checked <=> root.system-title-bar;
        toggled => { root.title-bar-toggled(); }
    }
    if root.editor: form := VerticalLayout {
        property <bool> confirming;
        spacing: 16px;
        VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: root.editing-saved ? "EDIT THEME" : "NEW THEME"; }
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    text <=> root.theme-name; placeholder: "Name"; label: "Theme name"; min-height: 36px; text-size: 15px;
                    accepted => { root.save-theme(); }
                }
                ActionButton { text: "Save"; primary: true; enabled: root.can-save; clicked => { root.save-theme(); } }
                ActionButton { text: "Cancel"; clicked => { root.cancel-theme(); } }
            }
        }
        if !root.editing-saved: VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: "START FROM"; }
            ComboBox {
                model: root.starts; current-index: root.start-index; accessible-label: "Start from";
                selected => { root.start-chosen(self.current-index); }
            }
        }
        SettingsSwitch {
            text: "Dark"; description: "Drop-down lists and scroll bars draw dark to match.";
            checked <=> root.theme-dark; toggled(dark) => { root.dark-toggled(dark); }
        }
        VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: "COLOURS"; }
            Label { text: "Each as #rgb, #rrggbb or #rrggbbaa. The window shows a change as you type it."; }
            // Two columns when they fit, read down.
            Rectangle {
                property <int> columns: self.width >= 520px ? 2 : 1;
                property <length> gap: 24px;
                property <length> row-height: 46px;
                property <length> cell-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                property <int> rows: ceil(root.colours.length / self.columns);
                height: self.rows * self.row-height;
                accessible-role: list; accessible-label: "Colours";
                for row[index] in root.colours: ThemeColourRow {
                    x: floor(index / parent.rows) * (parent.cell-width + parent.gap);
                    y: mod(index, parent.rows) * parent.row-height;
                    width: parent.cell-width; height: parent.row-height;
                    colour: row;
                    edited(text) => { root.colour-edited(index, text); }
                }
            }
        }
        if root.editing-saved: HorizontalLayout {
            alignment: start;
            ActionButton {
                text: form.confirming ? "Delete it for good" : "Delete theme"; danger: true; small: true;
                icon: @image-url("icons/trash-2.svg");
                clicked => {
                    if form.confirming { root.delete-theme(); } else { form.confirming = true; }
                }
            }
        }
    }
}

// Settings: how messages look, and what they share.
export component MessageSettings inherits VerticalLayout {
    in property <length> message-font-size;
    in-out property <bool> twelve-hour-clock;
    in-out property <bool> clock-seconds;
    /// Message text: 0 small, 1 default, 2 large.
    in-out property <int> text-size;
    in-out property <bool> link-previews;
    in-out property <bool> share-typing;
    /// When animations play: 0 while Yapfast has the focus, 1 always, 2 never.
    in-out property <int> animate;
    in-out property <bool> reply-ping;
    in-out property <bool> strip-tracking;
    /// The networks in use, which the descriptions name.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    SettingsTitle { text: "Messages"; }
    // A message as the chosen text size and clock show it.
    Rectangle {
        border-radius: 8px; border-width: 1px; border-color: Theme.line;
        accessible-role: groupbox; accessible-label: "Preview";
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            VerticalLayout { alignment: start; Avatar { initial: "S"; tint: #c0679a; } }
            VerticalLayout {
                spacing: 3px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Sam"; color: Theme.text; font-size: root.message-font-size; font-weight: 700; }
                    Text { text: (root.twelve-hour-clock ? "9:41" : "21:41") + (root.clock-seconds ? ":05" : "") + (root.twelve-hour-clock ? " PM" : ""); color: Theme.muted; font-size: root.message-font-size - 3px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: "Thinking co-op after nine, if people are up for it."; color: Theme.text; font-size: root.message-font-size; wrap: word-wrap; }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "TEXT SIZE"; }
        Choices {
            label: "Text size"; options: ["Small", "Default", "Large"];
            current <=> root.text-size;
            chosen => { root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "CLOCK"; }
        Choices {
            label: "Clock"; options: ["24-hour", "12-hour"];
            current: root.twelve-hour-clock ? 1 : 0;
            chosen(index) => { root.twelve-hour-clock = index == 1; root.preferences-changed(); }
        }
        SettingsSwitch {
            text: "Show seconds";
            description: "Message times show them, as 21:41:05.";
            checked <=> root.clock-seconds;
            toggled => { root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "PLAY GIFS, EMOJI AND STICKERS"; }
        Choices {
            label: "Play GIFs, emoji and stickers"; options: ["While Yapfast is focused", "Always", "Never"];
            current <=> root.animate;
            chosen => { root.preferences-changed(); }
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: "Show link previews";
        description: "Cards for links, videos and bots under messages. Linked pictures still show.";
        checked <=> root.link-previews;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Let others see when you're typing";
        description: (root.matrix && root.discord ? "Discord and Matrix show" : root.matrix ? "Matrix shows" : "Discord shows")
            + " \"typing...\" while you write. Others still show here when they type.";
        checked <=> root.share-typing;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Mention people you reply to";
        description: "They get notified of your reply. Switch it for one reply with @ On on the reply bar.";
        checked <=> root.reply-ping;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Remove tracking from links you send";
        description: "Takes out tags like utm_source and fbclid, and share ids from YouTube, Spotify and X. The links still go to the same page.";
        checked <=> root.strip-tracking;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: desktop notifications.
export component NotificationSettings inherits VerticalLayout {
    in-out property <bool> notifications;
    in-out property <bool> notification-text;
    in-out property <bool> flash-taskbar;
    /// The networks in use, whose rules decide what notifies.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    SettingsTitle { text: "Notifications"; }
    SettingsSwitch {
        text: "Show desktop notifications";
        description: "For new messages while Yapfast isn't in front. "
            + (root.matrix && root.discord ? "Each Discord server's notification settings and your Matrix notification rules decide"
                : root.matrix ? "Your Matrix notification rules decide" : "Each Discord server's notification settings decide")
            + " which: usually DMs and mentions. Clicking one opens the conversation.";
        checked <=> root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Show what messages say";
        description: "Off shows only who wrote and where, for a screen others can see.";
        checked <=> root.notification-text;
        enabled: root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Flash the taskbar";
        description: "For a message that notifies while Yapfast isn't in front. The window's title counts mentions and DMs waiting either way.";
        checked <=> root.flash-taskbar;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: Yapfast's own sounds for calls and messages, which instrument plays
// them, and how loud they are, all together or each on its own.
export component SoundSettings inherits VerticalLayout {
    /// The set, in the order the choices show.
    in-out property <int> sound-set;
    /// Percentages: all the sounds, and each against that, in the order of
    /// `names`.
    in-out property <int> volume;
    in-out property <bool> adjust-each;
    in property <[int]> each;
    callback preferences-changed;
    callback each-changed(int, int);
    /// Plays a sound by its index in `names`, as it's set.
    callback play(int);
    property <[string]> names: ["Someone joins the call", "Someone leaves the call", "Muting", "Unmuting", "Deafening", "Undeafening", "A message", "A mention", "Someone starts watching a stream", "Someone stops watching a stream", "Someone starts streaming", "Someone stops streaming"];
    spacing: 16px;
    SettingsTitle { text: "Sounds"; }
    Label { text: "Yapfast plays these as you and others join and leave a call, as you mute and deafen, as others start and stop streaming, as they start and stop watching your stream or the one you watch, and for messages that notify, except in the conversation in front of you. They play on the speakers chosen for calls."; }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "SOUND SET"; }
        Choices {
            label: "Sound set"; options: ["New Kalimba", "Felt piano", "Soft marimba", "Mellow Rhodes", "Glow", "Flute"];
            max-width: 520px;
            current <=> root.sound-set;
            chosen => { root.preferences-changed(); root.play(0); }
        }
    }
    VolumeSlider {
        label: "Volume"; maximum: 200;
        value <=> root.volume;
        committed => { root.preferences-changed(); root.play(6); }
    }
    SettingsSwitch {
        text: "Adjust each sound";
        description: "Set how loud each one is, as a share of the volume above. 0% turns a sound off.";
        checked <=> root.adjust-each;
        toggled => { root.preferences-changed(); }
    }
    if root.adjust-each: VerticalLayout {
        spacing: 12px;
        for name[index] in root.names: HorizontalLayout {
            spacing: 12px;
            VolumeSlider {
                label: name; maximum: 100; value: root.each[index]; horizontal-stretch: 1;
                committed(value) => { root.each-changed(index, value); root.play(index); }
            }
            Middle { IconButton { icon: @image-url("icons/play.svg"); label: "Play " + name; clicked => { root.play(index); } } }
        }
    }
}

// Settings: how Yapfast draws its window and encodes a shared screen. Slint
// picks a renderer once per process, so a change to that waits for a
// restart, which this offers; encoding changes from the next stream.
export component AdvancedSettings inherits VerticalLayout {
    in-out property <bool> gpu-rendering;
    in-out property <bool> gpu-encoding;
    in property <bool> gpu-running;
    in-out property <bool> close-to-tray;
    in property <bool> tray-available;
    in-out property <bool> multiple-windows;
    in-out property <bool> start-on-sign-in;
    in property <bool> autostart-available;
    in-out property <bool> discord-links;
    in property <bool> discord-links-available;
    callback preferences-changed;
    callback restart;
    spacing: 16px;
    SettingsTitle { text: "Advanced"; }

    if root.autostart-available: SettingsSwitch {
        text: "Start when you sign in";
        description: "Yapfast starts in the system tray when you sign in to your computer, so messages and calls reach you.";
        checked <=> root.start-on-sign-in;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        visible: root.discord-links-available;
        text: "Open Discord links in Yapfast";
        description: "discord:// links from other apps and shortcuts open here instead of Discord. Turning it off gives them back to the app that had them.";
        checked <=> root.discord-links;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Close to tray";
        description: root.tray-available
            ? "Closing the window keeps Yapfast running in the system tray, with any call. Quit from the tray icon's menu."
            : "No system tray is running, so closing the window quits Yapfast.";
        checked <=> root.close-to-tray;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Allow multiple windows";
        description: "Starting Yapfast while it runs opens another Yapfast, with its own window and tray icon. Off, it brings the open window forward.";
        checked <=> root.multiple-windows;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Render with the GPU";
        description: "Hardware acceleration. Off, Yapfast draws on the processor, which uses about half the memory.";
        checked <=> root.gpu-rendering;
        toggled => { root.preferences-changed(); }
    }
    if root.gpu-rendering != root.gpu-running: HorizontalLayout {
        spacing: 12px;
        Label {
            text: "Yapfast switches to " + (root.gpu-rendering ? "the GPU" : "the processor") + " when it restarts. Restarting leaves any call.";
            vertical-alignment: center; horizontal-stretch: 1;
        }
        ActionButton {
            text: "Restart Yapfast"; icon: @image-url("icons/refresh-cw.svg");
            clicked => { root.restart(); }
        }
    }
    SettingsSwitch {
        text: "Encode streams with the GPU";
        description: "Screen sharing uses the graphics card's video encoder, which takes almost no processor time and looks better at low bitrates. Off, or without one, Yapfast encodes on the processor.";
        checked <=> root.gpu-encoding;
        toggled => { root.preferences-changed(); }
    }
    Label {
        text: "Icons from Solar by 480 Design (CC BY 4.0), many of them adapted, and from Lucide (ISC).";
        font-size: 12px; color: Theme.faint;
    }
}

// Settings: linking a Discord account.
export component DiscordLinkSettings inherits VerticalLayout {
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    callback link-discord-token(string);
    callback open-discord-captcha;
    spacing: 16px;
    SettingsTitle { text: "Discord"; }
    Label { text: "Link your Discord account to see its servers and DMs in Yapfast, and join its calls. The login stays on this computer, in the system's credential store."; }
    DiscordLinkPanel {
        phase: root.link-phase; code: root.link-code; name: root.link-name; note: root.link-note;
        begin => { root.link-discord(); }
        reopen => { root.open-discord-captcha(); }
        link-token(token) => { root.link-discord-token(token); }
    }
}

// A detected game's local name and executable.
export struct GameExecutable { executable: string, text: string }

// Settings: detected games and Rich Presence.
export component GameActivitySettings inherits VerticalLayout {
    /// The Discord account shares the game it plays, as its settings say.
    in property <bool> shown;
    in property <bool> linked;
    in property <[GameExecutable]> executables;
    callback toggled(bool);
    callback save(int, string, string) -> bool;
    callback remove(int);
    private property <string> executable-draft;
    private property <string> text-draft;
    private property <bool> invalid-game;
    private property <int> editing-game: -1;
    spacing: 16px;
    SettingsTitle { text: "Game activity"; }
    SettingsSwitch {
        text: "Share the game you play";
        description: "Yapfast looks for games among the programs running, and on Linux takes the Rich Presence games send. Your Discord account keeps this setting, so it's the same in Discord's apps.";
        checked: root.shown;
        controlled: true;
        enabled: root.linked;
        locked-tip: "Link a Discord account first.";
        toggled(shown) => { root.toggled(shown); }
    }
    SettingsHeading { text: "CUSTOM GAMES"; }
    Label { text: "Name a game by its executable, a file name or a full path, and what to show after Playing. These come before the games Yapfast knows, but a game's Rich Presence comes first."; }
    for game[index] in root.executables: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: game.text; color: Theme.text; font-size: 15px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            ActionButton { text: "Edit"; small: true; clicked => { root.editing-game = index; root.executable-draft = game.executable; root.text-draft = game.text; root.invalid-game = false; } }
            ActionButton { text: "Remove"; small: true; clicked => { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; root.remove(index); } }
        }
        Text { text: game.executable; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    TextField { text <=> root.executable-draft; label: "Game executable"; placeholder: "Executable name or full path"; }
    TextField { text <=> root.text-draft; label: "Game activity text"; placeholder: "Text after Playing (up to 128 characters)"; }
    if root.invalid-game: Label { text: "Enter an executable and a name of up to 128 characters, without line breaks."; }
    HorizontalLayout {
        ActionButton {
            text: root.editing-game < 0 ? "Add game" : "Save game"; enabled: root.executable-draft != "" && root.text-draft != "";
            clicked => {
                root.invalid-game = !root.save(root.editing-game, root.executable-draft, root.text-draft);
                if !root.invalid-game { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; }
            }
        }
        if root.editing-game >= 0: ActionButton { text: "Cancel"; clicked => { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; root.invalid-game = false; } }
        Rectangle { horizontal-stretch: 1; }
    }
}

/// Someone the Discord account blocked, in Settings.
export struct BlockedRow { id: string, name: string, username: string, avatar-url: string, initial: string }

// Settings: Discord account and channel behavior.
export component DiscordSettings inherits VerticalLayout {
    in property <bool> matrix-build;
    in property <bool> show-hidden-channels;
    in property <bool> sync-discord-reads;
    in property <bool> show-idle;
    in property <bool> hide-blocked;
    /// Those the account blocked, by name.
    in property <[BlockedRow]> blocked;
    callback unlink-discord;
    /// Unblock someone, by user id.
    callback unblock(string);
    /// How many of them show; Discord's list shows five more at a time.
    private property <int> blocked-shown: 5;
    callback hide-blocked-toggled(bool);
    callback show-hidden-channels-toggled(bool);
    callback sync-discord-reads-toggled(bool);
    callback show-idle-toggled(bool);
    spacing: 16px;
    SettingsTitle { text: "Discord"; }
    if root.matrix-build: HorizontalLayout {
        spacing: 12px;
        Label { text: "Unlinking signs Yapfast out of Discord on this computer."; vertical-alignment: center; horizontal-stretch: 1; }
        ActionButton {
            text: "Unlink Discord"; icon: @image-url("icons/log-out.svg"); danger: true;
            clicked => { root.unlink-discord(); }
        }
    }
    SettingsSwitch {
        text: "Show channels you can't access";
        description: "They appear locked. Server admins hid them on purpose.";
        checked: root.show-hidden-channels;
        toggled(shown) => { root.show-hidden-channels-toggled(shown); }
    }
    SettingsSwitch {
        text: "Mark messages read on Discord";
        description: "Channels you read in Yapfast show as read in the Discord apps too.";
        checked: root.sync-discord-reads;
        toggled(sync) => { root.sync-discord-reads-toggled(sync); }
    }
    SettingsSwitch {
        text: "Show me as idle when I'm away";
        description: "After 10 minutes without using Yapfast, as in Discord. Either way, your phone gets notifications while you're away.";
        checked: root.show-idle;
        toggled(shown) => { root.show-idle-toggled(shown); }
    }
    SettingsSwitch {
        text: "Hide messages from people you blocked";
        description: "Leaves them out entirely, rather than showing a line you can open.";
        checked: root.hide-blocked;
        toggled(hide) => { root.hide-blocked-toggled(hide); }
    }
    // As Discord's Ignore & Block lists them, only while there are any.
    if root.blocked.length > 0: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px; padding-top: 8px;
            Middle {
                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px; background: Theme.raised;
                    Image { source: @image-url("icons/ban.svg"); width: 20px; height: 20px; colorize: Theme.secondary; }
                }
            }
            VerticalLayout {
                alignment: center; spacing: 2px;
                Text { text: "Blocked accounts"; color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { text: root.blocked.length + (root.blocked.length == 1 ? " account" : " accounts"); color: Theme.secondary; font-size: 14px; }
            }
        }
        VerticalLayout {
            for person[index] in root.blocked: VerticalLayout {
                if index < root.blocked-shown: HorizontalLayout {
                    padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                    Middle { Avatar { size: 40px; initial: person.initial; picture-url: person.avatar-url; } }
                    Middle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                            if person.username != "": Text { text: person.username; color: Theme.secondary; font-size: 14px; overflow: elide; }
                        }
                    }
                    Middle {
                        ActionButton {
                            text: "Unblock"; small: true; label: "Unblock " + person.name;
                            clicked => { root.unblock(person.id); }
                        }
                    }
                }
            }
        }
        if root.blocked.length > root.blocked-shown: HorizontalLayout {
            alignment: start;
            ActionButton {
                text: "See " + (root.blocked.length - root.blocked-shown) + " more"; ghost: true; small: true;
                clicked => { root.blocked-shown += 5; }
            }
        }
    }
}
