import { SettingsToggle } from "yapfast/settings-toggle.slint";
import { SettingsNavigation } from "yapfast/settings-nav.slint";
import { ClientStyle } from "yapfast/style.slint";
import { ComboBox } from "std-widgets.slint";
import { ScrollView } from "scrollview.slint";
import { Theme, Middle, Label, Tip, Popup, PopupEntry, Looks } from "theme.slint";
import { ActionButton, IconButton, Avatar, LevelBar, SensitivitySlider, VolumeSlider, TextField, StatusText, AccountLook } from "controls.slint";
import { DiscordLinkPanel } from "discord.slint";
import { ChannelRow } from "rail.slint";
import { Soundboard, SoundRow } from "voice.slint";
import { BuildInfo, Updates, UpdateStatus } from "yapfast/build-info.slint";
import { NewTag, NewTags } from "yapfast/new-tags.slint";

// Settings: a section's title, a group's heading, a switch with what it does, and
// a row of exclusive choices with the current one raised. The title shows in
// the classic layout; Discord's puts it in the frame's bar.
export component SettingsTitle inherits Text {
    color: Theme.text; font-size: ClientStyle.enabled ? 24px : 20px; font-weight: 700;
}

export component SettingsHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; overflow: elide;
}

// A marigold switch, with its label beside it and what it does below. A click on
// either, or Space or Enter with the keyboard, toggles it.
export component SettingsSwitch inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    /// Why it can't change, shown while the pointer is on the switch.
    in property <string> locked-tip;
    /// The key under which new_tags.rs lists this setting, if it is a new one:
    /// a NEW tag follows its name until the page has been seen.
    in property <string> new-key;
    /// Its owner sets `checked`, from what a flip asks for: the switch only
    /// says it was flipped, so a binding to it stays.
    in property <bool> controlled;
    callback toggled(bool);
    height: column.preferred-height;
    function toggle() {
        if root.enabled {
            if root.controlled {
                root.toggled(!root.checked);
                return;
            }
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    column := VerticalLayout {
        spacing: 4px;
        row := HorizontalLayout {
            spacing: 12px;
            if !ClientStyle.enabled: Middle {
                SettingsToggle { checked: root.checked; enabled: root.enabled; hovered: pointer.has-hover; focused: focus.has-focus; }
            }
            HorizontalLayout {
                spacing: 6px; alignment: start; horizontal-stretch: 1;
                Text {
                    text: root.text; color: root.enabled ? Theme.text : Theme.muted; font-size: 15px;
                    animate color { duration: Theme.quick; }
                    vertical-alignment: center; wrap: word-wrap;
                }
                if root.new-key != "" && NewTags.is-new(root.new-key, NewTags.revision): Middle { NewTag { } }
                // Discord's lock after the title, with why on hover.
                if !root.enabled && root.locked-tip != "": Middle {
                    Image {
                        width: 14px; height: 14px; source: @image-url("icons/lock.svg"); colorize: Theme.muted;
                        accessible-role: image; accessible-label: root.locked-tip;
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    Tip.text = root.locked-tip;
                                    Tip.side = 0;
                                    Tip.x = self.absolute-position.x + self.width / 2;
                                    Tip.y = self.absolute-position.y;
                                } else if Tip.text == root.locked-tip {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                }
            }
            if ClientStyle.enabled: Middle {
                SettingsToggle { checked: root.checked; enabled: root.enabled; hovered: pointer.has-hover; focused: focus.has-focus; }
            }
        }
        if root.description != "": Label { text: root.description; }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: root.width; height: row.height;
        enabled: root.enabled;
        accessible-role: switch;
        accessible-label: root.text;
        accessible-description: root.description;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.toggle(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggle(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
            clicked => { root.toggle(); }
        }
    }
    // Outside the focus scope, which disabled takes no pointer.
    if !root.enabled && root.locked-tip != "": TouchArea {
        x: ClientStyle.enabled ? root.width - 48px : 0px; y: (row.height - self.height) / 2; width: ClientStyle.enabled ? 48px : 40px; height: ClientStyle.enabled ? 24px : 22px;
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.locked-tip;
                Tip.side = 0;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = self.absolute-position.y;
            } else if Tip.text == root.locked-tip {
                Tip.text = "";
            }
        }
    }
}

// Exclusive choices in a well, the current one raised. On a settings page
// it's as wide as its options' text, and at least `widest`; in a dialog it
// fills the row, under the fields there. A long set in a row too narrow for
// it goes on to more lines rather than past the row's edge.
export component Choices inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> current;
    /// `current` follows what Rust shows, and a click only reports the
    /// choice: assigning it would drop the binding, and Reset or a live
    /// update would no longer show.
    in property <bool> controlled;
    callback chosen(int);
    /// How wide it grows at least, while the row has room: its options'
    /// text may take more, as a translation's words run longer.
    in property <length> widest: 360px;
    /// It fills the row, its options sharing it evenly.
    in property <bool> fill;
    /// Its options go on to more lines wherever the row is narrower than
    /// them, as in a menu of a fixed width.
    in property <bool> wrap;
    /// Its options on one line, each as wide as in bold, for a dialog that
    /// fits itself to them.
    out property <length> natural: measure.min-width;
    // A dialog that fits itself to what's in it keeps its options on one
    // line: only a set wider than 480px goes on to more where there's no
    // room, unless it's asked to wrap.
    min-width: root.wrap ? line.min-width : root.fill ? root.natural : min(root.natural, 480px);
    max-width: root.fill ? 100000px : max(root.widest, root.natural);
    // As tall as its lines, never stretched: the options keep their height.
    max-height: line.preferred-height; vertical-stretch: 0;
    border-radius: 8px; background: Theme.sunken;
    // A rim, so it keeps its shape on a theme whose wells are the panel's
    // colour.
    border-width: 1px; border-color: Theme.line;
    accessible-role: groupbox;
    accessible-label: root.label;
    // Measures the line; placed, so the well's size doesn't follow it.
    measure := HorizontalLayout {
        x: 0px; y: 0px; visible: false;
        padding: 4px; spacing: 4px;
        for option in root.options: HorizontalLayout {
            padding-left: 10px; padding-right: 10px;
            Text { text: option; font-size: 14px; font-weight: 700; }
        }
    }
    line := FlexboxLayout {
        padding: 4px; spacing: 4px; alignment: stretch;
        for option[index] in root.options: Rectangle {
            // Grown from nothing, so the options share what's spare evenly.
            min-width: name.preferred-width + 20px; preferred-width: 0px; horizontal-stretch: 1;
            height: 28px;
            border-radius: 4px;
            background: index == root.current ? Theme.active : choice.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-role: button;
            accessible-label: index == root.current ? @tr("{}, chosen", option) : option;
            accessible-action-default => { if !root.controlled { root.current = index; } root.chosen(index); }
            name := Text {
                text: option; font-size: 14px;
                color: index == root.current ? Theme.text : Theme.secondary;
                animate color { duration: Theme.quick; }
                font-weight: index == root.current ? 700 : 500;
            }
            choice := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { if !root.controlled { root.current = index; } root.chosen(index); }
            }
        }
    }
}

// A ComboBox showing `chosen`, which Rust keeps: a pick assigns
// `current-index`, which drops a binding to it, so each change of `chosen` is
// assigned again, as after Reset or a live update.
export component Picker inherits ComboBox {
    in property <int> chosen;
    // The settings pages' control height, as a button's and Choices'.
    min-height: 36px;
    current-index: root.chosen;
    changed chosen => { root.current-index = root.chosen; }
}

// A text of a settings page several lines long, such as a server's
// description or a channel's topic: at least four lines high, taller as the
// text grows, with how many characters are left below it when that's counted.
export component SettingsArea inherits VerticalLayout {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <int> left;
    in property <bool> counted: true;
    in property <bool> enabled: true;
    callback edited(string);
    spacing: 4px;
    Rectangle {
        height: max(96px, input.preferred-height + 16px);
        border-radius: 6px; background: Theme.sunken; clip: true;
        // A rim, so it keeps its shape on a theme whose wells are the
        // panel's colour; the keys' ring takes its place, as TextField's.
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent.with-alpha(0.8) : Theme.line;
        animate border-color { duration: Theme.quick; }
        Text {
            x: 10px; y: 8px; width: parent.width - 20px;
            visible: root.text == "";
            text: root.placeholder; color: Theme.muted; font-size: 14px;
            wrap: word-wrap; overflow: elide;
        }
        input := TextInput {
            x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
            text <=> root.text; enabled: root.enabled;
            single-line: false; wrap: word-wrap;
            font-size: 14px; color: Theme.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
        }
    }
    if root.counted: Text {
        horizontal-alignment: right;
        text: root.left < 0 ? @tr("Too long by {}", -root.left) : @tr("{} left", root.left);
        color: root.left < 0 ? Theme.danger : Theme.muted; font-size: 12px;
        animate color { duration: Theme.quick; }
    }
}

// A button drawn as its words alone, for an action that starts a row: they
// start on the column's edge, under the text above, where a ghost button's
// padding would set them in. They brighten under the pointer.
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <bool> small;
    callback clicked;
    height: root.small ? 28px : 36px; horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    property <color> ink: !root.enabled ? Theme.faint : root.danger ? Theme.danger-text
        : pointer.has-hover ? Theme.text : Theme.secondary;
    animate ink { duration: Theme.quick; }
    // The keys' ring, a little outside the words.
    Rectangle {
        x: -6px; y: 0px; width: parent.width + 12px; height: parent.height;
        border-radius: 6px; border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
    }
    HorizontalLayout {
        spacing: 8px;
        if root.icon.width > 0: Image {
            source: root.icon; width: root.small ? 16px : 18px; image-fit: contain;
            colorize: root.ink;
        }
        if root.text != "": Text {
            text: root.text; color: root.ink; font-size: root.small ? 14px : 15px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// Discord's bar once a draft differs from what Discord has: Reset puts it back,
// and Save Changes sends it. Each time leaving is refused for the changes,
// `nudge` goes up, and the bar shakes red, as Discord's does.
export component UnsavedBar inherits Rectangle {
    in property <bool> saving;
    in property <bool> may-reset: true;
    in property <bool> may-save: true;
    in property <int> nudge;
    in property <length> pad: 12px;
    callback undo;
    callback save;
    /// Shakes left to go, and the red that lasts a little longer.
    property <int> shakes;
    property <bool> red;
    changed nudge => { root.shakes = 6; root.red = true; }
    Timer { interval: 60ms; running: root.shakes > 0; triggered => { root.shakes -= 1; } }
    Timer { interval: 1200ms; running: root.red; triggered => { root.red = false; } }
    height: 60px;
    background: root.red ? Theme.danger : Theme.raised;
    animate background { duration: Theme.quick; }
    // It comes up from the edge it sits on.
    enter := PopupEntry { }
    opacity: Popup.opacity(enter.amount); transform-scale: Popup.scale(enter.amount);
    transform-origin: { x: self.width / 2, y: self.height };
    Rectangle { y: 0px; height: 1px; background: Theme.edge; }
    bar := HorizontalLayout {
        // Only the red says it while the interface holds still.
        x: root.shakes == 0 || Theme.still ? 0px : Math.mod(root.shakes, 2) == 0 ? -6px : 6px;
        animate x { duration: Theme.still ? 0ms : 50ms; }
        width: root.width;
        padding: 12px; padding-left: root.pad; spacing: 8px;
        // It goes onto two lines where the bar is narrow, as in the
        // profile editor's middle column.
        Middle {
            Text {
                text: @tr("Careful — you have unsaved changes!"); font-size: 14px; font-weight: 600; wrap: word-wrap;
                color: root.red ? Theme.on-danger : Theme.text;
                animate color { duration: Theme.quick; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        ActionButton {
            text: @tr("Reset"); ghost: true; enabled: root.may-reset && !root.saving;
            clicked => { root.undo(); }
        }
        ActionButton {
            text: root.saving ? @tr("Saving...") : @tr("Save Changes"); primary: true;
            enabled: root.may-save && !root.saving;
            clicked => { root.save(); }
        }
    }
}

/// A row of a settings sidebar: a group's heading, a line between groups
/// for a heading without text, or a page, red for a dangerous one.
export struct SettingsRow { heading: bool, text: string, icon: image, id: int, danger: bool }

// The sections of a server's or a channel's settings in Discord's layout,
// with SettingsNavigation's measures: each group under its heading, a line
// before a dangerous one, scrolling once they're taller than the card.
component SectionsNavigation inherits Rectangle {
    in property <[SettingsRow]> rows;
    in property <int> selected;
    callback chose(int);
    width: 266px; horizontal-stretch: 0; background: Theme.chat;
    ScrollView {
        content-width: self.visible-width;
        content-height: entries.preferred-height;
        entries := VerticalLayout {
            // The first heading's middle on the line of the page's title.
            padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 16px;
            alignment: start;
            for row[index] in root.rows: VerticalLayout {
                if row.heading && row.text != "": HorizontalLayout {
                    padding-left: 8px; padding-top: index == 0 ? 0px : 16px;
                    height: index == 0 ? 24px : 40px;
                    SettingsHeading { text: row.text; vertical-alignment: center; }
                }
                if row.heading && row.text == "": VerticalLayout {
                    padding-left: 8px; padding-right: 8px; padding-top: 12px; padding-bottom: 12px;
                    Rectangle { height: 1px; background: Theme.line; }
                }
                if !row.heading: ChannelRow {
                    height: 40px; text: row.text; icon: row.icon; danger: row.danger;
                    selected: root.selected == row.id;
                    clicked => { root.chose(row.id); }
                }
            }
        }
    }
}

// Settings, on a SettingsCard: sections on the left, under their groups'
// headings, and the chosen one, given as children, on the right. Escape or the
// close button returns to the conversation.
//
// In Discord's layout the user's settings, a server's and a channel's share
// one frame: a bar with the page's title over the page's column and the close
// button in its corner, and the column centred under it, 696px wide for a
// form and up to 1040px for a table.
export component SettingsFrame inherits Rectangle {
    in property <[SettingsRow]> rows;
    in property <int> selected;
    in property <string> label: @tr("Settings");
    in property <bool> discord-layout;
    /// The user's own settings: the account heads the sections, which can be
    /// searched. Otherwise `rows` lists them.
    in property <bool> account;
    in property <string> page-title;
    /// Shown after the title, quieter: a server's boost level.
    in property <string> page-detail;
    in property <string> account-name;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <bool> with-discord;
    in property <bool> may-edit-profile;
    callback edit-profile;
    /// Puts text on the clipboard, for the version under the sections.
    callback copy-text(string);
    /// Room below the section, for a bar over its bottom.
    in property <length> bottom: 56px;
    /// The page fills the frame's height instead of scrolling in it, for
    /// a page with a list view of its own, which makes only the rows in
    /// sight.
    in property <bool> fill;
    /// The page is a table, whose columns take the width there is.
    in property <bool> wide;
    property <length> column-max: !root.discord-layout ? 660px : root.wide ? 1040px : 696px;
    property <length> column-x: root.discord-layout ? max(32px, (content.width - root.column-max) / 2) : 40px;
    /// Where the page's column starts and how wide it is, for a bar over it.
    out property <length> content-x: content.x + root.column-x;
    out property <length> content-width: root.discord-layout ? content.width - 2 * root.column-x : min(root.column-max, content.width - root.column-x - 96px);
    callback chose(int);
    callback close;
    /// Takes the keys back, for Escape, once what had them is gone.
    public function focus-keys() { keys.focus(); }
    // A page opens at its top, not where the last one was scrolled to.
    changed selected => { scroll.content-y = 0px; }
    background: root.discord-layout ? Theme.panel : Theme.chat;
    accessible-role: groupbox;
    accessible-label: root.label;
    TouchArea { }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        HorizontalLayout {
            if root.discord-layout && root.account: SettingsNavigation {
                selected: root.selected; with-discord: root.with-discord;
                account-name: root.account-name; account-initial: root.account-initial;
                account-tint: root.account-tint; account-picture: root.account-picture;
                may-edit-profile: root.may-edit-profile;
                chose(id) => { root.chose(id); }
                edit-profile => { root.edit-profile(); }
                copy-text(text) => { root.copy-text(text); }
            }
            if root.discord-layout && !root.account: SectionsNavigation {
                rows: root.rows; selected: root.selected;
                chose(id) => { root.chose(id); }
            }
            if !root.discord-layout: Rectangle {
                background: Theme.sidebar; horizontal-stretch: 0; min-width: 232px;
                HorizontalLayout {
                    alignment: end;
                    // Scrolls, so a short window still reaches the last.
                    ScrollView {
                        width: 232px;
                        content-width: self.visible-width;
                        content-height: classic-rows.preferred-height;
                        classic-rows := VerticalLayout {
                            padding: 16px; padding-top: 56px; spacing: 2px; alignment: start;
                            for row[index] in root.rows: VerticalLayout {
                                if row.heading && row.text != "": HorizontalLayout {
                                    padding-left: 8px; padding-bottom: 6px; padding-top: index == 0 ? 0px : 16px;
                                    SettingsHeading { text: row.text; overflow: elide; }
                                }
                                if row.heading && row.text == "": VerticalLayout {
                                    padding-left: 8px; padding-right: 8px; padding-top: 12px; padding-bottom: 12px;
                                    Rectangle { height: 1px; background: Theme.line; }
                                }
                                if !row.heading: ChannelRow {
                                    text: row.text; icon: row.icon; danger: row.danger;
                                    selected: root.selected == row.id; clicked => { root.chose(row.id); }
                                }
                            }
                        }
                    }
                }
            }
            content := Rectangle {
                horizontal-stretch: 2; min-width: root.discord-layout ? 320px : 440px;
                if root.discord-layout: Rectangle {
                    y: 0px; height: 48px; background: Theme.panel;
                    HorizontalLayout {
                        // The title over the page's column, the close button
                        // in the card's corner.
                        padding-left: root.column-x; padding-right: 8px; spacing: 16px;
                        HorizontalLayout {
                            alignment: start; spacing: 8px; horizontal-stretch: 1;
                            Text { text: root.page-title; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                            if root.page-detail != "": Text { text: root.page-detail; color: Theme.muted; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                        Middle { IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close {}", root.label); size: 32px; glyph: 18px; clicked => { root.close(); } } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                scroll := ScrollView {
                    y: root.discord-layout ? 48px : 0px;
                    height: parent.height - self.y;
                    // Only down: what's wider than the page wraps or
                    // shrinks rather than pushing it sideways.
                    content-width: self.visible-width;
                    content-height: root.fill ? self.visible-height : page.preferred-height;
                    page := HorizontalLayout {
                        height: root.fill ? scroll.visible-height : self.preferred-height;
                        padding-left: root.column-x;
                        padding-right: root.discord-layout ? root.column-x : 96px;
                        // The bar holds the title: the page starts a step under it.
                        padding-top: root.discord-layout ? 24px : 56px; padding-bottom: root.bottom;
                        VerticalLayout {
                            max-width: root.column-max; horizontal-stretch: 1; spacing: 16px;
                            alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
                            @children
                        }
                    }
                }
                if !root.discord-layout: VerticalLayout {
                    x: parent.width - 80px; y: 48px; width: 56px; height: self.preferred-height; spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/x.svg"); label: @tr("Close {}", root.label); size: 36px; glyph: 18px; radius: 18px;
                            fill: Theme.raised; clicked => { root.close(); }
                        }
                    }
                    Text { text: "ESC"; color: Theme.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Settings on a card over the dimmed window, as Discord shows them, which
// opens as popups do; see Popup. A click outside closes them.
export component SettingsCard inherits Rectangle {
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    /// The window's margin around it, the same on each side: 72px in a
    /// large window, down to 24px in a small one, in 8px steps.
    property <length> gutter: max(24px, min(72px, floor((min(root.height, root.width - 400px) - 540px) / 40px) * 8px));
    /// Both sides' margins together.
    in property <length> margin: ClientStyle.enabled ? 2 * self.gutter : ClientStyle.settings-margin;
    callback close;
    Rectangle { background: rgba(0, 0, 0, 0.7 * root.motion); }
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(ClientStyle.settings-width, root.width - root.margin);
        height: min(ClientStyle.settings-height, root.height - root.margin);
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        border-radius: 12px; border-width: 1px; border-color: Theme.edge;
        // The shadow shows once the card is open: a card this large costs
        // a blurred image as large to draw again each frame it grows.
        drop-shadow-blur: 24px; drop-shadow-color: root.motion == 1 ? #00000080 : transparent; drop-shadow-offset-y: 8px;
        Rectangle {
            border-radius: 12px; clip: true;
            @children
        }
    }
}

// This device's settings, in a SettingsFrame on a SettingsCard.
export component SettingsScreen inherits Rectangle {
    /// The section showing: 0 account, 1 voice and video, 2 messages,
    /// 3 notifications, 4 Discord, 5 sounds, 6 advanced, 7 appearance,
    /// 8 game activity, 9 about, 10 keybinds.
    in-out property <int> settings-section;
    in property <bool> discord-build;
    in property <bool> preview;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    in property <string> account-name;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <bool> may-edit-profile;
    callback close;
    callback edit-profile;
    callback refresh-devices;
    callback copy-text(string);
    property <[SettingsRow]> with-discord: [
        { heading: true, text: @tr("SETTINGS") },
        { text: @tr("My account"), icon: @image-url("icons/user.svg"), id: 0 },
        { text: @tr("Appearance"), icon: @image-url("icons/palette.svg"), id: 7 },
        { text: @tr("Voice & video"), icon: @image-url("icons/headphones.svg"), id: 1 },
        { text: @tr("Keybinds"), icon: @image-url("icons/keyboard.svg"), id: 10 },
        { text: @tr("Messages"), icon: @image-url("icons/message-circle.svg"), id: 2 },
        { text: @tr("Notifications"), icon: @image-url("icons/bell.svg"), id: 3 },
        { text: @tr("Sounds"), icon: @image-url("icons/volume-2.svg"), id: 5 },
        { text: "Discord", icon: @image-url("icons/discord.svg"), id: 4 },
        { text: @tr("Game activity"), icon: @image-url("icons/play.svg"), id: 8 },
        { text: @tr("Advanced"), icon: @image-url("icons/settings.svg"), id: 6 },
        { text: @tr("About"), icon: @image-url("icons/help-circle.svg"), id: 9 },
    ];
    property <[SettingsRow]> without-discord: [
        { heading: true, text: @tr("SETTINGS") },
        { text: @tr("My account"), icon: @image-url("icons/user.svg"), id: 0 },
        { text: @tr("Appearance"), icon: @image-url("icons/palette.svg"), id: 7 },
        { text: @tr("Voice & video"), icon: @image-url("icons/headphones.svg"), id: 1 },
        { text: @tr("Keybinds"), icon: @image-url("icons/keyboard.svg"), id: 10 },
        { text: @tr("Messages"), icon: @image-url("icons/message-circle.svg"), id: 2 },
        { text: @tr("Notifications"), icon: @image-url("icons/bell.svg"), id: 3 },
        { text: @tr("Sounds"), icon: @image-url("icons/volume-2.svg"), id: 5 },
        { text: @tr("Advanced"), icon: @image-url("icons/settings.svg"), id: 6 },
        { text: @tr("About"), icon: @image-url("icons/help-circle.svg"), id: 9 },
    ];
    SettingsCard {
        motion: root.motion;
        close => { root.close(); }
        SettingsFrame {
            discord-layout: ClientStyle.enabled; account: true;
            page-title: root.settings-section == 0 ? @tr("My Account") : root.settings-section == 1 ? @tr("Voice & Video")
                : root.settings-section == 2 ? @tr("Messages") : root.settings-section == 3 ? @tr("Notifications")
                : root.settings-section == 4 ? "Discord" : root.settings-section == 5 ? @tr("Sounds")
                : root.settings-section == 6 ? @tr("Advanced") : root.settings-section == 7 ? @tr("Appearance")
                : root.settings-section == 9 ? @tr("About") : root.settings-section == 10 ? @tr("Keybinds") : @tr("Game Activity");
            account-name: root.account-name; account-initial: root.account-initial;
            account-tint: root.account-tint; account-picture: root.account-picture;
            with-discord: root.discord-build && !root.preview;
            may-edit-profile: root.may-edit-profile;
            edit-profile => { root.edit-profile(); }
            copy-text(text) => { root.copy-text(text); }
            rows: root.discord-build && !root.preview ? root.with-discord : root.without-discord;
            selected: root.settings-section;
            chose(id) => {
                root.settings-section = id;
                if id == 1 { root.refresh-devices(); }
            }
            close => { root.close(); }
            @children
        }
    }
}

export component AccountSettings inherits VerticalLayout {
    in property <string> account-name;
    in property <string> account-status;
    in property <string> account-status-emoji;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> storage;
    in property <bool> preview;
    in property <bool> online;
    in property <bool> busy;
    in property <bool> sending;
    in property <bool> discord-linked;
    in property <bool> has-custom-status;
    callback retry-sync;
    callback set-custom-status;
    callback edit-profile;
    callback sign-out;
    spacing: 16px;
    // Discord's layout titles the page in the frame's bar.
    if !ClientStyle.enabled: SettingsTitle { text: @tr("My account"); }
    Rectangle {
        background: Theme.sidebar; border-radius: 8px;
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            Middle { Avatar { size: 64px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; decoration-url: AccountLook.decoration-url; } }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                Text { text: root.account-name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                StatusText { text: root.account-status; emoji-url: root.account-status-emoji; }
            }
        }
    }
    if root.storage != "": Label { text: root.storage; }
    // A narrow window takes them onto a second line.
    FlexboxLayout {
        spacing: 8px; alignment: start;
        if !root.preview && !root.online: ActionButton {
            text: @tr("Reconnect"); icon: @image-url("icons/refresh-cw.svg"); enabled: !root.busy;
            clicked => { root.retry-sync(); }
        }
        if root.discord-linked: ActionButton {
            text: @tr("Edit profile"); icon: @image-url("icons/user-pen.svg");
            clicked => { root.edit-profile(); }
        }
        if root.discord-linked: ActionButton {
            text: root.has-custom-status ? @tr("Change custom status") : @tr("Set a custom status"); icon: @image-url("icons/smile-plus.svg");
            clicked => { root.set-custom-status(); }
        }
        ActionButton {
            text: root.preview ? @tr("Back to sign in") : @tr("Sign out"); icon: @image-url("icons/log-out.svg");
            danger: !root.preview; enabled: !root.busy && !root.sending;
            clicked => { root.sign-out(); }
        }
    }
}

// A keybind's keys and the button that records them: while recording, the
// keys pressed so far.
component KeyRecorder inherits HorizontalLayout {
    in property <string> label;
    /// The keybind's keys, empty while there are none.
    in property <string> keys;
    in property <bool> recording;
    in property <string> recorded-keys;
    in property <length> box-width: 200px;
    /// The box takes the row's spare width, down to 120px, the button
    /// keeping its own.
    in property <bool> stretch;
    callback record(bool);
    spacing: 8px; alignment: start;
    Rectangle {
        min-width: root.stretch ? 120px : root.box-width; preferred-width: root.box-width;
        max-width: root.stretch ? 100000px : root.box-width;
        horizontal-stretch: root.stretch ? 1 : 0;
        height: 36px; border-radius: 8px; background: Theme.sunken;
        // A well's rim, as the page's others; the accent while recording.
        border-width: root.recording ? 2px : 1px; border-color: root.recording ? Theme.accent : Theme.line;
        accessible-role: text;
        accessible-label: root.label;
        accessible-value: root.recording ? root.recorded-keys : root.keys != "" ? root.keys : @tr("No keybind set");
        Text {
            x: 12px; width: parent.width - 24px; overflow: elide; font-size: 14px;
            text: root.recording ? (root.recorded-keys != "" ? root.recorded-keys : @tr("Press a key..."))
                : root.keys != "" ? root.keys : @tr("No keybind set");
            color: root.keys != "" && !root.recording ? Theme.text : Theme.muted;
            font-weight: root.keys != "" && !root.recording ? 600 : 400;
        }
    }
    ActionButton {
        text: root.recording ? @tr("Stop recording") : root.keys == "" ? @tr("Record keybind") : @tr("Edit keybind");
        danger: root.recording;
        clicked => { root.record(!root.recording); }
    }
}

/// A keybind on the Keybinds page: its action's place in the page's list,
/// its keys' name or "", what the action does, and what the desktop did with
/// it, while the desktop runs keybinds.
export struct KeybindRow { action: int, keys: string, description: string, desktop: string }

// Settings: keybinds, as Discord's Keybinds page.
export component KeybindSettings inherits VerticalLayout {
    in property <[KeybindRow]> rows;
    /// Where keybinds work.
    in property <string> note;
    /// The row whose keys are being recorded, or -1, and the keys so far.
    in property <int> recording: -1;
    in property <string> recorded-keys;
    callback add;
    callback remove(int);
    callback action-chosen(int, int);
    /// Starts or stops recording a row's keys.
    callback record(int, bool);
    spacing: 16px;
    // The title is the frame's bar's in Discord's layout, as on every page;
    // what keybinds do, and the way to add one, start the page.
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Keybinds"); }
    HorizontalLayout {
        spacing: 16px;
        Label {
            text: root.note != "" ? root.note : @tr("Keybinds mute, deafen, talk, share your screen or leave a call from any app. Add one, choose what it does, and record its keys.");
            horizontal-stretch: 1; min-width: 0;
        }
        VerticalLayout { alignment: start; ActionButton { text: @tr("Add a Keybind"); primary: true; clicked => { root.add(); } } }
    }
    // Each keybind in a rimmed card, as the page's other groups.
    for row[index] in root.rows: Rectangle {
        border-radius: 8px; border-width: 1px; border-color: Theme.line;
        accessible-role: groupbox; accessible-label: @tr("Keybind {}", index + 1);
        VerticalLayout {
            padding: 16px; spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    // One width for every row, so they line up, and room for
                    // the longest action in Russian, narrowing in a narrow
                    // window before the keys' box does.
                    min-width: 160px; preferred-width: 240px; max-width: 240px; horizontal-stretch: 1;
                    spacing: 8px; alignment: start;
                    SettingsHeading { text: @tr("ACTION"); }
                    Picker {
                        model: [@tr("Unassigned"), @tr("Push to Talk (Normal)"), @tr("Push to Mute"), @tr("Toggle Mute"), @tr("Toggle Deafen"), @tr("Toggle VAD"), @tr("Toggle Go Live"), @tr("Disconnect from Voice Channel")];
                        chosen: row.action; accessible-label: @tr("Action");
                        selected => { root.action-chosen(index, self.current-index); }
                    }
                }
                VerticalLayout {
                    spacing: 8px; horizontal-stretch: 1; alignment: start;
                    SettingsHeading { text: @tr("KEYBIND"); }
                    KeyRecorder {
                        label: @tr("Keybind"); keys: row.keys; box-width: 180px; stretch: true;
                        recording: root.recording == index; recorded-keys: root.recorded-keys;
                        record(on) => { root.record(index, on); }
                    }
                }
                // On the controls' line, under the headings.
                VerticalLayout {
                    alignment: end;
                    IconButton {
                        icon: @image-url("icons/x.svg"); label: @tr("Remove Keybind"); size: 32px; glyph: 16px; height: 36px;
                        clicked => { root.remove(index); }
                    }
                }
            }
            Label { text: row.description; }
            if row.desktop != "": Label { text: row.desktop; }
        }
    }
}

// Settings: the audio devices and camera, and how calls start and sound.
export component VoiceSettings inherits VerticalLayout {
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <[string]> cameras;
    /// The chosen devices, bound both ways: a ComboBox sets its own index
    /// as it's used, which would undo a one-way binding and leave it
    /// showing another device once the list changes.
    in-out property <int> microphone-index;
    in-out property <int> speaker-index;
    in-out property <int> camera-index;
    /// Filming to try the camera, and what it films; and why it can't, if
    /// it couldn't start.
    in-out property <bool> camera-testing;
    in property <image> camera-preview;
    in property <string> camera-note;
    in-out property <bool> unmute-on-join;
    /// How long a DM call with no one else in it waits before leaving: 0
    /// never, then 3, 10 and 30 minutes and an hour.
    in-out property <int> alone-wait: 1;
    in-out property <bool> level-voice;
    /// What suppresses noise in Discord calls: 0 DeepFilterNet, 1 RNNoise, 2
    /// nothing; and how far: 0 full, 1 medium, 2 light.
    in-out property <int> noise-suppression;
    in-out property <int> noise-strength;
    /// Discord calls take the room's reverb out of the microphone.
    in-out property <bool> dereverb;
    /// Windows runs its microphone effects in Discord calls; the switch shows
    /// where there are any, on Windows.
    in-out property <bool> windows-effects;
    in property <bool> windows-effects-choice;
    /// The quietest speech Discord calls send, in dBFS; and the microphone as
    /// the voice gate hears it, refreshed while this shows.
    in-out property <int> sensitivity: -60;
    in property <float> gate-level: -100;
    in property <bool> gate-sending;
    /// Why the gate's level can't be shown, if it can't.
    in property <string> gate-meter-note;
    /// Testing the microphone: it plays back, and its level shows beside the
    /// button; why it can't play, if it can't; and a call going on, which
    /// leaves the test off.
    in-out property <bool> microphone-testing;
    in property <string> microphone-test-note;
    in property <bool> calling;
    /// How calls send the microphone: 0 voice activity, 1 push to talk.
    in-out property <int> input-mode;
    /// The push-to-talk keybind's name, empty while there's none, and
    /// whether the keys pressed next become it, and those pressed so far.
    in property <string> talk-key;
    in-out property <bool> talk-recording;
    in property <string> recorded-keys;
    /// How long the microphone keeps sending after the key comes up, in ms.
    in-out property <int> talk-delay: 20;
    /// Where the key works: in every app, or only in Yapfast and why.
    in property <string> talk-note;
    /// Discord is linked, so its calls' noise suppression shows.
    in property <bool> discord;
    /// How loud every call sends the microphone and plays, as sliders'
    /// percentages from 0% to 200%. Dragging plays each step through
    /// call-volumes-changed, and letting go saves the last.
    in-out property <int> microphone-volume: 100;
    in-out property <int> speaker-volume: 100;
    /// How loud the Discord soundboard plays, on its slider from 0% to
    /// 100%, for every client of the account.
    in-out property <int> soundboard-volume: 100;
    /// Entrance sounds: the servers to choose one for, "All servers" first,
    /// the one chosen, its sound's name or empty, and the sounds to choose
    /// from, which need Nitro.
    in property <[string]> entrance-servers;
    in-out property <int> entrance-server;
    in property <string> entrance-sound;
    in property <[SoundRow]> entrance-rows;
    in property <bool> nitro;
    in property <string> emoji-font;
    callback soundboard-volume-committed(int);
    /// The entrance sounds' names and choices are wanted.
    callback entrance-sounds-wanted;
    callback entrance-server-chosen(int);
    /// Sets the chosen server's entrance sound, or takes it away with "".
    callback choose-entrance-sound(string);
    callback call-volumes-changed;
    callback select-microphone(int);
    callback select-speaker(int);
    callback select-camera(int);
    callback refresh-devices;
    callback preferences-changed;
    /// Starts or stops recording the push-to-talk keybind.
    callback record-talk-key(bool);
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Voice & video"); }
    // Each row's two columns take half the width each, whatever is in them:
    // a column starts at its least width and stretches from there, so none
    // has one.
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: @tr("MICROPHONE"); }
            ComboBox { min-height: 36px; model: root.microphones; current-index <=> root.microphone-index; enabled: root.microphones.length > 0; accessible-label: @tr("Microphone device"); selected => { root.select-microphone(self.current-index); } }
            VolumeSlider {
                label: @tr("Microphone volume"); value <=> root.microphone-volume;
                changed => { root.call-volumes-changed(); }
                committed => { root.preferences-changed(); }
            }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: @tr("SPEAKERS"); }
            ComboBox { min-height: 36px; model: root.speakers; current-index <=> root.speaker-index; enabled: root.speakers.length > 0; accessible-label: @tr("Speaker device"); selected => { root.select-speaker(self.current-index); } }
            VolumeSlider {
                label: @tr("Speaker volume"); value <=> root.speaker-volume;
                changed => { root.call-volumes-changed(); }
                committed => { root.preferences-changed(); }
            }
        }
    }
    if root.microphones.length == 0 && root.speakers.length == 0: Label { text: @tr("No audio devices found. Connect one, then refresh."); }
    // Plays the microphone back as Discord calls process it, as Discord's Mic
    // Test does, with its level beside the button.
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("MICROPHONE TEST"); }
        HorizontalLayout {
            spacing: 16px;
            // As wide as the wider of its labels, so the bar holds still as
            // it turns.
            Rectangle {
                width: max(start-label.preferred-width, stop-label.preferred-width) + 20px; height: 28px;
                ActionButton {
                    width: parent.width; height: parent.height; small: true;
                    text: root.microphone-testing ? @tr("Stop testing") : @tr("Test microphone");
                    enabled: !root.calling && root.microphones.length > 0;
                    clicked => { root.microphone-testing = !root.microphone-testing; }
                }
                start-label := Text { width: 0px; height: 0px; visible: false; accessible-role: none; text: @tr("Test microphone"); font-size: 14px; font-weight: 700; }
                stop-label := Text { width: 0px; height: 0px; visible: false; accessible-role: none; text: @tr("Stop testing"); font-size: 14px; font-weight: 700; }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; min-width: 0;
                LevelBar {
                    level: root.microphone-testing ? root.gate-level : -100;
                    accessible-role: progress-indicator; accessible-label: @tr("Microphone level");
                    accessible-value: root.microphone-testing ? @tr("{} dB", round(max(-80, root.gate-level))) : "";
                }
            }
        }
        Label {
            text: root.calling ? @tr("Leave the call to test your microphone.")
                : root.microphone-testing && root.gate-meter-note != "" ? root.gate-meter-note
                : root.microphone-testing && root.microphone-test-note != "" ? root.microphone-test-note
                : @tr("Hear how your microphone sounds in Discord calls, with its noise suppression and volume, without holding a key. Use headphones: through speakers, the microphone hears itself.");
        }
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0; alignment: start;
            SettingsHeading { text: @tr("CAMERA"); }
            ComboBox { min-height: 36px; model: root.cameras; current-index <=> root.camera-index; enabled: root.cameras.length > 0; accessible-label: @tr("Camera device"); selected => { root.select-camera(self.current-index); } }
            if root.cameras.length == 0: Label { text: @tr("No camera found. Connect one, then refresh."); }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            SettingsHeading { text: @tr("PREVIEW"); }
            Rectangle {
                height: self.width * 9 / 16; border-radius: 8px; background: #000000; clip: true;
                accessible-role: image; accessible-label: root.camera-testing ? @tr("Your camera") : @tr("Camera preview, off");
                if root.camera-testing: Image { width: parent.width; height: parent.height; source: root.camera-preview; image-fit: contain; }
                // Black in every theme, as a camera's picture.
                if !root.camera-testing || root.camera-preview.width == 0: VerticalLayout {
                    alignment: center; spacing: 10px; padding: 12px;
                    Image { height: 30px; source: @image-url("icons/video.svg"); image-fit: contain; colorize: #b5b8c1; }
                    Text {
                        text: root.camera-note != "" ? root.camera-note : root.camera-testing ? @tr("Starting your camera...") : @tr("Your camera is off.");
                        color: #b5b8c1; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                ActionButton {
                    text: root.camera-testing ? @tr("Stop video") : @tr("Test video"); small: true; enabled: root.cameras.length > 0;
                    clicked => { root.camera-testing = !root.camera-testing; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        LinkButton { text: @tr("Refresh devices"); icon: @image-url("icons/refresh-cw.svg"); small: true; clicked => { root.refresh-devices(); } }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: @tr("Turn on your microphone when you join a call");
        description: @tr("Otherwise you join muted, and unmute when you're ready.");
        checked <=> root.unmute-on-join;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Even out your voice");
        description: @tr("Keeps your voice steady as you lean towards the microphone or away from it. Whispers and shouts still come through as they are.");
        checked <=> root.level-voice;
        toggled => { root.preferences-changed(); }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("LEAVE A DM CALL WHEN YOU'RE ALONE"); }
        Choices {
            wrap: true;
            label: @tr("Leave a DM call when you're alone");
            options: [@tr("Never"), @tr("3 min"), @tr("10 min"), @tr("30 min"), @tr("1 hour")];
            current <=> root.alone-wait;
            chosen => { root.preferences-changed(); }
        }
        Label { text: @tr("Once everyone else has left a DM or group call, or nobody has answered yours, you leave it after this long. Server voice channels keep you until you leave."); }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("NOISE SUPPRESSION IN DISCORD CALLS"); }
        Choices {
            wrap: true;
            label: @tr("Noise suppression in Discord calls"); options: ["DeepFilterNet", "RNNoise", @tr("Off")];
            current <=> root.noise-suppression;
            chosen => { root.preferences-changed(); }
        }
        Label { text: @tr("DeepFilterNet also takes out typing and other sudden noise. RNNoise uses less processing. Off sends your microphone as it is, for a quiet room. A call going on switches straight away."); }
    }
    if root.discord && root.noise-suppression != 2: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("NOISE SUPPRESSION STRENGTH"); }
        Choices {
            wrap: true;
            label: @tr("Noise suppression strength"); options: [@tr("Full"), @tr("Medium"), @tr("Light")];
            current <=> root.noise-strength;
            chosen => { root.preferences-changed(); }
        }
        Label { text: @tr("Full takes out the most noise, but can cut off giggles and breathy laughs. Medium and Light leave a little of the room's sound in, which can sound more natural, and let a little more noise through."); }
    }
    // A slider's own label names its section, its value on the same line.
    if root.discord: VerticalLayout {
        spacing: 8px;
        VolumeSlider {
            label: @tr("Soundboard volume"); value <=> root.soundboard-volume; maximum: 100;
            committed(value) => { root.soundboard-volume-committed(value); }
        }
        Label { text: @tr("How loud soundboard sounds play in Discord calls, yours and everyone else's. Discord keeps it for all your devices."); }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        init => { root.entrance-sounds-wanted(); }
        SettingsHeading { text: @tr("ENTRANCE SOUNDS"); }
        HorizontalLayout {
            spacing: 8px;
            Picker {
                width: 200px; model: root.entrance-servers; chosen: root.entrance-server;
                accessible-label: @tr("Entrance sound for");
                selected => { root.entrance-server = self.current-index; root.entrance-server-chosen(self.current-index); }
            }
            Rectangle {
                horizontal-stretch: 1; min-width: 0; height: 36px; border-radius: 8px; background: Theme.sunken;
                border-width: 1px; border-color: Theme.line;
                accessible-role: text; accessible-label: @tr("Entrance sound");
                accessible-value: root.entrance-sound != "" ? root.entrance-sound : @tr("None");
                Text {
                    x: 12px; width: parent.width - 24px; overflow: elide; font-size: 14px;
                    text: root.entrance-sound != "" ? root.entrance-sound : @tr("None");
                    color: root.entrance-sound != "" ? Theme.text : Theme.muted;
                }
            }
            choose := ActionButton {
                text: @tr("Choose"); enabled: root.nitro;
                clicked => { chooser.show(); }
            }
            if root.entrance-sound != "": ActionButton {
                text: @tr("Remove"); ghost: true;
                clicked => { root.choose-entrance-sound(""); }
            }
        }
        Label {
            text: root.nitro ? @tr("Plays to everyone in a voice channel or DM call as you join it, outside stage channels. A server's own comes before the one for all servers.")
                : @tr("Entrance sounds play to everyone as you join a voice channel. They need Nitro.");
        }
        chooser := PopupWindow {
            x: choose.x + choose.width - self.width; y: choose.y + choose.height + 6px;
            width: board.width; height: board.height;
            close-policy: PopupClosePolicy.close-on-click-outside;
            board := Soundboard {
                title: @tr("Choose an entrance sound"); extras: false; verb: @tr("Choose");
                rows: root.entrance-rows; emoji-font: root.emoji-font;
                play(id) => { root.choose-entrance-sound(id); chooser.close(); }
                close => { chooser.close(); }
            }
        }
    }
    if root.discord: SettingsSwitch {
        text: @tr("Take out your room's echo in Discord calls");
        description: @tr("For a bare or echoey room that makes your voice sound far away. Uses a little more processing, and your voice goes out 10 ms later.");
        checked <=> root.dereverb;
        toggled => { root.preferences-changed(); }
    }
    if root.discord && root.windows-effects-choice: SettingsSwitch {
        text: @tr("Let Windows process your microphone in Discord calls");
        description: @tr("Runs the effects Windows and your sound driver add to the microphone, such as their own noise suppression. Off, Yapfast skips them, as they can muffle your voice on top of Yapfast's. Turn it on if your microphone sounds worse without them, as some laptop microphones can.");
        checked <=> root.windows-effects;
        toggled => { root.preferences-changed(); }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("INPUT MODE"); }
        Choices {
            wrap: true;
            label: @tr("Input mode"); options: [@tr("Voice activity"), @tr("Push to talk")];
            current <=> root.input-mode;
            chosen => { root.preferences-changed(); }
        }
        Label {
            text: root.input-mode == 0 ? @tr("Yapfast sends your voice when it hears you speak.")
                : @tr("Yapfast sends your microphone only while you hold a key.");
        }
    }
    if root.input-mode == 1: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("PUSH TO TALK KEYBIND"); }
        KeyRecorder {
            label: @tr("Push to talk keybind"); keys: root.talk-key;
            recording: root.talk-recording; recorded-keys: root.recorded-keys;
            record(on) => { root.record-talk-key(on); }
        }
        Label {
            text: root.talk-recording ? @tr("Press the keys to hold while you talk, then let go. Escape stops without changing it.")
                : root.talk-key == "" ? @tr("Push to talk is on, but no keybind is set, so your microphone sends nothing.")
                : root.talk-note;
        }
    }
    if root.input-mode == 1: VerticalLayout {
        spacing: 8px;
        VolumeSlider {
            label: @tr("Push to talk release delay"); value <=> root.talk-delay; maximum: 2000; step: 10; full-mark: false;
            shown: self.value >= 1000 ? @tr("{} s", (self.value / 1000).to-fixed(2)) : @tr("{} ms", self.value);
            committed => { root.preferences-changed(); }
        }
        Label { text: @tr("How long your microphone keeps sending after you let go of the key, so the end of a word isn't cut off."); }
    }
    if root.discord && root.input-mode == 0: VerticalLayout {
        spacing: 8px;
        SensitivitySlider {
            label: @tr("Input sensitivity"); value <=> root.sensitivity;
            level: root.gate-level; sending: root.gate-sending;
            committed => { root.preferences-changed(); }
        }
        Label {
            text: root.gate-meter-note != "" ? root.gate-meter-note
                : @tr("Yapfast sends your voice when it's louder than the handle, and other sounds when they're 18 dB louder still. The bar is your microphone after noise suppression and at its volume, as Yapfast hears it to decide.");
        }
    }
}

/// A theme as Appearance offers it: its name, and the colours of its preview.
export struct ThemeCard {
    id: string,
    name: string,
    /// One of the person's own, which can be edited.
    custom: bool,
    rail: color,
    sidebar: color,
    chat: color,
    raised: color,
    accent: color,
    text: color,
    muted: color,
}

/// A colour in the theme editor: its name, the colour, and its field's text,
/// wrong when that isn't a colour.
export struct ThemeColour {
    name: string,
    colour: color,
    hex: string,
    wrong: bool,
}

// A theme to choose: a small window drawn in its own colours, with its name
// below. The current one has an accent ring and a check; the person's own
// themes have a pencil that edits them.
component ThemeTile inherits Rectangle {
    in property <ThemeCard> card;
    in property <bool> current;
    callback choose();
    callback edit();
    border-radius: 10px;
    border-width: root.current || focus.has-focus ? 2px : 1px;
    border-color: root.current || focus.has-focus ? Theme.accent : pointer.has-hover ? Theme.faint : Theme.line;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background, border-color { duration: Theme.quick; }
    preview := Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 78px;
        border-radius: 6px; clip: true; background: root.card.chat;
        // The rail with three servers, the first selected.
        Rectangle {
            x: 0px; width: 16px; background: root.card.rail;
            for index in 3: Rectangle {
                x: 3px; y: 6px + index * 13px; width: 10px; height: 10px; border-radius: index == 0 ? 3px : 5px;
                background: index == 0 ? root.card.accent : root.card.raised;
            }
        }
        // The sidebar's channels, one of them open.
        Rectangle {
            x: 16px; width: 38px; background: root.card.sidebar;
            for index in 4: Rectangle {
                x: 6px; y: 8px + index * 11px; height: 4px; border-radius: 2px;
                width: index == 1 ? 24px : 18px + mod(index, 2) * 4px;
                background: index == 1 ? root.card.text : root.card.muted;
            }
        }
        // Two messages and the composer.
        for index in 2: Rectangle {
            x: 60px; y: 8px + index * 22px; width: parent.width - 66px; height: 16px;
            Rectangle { x: 0px; y: 0px; width: 10px; height: 10px; border-radius: 5px; background: index == 0 ? root.card.accent : root.card.muted; }
            Rectangle { x: 14px; y: 1px; width: index == 0 ? 22px : 16px; height: 4px; border-radius: 2px; background: root.card.text; }
            Rectangle { x: 14px; y: 8px; width: min(parent.width - 14px, index == 0 ? 52px : 40px); height: 3px; border-radius: 1.5px; background: root.card.muted; }
        }
        Rectangle {
            x: 60px; y: parent.height - 18px; width: parent.width - 66px; height: 12px;
            border-radius: 4px; background: root.card.raised;
            Rectangle { x: parent.width - 10px; width: 6px; height: 6px; border-radius: 3px; background: root.card.accent; }
        }
    }
    HorizontalLayout {
        x: 10px; y: preview.y + preview.height + 6px; width: parent.width - 20px - (root.card.custom ? 26px : 0px); height: 24px; spacing: 6px;
        Text {
            text: root.card.name; color: root.current ? Theme.text : Theme.secondary; font-size: 14px;
            animate color { duration: Theme.quick; }
            font-weight: root.current ? 700 : 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
        if root.current: Image {
            width: 16px; source: @image-url("icons/check.svg"); colorize: Theme.accent; image-fit: contain;
        }
    }
    focus := FocusScope {
        accessible-role: button;
        accessible-label: root.current ? @tr("{}, chosen", root.card.name) : root.card.name;
        accessible-action-default => { root.choose(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.choose(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.choose(); }
        }
    }
    if root.card.custom: IconButton {
        x: parent.width - 8px - self.width; y: preview.y + preview.height + 6px; height: 24px;
        icon: @image-url("icons/pencil.svg"); label: @tr("Edit {}", root.card.name); size: 24px; glyph: 14px;
        clicked => { root.edit(); }
    }
}

// A colour in the theme editor: a swatch, its name, and its hex in a field
// that says when it holds no colour.
component ThemeColourRow inherits HorizontalLayout {
    in property <ThemeColour> colour;
    callback edited(string);
    spacing: 10px;
    Middle {
        Rectangle {
            width: 28px; height: 28px; border-radius: 6px; background: root.colour.colour;
            border-width: 1px; border-color: Theme.line;
        }
    }
    VerticalLayout {
        alignment: center; horizontal-stretch: 1;
        Text { text: root.colour.name; color: Theme.text; font-size: 14px; overflow: elide; }
        if root.colour.wrong: Text { text: @tr("Not a colour"); color: Theme.danger; font-size: 12px; overflow: elide; }
    }
    Middle {
        TextField {
            width: 116px; min-height: 34px; text-size: 14px; pad: 8px;
            fill: root.colour.wrong ? Theme.danger.with-alpha(0.16) : Theme.sunken;
            text: root.colour.hex; label: root.colour.name;
            edited(text) => { root.edited(text); }
        }
    }
}

/// A font file the person chose, in Appearance: its name, the faces it gave
/// or why it gave none, a warning on what it lacks, and the weight and slant
/// of its first face, which its sample is drawn in.
export struct FontFile { name: string, detail: string, problem: bool, warning: string, weight: int, italic: bool }

// A font file in Appearance's list: a sample of its first face, or a warning
// sign when it gave none, its name, its faces or why it gave none, and the
// button that takes it out.
component FontFileRow inherits HorizontalLayout {
    in property <FontFile> file;
    callback remove();
    padding-left: 12px; padding-right: 8px; padding-top: 10px; padding-bottom: 10px;
    spacing: 12px;
    accessible-role: list-item;
    accessible-label: root.file.name;
    accessible-description: root.file.warning != "" ? root.file.detail + ". " + root.file.warning : root.file.detail;
    Middle {
        Rectangle {
            width: 40px; height: 40px; border-radius: 8px; background: Theme.sunken;
            border-width: 1px; border-color: Theme.line;
            if !root.file.problem: Text {
                text: "Aa"; color: Theme.text; font-size: 18px;
                font-weight: root.file.weight; font-italic: root.file.italic;
                horizontal-alignment: center; vertical-alignment: center;
                accessible-role: none;
            }
            if root.file.problem: Image {
                width: 18px; source: @image-url("icons/triangle-alert.svg"); colorize: Theme.danger-text; image-fit: contain;
            }
        }
    }
    VerticalLayout {
        alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0;
        Text { text: root.file.name; color: Theme.text; font-size: 15px; overflow: elide; }
        Text {
            text: root.file.detail; font-size: 13px; wrap: word-wrap;
            color: root.file.problem ? Theme.danger-text : Theme.muted;
        }
        // The sign in the warning colour, the words in one every theme
        // reads at this size.
        if root.file.warning != "": HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                padding-top: 2px; alignment: start;
                Image { width: 14px; height: 14px; source: @image-url("icons/triangle-alert.svg"); colorize: Theme.loud; image-fit: contain; }
            }
            Text { text: root.file.warning; color: Theme.secondary; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
    Middle {
        IconButton {
            icon: @image-url("icons/x.svg"); label: @tr("Remove {}", root.file.name); size: 32px; glyph: 16px;
            clicked => { root.remove(); }
        }
    }
}

// Settings: the window's colours, from the themes Yapfast comes with and the
// person's own. A click shows one at once. New theme opens the editor, whose
// changes show at once too; Save keeps them, Cancel restores the theme from
// before.
export component AppearanceSettings inherits VerticalLayout {
    callback preferences-changed();
    in-out property <bool> show-nameplates;
    in property <[ThemeCard]> themes;
    in property <string> theme-id;
    /// The editor, while it's open: the colours, the name, whether the theme
    /// is dark, and whether it edits a saved theme rather than making one,
    /// from the theme at start-index among the starts.
    in property <bool> editor;
    in property <[ThemeColour]> colours;
    in-out property <string> theme-name;
    in-out property <bool> theme-dark;
    in property <bool> editing-saved;
    in property <[string]> starts;
    in property <int> start-index;
    in property <bool> can-save;
    /// How the last import or export of a theme file went, under the
    /// theme's heading or the editor's name; `note-wrong` when it didn't.
    in property <string> note;
    in property <bool> note-wrong;
    callback import-theme();
    callback export-theme();
    callback choose-theme(string);
    callback new-theme();
    callback edit-theme(string);
    callback start-chosen(int);
    callback colour-edited(int, string);
    callback dark-toggled(bool);
    callback save-theme();
    callback cancel-theme();
    callback delete-theme();
    /// The desktop draws the window's title bar; offered where Yapfast can
    /// draw its own.
    in-out property <bool> system-title-bar;
    in property <bool> title-bar-choice;
    callback title-bar-toggled();
    /// The interface's languages, after a first row that follows the
    /// system, and the row chosen.
    in property <[string]> languages;
    in property <int> language;
    callback language-chosen(int);
    /// The font files chosen, a note on them, such as which of those chosen
    /// last weren't added, and whether files chosen are being copied in.
    in property <[FontFile]> font-files;
    in property <string> font-note;
    in property <bool> font-importing;
    callback choose-font-files();
    callback remove-font-file(int);
    callback reset-font();
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Appearance"); }
    if !root.editor: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            SettingsHeading { text: @tr("THEME"); vertical-alignment: center; horizontal-stretch: 1; }
            ActionButton {
                text: @tr("Import"); label: @tr("Import a theme file"); small: true; icon: @image-url("icons/folder.svg");
                clicked => { root.import-theme(); }
            }
            ActionButton {
                text: @tr("New theme"); small: true; icon: @image-url("icons/circle-plus.svg");
                clicked => { root.new-theme(); }
            }
        }
        if root.note != "": Text {
            text: root.note; color: root.note-wrong ? Theme.danger-text : Theme.secondary;
            font-size: 13px; wrap: word-wrap;
        }
        // As many 150px or wider cards across as fit, in rows.
        Rectangle {
            property <length> gap: 12px;
            property <int> columns: max(1, floor((self.width + self.gap) / (150px + self.gap)));
            property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
            property <length> card-height: 124px;
            height: ceil(root.themes.length / self.columns) * (self.card-height + self.gap) - self.gap;
            accessible-role: list; accessible-label: @tr("Themes");
            for card[index] in root.themes: ThemeTile {
                x: mod(index, parent.columns) * (parent.card-width + parent.gap);
                y: floor(index / parent.columns) * (parent.card-height + parent.gap);
                width: parent.card-width; height: parent.card-height;
                card: card; current: card.id == root.theme-id;
                choose => { root.choose-theme(card.id); }
                edit => { root.edit-theme(card.id); }
            }
        }
    }
    if !root.editor: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("LANGUAGE"); }
        HorizontalLayout {
            alignment: start;
            Picker {
                width: 260px;
                model: root.languages; chosen: root.language;
                accessible-label: @tr("Language");
                selected => { root.language-chosen(self.current-index); }
            }
        }
    }
    if !root.editor: VerticalLayout {
        spacing: 8px;
        // As the theme's heading: the action at its end.
        HorizontalLayout {
            spacing: 8px;
            SettingsHeading { text: @tr("FONT"); vertical-alignment: center; horizontal-stretch: 1; }
            ActionButton {
                text: root.font-importing ? @tr("Adding…") : @tr("Add font files"); small: true;
                icon: @image-url("icons/circle-plus.svg"); enabled: !root.font-importing;
                clicked => { root.choose-font-files(); }
            }
        }
        Label { text: @tr("Draw the whole interface in a font of your own: add its TTF, OTF, TTC or WOFF files, each weight and italic you have. Code and emoji keep their fonts."); }
        // The files in a rimmed card, as the page's other groups, a line
        // between each.
        if root.font-files.length > 0: Rectangle {
            border-radius: 8px; border-width: 1px; border-color: Theme.line;
            accessible-role: list; accessible-label: @tr("Font files");
            VerticalLayout {
                for file[index] in root.font-files: VerticalLayout {
                    if index > 0: Rectangle { height: 1px; background: Theme.line; }
                    FontFileRow {
                        file: file;
                        remove => { root.remove-font-file(index); }
                    }
                }
            }
        }
        if root.font-note != "": Text { text: root.font-note; color: Theme.danger-text; font-size: 13px; wrap: word-wrap; }
        if root.font-files.length > 0: HorizontalLayout {
            alignment: start;
            LinkButton { text: @tr("Back to the bundled font"); small: true; clicked => { root.reset-font(); } }
        }
    }
    if !root.editor && root.title-bar-choice: SettingsSwitch {
        text: @tr("Use the system title bar");
        description: @tr("Your desktop draws the window's title bar and buttons, as on its other windows. Off, Yapfast draws its own.");
        checked <=> root.system-title-bar;
        toggled => { root.title-bar-toggled(); }
    }
    // The heading 8px over its switches, which keep the page's 16px apart.
    if !root.editor: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("PROFILES"); }
        VerticalLayout {
            spacing: 16px;
            SettingsSwitch {
                text: @tr("Play profile effects");
                description: @tr("The animations some people put over their profile cards.");
                checked <=> Looks.profile-effects;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Show avatar decorations");
                description: @tr("The pictures around people's avatars.");
                checked <=> Looks.decorations;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Show nameplates");
                description: @tr("The pictures Discord members equip behind their rows in the member list and on your account card.");
                checked <=> root.show-nameplates;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Animate decorations and nameplates");
                description: @tr("They play when pointed at, as in Discord. Off, they hold still.");
                checked <=> Looks.moving;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Show name styles");
                description: @tr("The fonts and colours people give their display names.");
                checked <=> Looks.name-styles;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Show server tags");
                description: @tr("The tag and its badge beside people's names.");
                checked <=> Looks.server-tags;
                toggled => { root.preferences-changed(); }
            }
            SettingsSwitch {
                text: @tr("Show profile frames");
                description: @tr("The frames some people put around their profile cards.");
                checked <=> Looks.profile-frames;
                toggled => { root.preferences-changed(); }
            }
        }
    }
    if root.editor: form := VerticalLayout {
        property <bool> confirming;
        spacing: 16px;
        VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: root.editing-saved ? @tr("EDIT THEME") : @tr("NEW THEME"); }
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    text <=> root.theme-name; placeholder: @tr("Name"); label: @tr("Theme name"); min-height: 36px; text-size: 15px;
                    accepted => { root.save-theme(); }
                }
                ActionButton { text: @tr("Save"); primary: true; enabled: root.can-save; clicked => { root.save-theme(); } }
                ActionButton { text: @tr("Cancel"); clicked => { root.cancel-theme(); } }
                ActionButton {
                    text: @tr("Export"); label: @tr("Export to a file"); icon: @image-url("icons/download.svg"); enabled: root.can-save;
                    clicked => { root.export-theme(); }
                }
            }
            if root.note != "": Text {
                text: root.note; color: root.note-wrong ? Theme.danger-text : Theme.secondary;
                font-size: 13px; wrap: word-wrap;
            }
        }
        if !root.editing-saved: VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: @tr("START FROM"); }
            ComboBox {
                min-height: 36px;
                model: root.starts; current-index: root.start-index; accessible-label: @tr("Start from");
                selected => { root.start-chosen(self.current-index); }
            }
        }
        SettingsSwitch {
            text: @tr("Dark"); description: @tr("Drop-down lists and scroll bars draw dark to match.");
            checked <=> root.theme-dark; toggled(dark) => { root.dark-toggled(dark); }
        }
        VerticalLayout {
            spacing: 8px;
            SettingsHeading { text: @tr("COLOURS"); }
            Label { text: @tr("Each as #rgb, #rrggbb or #rrggbbaa. The window shows a change as you type it."); }
            // Two columns when they fit, read down.
            Rectangle {
                property <int> columns: self.width >= 520px ? 2 : 1;
                property <length> gap: 24px;
                property <length> row-height: 46px;
                property <length> cell-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                property <int> rows: ceil(root.colours.length / self.columns);
                height: self.rows * self.row-height;
                accessible-role: list; accessible-label: @tr("Colours");
                for row[index] in root.colours: ThemeColourRow {
                    x: floor(index / parent.rows) * (parent.cell-width + parent.gap);
                    y: mod(index, parent.rows) * parent.row-height;
                    width: parent.cell-width; height: parent.row-height;
                    colour: row;
                    edited(text) => { root.colour-edited(index, text); }
                }
            }
        }
        if root.editing-saved: HorizontalLayout {
            alignment: start;
            ActionButton {
                text: form.confirming ? @tr("Delete it for good") : @tr("Delete theme"); danger: true; small: true;
                icon: @image-url("icons/trash-2.svg");
                clicked => {
                    if form.confirming { root.delete-theme(); } else { form.confirming = true; }
                }
            }
        }
    }
}

// Settings: how messages look, and what they share.
export component MessageSettings inherits VerticalLayout {
    in property <length> message-font-size;
    in-out property <bool> twelve-hour-clock;
    in-out property <bool> clock-seconds;
    /// The date format: 0 day first, 1 month first, 2 year first; -1 follows the clock.
    in-out property <int> date-format: -1;
    /// Message text: 0 small, 1 default, 2 large.
    in-out property <int> text-size;
    in-out property <bool> link-previews;
    in-out property <bool> collapse-long;
    in-out property <bool> boost-gems;
    in-out property <bool> share-typing;
    /// When animations play: 0 while Yapfast has the focus, 1 always, 2 never.
    in-out property <int> animate;
    in-out property <bool> reply-ping;
    in-out property <bool> strip-tracking;
    /// The networks in use, which the descriptions name.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Messages"); }
    // A message as the chosen text size and clock show it.
    Rectangle {
        border-radius: 8px; border-width: 1px; border-color: Theme.line;
        accessible-role: groupbox; accessible-label: @tr("Preview");
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            VerticalLayout { alignment: start; Avatar { initial: "S"; tint: #c0679a; } }
            VerticalLayout {
                spacing: 3px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Sam"; color: Theme.text; font-size: root.message-font-size; font-weight: 700; }
                    Text { text: (root.twelve-hour-clock ? "9:41" : "21:41") + (root.clock-seconds ? ":05" : "") + (root.twelve-hour-clock ? " PM" : ""); color: Theme.muted; font-size: root.message-font-size - 3px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: @tr("Thinking co-op after nine, if people are up for it."); color: Theme.text; font-size: root.message-font-size; wrap: word-wrap; }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("TEXT SIZE"); }
        Choices {
            wrap: true;
            label: @tr("Text size"); options: [@tr("Small"), @tr("Default"), @tr("Large")];
            current <=> root.text-size;
            chosen => { root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("CLOCK"); }
        Choices {
            wrap: true;
            label: @tr("Clock"); options: [@tr("24-hour"), @tr("12-hour")];
            current: root.twelve-hour-clock ? 1 : 0;
            chosen(index) => { root.twelve-hour-clock = index == 1; root.preferences-changed(); }
        }
        SettingsSwitch {
            text: @tr("Show seconds");
            description: @tr("Message times show them, as 21:41:05.");
            checked <=> root.clock-seconds;
            toggled => { root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("DATE FORMAT"); }
        Choices {
            wrap: true;
            label: @tr("DATE FORMAT"); options: [@tr("Day/Month/Year"), @tr("Month/Day/Year"), @tr("Year-Month-Day")];
            current: root.date-format >= 0 ? root.date-format : root.twelve-hour-clock ? 1 : 0;
            chosen(index) => { root.date-format = index; root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("PLAY GIFS, EMOJI AND STICKERS"); }
        Choices {
            wrap: true;
            label: @tr("Play GIFs, emoji and stickers"); options: [@tr("While Yapfast is focused"), @tr("Never")];
            current <=> root.animate;
            chosen => { root.preferences-changed(); }
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: @tr("Show link previews");
        description: @tr("Cards for links, videos and bots under messages. Linked pictures still show.");
        checked <=> root.link-previews;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Collapse long messages");
        description: @tr("Long messages and code show their first lines, with Show more to see the rest.");
        checked <=> root.collapse-long;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Show boost gems");
        description: @tr("A gem by the name of each member boosting their Discord server, in the member list.");
        checked <=> root.boost-gems;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Let others see when you're typing");
        description: root.matrix && root.discord ? @tr("Discord and Matrix show \"typing...\" while you write. Others still show here when they type.")
            : root.matrix ? @tr("Matrix shows \"typing...\" while you write. Others still show here when they type.")
            : @tr("Discord shows \"typing...\" while you write. Others still show here when they type.");
        checked <=> root.share-typing;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Mention people you reply to");
        description: @tr("They get notified of your reply. Switch it for one reply with @ On on the reply bar.");
        checked <=> root.reply-ping;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Remove tracking from links you send");
        description: @tr("Takes out tags like utm_source and fbclid, and share ids from YouTube, Spotify and X. The links still go to the same page.");
        checked <=> root.strip-tracking;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: desktop notifications.
export component NotificationSettings inherits VerticalLayout {
    in-out property <bool> notifications;
    in-out property <bool> notification-text;
    in-out property <bool> flash-taskbar;
    /// The networks in use, whose rules decide what notifies.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Notifications"); }
    SettingsSwitch {
        text: @tr("Show desktop notifications");
        description: root.matrix && root.discord ? @tr("For new messages while Yapfast isn't in front. Each Discord server's notification settings and your Matrix notification rules decide which: usually DMs and mentions. Clicking one opens the conversation.")
            : root.matrix ? @tr("For new messages while Yapfast isn't in front. Your Matrix notification rules decide which: usually DMs and mentions. Clicking one opens the conversation.")
            : @tr("For new messages while Yapfast isn't in front. Each Discord server's notification settings decide which: usually DMs and mentions. Clicking one opens the conversation.");
        checked <=> root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Show what messages say");
        description: @tr("Off shows only who wrote and where, for a screen others can see.");
        checked <=> root.notification-text;
        enabled: root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Flash the taskbar");
        description: @tr("For a message that notifies while Yapfast isn't in front. The window's title counts mentions and DMs waiting either way.");
        checked <=> root.flash-taskbar;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: Yapfast's own sounds for calls and messages, which instrument plays
// them, and how loud they are, all together or each on its own.
export component SoundSettings inherits VerticalLayout {
    /// The set, in the order the choices show.
    in-out property <int> sound-set;
    /// Percentages: all the sounds, and each against that, in the order of
    /// `names`.
    in-out property <int> volume;
    in-out property <bool> adjust-each;
    in property <[int]> each;
    callback preferences-changed;
    callback each-changed(int, int);
    /// Plays a sound by its index in `names`, as it's set.
    callback play(int);
    property <[string]> names: [@tr("Someone joins the call"), @tr("Someone leaves the call"), @tr("Muting"), @tr("Unmuting"), @tr("Deafening"), @tr("Undeafening"), @tr("A message"), @tr("A mention"), @tr("Someone starts watching a stream"), @tr("Someone stops watching a stream"), @tr("Someone starts streaming"), @tr("Someone stops streaming")];
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Sounds"); }
    Label { text: @tr("Yapfast plays these as you and others join and leave a call, as you mute and deafen, as others start and stop streaming, as they start and stop watching your stream or the one you watch, and for messages that notify, except in the conversation in front of you. They play on the speakers chosen for calls."); }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("SOUND SET"); }
        // A list, as Discord offers its sound packs: six names side by side
        // run wider than the page in a translation.
        HorizontalLayout {
            alignment: start;
            Picker {
                width: 260px;
                model: [@tr("New Kalimba"), @tr("Felt piano"), @tr("Soft marimba"), @tr("Mellow Rhodes"), @tr("Glow"), @tr("Flute")];
                chosen: root.sound-set;
                accessible-label: @tr("Sound set");
                selected => { root.sound-set = self.current-index; root.preferences-changed(); root.play(0); }
            }
        }
    }
    VolumeSlider {
        label: @tr("Volume"); maximum: 200;
        value <=> root.volume;
        committed => { root.preferences-changed(); root.play(6); }
    }
    SettingsSwitch {
        text: @tr("Adjust each sound");
        description: @tr("Set how loud each one is, as a share of the volume above. 0% turns a sound off.");
        checked <=> root.adjust-each;
        toggled => { root.preferences-changed(); }
    }
    if root.adjust-each: VerticalLayout {
        spacing: 12px;
        for name[index] in root.names: HorizontalLayout {
            spacing: 12px;
            VolumeSlider {
                label: name; maximum: 100; value: root.each[index]; horizontal-stretch: 1;
                committed(value) => { root.each-changed(index, value); root.play(index); }
            }
            Middle { IconButton { icon: @image-url("icons/play.svg"); label: @tr("Play {}", name); clicked => { root.play(index); } } }
        }
    }
}

// Settings: how Yapfast draws its window and encodes a shared screen. Slint
// picks a renderer once per process, so a change to that waits for a
// restart, which this offers; encoding changes from the next stream. Also
// Developer Mode, which shows Copy ID in menus.
export component AdvancedSettings inherits VerticalLayout {
    in-out property <bool> gpu-rendering;
    in-out property <bool> gpu-encoding;
    in property <bool> gpu-running;
    in-out property <bool> close-to-tray;
    in property <bool> tray-available;
    in-out property <bool> multiple-windows;
    in-out property <bool> developer-mode;
    in-out property <bool> start-on-sign-in;
    in property <bool> autostart-available;
    in-out property <bool> discord-links;
    in property <bool> discord-links-available;
    callback preferences-changed;
    callback restart;
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Advanced"); }

    if root.autostart-available: SettingsSwitch {
        text: @tr("Start when you sign in");
        description: @tr("Yapfast starts in the system tray when you sign in to your computer, so messages and calls reach you.");
        checked <=> root.start-on-sign-in;
        toggled => { root.preferences-changed(); }
    }
    if root.discord-links-available: SettingsSwitch {
        text: @tr("Open Discord links in Yapfast");
        description: @tr("discord:// links from other apps and shortcuts open here instead of Discord. Turning it off gives them back to the app that had them.");
        checked <=> root.discord-links;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Close to tray");
        description: root.tray-available
            ? @tr("Closing the window keeps Yapfast running in the system tray, with any call. Quit from the tray icon's menu.")
            : @tr("No system tray is running, so closing the window quits Yapfast.");
        checked <=> root.close-to-tray;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Allow multiple windows");
        description: @tr("Starting Yapfast while it runs opens another Yapfast, with its own window and tray icon. Off, it brings the open window forward.");
        checked <=> root.multiple-windows;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Render with the GPU");
        description: @tr("Hardware acceleration. Off, Yapfast draws on the processor, which uses about half the memory.");
        checked <=> root.gpu-rendering;
        toggled => { root.preferences-changed(); }
    }
    if root.gpu-rendering != root.gpu-running: HorizontalLayout {
        spacing: 12px;
        Label {
            text: root.gpu-rendering ? @tr("Yapfast switches to the GPU when it restarts. Restarting leaves any call.") : @tr("Yapfast switches to the processor when it restarts. Restarting leaves any call.");
            vertical-alignment: center; horizontal-stretch: 1;
        }
        ActionButton {
            text: @tr("Restart Yapfast"); icon: @image-url("icons/refresh-cw.svg");
            clicked => { root.restart(); }
        }
    }
    SettingsSwitch {
        text: @tr("Encode streams with the GPU");
        description: @tr("Screen sharing uses the graphics card's video encoder, which takes almost no processor time and looks better at low bitrates. Off, or without one, Yapfast encodes on the processor.");
        checked <=> root.gpu-encoding;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: @tr("Developer Mode");
        description: @tr("Menus offer Copy ID for servers, channels and people, which helps when you write apps that use the Discord API.");
        checked <=> root.developer-mode;
        toggled => { root.preferences-changed(); }
    }
    Label {
        text: @tr("Icons from Solar by 480 Design (CC BY 4.0), many of them adapted, and from Lucide (ISC).");
        font-size: 12px; color: Theme.faint;
    }
}

// Settings: which build this is, and whether a newer release is out. The check
// is a switch, off until it's turned on; a release installs only when Update
// and restart is pressed.
export component AboutSettings inherits VerticalLayout {
    callback copy-text(string);
    property <bool> copied;
    property <string> status-text:
        Updates.status == UpdateStatus.checking ? @tr("Checking for updates…")
        : Updates.status == UpdateStatus.current ? @tr("You're up to date.")
        : Updates.status == UpdateStatus.available ? @tr("Yapfast {} is available.", Updates.latest)
        : Updates.status == UpdateStatus.skipped ? @tr("You skipped {}. We'll tell you about the next one.", Updates.latest)
        : Updates.status == UpdateStatus.failed ? @tr("Couldn't check for updates: {}", Updates.error)
        : Updates.status == UpdateStatus.source ? @tr("You're running a build from source, so there's nothing to update.")
        : Updates.check ? "" : @tr("Update checks are turned off.");
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("About"); }
    Rectangle {
        background: Theme.sidebar; border-radius: 8px;
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            Middle {
                Rectangle {
                    width: 56px; height: 56px; border-radius: 14px; clip: true;
                    Image { source: @image-url("../packaging/icon.png"); width: 56px; height: 56px; }
                }
            }
            VerticalLayout {
                alignment: center; spacing: 4px; horizontal-stretch: 1;
                Text { text: BuildInfo.headline; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                HorizontalLayout {
                    alignment: start;
                    Text {
                        text: BuildInfo.channel; font-size: 13px; font-weight: 700;
                        color: BuildInfo.tone == 0 ? Theme.live : BuildInfo.tone == 1 ? Theme.accent : Theme.danger-text;
                    }
                    if BuildInfo.details != "": Text { text: " · " + BuildInfo.details; color: Theme.muted; font-size: 13px; overflow: elide; }
                }
            }
            Middle {
                ActionButton {
                    text: root.copied ? @tr("Copied") : @tr("Copy version");
                    clicked => { root.copy-text(BuildInfo.summary); root.copied = true; }
                }
            }
        }
    }
    Timer { interval: 2s; running: root.copied; triggered => { root.copied = false; } }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("UPDATES"); }
        if !Updates.releases: Label {
            text: @tr("This is {0}, a fork of {1}. The fork has no releases: it's updated by building it again from its source code, so {0} doesn't look for updates and downloads nothing.", BuildInfo.product, "Yapfast");
        }
        if Updates.releases && Updates.manager != "": Label {
            text: @tr("You installed Yapfast with {}, so update it there.", Updates.manager);
        }
        if Updates.releases && root.status-text != "": Label {
            text: root.status-text;
            color: Updates.status == UpdateStatus.available ? Theme.accent : Updates.status == UpdateStatus.failed ? Theme.danger-text : Theme.muted;
        }
        if Updates.installing: VerticalLayout {
            spacing: 8px;
            Label { text: Updates.install-text; color: Theme.text; }
            Rectangle {
                height: 6px; border-radius: 3px; background: Theme.sidebar;
                Rectangle {
                    x: 0px; width: parent.width * max(Updates.install-progress, 0); height: parent.height; border-radius: 3px; background: Theme.accent;
                    animate width { duration: Theme.still ? 0ms : 200ms; easing: linear; }
                }
            }
            HorizontalLayout {
                alignment: start;
                if Updates.can-cancel: ActionButton { text: @tr("Cancel"); clicked => { Updates.cancel-install(); } }
            }
        }
        if !Updates.installing && Updates.install-error != "": Label {
            text: @tr("Couldn't update: {}", Updates.install-error); color: Theme.danger-text;
        }
        if !Updates.installing && Updates.status == UpdateStatus.available && Updates.install-note != "": Label {
            text: Updates.install-note;
        }
        // A narrow window takes them onto a second line.
        if Updates.releases && !Updates.installing: FlexboxLayout {
            spacing: 8px; alignment: start;
            if Updates.status == UpdateStatus.available && Updates.can-install: ActionButton {
                text: @tr("Update and restart"); icon: @image-url("icons/download.svg"); primary: true;
                clicked => { Updates.install(); }
            }
            if Updates.status == UpdateStatus.available || Updates.status == UpdateStatus.skipped: ActionButton {
                text: @tr("View release"); icon: @image-url("icons/external-link.svg"); primary: Updates.status == UpdateStatus.available && !Updates.can-install;
                clicked => { Updates.view(); }
            }
            if Updates.status == UpdateStatus.available: ActionButton {
                text: @tr("Skip this version");
                clicked => { Updates.skip(); }
            }
            ActionButton {
                text: @tr("Check now"); icon: @image-url("icons/refresh-cw.svg"); enabled: Updates.status != UpdateStatus.checking;
                clicked => { Updates.check-now(); }
            }
        }
    }
    if Updates.notes != "" && (Updates.status == UpdateStatus.available || Updates.status == UpdateStatus.skipped): VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("WHAT'S NEW IN {}", Updates.latest.to-uppercase()); }
        Rectangle {
            background: Theme.sidebar; border-radius: 8px; height: min(notes-text.preferred-height + 24px, 220px);
            ScrollView {
                content-height: notes-text.preferred-height + 24px;
                notes-text := Text {
                    x: 12px; y: 12px; width: parent.width - 24px;
                    text: Updates.notes; color: Theme.secondary; font-size: 13px; wrap: word-wrap;
                }
            }
        }
    }
    if Updates.releases: SettingsSwitch {
        text: @tr("Check for updates");
        description: @tr("Checks for new versions every 6 hours.");
        new-key: "check-updates";
        checked <=> Updates.check;
        toggled => { Updates.preferences-changed(); }
    }
    if Updates.releases: SettingsSwitch {
        text: @tr("Include nightly builds");
        description: @tr("Get the newest features before release. Expect some bugs.");
        new-key: "update-nightlies";
        checked <=> Updates.nightlies;
        enabled: Updates.check;
        toggled => { Updates.preferences-changed(); }
    }
    // Not available: the project decides whether Yapfast may update without
    // being asked, and until it does, nothing turns this on.
    if Updates.releases: SettingsSwitch {
        text: @tr("Install updates automatically");
        description: @tr("Not available yet.");
        checked: false;
        enabled: false;
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("LINKS"); }
        FlexboxLayout {
            spacing: 8px; alignment: start;
            ActionButton { text: "GitHub"; icon: @image-url("icons/github.svg"); clicked => { Updates.open-github(); } }
            ActionButton { text: @tr("Original: {}", "Yapfast"); icon: @image-url("icons/external-link.svg"); clicked => { Updates.open-website(); } }
        }
    }
}

// Settings: linking a Discord account.
export component DiscordLinkSettings inherits VerticalLayout {
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    callback link-discord-token(string);
    callback open-discord-captcha;
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: "Discord"; }
    Label { text: @tr("Link your Discord account to see its servers and DMs in Yapfast, and join its calls. The login stays on this computer, in the system's credential store."); }
    DiscordLinkPanel {
        phase: root.link-phase; code: root.link-code; name: root.link-name; note: root.link-note;
        begin => { root.link-discord(); }
        reopen => { root.open-discord-captcha(); }
        link-token(token) => { root.link-discord-token(token); }
    }
}

// A detected game's local name and executable.
export struct GameExecutable { executable: string, text: string }

// Settings: detected games and Rich Presence.
export component GameActivitySettings inherits VerticalLayout {
    /// The Discord account shares the game it plays, as its settings say.
    in property <bool> shown;
    in property <bool> linked;
    in property <[GameExecutable]> executables;
    callback toggled(bool);
    callback save(int, string, string) -> bool;
    callback remove(int);
    private property <string> executable-draft;
    private property <string> text-draft;
    private property <bool> invalid-game;
    private property <int> editing-game: -1;
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: @tr("Game activity"); }
    SettingsSwitch {
        text: @tr("Share the game you play");
        description: @tr("Yapfast looks for games among the programs running, and on Linux takes the Rich Presence games send. Your Discord account keeps this setting, so it's the same in Discord's apps.");
        checked: root.shown;
        controlled: true;
        enabled: root.linked;
        locked-tip: @tr("Link a Discord account first.");
        toggled(shown) => { root.toggled(shown); }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("CUSTOM GAMES"); }
        Label { text: @tr("Name a game by its executable, a file name or a full path, and what to show after Playing. These come before the games Yapfast knows, but a game's Rich Presence comes first."); }
        for game[index] in root.executables: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: game.text; color: Theme.text; font-size: 15px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                ActionButton { text: @tr("Edit"); small: true; clicked => { root.editing-game = index; root.executable-draft = game.executable; root.text-draft = game.text; root.invalid-game = false; } }
                ActionButton { text: @tr("Remove"); small: true; clicked => { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; root.remove(index); } }
            }
            Text { text: game.executable; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
    }
    VerticalLayout {
        spacing: 8px;
        TextField { text <=> root.executable-draft; label: @tr("Game executable"); placeholder: @tr("Executable name or full path"); }
        TextField { text <=> root.text-draft; label: @tr("Game activity text"); placeholder: @tr("Text after Playing (up to 128 characters)"); }
        if root.invalid-game: Label { text: @tr("Enter an executable and a name of up to 128 characters, without line breaks."); }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            ActionButton {
                text: root.editing-game < 0 ? @tr("Add game") : @tr("Save game"); enabled: root.executable-draft != "" && root.text-draft != "";
                clicked => {
                    root.invalid-game = !root.save(root.editing-game, root.executable-draft, root.text-draft);
                    if !root.invalid-game { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; }
                }
            }
            if root.editing-game >= 0: ActionButton { text: @tr("Cancel"); ghost: true; clicked => { root.editing-game = -1; root.executable-draft = ""; root.text-draft = ""; root.invalid-game = false; } }
        }
    }
}

/// Someone the Discord account blocked, in Settings.
export struct BlockedRow { id: string, name: string, username: string, avatar-url: string, initial: string }

// Settings: Discord account and channel behavior.
export component DiscordSettings inherits VerticalLayout {
    in property <bool> matrix-build;
    in property <bool> show-hidden-channels;
    in property <bool> sync-discord-reads;
    in property <bool> show-idle;
    in property <bool> hide-blocked;
    /// Those the account blocked, by name.
    in property <[BlockedRow]> blocked;
    callback unlink-discord;
    /// Unblock someone, by user id.
    callback unblock(string);
    /// How many of them show; Discord's list shows five more at a time.
    private property <int> blocked-shown: 5;
    callback hide-blocked-toggled(bool);
    callback show-hidden-channels-toggled(bool);
    callback sync-discord-reads-toggled(bool);
    callback show-idle-toggled(bool);
    spacing: 16px;
    if !ClientStyle.enabled: SettingsTitle { text: "Discord"; }
    if root.matrix-build: HorizontalLayout {
        spacing: 12px;
        Label { text: @tr("Unlinking signs Yapfast out of Discord on this computer."); vertical-alignment: center; horizontal-stretch: 1; }
        ActionButton {
            text: @tr("Unlink Discord"); icon: @image-url("icons/log-out.svg"); danger: true;
            clicked => { root.unlink-discord(); }
        }
    }
    SettingsSwitch {
        text: @tr("Show channels you can't access");
        description: @tr("They appear locked. Server admins hid them on purpose.");
        checked: root.show-hidden-channels;
        toggled(shown) => { root.show-hidden-channels-toggled(shown); }
    }
    SettingsSwitch {
        text: @tr("Mark messages read on Discord");
        description: @tr("Channels you read in Yapfast show as read in the Discord apps too.");
        checked: root.sync-discord-reads;
        toggled(sync) => { root.sync-discord-reads-toggled(sync); }
    }
    SettingsSwitch {
        text: @tr("Show me as idle when I'm away");
        description: @tr("After 10 minutes without using Yapfast, as in Discord. Either way, your phone gets notifications while you're away.");
        checked: root.show-idle;
        toggled(shown) => { root.show-idle-toggled(shown); }
    }
    SettingsSwitch {
        text: @tr("Hide messages from people you blocked");
        description: @tr("Leaves them out entirely, rather than showing a line you can open.");
        checked: root.hide-blocked;
        toggled(hide) => { root.hide-blocked-toggled(hide); }
    }
    // As Discord's Ignore & Block lists them, only while there are any.
    if root.blocked.length > 0: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px; padding-top: 8px;
            Middle {
                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px; background: Theme.raised;
                    Image { source: @image-url("icons/ban.svg"); width: 20px; height: 20px; colorize: Theme.secondary; }
                }
            }
            VerticalLayout {
                alignment: center; spacing: 2px;
                Text { text: @tr("Blocked accounts"); color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { text: @tr("{n} account" | "{n} accounts" % root.blocked.length); color: Theme.secondary; font-size: 14px; }
            }
        }
        VerticalLayout {
            for person[index] in root.blocked: VerticalLayout {
                if index < root.blocked-shown: HorizontalLayout {
                    padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                    Middle { Avatar { size: 40px; initial: person.initial; picture-url: person.avatar-url; } }
                    Middle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                            if person.username != "": Text { text: person.username; color: Theme.secondary; font-size: 14px; overflow: elide; }
                        }
                    }
                    Middle {
                        ActionButton {
                            text: @tr("Unblock"); small: true; label: @tr("Unblock {}", person.name);
                            clicked => { root.unblock(person.id); }
                        }
                    }
                }
            }
        }
        if root.blocked.length > root.blocked-shown: HorizontalLayout {
            alignment: start;
            LinkButton {
                text: @tr("See {} more", root.blocked.length - root.blocked-shown); small: true;
                clicked => { root.blocked-shown += 5; }
            }
        }
    }
}
