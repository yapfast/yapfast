import { Theme } from "theme.slint";
import { ActionButton, Avatar, TextField } from "controls.slint";
import { SettingsHeading } from "settings.slint";

/// Delete Server's or Transfer Ownership's dialog, while open.
export struct OwnershipPrompt {
    /// 0 none, 1 Delete Server, 2 Transfer Ownership.
    kind: int,
    title: string,
    /// Discord's words, with the server's and the new owner's names bold.
    text: styled-text,
    /// Delete Server asks for the server's name, without two-factor
    /// authentication, and says when it's wrong.
    by-name: bool,
    wrong: bool,
    /// Transfer Ownership: both owners' avatars, the acknowledgement, and
    /// whether the server is Verified or Partnered, which blocks it.
    owner-avatar: string,
    owner-initial: string,
    new-avatar: string,
    new-initial: string,
    acknowledge: styled-text,
    agreed: bool,
    verified: bool,
    /// The emailed code's step: another code on its way, or come.
    code: bool,
    resending: bool,
    resent: bool,
    sending: bool,
    may-confirm: bool,
    error: string,
}

// A dialog's frame over the screen, closed by Escape or a click beside it
// unless Discord is answering.
component OwnershipFrame inherits Rectangle {
    in property <OwnershipPrompt> page;
    callback cancel;
    background: #000000aa;
    TouchArea { clicked => { if !root.page.sending { root.cancel(); } } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        Rectangle {
            width: 440px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            accessible-role: groupbox; accessible-label: root.page.title;
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 14px;
                Text { text: root.page.title; color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                @children
            }
        }
    }
}

// Delete Server, as Discord's asks: a confirmation with two-factor
// authentication, the server's name typed without it.
export component DeleteServerDialog inherits Rectangle {
    in property <OwnershipPrompt> page;
    /// 0 the name typed, 1 delete, 2 cancel.
    callback act(int, string);
    OwnershipFrame {
        page: root.page;
        cancel => { root.act(2, ""); }
        StyledText { text: root.page.text; default-color: Theme.secondary; default-font-size: 15px; }
        if root.page.by-name: VerticalLayout {
            spacing: 6px;
            SettingsHeading { text: @tr("ENTER SERVER NAME"); }
            TextField {
                label: @tr("Enter server name"); enabled: !root.page.sending;
                init => { self.focus-input(); }
                edited(text) => { root.act(0, text); }
                accepted => { root.act(1, ""); }
            }
            if root.page.wrong: Text { text: @tr("You didn't enter the server name correctly"); color: Theme.danger; font-size: 12px; }
        }
        if root.page.error != "": Text { text: root.page.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            ActionButton { text: @tr("Cancel"); ghost: true; enabled: !root.page.sending; clicked => { root.act(2, ""); } }
            ActionButton {
                text: root.page.sending ? @tr("Deleting...") : @tr("Delete Server"); danger: true;
                enabled: !root.page.sending;
                clicked => { root.act(1, ""); }
            }
        }
    }
}

// Transfer Ownership, as Discord's asks: who gets the server, an
// acknowledgement, then the code Discord emailed when two-factor
// authentication doesn't confirm it.
export component TransferOwnershipDialog inherits Rectangle {
    in property <OwnershipPrompt> page;
    /// 0 the code typed, 1 transfer, 2 cancel, 3 the acknowledgement,
    /// 4 resend the code.
    callback act(int, string);
    OwnershipFrame {
        page: root.page;
        cancel => { root.act(2, ""); }
        if !root.page.code: StyledText { text: root.page.text; default-color: Theme.secondary; default-font-size: 15px; }
        if !root.page.code: HorizontalLayout {
            alignment: center; spacing: 24px;
            Avatar { size: 80px; initial: root.page.owner-initial; picture-url: root.page.owner-avatar; }
            VerticalLayout {
                alignment: center;
                Image { source: @image-url("icons/chevron-right.svg"); width: 24px; height: 24px; colorize: Theme.muted; }
            }
            Avatar { size: 80px; initial: root.page.new-initial; picture-url: root.page.new-avatar; }
        }
        if !root.page.code && root.page.verified: Rectangle {
            border-radius: 6px; background: Theme.danger.with-alpha(0.12);
            height: warning.preferred-height + 20px;
            warning := Text {
                x: 10px; width: parent.width - 20px;
                text: @tr("Partnered or Verified servers must reach out to the Community team for ownership transfer requests. However, our Partner and Verified Server Programs are currently paused and not able to handle any requests.");
                color: Theme.text; font-size: 13px; wrap: word-wrap;
            }
        }
        if !root.page.code: Rectangle {
            height: acknowledgement.preferred-height;
            opacity: root.page.verified ? 0.5 : 1;
            accessible-role: checkbox; accessible-checked: root.page.agreed;
            accessible-label: @tr("Acknowledge the transfer");
            accessible-action-default => { root.act(3, ""); }
            acknowledgement := HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: start; padding-top: 2px;
                    Rectangle {
                        width: 18px; height: 18px; border-radius: 4px;
                        background: root.page.agreed ? Theme.accent : transparent;
                        border-width: root.page.agreed ? 0px : 1.5px; border-color: Theme.muted;
                        if root.page.agreed: Image { width: 12px; height: 12px; image-fit: contain; source: @image-url("icons/check.svg"); colorize: Theme.on-accent; }
                    }
                }
                StyledText { horizontal-stretch: 1; text: root.page.acknowledge; default-color: Theme.secondary; default-font-size: 14px; }
            }
            TouchArea {
                enabled: !root.page.verified && !root.page.sending;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.act(3, ""); }
            }
        }
        if root.page.code: Text {
            text: @tr("Check your email: we sent you a verification code. Enter it here to verify you’re really you.");
            color: Theme.secondary; font-size: 15px; wrap: word-wrap;
        }
        if root.page.code: VerticalLayout {
            spacing: 6px;
            SettingsHeading { text: @tr("VERIFICATION CODE"); }
            TextField {
                label: @tr("Verification Code"); enabled: !root.page.sending;
                init => { self.focus-input(); }
                edited(text) => { root.act(0, text); }
                accepted => { root.act(1, ""); }
            }
            if root.page.error != "": Text { text: root.page.error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: resend.preferred-width; height: resend.preferred-height;
                    accessible-role: button; accessible-label: resend.text;
                    accessible-action-default => { root.act(4, ""); }
                    resend := Text {
                        text: root.page.resent ? @tr("Verification code sent.") : @tr("Didn’t receive a code or it expired? Resend it.");
                        color: root.page.resent ? Theme.live : resend-area.has-hover ? Theme.accent-hover : Theme.link;
                        font-size: 13px;
                    }
                    resend-area := TouchArea {
                        enabled: !root.page.sending && !root.page.resending;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.act(4, ""); }
                    }
                }
            }
        }
        if !root.page.code && root.page.error != "": Text { text: root.page.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            ActionButton { text: @tr("Cancel"); ghost: true; enabled: !root.page.sending; clicked => { root.act(2, ""); } }
            ActionButton {
                text: root.page.sending ? @tr("Transferring...") : @tr("Transfer Ownership"); danger: true;
                enabled: root.page.may-confirm;
                clicked => { root.act(1, ""); }
            }
        }
    }
}
