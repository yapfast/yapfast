// Dialogs a Discord server's, category's or channel's menu opens.
import { StatusDot } from "rail.slint";
import { ScrollView } from "scrollview.slint";
import { Theme, Label, Middle, Popup } from "theme.slint";
import { ActionButton, Avatar, IconButton, MenuItem, TextField, Motion, StatusText, ServerTagChip, PictureStore, StyledName, NameStyleRow } from "controls.slint";
import { Choices, Picker, UnsavedBar } from "settings.slint";
import { NameStyles } from "controls.slint";
import { ProfileData, ProfileHeading, ProfileTitle, ActivityCard, ProfileBadge, ProfileBadgeRow, BoardCard, WishlistCard, ProfileTheme } from "people.slint";

// What an invite dialog shows: whom it invites where, and the link once
// Discord made it.
export struct InvitePrompt {
    title: string,
    /// Where the link lands those who follow it, such as "#general".
    detail: string,
    /// The link; empty while Discord makes it.
    link: string,
    /// How long the link lasts and how often it works, as said under it.
    note: string,
    making: bool,
    error: string,
}

// An invite link to a server or a channel, with a button to copy it, and how
// long a new one lasts and how many may use it, as Discord's invite dialog
// offers them.
export component InviteDialog inherits Rectangle {
    in property <InvitePrompt> prompt;
    /// The choices for the next link: an index into each list of options.
    in-out property <int> age;
    in-out property <int> uses;
    callback copy(string);
    callback remake(int, int);
    callback close;
    // The link last copied; a new one shows Copy again.
    property <string> copied-link;
    property <bool> copied: root.prompt.link != "" && root.copied-link == root.prompt.link;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(460px, root.width - 48px); height: invite-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            invite-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.detail != "": Label { text: root.prompt.detail; }
                Text { text: @tr("INVITE LINK"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                Rectangle {
                    height: 44px; border-radius: 8px; background: Theme.sunken;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 4px; spacing: 8px;
                        Text {
                            text: root.prompt.making ? @tr("Making a link...") : root.prompt.link;
                            color: root.prompt.making ? Theme.muted : Theme.text; font-size: 15px;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            ActionButton {
                                text: root.copied ? @tr("Copied") : @tr("Copy"); primary: !root.copied;
                                enabled: root.prompt.link != "";
                                clicked => { root.copy(root.prompt.link); root.copied-link = root.prompt.link; }
                            }
                        }
                    }
                }
                if root.prompt.note != "": Label { text: root.prompt.note; }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                Text { text: @tr("EXPIRE AFTER"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                Choices {
                    label: @tr("Expire after"); options: [@tr("30 min"), @tr("1 hr"), @tr("6 hr"), @tr("12 hr"), @tr("1 day"), @tr("7 days"), @tr("Never")];
                    current <=> root.age;
                }
                Text { text: @tr("MAX NUMBER OF USES"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                Choices {
                    label: @tr("Max number of uses"); options: [@tr("No limit"), "1", "5", "10", "25", "50", "100"];
                    current <=> root.uses;
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton { text: @tr("Done"); ghost: true; clicked => { root.close(); } }
                    ActionButton {
                        text: @tr("Generate a new link"); enabled: !root.prompt.making;
                        clicked => { root.remake(root.age, root.uses); }
                    }
                }
            }
        }
    }
}

// What Join a Server shows: the field for an invite, the server it's to once
// Discord found it, and how joining goes.
export struct JoinPrompt {
    title: string,
    /// Whether it has a field for the invite; a clicked link's has none.
    field: bool,
    /// The server, once found: its name, picture or initial, and its
    /// members, or the channel joining lands in.
    found: bool,
    name: string,
    picture-url: string,
    initial: string,
    detail: string,
    /// What the main button does, such as "Join Server"; empty for none.
    confirm: string,
    busy: bool,
    /// How it's going, such as "Joining...".
    status: string,
    /// Discord asked for a captcha, which opens again from a button.
    captcha: bool,
    /// The server asks for a form, which its button opens in the browser.
    form: bool,
    error: string,
}

// Joins a Discord server by an invite, as Discord's Join a Server and invite
// dialogs do: the server shows before anyone joins.
export component JoinDialog inherits Rectangle {
    in property <JoinPrompt> prompt;
    in-out property <string> link;
    callback find(string);
    callback join;
    callback open-captcha;
    callback open-form;
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: join-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { if !root.prompt.field { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            join-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.field: Label { text: @tr("Paste an invite link or code to join a server you were invited to."); }
                if root.prompt.field: Text { text: @tr("INVITE LINK"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                if root.prompt.field: TextField {
                    init => { self.focus-input(); }
                    min-height: 36px; text-size: 15px; pad: 10px;
                    placeholder: "https://discord.gg/yapfast"; label: @tr("Invite link");
                    text <=> root.link;
                    accepted => { if !root.prompt.busy { root.find(root.link); } }
                }
                if root.prompt.found: Rectangle {
                    border-radius: 8px; background: Theme.sunken;
                    height: found-row.preferred-height;
                    found-row := HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Avatar { size: 48px; picture-url: root.prompt.picture-url; initial: root.prompt.initial; }
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: root.prompt.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                            if root.prompt.detail != "": Label { text: root.prompt.detail; }
                        }
                    }
                }
                if root.prompt.status != "": Label { text: root.prompt.status; }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton { text: root.prompt.form || root.prompt.confirm == "" ? @tr("Close") : @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                    if root.prompt.captcha: ActionButton { text: @tr("Open the captcha again"); clicked => { root.open-captcha(); } }
                    if root.prompt.confirm != "": ActionButton {
                        text: root.prompt.confirm; primary: true; enabled: !root.prompt.busy;
                        clicked => {
                            if root.prompt.form { root.open-form(); }
                            else if root.prompt.found { root.join(); }
                            else { root.find(root.link); }
                        }
                    }
                }
            }
        }
    }
}

// What a scheduled event shows: when and where it is, what it says, and
// how changing interest in it goes.
export struct EventPrompt {
    title: string,
    /// The event, once found: its name, when it is, and where.
    found: bool,
    name: string,
    when: string,
    detail: string,
    /// What the event says about itself.
    description: string,
    /// What the main button does, such as "Interested"; empty for none.
    confirm: string,
    busy: bool,
    /// How it's going, such as "This event is going on now.".
    status: string,
    error: string,
}

// A Discord server's scheduled event that a clicked event link opened,
// as Discord's event dialog shows it, with its Interested button.
export component EventDialog inherits Rectangle {
    in property <EventPrompt> prompt;
    callback toggle-interest;
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: event-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            event-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.found: Rectangle {
                    border-radius: 8px; background: Theme.sunken;
                    height: found-row.preferred-height;
                    found-row := VerticalLayout {
                        padding: 12px; spacing: 2px;
                        Text { text: root.prompt.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                        if root.prompt.when != "": Label { text: root.prompt.when; }
                        if root.prompt.detail != "": Label { text: root.prompt.detail; }
                    }
                }
                if root.prompt.description != "": Text { text: root.prompt.description; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                if root.prompt.status != "": Label { text: root.prompt.status; }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton { text: root.prompt.confirm == "" ? @tr("Close") : @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                    if root.prompt.confirm != "": ActionButton {
                        text: root.prompt.confirm; primary: true; enabled: !root.prompt.busy;
                        clicked => { root.toggle-interest(); }
                    }
                }
            }
        }
    }
}

// What a gift shows: what it grants, who sent it, and how redeeming goes.
export struct GiftPrompt {
    title: string,
    /// The gift, once found: what it grants, and its plan or its giver.
    found: bool,
    name: string,
    detail: string,
    /// What the main button does, such as "Redeem Gift"; empty for none.
    confirm: string,
    /// The main button opens the gift in the browser, for a gift only
    /// Discord can redeem.
    browser: bool,
    busy: bool,
    /// How it's going, such as "Redeeming...".
    status: string,
    error: string,
}

// A Discord gift, such as Nitro, that a clicked gift link opened: what it
// grants shows before anyone redeems it, as Discord's gift dialog does.
export component GiftDialog inherits Rectangle {
    in property <GiftPrompt> prompt;
    callback redeem;
    callback open-in-browser;
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: gift-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            gift-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.found: Rectangle {
                    border-radius: 8px; background: Theme.sunken;
                    height: found-row.preferred-height;
                    found-row := VerticalLayout {
                        padding: 12px; spacing: 2px;
                        Text { text: root.prompt.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                        if root.prompt.detail != "": Label { text: root.prompt.detail; }
                    }
                }
                if root.prompt.status != "": Label { text: root.prompt.status; }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton { text: root.prompt.confirm == "" ? @tr("Close") : @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                    if root.prompt.confirm != "": ActionButton {
                        text: root.prompt.confirm; primary: true; enabled: !root.prompt.busy;
                        clicked => { if root.prompt.browser { root.open-in-browser(); } else { root.redeem(); } }
                    }
                }
            }
        }
    }
}

// What authorizing an application shows: what it asks for, in words, the
// server picker for a server install, and how authorizing goes.
export struct OAuthPrompt {
    title: string,
    /// The application, once found: its name, picture or initial, and
    /// what it says about itself or the bot it adds.
    found: bool,
    name: string,
    picture-url: string,
    initial: string,
    detail: string,
    /// What it asks for, a line each, and what of that can take over the
    /// account or a server, such as Administrator, in red above it.
    wants: string,
    warning: string,
    /// Whether it offers the servers it could be added to, or else the
    /// one server a link names, which can't be changed.
    guild-picker: bool,
    guild-name: string,
    /// Where Discord sends the person next when Yapfast won't open it,
    /// such as an app's own address, to copy.
    address: string,
    /// What the main button does, such as "Authorize"; empty for none.
    confirm: string,
    busy: bool,
    status: string,
    error: string,
}

// Authorizes a Discord application from its link, as Discord's
// authorization page does: what it asks for shows before anyone agrees.
export component OAuthDialog inherits Rectangle {
    in property <OAuthPrompt> prompt;
    in property <[string]> guilds;
    in property <int> guild-chosen;
    callback choose-guild(int);
    callback authorize;
    callback copy(string);
    callback close;
    // The address last copied.
    property <string> copied-address;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: oauth-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            oauth-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.found: Rectangle {
                    border-radius: 8px; background: Theme.sunken;
                    height: found-row.preferred-height;
                    found-row := HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Avatar { size: 48px; picture-url: root.prompt.picture-url; initial: root.prompt.initial; }
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: root.prompt.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                            if root.prompt.detail != "": Label { text: root.prompt.detail; }
                        }
                    }
                }
                if root.prompt.warning != "": Text { text: root.prompt.warning; color: Theme.danger; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                if root.prompt.wants != "": Text { text: root.prompt.wants; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                if root.prompt.guild-picker || root.prompt.guild-name != "": Text { text: @tr("ADD TO SERVER"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                if root.prompt.guild-picker: Picker {
                    model: root.guilds; chosen: root.guild-chosen; enabled: !root.prompt.busy;
                    accessible-label: @tr("Add to server");
                    selected => { root.choose-guild(self.current-index); }
                }
                if !root.prompt.guild-picker && root.prompt.guild-name != "": Rectangle {
                    height: 44px; border-radius: 8px; background: Theme.sunken;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text { text: root.prompt.guild-name; color: Theme.text; font-size: 15px; vertical-alignment: center; overflow: elide; }
                    }
                }
                if root.prompt.status != "": Label { text: root.prompt.status; }
                if root.prompt.address != "": Rectangle {
                    height: 44px; border-radius: 8px; background: Theme.sunken;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 4px; spacing: 8px;
                        Text { text: root.prompt.address; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout {
                            alignment: center;
                            ActionButton {
                                text: root.copied-address == root.prompt.address ? @tr("Copied") : @tr("Copy");
                                primary: root.copied-address != root.prompt.address;
                                clicked => { root.copy(root.prompt.address); root.copied-address = root.prompt.address; }
                            }
                        }
                    }
                }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton { text: root.prompt.confirm == "" ? @tr("Close") : @tr("Cancel"); ghost: true; clicked => { root.close(); } }
                    if root.prompt.confirm != "": ActionButton {
                        text: root.prompt.confirm; primary: true; enabled: !root.prompt.busy;
                        clicked => { root.authorize(); }
                    }
                }
            }
        }
    }
}

// What a channel dialog asks: to make, copy or delete a channel or category,
// and which of its fields it shows.
export struct ChannelPrompt {
    title: string,
    /// Where it goes, or what deleting it does.
    detail: string,
    /// The button that carries it out, such as "Create channel".
    confirm: string,
    /// A button in place of Cancel that carries it out another way, such
    /// as "Keep Current Permissions"; empty for Cancel.
    alternative: string,
    danger: bool,
    /// Whether it offers text or voice, for a channel it makes.
    kinds: bool,
    /// Whether it asks for a name; the name's heading, and what it shows
    /// without one.
    named: bool,
    field: string,
    placeholder: string,
    /// A box to tick below the detail, such as leaving a group DM without
    /// telling its other members; empty for none. Ticking it calls tick.
    option: string,
    ticked: bool,
    saving: bool,
    error: string,
}

// Makes, copies or deletes a Discord channel or category, as Discord's
// create channel dialog does; asks before leaving a server or group DM.
export component ChannelDialog inherits Rectangle {
    in property <ChannelPrompt> prompt;
    in-out property <string> name;
    /// 0 for text, 1 for voice.
    in-out property <int> kind;
    callback save;
    callback alternative;
    callback tick;
    callback close;
    property <bool> ready: !root.prompt.saving;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(460px, root.width - 48px); height: channel-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        FocusScope {
            init => { if !root.prompt.named { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                if event.text == "\n" && root.ready { root.save(); return accept; }
                return reject;
            }
            channel-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.detail != "": Label { text: root.prompt.detail; }
                if root.prompt.kinds: Text { text: @tr("CHANNEL TYPE"); color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                if root.prompt.kinds: Choices {
                    label: @tr("Channel type"); options: [@tr("Text"), @tr("Voice")];
                    current <=> root.kind;
                }
                if root.prompt.named: Text { text: root.prompt.field; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                if root.prompt.named: TextField {
                    init => { self.focus-input(); }
                    min-height: 36px; text-size: 15px; pad: 10px;
                    placeholder: root.prompt.placeholder; label: root.prompt.field;
                    text <=> root.name;
                    accepted => { if root.ready { root.save(); } }
                }
                if root.prompt.option != "": Rectangle {
                    height: option-row.preferred-height;
                    accessible-role: checkbox; accessible-checked: root.prompt.ticked;
                    accessible-label: root.prompt.option;
                    accessible-action-default => { if root.ready { root.tick(); } }
                    option-row := HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: start; padding-top: 1px;
                            Rectangle {
                                width: 18px; height: 18px; border-radius: 4px;
                                background: root.prompt.ticked ? Theme.accent : transparent;
                                border-width: root.prompt.ticked ? 0px : 1.5px; border-color: Theme.muted;
                                if root.prompt.ticked: Image { width: 12px; height: 12px; image-fit: contain; source: @image-url("icons/check.svg"); colorize: Theme.on-accent; }
                            }
                        }
                        Text { text: root.prompt.option; color: Theme.secondary; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                    TouchArea {
                        enabled: root.ready;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.tick(); }
                    }
                }
                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 4px;
                    ActionButton {
                        text: root.prompt.alternative != "" ? root.prompt.alternative : @tr("Cancel"); ghost: true;
                        clicked => { if root.prompt.alternative != "" { root.alternative(); } else { root.close(); } }
                    }
                    ActionButton {
                        text: root.prompt.confirm; primary: !root.prompt.danger; danger: root.prompt.danger;
                        enabled: root.ready;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
}

// What the profile editor shows besides what's written in it, for the main
// profile or one server's.
/// A server whose tag can be worn.
export struct ServerTagRow { id: string, name: string, icon: string, tag: string, badge: string }

export struct ProfileEditorPrompt {
    /// The servers whose tags can be worn, the one chosen, and the tag it would show.
    server-tags: [ServerTagRow],
    tag-chosen-id: string,
    tag-text: string,
    tag-icon: string,
    /// "Edit profile" or "Edit server profile", and which profile it is,
    /// as the corner of the banner says.
    title: string,
    detail: string,
    /// It edits the main profile, not a server's.
    main: bool,
    /// The username, and the pronouns that show while none are written:
    /// the main profile's in a server.
    handle: string,
    pronouns-fallback: string,
    name-placeholder: string,
    bio-placeholder: string,
    /// Discord sends the profile; Discord takes the change.
    loading: bool,
    saving: bool,
    error: string,
    /// Which fields this account may change: the nickname needs permission
    /// in a server; the rest Nitro, as Discord has them.
    name-enabled: bool,
    avatar-enabled: bool,
    banner-enabled: bool,
    bio-enabled: bool,
    /// Discord's Nitro offer over a server's fields, and whether it asks a
    /// lesser Nitro to upgrade.
    offer: bool,
    upgrade: bool,
    /// The banner shows with the Nitro it takes, and the banner colour of
    /// the main profile without.
    banner-shown: bool,
    colour-shown: bool,
    /// The banner colour as written, and whether it isn't one.
    colour: color,
    has-colour: bool,
    colour-wrong: bool,
    /// Whether there's an avatar or banner to reset, and the word for it:
    /// "Reset" in a server, "Remove" in the main profile.
    avatar-reset: bool,
    banner-reset: bool,
    reset-word: string,
    /// A chosen picture is being read: "avatar", "banner" or "".
    reading: string,
    /// How many characters the bio has left; below 0, too many.
    bio-left: int,
    /// The name or pronouns are longer than Discord takes.
    too-long: string,
    /// Saving would change something.
    changed: bool,
    /// The profile card as it would show.
    preview: ProfileData,
    /// Nitro lets the main profile choose its theme and name style: as written,
    /// and the name's font, 0 for the usual one.
    look-enabled: bool,
    /// What the account wears that only Discord's shop sets, which the
    /// profile switches may keep from showing.
    decoration-set: bool,
    effect-set: bool,
    frame-set: bool,
    name-font-id: int,
    name-effect-id: int,
    name-colours-key: string,
    theme-top-text: string,
    theme-bottom-text: string,
}

// A pencil, or a lock where Nitro is wanted, on a round dark badge: what
// the profile editor shows over a picture that can be changed.
component EditBadge inherits Rectangle {
    in property <bool> locked;
    width: 32px; height: 32px; border-radius: 16px;
    background: #000000b3;
    Image {
        width: 16px; height: 16px; colorize: #ffffff;
        source: root.locked ? @image-url("icons/lock.svg") : @image-url("icons/pencil.svg");
    }
}

// A small pencil button beside a text of the profile editor's.
// What says a text can be changed: an outline around it while pointed at, and on
// the name a pencil at its end, as Discord's editor has it.
component HoverEdit inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> pencil;
    in property <string> label;
    in property <MouseCursor> cursor: MouseCursor.pointer;
    callback clicked;
    // As measured from Discord's: a 1px line of 17% white, 7px round, in 100ms.
    border-radius: 7px; border-width: 1px;
    border-color: touch.has-hover && root.enabled ? #ffffff2c : #ffffff00;
    animate border-color { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    if root.pencil && touch.has-hover && root.enabled: Image {
        x: parent.width - self.width - 12px;
        source: @image-url("icons/pen.svg"); width: 15px; height: 15px; image-fit: contain; colorize: #acadb3;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? root.cursor : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// This account's Discord profile as its large card shows it, each part of
// it editable in place, as Discord's editors allow: the main profile's
// display name, pronouns, avatar, bio and banner colour, or banner with
// Nitro; or a server's nickname and pronouns, and its avatar, banner and
// bio with Nitro, locked under its offer without. A text turns into a field
// when it or its pencil is clicked; a picture offers Change and Remove, or
// Reset, when clicked. Once something changed, Discord's bar asks to save
// it.
// A heading and what it's about, in the column beside the profile.
component CustomizeGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; }
    @children
}

component CustomizeCell inherits Rectangle {
    in property <bool> enabled;
    callback clicked;
    height: 100px; border-radius: 12px; clip: true;
    // Tiles side by side share their row evenly, whatever they hold.
    horizontal-stretch: 1; min-width: 0px; preferred-width: 100px;
    background: touch.has-hover && root.enabled ? Theme.hover : Theme.raised;
    animate background { duration: 120ms; }
    transform-scale: touch.has-hover && root.enabled ? 1.03 : 1;
    animate transform-scale { duration: 120ms; easing: ease-out; }
    @children
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// A round plus, on a slot that has nothing in it yet.
component SlotPlus inherits Image {
    source: @image-url("icons/circle-plus.svg"); width: 26px; height: 26px; image-fit: contain; colorize: #ffffff;
}

// A theme colour's handle, on its tile.
component ThemeHandle inherits Rectangle {
    in property <color> fill;
    in property <bool> open;
    callback clicked;
    width: 24px; height: 24px; border-radius: 7px; background: root.fill;
    border-width: root.open ? 3px : 2px; border-color: #ffffff;
    accessible-role: button;
    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// What a profile wears, beside the editor, in the order Discord's has it.
component ProfileCustomize inherits Rectangle {
    in property <ProfileData> data;
    in property <bool> avatar-enabled;
    in property <bool> banner-enabled;
    in property <bool> look-enabled;
    in property <bool> decoration-set;
    in property <bool> effect-set;
    in property <bool> frame-set;
    in property <int> open-handle;
    callback pick(int);
    callback open-style;
    callback open-handle-at(int);
    callback open-link(string);
    callback collapse;
    width: 241px;
    background: Theme.panel;
    VerticalLayout {
        Rectangle {
            height: 50px;
            Text { x: 16px; text: @tr("Main Profile"); color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; height: 100%; }
            IconButton {
                x: parent.width - self.width - 8px; y: (parent.height - self.height) / 2; height: self.width;
                icon: @image-url("icons/chevrons-right.svg"); label: @tr("Hide Styles"); size: 30px; glyph: 16px;
                clicked => { root.collapse(); }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        ScrollView {
            vertical-stretch: 1;
            content-height: column.preferred-height;
            column := VerticalLayout {
                padding: 16px; spacing: 16px; alignment: start;
                CustomizeGroup {
                    title: @tr("Nameplate");
                    CustomizeCell {
                        height: 42px; enabled: true;
                        clicked => { root.open-link("https://discord.com/shop"); }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Middle { Avatar { size: 26px; initial: root.data.initial; tint: root.data.tint; picture: root.data.picture; } }
                            Middle { Rectangle { height: 12px; border-radius: 6px; background: Theme.hover; horizontal-stretch: 1; } }
                            Middle { SlotPlus { width: 22px; height: 22px; } }
                        }
                    }
                }
                CustomizeGroup {
                    title: @tr("Avatar & Decoration");
                    HorizontalLayout {
                        spacing: 8px;
                        CustomizeCell {
                            enabled: root.avatar-enabled;
                            clicked => { root.pick(0); }
                            Avatar { size: 72px; initial: root.data.initial; tint: root.data.tint; picture: root.data.picture; }
                        }
                        CustomizeCell {
                            enabled: true;
                            clicked => { root.open-link("https://discord.com/shop"); }
                            if root.data.decoration-url != "": Avatar { width: 64px; height: 64px; size: 64px; initial: root.data.initial; tint: root.data.tint; picture: root.data.picture; decoration-url: root.data.decoration-url; }
                            if root.data.decoration-url == "" && root.decoration-set: Text { text: @tr("Decoration on"); color: Theme.text; font-size: 13px; }
                            if !root.decoration-set: SlotPlus { }
                        }
                    }
                }
                CustomizeGroup {
                    title: @tr("Display Name Style");
                    CustomizeCell {
                        height: 42px; enabled: root.look-enabled;
                        clicked => { root.open-style(); }
                        StyledName {
                            x: max(0px, (parent.width - self.width) / 2); y: (parent.height - self.height) / 2;
                            text: root.data.name; font-size: 18px; font-weight: 600; styles: root.data.name-style; ink: Theme.text;
                        }
                    }
                }
                CustomizeGroup {
                    title: @tr("Theme & Banner");
                    HorizontalLayout {
                        spacing: 8px;
                        // The card's two colours, top and bottom, each on its handle.
                        CustomizeCell {
                            background: root.data.has-theme ? @linear-gradient(180deg, root.data.theme-primary, root.data.theme-secondary) : Theme.raised;
                            if root.look-enabled: ThemeHandle {
                                y: 4px; fill: root.data.theme-primary; open: root.open-handle == 1;
                                accessible-label: @tr("Theme's top colour");
                                clicked => { root.open-handle-at(1); }
                            }
                            if root.look-enabled: ThemeHandle {
                                y: parent.height - self.height - 4px; fill: root.data.theme-secondary; open: root.open-handle == 2;
                                accessible-label: @tr("Theme's bottom colour");
                                clicked => { root.open-handle-at(2); }
                            }
                        }
                        CustomizeCell {
                            enabled: root.banner-enabled;
                            clicked => { root.pick(1); }
                            background: root.data.has-accent ? root.data.accent : Theme.raised;
                            if root.data.banner.width > 0: Image { width: parent.width; height: parent.height; source: root.data.banner; image-fit: cover; }
                            if root.data.banner.width == 0 && !root.data.has-accent: Text { text: @tr("No banner"); color: Theme.muted; font-size: 13px; }
                        }
                    }
                }
                CustomizeGroup {
                    title: @tr("Profile Effect & Frame");
                    HorizontalLayout {
                        spacing: 8px;
                        CustomizeCell {
                            enabled: true;
                            clicked => { root.open-link("https://discord.com/shop"); }
                            if root.effect-set: Text { text: @tr("Effect on"); color: Theme.text; font-size: 13px; }
                            if !root.effect-set: SlotPlus { }
                        }
                        CustomizeCell {
                            enabled: true;
                            clicked => { root.open-link("https://discord.com/shop"); }
                            if root.frame-set: Text { text: @tr("Frame on"); color: Theme.text; font-size: 13px; }
                            if !root.frame-set: SlotPlus { }
                        }
                    }
                }
            }
        }
    }
}

// Saturation, brightness and hue for a colour, with its code, as Discord's has.
component ColourPopover inherits Rectangle {
    in property <string> start;
    callback chosen(string);
    pure callback parse-hex(string) -> color;
    pure callback format-hex(color) -> string;
    property <float> hue;
    property <float> sat;
    property <float> val;
    function load(colour: color) {
        let hsv = colour.to-hsv();
        root.hue = hsv.hue; root.sat = hsv.saturation; root.val = hsv.value;
    }
    function use() {
        let hex = root.format-hex(Colors.hsv(root.hue, root.sat, root.val));
        // Set last: Slint's generated code moves the text into the field.
        root.chosen("#" + hex);
        field.text = hex;
    }
    init => { root.load(root.parse-hex(root.start)); field.text = root.start; }
    width: 240px; height: 250px; border-radius: 12px; background: Theme.raised;
    border-color: Theme.edge; border-width: 1px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 6px;
    TouchArea { }
    Rectangle {
        x: 10px; y: 10px; width: parent.width - 20px; height: 150px; border-radius: 8px; clip: true;
        background: @linear-gradient(90deg, #ffffff 0%, Colors.hsv(root.hue, 1, 1) 100%);
        Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
        Rectangle {
            x: root.sat * parent.width - self.width / 2; y: (1 - root.val) * parent.height - self.height / 2;
            width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: #ffffff;
        }
        TouchArea {
            function place() {
                root.sat = clamp(self.mouse-x / parent.width, 0, 1);
                root.val = 1 - clamp(self.mouse-y / parent.height, 0, 1);
                root.use();
            }
            pointer-event(event) => { if event.kind == PointerEventKind.down { self.place(); } }
            moved => { if self.pressed { self.place(); } }
        }
    }
    Rectangle {
        x: 10px; y: 170px; width: parent.width - 20px; height: 10px; border-radius: 5px;
        background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
        Rectangle {
            x: root.hue / 360 * parent.width - self.width / 2; y: -3px;
            width: 8px; height: 16px; border-radius: 4px; background: #ffffff;
        }
        TouchArea {
            function place() {
                root.hue = clamp(self.mouse-x / parent.width, 0, 1) * 360;
                root.use();
            }
            pointer-event(event) => { if event.kind == PointerEventKind.down { self.place(); } }
            moved => { if self.pressed { self.place(); } }
        }
    }
    field := TextField {
        x: 10px; y: 194px; width: parent.width - 20px; height: 42px;
        placeholder: "#rrggbb"; label: @tr("Colour code"); text-size: 14px; border-radius: 10px;
        edited(text) => { root.load(root.parse-hex(text)); root.chosen(text); }
    }
}

// What a profile shows beside it. Discord's Board and Wishlist can't be set up
// in Yapfast yet, and say so rather than offer buttons that do nothing.
component ProfileTabs inherits Rectangle {
    in property <ProfileData> data;
    /// Its text and tiles, which the profile's theme sets.
    in property <color> ink: Theme.text;
    in property <color> ink2: Theme.secondary;
    in property <color> ink3: Theme.muted;
    in property <color> tile: Theme.raised;
    in property <color> line: Theme.line;
    callback open-link(string);
    callback open-wishlist;
    property <int> page: 0;
    // Long tabs scroll in what's under the headings, so they don't change the
    // card's size. They sit over the column rather than in it, to that end.
    property <length> list-y: headings.y + headings.height + 16px;
    property <length> list-width: self.width - 18px;
    property <length> list-height: self.height - self.list-y - 8px;
    property <string> coming-soon: @tr("Adding more from Yapfast is coming soon.");
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 280px;
    VerticalLayout {
        padding: 22px; padding-left: 0px; padding-top: 58px; padding-right: 32px; spacing: 16px; alignment: start;
        headings := VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                spacing: 24px; alignment: start;
                for tab[index] in [@tr("Board"), @tr("Activity"), @tr("Wishlist")]: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: tab; font-size: 14px; font-weight: 600; color: root.page == index ? root.ink : root.ink2;
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.page = index;
                                if index == 2 { root.open-wishlist(); }
                            }
                        }
                    }
                    Rectangle { height: 2px; background: root.page == index ? root.ink : transparent; animate background { duration: Theme.quick; } }
                }
            }
            Rectangle { height: 1px; background: root.line; }
        }
        if root.page == 1: VerticalLayout {
            spacing: 10px;
            Text { text: @tr("Current activity"); color: root.ink2; font-size: 13px; font-weight: 600; }
            if root.data.activities.length == 0: Text { text: @tr("Nothing going on right now."); color: root.ink3; font-size: 13px; }
            for activity in root.data.activities: ActivityCard {
                activity: activity; ink: root.ink; ink2: root.ink2; ink3: root.ink3;
                open-link(url) => { root.open-link(url); }
            }
        }
    }
    if root.page == 0: board-scroll := ScrollView {
        x: 0px; y: root.list-y; width: root.list-width; height: root.list-height;
        content-width: self.visible-width;
        content-height: board.preferred-height;
        board := VerticalLayout {
            width: board-scroll.visible-width; padding-right: 14px; padding-bottom: 14px; spacing: 12px; alignment: start;
            if root.data.board-note != "": Text { text: root.data.board-note; color: root.ink2; font-size: 13px; wrap: word-wrap; }
            if root.data.board-note == "" && root.data.widgets.length == 0: Text { text: @tr("Nothing on your board yet."); color: root.ink2; font-size: 13px; wrap: word-wrap; }
            if root.data.widgets.length > 0: Text { text: @tr("Your Widgets"); color: root.ink2; font-size: 13px; font-weight: 600; }
            if root.data.board-note == "": Text { text: root.coming-soon; color: root.ink3; font-size: 12px; wrap: word-wrap; }
            for widget in root.data.widgets: BoardCard { widget: widget; tile: root.tile; ink: root.ink; ink2: root.ink2; ink3: root.ink3; }
        }
    }
    if root.page == 2: wishlist-scroll := ScrollView {
        property <length> gap: 12px;
        property <length> room: self.visible-width - 14px;
        property <length> card-width: min((self.room - self.gap) / 2, 168px);
        property <length> card-height: self.card-width + 26px;
        property <int> count: root.data.wishlist.length;
        x: 0px; y: root.list-y; width: root.list-width; height: root.list-height;
        content-width: self.visible-width;
        content-height: wishlist.preferred-height;
        wishlist := VerticalLayout {
            width: wishlist-scroll.visible-width; padding-right: 14px; padding-bottom: 14px; spacing: 12px; alignment: start;
            if wishlist-scroll.count > 0: Text { text: wishlist-scroll.count + (wishlist-scroll.count == 1 ? @tr(" Item") : @tr(" Items")); color: root.ink2; font-size: 13px; font-weight: 600; }
            if root.data.wishlist-note != "": Text { text: root.data.wishlist-note; color: root.ink2; font-size: 13px; wrap: word-wrap; }
            if root.data.wishlist-note == "" && wishlist-scroll.count == 0: Text { text: @tr("Nothing on your wishlist yet."); color: root.ink2; font-size: 13px; wrap: word-wrap; }
            if root.data.wishlist-note == "" || wishlist-scroll.count > 0: Text { text: root.coming-soon; color: root.ink3; font-size: 12px; wrap: word-wrap; }
            if wishlist-scroll.count > 0: Rectangle {
                height: ceil(wishlist-scroll.count / 2) * (wishlist-scroll.card-height + wishlist-scroll.gap) - wishlist-scroll.gap;
                for item[index] in root.data.wishlist: WishlistCard {
                    x: mod(index, 2) * (wishlist-scroll.card-width + wishlist-scroll.gap);
                    y: floor(index / 2) * (wishlist-scroll.card-height + wishlist-scroll.gap);
                    width: wishlist-scroll.card-width;
                    height: wishlist-scroll.card-height;
                    item: item; tile: root.tile; ink: root.ink; ink3: root.ink3;
                }
            }
        }
    }
}

// A name style's colours: Discord's preset or one's own, written as hex
// joined by commas, and spread over five stops for a swatch.
struct NamePreset { key: string, c1: color, c2: color, c3: color, c4: color, c5: color }

// Discord's window for a name's style: its font, effect and colour, with how
// it looks on a profile, a message and a member row.
component NameStyleWindow inherits Rectangle {
    in property <int> start-font;
    in property <int> start-effect;
    in property <string> start-key;
    in property <string> name;
    in property <string> handle;
    in property <image> picture;
    in property <string> initial;
    in property <color> tint;
    in property <string> presence;
    in property <[ProfileBadgeRow]> badges;
    in property <bool> has-theme;
    in property <color> theme-top;
    in property <color> theme-bottom;
    callback close;
    callback apply(int, int, string);
    pure callback parse-hex(string) -> color;
    property <[{ id: int, family: string, weight: int, label: string }]> faces: [
        { id: 11, family: "", weight: 500, label: @tr("Default") }, { id: 12, family: "Tempo", weight: 600, label: @tr("Tempo") }, { id: 3, family: "Sakura", weight: 400, label: @tr("Sakura") }, { id: 4, family: "Jellybean", weight: 400, label: @tr("Jellybean") },
        { id: 6, family: "Modern", weight: 500, label: @tr("Modern") }, { id: 7, family: "Néo-castel", weight: 400, label: @tr("Medieval") }, { id: 8, family: "8Bit", weight: 500, label: @tr("8Bit") }, { id: 10, family: "Sinistre", weight: 548, label: @tr("Vampyre") },
        { id: 13, family: "Monkey Bars", weight: 700, label: @tr("Monkey Bars") }, { id: 14, family: "Mainframe", weight: 700, label: @tr("Mainframe") }, { id: 15, family: "Headbang", weight: 400, label: @tr("Headbang") }, { id: 16, family: "Journal", weight: 700, label: @tr("Journal") },
    ];
    property <[{ id: int, label: string }]> effects: [
        { id: 1, label: @tr("Solid") }, { id: 2, label: @tr("Gradient") }, { id: 3, label: @tr("Neon") }, { id: 4, label: @tr("Toon") },
        { id: 5, label: @tr("Pop") }, { id: 8, label: @tr("Gummy") }, { id: 7, label: @tr("Prism") },
    ];
    property <[NamePreset]> solid: [{ key: "f0f0f2", c1: #f0f0f2, c2: #f0f0f2, c3: #f0f0f2, c4: #f0f0f2, c5: #f0f0f2 }, { key: "26e36e", c1: #26e36e, c2: #26e36e, c3: #26e36e, c4: #26e36e, c5: #26e36e }, { key: "1f99ec", c1: #1f99ec, c2: #1f99ec, c3: #1f99ec, c4: #1f99ec, c5: #1f99ec }, { key: "c32cfe", c1: #c32cfe, c2: #c32cfe, c3: #c32cfe, c4: #c32cfe, c5: #c32cfe }, { key: "da034a", c1: #da034a, c2: #da034a, c3: #da034a, c4: #da034a, c5: #da034a }, { key: "f93824", c1: #f93824, c2: #f93824, c3: #f93824, c4: #f93824, c5: #f93824 }, { key: "c6a617", c1: #c6a617, c2: #c6a617, c3: #c6a617, c4: #c6a617, c5: #c6a617 }];
    property <[NamePreset]> neon: [{ key: "6b20ee", c1: #6b20ee, c2: #6b20ee, c3: #6b20ee, c4: #6b20ee, c5: #6b20ee }, { key: "26e36e", c1: #26e36e, c2: #26e36e, c3: #26e36e, c4: #26e36e, c5: #26e36e }, { key: "1f99ec", c1: #1f99ec, c2: #1f99ec, c3: #1f99ec, c4: #1f99ec, c5: #1f99ec }, { key: "c32cfe", c1: #c32cfe, c2: #c32cfe, c3: #c32cfe, c4: #c32cfe, c5: #c32cfe }, { key: "da034a", c1: #da034a, c2: #da034a, c3: #da034a, c4: #da034a, c5: #da034a }, { key: "f93824", c1: #f93824, c2: #f93824, c3: #f93824, c4: #f93824, c5: #f93824 }, { key: "c6a617", c1: #c6a617, c2: #c6a617, c3: #c6a617, c4: #c6a617, c5: #c6a617 }];
    property <[NamePreset]> toon: [{ key: "f52399", c1: #f52399, c2: #f52399, c3: #f52399, c4: #f52399, c5: #f52399 }, { key: "26e36e", c1: #26e36e, c2: #26e36e, c3: #26e36e, c4: #26e36e, c5: #26e36e }, { key: "1f99ec", c1: #1f99ec, c2: #1f99ec, c3: #1f99ec, c4: #1f99ec, c5: #1f99ec }, { key: "c32cfe", c1: #c32cfe, c2: #c32cfe, c3: #c32cfe, c4: #c32cfe, c5: #c32cfe }, { key: "da034a", c1: #da034a, c2: #da034a, c3: #da034a, c4: #da034a, c5: #da034a }, { key: "f93824", c1: #f93824, c2: #f93824, c3: #f93824, c4: #f93824, c5: #f93824 }, { key: "c6a617", c1: #c6a617, c2: #c6a617, c3: #c6a617, c4: #c6a617, c5: #c6a617 }];
    property <[NamePreset]> pop: [{ key: "12d088", c1: #12d088, c2: #12d088, c3: #12d088, c4: #12d088, c5: #12d088 }, { key: "26e36e", c1: #26e36e, c2: #26e36e, c3: #26e36e, c4: #26e36e, c5: #26e36e }, { key: "1f99ec", c1: #1f99ec, c2: #1f99ec, c3: #1f99ec, c4: #1f99ec, c5: #1f99ec }, { key: "c32cfe", c1: #c32cfe, c2: #c32cfe, c3: #c32cfe, c4: #c32cfe, c5: #c32cfe }, { key: "da034a", c1: #da034a, c2: #da034a, c3: #da034a, c4: #da034a, c5: #da034a }, { key: "f93824", c1: #f93824, c2: #f93824, c3: #f93824, c4: #f93824, c5: #f93824 }, { key: "c6a617", c1: #c6a617, c2: #c6a617, c3: #c6a617, c4: #c6a617, c5: #c6a617 }];
    property <[NamePreset]> gradient: [{ key: "2dafa7,fec491", c1: #2dafa7, c2: #61b4a2, c3: #96ba9c, c4: #cabf96, c5: #fec491 }, { key: "ca63fa,417ae4", c1: #ca63fa, c2: #a869f4, c3: #866eef, c4: #6374ea, c5: #417ae4 }, { key: "7c61c4,6bba9f", c1: #7c61c4, c2: #7877bb, c3: #748eb2, c4: #6fa4a8, c5: #6bba9f }, { key: "edaab1,e577da", c1: #edaab1, c2: #eb9dbb, c3: #e990c6, c4: #e784d0, c5: #e577da }, { key: "f39054,e764cf", c1: #f39054, c2: #f08573, c3: #ed7a92, c4: #ea6fb0, c5: #e764cf }];
    property <[NamePreset]> gummy: [{ key: "eaaad6,aadef1,baa8ef,baebcc", c1: #eaaad6, c2: #bad1ea, c3: #b2c3f0, c4: #bab9e6, c5: #baebcc }, { key: "fe70c2,f550a8,fe9bd6,da6cb8", c1: #fe70c2, c2: #f758ae, c3: #fa76bf, c4: #f58fce, c5: #da6cb8 }, { key: "ffb67c,ff9571,ff7e7a,f06c8b", c1: #ffb67c, c2: #ff9d74, c3: #ff8a76, c4: #fb7a7e, c5: #f06c8b }, { key: "c4ed66,98de61,6dcd64,46bc67", c1: #c4ed66, c2: #a3e262, c3: #82d662, c4: #63c965, c5: #46bc67 }, { key: "7db8fe,8fe0d0,9d95f5,67cff0", c1: #7db8fe, c2: #8ad6dc, c3: #96bae2, c4: #90a4f4, c5: #67cff0 }, { key: "d77cfe,b56cfe,e45de5,8c6dfe", c1: #d77cfe, c2: #be70fe, c3: #cc64f2, c4: #ce61eb, c5: #8c6dfe }, { key: "d83b60,c94ccb,8c5dfe,b06dfe", c1: #d83b60, c2: #cd48b0, c3: #aa54e4, c4: #9561fe, c5: #b06dfe }];
    property <[NamePreset]> prism: [{ key: "fe9444,37ee80,fee048,ff4ed3,5966f2", c1: #fe9444, c2: #37ee80, c3: #fee048, c4: #ff4ed3, c5: #5966f2 }, { key: "90c464,68e971,fed84f,fe63bd,b458e0", c1: #90c464, c2: #68e971, c3: #fed84f, c4: #fe63bd, c5: #b458e0 }, { key: "7ed8ed,7dbbfe,828bfe,ad72fe,d17bed", c1: #7ed8ed, c2: #7dbbfe, c3: #828bfe, c4: #ad72fe, c5: #d17bed }, { key: "a5160f,d32f15,f45e18,fc8d05,feb122", c1: #a5160f, c2: #d32f15, c3: #f45e18, c4: #fc8d05, c5: #feb122 }];
    function presets-of(effect: int) -> [NamePreset] {
        if effect == 2 { return root.gradient; }
        if effect == 3 { return root.neon; }
        if effect == 4 { return root.toon; }
        if effect == 5 { return root.pop; }
        if effect == 7 { return root.prism; }
        if effect == 8 { return root.gummy; }
        return root.solid;
    }
    property <int> font: root.start-font;
    property <int> effect: root.start-effect < 1 ? 1 : root.start-effect;
    property <NamePreset> paint: root.presets-of(root.effect)[0];
    property <[NamePreset]> presets: root.presets-of(root.effect);
    property <bool> hex-open;
    /// The preview's message and member row show as in Discord's light mode.
    property <bool> light-preview;
    property <color> sample-fill: root.light-preview ? #ffffff : Theme.raised;
    property <color> sample-ink: root.light-preview ? #313338 : Theme.text;
    property <color> sample-edge: root.light-preview ? transparent : Theme.edge;
    // Your own colours: the bar's two ends, or a prism's five, and which is open.
    property <string> hex1: "2dafa7";
    property <string> hex2: "fec491";
    property <string> prism1: "fe9444";
    property <string> prism2: "37ee80";
    property <string> prism3: "fee048";
    property <string> prism4: "ff4ed3";
    property <string> prism5: "5966f2";
    property <int> open-handle: 0;
    property <bool> bar-shown: root.effect == 2 || root.effect == 7;
    property <bool> theme-light: root.has-theme && ProfileTheme.light(root.theme-top);
    property <color> card-top: !root.has-theme ? Theme.raised : ProfileTheme.wash(root.theme-top, root.theme-light);
    property <color> card-bottom: !root.has-theme ? Theme.raised : ProfileTheme.wash(root.theme-bottom, root.theme-light);
    property <bool> changed-any: root.font != root.start-font || root.effect != max(1, root.start-effect) || root.paint.key != root.start-key;
    // The colour picker's place, as hue, saturation and value.
    property <float> pick-hue;
    property <float> pick-sat;
    property <float> pick-val: 1;
    property <color> pick-colour: Colors.hsv(root.pick-hue, root.pick-sat, root.pick-val);
    property <bool> picker-open: root.hex-open || root.open-handle > 0;
    property <string> pick-text;
    changed pick-text => { pick-field.text = root.pick-text; }
    pure callback format-hex(color) -> string;
    /// A style's colours, written as hex joined by commas: one, as it's
    /// written, or spread evenly over five stops.
    pure callback key-part(string, int) -> string;
    pure callback key-colour(string, int) -> color;
    function slot-hex(number: int) -> string {
        if root.effect == 2 { return number == 1 ? root.hex1 : root.hex2; }
        return number == 1 ? root.prism1 : number == 2 ? root.prism2 : number == 3 ? root.prism3 : number == 4 ? root.prism4 : root.prism5;
    }
    function load-pick(colour: color) {
        let hsv = colour.to-hsv();
        root.pick-hue = hsv.hue;
        root.pick-sat = hsv.saturation;
        root.pick-val = hsv.value;
        root.pick-text = root.format-hex(colour);
    }
    function use-pick() {
        let hex = root.format-hex(Colors.hsv(root.pick-hue, root.pick-sat, root.pick-val));
        // Set last: Slint's generated code moves the text into the property.
        root.use-hex(hex);
        root.pick-text = hex;
    }
    function use-hex(hex: string) {
        if root.open-handle > 0 {
            root.set-handle(hex);
        } else {
            let c = root.parse-hex(hex);
            root.paint = { key: hex, c1: c, c2: c, c3: c, c4: c, c5: c };
        }
    }
    function custom-paint() {
        if root.effect == 2 {
            let a = root.parse-hex(root.hex1);
            let b = root.parse-hex(root.hex2);
            root.paint = { key: root.hex1 + "," + root.hex2, c1: a, c2: a.mix(b, 0.75), c3: a.mix(b, 0.5), c4: a.mix(b, 0.25), c5: b };
        } else {
            root.paint = { key: root.prism1 + "," + root.prism2 + "," + root.prism3 + "," + root.prism4 + "," + root.prism5, c1: root.parse-hex(root.prism1), c2: root.parse-hex(root.prism2), c3: root.parse-hex(root.prism3), c4: root.parse-hex(root.prism4), c5: root.parse-hex(root.prism5) };
        }
    }
    function handle-text() -> string {
        if root.effect == 2 { return root.open-handle == 1 ? root.hex1 : root.hex2; }
        return root.open-handle == 1 ? root.prism1 : root.open-handle == 2 ? root.prism2 : root.open-handle == 3 ? root.prism3 : root.open-handle == 4 ? root.prism4 : root.prism5;
    }
    function set-handle(text: string) {
        let hex = text;
        if root.effect == 2 {
            if root.open-handle == 1 { root.hex1 = hex; } else { root.hex2 = hex; }
        } else {
            if root.open-handle == 1 { root.prism1 = hex; } else if root.open-handle == 2 { root.prism2 = hex; } else if root.open-handle == 3 { root.prism3 = hex; } else if root.open-handle == 4 { root.prism4 = hex; } else { root.prism5 = hex; }
        }
        root.custom-paint();
    }
    /// The style as chosen, drawn as names are everywhere else.
    property <[NameStyleRow]> style: NameStyles.row(root.font, root.effect, root.paint.key, root.name);
    function pick-effect(id: int) {
        root.effect = id;
        root.paint = root.presets-of(id)[0];
        root.hex-open = false;
        root.open-handle = 0;
    }
    // Opens on the style as it stands; a saved bar's colours fill its handles.
    init => {
        if root.start-key != "" {
            root.paint = {
                key: root.start-key,
                c1: root.key-colour(root.start-key, 0), c2: root.key-colour(root.start-key, 1), c3: root.key-colour(root.start-key, 2),
                c4: root.key-colour(root.start-key, 3), c5: root.key-colour(root.start-key, 4),
            };
            if root.effect == 2 {
                root.hex1 = root.key-part(root.start-key, 0);
                root.hex2 = root.key-part(root.start-key, 1);
            }
            if root.effect == 7 {
                root.prism1 = root.key-part(root.start-key, 0);
                root.prism2 = root.key-part(root.start-key, 1);
                root.prism3 = root.key-part(root.start-key, 2);
                root.prism4 = root.key-part(root.start-key, 3);
                root.prism5 = root.key-part(root.start-key, 4);
            }
        }
    }
    background: Theme.sidebar; border-radius: 16px;
    drop-shadow-blur: 48px; drop-shadow-color: #000000b3; drop-shadow-offset-y: 16px;
    accessible-role: groupbox;
    accessible-label: @tr("Change Display Name Style");
    TouchArea { }
    Rectangle { border-radius: 16px; clip: true;
    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 424px;
                VerticalLayout {
                    padding: 24px; spacing: 12px; alignment: start;
                    Text { text: @tr("Change Display Name Style"); color: Theme.text; font-size: 22px; font-weight: 700; }
                    Text { text: @tr("Font"); color: Theme.secondary; font-size: 13px; font-weight: 600; }
                    Rectangle {
                        height: 3 * 68px + 2 * 8px;
                        for face[index] in root.faces: Rectangle {
                            x: mod(index, 4) * (parent.width + 8px) / 4; y: floor(index / 4) * 76px;
                            width: (parent.width - 24px) / 4; height: 68px; border-radius: 12px;
                            background: root.font == face.id ? Theme.accent.with-alpha(0.16) : face-touch.has-hover ? Theme.hover : Theme.raised;
                            animate background { duration: 120ms; }
                            border-width: root.font == face.id ? 2px : 0px; border-color: Theme.accent;
                            transform-scale: face-touch.has-hover ? 1.04 : 1;
                            animate transform-scale { duration: 120ms; easing: ease-out; }
                            accessible-role: button; accessible-label: face.family == "" ? @tr("Usual font") : face.family;
                            Text { text: @tr("Gg"); font-family: face.family; font-weight: face.weight; font-size: 22px; color: Theme.text; }
                            face-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.font = face.id; } }
                            // Its name, over it while pointed at.
                            z: face-touch.has-hover ? 10 : 0;
                            if face-touch.has-hover: Rectangle {
                                y: -30px; width: face-tip.preferred-width + 16px; height: 24px; border-radius: 8px;
                                background: #000000e6;
                                face-tip := Text { text: face.label; color: #ffffff; font-size: 12px; font-weight: 600; }
                            }
                        }
                    }
                    Text { text: @tr("Effect"); color: Theme.secondary; font-size: 13px; font-weight: 600; }
                    Rectangle {
                        height: 2 * 68px + 8px;
                        for item[index] in root.effects: Rectangle {
                            x: mod(index, 4) * (parent.width + 8px) / 4; y: floor(index / 4) * 76px;
                            width: (parent.width - 24px) / 4; height: 68px; border-radius: 12px;
                            background: root.effect == item.id ? Theme.accent.with-alpha(0.16) : effect-touch.has-hover ? Theme.hover : Theme.raised;
                            animate background { duration: 120ms; }
                            border-width: root.effect == item.id ? 2px : 0px; border-color: Theme.accent;
                            transform-scale: effect-touch.has-hover ? 1.04 : 1;
                            animate transform-scale { duration: 120ms; easing: ease-out; }
                            accessible-role: button; accessible-label: item.label;
                            StyledName { x: (parent.width - self.preferred-width) / 2; text: item.label; font-size: 15px; font-weight: 500; styles: NameStyles.row(11, item.id, root.presets-of(item.id)[0].key, item.label); }
                            effect-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.pick-effect(item.id); } }
                        }
                    }
                    Text { text: @tr("Colour"); color: Theme.secondary; font-size: 13px; font-weight: 600; }
                    colour-row := HorizontalLayout {
                        spacing: 8px; alignment: start; height: 40px;
                        if !root.bar-shown: Rectangle {
                            width: 40px; border-radius: 12px;
                            background: hex-touch.has-hover || root.hex-open ? Theme.hover : Theme.raised;
                            animate background { duration: 120ms; }
                            accessible-role: button; accessible-label: @tr("Your own colour");
                            Image { source: @image-url("icons/eyedropper.svg"); width: 16px; colorize: Theme.text; }
                            hex-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open-handle = 0; root.hex-open = !root.hex-open; root.load-pick(root.paint.c1); } }
                        }
                        // Your own gradient or prism: a bar with a handle for each colour.
                        if root.bar-shown: Rectangle {
                            width: 136px; border-radius: 12px;
                            background: root.effect == 2
                                ? @linear-gradient(90deg, root.parse-hex(root.hex1) 0%, root.parse-hex(root.hex2) 100%)
                                : @linear-gradient(90deg, root.parse-hex(root.prism1) 0%, root.parse-hex(root.prism2) 25%, root.parse-hex(root.prism3) 50%, root.parse-hex(root.prism4) 75%, root.parse-hex(root.prism5) 100%);
                            for spot[index] in (root.effect == 2 ? 2 : 5): Rectangle {
                                property <int> number: index + 1;
                                property <int> count: root.effect == 2 ? 2 : 5;
                                x: 5px + index * (parent.width - 10px - self.width) / (self.count - 1);
                                y: (parent.height - self.height) / 2;
                                width: root.effect == 2 ? 24px : 20px; height: 24px; border-radius: 7px;
                                background: root.parse-hex(root.slot-hex(self.number));
                                border-width: root.open-handle == self.number ? 3px : 2px; border-color: #ffffff;
                                drop-shadow-blur: 4px; drop-shadow-color: #00000080;
                                accessible-role: button; accessible-label: @tr("Colour {}", self.number);
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.hex-open = false;
                                        root.open-handle = root.open-handle == parent.number ? 0 : parent.number;
                                        root.custom-paint();
                                        if root.open-handle > 0 { root.load-pick(root.parse-hex(root.handle-text())); }
                                    }
                                }
                            }
                        }
                        for preset in root.presets: Rectangle {
                            width: 40px; border-radius: 12px;
                            // Gummy's colours are stripes, as each letter takes one whole.
                            background: root.effect == 8
                                ? @linear-gradient(90deg, NameStyles.stripe(preset.key, 0) 0%, NameStyles.stripe(preset.key, 0) 25%, NameStyles.stripe(preset.key, 1) 25%, NameStyles.stripe(preset.key, 1) 50%, NameStyles.stripe(preset.key, 2) 50%, NameStyles.stripe(preset.key, 2) 75%, NameStyles.stripe(preset.key, 3) 75%, NameStyles.stripe(preset.key, 3) 100%)
                                : @linear-gradient(90deg, preset.c1 0%, preset.c2 25%, preset.c3 50%, preset.c4 75%, preset.c5 100%);
                            border-width: root.paint.key == preset.key ? 3px : 0px; border-color: Theme.text;
                            transform-scale: swatch-touch.has-hover ? 1.08 : 1;
                            animate transform-scale { duration: 120ms; easing: ease-out; }
                            accessible-role: button; accessible-label: @tr("Colour {}", preset.key);
                            swatch-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.paint = preset; root.hex-open = false; root.open-handle = 0; } }
                        }
                    }
                }
            }
            // How it looks: laid out as Discord's, each overlapping the one before.
            Rectangle {
                background: @linear-gradient(160deg, Theme.sunken 0%, Theme.accent.with-alpha(0.10).mix(Theme.sunken, 0.5) 100%); clip: true;
                Rectangle {
                    x: 40px; y: 132px; width: 305px; height: 216px; border-radius: 14px;
                    background: @linear-gradient(180deg, root.card-top, root.card-bottom);
                    border-color: Theme.edge; border-width: 1px;
                    drop-shadow-blur: 24px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
                    Rectangle {
                        x: 16px; y: 56px; width: 80px; height: 80px;
                        Avatar { size: 80px; initial: root.initial; tint: root.tint; picture: root.picture; }
                        if root.presence != "": StatusDot { x: 56px; y: 56px; width: 26px; height: 26px; presence: root.presence; ring: root.card-top; }
                    }
                    StyledName { x: 18px; y: 145px; height: self.preferred-height; text: root.name; styles: root.style; font-size: 21px; font-weight: 700; ink: root.has-theme ? ProfileTheme.ink(root.theme-light) : Theme.text; }
                    HorizontalLayout {
                        x: 18px; y: 176px; width: parent.width - 36px; height: 26px; spacing: 6px; alignment: start;
                        Text { text: root.handle; color: root.has-theme ? ProfileTheme.ink(root.theme-light) : #ffffff; font-size: 13px; vertical-alignment: center; overflow: elide; }
                        for badge[index] in root.badges: Rectangle {
                            width: index < 3 ? 22px : 0px; visible: index < 3;
                            ProfileBadge { width: 20px; height: 20px; badge: badge; }
                        }
                    }
                }
                Rectangle {
                    x: 65px; y: 338px; width: 320px; height: 85px; border-radius: 12px;
                    background: root.sample-fill; border-color: root.sample-edge; border-width: 1px;
                    animate background { duration: 180ms; }
                    drop-shadow-blur: 18px; drop-shadow-color: #00000055; drop-shadow-offset-y: 6px;
                    Avatar { x: 20px; y: 22px; size: 40px; initial: root.initial; tint: root.tint; picture: root.picture; }
                    // A message's name stays plain here, as Discord's preview has it.
                    Text {
                        x: 72px; y: 20px; text: root.name; color: root.sample-ink; font-size: 17px; font-weight: 600;
                        font-family: root.style[0].family;
                    }
                    Text { x: 72px; y: 46px; text: @tr("does anyone read this?"); color: root.sample-ink; font-size: 15px; }
                }
                Rectangle {
                    x: 40px; y: 418px; width: 282px; height: 50px; border-radius: 10px;
                    background: root.sample-fill; border-color: root.sample-edge; border-width: 1px;
                    animate background { duration: 180ms; }
                    drop-shadow-blur: 14px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
                    Avatar { x: 10px; y: 9px; size: 32px; initial: root.initial; tint: root.tint; picture: root.picture; }
                    StyledName { x: 52px; y: 14px; height: self.preferred-height; text: root.name; styles: root.style; font-size: 17px; font-weight: 600; }
                }
                // Light or dark, for the message and member row.
                Rectangle {
                    x: parent.width - self.width - 24px; y: parent.height - 64px; width: 76px; height: 40px; border-radius: 12px;
                    background: #00000059;
                    for mode[index] in [{ light: false, icon: @image-url("icons/moon.svg"), label: @tr("Dark") }, { light: true, icon: @image-url("icons/sun.svg"), label: @tr("Light") }]: Rectangle {
                        x: 4px + index * 36px; y: 4px; width: 32px; height: 32px; border-radius: 9px;
                        background: root.light-preview == mode.light ? #ffffff26 : mode-touch.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 120ms; }
                        accessible-role: button; accessible-label: @tr("{} preview", mode.label);
                        Image { source: mode.icon; width: 16px; image-fit: contain; colorize: root.light-preview == mode.light ? #ffffff : #ffffffa6; }
                        mode-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.light-preview = mode.light; } }
                    }
                }
                Text {
                    x: 28px; y: parent.height - 72px; width: parent.width - 56px - 92px;
                    text: @tr("Colours and effects don't show in servers, and may look different across Discord."); color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            padding: 16px; spacing: 8px; alignment: end;
            ActionButton {
                text: @tr("Surprise Me");
                clicked => {
                    let tick = floor(animation-tick() / 1ms);
                    root.font = root.faces[mod(tick, root.faces.length)].id;
                    root.effect = root.effects[mod(floor(tick / 7), root.effects.length)].id;
                    let list = root.presets-of(root.effect);
                    root.paint = list[mod(floor(tick / 53), list.length)];
                }
            }
            ActionButton { text: @tr("Apply"); primary: true; enabled: root.changed-any; clicked => { root.apply(root.font, root.effect, root.paint.key); } }
        }
    }
    }
    IconButton {
        x: root.width - self.width - 12px; y: 12px; height: self.width;
        icon: @image-url("icons/x.svg"); label: @tr("Close");
        clicked => { root.close(); }
    }
    // Clicking away closes the colour picker.
    if root.picker-open: TouchArea { clicked => { root.hex-open = false; root.open-handle = 0; } }
    Rectangle {
        visible: root.picker-open;
        x: 24px; y: colour-row.absolute-position.y - root.absolute-position.y - self.height - 8px;
        width: 240px; height: 250px; border-radius: 12px; background: Theme.raised;
        border-color: Theme.edge; border-width: 1px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 6px;
        TouchArea { }
        // Saturation across and brightness down, for the hue below.
        square := Rectangle {
            x: 10px; y: 10px; width: parent.width - 20px; height: 150px; border-radius: 8px; clip: true;
            background: @linear-gradient(90deg, #ffffff 0%, Colors.hsv(root.pick-hue, 1, 1) 100%);
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
            Rectangle {
                x: root.pick-sat * parent.width - self.width / 2; y: (1 - root.pick-val) * parent.height - self.height / 2;
                width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: #ffffff; background: root.pick-colour;
            }
            TouchArea {
                function place() {
                    root.pick-sat = clamp(self.mouse-x / parent.width, 0, 1);
                    root.pick-val = 1 - clamp(self.mouse-y / parent.height, 0, 1);
                    root.use-pick();
                }
                pointer-event(event) => { if event.kind == PointerEventKind.down { self.place(); } }
                moved => { if self.pressed { self.place(); } }
            }
        }
        // The hue.
        Rectangle {
            x: 10px; y: 170px; width: parent.width - 20px; height: 10px; border-radius: 5px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
            Rectangle {
                x: root.pick-hue / 360 * parent.width - self.width / 2; y: -3px;
                width: 8px; height: 16px; border-radius: 4px; background: #ffffff;
                drop-shadow-blur: 3px; drop-shadow-color: #00000080;
            }
            TouchArea {
                function place() {
                    root.pick-hue = clamp(self.mouse-x / parent.width, 0, 1) * 360;
                    root.use-pick();
                }
                pointer-event(event) => { if event.kind == PointerEventKind.down { self.place(); } }
                moved => { if self.pressed { self.place(); } }
            }
        }
        pick-field := TextField {
            x: 10px; y: 194px; width: parent.width - 20px; height: 42px;
            placeholder: "#rrggbb"; label: @tr("Colour code"); text-size: 14px; border-radius: 10px;
            edited(text) => {
                let c = root.parse-hex(text);
                let hsv = c.to-hsv();
                if hsv.alpha > 0 {
                    root.pick-hue = hsv.hue; root.pick-sat = hsv.saturation; root.pick-val = hsv.value;
                    root.use-hex(root.format-hex(c));
                }
            }
        }
    }
}

export component ProfileEditorDialog inherits Rectangle {
    in property <ProfileEditorPrompt> prompt;
    in-out property <string> name;
    in-out property <string> pronouns;
    in-out property <string> bio;
    in-out property <string> colour;
    /// A text changed: 0 the name, 1 the pronouns, 2 the bio, 3 the banner
    /// colour.
    callback write(int, string);
    /// Choose a picture, or go back to the fallback's: 0 the avatar, 1 the
    /// banner.
    callback pick(int);
    callback reset(int);
    callback unlock-nitro;
    /// Undo every change, as the bar's Reset does.
    callback undo;
    callback save;
    callback close;
    property <bool> ready: !root.prompt.loading && !root.prompt.saving;
    /// The text being edited: 0 none, 1 the name, 2 the pronouns, 3 the bio.
    property <int> editing;
    /// The banner colour's field shows under the banner.
    property <bool> colour-open;
    property <bool> banner-editable: root.ready && (root.prompt.banner-enabled || root.prompt.colour-shown) && root.prompt.reading == "";
    property <bool> banner-locked: root.prompt.banner-shown && !root.prompt.banner-enabled;
    property <bool> avatar-editable: root.ready && root.prompt.avatar-enabled && root.prompt.reading == "";
    property <length> banner-height: root.prompt.main ? 193px : 210px;
    property <length> avatar-size: 120px;
    // The main profile's text sits in the middle of its half of the card, as
    // Discord's does, so no gap opens between it and the tabs.
    property <length> pad: root.prompt.main ? clamp((card.width - 241px * root.side-out) / 2 / 2 - 160px, 32px, 80px) : 24px;
    /// Hide Styles and Show Styles: the left panel gives the card its room.
    property <bool> side-open: true;
    /// How far the left panel is out, from 0 to 1, as Discord's slides.
    property <float> side-out: root.side-open ? 1 : 0;
    animate side-out { duration: 280ms; easing: ease-in-out; }
    /// Which theme colour's picker is open: 1 the top, 2 the bottom.
    property <int> theme-handle;
    property <bool> themed: root.prompt.main && root.prompt.preview.has-theme;
    property <bool> theme-light: root.themed && ProfileTheme.light(root.prompt.preview.theme-primary);
    property <color> card-top: ProfileTheme.wash(root.prompt.preview.theme-primary, root.theme-light);
    property <color> card-bottom: ProfileTheme.wash(root.prompt.preview.theme-secondary, root.theme-light);
    /// The text on the card, which a theme sets whatever Yapfast's own theme is.
    property <color> ink: root.themed ? ProfileTheme.ink(root.theme-light) : Theme.text;
    property <color> ink2: root.themed ? ProfileTheme.ink2(root.theme-light) : Theme.secondary;
    property <color> ink3: root.themed ? ProfileTheme.ink3(root.theme-light) : Theme.muted;
    property <color> plate: root.themed ? root.card-top : Theme.sidebar;
    /// The status thought, white on a light theme as on the card.
    property <color> bubble: !root.themed ? Theme.raised : root.theme-light ? #ffffff : #232427;
    property <color> bubble-edge: !root.themed ? Theme.edge : root.theme-light ? #00000026 : #404044;
    callback copy-id;
    callback open-wishlist;
    callback choose-tag(string);
    callback edit-note;
    callback edit-status;
    in property <bool> has-status;
    in property <string> status-text;
    in property <string> status-emoji;
    /// The tabs show where there's room for them beside the profile.
    property <bool> tabs-shown: root.prompt.main && root.width >= 880px;
    callback open-link(string);
    callback choose-name-style(int, int, string);
    pure callback parse-hex(string) -> color;
    pure callback format-hex(color) -> string;
    pure callback key-part(string, int) -> string;
    pure callback key-colour(string, int) -> color;
    /// The account's status, on the name style window's preview.
    in property <string> presence;
    property <bool> style-open;
    function stop-editing() {
        root.editing = 0;
        scope.focus();
    }
    function edit(field: int) {
        root.editing = field;
        root.colour-open = false;
    }
    function banner-clicked() {
        if root.prompt.colour-shown {
            root.colour-open = !root.colour-open;
            root.editing = 0;
        } else if root.prompt.banner-reset {
            banner-menu.show();
        } else {
            root.pick(1);
        }
    }
    function avatar-clicked() {
        if root.prompt.avatar-reset {
            avatar-menu.show();
        } else {
            root.pick(0);
        }
    }
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    property <length> bar-height: root.prompt.changed || root.prompt.saving ? 60px : 0px;
    // Show Styles: a tab on the card's left edge, once the panel has gone.
    if root.prompt.main && !root.side-open: Rectangle {
        x: card.x - 30px; y: card.y + 40px; width: 42px; height: 36px;
        opacity: 1 - root.side-out;
        border-radius: 10px; background: #000000; border-color: Theme.edge; border-width: 1px;
        accessible-role: button; accessible-label: @tr("Show Styles");
        accessible-action-default => { root.side-open = true; }
        Image { x: 7px; y: 9px; width: 18px; height: 18px; source: @image-url("icons/brush.svg"); colorize: #ffffff; }
        show-styles := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.side-open = true; } }
        if show-styles.has-hover: Rectangle {
            x: -8px; y: -40px; width: tip-text.preferred-width + 20px; height: 32px;
            border-radius: 8px; background: Theme.raised;
            tip-text := Text { text: @tr("Show Styles"); color: Theme.text; font-size: 14px; font-weight: 600; }
        }
    }
    // Its top stays where a card of a usual height starts, so what's under
    // the pointer stays put as the bar or the banner colour opens; it rises
    // only to keep its end in the window.
    card := Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: root.prompt.main ? min(958px, root.width - 96px) + (min(1199px, root.width - 8px) - min(958px, root.width - 96px)) * root.side-out : min(600px, root.width - 48px); height: min(max(card-content.preferred-height, root.prompt.main ? 798px : 620px), root.height - 48px);
        y: max(24px, min((root.height - (root.prompt.main ? 798px : 600px)) / 2, root.height - 24px - self.height));
        background: root.themed ? @linear-gradient(180deg, root.card-top, root.card-bottom) : Theme.sidebar;
        border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        // A click on the card, outside what's being edited, ends the editing.
        TouchArea { clicked => { root.stop-editing(); root.colour-open = false; } }
        scope := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if root.editing != 0 || root.colour-open {
                        root.stop-editing();
                        root.colour-open = false;
                    } else {
                        root.close();
                    }
                    return accept;
                }
                return reject;
            }
            Rectangle {
                border-radius: 12px; clip: true;
                HorizontalLayout {
                    if root.prompt.main: Rectangle {
                        width: 241px * root.side-out; clip: true;
                    ProfileCustomize {
                        x: parent.width - 241px; height: parent.height;
                        collapse => { root.side-open = false; }
                        data: root.prompt.preview;
                        avatar-enabled: root.avatar-editable; banner-enabled: root.banner-editable;
                        look-enabled: root.prompt.look-enabled; open-handle: root.theme-handle;
                        decoration-set: root.prompt.decoration-set; effect-set: root.prompt.effect-set; frame-set: root.prompt.frame-set;
                        open-style => { root.stop-editing(); root.style-open = true; }
                        open-handle-at(which) => { root.stop-editing(); root.theme-handle = root.theme-handle == which ? 0 : which; }
                        pick(which) => { root.stop-editing(); root.pick(which); }
                        open-link(url) => { root.open-link(url); }
                    }
                    }
                    if root.prompt.main && root.side-out > 0: Rectangle { width: 1px; background: Theme.line; }
                    Rectangle {
                        horizontal-stretch: 1;
                        // Shares the card evenly with the tabs, whatever each shows.
                        preferred-width: 0px;
                        min-width: root.prompt.main ? 360px : 0px;
                card-content := VerticalLayout {
                    ScrollView {
                        vertical-stretch: 1;
                        min-height: min(body.preferred-height, 240px);
                        preferred-height: body.preferred-height;
                        content-height: body.preferred-height;
                        body := VerticalLayout {
                            padding-bottom: root.pad; spacing: 0px;
                            // The banner, with the avatar hanging over its lower edge.
                            Rectangle {
                                height: root.banner-height + root.avatar-size / 2 + 8px;
                                banner := Rectangle {
                                    y: 0px; height: root.banner-height;
                                    // With neither picture nor colour, the main profile's card shows through.
                                    background: root.prompt.preview.has-accent ? root.prompt.preview.accent : root.prompt.main ? transparent : Theme.raised;
                                    if root.prompt.preview.banner.width > 0: Image {
                                        width: parent.width; height: parent.height; source: root.prompt.preview.banner; image-fit: cover;
                                    }
                                    if banner-touch.has-hover && (root.banner-editable || root.banner-locked): Rectangle { background: #00000059; }
                                    if banner-touch.has-hover && (root.banner-editable || root.banner-locked): EditBadge {
                                        x: parent.width - self.width - 60px; y: 18px; locked: root.banner-locked;
                                    }
                                    if root.prompt.reading == "banner": Text {
                                        text: @tr("Reading..."); color: #ffffff; font-size: 14px; font-weight: 700;
                                    }
                                    banner-touch := TouchArea {
                                        enabled: root.banner-editable || root.banner-locked;
                                        mouse-cursor: root.banner-editable ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => { if root.banner-editable { root.banner-clicked(); } }
                                    }
                                    banner-menu := PopupWindow {
                                        x: parent.width - 236px; y: 56px; width: 180px;
                                        Rectangle {
                                            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
                                            VerticalLayout {
                                                padding: 6px; spacing: 2px;
                                                MenuItem { text: @tr("Change Banner"); icon: @image-url("icons/image.svg"); clicked => { banner-menu.close(); root.pick(1); } }
                                                MenuItem { text: @tr("{} Banner", root.prompt.reset-word); icon: @image-url("icons/x.svg"); danger: true; clicked => { banner-menu.close(); root.reset(1); } }
                                            }
                                        }
                                    }
                                }
                                // What it edits, over the banner's corner; the main profile's column says.
                                if !root.prompt.main: Rectangle {
                                    x: 16px; y: 16px; width: detail-text.preferred-width + 20px; height: 28px; border-radius: 14px;
                                    background: #000000b3;
                                    detail-text := Text { text: root.prompt.detail; color: #ffffff; font-size: 13px; font-weight: 600; }
                                }
                                if !root.prompt.main: Rectangle {
                                    x: parent.width - self.width - 16px; y: 16px; width: 36px; height: 36px;
                                    IconButton {
                                        icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 36px; glyph: 18px; radius: 18px;
                                        fill: #000000b3; tint: #ffffff;
                                        clicked => { root.close(); }
                                    }
                                }
                                Rectangle {
                                    x: root.pad - 6px; y: root.banner-height - root.avatar-size / 2 - 6px;
                                    width: root.avatar-size + 12px; height: self.width; border-radius: self.width / 2;
                                    background: root.plate;
                                    Avatar { size: root.avatar-size; initial: root.prompt.preview.initial; tint: root.prompt.preview.tint; picture: root.prompt.preview.picture; }
                                    if root.prompt.main && root.presence != "": StatusDot {
                                        x: root.avatar-size * 0.85 - self.width / 2 + 6px; y: root.avatar-size * 0.85 - self.height / 2 + 6px;
                                        width: root.avatar-size * 0.325; height: self.width; presence: root.presence; ring: root.plate;
                                    }
                                    // What you're up to, a thought beside the picture.
                                    if root.prompt.main: Rectangle {
                                        x: root.avatar-size + 14px; y: 38px; width: 10px; height: 10px; border-radius: 5px;
                                        background: root.bubble; border-color: root.bubble-edge; border-width: 1px;
                                    }
                                    if root.prompt.main: Rectangle {
                                        x: root.avatar-size + 28px; y: 45px; width: 20px; height: 20px; border-radius: 10px;
                                        background: root.bubble; border-color: root.bubble-edge; border-width: 1px;
                                    }
                                    if root.prompt.main: Rectangle {
                                        x: root.avatar-size + 18px; y: 53px;
                                        width: min(180px, thought.preferred-width + 26px);
                                        height: thought.preferred-width > 154px ? 54px : 36px;
                                        border-radius: 16px; background: root.bubble; border-color: root.bubble-edge; border-width: 1px;
                                        accessible-role: button;
                                        accessible-label: root.has-status ? @tr("Change custom status") : @tr("Set a custom status");
                                        // The bump joins the bubble with no line between them.
                                        Rectangle { x: 11px; y: 0px; width: 18px; height: 2px; background: root.bubble; }
                                        VerticalLayout {
                                            alignment: center;
                                            padding-left: 13px; padding-right: 13px;
                                            thought := StatusText {
                                                text: root.has-status ? root.status-text : @tr("Set a custom status");
                                                emoji-url: root.has-status ? root.status-emoji : "";
                                                color: root.has-status ? root.ink : root.ink2; font-size: 14px; wrap: word-wrap; max-height: 40px;
                                            }
                                        }
                                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.edit-status(); } }
                                    }
                                    if avatar-touch.has-hover && root.ready && root.prompt.reading != "avatar": Rectangle {
                                        width: root.avatar-size; height: root.avatar-size; border-radius: root.avatar-size / 2;
                                        background: #00000073;
                                        EditBadge { locked: !root.prompt.avatar-enabled; }
                                    }
                                    if root.prompt.reading == "avatar": Rectangle {
                                        width: root.avatar-size; height: root.avatar-size; border-radius: root.avatar-size / 2;
                                        background: #00000099;
                                        Text { text: @tr("Reading..."); color: #ffffff; font-size: 13px; font-weight: 700; }
                                    }
                                    avatar-touch := TouchArea {
                                        enabled: root.ready;
                                        mouse-cursor: root.avatar-editable ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => { if root.avatar-editable { root.avatar-clicked(); } }
                                    }
                                    avatar-menu := PopupWindow {
                                        x: 12px; y: parent.height - 4px; width: 180px;
                                        Rectangle {
                                            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
                                            VerticalLayout {
                                                padding: 6px; spacing: 2px;
                                                MenuItem { text: @tr("Change Avatar"); icon: @image-url("icons/image.svg"); clicked => { avatar-menu.close(); root.pick(0); } }
                                                MenuItem { text: @tr("{} Avatar", root.prompt.reset-word); icon: @image-url("icons/x.svg"); danger: true; clicked => { avatar-menu.close(); root.reset(0); } }
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-left: root.pad; padding-right: root.prompt.main ? 8px : root.pad; spacing: root.prompt.main ? 28px : 16px;
                                // The banner colour, opened by clicking the banner.
                                if root.colour-open: Rectangle {
                                    border-radius: 8px; background: Theme.sunken;
                                    height: colour-box.preferred-height;
                                    colour-box := VerticalLayout {
                                    padding: 10px; spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Middle { Text { text: @tr("Banner color"); color: Theme.text; font-size: 14px; font-weight: 600; } }
                                        Middle {
                                            Rectangle {
                                                width: 28px; height: 28px; border-radius: 6px;
                                                background: root.prompt.has-colour ? root.prompt.colour : Theme.raised;
                                                border-width: 1px; border-color: Theme.line;
                                            }
                                        }
                                        Middle {
                                            TextField {
                                                init => { self.focus-input(); }
                                                width: 116px; min-height: 32px; text-size: 14px; pad: 8px;
                                                fill: root.prompt.colour-wrong ? Theme.danger.with-alpha(0.16) : Theme.raised;
                                                placeholder: @tr("Default"); label: @tr("Banner color");
                                                text <=> root.colour;
                                                edited(text) => { root.write(3, text); }
                                                accepted => { root.colour-open = false; scope.focus(); }
                                            }
                                        }
                                        if root.prompt.colour-wrong: Middle { Text { text: @tr("Not a colour"); color: Theme.danger; font-size: 13px; } }
                                        Rectangle { horizontal-stretch: 1; }
                                        if root.colour != "": Middle {
                                            ActionButton {
                                                small: true; ghost: true; text: @tr("Default");
                                                clicked => { root.colour = ""; root.write(3, ""); }
                                            }
                                        }
                                    }
                                    // A few to pick from, without typing.
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        for swatch in [
                                            { hex: "#5865f2", colour: #5865f2 }, { hex: "#3ba55d", colour: #3ba55d },
                                            { hex: "#faa61a", colour: #faa61a }, { hex: "#ed4245", colour: #ed4245 },
                                            { hex: "#eb459e", colour: #eb459e }, { hex: "#1abc9c", colour: #1abc9c },
                                            { hex: "#9b59b6", colour: #9b59b6 }, { hex: "#607d8b", colour: #607d8b },
                                            { hex: "#2c2f33", colour: #2c2f33 },
                                        ]: Rectangle {
                                            width: 26px; height: 26px; border-radius: 6px; background: swatch.colour;
                                            border-width: root.colour == swatch.hex ? 2px : swatch-touch.has-hover ? 1px : 0px;
                                            border-color: Theme.text;
                                            accessible-role: button;
                                            accessible-label: @tr("Banner color {}", swatch.hex);
                                            accessible-action-default => { root.colour = swatch.hex; root.write(3, swatch.hex); }
                                            swatch-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.colour = swatch.hex; root.write(3, swatch.hex); }
                                            }
                                        }
                                    }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    // The name, or its field.
                                    if root.editing != 1: HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        StyledName {
                                            text: root.prompt.loading ? @tr("Loading...") : root.prompt.preview.name;
                                            styles: root.prompt.preview.name-style; ink: root.ink; font-weight: 700;
                                            font-size: root.prompt.main ? 24px : 26px;
                                            HoverEdit {
                                                x: -7px; y: (parent.height - self.height) / 2; width: max(136px, parent.width + 14px + 28px); height: 40px;
                                                enabled: root.ready && root.prompt.name-enabled; pencil: true;
                                                label: root.prompt.main ? @tr("Edit display name") : @tr("Edit server nickname");
                                                clicked => { root.edit(1); }
                                            }
                                        }
                                    }
                                    if root.editing == 1: TextField {
                                        init => { self.focus-input(); }
                                        min-height: 40px; text-size: 22px; pad: 8px;
                                        placeholder: root.prompt.name-placeholder;
                                        label: root.prompt.main ? @tr("Display name") : @tr("Server nickname");
                                        text <=> root.name;
                                        edited(text) => { root.write(0, text); }
                                        accepted => { root.stop-editing(); }
                                    }
                                    // The username, then the pronouns or their field.
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Middle { Text { text: root.prompt.handle + " ·"; color: root.ink2; font-size: 14px; font-weight: 500; } }
                                        if root.editing != 2: Middle {
                                            Text {
                                                text: root.pronouns != "" ? root.pronouns : root.prompt.pronouns-fallback != "" ? root.prompt.pronouns-fallback : @tr("Add pronouns");
                                                color: root.pronouns != "" || root.prompt.pronouns-fallback != "" ? root.ink2 : root.ink3;
                                                font-size: 14px; font-weight: 500; overflow: elide;
                                                HoverEdit {
                                                    x: -5px; y: (parent.height - self.height) / 2; width: parent.width + 10px; height: 32px;
                                                    enabled: root.ready; label: @tr("Edit pronouns");
                                                    clicked => { root.edit(2); }
                                                }
                                            }
                                        }
                                        if root.editing == 2: TextField {
                                            init => { self.focus-input(); }
                                            width: 220px; min-height: 30px; text-size: 14px; pad: 8px;
                                            placeholder: root.prompt.pronouns-fallback != "" ? root.prompt.pronouns-fallback : @tr("Add your pronouns");
                                            label: @tr("Pronouns");
                                            text <=> root.pronouns;
                                            edited(text) => { root.write(1, text); }
                                            accepted => { root.stop-editing(); }
                                        }
                                        // The server tag worn, and where another's chosen.
                                        if root.prompt.main && root.editing != 2: Middle {
                                            tag-chip := Rectangle {
                                                height: 24px; width: tag-row.preferred-width; border-radius: 7px;
                                                background: tag-touch.has-hover ? root.ink.with-alpha(0.12) : root.ink.with-alpha(0.07);
                                                animate background { duration: 120ms; }
                                                accessible-role: button; accessible-label: @tr("Change server tag");
                                                tag-row := HorizontalLayout {
                                                    padding-left: 7px; padding-right: 5px; spacing: 4px;
                                                    if root.prompt.tag-text == "": Text { text: @tr("Server Tag"); color: root.ink2; font-size: 12px; font-italic: true; vertical-alignment: center; }
                                                    if root.prompt.tag-text != "": Middle { ServerTagChip { text: root.prompt.tag-text; badge: root.prompt.tag-icon; } }
                                                    Image { source: @image-url("icons/chevron-down.svg"); width: 14px; image-fit: contain; colorize: root.ink2; }
                                                }
                                                tag-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { tag-menu.show(); } }
                                                tag-menu := PopupWindow {
                                                    x: 0px; y: 28px; width: 270px; height: min(290px, 56px + 36px * (root.prompt.server-tags.length + 1));
                                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                                    Rectangle {
                                                        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px; clip: true;
                                                        VerticalLayout {
                                                            padding: 8px; spacing: 6px;
                                                            tag-search := TextField { placeholder: @tr("Search"); label: @tr("Search server tags"); text-size: 13px; min-height: 32px; border-radius: 8px; }
                                                            ScrollView {
                                                                vertical-stretch: 1;
                                                                content-height: tag-list.preferred-height;
                                                                tag-list := VerticalLayout {
                                                                    alignment: start;
                                                                    Rectangle {
                                                                        height: 36px; border-radius: 6px;
                                                                        background: none-touch.has-hover ? Theme.hover : transparent;
                                                                        Text { x: 8px; height: 100%; text: @tr("No Server Tag"); color: Theme.muted; font-size: 13px; font-italic: true; vertical-alignment: center; }
                                                                        none-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.choose-tag(""); tag-menu.close(); } }
                                                                    }
                                                                    for row in root.prompt.server-tags: Rectangle {
                                                                        property <bool> found: NameStyles.contains(row.name, tag-search.text) || NameStyles.contains(row.tag, tag-search.text);
                                                                        height: self.found ? 36px : 0px; visible: self.found; border-radius: 6px;
                                                                        background: row-touch.has-hover ? Theme.hover : row.id == root.prompt.tag-chosen-id ? Theme.active : transparent;
                                                                        accessible-role: button; accessible-label: row.name + ", " + row.tag;
                                                                        HorizontalLayout {
                                                                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                                                                            Middle { Avatar { size: 20px; initial: row.name; picture-url: row.icon; } }
                                                                            Text { text: row.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                                            Middle { ServerTagChip { text: row.tag; badge: row.badge; } }
                                                                        }
                                                                        row-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.choose-tag(row.id); tag-menu.close(); } }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // Their badges, in a pill after the tag.
                                        if root.prompt.main && root.editing != 2 && root.prompt.preview.badges.length > 0: Middle {
                                            Rectangle {
                                                height: 26px; border-radius: 8px; background: #00000059;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    for badge in root.prompt.preview.badges: Rectangle {
                                                        width: 22px;
                                                        ProfileBadge { width: 18px; height: 18px; badge: badge; open-link(link) => { root.open-link(link); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.prompt.too-long != "": Text { text: root.prompt.too-long; color: Theme.danger; font-size: 13px; wrap: word-wrap; }
                                }
                                // What others would see to press: Message can't be sent to oneself.
                                if root.prompt.main: HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    ActionButton { text: @tr("Message"); enabled: false; }
                                    IconButton {
                                        icon: @image-url("icons/shop.svg"); label: @tr("Shop"); size: 34px; glyph: 18px; radius: 8px; fill: Theme.raised;
                                        clicked => { root.open-link("https://discord.com/shop"); }
                                    }
                                    more-button := IconButton {
                                        icon: @image-url("icons/ellipsis.svg"); label: @tr("More"); size: 34px; glyph: 18px; radius: 8px; fill: Theme.raised;
                                        clicked => { more-menu.show(); }
                                    }
                                    more-menu := PopupWindow {
                                        x: more-button.x; y: 38px; width: 170px;
                                        Rectangle {
                                            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                            VerticalLayout {
                                                padding: 6px;
                                                MenuItem { text: @tr("Copy User ID"); icon: @image-url("icons/copy.svg"); clicked => { root.copy-id(); more-menu.close(); } }
                                            }
                                        }
                                    }
                                }
                                // Discord's offer, over what Nitro unlocks in a server.
                                if root.prompt.offer: Rectangle {
                                    border-radius: 8px; background: Theme.sunken;
                                    height: offer.preferred-height;
                                    offer := HorizontalLayout {
                                        padding: 12px; spacing: 12px;
                                        Middle { Image { source: @image-url("icons/lock.svg"); width: 20px; height: 20px; colorize: Theme.accent; } }
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 2px; alignment: center;
                                            Text { text: @tr("Make unique profiles for each server"); color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                                            Label { text: @tr("Customize your profile for every server, from avatar decorations to bios. Only with Nitro."); }
                                        }
                                        Middle {
                                            ActionButton {
                                                small: true; primary: true;
                                                text: root.prompt.upgrade ? @tr("Upgrade Nitro") : @tr("Unlock with Nitro");
                                                clicked => { root.unlock-nitro(); }
                                            }
                                        }
                                    }
                                }
                                // The bio: Markdown as it shows, or its field.
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        Middle { ProfileHeading { text: root.prompt.main ? @tr("Bio") : @tr("ABOUT ME"); color: root.prompt.main ? root.ink : root.ink3; font-size: root.prompt.main ? 13px : 12px; font-weight: root.prompt.main ? 500 : 700; letter-spacing: root.prompt.main ? 0px : 0.6px; } }
                                        if !root.prompt.bio-enabled && !root.prompt.loading: Middle {
                                            Image { source: @image-url("icons/lock.svg"); width: 13px; height: 13px; colorize: root.ink3; }
                                        }
                                    }
                                    if root.editing != 3: Rectangle {
                                        height: bio-shown.preferred-height;
                                        bio-shown := VerticalLayout {
                                            if root.prompt.preview.has-bio: StyledText {
                                                text: root.prompt.preview.bio; default-color: root.ink; link-color: Theme.link;
                                            }
                                            if !root.prompt.preview.has-bio: Text {
                                                text: root.prompt.bio-placeholder; color: root.ink3; font-size: 14px; wrap: word-wrap;
                                            }
                                        }
                                        HoverEdit {
                                            x: -7px; y: round((parent.height - self.height) / 2px) * 1px; width: root.prompt.main ? 281px : parent.width + 14px; height: max(28px, parent.height + 7px);
                                            enabled: root.ready && root.prompt.bio-enabled; label: @tr("Edit bio"); cursor: MouseCursor.text;
                                            clicked => { root.edit(3); }
                                        }
                                    }
                                    if root.editing == 3: VerticalLayout {
                                        spacing: 4px;
                                        Rectangle {
                                            height: 110px; border-radius: 6px; background: Theme.sunken;
                                            border-width: 1px; border-color: Theme.accent.with-alpha(0.8);
                                            Text {
                                                x: 10px; y: 8px; width: parent.width - 20px;
                                                visible: root.bio == "";
                                                text: root.prompt.bio-placeholder; color: Theme.muted; font-size: 14px;
                                                wrap: word-wrap; overflow: elide;
                                            }
                                            TextInput {
                                                init => { self.focus(); }
                                                x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                                                text <=> root.bio;
                                                single-line: false; wrap: word-wrap;
                                                font-size: 14px; color: Theme.text;
                                                selection-background-color: Theme.accent.with-alpha(0.35);
                                                selection-foreground-color: Theme.text;
                                                accessible-label: @tr("Bio");
                                                edited => { root.write(2, self.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            Label { text: @tr("You can use markdown and links if you'd like."); horizontal-stretch: 1; color: root.ink3; }
                                            Text {
                                                text: root.prompt.bio-left < 0 ? @tr("Too long by {}", (-root.prompt.bio-left)) : @tr("{} left", root.prompt.bio-left);
                                                color: root.prompt.bio-left < 0 ? Theme.danger : root.ink3; font-size: 12px;
                                            }
                                        }
                                    }
                                    if root.editing != 3 && root.prompt.bio-left < 0: Text {
                                        text: @tr("Too long by {}", (-root.prompt.bio-left)); color: Theme.danger; font-size: 12px;
                                    }
                                }
                                if root.prompt.preview.created != "" || root.prompt.preview.joined != "": VerticalLayout {
                                    spacing: 6px;
                                    ProfileTitle { text: @tr("Member since"); color: root.ink; }
                                    HorizontalLayout {
                                        spacing: 24px; alignment: start;
                                        if root.prompt.preview.created != "": VerticalLayout {
                                            Text { text: root.prompt.preview.created; color: root.ink; font-size: root.prompt.main ? 15px : 14px; font-weight: root.prompt.main ? 400 : 500; }
                                            if !root.prompt.main: Text { text: @tr("On Discord"); color: root.ink3; font-size: 12px; }
                                        }
                                        if root.prompt.preview.joined != "": VerticalLayout {
                                            Text { text: root.prompt.preview.joined; color: root.ink; font-size: 14px; font-weight: 500; }
                                            Text { text: @tr("In this server"); color: root.ink3; font-size: 12px; }
                                        }
                                    }
                                }
                                if root.prompt.main: VerticalLayout {
                                    spacing: 6px;
                                    ProfileHeading { text: @tr("Connections"); color: root.prompt.main ? root.ink : root.ink3; font-size: root.prompt.main ? 13px : 12px; font-weight: root.prompt.main ? 500 : 700; letter-spacing: root.prompt.main ? 0px : 0.6px; }
                                    Text {
                                        text: @tr("+  Add Connection"); color: root.ink2; font-size: 14px; font-weight: 500;
                                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open-link("https://discord.com/settings/connections"); } }
                                    }
                                }
                                if root.prompt.main: VerticalLayout {
                                    spacing: 6px;
                                    ProfileHeading { text: @tr("Note (only visible to you)"); color: root.prompt.main ? root.ink : root.ink3; font-size: root.prompt.main ? 13px : 12px; font-weight: root.prompt.main ? 500 : 700; letter-spacing: root.prompt.main ? 0px : 0.6px; }
                                    Text {
                                        text: @tr("Click to add a note"); color: root.ink3; font-size: 15px; font-italic: true;
                                        HoverEdit {
                                            x: -7px; y: (parent.height - self.height) / 2; width: 281px; height: 28px;
                                            label: @tr("Add a note"); cursor: MouseCursor.text;
                                            clicked => { root.edit-note(); }
                                        }
                                    }
                                }
                                if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                            }
                        }
                    }
                    // Discord's bar, once there's something to save.
                    if root.prompt.changed || root.prompt.saving: UnsavedBar {
                        height: root.bar-height; pad: root.pad; saving: root.prompt.saving;
                        may-reset: root.ready;
                        may-save: root.ready && root.prompt.reading == "" && root.prompt.too-long == "" && root.prompt.bio-left >= 0 && !root.prompt.colour-wrong;
                        undo => { root.stop-editing(); root.colour-open = false; root.undo(); }
                        save => { root.stop-editing(); root.save(); }
                    }
                }
                    }
                    if root.tabs-shown: ProfileTabs {
                        data: root.prompt.preview; ink: root.ink; ink2: root.ink2; ink3: root.ink3;
                        tile: !root.themed ? Theme.raised : root.theme-light ? #ffffff3d : #ffffff14;
                        line: root.themed ? root.ink.transparentize(0.88) : Theme.line;
                        open-link(url) => { root.open-link(url); }
                        open-wishlist => { root.open-wishlist(); }
                    }
                }
            }
        }
    }
    // The main profile's column runs the whole card, so it closes from the corner.
    if root.prompt.main: IconButton {
        x: card.x + card.width - self.width - 12px; y: card.y + 12px; height: self.width;
        icon: @image-url("icons/x.svg"); label: @tr("Close"); size: 36px; glyph: 18px;
        clicked => { root.close(); }
    }
    // A theme colour's picker, beside its tile.
    if root.theme-handle > 0: TouchArea { clicked => { root.theme-handle = 0; } }
    if root.theme-handle > 0: ColourPopover {
        x: card.x + 248px; y: min(card.y + 300px, root.height - self.height - 8px);
        start: root.theme-handle == 1 ? root.prompt.theme-top-text : root.prompt.theme-bottom-text;
        parse-hex(text) => { return root.parse-hex(text); }
        format-hex(colour) => { return root.format-hex(colour); }
        chosen(hex) => { root.write(root.theme-handle == 1 ? 4 : 5, hex); }
    }
    if root.style-open: Rectangle {
        background: #00000080;
        TouchArea { clicked => { root.style-open = false; } }
        NameStyleWindow {
            width: min(836px, parent.width - 32px); height: min(722px, parent.height - 32px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            start-font: root.prompt.name-font-id; start-effect: root.prompt.name-effect-id; start-key: root.prompt.name-colours-key;
            name: root.prompt.preview.name; handle: root.prompt.preview.handle;
            picture: root.prompt.preview.picture; initial: root.prompt.preview.initial; tint: root.prompt.preview.tint;
            presence: root.presence; badges: root.prompt.preview.badges;
            has-theme: root.prompt.preview.has-theme; theme-top: root.prompt.preview.theme-primary;
            theme-bottom: root.prompt.preview.theme-secondary;
            parse-hex(text) => { return root.parse-hex(text); }
            format-hex(colour) => { return root.format-hex(colour); }
            key-part(key, index) => { return root.key-part(key, index); }
            key-colour(key, index) => { return root.key-colour(key, index); }
            close => { root.style-open = false; }
            apply(font, effect, colours) => { root.choose-name-style(font, effect, colours); root.style-open = false; }
        }
    }
}
