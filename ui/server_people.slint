import { ComboBox } from "std-widgets.slint";
import { Theme, Middle, Label } from "theme.slint";
import { ActionButton, Avatar, IconButton, TextField, TipIcon } from "controls.slint";
import { SettingsTitle, SettingsHeading, SettingsSwitch } from "settings.slint";
import { ListView } from "scrollview.slint";

/// A member as Members lists them.
export struct ListedMemberRow {
    id: string,
    name: string,
    /// Shown under the name when it differs.
    username: string,
    avatar-url: string,
    initial: string,
    /// Their highest coloured role's colour, or transparent.
    name-color: color,
    /// "3 days ago", as Discord words how long.
    since: string,
    age: string,
    /// How they joined: an invite's code, "Server Discovery" and so on, and
    /// whether it's Discord's muted "Unknown".
    join: string,
    join-unknown: bool,
    /// Their highest role, its colour, and "+2" for the rest.
    role: string,
    role-color: color,
    more-roles: string,
    /// Discord's signals: "Timed out for 2h 3m", unusual DMs, suspected spam
    /// and a quarantined name.
    timed-out: string,
    unusual-dms: bool,
    spammer: bool,
    quarantined: bool,
}

/// What Members shows.
export struct MembersPrompt {
    rows: [ListedMemberRow],
    /// A search or an order is chosen: "Search Results" heads the list.
    searched: bool,
    /// One of the orders, from 0, or -1 for Discord's own.
    sort: int,
    page: int,
    pages: int,
    /// One of the page sizes, by its place.
    page-size: int,
    /// How many match, as Discord counts them: "..." while it does.
    count: string,
    total: int,
    fetching: bool,
    /// Discord indexes the server before it can search it.
    indexing: bool,
    /// Join Method shows, with Manage Server.
    join-method: bool,
}

/// An invite as Invites lists it.
export struct InviteRow {
    code: string,
    inviter: string,
    avatar-url: string,
    initial: string,
    channel: string,
    /// "3" or "3/10".
    uses: string,
    /// When it expires, in seconds from when the prompt was made; -1 for
    /// never.
    expires-in: int,
    /// The first role it gives, and "+2" for the rest.
    role: string,
    role-color: color,
    more-roles: string,
}

/// What Invites shows.
export struct InvitesPrompt {
    rows: [InviteRow],
    /// The second the rows' countdowns count from. Rows change in place, so
    /// this is what makes the prompt differ and their ticks start again.
    counted: int,
    /// Invites are paused: rows dimmed, and Enable Invites.
    paused: bool,
    /// Security Actions, while open: its hours by place, its switches, and
    /// whether Save may go.
    security: bool,
    hours: int,
    pause-invites: bool,
    pause-dms: bool,
    may-save: bool,
    saving: bool,
    security-error: string,
    /// Invites may be made here.
    may-create: bool,
}

// A role as a chip: its colour's dot and name, then "+2" for more.
component RoleChip inherits HorizontalLayout {
    in property <string> name;
    in property <color> color;
    in property <string> more;
    spacing: 4px; alignment: start;
    if root.name != "": Rectangle {
        height: 24px; border-radius: 4px; background: Theme.overlay.with-alpha(0.08);
        HorizontalLayout {
            padding-left: 6px; padding-right: 8px; spacing: 4px;
            Middle { Rectangle { width: 10px; height: 10px; border-radius: 5px; background: root.color; } }
            Text { text: root.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
    }
    if root.more != "": Middle { Text { text: root.more; color: Theme.secondary; font-size: 12px; font-weight: 600; } }
}

// Members: the server's members, newest first or in an order chosen, a page
// at a time, found by name or id; a row opens its member's profile, and its
// More Options their menu, as Discord's page has them.
export component MembersSection inherits VerticalLayout {
    in property <MembersPrompt> page;
    /// 0 search for a text, 1 an order by place, 2 go to a page, 3 a page
    /// size by place, 4 open a member's profile by id.
    callback act(int, string, int);
    /// A member's menu, by id, at a point of the window.
    callback menu(string, length, length);
    property <string> typed;
    property <string> sent;
    property <bool> flip;
    // Discord's client searches once the typing stops for 300 ms.
    Timer {
        interval: root.flip ? 300ms : 301ms;
        running: root.typed != root.sent;
        triggered => { root.sent = root.typed; root.act(0, root.typed, 0); }
    }
    spacing: 16px;
    SettingsTitle { text: @tr("Server Members"); }
    HorizontalLayout {
        spacing: 12px;
        Middle {
            horizontal-stretch: 1;
            Text { text: root.page.searched ? @tr("Search Results") : @tr("Recent Members"); color: Theme.text; font-size: 16px; font-weight: 700; }
        }
        TextField {
            width: 190px; horizontal-stretch: 0; text-size: 14px;
            text <=> root.typed; placeholder: @tr("Search by username or id"); label: @tr("Search members");
            edited => { root.flip = !root.flip; }
            accepted => { root.sent = root.typed; root.act(0, root.typed, 0); }
        }
        ComboBox {
            width: 200px;
            model: [@tr("Member Since (Newest first)"), @tr("Member Since (Oldest first)"), @tr("Joined Discord (Newest first)"), @tr("Joined Discord (Oldest first)")];
            current-index: max(root.page.sort, 0);
            accessible-label: @tr("Sort");
            selected => { root.act(1, "", self.current-index); }
        }
    }
    // The columns' names; the columns share the width as Discord's grow.
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        for column in [
            { text: @tr("NAME"), grow: 4 },
            { text: @tr("MEMBER SINCE"), grow: 2 },
            { text: @tr("JOINED DISCORD"), grow: 2 },
            { text: @tr("JOIN METHOD"), grow: root.page.join-method ? 2 : 0 },
            { text: @tr("ROLES"), grow: 2 },
            { text: @tr("SIGNALS"), grow: 1.5 },
        ]: Text {
            visible: column.grow > 0;
            text: column.text; color: Theme.secondary; font-size: 11px; font-weight: 700; overflow: elide;
            preferred-width: 0px; min-width: 0px; horizontal-stretch: column.grow;
        }
        Rectangle { width: 32px; }
    }
    if root.page.indexing: Label { text: @tr("Before searching, we need to index this server. Give us a bit."); }
    if root.page.rows.length == 0 && root.page.fetching && !root.page.indexing: Label { text: @tr("Loading..."); vertical-stretch: 1; }
    if root.page.rows.length == 0 && !root.page.fetching: VerticalLayout {
        alignment: center; vertical-stretch: 1;
        Text { text: @tr("No members match these search results."); color: Theme.secondary; font-size: 15px; horizontal-alignment: center; }
    }
    if root.page.rows.length > 0: ListView {
        vertical-stretch: 1; min-height: 120px;
        for member in root.page.rows: Rectangle {
            height: 56px; border-radius: 6px;
            background: area.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
            accessible-role: button; accessible-label: member.name;
            accessible-action-default => { root.act(4, member.id, 0); }
            area := TouchArea {
                clicked => { root.act(4, member.id, 0); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.menu(member.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                HorizontalLayout {
                    spacing: 10px; horizontal-stretch: 4; preferred-width: 0px; min-width: 0px;
                    Middle { Avatar { size: 32px; initial: member.initial; picture-url: member.avatar-url; } }
                    Middle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: member.name; font-size: 15px; font-weight: 600; overflow: elide;
                                color: member.name-color.alpha > 0 ? member.name-color : Theme.text;
                            }
                            if member.username != "": Text { text: member.username; color: Theme.secondary; font-size: 13px; overflow: elide; }
                        }
                    }
                }
                Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 2; text: member.since; color: Theme.secondary; font-size: 13px; vertical-alignment: center; overflow: elide; }
                Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 2; text: member.age; color: Theme.secondary; font-size: 13px; vertical-alignment: center; overflow: elide; }
                Text {
                    visible: root.page.join-method;
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: root.page.join-method ? 2 : 0;
                    text: member.join; font-size: 13px; vertical-alignment: center; overflow: elide;
                    color: member.join-unknown ? Theme.muted : Theme.text;
                }
                Middle { preferred-width: 0px; min-width: 0px; horizontal-stretch: 2; RoleChip { name: member.role; color: member.role-color; more: member.more-roles; } }
                HorizontalLayout {
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1.5; spacing: 2px; alignment: start;
                    if member.unusual-dms: Middle { TipIcon { source: @image-url("icons/message-circle.svg"); colorize: Theme.muted; tip: @tr("Sent excessive DMs to non-friend server members in last 24 hrs"); } }
                    if member.timed-out != "": Middle { TipIcon { source: @image-url("icons/clock.svg"); colorize: Theme.danger; tip: member.timed-out; } }
                    if member.spammer: Middle { TipIcon { source: @image-url("icons/triangle-alert.svg"); colorize: Theme.danger; tip: @tr("Engaged in suspected spam activity"); } }
                    if member.quarantined: Middle { TipIcon { source: @image-url("icons/shield.svg"); colorize: Theme.muted; tip: @tr("User can't talk in server until they change their member name"); } }
                }
                Middle {
                    more := IconButton {
                        icon: @image-url("icons/ellipsis.svg"); label: @tr("More Options"); size: 32px; glyph: 18px;
                        clicked => { root.menu(member.id, self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                }
            }
        }
    }
    // Discord's footer: how many a page, of how many, and the pager while
    // there's more than a page.
    property <int> page-length: [12, 25, 50, 100][root.page.page-size];
    HorizontalLayout {
        spacing: 8px;
        if root.page.total > 12: Middle { Text { text: @tr("Showing"); color: Theme.secondary; font-size: 14px; } }
        if root.page.total > 12: ComboBox {
            width: 80px; model: ["12", "25", "50", "100"]; current-index: root.page.page-size;
            accessible-label: @tr("Members per page");
            selected => { root.act(3, "", self.current-index); }
        }
        Middle {
            horizontal-stretch: 1;
            Text {
                text: root.page.total > 12 ? @tr("members of {}", root.page.count) : @tr("Showing {0}{1}", root.page.count, (root.page.total == 1 ? @tr(" member") : @tr(" members")));
                color: Theme.secondary; font-size: 14px;
            }
        }
        if root.page.total > root.page-length || root.page.fetching: HorizontalLayout {
            spacing: 8px;
            ActionButton {
                text: @tr("Previous"); ghost: true; enabled: root.page.page > 0;
                clicked => { root.act(2, "", root.page.page - 1); }
            }
            Middle { Text { text: @tr("{0} of {1}", (root.page.page + 1), root.page.pages); color: Theme.secondary; font-size: 14px; } }
            ActionButton {
                text: @tr("Next"); ghost: true; enabled: root.page.page + 1 < root.page.pages && !root.page.fetching;
                clicked => { root.act(2, "", root.page.page + 1); }
            }
        }
    }
}

// Days, hours, minutes and seconds left, as Discord's invites count down.
component Countdown inherits Text {
    in property <int> seconds;
    property <int> days: floor(root.seconds / 86400);
    property <int> hours: mod(floor(root.seconds / 3600), 24);
    property <int> minutes: mod(floor(root.seconds / 60), 60);
    property <int> secs: mod(root.seconds, 60);
    function two(n: int) -> string { return (n < 10 ? "0" : "") + n; }
    text: root.seconds < 0 ? "∞" : (root.days > 0 ? root.two(root.days) + ":" : "") + root.two(root.hours) + ":" + root.two(root.minutes) + ":" + root.two(root.secs);
}

// Invites: the server's invites, each revoked at once, Security Actions'
// pause, and Create Invite Link, as Discord's page has them.
export component InvitesSection inherits VerticalLayout {
    in property <InvitesPrompt> page;
    /// 0 revoke an invite by code, 1 create one, 2 open Security Actions.
    callback act(int, string, int);
    // The countdowns tick each second from the prompt's time.
    property <int> ticks;
    changed page => { root.ticks = 0; }
    Timer { interval: 1s; running: root.page.rows.length > 0; triggered => { root.ticks += 1; } }
    spacing: 16px;
    SettingsTitle { text: @tr("Invites"); }
    Label { text: @tr("Create an invite link anyone can use to join, or invite friends directly."); }
    HorizontalLayout {
        spacing: 8px;
        Middle {
            horizontal-stretch: 1;
            SettingsHeading { text: root.page.rows.length > 0 ? @tr("ACTIVE INVITE LINKS") : @tr("NO ACTIVE INVITE LINKS"); }
        }
        ActionButton {
            text: root.page.paused ? @tr("Enable Invites") : @tr("Pause Invites");
            primary: root.page.paused; danger: !root.page.paused;
            clicked => { root.act(2, "", 0); }
        }
        if root.page.may-create: ActionButton {
            text: @tr("Create Invite Link"); primary: true;
            clicked => { root.act(1, "", 0); }
        }
    }
    // Discord's columns grow 4, 3, 1, 2 and 2.
    if root.page.rows.length > 0: HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        for column in [
            { text: @tr("INVITER"), grow: 4 },
            { text: @tr("INVITE CODE"), grow: 3 },
            { text: @tr("USES"), grow: 1 },
            { text: @tr("EXPIRES"), grow: 2 },
            { text: @tr("ROLES"), grow: 2 },
        ]: Text {
            text: column.text; color: Theme.secondary; font-size: 12px; font-weight: 700;
            preferred-width: 0px; min-width: 0px; horizontal-stretch: column.grow;
        }
        Rectangle { width: 32px; }
    }
    if root.page.rows.length > 0: ListView {
        vertical-stretch: 1; min-height: 120px;
        for invite in root.page.rows: Rectangle {
            height: 56px; border-radius: 6px;
            opacity: root.page.paused ? 0.5 : 1;
            background: hover.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
            hover := TouchArea { }
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                HorizontalLayout {
                    spacing: 10px; horizontal-stretch: 4; preferred-width: 0px; min-width: 0px;
                    Middle { Avatar { size: 24px; initial: invite.initial; picture-url: invite.avatar-url; } }
                    Middle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 1px;
                            Text { text: invite.inviter; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                            Text { text: invite.channel; color: Theme.secondary; font-size: 13px; overflow: elide; }
                        }
                    }
                }
                Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 3; text: invite.code; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                Text { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; text: invite.uses; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                Countdown {
                    preferred-width: 0px; min-width: 0px; horizontal-stretch: 2; color: Theme.text; font-size: 14px; vertical-alignment: center;
                    seconds: invite.expires-in < 0 ? -1 : max(0, invite.expires-in - root.ticks);
                    accessible-label: invite.expires-in < 0 ? @tr("Never") : self.text;
                }
                Middle { preferred-width: 0px; min-width: 0px; horizontal-stretch: 2; RoleChip { name: invite.role; color: invite.role-color; more: invite.more-roles; } }
                Middle {
                    IconButton {
                        icon: @image-url("icons/x.svg"); label: @tr("Remove"); size: 32px; glyph: 18px; danger: true;
                        opacity: hover.has-hover || self.hovered ? 1 : 0;
                        clicked => { root.act(0, invite.code, 0); }
                    }
                }
            }
        }
    }
    if root.page.rows.length == 0: Rectangle { vertical-stretch: 1; }
}

// Security Actions, over the screen: pause invites, DMs or both for some
// hours, as Discord's dialog does.
export component SecurityActionsDialog inherits Rectangle {
    in property <InvitesPrompt> page;
    /// 3 the hours by place, 4 pause invites, 5 pause DMs, 6 save, 7 close.
    callback act(int, int);
    background: #000000aa;
    TouchArea { clicked => { root.act(7, 0); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.act(7, 0); return accept; }
            return reject;
        }
        Rectangle {
            width: 480px; height: box.preferred-height;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.chat; border-radius: 8px;
            accessible-role: groupbox; accessible-label: @tr("Security Actions");
            TouchArea { }
            box := VerticalLayout {
                padding: 16px; spacing: 14px;
                Text { text: @tr("Security Actions"); color: Theme.text; font-size: 20px; font-weight: 700; }
                VerticalLayout {
                    ComboBox {
                        model: [@tr("1 hour"), @tr("2 hours"), @tr("4 hours"), @tr("6 hours"), @tr("12 hours"), @tr("24 hours")];
                        current-index: root.page.hours; enabled: !root.page.saving;
                        accessible-label: @tr("Duration");
                        selected => { root.act(3, self.current-index); }
                    }
                }
                SettingsSwitch {
                    text: @tr("Pause Invites"); description: @tr("Temporarily stop new members from joining this server via invite or vanity links.");
                    checked: root.page.pause-invites; controlled: true; enabled: !root.page.saving;
                    toggled => { root.act(4, 0); }
                }
                SettingsSwitch {
                    text: @tr("Pause DMs"); description: @tr("Temporarily stop new direct messages from being sent between members in your server. Friends can still DM each other, moderators can still DM members, and your Apps can still DM members.");
                    checked: root.page.pause-dms; controlled: true; enabled: !root.page.saving;
                    toggled => { root.act(5, 0); }
                }
                if root.page.security-error != "": Text { text: root.page.security-error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    ActionButton { text: @tr("Cancel"); ghost: true; enabled: !root.page.saving; clicked => { root.act(7, 0); } }
                    ActionButton {
                        text: root.page.saving ? @tr("Saving...") : @tr("Save"); primary: true; enabled: root.page.may-save && !root.page.saving;
                        clicked => { root.act(6, 0); }
                    }
                }
            }
        }
    }
}
