import { ListView } from "scrollview.slint";
import { Theme, Middle } from "theme.slint";
import { IconButton, PingToggle, ActionButton, MessagesSkeleton, TextField } from "controls.slint";
import { FoundRow, FoundCard } from "header.slint";
import { SettingsSwitch } from "settings.slint";
import { Composer, StagedFile, StagedTile, MentionRow, MentionList, EmojiSuggestions } from "composer.slint";
import { EmojiCell, EmojiButton, MessageRow, MessageContent, HistoryEdge } from "messages.slint";

/// A Discord thread beside the open channel, in place of its member list, as
/// Discord opens a thread from a message: its messages and a composer, with a
/// way to show it in place of the channel.
export component ThreadPanel inherits Rectangle {
    in property <string> name;
    in property <[MessageRow]> messages;
    /// Its timeline came.
    in property <bool> ready;
    in property <bool> loading;
    in property <bool> start;
    in property <bool> failed;
    in property <bool> busy;
    in property <bool> composer-enabled;
    in property <bool> can-send;
    in property <bool> sending;
    /// "Replying to ..." or "Editing your message", over the composer.
    in property <string> compose-label;
    /// Whether the reply being written mentions the person it replies to.
    in property <bool> reply-ping;
    callback toggle-reply-ping;
    in-out property <string> draft;
    /// Files waiting to go with the next message.
    in property <[StagedFile]> staged;
    in property <bool> can-attach;
    in property <bool> can-mark-spoilers;
    callback attach;
    callback unstage(int);
    callback toggle-spoiler(int);
    /// The window pastes the clipboard's files, or counts `paste-tick` up
    /// for its text.
    callback paste;
    in property <int> paste-tick;
    changed paste-tick => { composer.paste-text(); }
    in property <string> emoji-font;
    in property <length> message-font-size;
    in property <[EmojiCell]> bar-reactions;
    /// The window's message under the pointer, and those its popups are for,
    /// whose actions stay.
    in-out property <string> active-item;
    in property <string> react-item;
    in property <string> menu-item;
    in property <string> confirm-delete;
    /// Shift is held: the hover bar shows its quick actions.
    in property <bool> shift-held;
    in property <bool> forward-allowed;
    /// The rows at the top and bottom of the view, for the media to load.
    property <int> top-index: -1;
    property <int> bottom-index: -1;
    callback close;
    callback expand;
    /// The More button, with where its menu opens.
    callback more(length, length);
    callback earlier;
    callback draft-edited(string);
    callback send;
    callback cancel-compose;
    /// The rows at the top and bottom of the view changed.
    callback viewport(int, int);
    callback reply(string);
    callback edit(string);
    callback pin-message(string);
    callback start-forward(string);
    callback delete-now(string);
    callback react(string, string);
    /// A message's reaction picker or menu, opening beside what was clicked.
    callback open-picker(string, length, length, length, length);
    callback open-menu(MessageRow, length, length, length, length);
    /// A message's menu from a right click on its picture or video at this
    /// index of its attachments, which may be one.
    callback open-media-menu(MessageRow, int, bool, length, length);
    callback confirm-delete-message;
    callback cancel-delete;
    callback author-card(string, string, length, length, length, length);
    callback author-menu(string, string, length, length);
    callback jump-to(string);
    /// A link in a message's text, and where the pointer clicked it.
    callback link-clicked(string, length, length);
    callback open-link(string);
    callback open-thread(string);
    callback retry(string);
    callback cancel-send(string);
    callback reveal-attachment(string, int);
    callback view-image(string, int);
    callback save-attachment(string, int);
    public function focus-composer() { composer.focus-input(); }
    /// Counts up for the window to focus the composer, after a menu's Reply or Edit.
    in property <int> focus-tick;
    changed focus-tick => { composer.focus-input(); }
    /// Goes up for a key typed with nothing focused: the composer takes the
    /// focus with its caret at the end.
    in property <int> typing-tick;
    changed typing-tick => { composer.focus-input(); composer.place-caret(1000000); }
    callback composer-focused;
    /// Escape in the composer; whether it was taken.
    callback escape-composing() -> bool;
    /// Counts up for the window to put the cursor at `caret-offset`, after a
    /// suggestion was chosen.
    in property <int> caret-tick;
    in property <int> caret-offset;
    changed caret-tick => { composer.place-caret(root.caret-offset); composer.focus-input(); }
    // Mention and emoji suggestions for what's typed here, as the channel's
    // composer has; the window fills them while this composer was typed in last.
    in property <[MentionRow]> mentions;
    in property <int> mention-index;
    in property <[EmojiCell]> emoji-suggestions;
    in property <string> emoji-suggestion-query;
    in property <int> emoji-suggestion-index;
    callback caret(string, int);
    callback suggestion-moved(int);
    callback suggestion-chosen;
    callback suggestion-dismissed;
    callback mention-chosen(int);
    callback emoji-suggestion-chosen(int);
    public function scroll-to-latest() {
        root.follow-latest = true;
        thread-list.content-y = min(0px, thread-list.height - thread-list.content-height);
    }
    property <bool> is-editing: root.compose-label == "Editing your message";
    background: Theme.chat;
    accessible-role: list;
    accessible-label: root.name + " thread";
    Rectangle { x: 0; width: 1px; background: Theme.edge; }

    // The newest message stays in view as rows come, until scrolled away from,
    // as in the timeline. Earlier pages hold the rows in view where they were.
    property <bool> follow-latest: true;
    property <length> list-position: thread-list.content-y;
    property <length> list-content: thread-list.content-height;
    property <length> list-viewport: thread-list.height;
    changed list-position => {
        if thread-list.content-y <= min(0px, thread-list.height - thread-list.content-height) + 0.5px { root.follow-latest = true; }
    }
    changed list-viewport => { if root.follow-latest { root.scroll-to-latest(); } }
    changed list-content => { if root.follow-latest { root.scroll-to-latest(); } }
    // Earlier messages load as the list nears its top, a page at a time,
    // until the first message; after a failure they wait for Retry. A timer
    // rather than a changed handler, as the panel can be made with its
    // timeline already there, when no change follows.
    property <bool> wants-earlier: root.ready && !root.busy && root.messages.length > 0
        && !root.loading && !root.start && !root.failed && -thread-list.content-y < thread-list.height;
    Timer { interval: 50ms; running: root.wants-earlier; triggered => { root.earlier(); } }
    changed top-index => { root.viewport(root.top-index, root.bottom-index); }
    changed bottom-index => { root.viewport(root.top-index, root.bottom-index); }
    property <int> count: root.messages.length;
    changed count => { root.viewport(root.top-index, root.bottom-index); }
    property <int> view-tick;

    VerticalLayout {
        x: 1px; width: parent.width - 1px;
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 8px;
                Middle { Image { source: @image-url("icons/thread.svg"); width: 18px; height: 18px; colorize: Theme.muted; } }
                Text { text: root.name; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Middle {
                    IconButton {
                        icon: @image-url("icons/ellipsis.svg"); label: "More"; size: 28px; glyph: 18px; tip-side: 2;
                        clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height + 6px); }
                    }
                }
                Middle { IconButton { icon: @image-url("icons/maximize.svg"); label: "Open in full view"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.expand(); } } }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close thread"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        Rectangle {
            vertical-stretch: 1;
            thread-list := ListView {
                width: parent.width; height: parent.height;
                scrolled => { root.follow-latest = false; }
                for message[index] in root.messages: Rectangle {
                    property <bool> lit: root.active-item == message.item;
                    property <length> view-y: self.y + thread-list.content-y;
                    property <int> view-tick: root.view-tick;
                    function report-view() {
                        if self.view-y <= 0px && self.view-y + self.height > 0px { root.top-index = index; }
                        if self.view-y < thread-list.height && (self.view-y + self.height >= thread-list.height || index == root.messages.length - 1) { root.bottom-index = index; }
                    }
                    init => { root.view-tick += 1; }
                    changed view-y => { self.report-view(); }
                    changed height => { self.report-view(); }
                    changed view-tick => { self.report-view(); }
                    height: col.preferred-height;
                    background: self.lit ? Theme.row-hover : transparent;
                    if message.highlighted: Rectangle {
                        y: index == 0 ? col.padding-top + 42px : 0px;
                        background: row-pointer.has-hover ? Theme.mentioned-hover : Theme.mentioned;
                        Rectangle { x: 0px; width: 2px; background: Theme.accent; }
                    }
                    row-pointer := TouchArea {
                        changed has-hover => { if self.has-hover { root.active-item = message.item; } }
                        clicked => { root.active-item = message.item; }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                && !message.deleted && message.delivery == "" {
                                root.active-item = message.item;
                                root.open-menu(message, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0px, 0px);
                            }
                        }
                        col := VerticalLayout {
                            padding-top: message.day != "" ? 12px : message.first ? 14px : 1px;
                            padding-bottom: index == root.messages.length - 1 ? 20px : 1px;
                            spacing: 0px;
                            if index == 0: HistoryEdge {
                                loading: root.loading; failed: root.failed; start: root.start;
                                enabled: !root.busy; room-thread: true; room-name: root.name;
                                earlier => { root.earlier(); }
                            }
                            if message.day != "": HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; padding-bottom: 6px; spacing: 10px; height: 26px;
                                Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                Text { text: message.day; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                            }
                            MessageContent {
                                message: message; active-item: root.active-item; composer-enabled: root.composer-enabled;
                                emoji-font: root.emoji-font; message-font-size: root.message-font-size;
                                end-padding: 16px;
                                author-card(item, sender, x, y, width, height) => { root.author-card(item, sender, x, y, width, height); }
                                author-menu(item, sender, x, y) => { root.author-menu(item, sender, x, y); }
                                jump-to(item) => { root.jump-to(item); }
                                link-clicked(link) => {
                                    root.link-clicked(link, row-pointer.absolute-position.x + row-pointer.mouse-x, row-pointer.absolute-position.y + row-pointer.mouse-y);
                                }
                                open-link(link) => { root.open-link(link); }
                                open-thread(room) => { root.open-thread(room); }
                                react(item, key) => { root.react(item, key); }
                                retry(item) => { root.retry(item); }
                                cancel-send(item) => { root.cancel-send(item); }
                                reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                                view-image(id, index) => { root.view-image(id, index); }
                                save-attachment(id, index) => { root.save-attachment(id, index); }
                                media-menu(id, index, video, x, y) => {
                                    if !message.deleted && message.delivery == "" {
                                        root.active-item = message.item;
                                        root.open-media-menu(message, index, video, x, y);
                                    }
                                }
                            }
                        }
                    }
                    // The row's actions float over its top edge, as in the timeline,
                    // with fewer reactions for the narrower panel.
                    if (self.lit || root.react-item == message.item || root.menu-item == message.item || root.confirm-delete == message.item) && !message.deleted && message.delivery == "": message-bar := Rectangle {
                        x: parent.width - self.width - 12px; y: index == 0 ? 4px : -16px;
                        width: actions.preferred-width; height: actions.preferred-height;
                        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                        drop-shadow-blur: 10px; drop-shadow-color: #00000059; drop-shadow-offset-y: 2px;
                        // Shift's quick actions, as in the timeline.
                        property <bool> quick: root.shift-held && root.react-item != message.item && root.menu-item != message.item;
                        property <bool> deletes: self.quick && message.can-delete && root.composer-enabled;
                        actions := HorizontalLayout {
                            padding: 3px; spacing: 0px;
                            if root.confirm-delete == message.item: HorizontalLayout {
                                spacing: 4px; padding-left: 8px;
                                Text { text: "Delete for everyone?"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                ActionButton { text: "Delete"; danger: true; small: true; clicked => { root.confirm-delete-message(); } }
                                ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-delete(); } }
                            }
                            if root.confirm-delete != message.item: HorizontalLayout {
                                spacing: 0px;
                                if message-bar.quick && message.can-pin: IconButton {
                                    icon: message.pinned ? @image-url("icons/pin-off.svg") : @image-url("icons/pin.svg");
                                    label: message.pinned ? "Unpin" : "Pin";
                                    clicked => { root.pin-message(message.item); }
                                }
                                if message-bar.quick && message.own && message.can-edit && message.can-reply && root.composer-enabled: IconButton {
                                    icon: @image-url("icons/reply.svg"); label: "Reply";
                                    clicked => { root.reply(message.item); root.focus-composer(); }
                                }
                                if message.can-react && root.composer-enabled: HorizontalLayout {
                                    spacing: 0px;
                                    for cell[slot] in root.bar-reactions: EmojiButton {
                                        animation-key: cell.key;
                                        visible: slot < 2 && !message-bar.quick; width: slot < 2 && !message-bar.quick ? 32px : 0px;
                                        emoji: cell; font: root.emoji-font;
                                        clicked => { root.react(message.item, cell.key); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/smile-plus.svg"); label: "Add reaction";
                                        clicked => { root.open-picker(message.item, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                    }
                                }
                                if message.own && message.can-edit && root.composer-enabled: IconButton { icon: @image-url("icons/pencil.svg"); label: "Edit"; clicked => { root.edit(message.item); root.focus-composer(); } }
                                if !(message.own && message.can-edit) && message.can-reply && root.composer-enabled: IconButton { icon: @image-url("icons/reply.svg"); label: "Reply"; clicked => { root.reply(message.item); root.focus-composer(); } }
                                if message-bar.quick && message.can-forward && root.forward-allowed: IconButton {
                                    icon: @image-url("icons/forward.svg"); label: "Forward";
                                    clicked => { root.start-forward(message.item); }
                                }
                                if message-bar.deletes: IconButton {
                                    icon: @image-url("icons/trash-2.svg"); label: "Delete"; danger: true;
                                    clicked => { root.delete-now(message.item); }
                                }
                                if !message-bar.deletes: IconButton {
                                    icon: @image-url("icons/ellipsis.svg"); label: "More";
                                    clicked => { root.open-menu(message, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                }
                            }
                        }
                    }
                }
            }
            if root.messages.length == 0 && !root.ready: MessagesSkeleton {
                width: parent.width; height: parent.height;
            }
            if root.messages.length == 0 && root.ready: Text {
                x: 16px; width: parent.width - 32px;
                text: "This is the start of the " + root.name + " thread.";
                color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            }
        }
        VerticalLayout {
            padding-left: 12px; padding-right: 12px; padding-bottom: 12px; spacing: 0px; vertical-stretch: 0;
            if root.compose-label != "": Rectangle {
                height: 36px; background: Theme.sidebar;
                border-top-left-radius: 10px; border-top-right-radius: 10px;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 4px; spacing: 8px;
                    Image { source: root.is-editing ? @image-url("icons/pencil.svg") : @image-url("icons/reply.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                    Text { text: root.compose-label; color: Theme.secondary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if !root.is-editing: VerticalLayout { alignment: center; PingToggle { on: root.reply-ping; toggled => { root.toggle-reply-ping(); } } }
                    IconButton { icon: @image-url("icons/x.svg"); label: root.is-editing ? "Cancel editing" : "Cancel reply"; size: 28px; glyph: 16px; clicked => { root.cancel-compose(); } }
                }
            }
            composer-box := Rectangle {
                min-height: 48px;
                background: Theme.field;
                border-radius: 10px;
                border-top-left-radius: root.compose-label != "" ? 0px : 10px;
                border-top-right-radius: root.compose-label != "" ? 0px : 10px;
                VerticalLayout {
                    spacing: 0px;
                    // Files waiting to go with the message, in a row that scrolls sideways.
                    if root.staged.length > 0: Flickable {
                        height: 152px;
                        content-width: max(self.width, staged-row.preferred-width);
                        staged-row := HorizontalLayout {
                            padding: 10px; padding-bottom: 2px; spacing: 8px; alignment: LayoutAlignment.start;
                            for file[index] in root.staged: StagedTile {
                                file: file; can-spoil: root.can-mark-spoilers;
                                remove => { root.unstage(index); }
                                toggle-spoiler => { root.toggle-spoiler(index); }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 6px;
                        VerticalLayout {
                            alignment: end; padding-bottom: 8px;
                            IconButton {
                                icon: @image-url("icons/circle-plus.svg"); label: "Attach files";
                                glyph: 22px; enabled: root.can-attach;
                                clicked => { root.attach(); }
                            }
                        }
                        composer := Composer {
                            text <=> root.draft; enabled: root.composer-enabled; label: "Message " + root.name;
                            placeholder: root.is-editing ? "Edit your message" : root.compose-label != "" ? "Write a reply" : "Message " + root.name;
                            edited(text) => { root.draft-edited(text); }
                            accepted => { root.send(); }
                            paste => { root.paste(); }
                            suggesting: root.mentions.length > 0 || root.emoji-suggestions.length > 0;
                            caret(text, offset) => { root.caret(text, offset); }
                            suggestion-moved(step) => { root.suggestion-moved(step); }
                            suggestion-chosen => { root.suggestion-chosen(); }
                            suggestion-dismissed => { root.suggestion-dismissed(); }
                            escaped => { return root.escape-composing(); }
                            got-focus => { root.composer-focused(); }
                        }
                        VerticalLayout {
                            alignment: end; padding-bottom: 8px;
                            IconButton {
                                icon: @image-url("icons/send-horizontal.svg");
                                label: root.sending ? "Sending..." : root.is-editing ? "Save" : "Send";
                                enabled: root.can-send; emphasis: root.can-send;
                                clicked => { root.send(); }
                            }
                        }
                    }
                }
            }
        }
    }
    // Suggestions just above the composer and as wide as it, over a reply's or
    // an edit's bar, as the channel's show above its own.
    property <length> suggestions-y: composer-box.absolute-position.y - root.absolute-position.y - (root.compose-label != "" ? 36px : 0px) - 8px;
    if root.mentions.length > 0 && root.composer-enabled: MentionList {
        x: composer-box.absolute-position.x - root.absolute-position.x;
        width: composer-box.width;
        y: root.suggestions-y - self.height;
        mentions: root.mentions; mention-index: root.mention-index;
        mention-chosen(index) => { root.mention-chosen(index); }
    }
    if root.emoji-suggestions.length > 0 && root.mentions.length == 0 && root.composer-enabled: EmojiSuggestions {
        x: composer-box.absolute-position.x - root.absolute-position.x;
        width: composer-box.width;
        y: root.suggestions-y - self.height;
        emoji: root.emoji-suggestions; query: root.emoji-suggestion-query;
        emoji-index: root.emoji-suggestion-index; emoji-font: root.emoji-font;
        emoji-chosen(index) => { root.emoji-suggestion-chosen(index); }
    }
}

// Discord's "New Thread" form, beside the channel in place of its member
// list: the message it starts from, its name, whether it's private, and
// the first message, which Enter sends with the thread. Closing it after
// writing asks first, as Discord's does.
export component NewThreadPanel inherits Rectangle {
    /// The message it starts from, if any.
    in property <bool> from-message;
    in property <FoundRow> starter;
    in-out property <string> name;
    /// What an empty name becomes, or "New Thread".
    in property <string> name-placeholder;
    in-out property <string> body;
    in property <bool> can-private;
    in property <bool> only-private;
    in property <bool> private;
    in property <bool> starting;
    in property <string> error;
    /// Closing asks first.
    in property <bool> leaving;
    callback name-edited(string);
    callback body-edited(string);
    callback private-changed(bool);
    callback create;
    callback close;
    callback leave;
    callback stay;
    callback jump-to(string);
    callback open-link(string);
    public function focus-composer() { composer.focus-input(); }
    /// Goes up for a key typed with nothing focused, as on ThreadPanel.
    in property <int> typing-tick;
    changed typing-tick => { composer.focus-input(); composer.place-caret(1000000); }
    callback composer-focused;
    callback escape-composing() -> bool;
    background: Theme.chat;
    accessible-role: groupbox;
    accessible-label: "New Thread";
    Rectangle { x: 0; width: 1px; background: Theme.edge; }
    VerticalLayout {
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                Middle { Image { source: @image-url("icons/thread.svg"); width: 18px; height: 18px; colorize: Theme.muted; } }
                Text { text: "New Thread"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        VerticalLayout {
            padding: 16px; spacing: 16px; vertical-stretch: 1; alignment: start;
            if root.from-message: FoundCard {
                found: root.starter;
                jump => { root.jump-to(root.starter.item); }
                open-link(link) => { root.open-link(link); }
            }
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: root.from-message ? "THREAD NAME (OPTIONAL)" : "THREAD NAME";
                    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                }
                name-field := TextField {
                    text <=> root.name; placeholder: root.name-placeholder; label: "Thread Name";
                    enabled: !root.starting;
                    edited(text) => { root.name-edited(text); }
                    accepted => { root.focus-composer(); }
                }
            }
            if root.can-private: SettingsSwitch {
                text: "Private Thread";
                description: root.private
                    ? "Only people you invite and moderators can see. You can invite new people by @mentioning them."
                    : "Only people you invite and moderators can see";
                checked: root.private; enabled: !root.only-private && !root.starting;
                toggled(checked) => { root.private-changed(checked); }
            }
            if root.error != "": Text { text: root.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        }
        VerticalLayout {
            padding-left: 12px; padding-right: 12px; padding-bottom: 12px; vertical-stretch: 0;
            Rectangle {
                min-height: 48px; background: Theme.field; border-radius: 10px;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                    composer := Composer {
                        text <=> root.body; enabled: !root.starting; label: "First message";
                        placeholder: "Enter a message to start the conversation!";
                        edited(text) => { root.body-edited(text); }
                        accepted => { root.create(); }
                        paste => { self.paste-text(); }
                        escaped => { return root.escape-composing(); }
                        got-focus => { root.composer-focused(); }
                    }
                    VerticalLayout {
                        alignment: end; padding-bottom: 8px;
                        IconButton {
                            icon: @image-url("icons/send-horizontal.svg");
                            label: root.starting ? "Creating..." : "Create Thread";
                            enabled: !root.starting; emphasis: !root.starting && root.body != "";
                            clicked => { root.create(); }
                        }
                    }
                }
            }
        }
    }
    // Leaving what was written, as Discord's client asks.
    if root.leaving: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            x: 16px; width: parent.width - 32px; y: (parent.height - self.height) / 2;
            height: ask.preferred-height;
            background: Theme.sidebar; border-radius: 10px; border-width: 1px; border-color: Theme.edge;
            ask := VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "Are you sure you want to go?"; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                Text { text: "Any changes you made will be lost if you exit now."; color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 6px;
                    ActionButton { text: "Back to editing"; ghost: true; clicked => { root.stay(); } }
                    ActionButton { text: "Exit"; danger: true; clicked => { root.leave(); } }
                }
            }
        }
    }
}
