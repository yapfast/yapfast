import { Theme, Middle, Label } from "theme.slint";
import { ActionButton, Avatar, TextField, PictureStore } from "controls.slint";
import { Choices, Picker, SettingsCard, SettingsFrame, SettingsRow, SettingsTitle, SettingsHeading, SettingsSwitch, UnsavedBar } from "settings.slint";
import { AddMembersDialog, RoleConfirmDialog, RolesPrompt, RolesSection } from "roles.slint";
import { AuditLogPrompt, AuditLogSection, BanDialog, BansPrompt, BansSection, SafetyPrompt, SafetySection } from "moderation.slint";
import { InvitesPrompt, InvitesSection, MembersPrompt, MembersSection, SecurityActionsDialog } from "server_people.slint";
import { EmojiPrompt, EmojiSection, EmojiUploadDialog, StickerDialog, StickersPrompt, StickersSection } from "server_expressions.slint";
import { DeleteServerDialog, OwnershipPrompt, TransferOwnershipDialog } from "server_ownership.slint";

/// What Server Profile shows besides what's written in it.
export struct ServerProfilePrompt {
    /// The icon: Discord's by its address, or a new one's preview.
    icon-url: string,
    new-icon: image,
    has-icon: bool,
    initial: string,
    /// How many characters the description has left; below 0, too many.
    description-left: int,
}

/// What Engagement shows: each list's choices and the chosen one, and the
/// system messages' switches.
export struct EngagementPrompt {
    /// "No System Messages", then the server's text channels.
    system-channels: [string],
    system-channel: int,
    welcome: bool,
    welcome-sticker: bool,
    boosted: bool,
    setup-tips: bool,
    /// 0 all messages, 1 only @mentions.
    notifications: int,
    /// "No Inactive Channel", then the server's voice channels.
    afk-channels: [string],
    afk-channel: int,
    /// One of the timeouts, "1 minute" to "1 hour".
    afk-timeout: int,
}

/// A banner or invite background as Boost Perks shows it.
export struct BoostPicture {
    url: string,
    new: image,
    shown: bool,
    /// The server's boost level doesn't unlock it yet: "Unlocks at Level 2".
    locked: string,
}

/// What Boost Perks shows.
export struct BoostPrompt {
    /// "Level 1", or "No Level" before one.
    level: string,
    banner: BoostPicture,
    splash: BoostPicture,
    progress-bar: bool,
}

/// What a Discord server's settings show besides what's written in them.
export struct ServerSettingsPrompt {
    /// The sidebar: the server's name heading the pages this account may
    /// change, under Discord's groups.
    rows: [SettingsRow],
    /// The page showing: 0 Server Profile, 1 Engagement, 2 Boost Perks,
    /// 3 Roles, 4 Safety Setup, 5 Bans, 6 Audit Log, 7 Members, 8 Invites,
    /// 9 Emoji, 10 Stickers.
    section: int,
    /// The page saves each change as it's made, without the bar.
    immediate: bool,
    /// Discord sends the page; it's here; Discord takes the change.
    loading: bool,
    loaded: bool,
    saving: bool,
    error: string,
    /// Why the draft can't be saved as it is, as Discord's client says it.
    problem: string,
    /// The draft differs from what Discord has, and may be saved.
    changed: bool,
    may-save: bool,
    /// Goes up each time leaving is refused for unsaved changes.
    nudge: int,
    /// A picture chosen for the page is being read.
    reading: bool,
    profile: ServerProfilePrompt,
    engagement: EngagementPrompt,
    boost: BoostPrompt,
    roles: RolesPrompt,
    safety: SafetyPrompt,
    bans: BansPrompt,
    audit-log: AuditLogPrompt,
    members: MembersPrompt,
    invites: InvitesPrompt,
    emoji: EmojiPrompt,
    stickers: StickersPrompt,
    ownership: OwnershipPrompt,
}

// A text of a settings page, several lines high, with how many characters
// are left below it.
component SettingsArea inherits VerticalLayout {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <int> left;
    in property <bool> enabled: true;
    callback edited(string);
    spacing: 4px;
    Rectangle {
        height: 96px; border-radius: 6px; background: Theme.sunken;
        border-width: input.has-focus ? 1px : 0px; border-color: Theme.accent.with-alpha(0.8);
        Text {
            x: 10px; y: 8px; width: parent.width - 20px;
            visible: root.text == "";
            text: root.placeholder; color: Theme.muted; font-size: 14px;
            wrap: word-wrap; overflow: elide;
        }
        input := TextInput {
            x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
            text <=> root.text; enabled: root.enabled;
            single-line: false; wrap: word-wrap;
            font-size: 14px; color: Theme.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
        }
    }
    Text {
        horizontal-alignment: right;
        text: root.left < 0 ? @tr("Too long by {}", (-root.left)) : @tr("{} left", root.left);
        color: root.left < 0 ? Theme.danger : Theme.muted; font-size: 12px;
    }
}

// Server Profile: the server's name, icon and description, as Discord's page
// has them.
component ServerProfileSection inherits VerticalLayout {
    in property <ServerSettingsPrompt> prompt;
    in-out property <string> name;
    in-out property <string> description;
    callback write(int, string);
    callback pick-icon;
    callback remove-icon;
    property <bool> ready: !root.prompt.saving;
    spacing: 16px;
    SettingsTitle { text: @tr("Server Profile"); }
    Label { text: @tr("Customize how your server appears in invite links and, if enabled, in Server Discovery and Announcement Channel messages."); }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("NAME"); }
        TextField {
            text <=> root.name; label: @tr("Server name"); enabled: root.ready;
            edited(text) => { root.write(0, text); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("ICON"); }
        HorizontalLayout {
            spacing: 16px; alignment: start;
            Avatar {
                size: 80px; initial: root.prompt.profile.initial;
                picture-url: root.prompt.profile.icon-url; picture: root.prompt.profile.new-icon;
            }
            VerticalLayout {
                spacing: 8px; alignment: center;
                Label { text: root.prompt.reading ? @tr("Reading the picture...") : @tr("We recommend an image of at least 512x512."); }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    ActionButton {
                        text: @tr("Change Server Icon"); enabled: root.ready && !root.prompt.reading;
                        clicked => { root.pick-icon(); }
                    }
                    if root.prompt.profile.has-icon: ActionButton {
                        text: @tr("Remove Icon"); ghost: true; enabled: root.ready;
                        clicked => { root.remove-icon(); }
                    }
                }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("DESCRIPTION"); }
        SettingsArea {
            text <=> root.description; label: @tr("Description"); enabled: root.ready;
            placeholder: @tr("Tell people what your server is about.");
            left: root.prompt.profile.description-left;
            edited(text) => { root.write(1, text); }
        }
    }
}

// Engagement: where system messages go and which, how members who set nothing
// are notified, and where idle members move, as Discord's page has them.
component EngagementSection inherits VerticalLayout {
    in property <ServerSettingsPrompt> prompt;
    /// A switch flipped: 0 the welcome message, 1 its sticker reply, 2 the
    /// boost message, 3 setup tips.
    callback toggle(int);
    /// A list's choice: 0 the system channel, 1 notifications, 2 the
    /// inactive channel, 3 its timeout; by its index.
    callback choose(int, int);
    property <bool> ready: !root.prompt.saving;
    property <EngagementPrompt> page: root.prompt.engagement;
    property <bool> system: root.page.system-channel > 0;
    spacing: 16px;
    SettingsTitle { text: @tr("Engagement"); }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("SYSTEM MESSAGES CHANNEL"); }
        Label { text: @tr("This is the channel we send system event messages to. These can be turned off at any time."); }
        Picker {
            model: root.page.system-channels; chosen: root.page.system-channel; enabled: root.ready;
            accessible-label: @tr("System Messages Channel");
            selected => { root.choose(0, self.current-index); }
        }
    }
    SettingsSwitch {
        text: @tr("Send a random welcome message when someone joins this server.");
        checked: root.page.welcome; controlled: true; enabled: root.ready && root.system;
        toggled => { root.toggle(0); }
    }
    SettingsSwitch {
        text: @tr("Prompt members to reply to welcome messages with a sticker.");
        checked: root.page.welcome-sticker; controlled: true; enabled: root.ready && root.system;
        toggled => { root.toggle(1); }
    }
    SettingsSwitch {
        text: @tr("Send a message when someone boosts this server.");
        checked: root.page.boosted; controlled: true; enabled: root.ready && root.system;
        toggled => { root.toggle(2); }
    }
    SettingsSwitch {
        text: @tr("Send helpful tips for server setup.");
        checked: root.page.setup-tips; controlled: true; enabled: root.ready && root.system;
        toggled => { root.toggle(3); }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("DEFAULT NOTIFICATION SETTINGS"); }
        Label { text: @tr("This will determine whether members who have not explicitly set their notification settings receive a notification for every message sent in this server or not."); }
        Choices {
            label: @tr("Default Notification Settings"); options: [@tr("All Messages"), @tr("Only @mentions")];
            current: root.page.notifications; controlled: true;
            chosen(index) => { root.choose(1, index); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: @tr("INACTIVE CHANNEL"); }
        Label { text: @tr("Automatically move members to this channel and mute them when they have been idle for longer than the inactive timeout. This does not affect browsers."); }
        HorizontalLayout {
            spacing: 16px;
            Picker {
                horizontal-stretch: 2;
                model: root.page.afk-channels; chosen: root.page.afk-channel; enabled: root.ready;
                accessible-label: @tr("Inactive Channel");
                selected => { root.choose(2, self.current-index); }
            }
            Picker {
                horizontal-stretch: 1;
                model: [@tr("1 minute"), @tr("5 minutes"), @tr("15 minutes"), @tr("30 minutes"), @tr("1 hour")];
                chosen: root.page.afk-timeout; enabled: root.ready && root.page.afk-channel > 0;
                accessible-label: @tr("Inactive Timeout");
                selected => { root.choose(3, self.current-index); }
            }
        }
    }
}

// A banner or invite background on Boost Perks: the picture at 16 by 9, with
// Upload and Remove, or the level that unlocks it.
component BoostBackground inherits VerticalLayout {
    in property <string> heading;
    in property <string> text;
    in property <BoostPicture> picture;
    in property <bool> enabled;
    callback pick;
    callback remove;
    property <image> shown: root.picture.url != "" ? PictureStore.picture(root.picture.url, PictureStore.revision(root.picture.url)) : root.picture.new;
    init => { if root.picture.url != "" { PictureStore.request(root.picture.url); } }
    changed picture => { if root.picture.url != "" { PictureStore.request(root.picture.url); } }
    spacing: 8px;
    SettingsHeading { text: root.heading; }
    Label { text: root.text; }
    HorizontalLayout {
        spacing: 16px; alignment: start;
        Rectangle {
            width: 240px; height: 135px; border-radius: 8px; clip: true;
            background: Theme.sunken;
            if root.shown.width > 0: Image { width: parent.width; height: parent.height; source: root.shown; image-fit: cover; }
            if root.shown.width == 0: Text {
                text: root.picture.locked != "" ? root.picture.locked : @tr("No image");
                color: Theme.muted; font-size: 13px; font-weight: 600;
            }
        }
        VerticalLayout {
            spacing: 8px; alignment: center;
            ActionButton {
                text: @tr("Upload Background"); enabled: root.enabled && root.picture.locked == "";
                clicked => { root.pick(); }
            }
            if root.picture.shown: ActionButton {
                text: @tr("Remove Background"); ghost: true; enabled: root.enabled;
                clicked => { root.remove(); }
            }
        }
    }
}

// Boost Perks: the banner, the invite background and the progress bar, each at
// the level that unlocks it, as Discord's page has them.
component BoostSection inherits VerticalLayout {
    in property <ServerSettingsPrompt> prompt;
    /// 1 the banner, 2 the invite background.
    callback pick(int);
    callback remove(int);
    callback toggle-progress-bar;
    property <bool> ready: !root.prompt.saving && !root.prompt.reading;
    property <BoostPrompt> page: root.prompt.boost;
    spacing: 16px;
    HorizontalLayout {
        SettingsTitle { text: @tr("Boost Perks"); horizontal-stretch: 1; }
        Middle { Text { text: root.page.level; color: Theme.muted; font-size: 14px; font-weight: 700; } }
    }
    SettingsSwitch {
        text: @tr("Show Boost progress bar");
        description: @tr("This progress bar will display in your channel list, attached to your server name (or server banner if you have one set).");
        checked: root.page.progress-bar; controlled: true; enabled: !root.prompt.saving;
        toggled => { root.toggle-progress-bar(); }
    }
    BoostBackground {
        heading: @tr("SERVER BANNER BACKGROUND");
        text: @tr("The recommended minimum size is 960x540 and recommended aspect ratio is 16:9.");
        picture: root.page.banner; enabled: root.ready;
        pick => { root.pick(1); }
        remove => { root.remove(1); }
    }
    BoostBackground {
        heading: @tr("SERVER INVITE BACKGROUND");
        text: @tr("Servers who reach Boosting Level 1 and above get unique invite embeds with custom Server Invite Backgrounds. The recommended minimum size is 1920x1080 and recommended aspect ratio is 16:9.");
        picture: root.page.splash; enabled: root.ready;
        pick => { root.pick(2); }
        remove => { root.remove(2); }
    }
}

// A Discord server's settings, on a card over the window: the pages this account
// may change down the left, the chosen one on the right, and Discord's bar
// over its bottom once the page has unsaved changes. Leaving the page or the
// settings waits until they're reset or saved.
export component ServerSettingsScreen inherits Rectangle {
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    in property <ServerSettingsPrompt> prompt;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <string> role-name;
    callback choose(int);
    /// A text changed: 0 the name, 1 the description.
    callback write(int, string);
    /// A switch flipped: Engagement's by number, 4 Boost Perks' progress bar.
    callback toggle(int);
    /// A list's choice, by list and index; see EngagementSection.
    callback pick-choice(int, int);
    /// Choose or remove a picture: 0 the icon, 1 the banner, 2 the invite
    /// background, 3 a role's icon, 4 a new emoji, 5 a new sticker.
    callback pick-picture(int);
    callback remove-picture(int);
    callback undo;
    callback save;
    callback close;
    /// Something done on Roles: what, a text such as a role's id, and a
    /// number; see RolesSection.
    callback role(int, string, int);
    /// Something done on Bans: what, a text such as a user's id, and a
    /// number; see BansSection, then 4 close the ban shown, 5 lift it.
    callback ban(int, string, int);
    /// Something done on Audit Log: what, and a number; see
    /// AuditLogSection.
    callback audit-log(int, int);
    /// Something done on Members or Invites: what, a text such as a user's
    /// id or an invite's code, and a number; see MembersSection,
    /// InvitesSection and SecurityActionsDialog.
    callback member(int, string, int);
    callback invite(int, string, int);
    /// Something done on Emoji or Stickers: what, and texts such as an
    /// emoji's id and name; see EmojiSection, EmojiUploadDialog,
    /// StickersSection and StickerDialog.
    callback emoji(int, string, string);
    callback sticker(int, string);
    /// Something done in Delete Server's or Transfer Ownership's dialog;
    /// see DeleteServerDialog and TransferOwnershipDialog. Delete Server
    /// in the sidebar is 99.
    callback ownership(int, string);
    /// A member's menu, by id, at a point of the window.
    callback member-menu(string, length, length);
    property <bool> bar: (root.prompt.changed || root.prompt.saving) && !root.prompt.immediate;
    // A ban's dialog closes itself once Discord lifts the ban: the keys go
    // back to the frame, for Escape.
    property <bool> ban-open: root.prompt.bans.open;
    changed ban-open => { if !self.ban-open { frame.focus-keys(); } }
    // So do the emoji, sticker and ownership dialogs, once closed or
    // Discord takes what they send.
    property <bool> dialog-open: root.prompt.emoji.uploading || root.prompt.stickers.form || root.prompt.ownership.kind != 0;
    changed dialog-open => { if !self.dialog-open { frame.focus-keys(); } }
    SettingsCard {
        motion: root.motion;
        close => { root.close(); }
        frame := SettingsFrame {
            rows: root.prompt.rows; selected: root.prompt.section; label: @tr("Server settings");
            bottom: root.bar ? 140px : 56px;
            // A role's permissions are a list view.
            fill: root.prompt.loaded && ((root.prompt.section == 3 && root.prompt.roles.open && root.prompt.roles.tab == 1) || root.prompt.section == 5 || root.prompt.section == 6 || root.prompt.section == 7 || root.prompt.section == 8 || root.prompt.section == 9);
            chose(id) => { root.choose(id); }
            close => { root.close(); }
            if root.prompt.loading: Label { text: @tr("Loading..."); }
            if root.prompt.loaded && root.prompt.section == 0: ServerProfileSection {
                prompt: root.prompt; name <=> root.name; description <=> root.description;
                write(field, text) => { root.write(field, text); }
                pick-icon => { root.pick-picture(0); }
                remove-icon => { root.remove-picture(0); }
            }
            if root.prompt.loaded && root.prompt.section == 1: EngagementSection {
                prompt: root.prompt;
                toggle(which) => { root.toggle(which); }
                choose(list, index) => { root.pick-choice(list, index); }
            }
            if root.prompt.loaded && root.prompt.section == 2: BoostSection {
                prompt: root.prompt;
                pick(kind) => { root.pick-picture(kind); }
                remove(kind) => { root.remove-picture(kind); }
                toggle-progress-bar => { root.toggle(4); }
            }
            if root.prompt.loaded && root.prompt.section == 3: RolesSection {
                page: root.prompt.roles; saving: root.prompt.saving; reading: root.prompt.reading;
                name <=> root.role-name;
                write(field, text) => { root.role(field, text, 0); }
                open(id) => { root.role(10, id, 0); }
                tab(tab) => { root.role(11, "", tab); }
                color(index) => { root.role(12, "", index); }
                toggle(which) => { root.role(13, "", which); }
                permission(bit) => { root.role(14, "", bit); }
                move(id, to) => { root.role(15, id, to); }
                act(what, id) => { root.role(20 + what, id, 0); }
                pick-icon => { root.pick-picture(3); }
                remove-icon => { root.remove-picture(3); }
            }
            if root.prompt.loaded && root.prompt.section == 4: SafetySection {
                page: root.prompt.safety; saving: root.prompt.saving;
                // Verification, filter and two-factor are lists 10 to 12.
                choose(what, value) => { root.pick-choice(10 + what, value); }
            }
            if root.prompt.loaded && root.prompt.section == 5: BansSection {
                page: root.prompt.bans;
                act(what, text, number) => { root.ban(what, text, number); }
            }
            if root.prompt.loaded && root.prompt.section == 6: AuditLogSection {
                page: root.prompt.audit-log;
                act(what, number) => { root.audit-log(what, number); }
            }
            if root.prompt.loaded && root.prompt.section == 7: MembersSection {
                page: root.prompt.members;
                act(what, text, number) => { root.member(what, text, number); }
                menu(id, x, y) => { root.member-menu(id, x, y); }
            }
            if root.prompt.loaded && root.prompt.section == 8: InvitesSection {
                page: root.prompt.invites;
                act(what, text, number) => { root.invite(what, text, number); }
            }
            if root.prompt.loaded && root.prompt.section == 9: EmojiSection {
                page: root.prompt.emoji;
                act(what, id, name) => { root.emoji(what, id, name); }
                upload => { root.pick-picture(4); }
            }
            if root.prompt.loaded && root.prompt.section == 10: StickersSection {
                page: root.prompt.stickers;
                act(what, id) => { root.sticker(what, id); }
            }
            if root.prompt.problem != "": Text { text: root.prompt.problem; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
            if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        }
        if root.bar: UnsavedBar {
            x: frame.content-x + 24px; width: min(700px, frame.content-width - 48px);
            y: frame.height - self.height - 24px;
            border-radius: 8px; drop-shadow-blur: 16px; drop-shadow-color: #00000066; drop-shadow-offset-y: 4px;
            saving: root.prompt.saving; may-save: root.prompt.may-save; nudge: root.prompt.nudge;
            // The fields go still while Discord takes the change, so Escape
            // goes to the frame.
            undo => { frame.focus-keys(); root.undo(); }
            save => { frame.focus-keys(); root.save(); }
        }
    }
    if root.prompt.section == 3 && root.prompt.roles.confirm != 0: RoleConfirmDialog {
        page: root.prompt.roles;
        confirm => { root.role(24, "", 0); frame.focus-keys(); }
        cancel => { root.role(25, "", 0); frame.focus-keys(); }
    }
    if root.prompt.section == 5 && root.prompt.bans.open: BanDialog {
        page: root.prompt.bans;
        unban => { root.ban(5, "", 0); }
        close => { root.ban(4, "", 0); frame.focus-keys(); }
    }
    if root.prompt.section == 8 && root.prompt.invites.security: SecurityActionsDialog {
        page: root.prompt.invites;
        act(what, number) => {
            root.invite(what, "", number);
            if what == 7 { frame.focus-keys(); }
        }
    }
    if root.prompt.section == 9 && root.prompt.emoji.uploading: EmojiUploadDialog {
        page: root.prompt.emoji;
        act(what, text) => { root.emoji(what, "", text); }
    }
    if root.prompt.section == 10 && root.prompt.stickers.form: StickerDialog {
        page: root.prompt.stickers;
        act(what, text) => { root.sticker(what, text); }
        browse => { root.pick-picture(5); }
    }
    if root.prompt.ownership.kind == 1: DeleteServerDialog {
        page: root.prompt.ownership;
        act(what, text) => { root.ownership(what, text); }
    }
    if root.prompt.ownership.kind == 2: TransferOwnershipDialog {
        page: root.prompt.ownership;
        act(what, text) => { root.ownership(what, text); }
    }
    if root.prompt.section == 3 && root.prompt.roles.adding: AddMembersDialog {
        page: root.prompt.roles; role-name: root.role-name;
        search(text) => { root.role(4, text, 0); }
        pick(id) => { root.role(27, id, 0); }
        add => { root.role(28, "", 0); frame.focus-keys(); }
        close => { root.role(29, "", 0); frame.focus-keys(); }
    }
}
