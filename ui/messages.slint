import { ClientStyle } from "yapfast/style.slint";
import { ListView } from "scrollview.slint";
import { Theme, Tip, ReactionHover, Middle, Label } from "theme.slint";
import { ActionButton, IconButton, Avatar, Picture, PictureStore, EmojiAnimations, Skeleton, SpoilerCover, MenuItem, TextField, ContextMenu, MenuRow, StyledName, NameStyleRow, ServerTagChip } from "controls.slint";
import { FavoriteStar, GifFavorites } from "gifs.slint";

/// An emoji: what shows, its name, and the reaction it adds, which for a custom
/// emoji is Discord's `name:id`. A custom emoji shows its `picture` once it has
/// arrived; until then its glyph is its name.
/// An emoji as a button, tooltip or grid cell shows it. `usable` is false for a
/// custom emoji this account may not use where it is looking, which the picker
/// shows greyed with a lock, as Discord's does.
export struct EmojiCell { glyph: string, name: string, key: string, picture: image, usable: bool }
/// A heading, or up to a row's worth of emoji, in the emoji picker.
export struct EmojiRow { heading: string, cells: [EmojiCell] }
/// A place the emoji picker's sidebar jumps to: the row of its heading, and the
/// row after its last. Its icon is named by the heading.
export struct EmojiSection { icon: EmojiCell, row: int, end: int }

// An emoji at `side`: its picture, its glyph, or, for a custom emoji whose
// picture hasn't arrived, a quiet square in its place. One whose animation
// plays here draws that animation's frame in its picture's place.
export component EmojiFace inherits Rectangle {
    in property <EmojiCell> emoji;
    in property <string> font;
    in property <length> side: 20px;
    /// The key its animation is registered under, when it plays here: the
    /// picker's grid animates its cells, a tooltip or a status emoji does
    /// not, and stays still. "" draws no frame at all.
    in property <string> animation-key;
    // Its frame while the animation plays, as `Avatar` reads `PictureStore`,
    // so the tick that moves the clock draws this face again; empty until
    // then, or for a still emoji.
    property <image> animation-frame: root.animation-key == "" ? @image-url("") : EmojiAnimations.frame(root.animation-key, EmojiAnimations.revision);
    // The frame once it is there, else the still it shows until then.
    property <image> shown-picture: root.animation-frame.width > 0 ? root.animation-frame : root.emoji.picture;
    if root.shown-picture.width > 0: Image {
        source: root.shown-picture; width: root.side; height: root.side; image-fit: contain;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    if root.shown-picture.width == 0 && root.emoji.glyph != root.emoji.name: Text {
        text: root.emoji.glyph; font-family: root.font; font-size: root.side;
        // An emoji font's line box is taller than its size, so the text needs
        // more room than the glyph takes: at the size itself, Skia cut the top
        // and bottom off the system's emoji, and some fonts' glyphs wholly.
        width: parent.width; height: root.side * 1.5; y: (parent.height - self.height) / 2;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.shown-picture.width == 0 && root.emoji.glyph == root.emoji.name: Rectangle {
        width: root.side * 0.8; height: root.side * 0.8; border-radius: root.side * 0.2;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: Theme.overlay.with-alpha(0.07);
    }
}

// An emoji to react with, named by a tooltip unless it reports hovering instead.
export component EmojiButton inherits Rectangle {
    in property <EmojiCell> emoji;
    in property <string> font;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> fill: transparent;
    in property <bool> tip: true;
    /// Whether this account may use the emoji here. One it may not shows
    /// greyed, with a lock over its corner, and clicking it offers Nitro.
    in property <bool> usable: true;
    /// What clicking does with the emoji, for screen readers.
    in property <string> verb: "React with";
    /// The key its animation is registered under, when it plays here; "" for
    /// a button that stays still.
    in property <string> animation-key;
    callback clicked;
    callback hovered;
    /// A locked emoji was pressed.
    callback locked;
    width: root.size; height: root.size;
    border-radius: 6px;
    background: pointer.has-hover ? Theme.overlay.with-alpha(0.12) : root.fill;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.usable ? root.verb + " " + root.emoji.name : "Locked, Nitro only: " + root.emoji.name;
    opacity: root.usable ? 1 : 0.4;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    EmojiFace { emoji: root.emoji; font: root.font; side: root.glyph; animation-key: root.animation-key; }
    if !root.usable: Image {
        source: @image-url("icons/lock.svg"); width: 14px; height: 14px;
        x: root.width - self.width - 4px; y: root.height - self.height - 4px;
        colorize: Theme.text;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                Tip.text = "";
                if root.usable { root.clicked(); } else { root.locked(); }
            }
            changed has-hover => {
                if self.has-hover {
                    root.hovered();
                    if root.tip {
                        Tip.text = root.emoji.name;
                        Tip.side = 0;
                        Tip.x = root.absolute-position.x + root.width / 2;
                        Tip.y = root.absolute-position.y;
                    }
                } else if Tip.text == root.emoji.name {
                    Tip.text = "";
                }
            }
        }
    }
}

// A reaction under a message: the emoji in a color emoji font, then the count.
// Staying on it shows who reacted, as ReactionHover says.
export component ReactionToggle inherits Rectangle {
    /// The message's item, which a tooltip of who reacted needs.
    in property <string> item;
    in property <string> key;
    in property <string> label: root.key;
    in property <int> count;
    in property <bool> mine;
    in property <bool> enabled;
    in property <string> emoji-font;
    callback clicked;
    min-width: chip.preferred-width; height: 28px; border-radius: 8px;
    background: root.mine ? Theme.accent-soft : Theme.raised;
    border-width: 1px;
    border-color: root.mine ? Theme.accent.with-alpha(0.7) : pointer.has-hover && root.enabled ? Theme.overlay.with-alpha(0.15) : transparent;
    accessible-role: button;
    accessible-label: root.key + ", " + root.count + (root.mine ? ", including you. Remove your reaction" : ". Add this reaction");
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    chip := HorizontalLayout {
        padding-left: 8px; padding-right: 9px; spacing: 6px;
        Text { text: root.label; font-family: root.emoji-font; font-size: 16px; vertical-alignment: center; }
        Text { text: root.count; color: root.mine ? Theme.accent : Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    }
    property <bool> tip-shown: root.item != "" && ReactionHover.item == root.item && ReactionHover.key == root.key;
    pointer := TouchArea {
        enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => { if root.tip-shown { ReactionHover.on-chip = self.has-hover; } }
    }
    // Discord's client waits half a second before it shows who reacted.
    Timer {
        interval: 500ms;
        running: pointer.has-hover && root.item != "" && !root.tip-shown;
        triggered => {
            ReactionHover.item = root.item;
            ReactionHover.key = root.key;
            ReactionHover.x = root.absolute-position.x + root.width / 2;
            ReactionHover.y = root.absolute-position.y;
            ReactionHover.on-chip = true;
            ReactionHover.on-tip = false;
        }
    }
}

/// A reaction: `key` names it, and `label` shows it, with a custom emoji's glyph once it has one.
export struct ReactionChip { key: string, label: string, count: int, mine: bool }
/// An image in a message's gallery, placed in pixels; `index` is its place
/// among the message's attachments. A spoiler's picture shows blurred, under a
/// SPOILER label, until clicked.
/// An animation's `frames` show in turn, each for its `delays` in milliseconds.
export struct ImageCell {
    index: int, name: string, image: image, x: int, y: int, width: int, height: int, spoiler: bool,
    frames: [image], delays: [int],
    /// On its way: a skeleton shows in its place, at the size it will take.
    loading: bool,
    /// A video, whose poster the picture is: it plays in place.
    video: bool,
    /// A GIF's page, by which it's kept among the favourites; empty for any
    /// other picture.
    gif: string,
}

// The video playing. The cell showing it binds to this, so its pictures
// come without the timeline's rows changing.
export global VideoPlayer {
    in property <string> item;
    in property <int> index: -1;
    in property <image> frame;
    in property <bool> has-frame;
    in property <bool> loading;
    in property <bool> playing;
    in property <bool> ended;
    in property <bool> sound;
    in property <bool> muted;
    /// How loud it plays unmuted, from 0 to 1 as the volume slider stands.
    in property <float> volume: 1;
    /// How far in, from 0 to 1, and as text, such as "0:12 / 1:30".
    in property <float> progress;
    in property <string> time;
    in property <string> error;
    /// Its attachment's name, its pictures' full size in pixels, and how
    /// long it plays, in milliseconds; 0 until known.
    in property <string> name;
    in property <int> video-width;
    in property <int> video-height;
    in property <int> duration;
    /// It shows large over everything, in VideoViewer.
    in property <bool> expanded;
    /// Plays an item's attachment in a cell of this size.
    callback play(string, int, length, length);
    /// Shows it large, or back in its cell.
    callback expand(bool);
    /// The viewer shows it at this size.
    callback resize(length, length);
    /// Plays or pauses the video playing.
    callback toggle();
    callback seek(float);
    callback mute(bool);
    /// Sets how loud it plays, unmuting it; 0 mutes it.
    callback change-volume(float);
}

// A playing video's controls: play or pause, its time, a bar to move
// through it, mute, and full screen. A narrow video, such as one filmed
// upright, leaves out the time and then mute, so full screen stays in it.
component VideoControls inherits Rectangle {
    // Play, full screen, the padding and their spacing; the bar keeps 32px.
    property <length> fixed: 4px + 28px + 6px + 32px + 6px + 28px + 6px;
    property <bool> show-mute: VideoPlayer.sound && root.width >= root.fixed + 34px;
    property <bool> show-time: root.width >= root.fixed + (root.show-mute ? 34px : 0px) + clock.preferred-width + 6px;
    clock := Text { visible: false; text: VideoPlayer.time; font-size: 12px; }
    HorizontalLayout {
        padding-left: 4px; padding-right: 6px; spacing: 6px;
        Middle {
            IconButton {
                size: 28px; glyph: 16px; tint: #ffffff; tip-side: 0;
                icon: VideoPlayer.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                label: VideoPlayer.playing ? "Pause" : "Play";
                clicked => { VideoPlayer.toggle(); }
            }
        }
        if root.show-time: Text { text: VideoPlayer.time; color: #ffffff; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            accessible-role: slider;
            accessible-label: "Position";
            accessible-value: round(VideoPlayer.progress * 100) + "%";
            Rectangle {
                height: 4px; border-radius: 2px; background: #ffffff4d;
                Rectangle { x: 0; width: parent.width * clamp(VideoPlayer.progress, 0, 1); border-radius: 2px; background: #ffffff; }
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { VideoPlayer.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                moved => { if self.pressed { VideoPlayer.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
            }
        }
        // Mute, with a slider over it for how loud, while the pointer is on
        // either; the wheel turns it too.
        if root.show-mute: Rectangle {
            width: 28px;
            sound := TouchArea {
                property <bool> open: self.has-hover || level.pressed;
                property <length> rise: 112px;
                property <float> shown: level.pressed ? level.dragged : VideoPlayer.muted ? 0 : VideoPlayer.volume;
                y: (parent.height - 28px) / 2 - (self.open ? self.rise : 0px);
                height: 28px + (self.open ? self.rise : 0px);
                scroll-event(event) => {
                    if event.delta-y == 0 { return reject; }
                    VideoPlayer.change-volume(clamp(self.shown + (event.delta-y > 0 ? 0.05 : -0.05), 0, 1));
                    return accept;
                }
                Rectangle {
                    y: 0; width: 28px; height: sound.rise - 4px;
                    visible: sound.open;
                    border-radius: 6px; background: #000000cc;
                    accessible-role: slider;
                    accessible-label: "Volume";
                    accessible-value: round(sound.shown * 100) + "%";
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 100;
                    accessible-action-set-value(value) => { VideoPlayer.change-volume(clamp(value.to-float() / 100, 0, 1)); }
                    track := Rectangle {
                        x: (parent.width - self.width) / 2; y: 14px; width: 4px; height: parent.height - 28px;
                        border-radius: 2px; background: #ffffff4d;
                        Rectangle {
                            y: parent.height * (1 - sound.shown); height: parent.height * sound.shown;
                            border-radius: 2px; background: #ffffff;
                        }
                        Rectangle {
                            width: 12px; height: 12px; border-radius: 6px; background: #ffffff;
                            x: (parent.width - self.width) / 2; y: parent.height * (1 - sound.shown) - self.height / 2;
                        }
                    }
                    level := TouchArea {
                        enabled: sound.open;
                        mouse-cursor: MouseCursor.pointer;
                        property <float> dragged;
                        property <float> at: clamp(1 - (self.mouse-y - track.y) / track.height, 0, 1);
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                self.dragged = self.at;
                                VideoPlayer.change-volume(self.at);
                            }
                        }
                        moved => {
                            if self.pressed {
                                self.dragged = self.at;
                                VideoPlayer.change-volume(self.at);
                            }
                        }
                    }
                }
                IconButton {
                    y: parent.height - 28px; height: 28px;
                    size: 28px; glyph: 16px; tint: #ffffff; tip-side: 2;
                    icon: VideoPlayer.muted ? @image-url("icons/volume-x.svg") : @image-url("icons/volume-2.svg");
                    label: VideoPlayer.muted ? "Unmute" : "Mute";
                    clicked => { VideoPlayer.mute(!VideoPlayer.muted); }
                }
            }
        }
        Middle {
            IconButton {
                size: 28px; glyph: 16px; tint: #ffffff; tip-side: 0;
                icon: VideoPlayer.expanded ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                label: VideoPlayer.expanded ? "Exit full screen" : "Full screen";
                clicked => { VideoPlayer.expand(!VideoPlayer.expanded); }
            }
        }
    }
}

// A video in a gallery: its poster with a play button, then the video with
// its controls, which show while the pointer is over it or it's paused.
component VideoCell inherits Rectangle {
    in property <string> item;
    in property <ImageCell> cell;
    /// A right click, at this place in the window.
    callback menu(length, length);
    property <bool> active: VideoPlayer.item == root.item && VideoPlayer.index == root.cell.index;
    property <bool> failed: root.active && VideoPlayer.error != "";
    accessible-role: button;
    accessible-label: (root.active && VideoPlayer.playing ? "Pause " : "Play ") + root.cell.name;
    accessible-action-default => { pointer.clicked(); }
    if root.active && VideoPlayer.has-frame: Rectangle {
        background: #000000;
        Image { width: parent.width; height: parent.height; source: VideoPlayer.frame; image-fit: contain; }
    }
    // The bar is inside the cell's area, so the pointer on its controls is
    // still over the cell and the bar stays.
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if root.active && !root.failed { VideoPlayer.toggle(); } else { VideoPlayer.play(root.item, root.cell.index, root.width, root.height); }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        if root.active && !root.failed && !VideoPlayer.loading && (pointer.has-hover || !VideoPlayer.playing): Rectangle {
            y: parent.height - self.height; height: 36px;
            background: @linear-gradient(0deg, #000000cc 0%, #00000000 100%);
            // Between the controls, a click leaves the video be.
            TouchArea { mouse-cursor: MouseCursor.default; }
            VideoControls { }
        }
    }
    if !root.active || root.failed || (VideoPlayer.ended && !pointer.has-hover): Rectangle {
        width: 48px; height: 48px; border-radius: 24px; background: #000000b3;
        Path {
            width: 18px; height: 20px; x: 17px; y: 14px;
            commands: "M 0 0 L 18 10 L 0 20 Z"; fill: #ffffff;
        }
    }
    if root.active && VideoPlayer.loading && !root.failed: Rectangle {
        width: loading.preferred-width + 20px; height: 28px; border-radius: 14px; background: #000000b3;
        loading := Text { text: "Loading..."; color: #ffffff; font-size: 13px; }
    }
    if root.failed: Rectangle {
        y: parent.height - self.height - 8px; width: min(parent.width - 16px, problem.preferred-width + 20px); height: 28px;
        border-radius: 6px; background: #000000cc;
        problem := Text { text: VideoPlayer.error; color: #ffffff; font-size: 13px; overflow: elide; }
    }
}

/// A file, or an image without a preview, as a card.
export struct FileCell { index: int, name: string, detail: string }
/// A block of a message's or card's text, as Discord's client lays them
/// out: Markdown (0), a heading (1 to 3), subtext (4) or fenced code (5).
/// Slint's Markdown draws none but the first. A `quoted` block is behind a
/// quote's bar, whose ends are rounded at the blocks that start and end it.
/// `margin` is the space above it, outside any bar, and `padding` the space
/// above it inside one.
export struct TextBlock {
    text: styled-text, level: int,
    quoted: bool, quote-start: bool, quote-end: bool,
    margin: length, padding: length,
}
/// An embed's field, and a row of them: inline fields share a row. A value
/// with headings, quotes or code is in `value-blocks`.
export struct EmbedField { name: styled-text, value: styled-text, value-blocks: [TextBlock] }
export struct EmbedFieldRow { fields: [EmbedField] }
/// A Discord link preview or bot card. `title` links to the page when
/// there's one. A video's pictures are its poster, which opens `url`.
export struct EmbedCard {
    color: color, has-color: bool,
    provider: styled-text, has-provider: bool, author: styled-text, has-author: bool, title: styled-text, has-title: bool, url: string,
    /// A description with headings, quotes or code is in `description-blocks`.
    description: styled-text, has-description: bool, description-blocks: [TextBlock],
    field-rows: [EmbedFieldRow],
    footer: styled-text, has-footer: bool,
    /// The small picture beside the text; `thumbnail-index` is its place among the message's attachments.
    thumbnail: image, thumbnail-index: int, has-thumbnail: bool, thumbnail-loading: bool,
    images: [ImageCell], gallery-width: int, gallery-height: int,
    video: bool,
}
/// A Discord app's button. Only a link's is `enabled`: the others would ask
/// the app, which Yapfast can't yet.
export enum CardButtonStyle { primary, secondary, success, danger, link }
export struct CardButton { label: string, style: CardButtonStyle, url: string, enabled: bool }
export enum CardRowKind { text, media, separator, buttons, select, unknown }
/// A row of a Discord app's card, of one `kind`, with the fields it uses:
/// text and what a section shows beside it; pictures in a gallery and file
/// cards; a gap, `large`, with or without a `divider`; buttons; or a menu
/// by what it shows, which doesn't open; or a note that Yapfast can't show
/// some components.
export struct CardRow {
    kind: CardRowKind,
    blocks: [TextBlock],
    thumbnail: image, thumbnail-index: int, has-thumbnail: bool, thumbnail-loading: bool, thumbnail-spoiler: bool,
    button: CardButton, has-button: bool,
    images: [ImageCell], gallery-width: int, gallery-height: int, files: [FileCell],
    divider: bool, large: bool,
    buttons: [CardButton],
    select: string,
}
/// A container of a Discord message's components, framed with a bar of its
/// colour, or the components outside one.
export struct ComponentCard { framed: bool, color: color, has-color: bool, rows: [CardRow] }
/// What a poll card's button does.
export enum PollAction { none, vote, remove-vote, back-to-vote }

/// One answer of a poll as its card shows it.
export struct PollAnswerRow {
    id: int, text: string, emoji: string,
    /// Picked to vote for; with the results showing, voted for by this account.
    picked: bool,
    /// Its votes, as "3 votes", and its share of all of them, for the results.
    votes: string, percent: int,
    /// No answer has more votes.
    leading: bool,
}

/// A Discord poll on its message.
export struct PollCard {
    question: string,
    /// "Select one answer", while it takes votes.
    prompt: string,
    multiselect: bool,
    answers: [PollAnswerRow],
    /// Each answer's votes show: this account voted, the poll closed, or
    /// "Show results" was clicked. Clicking an answer then shows who voted.
    results: bool,
    /// Clicking an answer picks it.
    can-pick: bool,
    /// "5 votes", then "3h left" or "Poll closed".
    total: string, left: string,
    action: PollAction, action-enabled: bool,
    can-show-results: bool,
    /// This account may close it now: it's the author's.
    can-end: bool,
    /// It can be voted in here, rather than shown in a pinned message or a
    /// search result, whose clicks go to their card.
    interactive: bool,
}

/// What messages' poll cards do; `src/ui/polls.rs` answers.
export global Polls {
    /// The poll whose closing is being made sure of, by item.
    in property <string> confirm-end;
    /// Picks an answer, by the message's item and the answer's id, or
    /// unpicks it.
    callback pick(string, int);
    callback act(string, PollAction);
    callback show-results(string);
    /// Who voted for an answer, by id, or with -1 for the first.
    callback voters(string, int);
    callback ask-end(string);
    callback end();
    callback cancel-end();
}

// A Discord poll, as Discord's client shows it: the question and its answers
// to pick, and once this account voted, the poll closed or "Show results" was
// clicked, each answer's share of the votes.
export component PollView inherits HorizontalLayout {
    in property <PollCard> poll;
    in property <string> item;
    in property <string> emoji-font;
    padding-top: 4px;
    Rectangle {
        max-width: 480px; horizontal-stretch: 100;
        background: Theme.sidebar; border-radius: 8px; border-width: 1px; border-color: Theme.line;
        accessible-role: groupbox;
        accessible-label: "Poll: " + root.poll.question;
        VerticalLayout {
            padding: 16px; spacing: 8px;
            Text { text: root.poll.question; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
            if root.poll.prompt != "": Text { text: root.poll.prompt; color: Theme.muted; font-size: 13px; }
            for answer in root.poll.answers: Rectangle {
                property <bool> clickable: root.poll.interactive && (root.poll.results || root.poll.can-pick);
                // From the text as wrapped, which a scrolling list would otherwise squeeze.
                min-height: max(44px, answer-text.preferred-height + 16px); border-radius: 8px; clip: true;
                background: answer-touch.has-hover && self.clickable ? Theme.active : Theme.raised;
                animate background { duration: Theme.quick; }
                border-width: answer.picked ? 2px : 0px; border-color: Theme.accent;
                accessible-role: button;
                accessible-label: answer.text + (root.poll.results ? ", " + answer.votes + ", " + answer.percent + "%" : "");
                accessible-checked: answer.picked;
                accessible-enabled: self.clickable;
                accessible-action-default => { answer-touch.clicked(); }
                if root.poll.results: Rectangle {
                    x: 0px; width: parent.width * answer.percent / 100;
                    background: answer.leading ? Theme.accent-soft : Theme.overlay.with-alpha(0.06);
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
                    if answer.emoji != "": Text { text: answer.emoji; font-family: root.emoji-font; font-size: 20px; vertical-alignment: center; }
                    answer-text := Text { text: answer.text; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                    if root.poll.results && answer.picked: Middle {
                        Image { source: @image-url("icons/check.svg"); width: 16px; height: 16px; colorize: Theme.accent; accessible-label: "You voted for this answer"; }
                    }
                    if root.poll.results: Text { text: answer.votes; color: Theme.secondary; font-size: 13px; vertical-alignment: center; }
                    if root.poll.results: Text { text: answer.percent + "%"; color: Theme.text; font-size: 15px; font-weight: 700; min-width: 44px; horizontal-alignment: right; vertical-alignment: center; }
                    // A radio button, or for several answers a checkbox.
                    if !root.poll.results: Middle {
                        Rectangle {
                            width: 20px; height: 20px; border-radius: root.poll.multiselect ? 5px : 10px;
                            border-width: answer.picked ? 0px : 2px; border-color: Theme.muted;
                            background: answer.picked ? Theme.accent : transparent;
                            if answer.picked && root.poll.multiselect: Image { source: @image-url("icons/check.svg"); width: 14px; height: 14px; colorize: Theme.on-accent; }
                            if answer.picked && !root.poll.multiselect: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.on-accent; }
                        }
                    }
                }
                answer-touch := TouchArea {
                    enabled: parent.clickable;
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        if root.poll.results { Polls.voters(root.item, answer.id); } else { Polls.pick(root.item, answer.id); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px; padding-top: 4px;
                // The votes so far, which show who voted once the results do.
                Text {
                    text: root.poll.total; font-size: 14px; vertical-alignment: center;
                    color: total-touch.has-hover ? Theme.text : Theme.secondary;
                    accessible-role: button;
                    accessible-enabled: root.poll.interactive && root.poll.results;
                    accessible-action-default => { if self.accessible-enabled { Polls.voters(root.item, -1); } }
                    total-touch := TouchArea {
                        enabled: root.poll.interactive && root.poll.results;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { Polls.voters(root.item, -1); }
                    }
                }
                if root.poll.left != "": Text { text: "\u{00b7}  " + root.poll.left; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if root.poll.can-show-results: ActionButton {
                    text: "Show results"; ghost: true; small: true;
                    clicked => { Polls.show-results(root.item); }
                }
                if root.poll.action != PollAction.none: ActionButton {
                    text: root.poll.action == PollAction.vote ? "Vote" : root.poll.action == PollAction.remove-vote ? "Remove Vote" : "Go back to vote";
                    primary: root.poll.action == PollAction.vote; small: true;
                    enabled: root.poll.action-enabled;
                    clicked => { Polls.act(root.item, root.poll.action); }
                }
            }
            // Closing it before its time, once made sure of from the message's menu.
            if root.poll.interactive && Polls.confirm-end == root.item: VerticalLayout {
                spacing: 8px; padding-top: 4px;
                Rectangle { height: 1px; background: Theme.line; }
                Text { text: "End the poll now? This will close it immediately and reveal the results."; color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { Polls.cancel-end(); } }
                    ActionButton { text: "End Poll Now"; danger: true; small: true; clicked => { Polls.end(); } }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

export struct MessageRow {
    id: string, item: string, author: string, initial: string, tint: color, picture: image, body: string, time: string, short-time: string, own: bool,
    picture-url: string, reply-picture-url: string,
    /// The address of the decoration around the author's avatar.
    decoration-url: string,
    /// How the author's name is drawn.
    name-style: [NameStyleRow],
    /// Who wrote it, for their menu: a Discord user id or Matrix ID; empty
    /// for a blocked user.
    sender: string,
    /// The author's Discord role colour, when they have one.
    color: color, has-color: bool,
    /// The author is a Discord bot or webhook: tagged after their name.
    bot: bool,
    /// The server tag the author wears by their name, and its badge's address.
    tag: string, tag-badge: string,
    /// Starts a group: shows the avatar and author. Later messages from the same person follow compactly.
    first: bool,
    /// A date divider above this message, when it starts a new day.
    day: string,
    /// The first message that was unread when the conversation was opened:
    /// the "New" divider goes above it.
    unread-start: bool,
    /// Calls on this account: it mentions it or a group it's in, or, while
    /// it's new, replies to its message. The row is tinted marigold with a
    /// marigold edge.
    highlighted: bool,
    /// The body, and the author and time as selectable text: a selection runs across messages
    /// through all three. A body of nothing but emoji shows them large.
    jumbo: bool,
    styled: styled-text, author-styled: styled-text, time-styled: styled-text, edited: bool, deleted: bool,
    /// A notice in place of a message, such as Discord's that someone pinned
    /// one, by the icon it shows in place of the avatar: "pin", "join",
    /// "thread", "call" or "poll"; empty for a message. Its text has its
    /// author's name and time.
    notice: string,
    /// Forwarded on Discord: the body, files and embeds are the original's.
    forwarded: bool,
    reply-author: string, reply-body: string, reply-initial: string, reply-tint: color, reply-color: color, reply-has-color: bool, reply-picture: image, has-reply: bool,
    /// The original message's item; clicking the reply jumps to it.
    reply-item: string,
    reactions: [ReactionChip],
    /// Images with previews, laid out in a gallery of this size; other
    /// attachments show as file cards.
    images: [ImageCell], gallery-width: int, gallery-height: int,
    /// Discord stickers, drawn on their own at their size.
    stickers: [ImageCell],
    files: [FileCell],
    embeds: [EmbedCard],
    /// A Discord app's buttons and menus, or a message made of components.
    cards: [ComponentCard],
    /// The body in blocks, when it has headings, subtext, quotes or code;
    /// otherwise empty, and the body is `styled`.
    blocks: [TextBlock],
    /// Says a card is hidden, for a message that is only one, with link previews off.
    hidden-card: string,
    delivery: string, delivery-failed: bool, can-retry: bool, can-cancel: bool,
    can-reply: bool, can-edit: bool, can-delete: bool, can-react: bool, can-forward: bool,
    /// Among the conversation's pinned messages, and whether this account
    /// may pin it or unpin it.
    pinned: bool, can-pin: bool,
    /// The Discord thread it started or tells of, by room id, empty for
    /// none; its name, and how many messages it has.
    thread-room: string, thread-name: string, thread-detail: string,
    /// The Discord poll it asks.
    poll: PollCard, has-poll: bool,
}

// The card a click on an emoji in a message's text opens, as Discord's shows
// it: the emoji, its name, and what it is, and, for one of a server's, the
// server it came from, which opens on a click.
export struct EmojiCard {
    /// Its name between colons: a Unicode emoji's first shortcode, such as
    /// ":sob:", or a custom emoji's own, such as ":pog:".
    name: string,
    /// The emoji itself, for one Twemoji has no picture of.
    glyph: string,
    /// Its picture, at the 48px the card draws it.
    picture: image,
    /// A custom emoji's picture by address, asked for as the card shows it:
    /// its still may not have arrived when the card opens.
    picture-url: string,
    /// The name its animation is registered under, when it is a custom emoji
    /// that animates; "" draws the still alone.
    picture-key: string,
    /// What it is.
    description: string,
    /// The server it is from, when it is one's: its id, its name, the address
    /// of its icon at the 32px the card draws, the letter it shows without
    /// one, how many of its members are online, such as "3,999 Online", and a
    /// note such as "Discoverable Server"; "" for what Discord hasn't said.
    server: string,
    server-name: string,
    server-picture-url: string,
    server-initial: string,
    server-online: string,
    server-note: string,
}

// An emoji's card, 288px wide: the emoji, its name and what it is in 88px, and
// below it the server it is from, as tall as its lines.
export component EmojiCardView inherits Rectangle {
    in property <EmojiCard> card;
    /// The id of the server clicked: it opens.
    callback open-server(string);
    /// Its picture, asked for as the card shows it, as `Avatar` asks for one.
    property <image> emoji-picture: root.card.picture-url != ""
        ? PictureStore.picture(root.card.picture-url, PictureStore.revision)
        : root.card.picture;
    function request-emoji-picture() {
        if root.card.picture-url != "" && root.emoji-picture.width == 0 {
            PictureStore.request(root.card.picture-url);
        }
    }
    changed emoji-picture => { root.request-emoji-picture(); }
    /// The emoji's own frame while its animation plays, by the name the rows
    /// register it under; empty for a still emoji.
    property <image> card-animation: root.card.picture-key == ""
        ? @image-url("")
        : EmojiAnimations.frame(root.card.picture-key, EmojiAnimations.revision);
    /// The server's icon, asked for as it shows, as `Avatar` asks for one.
    property <image> server-picture: PictureStore.picture(root.card.server-picture-url, PictureStore.revision);
    function request-server-picture() {
        if root.card.server-picture-url != "" && root.server-picture.width == 0 {
            PictureStore.request(root.card.server-picture-url);
        }
    }
    init => { root.request-emoji-picture(); root.request-server-picture(); }
    changed server-picture => { root.request-server-picture(); }
    /// How many of its members are online, then what the server is, on one
    /// line, as Discord's card has them.
    property <string> server-counts: root.card.server-online != "" && root.card.server-note != ""
        ? root.card.server-online + " · " + root.card.server-note
        : root.card.server-online + root.card.server-note;
    width: 288px; height: body.preferred-height;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox; accessible-label: root.card.name;
    // Clicks on the card stay on it, instead of closing it.
    TouchArea { }
    body := VerticalLayout {
        alignment: start; spacing: 0px;
        // As tall as the name and the description's two lines and their
        // padding: 88px when the lines come to 36px.
        Rectangle {
            HorizontalLayout {
                padding: 16px; spacing: 10px;
                VerticalLayout {
                    padding-top: 4px;
                    // Its frame while it animates, as the picker reads it, and
                    // the still it shows until then, or for a still emoji.
                    if root.card-animation.width > 0 || root.emoji-picture.width > 0: Image {
                        source: root.card-animation.width > 0 ? root.card-animation : root.emoji-picture;
                        width: 48px; height: 48px; image-fit: contain;
                    }
                    if root.card-animation.width == 0 && root.emoji-picture.width == 0: Text {
                        text: root.card.glyph; width: 48px; height: 48px;
                        horizontal-alignment: center; vertical-alignment: center; font-size: 40px;
                    }
                }
                VerticalLayout {
                    width: 198px; spacing: 0px;
                    Text {
                        min-width: 0px;
                        text: root.card.name; height: 20px; font-size: 16px; font-weight: 600;
                        color: Theme.text; vertical-alignment: center; overflow: elide;
                    }
                    // Two lines, clipped only where a third would start, so a
                    // line the box had no room for is not elided away.
                    Text {
                        min-width: 0px;
                        text: root.card.description; font-size: 14px;
                        color: Theme.secondary; wrap: word-wrap; max-lines: 2;
                    }
                }
            }
        }
        if root.card.server != "": Rectangle {
            background: Theme.panel;
            border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
            VerticalLayout {
                // The card's 16px, and the title's 8px below it.
                padding: 16px; spacing: 8px;
                Text {
                    text: "This emoji is from"; min-width: 0px;
                    font-size: 12px; font-weight: 500;
                    color: Theme.muted; horizontal-alignment: start;
                    overflow: elide;
                }
                // The server, which opens on a click: as tall as its lines, so
                // the hover sits on them and no more.
                Rectangle {
                    border-radius: 6px;
                    background: server-hover.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: root.card.server-name;
                    accessible-action-default => { root.open-server(root.card.server); }
                    HorizontalLayout {
                        spacing: 8px;
                        // Each is as tall as the layout, so the icon centres
                        // against the two lines beside it.
                        Rectangle {
                            width: 32px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 32px; height: 32px; border-radius: 8px; clip: true;
                                background: root.server-picture.width > 0 ? transparent : Theme.field;
                                if root.server-picture.width > 0: Image {
                                    source: root.server-picture; width: 32px; height: 32px; image-fit: cover;
                                }
                                if root.server-picture.width == 0: Text {
                                    text: root.card.server-initial; font-size: 14px; font-weight: 700;
                                    color: Theme.text; horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                min-width: 0px; height: 20px;
                                text: root.card.server-name; font-size: 16px; font-weight: 600;
                                color: Theme.text; vertical-alignment: center; overflow: elide;
                            }
                            // One line, so nothing can come between the count,
                            // the separator and what the server is.
                            if root.server-counts != "": Text {
                                text: root.server-counts; height: 16px; font-size: 12px;
                                color: Theme.text; vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                    server-hover := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.open-server(root.card.server); }
                    }
                }
            }
        }
    }
}

// The emoji picker: a search, the emoji in rows under their headings, a
// sidebar that jumps to each heading, and the hovered one with its name.
// Escape closes it.
export component EmojiPicker inherits Rectangle {
    /// The grid for `emoji-query`, refreshed through emoji-search.
    in property <[EmojiRow]> emoji-rows;
    /// The headings of the grid with no query.
    in property <[EmojiSection]> emoji-sections;
    in-out property <string> emoji-query;
    in-out property <EmojiCell> emoji-hover;
    in property <string> emoji-font;
    /// What the emoji is for: a message's item, "yapfast:status" for the custom
    /// status, or "yapfast:composer" for the message being written.
    in property <string> react-item;
    callback emoji-search(string);
    callback pick(EmojiCell);
    callback close-picker;
    /// A locked emoji was pressed: offer Nitro, which unlocks it.
    callback unlock-nitro;
    /// How far the grid is scrolled and how tall it shows, so the adapter
    /// fetches the pictures of the custom emoji in sight rather than all of them.
    callback scrolled-to(length, length);
    /// Inside the picker above the composer, which draws the frame.
    in property <bool> bare;
    /// The emoji a row the grid was built for. A row takes as many 56px buttons
    /// as its width holds, and widening it adds a column rather than room
    /// between the buttons.
    in property <int> columns: 1;
    // Rows are all one height, so a row's place is known before the ListView
    // lays it out, and a jump lands on its heading. A button is 56px, as
    // Discord's, and holds the space its glyph leaves around it.
    property <length> row-height: 56px;
    property <length> scrolled: -grid.content-y;
    property <length> shown-height: grid.height;
    function report() { root.scrolled-to(root.scrolled, root.shown-height); }
    init => { root.report(); }
    changed scrolled => { root.report(); }
    changed shown-height => { root.report(); }
    function jump(row: int) {
        if root.emoji-query != "" {
            root.emoji-query = "";
            root.emoji-search("");
        }
        grid.content-y = -row * root.row-height;
    }
    background: root.bare ? transparent : Theme.raised; border-color: Theme.edge; border-width: root.bare ? 0px : 1px;
    border-radius: root.bare ? 0px : 10px;
    drop-shadow-blur: root.bare ? 0px : 24px; drop-shadow-color: root.bare ? transparent : #00000080; drop-shadow-offset-y: 8px;
    clip: true;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-picker(); return accept; }
            return reject;
        }
        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding: 10px; padding-bottom: 6px;
                // The picker's contents are created each time it opens.
                picker-field := TextField {
                    init => { self.focus-input(); }
                    min-height: 34px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: "Find an emoji"; label: "Find an emoji"; text <=> root.emoji-query;
                    edited(text) => { root.emoji-search(text); }
                    // Enter picks the first match.
                    accepted => {
                        if root.emoji-query != "" && root.emoji-rows.length > 0 && root.emoji-rows[0].cells.length > 0 {
                            root.pick(root.emoji-rows[0].cells[0]);
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                // The heading in view is marked, unless a search shows matches.
                Rectangle {
                    width: 48px; background: Theme.panel;
                    ListView {
                        for section in root.emoji-sections: HorizontalLayout {
                            alignment: center; padding-top: 4px;
                            EmojiButton {
                                emoji: section.icon; font: root.emoji-font; size: 36px; glyph: 24px; tip: false;
                                verb: "Jump to";
                                fill: root.emoji-query == "" && root.scrolled >= (section.row - 0.5) * root.row-height
                                    && root.scrolled < (section.end - 0.5) * root.row-height ? Theme.active : transparent;
                                hovered => { root.emoji-hover = section.icon; }
                                clicked => { root.jump(section.row); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    grid := ListView {
                        vertical-stretch: 1;
                        for row in root.emoji-rows: VerticalLayout {
                            height: root.row-height; padding-left: 8px; padding-right: 8px;
                            if row.heading != "": HorizontalLayout {
                                padding-left: 4px; padding-bottom: 4px;
                                Text { text: row.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: bottom; }
                            }
                            if row.cells.length > 0: HorizontalLayout {
                                alignment: start;
                                for cell in row.cells: EmojiButton {
                                    emoji: cell; font: root.emoji-font; size: 56px; glyph: 36px; tip: false;
                                    usable: cell.usable;
                                    // Its own `name:id`, which its animation is registered under; a
                                    // Unicode emoji's shortcode has none, and keeps its still.
                                    animation-key: cell.key;
                                    verb: root.react-item == "yapfast:status" ? "Choose" : root.react-item == "yapfast:composer" ? "Insert" : "React with";
                                    hovered => { root.emoji-hover = cell; }
                                    clicked => { root.pick(cell); }
                                    locked => { root.unlock-nitro(); }
                                }
                            }
                        }
                    }
                    if root.emoji-rows.length == 0: HorizontalLayout {
                        padding: 16px; vertical-stretch: 1;
                        Label { text: "No emoji match \"" + root.emoji-query + "\"."; horizontal-alignment: center; }
                    }
                }
            }
            // The hovered emoji, larger, with its name.
            Rectangle {
                height: 48px; background: Theme.panel;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    if root.emoji-hover.glyph != "": EmojiFace {
                        emoji: root.emoji-hover; font: root.emoji-font; side: 26px; width: 30px;
                    }
                    Text {
                        text: root.emoji-hover.glyph != "" ? root.emoji-hover.name
                            : root.react-item == "yapfast:status" ? "Pick an emoji for your status."
                            : root.react-item == "yapfast:composer" ? "Pick an emoji for your message." : "Pick an emoji to react with.";
                        color: root.emoji-hover.glyph != "" ? Theme.text : Theme.muted; font-size: 15px;
                        font-weight: root.emoji-hover.glyph != "" ? 700 : 400;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

// A message's actions, from its hover bar's "More" button or a right click:
// frequent reactions, then what can be done with it. A right click on a
// picture, video or link adds what can be done with that.
export component MessageMenu inherits Rectangle {
    in property <MessageRow> menu-message;
    /// Text selected in the message, as copied; empty for none.
    in property <string> selection;
    /// The picture or video right-clicked, by its index in the message's
    /// attachments; -1 for none.
    in property <int> media-index: -1;
    in property <bool> media-video;
    /// Its address on the web, or the link's, or empty when it has none.
    in property <string> link;
    in property <bool> menu-can-react;
    /// The reactions this device uses most.
    in property <[EmojiCell]> menu-reactions;
    in property <string> emoji-font;
    in property <bool> composer-enabled;
    /// Forward shows on messages that can be forwarded: Matrix forwards only
    /// from a verified device.
    in property <bool> forward-allowed;
    in property <bool> preview;
    out property <length> content-height: menu-content.preferred-height;
    callback react(string, string);
    callback open-picker(string);
    callback edit(string);
    callback reply(string);
    callback start-forward(string);
    callback copy-text(string);
    callback pin-message(string);
    callback request-delete(string);
    /// Asks to make sure before closing this account's poll.
    callback end-poll(string);
    /// Threads can start from the conversation's messages.
    in property <bool> can-start-thread;
    callback start-thread(string);
    callback view-thread(string);
    callback view-reactions(string);
    callback copy-image(string, int);
    callback save-attachment(string, int);
    callback open-link(string);
    background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    menu-content := VerticalLayout {
        padding: 6px; spacing: 2px;
        // Discord's quick reactions: 44px tiles, spread across the menu.
        if root.menu-can-react: HorizontalLayout {
            spacing: 4px; padding-bottom: 4px; padding-left: 2px; padding-right: 2px;
            alignment: space-between;
            for cell in root.menu-reactions: EmojiButton {
                animation-key: cell.key;
                emoji: cell; font: root.emoji-font; size: 44px; height: 44px; glyph: 24px; fill: Theme.field;
                clicked => { root.react(root.menu-message.item, cell.key); }
            }
        }
        if root.menu-can-react: MenuItem {
            text: "Add reaction"; icon: @image-url("icons/smile-plus.svg");
            clicked => { root.open-picker(root.menu-message.item); }
        }
        if root.menu-message.reactions.length > 0: MenuItem {
            text: "View Reactions"; icon: @image-url("icons/smile.svg");
            clicked => { root.view-reactions(root.menu-message.item); }
        }
        if root.menu-message.can-edit && root.composer-enabled: MenuItem {
            text: "Edit message"; icon: @image-url("icons/pencil.svg");
            clicked => { root.edit(root.menu-message.item); }
        }
        if root.menu-message.can-reply && root.composer-enabled: MenuItem {
            text: "Reply"; icon: @image-url("icons/reply.svg");
            clicked => { root.reply(root.menu-message.item); }
        }
        if root.menu-message.can-forward && root.forward-allowed: MenuItem {
            text: "Forward"; icon: @image-url("icons/forward.svg");
            clicked => { root.start-forward(root.menu-message.item); }
        }
        // A message someone wrote starts a thread, or leads to its own.
        if root.can-start-thread && root.menu-message.can-reply && root.menu-message.delivery == ""
            && root.menu-message.thread-room == "": MenuItem {
            text: "Create Thread"; icon: @image-url("icons/thread.svg");
            clicked => { root.start-thread(root.menu-message.item); }
        }
        if root.menu-message.can-reply && root.menu-message.thread-room != "": MenuItem {
            text: "View Thread"; icon: @image-url("icons/thread.svg");
            clicked => { root.view-thread(root.menu-message.thread-room); }
        }
        if root.menu-message.body != "": MenuItem {
            text: "Copy text"; icon: @image-url("icons/copy.svg");
            clicked => { root.copy-text(root.menu-message.body); }
        }
        if root.selection != "": MenuItem {
            text: "Copy selection"; icon: @image-url("icons/text-select.svg");
            clicked => { root.copy-text(root.selection); }
        }
        if root.menu-message.has-poll && root.menu-message.poll.can-end: MenuItem {
            text: "End Poll Now"; icon: @image-url("icons/circle-stop.svg");
            clicked => { root.end-poll(root.menu-message.item); }
        }
        if root.menu-message.can-pin && root.menu-message.delivery == "": MenuItem {
            text: root.menu-message.pinned ? "Unpin message" : "Pin message";
            icon: root.menu-message.pinned ? @image-url("icons/pin-off.svg") : @image-url("icons/pin.svg");
            clicked => { root.pin-message(root.menu-message.item); }
        }
        if root.link != "" || (root.media-index >= 0 && !root.preview): Rectangle { height: 1px; background: Theme.line; }
        if root.media-index >= 0 && root.link != "" && !root.media-video && !root.preview: MenuItem {
            text: "Copy Image"; icon: @image-url("icons/image.svg");
            clicked => { root.copy-image(root.menu-message.item, root.media-index); }
        }
        if root.media-index >= 0 && !root.preview: MenuItem {
            text: root.media-video ? "Save Video" : "Save Image"; icon: @image-url("icons/download.svg");
            clicked => { root.save-attachment(root.menu-message.item, root.media-index); }
        }
        if root.link != "": MenuItem {
            text: "Copy Link"; icon: @image-url("icons/link.svg");
            clicked => { root.copy-text(root.link); }
        }
        // A link in the text opens with a click.
        if root.media-index >= 0 && root.link != "": MenuItem {
            text: "Open Link"; icon: @image-url("icons/external-link.svg");
            clicked => { root.open-link(root.link); }
        }
        if root.menu-message.can-delete && root.composer-enabled: Rectangle { height: 1px; background: Theme.line; }
        if root.menu-message.can-delete && root.composer-enabled: MenuItem {
            text: "Delete message"; icon: @image-url("icons/trash-2.svg"); danger: true;
            clicked => { root.request-delete(root.menu-message.item); }
        }
    }
}

// A message's images with previews, laid out as a gallery. Clicking an image
// opens it large.
export component MessageGallery inherits HorizontalLayout {
    in property <[ImageCell]> images;
    in property <int> gallery-width;
    in property <int> gallery-height;
    /// The message's item, which its pictures open by, and its delivery
    /// state, empty once it's sent.
    in property <string> item;
    in property <string> delivery;
    in property <string> active-item;
    in property <bool> preview;
    callback reveal-attachment(string, int);
    callback view-image(string, int);
    callback save-attachment(string, int);
    /// A right click on a picture or video: the message, the attachment's
    /// index, whether it's a video, and where in the window.
    callback media-menu(string, int, bool, length, length);
    padding-top: 4px;
    Rectangle {
        width: root.gallery-width * 1px; height: root.gallery-height * 1px;
        for cell in root.images: Rectangle {
            x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
            border-radius: 8px; clip: true;
            // Discord draws a transparent picture straight on the message background.
            background: ClientStyle.enabled && !cell.loading ? transparent : Theme.sunken;
            if cell.loading: Skeleton { width: parent.width; height: parent.height; }
            if !cell.loading: Picture { still: cell.image; frames: cell.frames; delays: cell.delays; width: parent.width; height: parent.height; image-fit: cover; accessible-role: image; accessible-label: cell.spoiler ? "Spoiler" : cell.name; }
            if cell.spoiler: SpoilerCover {}
            cell-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if cell.spoiler { root.reveal-attachment(root.item, cell.index); } else { root.view-image(root.item, cell.index); }
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.media-menu(root.item, cell.index, cell.video, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                // Inside the touch area, so the pointer on it still hovers the GIF.
                if cell.gif != "" && !cell.spoiler && !root.preview && root.delivery == "": FavoriteStar {
                    x: 8px; y: 8px;
                    on: GifFavorites.is-favorite(cell.gif, GifFavorites.revision);
                    shown: cell-touch.has-hover;
                    clicked => { GifFavorites.toggle(root.item, cell.index); }
                }
            }
            if cell.video && !cell.spoiler && !cell.loading && !root.preview: VideoCell {
                width: parent.width; height: parent.height; item: root.item; cell: cell;
                menu(x, y) => { root.media-menu(root.item, cell.index, true, x, y); }
            }
            if root.active-item == root.item && !root.preview && root.delivery == "" && !cell.spoiler: Rectangle {
                x: parent.width - self.width - 8px; y: 8px; width: 32px; height: 32px; border-radius: 6px; background: #000000b3;
                IconButton {
                    icon: @image-url("icons/download.svg"); label: "Save " + cell.name; tint: #ffffff;
                    clicked => { root.save-attachment(root.item, cell.index); }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// A message's Discord stickers, drawn on their own at their size.
export component MessageStickers inherits HorizontalLayout {
    in property <[ImageCell]> stickers;
    padding-top: 4px; spacing: 8px;
    for cell in root.stickers: Rectangle {
        width: cell.width * 1px; height: cell.height * 1px;
        if cell.loading: Skeleton { width: parent.width; height: parent.height; border-radius: 12px; }
        if !cell.loading: Picture {
            still: cell.image; frames: cell.frames; delays: cell.delays;
            width: parent.width; height: parent.height; image-fit: contain;
            accessible-role: image; accessible-label: "Sticker: " + cell.name;
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// A file, or an image without a preview, as a card with a way to save it.
export component FileCard inherits HorizontalLayout {
    in property <FileCell> file;
    in property <bool> preview;
    /// The message's delivery state, empty once it's sent.
    in property <string> delivery;
    callback save;
    padding-top: 4px;
    Rectangle {
        min-height: file-card.preferred-height; max-width: 432px; horizontal-stretch: 100;
        background: Theme.sidebar; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
        file-card := HorizontalLayout {
            padding: 12px; padding-right: 8px; spacing: 12px;
            Image { source: @image-url("icons/file.svg"); width: 30px; image-fit: contain; colorize: Theme.accent; }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: root.file.name; color: Theme.text; font-weight: 500; overflow: elide; }
                if root.file.detail != "": Label { text: root.file.detail; }
            }
            IconButton {
                icon: @image-url("icons/download.svg"); label: "Save " + root.file.name;
                enabled: !root.preview && root.delivery == "";
                clicked => { root.save(); }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// A Discord thread under the message it started, or its notice: its name
// and how many messages it has. Clicking it opens the thread.
export component ThreadChip inherits HorizontalLayout {
    in property <string> name;
    in property <string> detail;
    callback clicked;
    padding-top: 4px;
    Rectangle {
        max-width: 432px; horizontal-stretch: 100;
        min-height: chip.preferred-height;
        background: touch.has-hover ? Theme.hover : Theme.sidebar;
        border-color: focus.has-focus ? Theme.accent : Theme.edge; border-width: focus.has-focus ? 2px : 1px;
        border-radius: 8px;
        accessible-role: button;
        accessible-label: "Thread " + root.name + (root.detail != "" ? ", " + root.detail : "");
        accessible-action-default => { root.clicked(); }
        chip := HorizontalLayout {
            padding: 8px; padding-left: 12px; padding-right: 12px; spacing: 10px;
            Image { source: @image-url("icons/thread.svg"); width: 18px; image-fit: contain; colorize: Theme.muted; }
            Text { text: root.name; color: Theme.text; font-weight: 700; overflow: elide; vertical-alignment: center; }
            if root.detail != "": Text {
                text: root.detail; color: Theme.link; font-size: 14px; vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Image { source: @image-url("icons/chevron-right.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == "\n" || event.text == " " {
                    root.clicked(); return accept;
                }
                return reject;
            }
            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.clicked(); }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// Discord's tag after a bot's name: white on blurple.
export component BotTag inherits Rectangle {
    width: tag-text.preferred-width + 8px; height: 16px; border-radius: 4px;
    background: #5865f2;
    accessible-role: text; accessible-label: "Bot";
    tag-text := Text { text: "BOT"; color: #ffffff; font-size: 10px; font-weight: 700; letter-spacing: 0.3px; }
}

// A block of text: a heading or subtext at its size, or fenced code in its
// box, behind a quote's bar when quoted. Inside a card's container, text and
// subtext are smaller, as in Discord's client; headings are not.
component TextBlockView inherits VerticalLayout {
    in property <TextBlock> block;
    in property <length> font-size;
    in property <bool> framed;
    in property <color> color: Theme.text;
    // Headings are in the strongest colour of their text, as in Discord's client.
    in property <color> heading-color: root.color;
    in property <int> max-lines;
    callback open-link(string);
    property <length> code-size: root.font-size * 0.875;
    padding-top: root.block.margin;
    HorizontalLayout {
        if root.block.quoted: Rectangle {
            width: 4px; background: Theme.reply-spine;
            border-top-left-radius: root.block.quote-start ? 2px : 0px;
            border-top-right-radius: self.border-top-left-radius;
            border-bottom-left-radius: root.block.quote-end ? 2px : 0px;
            border-bottom-right-radius: self.border-bottom-left-radius;
        }
        VerticalLayout {
            padding-top: root.block.padding;
            padding-left: root.block.quoted ? 12px : 0px;
            if root.block.level == 5: Rectangle {
                background: Theme.panel; border-radius: 4px; border-width: 1px; border-color: Theme.line;
                VerticalLayout {
                    padding: root.code-size / 2;
                    StyledText {
                        min-width: 0px;
                        text: root.block.text; link-color: Theme.link; default-color: Theme.text;
                        default-font-family: "monospace"; default-font-size: root.code-size; max-lines: root.max-lines;
                    }
                }
            }
            if root.block.level != 5: StyledText {
                min-width: 0px;
                text: root.block.text; link-color: Theme.link;
                // A quote's text is dimmer, but not its headings.
                default-color: root.block.level == 4 || (root.block.quoted && root.block.level == 0) ? Theme.secondary
                    : root.block.level >= 1 && root.block.level <= 3 ? root.heading-color : root.color;
                default-font-size: root.block.level == 1 ? root.font-size * 1.5 : root.block.level == 2 ? root.font-size * 1.25
                    : root.block.level == 3 ? root.font-size
                    : root.font-size * (root.block.level == 4 ? (root.framed ? 0.75 : 0.875) : (root.framed ? 0.875 : 1));
                max-lines: root.max-lines;
                link-clicked(link) => { root.open-link(link); }
            }
        }
    }
}

// Text in blocks, as a card's or a message's body. `max-lines` caps each
// block's lines, when not 0.
export component TextBlocks inherits VerticalLayout {
    in property <[TextBlock]> blocks;
    in property <length> font-size;
    in property <bool> framed;
    in property <color> color: Theme.text;
    in property <color> heading-color: root.color;
    in property <int> max-lines;
    callback open-link(string);
    for block in root.blocks: TextBlockView {
        block: block; font-size: root.font-size; framed: root.framed; color: root.color; heading-color: root.heading-color;
        max-lines: root.max-lines;
        open-link(link) => { root.open-link(link); }
    }
}

// Link previews and bot cards, behind a bar of their colour.
export component EmbedView inherits HorizontalLayout {
    in property <EmbedCard> embed;
    /// The message's item, which its pictures open by.
    in property <string> item;
    callback open-link(string);
    callback reveal-attachment(string, int);
    callback view-image(string, int);
    /// A right click on a picture, as [`MessageGallery`] has it.
    callback media-menu(string, int, bool, length, length);
    padding-top: 4px;
    // The card takes its height from its contents' layout, which measures
    // wrapped text at the width the card gets. A height bound to their
    // preferred height measured it at another width and cut off the end.
    Rectangle {
        max-width: 432px; horizontal-stretch: 100;
        background: Theme.sidebar; border-radius: 4px; clip: true;
        Rectangle { x: 0px; width: 4px; background: root.embed.has-color ? root.embed.color : Theme.edge; }
        embed-body := HorizontalLayout {
            padding: 12px; padding-left: 16px; padding-right: 16px; spacing: 16px;
            VerticalLayout {
                spacing: 8px; horizontal-stretch: 1; alignment: start;
                if root.embed.has-provider: StyledText { text: root.embed.provider; link-color: Theme.link; default-color: Theme.muted; default-font-size: 12px; max-lines: 1; }
                if root.embed.has-author: StyledText { text: root.embed.author; link-color: Theme.link; default-color: Theme.text; default-font-size: 14px; }
                if root.embed.has-title: StyledText {
                    text: root.embed.title; default-color: Theme.text; link-color: Theme.link; default-font-size: 16px;
                    link-clicked(link) => { root.open-link(link); }
                }
                if root.embed.has-description && root.embed.description-blocks.length == 0: StyledText {
                    text: root.embed.description; default-color: Theme.secondary; link-color: Theme.link; default-font-size: 14px;
                    link-clicked(link) => { root.open-link(link); }
                }
                if root.embed.description-blocks.length > 0: TextBlocks {
                    blocks: root.embed.description-blocks; font-size: 14px; color: Theme.secondary; heading-color: Theme.text;
                    open-link(link) => { root.open-link(link); }
                }
                for row in root.embed.field-rows: HorizontalLayout {
                    spacing: 8px;
                    for field in row.fields: VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        StyledText { text: field.name; link-color: Theme.link; default-color: Theme.text; default-font-size: 14px; }
                        if field.value-blocks.length == 0: StyledText {
                            text: field.value; default-color: Theme.secondary; link-color: Theme.link; default-font-size: 14px;
                            link-clicked(link) => { root.open-link(link); }
                        }
                        if field.value-blocks.length > 0: TextBlocks {
                            blocks: field.value-blocks; font-size: 14px; color: Theme.secondary; heading-color: Theme.text;
                            open-link(link) => { root.open-link(link); }
                        }
                    }
                }
                // A video's poster opens the video; other pictures open in the viewer.
                if root.embed.images.length > 0: HorizontalLayout {
                    Rectangle {
                        width: root.embed.gallery-width * 1px; height: root.embed.gallery-height * 1px;
                        for cell in root.embed.images: Rectangle {
                            x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
                            border-radius: 4px; clip: true; background: ClientStyle.enabled && !cell.loading ? transparent : Theme.sunken;
                            if cell.loading: Skeleton { width: parent.width; height: parent.height; }
                            if !cell.loading: Picture { still: cell.image; frames: cell.frames; delays: cell.delays; width: parent.width; height: parent.height; image-fit: cover; accessible-role: image; accessible-label: cell.spoiler ? "Spoiler" : cell.name; }
                            if cell.spoiler: SpoilerCover {}
                            if root.embed.video && !cell.spoiler && !cell.video: Rectangle {
                                width: 48px; height: 48px; border-radius: 24px; background: #000000b3;
                                Path {
                                    width: 18px; height: 20px; x: 17px; y: 14px;
                                    commands: "M 0 0 L 18 10 L 0 20 Z"; fill: #ffffff;
                                }
                            }
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    if cell.spoiler { root.reveal-attachment(root.item, cell.index); }
                                    else if root.embed.video { root.open-link(root.embed.url); } else { root.view-image(root.item, cell.index); }
                                }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        root.media-menu(root.item, cell.index, cell.video, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                            // A video file the media proxy has plays here; others open in the browser.
                            if cell.video && !cell.spoiler && !cell.loading: VideoCell {
                                width: parent.width; height: parent.height; item: root.item; cell: cell;
                                menu(x, y) => { root.media-menu(root.item, cell.index, true, x, y); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.embed.has-footer: StyledText { text: root.embed.footer; link-color: Theme.link; default-color: Theme.muted; default-font-size: 12px; }
            }
            if root.embed.has-thumbnail: VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 80px; height: 80px; border-radius: 4px; clip: true;
                    if root.embed.thumbnail-loading: Skeleton { width: parent.width; height: parent.height; }
                    Image { source: root.embed.thumbnail; width: parent.width; height: parent.height; image-fit: contain; accessible-role: image; accessible-label: "Thumbnail"; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.view-image(root.item, root.embed.thumbnail-index); }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                root.media-menu(root.item, root.embed.thumbnail-index, false, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// A Discord app's button. A link's opens its page; the others show what the
// app offers, but would ask the app, which Yapfast can't yet.
component CardButtonView inherits ActionButton {
    in property <CardButton> button;
    callback open-link(string);
    property <image> no-icon;
    text: root.button.label;
    icon: root.button.style == CardButtonStyle.link ? @image-url("icons/external-link.svg") : root.no-icon;
    primary: root.button.style == CardButtonStyle.primary;
    success: root.button.style == CardButtonStyle.success;
    danger: root.button.style == CardButtonStyle.danger;
    enabled: root.button.enabled;
    small: true;
    clicked => { root.open-link(root.button.url); }
}

// A Discord message's container of components, or those outside one: text
// beside a thumbnail or button, galleries, files, gaps, buttons and menus.
export component CardView inherits HorizontalLayout {
    in property <ComponentCard> card;
    /// The message's item, which its pictures open by, and its delivery
    /// state, empty once it's sent.
    in property <string> item;
    in property <string> delivery;
    in property <string> active-item;
    in property <bool> preview;
    in property <length> message-font-size;
    callback open-link(string);
    callback reveal-attachment(string, int);
    callback view-image(string, int);
    callback save-attachment(string, int);
    callback media-menu(string, int, bool, length, length);
    padding-top: 4px;
    Rectangle {
        max-width: root.card.framed ? 600px : 100000px; horizontal-stretch: 100;
        background: root.card.framed ? Theme.sidebar : transparent;
        border-radius: 8px; clip: root.card.framed;
        border-width: root.card.framed ? 1px : 0px; border-color: Theme.edge;
        if root.card.framed && root.card.has-color: Rectangle { x: 0px; width: 4px; background: root.card.color; }
        VerticalLayout {
            // The accent bar sits over the left padding.
            padding: root.card.framed ? 16px : 0px;
            spacing: 8px; alignment: start;
            for row in root.card.rows: VerticalLayout {
                if row.kind == CardRowKind.text: HorizontalLayout {
                    spacing: 12px;
                    TextBlocks {
                        horizontal-stretch: 1; blocks: row.blocks; font-size: root.message-font-size; framed: root.card.framed;
                        alignment: row.has-button ? LayoutAlignment.center : LayoutAlignment.start;
                        open-link(link) => { root.open-link(link); }
                    }
                    if row.has-thumbnail: VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 85px; height: 85px; border-radius: 8px; clip: true; background: ClientStyle.enabled && !row.thumbnail-loading ? transparent : Theme.sunken;
                            if row.thumbnail-loading: Skeleton { width: parent.width; height: parent.height; }
                            if !row.thumbnail-spoiler: Image {
                                source: row.thumbnail; width: parent.width; height: parent.height; image-fit: cover;
                                accessible-role: image; accessible-label: "Thumbnail";
                            }
                            if row.thumbnail-spoiler: SpoilerCover {}
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    if row.thumbnail-spoiler { root.reveal-attachment(root.item, row.thumbnail-index); }
                                    else { root.view-image(root.item, row.thumbnail-index); }
                                }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        root.media-menu(root.item, row.thumbnail-index, false, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                    if row.has-button: VerticalLayout {
                        alignment: start;
                        CardButtonView { button: row.button; open-link(link) => { root.open-link(link); } }
                    }
                }
                if row.kind == CardRowKind.media && row.images.length > 0: MessageGallery {
                    images: row.images; gallery-width: row.gallery-width; gallery-height: row.gallery-height;
                    item: root.item; delivery: root.delivery; active-item: root.active-item; preview: root.preview;
                    reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                    view-image(id, index) => { root.view-image(id, index); }
                    save-attachment(id, index) => { root.save-attachment(id, index); }
                    media-menu(id, index, video, x, y) => { root.media-menu(id, index, video, x, y); }
                }
                // Only a media row has files.
                for file in row.files: FileCard {
                    file: file; preview: root.preview; delivery: root.delivery;
                    save => { root.save-attachment(root.item, file.index); }
                }
                // With the layout's spacing either side, a small gap is 16
                // pixels and a large one 32, a divider's line between.
                if row.kind == CardRowKind.separator: Rectangle {
                    height: (row.large ? 16px : 0px) + (row.divider ? 1px : 0px);
                    if row.divider: Rectangle { y: row.large ? 8px : 0px; height: 1px; background: Theme.line; }
                }
                if row.kind == CardRowKind.buttons: HorizontalLayout {
                    spacing: 8px; alignment: start;
                    for button in row.buttons: CardButtonView { button: button; open-link(link) => { root.open-link(link); } }
                }
                if row.kind == CardRowKind.select: HorizontalLayout {
                    // It doesn't open, so it shows as disabled.
                    Rectangle {
                        max-width: 400px; horizontal-stretch: 100; height: 40px; border-radius: 8px; opacity: 0.5;
                        background: Theme.field; border-width: 1px; border-color: Theme.edge;
                        accessible-role: combobox; accessible-label: row.select; accessible-enabled: false;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 8px;
                            Text { text: row.select; color: Theme.secondary; font-weight: 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Image { source: @image-url("icons/chevron-down.svg"); width: 18px; image-fit: contain; colorize: Theme.secondary; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // As Discord's client tells of components it doesn't know.
                if row.kind == CardRowKind.unknown: Rectangle {
                    border-width: 1px; border-color: Theme.accent; border-radius: 12px;
                    HorizontalLayout {
                        padding: 16px;
                        Text { text: "Yapfast can't show this part of the message yet."; color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                    }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

// What to do when no conversation is chosen.
export component NoConversation inherits VerticalLayout {
    padding: 32px; spacing: 10px; alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
            Image { source: @image-url("icons/message-circle.svg"); width: 36px; height: 36px; colorize: Theme.secondary; }
        }
    }
    Text { text: "Pick a conversation"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
    Text { text: "Choose a DM or a server channel on the left."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
}

// What's above the oldest loaded message: earlier messages on their way, a way
// to load them, or the start of the conversation. It's as tall in each, so
// changing from one to another doesn't move the messages below. Below the
// newest message of a window of older ones, it's the same for newer messages.
export component HistoryEdge inherits HorizontalLayout {
    in property <bool> loading;
    in property <bool> failed;
    in property <bool> start;
    in property <bool> newer;
    in property <bool> enabled;
    in property <bool> room-direct;
    /// A Discord thread, named as one rather than as a channel.
    in property <bool> room-thread;
    in property <string> room-name;
    /// Discord's welcome block, in place of the one line: "server" for a
    /// server's first channel, "channel" for another, empty for neither.
    in property <string> intro;
    in property <string> intro-welcome;
    in property <string> intro-title;
    in property <string> intro-text;
    callback earlier;
    property <string> which: root.newer ? "newer" : "earlier";
    property <bool> welcome: ClientStyle.enabled && root.start && !root.newer && root.intro != "";
    out property <length> block: !root.welcome ? 42px : root.intro == "server" ? ClientStyle.intro-server-height : ClientStyle.intro-channel-height;
    alignment: center; height: root.block; padding-top: root.welcome ? 0px : 4px; padding-bottom: root.welcome ? 0px : 8px;
    if root.welcome: VerticalLayout {
        alignment: LayoutAlignment.start; spacing: 0px; padding-top: 47px; padding-bottom: 12px;
        // A server's: its welcome over its name, in two lines.
        if root.intro == "server": Text { text: root.intro-welcome; color: Theme.text; font-size: 32px; font-weight: 600; horizontal-alignment: center; overflow: elide; height: 40px; }
        if root.intro == "server": Text { text: root.intro-title; color: Theme.text; font-size: 32px; font-weight: 600; horizontal-alignment: center; overflow: elide; height: 40px; }
        // A channel's: a hash in a circle, then its welcome.
        if root.intro == "channel": HorizontalLayout {
            alignment: center; height: 68px;
            Rectangle {
                width: 68px; height: 68px; border-radius: 34px; background: Theme.field;
                Image { source: @image-url("icons/hash.svg"); width: 40px; height: 40px; colorize: Theme.text; }
            }
        }
        if root.intro == "channel": Rectangle { height: 8px; }
        if root.intro == "channel": Text { text: root.intro-title; color: Theme.text; font-size: 32px; font-weight: 700; horizontal-alignment: center; overflow: elide; height: 40px; }
        Rectangle { height: 8px; }
        Text { text: root.intro-text; color: Theme.secondary; font-size: root.intro == "server" ? 14px : 16px; horizontal-alignment: center; overflow: elide; height: 20px; }
    }
    if root.start && !root.welcome: Text {
        text: root.room-direct ? "This is the beginning of your messages with " + root.room-name + "."
            : root.room-thread ? "This is the start of the " + root.room-name + " thread."
            : "This is the start of #" + root.room-name + ".";
        color: Theme.muted; font-size: 14px; vertical-alignment: center; overflow: elide;
    }
    if !root.start: Rectangle {
        width: content.preferred-width; height: 30px; border-radius: 15px; clip: true;
        background: touch.has-hover && touch.enabled ? Theme.active : Theme.raised;
        accessible-role: button;
        accessible-label: root.loading ? "Loading " + root.which + " messages" : root.failed ? "Couldn't load " + root.which + " messages. Retry" : root.newer ? "Newer messages" : "Earlier messages";
        accessible-enabled: touch.enabled;
        accessible-action-default => { if touch.enabled { root.earlier(); } }
        // The shimmer of the skeletons that stand in for other things loading.
        if root.loading: Rectangle {
            width: 120px; height: parent.height;
            x: Math.mod(animation-tick() / 1ms, 1500) / 1500 * (parent.width + self.width) - self.width;
            background: @linear-gradient(90deg, Theme.shimmer.with-alpha(0) 0%, Theme.shimmer 50%, Theme.shimmer.with-alpha(0) 100%);
        }
        content := HorizontalLayout {
            padding-left: 12px; padding-right: 14px; spacing: 6px;
            Image {
                source: root.failed ? @image-url("icons/triangle-alert.svg") : @image-url("icons/history.svg");
                width: 16px; image-fit: contain; colorize: root.failed ? Theme.danger : Theme.secondary;
            }
            Text {
                text: root.loading ? "Loading " + root.which + " messages..." : root.failed ? "Couldn't load " + root.which + " messages. Retry" : root.newer ? "Newer messages" : "Earlier messages";
                color: Theme.secondary; font-size: 14px; font-weight: 500; vertical-alignment: center;
            }
        }
        touch := TouchArea { enabled: root.enabled && !root.loading; mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.earlier(); } }
    }
}

// Says how much is new since the conversation was last read while the "New"
// divider is out of view, and jumps to it.
export component UnreadBar inherits Rectangle {
    in property <string> label;
    /// The divider is above the view, rather than below it.
    in property <bool> above;
    callback jump;
    width: content.preferred-width; height: 32px; border-radius: 16px;
    background: touch.has-hover ? Theme.accent-hover : Theme.accent;
    drop-shadow-blur: 12px; drop-shadow-color: #00000060; drop-shadow-offset-y: 4px;
    accessible-role: button;
    accessible-label: root.label + ". Jump to the first unread message";
    accessible-action-default => { root.jump(); }
    content := HorizontalLayout {
        padding-left: 14px; padding-right: 10px; spacing: 8px;
        Text { text: root.label; color: Theme.on-accent; font-size: 14px; font-weight: 700; vertical-alignment: center; }
        Image {
            source: @image-url("icons/chevron-down.svg"); width: 16px; image-fit: contain;
            colorize: Theme.on-accent; transform-rotation: root.above ? 180deg : 0deg;
        }
    }
    touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.jump(); } }
}

// Says the timeline shows a window of older messages, which new ones don't go
// in, and goes back to the newest, as Discord's bar over the composer does.
export component PresentBar inherits Rectangle {
    callback jump;
    height: 36px; border-radius: 8px;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px;
    drop-shadow-blur: 12px; drop-shadow-color: #00000060; drop-shadow-offset-y: 4px;
    accessible-role: button;
    accessible-label: "You're viewing older messages. Jump to present";
    accessible-action-default => { root.jump(); }
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 8px;
        Text {
            text: "You're viewing older messages"; color: Theme.secondary; font-size: 14px; font-weight: 500;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        Text {
            text: "Jump to present"; color: touch.has-hover ? Theme.accent-hover : Theme.accent;
            font-size: 14px; font-weight: 700; vertical-alignment: center;
        }
        Image {
            source: @image-url("icons/chevron-down.svg"); width: 16px; image-fit: contain;
            colorize: touch.has-hover ? Theme.accent-hover : Theme.accent;
        }
    }
    touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.jump(); } }
}

// The opening of a conversation without messages yet.
export component ConversationStart inherits VerticalLayout {
    in property <bool> room-selected;
    in property <bool> room-ready;
    in property <bool> room-direct;
    in property <bool> room-thread;
    in property <string> room-name;
    in property <image> room-icon;
    in property <string> room-initial;
    in property <color> room-tint;
    in property <image> room-picture;
    padding: 24px; spacing: 8px; alignment: end;
    if root.room-selected && root.room-ready && root.room-direct: Avatar { size: 72px; initial: root.room-initial; tint: root.room-tint; picture: root.room-picture; }
    if root.room-selected && root.room-ready && !root.room-direct: Rectangle {
        width: 68px; height: 68px; border-radius: 34px; background: Theme.raised;
        Image { source: root.room-icon; width: 36px; height: 36px; colorize: Theme.text; }
    }
    Text {
        text: !root.room-ready ? "Loading conversation..." : root.room-direct || root.room-thread ? root.room-name : "Welcome to #" + root.room-name;
        color: Theme.text; font-size: root.room-ready ? 28px : 18px; font-weight: 900; wrap: word-wrap;
    }
    if root.room-ready: Text {
        text: root.room-direct ? "This is the beginning of your messages with " + root.room-name + "."
            : root.room-thread ? "This is the start of the " + root.room-name + " thread. No messages here yet."
            : "This is the start of #" + root.room-name + ". No messages here yet.";
        color: Theme.secondary; wrap: word-wrap;
    }
}

// An image shown large over everything. Arrow keys or the side buttons
// step through the message's images; Escape, the close button or a click
// outside the image closes it.
// A right click on a picture or video shown large offers what the message's
// menu does for it.
component ViewerMenu inherits PopupWindow {
    in property <string> item;
    in property <int> index;
    in property <bool> video;
    in property <bool> preview;
    /// Its address on the web, or empty when it has none.
    in property <string> link;
    /// Where it opens in the viewer, which is this big.
    in property <length> at-x;
    in property <length> at-y;
    in property <length> room-width;
    in property <length> room-height;
    callback copy-image(string, int);
    callback save-attachment(string, int);
    callback copy-text(string);
    callback open-link(string);
    /// The menu closed, by a choice or a key, for the viewer's keys to go on.
    callback done;
    property <MenuRow> save-row: {
        id: "save", text: root.video ? "Save Video" : "Save Image", icon: @image-url("icons/download.svg")
    };
    property <MenuRow> copy-link-row: { id: "copy-link", text: "Copy Link", icon: @image-url("icons/link.svg") };
    property <MenuRow> open-link-row: { id: "open-link", text: "Open Link", icon: @image-url("icons/external-link.svg") };
    property <[MenuRow]> rows: root.link == "" ? [root.save-row]
        : root.preview ? [root.copy-link-row, root.open-link-row]
        : root.video ? [root.save-row, root.copy-link-row, root.open-link-row]
        : [{ id: "copy-image", text: "Copy Image", icon: @image-url("icons/image.svg") }, root.save-row, root.copy-link-row, root.open-link-row];
    x: max(8px, min(root.room-width - content.menu-width - 8px, root.at-x));
    y: root.at-y + content.main-height <= root.room-height - 8px
        ? root.at-y : max(8px, root.at-y - content.main-height);
    width: content.content-width; height: content.content-height;
    close-policy: PopupClosePolicy.close-on-click-outside;
    content := ContextMenu {
        rows: root.rows;
        chose(id) => {
            root.close();
            root.done();
            if id == "copy-image" { root.copy-image(root.item, root.index); }
            else if id == "save" { root.save-attachment(root.item, root.index); }
            else if id == "copy-link" { root.copy-text(root.link); }
            else if id == "open-link" { root.open-link(root.link); }
        }
        close => { root.close(); root.done(); }
    }
}

export component ImageViewer inherits Rectangle {
    in property <image> viewer-image;
    in property <[image]> viewer-frames;
    in property <[int]> viewer-delays;
    /// The image's full size in pixels.
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    /// Such as "2 / 3"; empty for a message's only image.
    in property <string> viewer-position;
    /// While the full image loads, or why it can't show.
    in property <string> viewer-note;
    in property <string> viewer-item;
    in property <int> viewer-index;
    in property <bool> preview;
    callback close-image;
    callback step-image(int);
    callback save-attachment(string, int);
    callback copy-attachment(string, int);
    callback copy-text(string);
    callback open-link(string);
    pure callback attachment-link(string, int) -> string;
    // What its menu is for, read as it opens, as the arrows change the picture.
    property <string> menu-link;
    property <length> menu-x;
    property <length> menu-y;
    background: #000000e6;
    accessible-role: groupbox;
    accessible-label: "Image viewer";
    TouchArea { clicked => { root.close-image(); } }
    viewer-keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-image(); return accept; }
            if event.text == Key.LeftArrow && root.viewer-position != "" { root.step-image(-1); return accept; }
            if event.text == Key.RightArrow && root.viewer-position != "" { root.step-image(1); return accept; }
            return reject;
        }
        // Shown at full size, shrunk to fit beside the bars and arrows.
        property <length> room-width: root.width - 160px;
        property <length> room-height: root.height - 128px;
        property <length> natural-width: max(1, root.viewer-width) * 1px;
        property <length> natural-height: max(1, root.viewer-height) * 1px;
        property <float> scale: min(1, min(self.room-width / self.natural-width, self.room-height / self.natural-height));
        Picture {
            width: viewer-keys.natural-width * viewer-keys.scale; height: viewer-keys.natural-height * viewer-keys.scale;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            still: root.viewer-image; frames: root.viewer-frames; delays: root.viewer-delays; image-fit: contain;
            accessible-role: image; accessible-label: root.viewer-name;
            TouchArea {
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.menu-link = root.attachment-link(root.viewer-item, root.viewer-index);
                        root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                        root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                        if !root.preview || root.menu-link != "" { image-menu.show(); }
                    }
                }
            }
        }
        HorizontalLayout {
            y: 0px; height: 64px; padding-left: 20px; padding-right: 12px; spacing: 8px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: root.viewer-name; color: #ffffff; font-size: 15px; font-weight: 700; overflow: elide; }
                if root.viewer-position != "": Text { text: root.viewer-position; color: #ffffffb3; font-size: 13px; }
            }
            if !root.preview: Middle {
                IconButton {
                    icon: @image-url("icons/download.svg"); label: "Save " + root.viewer-name; tint: #ffffff;
                    clicked => { root.save-attachment(root.viewer-item, root.viewer-index); }
                }
            }
            Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; tint: #ffffff; clicked => { root.close-image(); } } }
        }
        if root.viewer-position != "": Rectangle {
            x: 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
            background: previous-touch.has-hover ? #ffffff33 : #ffffff1a;
            Image { source: @image-url("icons/chevron-left.svg"); width: 28px; height: 28px; colorize: #ffffff; }
            previous-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(-1); } }
            accessible-role: button; accessible-label: "Previous image";
            accessible-action-default => { root.step-image(-1); }
        }
        if root.viewer-position != "": Rectangle {
            x: parent.width - self.width - 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
            background: next-touch.has-hover ? #ffffff33 : #ffffff1a;
            Image { source: @image-url("icons/chevron-right.svg"); width: 28px; height: 28px; colorize: #ffffff; }
            next-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(1); } }
            accessible-role: button; accessible-label: "Next image";
            accessible-action-default => { root.step-image(1); }
        }
        if root.viewer-note != "": Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height - self.height - 20px;
            width: viewer-note-text.preferred-width + 24px; height: 32px; border-radius: 6px; background: #000000b3;
            viewer-note-text := Text { text: root.viewer-note; color: #ffffffd9; font-size: 13px; }
        }
    }
    image-menu := ViewerMenu {
        item: root.viewer-item; index: root.viewer-index; preview: root.preview;
        link: root.menu-link; at-x: root.menu-x; at-y: root.menu-y;
        room-width: root.width; room-height: root.height;
        copy-image(item, index) => { root.copy-attachment(item, index); }
        save-attachment(item, index) => { root.save-attachment(item, index); }
        copy-text(text) => { root.copy-text(text); }
        open-link(link) => { root.open-link(link); }
        done => { viewer-keys.focus(); }
    }
}

// The video playing, shown large over everything as ImageViewer shows an
// image, enlarged to fit, with its controls under it. Escape, the close
// button or a click outside the video brings it back to its cell; a click
// on it or Space plays or pauses it, and the arrow keys move five seconds.
export component VideoViewer inherits Rectangle {
    in property <bool> preview;
    callback save-attachment(string, int);
    callback copy-text(string);
    callback open-link(string);
    pure callback attachment-link(string, int) -> string;
    // What its menu is for, read as it opens.
    property <string> menu-link;
    property <length> menu-x;
    property <length> menu-y;
    background: #000000e6;
    accessible-role: groupbox;
    accessible-label: "Video viewer";
    TouchArea { clicked => { VideoPlayer.expand(false); } }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { VideoPlayer.expand(false); return accept; }
            if event.text == " " { VideoPlayer.toggle(); return accept; }
            if VideoPlayer.duration > 0 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                VideoPlayer.seek(clamp(VideoPlayer.progress + (event.text == Key.LeftArrow ? -5000 : 5000) / VideoPlayer.duration, 0, 1));
                return accept;
            }
            return reject;
        }
        // Between the title bar and the controls, 16:9 until the file says.
        property <length> room-width: root.width - 80px;
        property <length> room-height: root.height - 128px;
        property <length> natural-width: VideoPlayer.video-width > 0 && VideoPlayer.video-height > 0 ? VideoPlayer.video-width * 1px : 1600px;
        property <length> natural-height: VideoPlayer.video-width > 0 && VideoPlayer.video-height > 0 ? VideoPlayer.video-height * 1px : 900px;
        property <float> scale: min(self.room-width / self.natural-width, self.room-height / self.natural-height);
        screen := Rectangle {
            width: keys.natural-width * keys.scale; height: keys.natural-height * keys.scale;
            x: (parent.width - self.width) / 2; y: 64px + (keys.room-height - self.height) / 2;
            background: #000000;
            init => { VideoPlayer.resize(self.width, self.height); }
            changed width => { VideoPlayer.resize(self.width, self.height); }
            changed height => { VideoPlayer.resize(self.width, self.height); }
            accessible-role: button;
            accessible-label: (VideoPlayer.playing ? "Pause " : "Play ") + VideoPlayer.name;
            accessible-action-default => { VideoPlayer.toggle(); }
            if VideoPlayer.has-frame: Image { width: parent.width; height: parent.height; source: VideoPlayer.frame; image-fit: contain; }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { VideoPlayer.toggle(); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.menu-link = root.attachment-link(VideoPlayer.item, VideoPlayer.index);
                        root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                        root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                        if !root.preview || root.menu-link != "" { video-menu.show(); }
                    }
                }
            }
            if VideoPlayer.loading && VideoPlayer.error == "": Rectangle {
                width: loading.preferred-width + 20px; height: 28px; border-radius: 14px; background: #000000b3;
                loading := Text { text: "Loading..."; color: #ffffff; font-size: 13px; }
            }
            if VideoPlayer.error != "": Rectangle {
                width: min(parent.width - 16px, problem.preferred-width + 20px); height: 28px;
                border-radius: 6px; background: #000000cc;
                problem := Text { text: VideoPlayer.error; color: #ffffff; font-size: 13px; overflow: elide; }
            }
        }
        Rectangle {
            width: max(screen.width, 360px); height: 40px;
            x: (parent.width - self.width) / 2; y: screen.y + screen.height + 8px;
            TouchArea { }
            VideoControls { }
        }
        HorizontalLayout {
            y: 0px; height: 64px; padding-left: 20px; padding-right: 12px; spacing: 8px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: VideoPlayer.name; color: #ffffff; font-size: 15px; font-weight: 700; overflow: elide; }
            }
            if !root.preview: Middle {
                IconButton {
                    icon: @image-url("icons/download.svg"); label: "Save " + VideoPlayer.name; tint: #ffffff;
                    clicked => { root.save-attachment(VideoPlayer.item, VideoPlayer.index); }
                }
            }
            Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Exit full screen"; tint: #ffffff; clicked => { VideoPlayer.expand(false); } } }
        }
    }
    video-menu := ViewerMenu {
        item: VideoPlayer.item; index: VideoPlayer.index; video: true; preview: root.preview;
        link: root.menu-link; at-x: root.menu-x; at-y: root.menu-y;
        room-width: root.width; room-height: root.height;
        save-attachment(item, index) => { root.save-attachment(item, index); }
        copy-text(text) => { root.copy-text(text); }
        open-link(link) => { root.open-link(link); }
        done => { keys.focus(); }
    }
}

// A message's avatar or time, its reply, author line, text, attachments,
// thread and reactions: a timeline row without what scrolls and hovers it,
// for the conversation's timeline and a thread's beside it.
export component MessageContent inherits VerticalLayout {
    in property <MessageRow> message;
    /// The message the pointer or keyboard is on, whose time shows.
    in property <string> active-item;
    in property <bool> preview;
    in property <bool> composer-enabled;
    in property <string> emoji-font;
    in property <length> message-font-size;
    /// Space before the avatar, and after the text for the row's actions.
    in property <length> start-padding: 16px;
    in property <length> end-padding: 48px;
    callback author-card(string, string, length, length, length, length);
    callback author-menu(string, string, length, length);
    callback jump-to(string);
    /// A link in the text, which opens beside the pointer; and one in an embed.
    callback link-clicked(string);
    callback open-link(string);
    callback open-thread(string);
    callback react(string, string);
    callback retry(string);
    callback cancel-send(string);
    callback reveal-attachment(string, int);
    callback view-image(string, int);
    callback save-attachment(string, int);
    callback media-menu(string, int, bool, length, length);
    HorizontalLayout {
        padding-left: root.start-padding; padding-right: root.end-padding; padding-top: 2px; padding-bottom: 2px; spacing: 16px;
        Rectangle {
            width: 40px;
            min-height: message.first && message.notice == "" ? (message.has-reply ? 64px : 40px) : 0px;
            if message.has-reply: Rectangle {
                x: 19px; y: 11px; width: 33px; height: 13px; clip: true;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width + 12px; height: parent.height + 12px;
                    border-width: 2px; border-color: Theme.reply-spine; border-top-left-radius: 6px;
                }
            }
            // As Discord's client marks a notice, in place of the avatar.
            if message.notice != "": Image {
                x: 12px; y: (root.message-font-size * 1.375 - 16px) / 2 + 1px; width: 16px; height: 16px;
                source: message.notice == "pin" ? @image-url("icons/pin.svg")
                    : message.notice == "join" ? @image-url("icons/user-plus.svg")
                    : message.notice == "thread" ? @image-url("icons/thread.svg")
                    : message.notice == "call" ? @image-url("icons/phone.svg")
                    : @image-url("icons/chart-bar.svg");
                colorize: message.notice == "join" || message.notice == "call" ? Theme.live : Theme.muted;
            }
            if message.first && message.notice == "": Avatar {
                x: 0px; y: message.has-reply ? 24px : 2px;
                initial: message.initial; tint: message.tint; picture: message.picture; picture-url: message.picture-url;
                decoration-url: message.decoration-url; animate: root.active-item == message.item;
            }
            // Clicking the author's avatar shows their card beside it;
            // a right click opens their menu. Their name does the same.
            if message.first && message.notice == "" && message.sender != "": TouchArea {
                x: 0px; y: message.has-reply ? 24px : 2px; width: 40px; height: 40px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.author-card(message.item, message.sender, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.author-menu(message.item, message.sender, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            // Right-aligned to the avatar's edge; a time with seconds runs
            // further left, into the padding.
            if !message.first && root.active-item == message.item: Text {
                width: max(40px, self.preferred-width); x: 40px - self.width; y: 4px;
                text: message.short-time; color: Theme.muted; font-size: 12px; font-weight: 500;
                horizontal-alignment: right; overflow: elide;
            }
        }
        VerticalLayout {
            spacing: ClientStyle.message-gap; horizontal-stretch: 1;
            // Clicking the quote jumps to the message it quotes.
            if message.has-reply: Rectangle {
                height: 22px;
                accessible-role: button;
                accessible-enabled: message.reply-item != "";
                accessible-label: "Jump to the original message: " + message.reply-body;
                accessible-action-default => { if message.reply-item != "" { root.jump-to(message.reply-item); } }
                HorizontalLayout {
                    spacing: 6px;
                    if message.reply-author != "": Middle { Avatar { size: 16px; initial: message.reply-initial; tint: message.reply-tint; picture: message.reply-picture; picture-url: message.reply-picture-url; } }
                    if message.reply-author != "": Text {
                        // Discord quotes "@Name" in the author's role colour, regular weight.
                        text: ClientStyle.enabled ? "@" + message.reply-author : message.reply-author;
                        color: ClientStyle.enabled && message.reply-has-color ? message.reply-color : Theme.secondary;
                        font-size: 14px; font-weight: ClientStyle.enabled ? 400 : 700; vertical-alignment: center;
                    }
                    Text {
                        text: message.reply-body; font-size: ClientStyle.enabled ? 13px : 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        color: reply-touch.has-hover ? Theme.text : ClientStyle.enabled ? Theme.secondary : Theme.muted;
                    }
                }
                reply-touch := TouchArea {
                    enabled: message.reply-item != "";
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.jump-to(message.reply-item); }
                }
            }
            if message.first && message.notice == "": HorizontalLayout {
                spacing: 8px;
                // Discord's name line is 22px tall, a little over the text's.
                padding-bottom: ClientStyle.enabled ? 2px : 0px;
                Rectangle {
                    min-width: author-name.min-width; preferred-width: ClientStyle.enabled || message.name-style.length > 0 ? author-plain.preferred-width : author-name.preferred-width;
                    preferred-height: author-name.preferred-height; horizontal-stretch: 0;
                    // Discord's names are medium weight, a step under bold.
                    author-plain := Text {
                        width: parent.width; height: parent.height; visible: ClientStyle.enabled && message.name-style.length == 0;
                        text: message.author; color: message.has-color ? message.color : Theme.text;
                        font-size: root.message-font-size; vertical-alignment: center; overflow: elide;
                        // A styled name measures in its own font.
                        font-family: message.name-style[0].family;
                        font-weight: message.name-style[0].family != "" ? message.name-style[0].weight : 500;
                    }
                    author-name := StyledText {
                        width: parent.width; height: parent.height; visible: !ClientStyle.enabled && message.name-style.length == 0;
                        text: message.author-styled; link-color: Theme.link; default-color: message.has-color ? message.color : Theme.text; default-font-size: root.message-font-size; max-lines: 1; vertical-alignment: center;
                    }
                    if message.name-style.length > 0: StyledName {
                        width: parent.width; height: parent.height;
                        text: message.author; styles: message.name-style; ink: message.has-color ? message.color : Theme.text; font-size: root.message-font-size; font-weight: 500;
                    }
                    // Underlined while pointed at, as a link is.
                    if author-touch.has-hover: Rectangle {
                        y: (parent.height + root.message-font-size) / 2 + 1px; height: 1px;
                        background: message.has-color ? message.color : Theme.text;
                    }
                    author-touch := TouchArea {
                        enabled: message.sender != "";
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.author-card(message.item, message.sender, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                root.author-menu(message.item, message.sender, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
                if message.tag != "": Middle { ServerTagChip { text: message.tag; badge: message.tag-badge; font-size: root.message-font-size * 0.72; } }
                if message.bot: Middle { BotTag { } }
                StyledText { text: message.time-styled; link-color: Theme.link; default-color: Theme.muted; default-font-size: root.message-font-size - (ClientStyle.enabled ? 4px : 3px); max-lines: 1; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            // As Discord's client marks a forward, above what it carries.
            if message.forwarded: HorizontalLayout {
                spacing: 4px; alignment: start;
                Image { source: @image-url("icons/forward.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                Text { text: "Forwarded"; color: Theme.muted; font-size: 14px; font-italic: true; vertical-alignment: center; }
            }
            if message.body != "" && message.blocks.length == 0: StyledText {
                // An overlong word breaks, as in Discord's client, rather than widening the row.
                min-width: 0px;
                text: message.styled; link-color: Theme.link;
                default-color: message.deleted || message.delivery != "" ? Theme.muted : message.notice != "" ? Theme.secondary : Theme.text;
                // Discord's large emoji are 48 pixels where text's are 22.
                default-font-size: message.jumbo ? root.message-font-size * 2.2 : root.message-font-size;
                // A mention's card opens beside the pointer.
                link-clicked(link) => { root.link-clicked(link); }
                accessible-role: text; accessible-label: "Message from " + message.author + ": " + message.body;
            }
            if message.blocks.length > 0: Rectangle {
                accessible-role: text; accessible-label: "Message from " + message.author + ": " + message.body;
                TextBlocks {
                    blocks: message.blocks; font-size: root.message-font-size;
                    color: message.deleted || message.delivery != "" ? Theme.muted : Theme.text;
                    open-link(link) => { root.link-clicked(link); }
                }
            }
            if message.edited && !message.deleted: Text { text: "(edited)"; color: Theme.muted; font-size: 12px; }
            // Fixed-size children sit beside a spacer, so they do not cap the column's width.
            if message.images.length > 0: MessageGallery {
                images: message.images; gallery-width: message.gallery-width; gallery-height: message.gallery-height;
                item: message.item; delivery: message.delivery; active-item: root.active-item; preview: root.preview;
                reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                view-image(id, index) => { root.view-image(id, index); }
                save-attachment(id, index) => { root.save-attachment(id, index); }
                media-menu(id, index, video, x, y) => { root.media-menu(id, index, video, x, y); }
            }
            if message.stickers.length > 0: MessageStickers { stickers: message.stickers; }
            for file in message.files: FileCard {
                file: file; preview: root.preview; delivery: message.delivery;
                save => { root.save-attachment(message.item, file.index); }
            }
            if message.hidden-card != "": Text {
                text: message.hidden-card; color: Theme.muted; font-size: root.message-font-size * 0.875; font-italic: true; wrap: word-wrap;
            }
            if message.has-poll: PollView { poll: message.poll; item: message.item; emoji-font: root.emoji-font; }
            for embed in message.embeds: EmbedView {
                embed: embed; item: message.item;
                open-link(link) => { root.open-link(link); }
                reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                view-image(id, index) => { root.view-image(id, index); }
                media-menu(id, index, video, x, y) => { root.media-menu(id, index, video, x, y); }
            }
            for card in message.cards: CardView {
                card: card; item: message.item; delivery: message.delivery; active-item: root.active-item; preview: root.preview;
                message-font-size: root.message-font-size;
                open-link(link) => { root.open-link(link); }
                reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                view-image(id, index) => { root.view-image(id, index); }
                save-attachment(id, index) => { root.save-attachment(id, index); }
                media-menu(id, index, video, x, y) => { root.media-menu(id, index, video, x, y); }
            }
            if message.thread-room != "": ThreadChip {
                name: message.thread-name; detail: message.thread-detail;
                clicked => { root.open-thread(message.thread-room); }
            }
            if message.reactions.length > 0: HorizontalLayout {
                spacing: 6px; alignment: start; padding-top: 4px;
                for reaction in message.reactions: ReactionToggle {
                    item: message.item; key: reaction.key; label: reaction.label; count: reaction.count; mine: reaction.mine; emoji-font: root.emoji-font;
                    enabled: message.can-react && root.composer-enabled;
                    clicked => { root.react(message.item, reaction.key); }
                }
            }
            if message.delivery != "": HorizontalLayout {
                spacing: 4px; alignment: start;
                Text { text: message.delivery; color: message.delivery-failed ? Theme.danger : Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                if message.can-retry: ActionButton { text: "Retry"; ghost: true; small: true; clicked => { root.retry(message.item); } }
                if message.can-cancel: ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-send(message.item); } }
            }
        }
    }
}
