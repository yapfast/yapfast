// The badge windows: someone's, opened from a badge on their profile, and the
// account's own. See "Badge windows" in docs/discord/people.md.

import { ScrollView } from "scrollview.slint";
import { Theme, Middle } from "theme.slint";
import { ActionButton, IconButton, Avatar, Picture, PictureStore } from "controls.slint";

/// A badge on a profile was clicked: whose, and its number in the window.
export global BadgeWindows {
    callback open(string, int);
}

export struct BadgeLevelRow { name: string, icon: string, owned: bool, milestone: string }

/// A badge in a badge window.
export struct BadgeRow {
    id: int, name: string, owned: bool, description: string, info: string, rarity: string,
    icon: string, art: string, unlocked: string,
    /// The account's own: the next level, how far along to it, from 0 to 1,
    /// and what that means.
    has-next: bool, next-name: string, next-icon: string, progress: float, helper: string,
    levels: [BadgeLevelRow],
    /// Someone's: the badge's name over its level's, and what the date tile
    /// is of. Below, whether it's in beta, from before badges could be
    /// earned, or no longer to be had.
    eyebrow: string, date-label: string, beta: bool, legacy: bool, gone: bool,
    /// Its button's words and the Discord page it opens; quietly drawn once
    /// this account has the badge.
    action: string, action-link: string, action-quiet: bool,
    /// This account has it too, so there's a link to its own.
    view-yours: bool,
}

// A badge's picture, moving when it does.
component BadgePicture inherits Picture {
    in property <string> url;
    still: PictureStore.picture(root.url, PictureStore.revision(root.url));
    frames: PictureStore.frames(root.url, PictureStore.revision(root.url));
    delays: PictureStore.delays(root.url, PictureStore.revision(root.url));
    function request() {
        if root.url != "" && root.still.width == 0 {
            PictureStore.request(root.url);
        }
    }
    init => { root.request(); }
    changed url => { root.request(); }
    image-fit: contain;
}

component BadgeCell inherits Rectangle {
    in property <BadgeRow> badge;
    in property <bool> chosen;
    callback clicked;
    width: 64px; height: 64px; border-radius: 8px;
    background: pointer.has-hover || root.chosen ? Theme.hover : Theme.raised;
    animate background { duration: Theme.quick; }
    border-width: root.chosen ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.badge.name;
    accessible-action-default => { root.clicked(); }
    BadgePicture { width: 36px; height: 36px; url: root.badge.icon; }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// A rarity as Discord's tile has it, in its pill.
component RarityPill inherits Rectangle {
    in property <string> rarity;
    property <color> tone: root.rarity == "Rare" ? #6b8cff : root.rarity == "Epic" ? #b57bff : root.rarity == "Mythic" ? #ffb84d : Theme.secondary;
    width: pill-text.preferred-width + 18px; height: 20px; border-radius: 10px;
    background: root.tone.with-alpha(0.2); border-width: 1px; border-color: root.tone.with-alpha(0.6);
    pill-text := Text { text: root.rarity.to-uppercase(); color: root.tone; font-size: 11px; font-weight: 700; }
}

// A tile under a badge's name: what, then what of.
component BadgeTile inherits Rectangle {
    in property <string> value;
    in property <string> caption;
    /// A rarity, in its pill, in place of the value.
    in property <string> rarity;
    height: 62px; border-radius: 10px; background: Theme.raised;
    VerticalLayout {
        alignment: center; spacing: 4px;
        if root.rarity == "": Text { text: root.value; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
        if root.rarity != "": HorizontalLayout { alignment: center; RarityPill { rarity: root.rarity; } }
        Text { text: root.caption; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
    }
}

// Every level of someone's badge, as Discord's grid has them, the last row in
// the middle; one not reached is dimmed and locked.
component BadgeLevels inherits Rectangle {
    in property <[BadgeLevelRow]> levels;
    property <length> cell-width: self.width / 4;
    property <length> cell-height: 72px;
    property <int> last-start: floor((self.levels.length - 1) / 4) * 4;
    property <int> last-count: self.levels.length - self.last-start;
    height: ceil(self.levels.length / 4) * self.cell-height;
    for level[index] in root.levels: VerticalLayout {
        x: (mod(index, 4) + (index >= root.last-start ? (4 - root.last-count) / 2 : 0)) * root.cell-width;
        y: floor(index / 4) * root.cell-height;
        width: root.cell-width; height: root.cell-height;
        alignment: start; spacing: 3px;
        opacity: level.owned ? 1 : 0.55;
        HorizontalLayout { alignment: center; BadgePicture { width: 30px; height: 30px; url: level.icon; } }
        HorizontalLayout {
            alignment: center; spacing: 3px; padding-left: 2px; padding-right: 2px;
            if !level.owned: Image { source: @image-url("icons/lock.svg"); width: 10px; image-fit: contain; colorize: Theme.muted; }
            Text { text: level.name; color: level.owned ? Theme.text : Theme.muted; font-size: 11px; font-weight: 600; overflow: elide; min-width: 0px; }
        }
        if level.milestone != "": Text { text: level.milestone; color: level.owned ? Theme.secondary : Theme.muted; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    }
}

// A badge window. Given someone's name, it's theirs, as Discord's has it: what
// they own, each in detail with how far they've got. Without, it's the
// account's own: what it has and what it can earn, one in detail.
export component BadgesWindow inherits Rectangle {
    in property <[BadgeRow]> owned;
    in property <[BadgeRow]> available;
    in property <string> note;
    /// Which of those owned shows first.
    in property <int> first;
    /// Whose window it is, shortened as Discord shortens it, with the address
    /// of their avatar; no name for this account's own.
    in property <string> person;
    in property <string> person-avatar;
    /// Discord wouldn't say, so there's a way to ask again.
    in property <bool> failed;
    callback close;
    callback retry;
    /// To this account's window, on this badge if any, by its number.
    callback view-own(int);
    callback open-link(string);
    property <BadgeRow> chosen;
    property <bool> someone: root.person != "";
    property <int> shown-index;
    property <bool> has-chosen: root.chosen.name != "";
    property <bool> levels-open;
    property <length> cell: 72px;
    function pick-at(index: int) {
        root.shown-index = index;
        root.pick(root.owned[index]);
    }
    function pick(badge: BadgeRow) {
        root.chosen = badge;
        root.levels-open = false;
    }
    // The first it has shows until another's picked, and one that changes
    // underneath shows as it now is.
    changed owned => {
        if root.owned.length > 0 && !root.has-chosen {
            root.pick-at(min(root.first, root.owned.length - 1));
        } else if root.someone && root.shown-index < root.owned.length {
            root.chosen = root.owned[root.shown-index];
        }
    }
    // Going from someone's window to the account's starts it afresh.
    property <BadgeRow> none;
    changed person => {
        root.chosen = root.none;
        if root.owned.length > 0 { root.pick-at(min(root.first, root.owned.length - 1)); }
    }
    init => { if root.owned.length > 0 { root.pick-at(min(root.first, root.owned.length - 1)); } }
    width: 720px; height: 560px; border-radius: 12px;
    background: Theme.sidebar; border-color: Theme.edge; border-width: 1px;
    drop-shadow-blur: 32px; drop-shadow-color: #00000099; drop-shadow-offset-y: 8px;
    accessible-role: groupbox;
    accessible-label: root.someone ? root.person + "'s badges" : "Your badges";
    // Clicks on it stay on it.
    TouchArea { }
    HorizontalLayout {
        Rectangle {
            width: 320px;
            VerticalLayout {
                padding: 22px; spacing: 10px; alignment: start;
                if !root.someone: Text { text: "Your badges"; color: Theme.text; font-size: 20px; font-weight: 700; }
                if !root.someone: Text { text: "Browse your badges and discover new ones you can unlock."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                if root.someone: HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Middle { Avatar { size: 24px; initial: root.person; picture-url: root.person-avatar; } }
                    Text { text: root.person + "'s badges"; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; min-width: 0px; }
                }
                if root.someone: Text { text: "Explore their badges, or view your badges to find out what you can unlock next."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                if root.failed: HorizontalLayout {
                    alignment: start;
                    ActionButton { text: "Try Again"; primary: true; small: true; clicked => { root.retry(); } }
                }
                Rectangle {
                    height: ceil(root.owned.length / 4) * root.cell;
                    for badge[index] in root.owned: BadgeCell {
                        x: mod(index, 4) * root.cell; y: floor(index / 4) * root.cell;
                        badge: badge; chosen: root.chosen.id == badge.id && root.has-chosen;
                        clicked => { root.pick-at(index); }
                    }
                }
                if root.available.length > 0: Text { text: "Available to unlock"; color: Theme.text; font-size: 14px; font-weight: 700; }
                Rectangle {
                    height: ceil(root.available.length / 4) * root.cell;
                    for badge[index] in root.available: BadgeCell {
                        x: mod(index, 4) * root.cell; y: floor(index / 4) * root.cell;
                        badge: badge; chosen: root.chosen.id == badge.id && root.has-chosen;
                        clicked => { root.pick(badge); }
                    }
                }
            }
            if root.someone: VerticalLayout {
                y: parent.height - self.height; height: 66px;
                Rectangle { height: 1px; background: Theme.line; }
                VerticalLayout {
                    padding: 14px; padding-bottom: 15px;
                    ActionButton { text: "View Your Badges"; clicked => { root.view-own(-1); } }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        Rectangle {
            clip: true;
            if root.has-chosen && root.someone: person-scroll := ScrollView {
                width: parent.width;
                content-width: self.visible-width;
                content-height: person-detail.preferred-height;
                person-detail := VerticalLayout {
                    width: person-scroll.visible-width;
                    padding: 22px; padding-top: 34px; spacing: 10px;
                    HorizontalLayout { alignment: center; BadgePicture {
                        width: root.chosen.art != root.chosen.icon ? 150px : 96px;
                        height: root.chosen.art != root.chosen.icon ? 120px : 96px;
                        url: root.chosen.art; } }
                    VerticalLayout {
                        spacing: 2px;
                        if root.chosen.eyebrow != "": Text { text: root.chosen.eyebrow; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
                        Text { text: root.chosen.name; color: Theme.text; font-size: 26px; font-weight: 800; font-italic: true; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    // Its beta mark, whose it is and what they've done, with the
                    // link to one's own after it, or under it when that's long.
                    HorizontalLayout {
                        alignment: center; spacing: 5px;
                        if root.chosen.beta: Text { text: "Beta  •"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        Middle { Avatar { size: 16px; initial: root.person; picture-url: root.person-avatar; } }
                        Text { text: root.person + "'s badge"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
                        if root.chosen.info != "": Text { text: "•  " + root.chosen.info; color: Theme.secondary; font-size: 12px; vertical-alignment: center; overflow: elide; min-width: 0px; }
                        if root.chosen.view-yours && !(root.chosen.beta && root.chosen.info != ""): Text { text: "•"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
                        if root.chosen.view-yours && !(root.chosen.beta && root.chosen.info != ""): Text {
                            text: "View yours"; color: Theme.link; font-size: 12px; vertical-alignment: center;
                            accessible-role: button;
                            accessible-action-default => { root.view-own(root.chosen.id); }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.view-own(root.chosen.id); } }
                        }
                    }
                    if root.chosen.view-yours && root.chosen.beta && root.chosen.info != "": HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "View yours"; color: Theme.link; font-size: 12px;
                            accessible-role: button;
                            accessible-action-default => { root.view-own(root.chosen.id); }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.view-own(root.chosen.id); } }
                        }
                    }
                    if root.chosen.unlocked != "" || root.chosen.rarity != "": HorizontalLayout {
                        padding-top: 8px; spacing: 8px;
                        if root.chosen.unlocked != "": BadgeTile { value: root.chosen.unlocked; caption: root.chosen.date-label; }
                        if root.chosen.rarity != "": BadgeTile { rarity: root.chosen.rarity; caption: "Rarity"; }
                    }
                    if root.chosen.description != "" || root.chosen.levels.length > 0 || root.chosen.gone: Rectangle {
                        border-radius: 10px; background: Theme.raised;
                        VerticalLayout {
                            padding: 14px; spacing: 12px;
                            if root.chosen.description != "": HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    if root.chosen.legacy: Text { text: "Legacy Badge"; color: Theme.muted; font-size: 12px; }
                                    Text { text: root.chosen.description; color: Theme.text; font-size: 14px; font-weight: 500; wrap: word-wrap; }
                                }
                                if root.chosen.action != "": Middle {
                                    ActionButton {
                                        text: root.chosen.action; primary: !root.chosen.action-quiet;
                                        horizontal-stretch: 0;
                                        clicked => { root.open-link(root.chosen.action-link); }
                                    }
                                }
                            }
                            if root.chosen.levels.length > 0: Rectangle { height: 1px; background: Theme.line; }
                            if root.chosen.levels.length > 0: Text { text: root.person + "'s Progress"; color: Theme.secondary; font-size: 12px; font-weight: 500; }
                            if root.chosen.levels.length > 0: BadgeLevels { levels: root.chosen.levels; }
                            if root.chosen.gone: Text {
                                text: "This badge is no longer available, but others are waiting. View your badges to see what you can unlock.";
                                color: Theme.secondary; font-size: 12px; wrap: word-wrap;
                                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.view-own(-1); } }
                            }
                        }
                    }
                }
            }
            if root.has-chosen && !root.someone: own-scroll := ScrollView {
                width: parent.width;
                content-width: self.visible-width;
                content-height: detail.preferred-height;
                detail := VerticalLayout {
                    width: own-scroll.visible-width;
                    padding: 22px; padding-top: 14px; spacing: 10px;
                    HorizontalLayout { alignment: center; BadgePicture {
                        // Real art has clear space around it, so it's drawn larger than an
                        // icon, which would only blur.
                        width: root.chosen.art != root.chosen.icon ? 180px : 96px;
                        height: root.chosen.art != root.chosen.icon ? 150px : 96px;
                        url: root.chosen.art; } }
                    Text { text: root.chosen.name; color: Theme.text; font-size: 26px; font-weight: 800; font-italic: true; horizontal-alignment: center; wrap: word-wrap; }
                    if root.chosen.info != "": Text { text: root.chosen.info; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                    if root.chosen.unlocked != "" || root.chosen.rarity != "": HorizontalLayout {
                        spacing: 8px;
                        if root.chosen.unlocked != "": BadgeTile { value: root.chosen.unlocked; caption: "Level unlocked"; }
                        if root.chosen.rarity != "": BadgeTile { rarity: root.chosen.rarity; caption: "Rarity"; }
                    }
                    if root.chosen.description != "" || root.chosen.has-next: Rectangle {
                        border-radius: 8px; background: Theme.raised;
                        VerticalLayout {
                            padding: 14px; spacing: 12px;
                            if root.chosen.description != "": Text { text: root.chosen.description; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                            if root.chosen.has-next: HorizontalLayout {
                                spacing: 10px;
                                Middle { BadgePicture { width: 32px; height: 32px; url: root.chosen.icon; } }
                                VerticalLayout {
                                    spacing: 5px; alignment: center; horizontal-stretch: 1;
                                    Text { text: "Next Level: " + root.chosen.next-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Rectangle {
                                        height: 5px; border-radius: 2.5px; background: Theme.sunken;
                                        Rectangle {
                                            x: 0px; width: parent.width * root.chosen.progress; height: 100%; border-radius: 2.5px; background: Theme.accent;
                                        }
                                    }
                                    if root.chosen.helper != "": Text { text: root.chosen.helper; color: Theme.muted; font-size: 12px; }
                                }
                                Middle { BadgePicture { width: 32px; height: 32px; url: root.chosen.next-icon; } }
                            }
                            if root.chosen.levels.length > 0: Rectangle {
                                height: 26px;
                                accessible-role: button;
                                accessible-label: root.levels-open ? "Hide levels" : "View all levels";
                                accessible-action-default => { root.levels-open = !root.levels-open; }
                                HorizontalLayout {
                                    spacing: 6px; alignment: center;
                                    Text { text: root.levels-open ? "Hide levels" : "View all levels"; color: Theme.secondary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Image {
                                        source: @image-url("icons/chevron-right.svg"); width: 14px; image-fit: contain; colorize: Theme.secondary;
                                        transform-rotation: root.levels-open ? 270deg : 90deg;
                                    }
                                }
                                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.levels-open = !root.levels-open; } }
                            }
                            if root.levels-open: VerticalLayout {
                                spacing: 6px;
                                for level in root.chosen.levels: HorizontalLayout {
                                    spacing: 10px; height: 30px;
                                    Middle { BadgePicture { width: 26px; height: 26px; url: level.icon; opacity: level.owned ? 1 : 0.45; } }
                                    Text { text: level.name; color: level.owned ? Theme.text : Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: level.milestone; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    IconButton {
        x: root.width - self.width - 10px; y: 10px; height: self.width;
        icon: @image-url("icons/x.svg"); label: "Close";
        clicked => { root.close(); }
    }
}
