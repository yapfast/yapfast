// Layered graphite: the rail is darkest, the conversation lightest. Marigold marks
// selection, primary actions and messages that mention you, red mention counts and
// destructive actions, green live voice;
// a microphone's level goes from green through orange to red as it nears clipping.
// These are the Yap theme's colours; the application sets others from Rust
// (src/ui/theme.rs), so the defaults here only paint the first frame.
export global Theme {
    in-out property <color> rail: #111215;
    in-out property <color> sidebar: #17181c;
    in-out property <color> panel: #121316;
    in-out property <color> chat: #1e1f24;
    in-out property <color> stage: #1e1f24;
    in-out property <color> raised: #26272e;
    in-out property <color> field: #2a2b32;
    in-out property <color> sunken: #0e0f12;
    in-out property <color> hover: #222329;
    in-out property <color> active: #2c2d35;
    in-out property <color> row-hover: #1a1b20;
    in-out property <color> line: #2c2d34;
    in-out property <color> edge: #0c0d0f;
    in-out property <color> text: #eef0f4;
    in-out property <color> secondary: #b5b8c1;
    in-out property <color> muted: #8d919c;
    in-out property <color> faint: #5c606a;
    in-out property <color> accent: #ffbf47;
    in-out property <color> accent-hover: #ffcd70;
    in-out property <color> on-accent: #1d1607;
    in-out property <color> accent-soft: #ffbf4726;
    in-out property <color> danger: #f0545e;
    in-out property <color> danger-hover: #f46f77;
    /// Text and icons on a danger fill: badges, the LIVE pill, leaving a call.
    in-out property <color> on-danger: #ffffff;
    in-out property <color> live: #3ecf7e;
    in-out property <color> loud: #ff8c42;
    in-out property <color> link: #7cc4ff;
    /// The neutral ActionButton face.
    in-out property <color> button-default: #33343c;
    in-out property <color> button-default-hover: #3c3d46;
    /// Laid over any surface at a low alpha to lift it on hover, and behind an
    /// emoji still loading: white on a dark theme, black on a light one.
    in-out property <color> overlay: #ffffff;
    /// The light that sweeps across a skeleton while it loads.
    in-out property <color> shimmer: #ffffff10;
    /// The line from a reply's avatar to the message it answers.
    in-out property <color> reply-spine: #4a4c56;
    /// The ground of the window's tooltip and the zoom level's note.
    in-out property <color> tooltip: #0b0c0e;
    /// An avatar's ground before Yapfast knows the person's own tint.
    in-out property <color> avatar: #6b7280;
    /// Whether the theme is dark, for the std-widgets that follow the system's scheme.
    in-out property <bool> dark: true;
    out property <duration> quick: 120ms;
}

// One tooltip for the whole window, drawn above everything else.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    /// 0 above the anchor, 1 to its right, 2 below it.
    in-out property <int> side;
}

// The reaction whose tooltip shows, by message item and key, as Discord's
// client shows it: after the pointer stays on its chip, and until it has left
// both the chip and the tooltip for a moment. `x` and `y` are the chip's top
// centre.
export global ReactionHover {
    in-out property <string> item;
    in-out property <string> key;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> on-chip;
    in-out property <bool> on-tip;
}

// Centres a fixed-size child across a row, which Slint layouts align to the top.
export component Middle inherits VerticalLayout {
    alignment: center;
}

export component Label inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap;
    vertical-stretch: 0;
}

// Whether Discord's things carry its badge. A build without Matrix shows
// nothing else, so it leaves them off.
export global Badges {
    in property <bool> discord: true;
}

// What the Appearance settings turn on and off.
export global Looks {
    in-out property <bool> nameplates: true;
}

// How popups open, as Discord's modals do but quicker: the card grows
// from 80% as it fades in, and shrinks away as it fades out when it
// closes. A popup's dimmed backdrop only fades.
export global Popup {
    /// The card fades as it grows, on the GPU. Skia Software draws a
    /// fading card into a layer as large as what changed, which is the
    /// whole window under a dimmed backdrop, so there the card only grows.
    in property <bool> fade: true;
    out property <duration> duration: 100ms;
    /// The card's size and opacity for how far it's open, from 0 to 1.
    public pure function scale(amount: float) -> float { 0.8 + 0.2 * amount }
    public pure function opacity(amount: float) -> float { root.fade ? amount : (amount > 0 ? 1 : 0) }
}

// The way in and out of a popup shown with `if`: `amount` goes from 0 to
// 1 as it opens and back as it closes, and `shown` stays true until the
// way out ends, which the popup's `if` waits for.
export component PopupMotion {
    in property <bool> open;
    out property <float> amount;
    out property <bool> shown: self.open || self.amount > 0;
    init => { if self.open { self.amount = 1; } }
    changed open => { self.amount = self.open ? 1 : 0; }
    animate amount { duration: Popup.duration; easing: ease-out-quad; }
}
