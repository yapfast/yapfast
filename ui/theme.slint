// Layered graphite: the rail is darkest, the conversation lightest. Marigold marks
// selection, primary actions and messages that mention you, red mention counts and
// destructive actions, green live voice;
// a microphone's level goes from green through orange to red as it nears clipping.
// These are the Yap theme's colours; the application sets others from Rust
// (src/ui/theme.rs), so the defaults here only paint the first frame.
export global Theme {
    in-out property <color> rail: #111215;
    in-out property <color> sidebar: #17181c;
    in-out property <color> panel: #121316;
    in-out property <color> chat: #1e1f24;
    in-out property <color> stage: #1e1f24;
    in-out property <color> raised: #26272e;
    in-out property <color> field: #2a2b32;
    in-out property <color> sunken: #0e0f12;
    in-out property <color> hover: #222329;
    in-out property <color> active: #2c2d35;
    in-out property <color> row-hover: #1a1b20;
    in-out property <color> line: #2c2d34;
    in-out property <color> edge: #0c0d0f;
    /// The faint outline of the sidebar and the top of the window, and under the server name.
    in-out property <color> outline: #2c2d34;
    /// The lines on the conversation's side: under the channel name, and left of the member list.
    in-out property <color> outline-chat: #2c2d34;
    /// The outline of the message box.
    in-out property <color> outline-field: #2c2d34;
    /// The ground of a context menu: on a dark theme Discord's panel, a step
    /// above the raised surfaces (40, 40, 45 on its own dark theme).
    in property <color> menu-set; in property <bool> menu-on;
    out property <color> menu: self.menu-on ? self.menu-set : self.dark ? self.raised.mix(#ffffff, 0.98) : self.raised;
    /// A context menu's outline (53, 53, 59 on Discord's dark theme).
    in property <color> menu-line-set; in property <bool> menu-line-on;
    out property <color> menu-line: self.menu-line-on ? self.menu-line-set : self.dark ? self.line.mix(#000000, 0.95) : self.line;
    in-out property <color> text: #eef0f4;
    in-out property <color> secondary: #b5b8c1;
    in-out property <color> muted: #8d919c;
    in-out property <color> faint: #5c606a;
    in-out property <color> accent: #ffbf47;
    in-out property <color> accent-hover: #ffcd70;
    in-out property <color> on-accent: #1d1607;
    in-out property <color> accent-soft: #ffbf4726;
    // A message that mentions you: Discord's hsl(39.4 100% 48.6%) at 12%, 16% under the pointer.
    in-out property <color> mentioned: #f8a5001f;
    in-out property <color> mentioned-hover: #f8a50029;
    in-out property <color> danger: #f0545e;
    in-out property <color> danger-hover: #f46f77;
    /// A destructive menu row's text and icon, Discord's lighter red on a dark theme.
    /// Discord's composer: a hair lighter than a plain field, with a dimmer placeholder.
    in property <color> composer-set; in property <bool> composer-on;
    out property <color> composer: self.composer-on ? self.composer-set : self.dark ? self.field.mix(#ffffff, 0.99) : self.field;
    in property <color> placeholder-set; in property <bool> placeholder-on;
    out property <color> placeholder: self.placeholder-on ? self.placeholder-set : self.dark ? self.muted.mix(self.field, 0.66) : self.muted;
    out property <color> danger-text: self.dark ? #fa777c : self.danger;
    /// Text and icons on a danger fill: badges, the LIVE pill, leaving a call.
    in-out property <color> on-danger: #ffffff;
    in-out property <color> live: #3ecf7e;
    in-out property <color> loud: #ff8c42;
    in-out property <color> link: #64adf6;
    /// The neutral ActionButton face.
    in-out property <color> button-default: #33343c;
    in-out property <color> button-default-hover: #3c3d46;
    /// Laid over any surface at a low alpha to lift it on hover, and behind an
    /// emoji still loading: white on a dark theme, black on a light one.
    in-out property <color> overlay: #ffffff;
    /// The light that sweeps across a skeleton while it loads.
    in-out property <color> shimmer: #ffffff10;
    /// The line from a reply's avatar to the message it answers.
    in-out property <color> reply-spine: #4a4c56;
    /// The ground of the window's tooltip and the zoom level's note.
    in-out property <color> tooltip: #0b0c0e;
    /// An avatar's ground before Yapfast knows the person's own tint.
    in-out property <color> avatar: #6b7280;
    /// Whether the theme is dark, for the std-widgets that follow the system's scheme.
    in-out property <bool> dark: true;
    /// How long a hover's colour change takes; a theme's motion sets it.
    in-out property <duration> quick: 120ms;

    // Colours only an installed theme sets, each following another colour
    // until it does (see src/ui/theme_look.rs). Plugins can't set these.
    /// The accent drawn as text or an icon on a surface, where a pale or
    /// dark accent fill wouldn't read.
    in property <color> accent-text-set; in property <bool> accent-text-on;
    out property <color> accent-text: self.accent-text-on ? self.accent-text-set : self.accent;
    /// The tooltip's text.
    in property <color> on-tooltip-set; in property <bool> on-tooltip-on;
    out property <color> on-tooltip: self.on-tooltip-on ? self.on-tooltip-set : self.text;
    /// Selected text's ground.
    in property <color> selection-set; in property <bool> selection-on;
    out property <color> selection: self.selection-on ? self.selection-set : self.accent.with-alpha(0.35);
    /// The ring around what has the keyboard's focus.
    in property <color> focus-ring-set; in property <bool> focus-ring-on;
    out property <color> focus-ring: self.focus-ring-on ? self.focus-ring-set : self.accent;
    /// A scrollbar's thumb, and its track while the pointer is on it.
    in property <color> scrollbar-set; in property <bool> scrollbar-on;
    out property <color> scrollbar: self.scrollbar-on ? self.scrollbar-set : self.dark ? #FFFFFF14 : #00000073;
    in property <color> scrollbar-track-set; in property <bool> scrollbar-track-on;
    out property <color> scrollbar-track: self.scrollbar-track-on ? self.scrollbar-track-set : self.dark ? #2C2C2C : #f0f0f0;
    /// The message box's outline while it has the keys.
    in property <color> composer-focus-set; in property <bool> composer-focus-on;
    out property <color> composer-focus: self.composer-focus-on ? self.composer-focus-set : self.muted.with-alpha(0.55);
    /// A selected row's ground (a channel, a settings page) and the pill
    /// beside a selected or unread server.
    in property <color> row-selected-set; in property <bool> row-selected-on;
    out property <color> row-selected: self.row-selected-on ? self.row-selected-set : self.active;
    in property <color> pill-set; in property <bool> pill-on;
    out property <color> pill: self.pill-on ? self.pill-set : self.text;
    /// A switch's track and knob while it's off.
    in property <color> toggle-off-set; in property <bool> toggle-off-on;
    out property <color> toggle-off: self.toggle-off-on ? self.toggle-off-set : self.field;
    in property <color> knob-off-set; in property <bool> knob-off-on;
    out property <color> knob-off: self.knob-off-on ? self.knob-off-set : self.secondary;
    /// The grounds of code blocks and of embeds.
    in property <color> code-set; in property <bool> code-on;
    out property <color> code: self.code-on ? self.code-set : self.panel;
    in property <color> embed-set; in property <bool> embed-on;
    out property <color> embed: self.embed-on ? self.embed-set : self.sidebar;
    /// Whether the theme sets `hover`, which menus' rows then take over their
    /// stock wash.
    in property <bool> hover-on;
    /// The member list's ground: the conversation's, or the sidebar's
    /// without Discord's look.
    in property <color> members-set; in property <bool> members-on;
    /// The APP tag after a bot's name: Discord's blurple.
    in property <color> app-badge-set; in property <bool> app-badge-on;
    out property <color> app-badge: self.app-badge-on ? self.app-badge-set : #5865f2;
    /// What dims the window behind a dialog.
    in property <color> scrim-set; in property <bool> scrim-on;
    /// The dim behind a dialog: a theme's own colour, or what each dialog
    /// draws.
    public pure function scrim(stock: color) -> color { self.scrim-on ? self.scrim-set : stock }

    // Surfaces a theme may paint with a gradient. Each is its colour until a
    // theme sets a brush.
    in property <brush> rail-paint; in property <bool> rail-painted;
    out property <brush> rail-fill: self.rail-painted ? self.rail-paint : self.rail;
    in property <brush> sidebar-paint; in property <bool> sidebar-painted;
    out property <brush> sidebar-fill: self.sidebar-painted ? self.sidebar-paint : self.sidebar;
    in property <brush> chat-paint; in property <bool> chat-painted;
    out property <brush> chat-fill: self.chat-painted ? self.chat-paint : self.chat;
    in property <brush> panel-paint; in property <bool> panel-painted;
    out property <brush> panel-fill: self.panel-painted ? self.panel-paint : self.panel;
    in property <brush> raised-paint; in property <bool> raised-painted;
    out property <brush> raised-fill: self.raised-painted ? self.raised-paint : self.raised;
    in property <brush> accent-paint; in property <bool> accent-painted;
    out property <brush> accent-fill: self.accent-painted ? self.accent-paint : self.accent;
}

/// A surface's shape as a theme sets it. A negative radius, border or blur
/// leaves the stock value; a transparent colour leaves the stock colour.
export struct Shape {
    radius: length,
    border: length,
    border-color: color,
    shadow-blur: length,
    shadow-x: length,
    shadow-y: length,
    shadow-color: color,
}

/// Where a declared animation has moved a slot: its opacity, offset, scale
/// and rotation in degrees.
export struct SlotMotion {
    opacity: float,
    x: length,
    y: length,
    scale: float,
    rotation: float,
}

// What an installed theme sets beyond colours: shape, type, spacing, motion,
// declared animations and text effects. Every default is the stock value, so
// a window without a theme draws exactly as before, and a protected dialog
// (sign-in, permissions, install review) is drawn with these reset. Names
// are public API under theme_api 1; docs/themes.md lists them.
export global Look {
    // Shape, for the surfaces a theme names.
    in property <Shape> button: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> field: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> composer: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> card: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> menu: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> dialog: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> tooltip: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> chip: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> message: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> rail-icon: { radius: -1px, border: -1px, shadow-blur: -1px };
    /// An avatar's radius is a share of its size, in hundredths: 50 a circle.
    in property <Shape> avatar: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> tile: { radius: -1px, border: -1px, shadow-blur: -1px };
    /// Code blocks and embeds: their corners and outline.
    in property <Shape> code: { radius: -1px, border: -1px, shadow-blur: -1px };
    in property <Shape> embed: { radius: -1px, border: -1px, shadow-blur: -1px };
    // Every other corner by its stock size: small (4px and under), medium
    // (up to 8px) and large.
    in property <length> radius-small: -1px;
    in property <length> radius-medium: -1px;
    in property <length> radius-large: -1px;
    // Every other shadow: a theme's one shadow, or each stock one.
    in property <bool> shadows-on;
    in property <length> shadows-blur;
    in property <length> shadows-x;
    in property <length> shadows-y;
    in property <color> shadows-color;

    /// A stock corner radius, as the theme's size classes have it.
    public pure function radius(stock: length) -> length {
        stock <= 0px ? stock
            : stock <= 4px ? (self.radius-small >= 0px ? self.radius-small : stock)
            : stock <= 8px ? (self.radius-medium >= 0px ? self.radius-medium : stock)
            : (self.radius-large >= 0px ? self.radius-large : stock)
    }
    public pure function shadow-blur(stock: length) -> length { self.shadows-on ? self.shadows-blur : stock }
    public pure function shadow-x(stock: length) -> length { self.shadows-on ? self.shadows-x : stock }
    public pure function shadow-y(stock: length) -> length { self.shadows-on ? self.shadows-y : stock }
    public pure function shadow-color(stock: color) -> color { self.shadows-on ? self.shadows-color : stock }
    /// A named surface's radius, border and shadow over the stock values.
    public pure function r(shape: Shape, stock: length) -> length { shape.radius >= 0px ? shape.radius : self.radius(stock) }
    public pure function bw(shape: Shape, stock: length) -> length { shape.border >= 0px ? shape.border : stock }
    public pure function bc(shape: Shape, stock: brush) -> brush { shape.border >= 0px && shape.border-color != transparent ? shape.border-color : stock }
    public pure function sb(shape: Shape, stock: length) -> length { shape.shadow-blur >= 0px ? shape.shadow-blur : self.shadow-blur(stock) }
    public pure function sx(shape: Shape, stock: length) -> length { shape.shadow-blur >= 0px ? shape.shadow-x : self.shadow-x(stock) }
    public pure function sy(shape: Shape, stock: length) -> length { shape.shadow-blur >= 0px ? shape.shadow-y : self.shadow-y(stock) }
    public pure function sc(shape: Shape, stock: color) -> color { shape.shadow-blur >= 0px ? shape.shadow-color : self.shadow-color(stock) }

    // Type: a typeface per role, registered from the theme's own files, and
    // its size, weight and letter spacing. Empty and negative leave stock.
    in property <string> font-body;
    in property <string> font-headings;
    in property <string> font-names;
    in property <string> font-code;
    in property <string> font-labels;
    in property <length> size-headings: -1px;
    in property <length> size-names: -1px;
    in property <length> size-code: -1px;
    in property <length> size-labels: -1px;
    in property <int> weight-body: -1;
    in property <int> weight-headings: -1;
    /// The open conversation's and the server's names, and page and dialog
    /// titles, apart from other headings; negative follows headings.
    in property <length> size-header: -1px;
    in property <length> size-title: -1px;
    in property <int> weight-names: -1;
    in property <int> weight-labels: -1;
    in property <length> spacing-body;
    in property <length> spacing-headings;
    in property <length> spacing-names;
    in property <length> spacing-labels;
    in property <bool> headings-upper;
    out property <string> mono: self.font-code != "" ? self.font-code : "monospace";
    public pure function heading-font(stock: string) -> string { self.font-headings != "" ? self.font-headings : stock }
    public pure function heading-size(stock: length) -> length { self.size-headings >= 0px ? self.size-headings : stock }
    public pure function header-size(stock: length) -> length { self.size-header >= 0px ? self.size-header : self.heading-size(stock) }
    public pure function title-size(stock: length) -> length { self.size-title >= 0px ? self.size-title : self.heading-size(stock) }
    public pure function heading-weight(stock: int) -> int { self.weight-headings >= 0 ? self.weight-headings : stock }
    public pure function heading(text: string) -> string { self.headings-upper ? text.to-uppercase() : text }
    public pure function name-font(stock: string) -> string { self.font-names != "" ? self.font-names : stock }
    public pure function name-size(stock: length) -> length { self.size-names >= 0px ? self.size-names : stock }
    public pure function name-weight(stock: int) -> int { self.weight-names >= 0 ? self.weight-names : stock }
    public pure function label-font(stock: string) -> string { self.font-labels != "" ? self.font-labels : stock }
    public pure function label-size(stock: length) -> length { self.size-labels >= 0px ? self.size-labels : stock }
    public pure function label-weight(stock: int) -> int { self.weight-labels >= 0 ? self.weight-labels : stock }
    public pure function code-size(stock: length) -> length { self.size-code >= 0px ? self.size-code : stock }

    // Spacing beyond ClientStyle's: the message avatar, the chat's side
    // padding and the member list's rows. Negative leaves stock.
    in property <length> avatar-size: -1px;
    in property <length> chat-padding: -1px;
    in property <length> member-row-height: -1px;

    // Motion. `hover` 0 fade (stock), 1 none, 2 lift, 3 glow, 4 scale;
    // `press` 0 none, 1 scale, 2 sink; `open` 0 grow (stock), 1 none,
    // 2 fade, 3 zoom, 4 pop; `close-instant` closes popups at once.
    in property <int> hover;
    in property <int> press;
    in property <int> open;
    in property <bool> close-instant;
    /// The curve things move on, by its index in Curve::ALL.
    in property <int> curve: 3;
    in property <duration> popup: 100ms;
    out property <easing> curve-easing: self.curve == 0 ? linear : self.curve == 1 ? ease : self.curve == 2 ? ease-in
        : self.curve == 4 ? ease-in-out : self.curve == 5 ? ease-out-back : self.curve == 6 ? ease-out-bounce
        : self.curve == 7 ? ease-out-elastic : ease-out-quad;
    /// A button's or row's lift, glow and scale for its hover and press.
    public pure function lift(hovered: bool, pressed: bool) -> length {
        (hovered && self.hover == 2 && !pressed ? -1px : 0px) + (pressed && self.press == 2 ? 1px : 0px)
    }
    public pure function grow(hovered: bool, pressed: bool) -> float {
        pressed && self.press == 1 ? 0.96 : hovered && self.hover == 4 ? 1.04 : 1
    }
    public pure function halo(hovered: bool) -> length { hovered && (self.hover == 2 || self.hover == 3) ? (self.hover == 3 ? 14px : 8px) : 0px }
    public pure function halo-color(hovered: bool, glow: color) -> color {
        hovered && self.hover == 3 ? glow.with-alpha(0.55) : hovered && self.hover == 2 ? #00000055 : transparent
    }

    // Declared animations, by slot; src/ui/theme_look.rs moves them.
    in property <SlotMotion> home: { opacity: 1, scale: 1 };
    in property <SlotMotion> unread: { opacity: 1, scale: 1 };
    in property <SlotMotion> mention: { opacity: 1, scale: 1 };
    in property <SlotMotion> typing: { opacity: 1, scale: 1 };
    in property <SlotMotion> channel-name: { opacity: 1, scale: 1 };
    in property <SlotMotion> server-name: { opacity: 1, scale: 1 };
    in property <SlotMotion> profile-name: { opacity: 1, scale: 1 };
    in property <SlotMotion> own-avatar: { opacity: 1, scale: 1 };
    /// A layer over the whole window that takes no input.
    in property <color> window-tint: transparent;

    // Text effects: whether each text slot plays one, and the text it shows
    // at `tick`, which advances only while one is playing.
    in property <bool> fx-channel;
    in property <bool> fx-server;
    in property <bool> fx-profile;
    in property <bool> fx-settings;
    in property <bool> fx-welcome;
    in property <int> fx-tick;
    /// The text slot (its index in TextSlot::ALL), the text, and the tick.
    pure callback fx(int, string, int) -> string;
    public pure function channel-text(text: string) -> string { self.fx-channel ? self.fx(0, text, self.fx-tick) : text }
    public pure function server-text(text: string) -> string { self.fx-server ? self.fx(1, text, self.fx-tick) : text }
    public pure function profile-text(text: string) -> string { self.fx-profile ? self.fx(2, text, self.fx-tick) : text }
    public pure function settings-text(text: string) -> string { self.fx-settings ? self.fx(3, text, self.fx-tick) : text }
    public pure function welcome-text(text: string) -> string { self.fx-welcome ? self.fx(4, text, self.fx-tick) : text }
}

// One tooltip for the whole window, drawn above everything else.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    /// 0 above the anchor, 1 to its right, 2 below it.
    in-out property <int> side;
    /// Whether it pops up with a fade, as a badge's does, not at once.
    in-out property <bool> pop;
}

// The tooltip of a badge that levels up, as Discord's client shows it: a
// large picture of the level, the kind of badge, the level and how far along
// the person is. Empty `title` hides it. `x` and `y` are the badge's top
// centre.
export global BadgeTip {
    in-out property <string> kind;
    in-out property <string> title;
    in-out property <string> progress;
    in-out property <string> picture-url;
    in-out property <length> x;
    in-out property <length> y;
}

// The reaction whose tooltip shows, by message item and key, as Discord's
// client shows it: after the pointer stays on its chip, and until it has left
// both the chip and the tooltip for a moment. `x` and `y` are the chip's top
// centre.
export global ReactionHover {
    in-out property <string> item;
    in-out property <string> key;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> on-chip;
    in-out property <bool> on-tip;
}

// Centres a fixed-size child across a row, which Slint layouts align to the top.
export component Middle inherits VerticalLayout {
    alignment: center;
}

export component Label inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap;
    vertical-stretch: 0;
}

// Twemoji, as Discord's client draws emoji: `text` gives back a text with each
// emoji in it as the glyph of Twemoji's font that draws its picture, so a
// reaction, a poll's answer or an emoji shown by itself draws Twemoji's picture
// whole, a flag or a skin tone included, and never the system's emoji.
export global Twemoji {
    pure callback text(string) -> string;
}

// Whether Discord's things carry its badge. A build without Matrix shows
// nothing else, so it leaves them off.
// The profile switches in Settings → Appearance. The Rust side keeps them in
// layout.json and leaves out what's off before anything is fetched; see
// Cosmetics in the core.
export global Looks {
    in-out property <bool> profile-effects: true;
    in-out property <bool> decorations: true;
    in-out property <bool> moving: true;
    in-out property <bool> name-styles: true;
    in-out property <bool> server-tags: true;
}

export global Badges {
    in property <bool> discord: true;
}

// How popups open, as Discord's modals do but quicker: the card grows
// from 80% as it fades in, and shrinks away as it fades out when it
// closes. A popup's dimmed backdrop only fades.
export global Popup {
    /// The card fades as it grows, on the GPU. Skia Software draws a
    /// fading card into a layer as large as what changed, which is the
    /// whole window under a dimmed backdrop, so there the card only grows.
    in property <bool> fade: true;
    /// A theme's open transition sets how long and on what curve.
    out property <duration> duration: Look.open == 1 ? 0ms : Look.popup;
    /// The card's size and opacity for how far it's open, from 0 to 1: it
    /// grows from 80% (stock), shows at once, only fades, grows from 95%, or
    /// overshoots on its curve, as a theme's `motion.open` says.
    public pure function scale(amount: float) -> float {
        Look.open == 1 || Look.open == 2 ? 1 : Look.open == 3 ? 0.95 + 0.05 * amount : 0.8 + 0.2 * amount
    }
    public pure function opacity(amount: float) -> float { root.fade && Look.open != 1 ? amount : (amount > 0 ? 1 : 0) }
}

// The way in and out of a popup shown with `if`: `amount` goes from 0 to
// 1 as it opens and back as it closes, and `shown` stays true until the
// way out ends, which the popup's `if` waits for.
export component PopupMotion {
    in property <bool> open;
    out property <float> amount;
    out property <bool> shown: self.open || self.amount > 0;
    init => { if self.open { self.amount = 1; } }
    changed open => { self.amount = self.open ? 1 : 0; }
    animate amount { duration: !self.open && Look.close-instant ? 0ms : Popup.duration; easing: Look.open == 4 ? ease-out-back : Look.curve-easing; }
}
