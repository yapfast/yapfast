import { Theme, Middle } from "theme.slint";
import { ActionButton, IconButton, Avatar, SpoilerCover } from "controls.slint";
import { EmojiCell, EmojiFace } from "messages.slint";

/// A file waiting to go with the next message. A spoiler's picture is blurred.
export struct StagedFile { name: string, size: string, has-picture: bool, picture: image, spoiler: bool }

// A file waiting to go with the next message: its picture or a file icon, its
// name and size, and buttons that mark it as a spoiler, where the room has
// them, and take it out.
export component StagedTile inherits Rectangle {
    in property <StagedFile> file;
    in property <bool> can-spoil;
    callback remove;
    callback toggle-spoiler;
    width: 120px; height: 140px; border-radius: 8px; background: Theme.raised;
    accessible-role: groupbox;
    accessible-label: root.file.name + ", " + root.file.size + (root.file.spoiler ? ", spoiler" : "");
    VerticalLayout {
        padding: 6px; spacing: 2px;
        Rectangle {
            height: 86px; border-radius: 6px; clip: true; background: Theme.sidebar;
            if root.file.has-picture: Image { width: parent.width; height: parent.height; source: root.file.picture; image-fit: cover; }
            if !root.file.has-picture: Image {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 32px; height: 32px; source: @image-url("icons/file.svg"); colorize: Theme.muted;
            }
            if root.file.spoiler: SpoilerCover { width: parent.width; height: parent.height; }
        }
        Text { text: root.file.name; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
        Text { text: root.file.size; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
    if root.can-spoil: Rectangle {
        x: parent.width - 2 * self.width - 8px; y: 4px; width: 28px; height: 28px; border-radius: 14px;
        background: #000000b3;
        IconButton {
            icon: root.file.spoiler ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            label: root.file.spoiler ? "Stop covering " + root.file.name : "Mark " + root.file.name + " as a spoiler";
            size: 28px; glyph: 16px; radius: 14px; tint: #ffffff;
            clicked => { root.toggle-spoiler(); }
        }
    }
    Rectangle {
        x: parent.width - self.width - 4px; y: 4px; width: 28px; height: 28px; border-radius: 14px;
        background: #000000b3;
        IconButton {
            icon: @image-url("icons/x.svg"); label: "Remove " + root.file.name;
            size: 28px; glyph: 16px; radius: 14px; tint: #ffffff;
            clicked => { root.remove(); }
        }
    }
}

// The message composer is in composer-field.slint, which messages.slint uses too.
export { Composer } from "composer-field.slint";

// Someone or something the `@` word being typed may mention.
export struct MentionRow {
    name: string, initial: string, tint: color, picture: image,
    // The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    // A role or a group such as @everyone, or a channel, rather than a person.
    group: bool,
    // What a group's mark shows: "@", or "#" for a channel.
    sigil: string,
    // A voice channel, whose mark is a speaker instead.
    voice: bool,
    // Their username, or what a group reaches, such as "Everyone in this channel".
    detail: string,
    // The heading over the first member and the first role, such as "MEMBERS".
    heading: string,
}

// Suggestions just above the composer, as wide as it: Up and Down choose, Tab or
// Enter or a click takes one, Escape closes them.
export component SuggestionFrame inherits Rectangle {
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
}

component SuggestionHeading inherits Text {
    color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.4px;
    height: 24px; vertical-alignment: center;
}

// Mention suggestions: members, then roles, each under its heading, or channels.
export component MentionList inherits SuggestionFrame {
    in property <[MentionRow]> mentions;
    /// The highlighted one.
    in property <int> mention-index;
    callback mention-chosen(int);
    height: suggestions.preferred-height;
    suggestions := VerticalLayout {
        padding: 6px; spacing: 0px;
        for mention[index] in root.mentions: VerticalLayout {
            if mention.heading != "": HorizontalLayout { padding-left: 6px; SuggestionHeading { text: mention.heading; } }
            Rectangle {
                height: 36px; border-radius: 6px;
                background: index == root.mention-index ? Theme.active : pick.has-hover ? Theme.hover : transparent;
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-chosen(index); }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 10px; spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        if !mention.group: Avatar { size: 24px; initial: mention.initial; tint: mention.tint; picture: mention.picture; }
                        if mention.group: Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: (mention.has-color ? mention.color : Theme.muted).with-alpha(0.2);
                            if !mention.voice: Text { text: mention.sigil; color: mention.has-color ? mention.color : Theme.secondary; font-size: 13px; font-weight: 700; }
                            if mention.voice: Image { source: @image-url("icons/volume-2.svg"); width: 14px; height: 14px; colorize: Theme.secondary; }
                        }
                    }
                    Text {
                        text: mention.name; vertical-alignment: center; overflow: elide;
                        color: mention.has-color ? mention.color : Theme.text; font-size: 14px; font-weight: 600;
                    }
                    Text {
                        text: mention.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        color: Theme.muted; font-size: 13px;
                    }
                }
            }
        }
    }
}

// Emoji for the `:name` being typed, each with its name.
export component EmojiSuggestions inherits SuggestionFrame {
    in property <[EmojiCell]> emoji;
    /// The name typed so far, without its colon.
    in property <string> query;
    /// The highlighted one.
    in property <int> emoji-index;
    in property <string> emoji-font;
    callback emoji-chosen(int);
    height: suggestions.preferred-height;
    suggestions := VerticalLayout {
        padding: 6px; spacing: 0px;
        HorizontalLayout { padding-left: 6px; SuggestionHeading { text: "EMOJI MATCHING :" + root.query; } }
        for cell[index] in root.emoji: Rectangle {
            height: 36px; border-radius: 6px;
            background: index == root.emoji-index ? Theme.active : pick.has-hover ? Theme.hover : transparent;
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.emoji-chosen(index); }
            }
            HorizontalLayout {
                padding-left: 8px; padding-right: 10px; spacing: 10px;
                EmojiFace { emoji: cell; font: root.emoji-font; side: 20px; width: 24px; }
                Text {
                    text: cell.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    color: Theme.text; font-size: 14px; font-weight: 600;
                }
            }
        }
    }
}

// A Discord message request in place of the composer, answered rather than
// written to.
export component RequestBar inherits Rectangle {
    /// What the request is, such as who sent it.
    in property <string> request-title;
    callback accept-request;
    callback ignore-request;
    background: Theme.field; border-radius: 10px;
    HorizontalLayout {
        padding: 12px; padding-left: 16px; spacing: 10px;
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            // One line each: a wrapped line would spill over the hint below.
            Text { text: root.request-title; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
            Text { text: "Accept to reply. Ignoring removes it without telling them."; color: Theme.secondary; font-size: 14px; overflow: elide; }
        }
        Middle { ActionButton { text: "Ignore"; label: "Ignore the message request"; clicked => { root.ignore-request(); } } }
        Middle { ActionButton { text: "Accept"; label: "Accept the message request"; primary: true; clicked => { root.accept-request(); } } }
    }
}
