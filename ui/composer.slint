import { Theme, Middle } from "theme.slint";
import { ActionButton, IconButton, Avatar, SpoilerCover, ContextMenu, MenuRow } from "controls.slint";
import { EmojiCell, EmojiFace } from "messages.slint";

/// A file waiting to go with the next message. A spoiler's picture is blurred.
export struct StagedFile { name: string, size: string, has-picture: bool, picture: image, spoiler: bool }

// A file waiting to go with the next message: its picture or a file icon, its
// name and size, and buttons that mark it as a spoiler, where the room has
// them, and take it out.
export component StagedTile inherits Rectangle {
    in property <StagedFile> file;
    in property <bool> can-spoil;
    callback remove;
    callback toggle-spoiler;
    width: 120px; height: 140px; border-radius: 8px; background: Theme.raised;
    accessible-role: groupbox;
    accessible-label: root.file.name + ", " + root.file.size + (root.file.spoiler ? ", spoiler" : "");
    VerticalLayout {
        padding: 6px; spacing: 2px;
        Rectangle {
            height: 86px; border-radius: 6px; clip: true; background: Theme.sidebar;
            if root.file.has-picture: Image { width: parent.width; height: parent.height; source: root.file.picture; image-fit: cover; }
            if !root.file.has-picture: Image {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 32px; height: 32px; source: @image-url("icons/file.svg"); colorize: Theme.muted;
            }
            if root.file.spoiler: SpoilerCover { width: parent.width; height: parent.height; }
        }
        Text { text: root.file.name; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
        Text { text: root.file.size; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
    if root.can-spoil: Rectangle {
        x: parent.width - 2 * self.width - 8px; y: 4px; width: 28px; height: 28px; border-radius: 14px;
        background: #000000b3;
        IconButton {
            icon: root.file.spoiler ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            label: root.file.spoiler ? "Stop covering " + root.file.name : "Mark " + root.file.name + " as a spoiler";
            size: 28px; glyph: 16px; radius: 14px; tint: #ffffff;
            clicked => { root.toggle-spoiler(); }
        }
    }
    Rectangle {
        x: parent.width - self.width - 4px; y: 4px; width: 28px; height: 28px; border-radius: 14px;
        background: #000000b3;
        IconButton {
            icon: @image-url("icons/x.svg"); label: "Remove " + root.file.name;
            size: 28px; glyph: 16px; radius: 14px; tint: #ffffff;
            clicked => { root.remove(); }
        }
    }
}

// The message composer. Text wraps and the field grows to about ten lines, then
// scrolls to keep the cursor in view. Enter sends; Shift+Enter starts a new line.
// A right click opens Discord's menu for the field, without its spelling
// suggestions and with Select All, which Discord's lacks.
export component Composer inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <string> label;
    in property <length> text-size: 16px;
    // Mention or emoji suggestions show, so the arrow keys, Tab, Enter and Escape
    // go to them.
    in property <bool> suggesting;
    /// The field has the keys, which the box around it shows.
    out property <bool> focused: input.has-focus;
    callback edited(string);
    callback accepted;
    // The text and the cursor's byte offset in it, after an edit or a move.
    callback caret(string, int);
    callback suggestion-moved(int);
    callback suggestion-chosen;
    callback suggestion-dismissed;
    // Up in an empty composer, and Alt+Up anywhere in it.
    callback up-from-empty;
    callback up-to-messages;
    /// Escape was pressed; whether it was taken, as by cancelling a reply.
    callback escaped() -> bool;
    /// The field took the keyboard.
    callback got-focus;
    // Ctrl+V and the menu's Paste: the clipboard may hold files or a picture
    // rather than text, so the application looks first and, finding text,
    // pastes it with paste-text.
    callback paste;
    // Ctrl+G and Ctrl+E, as Discord's: open the GIFs, 0, or the emoji, 1.
    callback expressions(int);
    public function paste-text() { input.paste(); }
    public function focus-input() { input.focus(); }
    public function place-caret(offset: int) { input.set-selection-offsets(offset, offset); }
    in property <length> pad: 12px;
    // Room above and below the text inside the part that scrolls and clips it, as an
    // emoji is taller than its line.
    property <length> overhang: 4px;
    property <length> line: root.text-size * 1.5;
    // Where the menu opens: the pointer, from the composer's corner.
    property <length> menu-x;
    property <length> menu-y;
    property <bool> has-selection: input.anchor-position-byte-offset != input.cursor-position-byte-offset;
    property <MenuRow> paste-row: { id: "paste", text: "Paste", icon: @image-url("icons/clipboard-paste.svg") };
    property <MenuRow> select-all-row: { id: "select-all", text: "Select All", icon: @image-url("icons/text-select.svg") };
    property <[MenuRow]> menu-rows: root.has-selection
        ? [
            { id: "cut", text: "Cut", icon: @image-url("icons/scissors.svg") },
            { id: "copy", text: "Copy", icon: @image-url("icons/copy.svg") },
            root.paste-row, root.select-all-row,
        ]
        : [root.paste-row, root.select-all-row];
    horizontal-stretch: 1;
    height: max(48px, min(input.preferred-height + 2 * root.pad, 10 * root.line + 2 * root.pad));
    Text {
        x: 6px; y: root.pad; width: root.width - 12px; height: root.line;
        visible: root.text == "";
        text: root.placeholder; color: root.enabled ? Theme.placeholder : Theme.faint; font-size: root.text-size;
        vertical-alignment: center; overflow: elide;
    }
    FocusScope {
        x: 6px; y: root.pad - root.overhang; width: root.width - 12px;
        height: root.height - 2 * root.pad + 2 * root.overhang;
        capture-key-pressed(event) => {
            if root.suggesting {
                if event.text == Key.UpArrow { root.suggestion-moved(-1); return accept; }
                if event.text == Key.DownArrow { root.suggestion-moved(1); return accept; }
                if (event.text == Key.Return || event.text == Key.Tab) && !event.modifiers.shift { root.suggestion-chosen(); return accept; }
                if event.text == Key.Escape { root.suggestion-dismissed(); return accept; }
            }
            if event.text == Key.Escape && root.escaped() { return accept; }
            if event.text == Key.UpArrow && event.modifiers.alt { root.up-to-messages(); return accept; }
            if event.text == Key.UpArrow && root.text == "" && !event.modifiers.shift && !event.modifiers.control {
                root.up-from-empty();
                return accept;
            }
            if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt {
                root.accepted();
                return accept;
            }
            if (event.text == "v" || event.text == "V") && event.modifiers.control && !event.modifiers.alt && root.enabled {
                root.paste();
                return accept;
            }
            if (event.text == "g" || event.text == "G" || event.text == "e" || event.text == "E")
                && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && root.enabled {
                root.expressions(event.text == "g" || event.text == "G" ? 0 : 1);
                return accept;
            }
            return reject;
        }
        // Behind the field, which leaves it right clicks.
        TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.enabled {
                    input.focus();
                    root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                    root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                    edit-menu.show();
                }
            }
        }
        flick := Flickable {
            content-height: input.height + 2 * root.overhang;
            // Mouse presses go to the field, or with the right button past it.
            mouse-drag-pan-enabled: false;
            input := TextInput {
                y: root.overhang;
                width: flick.width;
                height: max(flick.height - 2 * root.overhang, self.preferred-height);
                text <=> root.text;
                enabled: root.enabled;
                single-line: false;
                wrap: word-wrap;
                font-size: root.text-size;
                color: root.enabled ? Theme.text : Theme.muted;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.label;
                changed has-focus => { if self.has-focus { root.got-focus(); } }
                edited => { root.edited(self.text); root.caret(self.text, self.cursor-position-byte-offset); }
                cursor-position-changed(position) => {
                    root.caret(self.text, self.cursor-position-byte-offset);
                    if position.y + flick.content-y < 0px {
                        flick.content-y = -position.y;
                    } else if position.y + root.line + 2 * root.overhang + flick.content-y > flick.height {
                        flick.content-y = flick.height - position.y - root.line - 2 * root.overhang;
                    }
                }
            }
        }
    }
    // Above the pointer, as the composer sits at the window's foot, unless
    // the window's top is too near.
    edit-menu := PopupWindow {
        x: root.menu-x;
        y: root.absolute-position.y + root.menu-y - edit-content.main-height >= 8px
            ? root.menu-y - edit-content.main-height : root.menu-y;
        width: edit-content.content-width; height: edit-content.content-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        edit-content := ContextMenu {
            rows: root.menu-rows;
            chose(id) => {
                edit-menu.close();
                input.focus();
                if id == "cut" { input.cut(); }
                else if id == "copy" { input.copy(); }
                else if id == "paste" { root.paste(); }
                else if id == "select-all" { input.select-all(); }
            }
            close => { edit-menu.close(); }
        }
    }
}

// Someone or something the `@` word being typed may mention.
export struct MentionRow {
    name: string, initial: string, tint: color, picture: image,
    // The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    // A role or a group such as @everyone, or a channel, rather than a person.
    group: bool,
    // What a group's mark shows: "@", or "#" for a channel.
    sigil: string,
    // A voice channel, whose mark is a speaker instead.
    voice: bool,
    // Their username, or what a group reaches, such as "Everyone in this channel".
    detail: string,
    // The heading over the first member and the first role, such as "MEMBERS".
    heading: string,
}

// Suggestions just above the composer, as wide as it: Up and Down choose, Tab or
// Enter or a click takes one, Escape closes them.
export component SuggestionFrame inherits Rectangle {
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
}

component SuggestionHeading inherits Text {
    color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.4px;
    height: 24px; vertical-alignment: center;
}

// Mention suggestions: members, then roles, each under its heading, or channels.
export component MentionList inherits SuggestionFrame {
    in property <[MentionRow]> mentions;
    /// The highlighted one.
    in property <int> mention-index;
    callback mention-chosen(int);
    height: suggestions.preferred-height;
    suggestions := VerticalLayout {
        padding: 6px; spacing: 0px;
        for mention[index] in root.mentions: VerticalLayout {
            if mention.heading != "": HorizontalLayout { padding-left: 6px; SuggestionHeading { text: mention.heading; } }
            Rectangle {
                height: 36px; border-radius: 6px;
                background: index == root.mention-index ? Theme.active : pick.has-hover ? Theme.hover : transparent;
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-chosen(index); }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 10px; spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        if !mention.group: Avatar { size: 24px; initial: mention.initial; tint: mention.tint; picture: mention.picture; }
                        if mention.group: Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: (mention.has-color ? mention.color : Theme.muted).with-alpha(0.2);
                            if !mention.voice: Text { text: mention.sigil; color: mention.has-color ? mention.color : Theme.secondary; font-size: 13px; font-weight: 700; }
                            if mention.voice: Image { source: @image-url("icons/volume-2.svg"); width: 14px; height: 14px; colorize: Theme.secondary; }
                        }
                    }
                    Text {
                        text: mention.name; vertical-alignment: center; overflow: elide;
                        color: mention.has-color ? mention.color : Theme.text; font-size: 14px; font-weight: 600;
                    }
                    Text {
                        text: mention.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        color: Theme.muted; font-size: 13px;
                    }
                }
            }
        }
    }
}

// Emoji for the `:name` being typed, each with its name.
export component EmojiSuggestions inherits SuggestionFrame {
    in property <[EmojiCell]> emoji;
    /// The name typed so far, without its colon.
    in property <string> query;
    /// The highlighted one.
    in property <int> emoji-index;
    in property <string> emoji-font;
    callback emoji-chosen(int);
    height: suggestions.preferred-height;
    suggestions := VerticalLayout {
        padding: 6px; spacing: 0px;
        HorizontalLayout { padding-left: 6px; SuggestionHeading { text: "EMOJI MATCHING :" + root.query; } }
        for cell[index] in root.emoji: Rectangle {
            height: 36px; border-radius: 6px;
            background: index == root.emoji-index ? Theme.active : pick.has-hover ? Theme.hover : transparent;
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.emoji-chosen(index); }
            }
            HorizontalLayout {
                padding-left: 8px; padding-right: 10px; spacing: 10px;
                EmojiFace { emoji: cell; font: root.emoji-font; side: 20px; width: 24px; }
                Text {
                    text: cell.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    color: Theme.text; font-size: 14px; font-weight: 600;
                }
            }
        }
    }
}

// A Discord message request in place of the composer, answered rather than
// written to.
export component RequestBar inherits Rectangle {
    /// What the request is, such as who sent it.
    in property <string> request-title;
    callback accept-request;
    callback ignore-request;
    background: Theme.field; border-radius: 10px;
    HorizontalLayout {
        padding: 12px; padding-left: 16px; spacing: 10px;
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            // One line each: a wrapped line would spill over the hint below.
            Text { text: root.request-title; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
            Text { text: "Accept to reply. Ignoring removes it without telling them."; color: Theme.secondary; font-size: 14px; overflow: elide; }
        }
        Middle { ActionButton { text: "Ignore"; label: "Ignore the message request"; clicked => { root.ignore-request(); } } }
        Middle { ActionButton { text: "Accept"; label: "Accept the message request"; primary: true; clicked => { root.accept-request(); } } }
    }
}
