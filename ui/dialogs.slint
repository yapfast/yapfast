import { ScrollView } from "scrollview.slint";
import { Theme, Middle, Label, Popup } from "theme.slint";
import { ActionButton, IconButton, Avatar, TextField, MenuItem } from "controls.slint";
import { DiscordBadge } from "discord.slint";
import { StatusDot } from "rail.slint";
import { EmojiCell, EmojiFace } from "messages.slint";
import { Choices } from "settings.slint";

// Someone the new conversation dialog found.
export struct ContactRow {
    name: string, detail: string, initial: string, tint: color, picture: image, discord: bool,
}

/// A place to forward a message to, or for the quick switcher to go to.
export struct PlaceRow {
    id: string, name: string, place: string, icon: image, initial: string, tint: color,
    /// Shown as an avatar: a DM's person or group icon, or a channel's or
    /// server's server icon; otherwise as the channel icon.
    avatar: bool, picture-url: string,
    /// Chosen to forward the message to.
    chosen: bool,
    /// Unread, and its mentions of this account as a count; empty for none.
    unread: bool, badge: string,
}

// The custom status: an emoji from the picker, words, and when it clears.
export component StatusDialog inherits Rectangle {
    in-out property <string> status-text;
    in-out property <EmojiCell> status-emoji;
    /// Never, 30 minutes, an hour, four hours or today.
    in-out property <int> status-clear-after;
    in property <bool> has-custom-status;
    in property <bool> status-saving;
    in property <string> status-error;
    in property <string> emoji-font;
    /// The emoji picker is wanted, beside where it last opened, or beside
    /// what asked for it, at this place in the window.
    callback pick-emoji;
    callback pick-emoji-beside(length, length, length, length);
    callback save-status;
    callback clear-status;
    callback close-status;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close-status(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(460px, root.width - 48px); height: status-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Set a custom status";
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-status(); return accept; }
                return reject;
            }
            status-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "Set a custom status"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-status(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 40px; height: 40px; border-radius: 6px;
                        background: status-emoji-touch.has-hover ? Theme.hover : Theme.sunken;
                        accessible-role: button;
                        accessible-label: root.status-emoji.glyph != "" ? "Emoji, " + root.status-emoji.name + ". Change it" : "Pick an emoji";
                        accessible-action-default => { root.pick-emoji(); }
                        if root.status-emoji.glyph != "": EmojiFace { emoji: root.status-emoji; font: root.emoji-font; side: 22px; }
                        if root.status-emoji.glyph == "": Image {
                            source: @image-url("icons/smile-plus.svg"); width: 20px; colorize: Theme.secondary;
                        }
                        status-emoji-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.pick-emoji-beside(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                        }
                        // Taking the emoji off: a small badge on its corner.
                        if root.status-emoji.glyph != "": Rectangle {
                            x: parent.width - 12px; y: -6px; width: 18px; height: 18px; border-radius: 9px;
                            background: remove-touch.has-hover ? Theme.danger : Theme.faint;
                            border-width: 2px; border-color: Theme.raised;
                            accessible-role: button;
                            accessible-label: "Remove the emoji";
                            accessible-action-default => { root.status-emoji = { glyph: "", name: "", key: "" }; }
                            Image { source: @image-url("icons/x.svg"); width: 10px; colorize: Theme.text; }
                            remove-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.status-emoji = { glyph: "", name: "", key: "" }; }
                            }
                        }
                    }
                    TextField {
                        init => { self.focus-input(); }
                        min-height: 40px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                        placeholder: "What's happening?"; label: "Status"; text <=> root.status-text;
                        accepted => { root.save-status(); }
                    }
                }
                Text { text: "CLEAR AFTER"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                Choices {
                    label: "Clear after"; options: ["Never", "30 min", "1 hour", "4 hours", "Today"];
                    current <=> root.status-clear-after;
                }
                if root.status-error != "": Text { text: root.status-error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; padding-top: 4px;
                    if root.has-custom-status: ActionButton {
                        text: "Clear status"; ghost: true; enabled: !root.status-saving;
                        clicked => { root.clear-status(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { text: "Cancel"; ghost: true; clicked => { root.close-status(); } }
                    ActionButton {
                        text: root.status-saving ? "Saving..." : "Save"; primary: true; enabled: !root.status-saving;
                        clicked => { root.save-status(); }
                    }
                }
            }
        }
    }
}

// Starting a DM: find someone on Discord or Matrix, then open the conversation
// with them, which starts it if there's none yet.
export component NewDmDialog inherits Rectangle {
    in-out property <string> new-dm-query;
    /// Matrix ids can be typed too.
    in property <bool> matrix;
    /// Who it found, and whether one is starting.
    in property <[ContactRow]> new-dm-people;
    in property <bool> new-dm-starting;
    in property <string> new-dm-note;
    callback new-dm-search;
    callback start-dm(int);
    callback close-new-dm;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close-new-dm(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: min(520px, root.height - 48px);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "New message";
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-new-dm(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "New message"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-new-dm(); } }
                }
                TextField {
                    init => { self.focus-input(); }
                    min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: root.matrix ? "Find a friend, or type a Matrix id" : "Find a friend"; label: "Find people"; text <=> root.new-dm-query;
                    edited => { root.new-dm-search(); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px; alignment: start;
                        for person[index] in root.new-dm-people: Rectangle {
                            height: 48px; border-radius: 6px;
                            background: person-touch.has-hover && !root.new-dm-starting ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: "Message " + person.name + ", " + person.detail;
                            accessible-action-default => { root.start-dm(index); }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 12px;
                                Middle {
                                    Rectangle {
                                        width: 36px; height: 32px;
                                        Avatar { x: 0; y: 0; size: 32px; initial: person.initial; tint: person.tint; picture: person.picture; }
                                        if person.discord: DiscordBadge { x: 18px; y: 16px; size: 14px; ring: Theme.raised; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                    Text { text: person.detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                                }
                                Middle {
                                    ActionButton { text: "Message"; small: true; primary: person-touch.has-hover; enabled: !root.new-dm-starting; clicked => { root.start-dm(index); } }
                                }
                            }
                            person-touch := TouchArea {
                                enabled: !root.new-dm-starting; mouse-cursor: MouseCursor.pointer;
                                clicked => { root.start-dm(index); }
                            }
                        }
                        if root.new-dm-note != "": HorizontalLayout {
                            padding: 8px;
                            Label { text: root.new-dm-note; }
                        }
                    }
                }
            }
        }
    }
}

// Forwarding a message, as Discord's client does: choose up to five
// conversations, add a message if you like, and send. Clicking outside or
// Escape closes it.
export component ForwardDialog inherits Rectangle {
    in property <string> forward-preview;
    in property <[PlaceRow]> forward-targets;
    in-out property <string> forward-query;
    in-out property <string> forward-note;
    /// How many conversations are chosen, and the most there may be.
    in property <int> forward-chosen;
    in property <int> forward-limit;
    /// Says the list is empty, and why.
    in property <string> forward-empty;
    /// Says which chosen channels won't get the message added, for their
    /// slowmode; empty when none.
    in property <string> forward-slowmode;
    /// Why the last try failed, and where.
    in property <string> forward-error;
    callback forward-search;
    callback forward-choose(string);
    callback forward-send(string);
    callback close-forward;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close-forward(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: min(600px, root.height - 48px);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Forward To";
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-forward(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Forward To"; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text {
                            text: root.forward-chosen < root.forward-limit ? "Select where you want to share this message." : "Maximum " + root.forward-limit + " places at once.";
                            color: Theme.secondary; font-size: 14px; overflow: elide;
                        }
                    }
                    Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-forward(); } } }
                }
                TextField {
                    init => { self.focus-input(); }
                    min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: "Search"; label: "Search"; text <=> root.forward-query;
                    edited => { root.forward-search(); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px; alignment: start;
                        for target in root.forward-targets: Rectangle {
                            property <bool> can-choose: target.chosen || root.forward-chosen < root.forward-limit;
                            height: 48px; border-radius: 6px;
                            background: target-touch.has-hover && self.can-choose ? Theme.hover : transparent;
                            opacity: self.can-choose ? 1 : 0.5;
                            accessible-role: checkbox;
                            accessible-checked: target.chosen;
                            accessible-label: target.name + ", " + target.place;
                            accessible-action-default => { if self.can-choose { root.forward-choose(target.id); } }
                            target-touch := TouchArea {
                                enabled: parent.can-choose; mouse-cursor: MouseCursor.pointer;
                                clicked => { root.forward-choose(target.id); }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 12px;
                                if target.avatar: Middle { Avatar { size: 32px; initial: target.initial; tint: target.tint; picture-url: target.picture-url; } }
                                if !target.avatar: Middle {
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 16px; background: Theme.field;
                                        Image { source: target.icon; width: 18px; height: 18px; colorize: Theme.secondary; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text { text: target.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                    Text { text: target.place; color: Theme.muted; font-size: 13px; overflow: elide; }
                                }
                                Middle {
                                    Rectangle {
                                        width: 22px; height: 22px; border-radius: 6px;
                                        background: target.chosen ? Theme.accent : transparent;
                                        border-width: target.chosen ? 0px : 2px; border-color: Theme.faint;
                                        if target.chosen: Image { source: @image-url("icons/check.svg"); width: 16px; height: 16px; colorize: Theme.on-accent; }
                                    }
                                }
                            }
                        }
                        if root.forward-targets.length == 0: HorizontalLayout {
                            padding: 8px;
                            Label { text: root.forward-empty; }
                        }
                    }
                }
                // The message, as a quote.
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { width: 3px; border-radius: 1.5px; background: Theme.line; }
                    Text { text: root.forward-preview; color: Theme.secondary; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
                TextField {
                    min-height: 40px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: "Add an optional message..."; label: "Add an optional message"; text <=> root.forward-note;
                    accepted => { if root.forward-chosen > 0 { root.forward-send(root.forward-note); } }
                }
                if root.forward-note != "" && root.forward-slowmode != "": Label { text: root.forward-slowmode; }
                if root.forward-error != "": Label { text: root.forward-error; color: Theme.danger; }
                HorizontalLayout {
                    alignment: end;
                    ActionButton {
                        text: root.forward-chosen > 1 ? "Send (" + root.forward-chosen + ")" : "Send";
                        primary: true; enabled: root.forward-chosen > 0;
                        clicked => { root.forward-send(root.forward-note); }
                    }
                }
            }
        }
    }
}

// Discord's quick switcher, which Ctrl+K opens: a search of the
// conversations and servers to go to, those opened lately before a search.
// The arrow keys choose, Enter goes, and clicking outside or Escape closes.
export component QuickSwitcher inherits Rectangle {
    in property <[PlaceRow]> switcher-places;
    in-out property <string> switcher-query;
    callback switcher-search(string);
    callback switch-to(string);
    callback close-switcher;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    /// The place Enter goes to.
    property <int> chosen: 0;
    property <int> current: min(root.chosen, root.switcher-places.length - 1);
    property <length> pitch: 40px;
    /// Scrolls the chosen place into view.
    function reveal() {
        if root.current * root.pitch + list.content-y < 0 {
            list.content-y = -root.current * root.pitch;
        } else if (root.current + 1) * root.pitch + list.content-y > list.visible-height {
            list.content-y = list.visible-height - (root.current + 1) * root.pitch;
        }
    }
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close-switcher(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(570px, root.width - 48px); height: min(440px, root.height - 48px);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Quick switcher";
        TouchArea { }
        FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.close-switcher(); return accept; }
                if root.switcher-places.length == 0 && (event.text == Key.DownArrow || event.text == Key.UpArrow
                    || event.text == Key.Tab || event.text == Key.Backtab) {
                    return accept;
                }
                if event.text == Key.DownArrow || (event.text == Key.Tab && !event.modifiers.shift) {
                    root.chosen = root.current + 1 < root.switcher-places.length ? root.current + 1 : 0;
                    root.reveal();
                    return accept;
                }
                if event.text == Key.UpArrow || event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                    root.chosen = root.current > 0 ? root.current - 1 : root.switcher-places.length - 1;
                    root.reveal();
                    return accept;
                }
                if event.text == Key.Return {
                    if root.current >= 0 { root.switch-to(root.switcher-places[root.current].id); }
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                padding: 16px; spacing: 12px;
                TextField {
                    init => { self.focus-input(); }
                    min-height: 52px; text-size: 20px; pad: 14px; fill: Theme.sunken;
                    placeholder: "Where would you like to go?"; label: "Where would you like to go?";
                    text <=> root.switcher-query;
                    edited(text) => {
                        root.chosen = 0;
                        list.content-y = 0;
                        root.switcher-search(text);
                    }
                }
                if root.switcher-query == "" && root.switcher-places.length > 0: Text {
                    text: "PREVIOUS CHANNELS"; color: Theme.muted; font-size: 12px; font-weight: 700;
                }
                list := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for place[index] in root.switcher-places: Rectangle {
                            height: root.pitch; border-radius: 6px;
                            background: index == root.current ? Theme.active : place-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: place.name + ", " + place.place
                                + (place.badge != "" ? ", " + place.badge + " mentions" : place.unread ? ", unread" : "");
                            accessible-action-default => { root.switch-to(place.id); }
                            place-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.switch-to(place.id); }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                if place.avatar: Middle { Avatar { size: 24px; initial: place.initial; tint: place.tint; picture-url: place.picture-url; } }
                                if !place.avatar: Middle {
                                    Image { source: place.icon; width: 20px; height: 20px; colorize: Theme.faint; }
                                }
                                Text {
                                    text: place.name; vertical-alignment: center; overflow: elide;
                                    color: place.unread || index == root.current ? Theme.text : Theme.secondary;
                                    font-size: 16px; font-weight: place.unread ? 700 : 500;
                                }
                                Text {
                                    text: place.place; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                    color: Theme.muted; font-size: 13px;
                                }
                                if place.badge != "": Middle {
                                    Rectangle {
                                        width: max(18px, badge-text.preferred-width + 10px); height: 18px; border-radius: 9px; background: Theme.danger;
                                        badge-text := Text { text: place.badge; color: Theme.on-danger; font-size: 11px; font-weight: 700; }
                                    }
                                }
                            }
                        }
                        if root.switcher-places.length == 0 && root.switcher-query != "": HorizontalLayout {
                            padding: 8px;
                            Label { text: "Nothing goes by that name."; }
                        }
                    }
                }
                Text {
                    text: "Start a search with @ for people, # for text channels, ! for voice channels or * for servers.";
                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }
            }
        }
    }
}

// Asks before opening a link whose text shows something other than where it
// goes, as Discord's client does, naming the site it really leads to.
export component LeavingDialog inherits Rectangle {
    in property <string> link;
    in property <string> site;
    callback visit;
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Leaving Yapfast";
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                if event.text == Key.Return { root.visit(); return accept; }
                return reject;
            }
            content := VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "Leaving Yapfast"; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text { text: "This link goes to"; color: Theme.secondary; font-size: 15px; }
                Text { text: root.site; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                Rectangle {
                    background: Theme.sunken; border-radius: 6px;
                    height: link-text.preferred-height + 16px;
                    link-text := Text {
                        x: 10px; width: parent.width - 20px;
                        text: root.link; color: Theme.secondary; font-size: 14px; wrap: char-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    ActionButton { text: "Go back"; ghost: true; clicked => { root.close(); } }
                    ActionButton { text: "Visit site"; primary: true; clicked => { root.visit(); } }
                }
            }
        }
    }
}

// A status in the status menu: its dot, its name and what it does, with a
// check beside the current one.
component StatusOption inherits Rectangle {
    in property <string> key;
    in property <string> name;
    in property <string> note;
    in property <bool> checked;
    callback clicked;
    height: max(36px, content.preferred-height);
    border-radius: 4px;
    background: pointer.has-hover ? Theme.active : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.note;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    content := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
        Middle {
            StatusDot {
                presence: root.key == "invisible" ? "offline" : root.key;
                ring: pointer.has-hover ? Theme.active : Theme.raised;
            }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text {
                text: root.name; font-size: 15px; font-weight: root.checked ? 700 : 400;
                color: root.checked || pointer.has-hover ? Theme.text : Theme.secondary;
            }
            if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        if root.checked: Middle {
            Image { source: @image-url("icons/check.svg"); width: 16px; image-fit: contain; colorize: Theme.accent; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

// The account's Discord status, picked from a menu over the account panel as
// in Discord, and the ways into its custom status and its profile.
export component StatusMenu inherits Rectangle {
    /// "online", "idle", "dnd" or "invisible".
    in property <string> status;
    in property <bool> has-custom-status;
    in property <string> game-name;
    in property <string> game-duration;
    /// Asks for `game-duration` again; it changes by the minute.
    callback game-duration-due;
    callback choose(string);
    callback custom-status;
    callback edit-profile;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox;
    accessible-label: "Status";
    VerticalLayout {
        padding: 6px; spacing: 2px;
        if root.game-name != "": VerticalLayout {
            padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 6px; spacing: 2px;
            Text { text: root.game-name; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
            Text { text: root.game-duration == "" ? "Playing now" : "Playing for " + root.game-duration; color: Theme.secondary; font-size: 12px; }
            Rectangle { height: 1px; background: Theme.line; }
            Timer { interval: 20s; running: root.game-duration != ""; triggered => { root.game-duration-due(); } }
        }
        for option in [
            { key: "online", name: "Online", note: "" },
            { key: "idle", name: "Idle", note: "" },
            { key: "dnd", name: "Do Not Disturb", note: "You won't get message notifications." },
            { key: "invisible", name: "Invisible", note: "You'll show as offline, but can use Yapfast as usual." },
        ]: StatusOption {
            key: option.key; name: option.name; note: option.note; checked: root.status == option.key;
            clicked => { root.choose(option.key); }
        }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px;
            Rectangle { height: 1px; background: Theme.line; }
        }
        MenuItem {
            text: root.has-custom-status ? "Change custom status" : "Set a custom status";
            icon: @image-url("icons/smile-plus.svg");
            clicked => { root.custom-status(); }
        }
        MenuItem {
            text: "Edit Profile";
            icon: @image-url("icons/user-pen.svg");
            clicked => { root.edit-profile(); }
        }
    }
}

/// A dialog from a DM's or a server member's menu about its person.
export struct PersonPrompt {
    title: string,
    /// What it explains, under the title.
    text: string,
    /// Choices to pick one of, such as a timeout's length, under a heading;
    /// and which is picked.
    options-heading: string,
    options: [string],
    chosen: int,
    /// What its field is for, as its label; empty for a dialog that only asks.
    field: string,
    /// What its button says, and whether it does something hard to undo.
    confirm: string,
    danger: bool,
    /// The field's text is on its way, or what was asked is.
    loading: bool,
    saving: bool,
    error: string,
}

// Writing a note on someone or the nickname you give them, making sure
// before unfriending or blocking them, or in a server, their nickname, or a
// timeout, kick or ban with how long or how much and a reason.
export component PersonDialog inherits Rectangle {
    in property <PersonPrompt> prompt;
    in-out property <string> text;
    callback answer(string);
    callback choose(int);
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(440px, root.width - 48px); height: person-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.title;
        TouchArea { }
        person-keys := FocusScope {
            init => { if root.prompt.field == "" { self.focus(); } }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                if event.text == "\n" && root.prompt.field == "" { root.answer(""); return accept; }
                return reject;
            }
            person-content := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.prompt.title; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                if root.prompt.text != "": Label { text: root.prompt.text; }
                if root.prompt.options.length > 0: VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.prompt.options-heading; color: Theme.muted;
                        font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                    }
                    for option[index] in root.prompt.options: MenuItem {
                        text: option; checked: index == root.prompt.chosen;
                        clicked => { root.choose(index); }
                    }
                }
                if root.prompt.field != "": TextField {
                    // A note takes the keys once it's here.
                    init => { if self.enabled { self.focus-input(); } }
                    changed enabled => { if self.enabled { self.focus-input(); } }
                    enabled: !root.prompt.loading;
                    min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                    placeholder: root.prompt.loading ? "Loading..." : root.prompt.field; label: root.prompt.field;
                    text <=> root.text;
                    accepted => { root.answer(root.text); }
                }
                if root.prompt.error != "": Text {
                    text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    ActionButton { text: "Cancel"; ghost: true; clicked => { root.close(); } }
                    ActionButton {
                        text: root.prompt.confirm; primary: !root.prompt.danger; danger: root.prompt.danger;
                        enabled: !root.prompt.loading && !root.prompt.saving;
                        clicked => { root.answer(root.text); }
                    }
                }
            }
        }
    }
}

/// One of a message's reactions in its Reactions window: `label` shows the
/// emoji, `name` names it, as `:name:`. For a poll's voters, it's an answer:
/// `label` its emoji, if any, and `name` its text.
export struct ReactionPill { key: string, label: string, name: string, count: int }

/// Someone who reacted, as the Reactions window lists them.
export struct ReactorRow {
    id: string, name: string, username: string, avatar: string, initial: string, tint: color,
    /// This account may remove their reaction: its own, or as a moderator.
    removable: bool,
}

// A message's reactions and who reacted with each, as Discord's "Reactions"
// window shows them: the reactions down the left, the most first, and the
// chosen one's people on the right, a page at a time. Clicking outside or
// Escape closes it. It lists a poll's voters the same way, by answer.
export component ReactionsDialog inherits Rectangle {
    in property <[ReactionPill]> reaction-pills;
    in property <bool> voters;
    in property <string> reactions-key;
    in property <[ReactorRow]> reactor-rows;
    in property <bool> reactors-loading;
    in property <bool> reactors-more;
    in property <string> reactors-error;
    in property <string> emoji-font;
    callback select-reaction(string);
    callback more-reactors;
    callback remove-reactor(string);
    callback close-reactions;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close-reactions(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(600px, root.width - 48px); height: min(720px, root.height - 96px);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.voters ? "Votes" : "Reactions";
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-reactions(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding-top: 16px; spacing: 0px;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 16px; padding-bottom: 12px;
                    Text { text: root.voters ? "Votes" : "Reactions"; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-reactions(); } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 24px; vertical-stretch: 1;
                    // The reactions, the most first, or the answers.
                    Rectangle {
                        width: root.voters ? 220px : 98px;
                        ScrollView {
                            width: parent.width - 1px; x: 0px;
                            VerticalLayout {
                                padding-top: 12px; padding-right: 16px; alignment: start;
                                for pill in root.reaction-pills: Rectangle {
                                    property <bool> chosen: pill.key == root.reactions-key;
                                    height: 40px;
                                    Rectangle {
                                        y: 0px; height: 32px; border-radius: 8px;
                                        background: parent.chosen ? Theme.active : pill-touch.has-hover ? Theme.hover : transparent;
                                        accessible-role: button;
                                        accessible-label: pill.name + " " + pill.count + (root.voters ? (pill.count == 1 ? " vote" : " votes") : (pill.count == 1 ? " reaction" : " reactions"));
                                        accessible-checked: parent.chosen;
                                        accessible-action-default => { root.select-reaction(pill.key); }
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 8px; spacing: 8px;
                                            if !root.voters || pill.label != "": Text { text: pill.label; font-family: root.emoji-font; font-size: 20px; width: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                            if root.voters: Text { text: pill.name; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: pill.count; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        pill-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.select-reaction(pill.key); }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
                    }
                    // Who reacted with the chosen one.
                    people := ScrollView {
                        horizontal-stretch: 1;
                        changed content-y => { root.near-end(); }
                        changed content-height => { root.near-end(); }
                        VerticalLayout {
                            padding-top: 8px; padding-bottom: 8px; alignment: start;
                            for person in root.reactor-rows: Rectangle {
                                height: 52px;
                                // Holds the row, its X button among it, so it stays hovered over that.
                                person-touch := TouchArea {
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                                        Middle { Avatar { size: 32px; initial: person.initial; tint: person.tint; picture-url: person.avatar; } }
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 1;
                                            Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                            if person.username != "": Text { text: person.username; color: Theme.muted; font-size: 12px; overflow: elide; }
                                        }
                                        if person.removable && person-touch.has-hover: Middle {
                                            IconButton {
                                                icon: @image-url("icons/x.svg"); label: "Remove Reaction"; size: 28px; glyph: 16px;
                                                clicked => { root.remove-reactor(person.id); }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.reactors-loading || root.reactors-more: Rectangle {
                                height: 52px;
                                Label { text: "Loading..."; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.reactors-error != "": HorizontalLayout {
                                padding: 16px;
                                Label { text: root.reactors-error; }
                            }
                        }
                    }
                }
            }
        }
    }
    // The next page comes as the list nears its end, as in Discord's client.
    function near-end() {
        if root.reactors-more && !root.reactors-loading
            && -people.content-y + people.visible-height >= people.content-height - 52px {
            root.more-reactors();
        }
    }
    changed reactors-more => { root.near-end(); }
    changed reactors-loading => { root.near-end(); }
}

/// An answer of the poll being made: its emoji, if it has one, and text.
export struct PollAnswerDraft { id: int, text: string, emoji: EmojiCell }

// Making a Discord poll, as Discord's "Create a Poll" dialog does: the
// question, up to ten answers, each with an emoji if wanted, how long it
// takes votes, and whether several answers may be picked. Clicking outside
// or Escape closes it.
export component PollDialog inherits Rectangle {
    in-out property <string> question;
    /// "12 / 300", as the question grows.
    in property <string> question-count;
    in property <[PollAnswerDraft]> answers;
    /// Its place among the durations offered.
    in property <int> duration;
    in property <bool> multiselect;
    in property <bool> can-add;
    in property <bool> can-post;
    in property <bool> posting;
    /// What's too long, or why posting failed.
    in property <string> problem;
    in property <string> emoji-font;
    callback question-edited(string);
    callback answer-edited(int, string);
    /// An answer's emoji is wanted from the picker, beside this place.
    callback pick-emoji(int, length, length, length, length);
    callback remove-emoji(int);
    callback add-answer;
    callback remove-answer(int);
    callback choose-duration(int);
    callback set-multiselect(bool);
    callback post;
    callback close;
    /// How far it's open, from 0 to 1; see PopupMotion.
    in property <float> motion: 1;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(500px, root.width - 48px);
        height: min(root.height - 48px, head.preferred-height + form.preferred-height + foot.preferred-height + 40px);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Create a Poll";
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 0px;
                head := HorizontalLayout {
                    padding-bottom: 12px;
                    Text { text: "Create a Poll"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    form := VerticalLayout {
                        spacing: 8px; alignment: start;
                        HorizontalLayout {
                            Text { text: "QUESTION"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; horizontal-stretch: 1; }
                            Text { text: root.question-count; color: Theme.muted; font-size: 12px; }
                        }
                        TextField {
                            init => { self.focus-input(); }
                            min-height: 40px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                            placeholder: "What question do you want to ask?"; label: "Question"; text <=> root.question;
                            edited(text) => { root.question-edited(text); }
                        }
                        Text { text: "ANSWERS"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                        for answer[index] in root.answers: HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: 6px;
                                background: emoji-touch.has-hover ? Theme.hover : Theme.sunken;
                                accessible-role: button;
                                accessible-label: answer.emoji.glyph != "" ? "Emoji, " + answer.emoji.name + ". Change it" : "Add emoji, answer " + (index + 1);
                                accessible-action-default => { root.pick-emoji(index, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                if answer.emoji.glyph != "": EmojiFace { emoji: answer.emoji; font: root.emoji-font; side: 22px; }
                                if answer.emoji.glyph == "": Image {
                                    source: @image-url("icons/smile-plus.svg"); width: 20px; colorize: Theme.secondary;
                                }
                                emoji-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.pick-emoji(index, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                }
                                // Taking the emoji off: a small badge on its corner.
                                if answer.emoji.glyph != "": Rectangle {
                                    x: parent.width - 12px; y: -6px; width: 18px; height: 18px; border-radius: 9px;
                                    background: remove-emoji-touch.has-hover ? Theme.danger : Theme.faint;
                                    border-width: 2px; border-color: Theme.raised;
                                    accessible-role: button;
                                    accessible-label: "Remove the emoji";
                                    accessible-action-default => { root.remove-emoji(index); }
                                    Image { source: @image-url("icons/x.svg"); width: 10px; colorize: Theme.text; }
                                    remove-emoji-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.remove-emoji(index); }
                                    }
                                }
                            }
                            TextField {
                                min-height: 40px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                                placeholder: "Type your answer"; label: "Answer " + (index + 1);
                                text: answer.text;
                                edited(text) => { root.answer-edited(index, text); }
                            }
                            if root.answers.length > 1: Middle {
                                IconButton {
                                    icon: @image-url("icons/trash-2.svg"); label: "Remove answer " + (index + 1); size: 32px; glyph: 18px;
                                    clicked => { root.remove-answer(index); }
                                }
                            }
                        }
                        if root.can-add: HorizontalLayout {
                            alignment: start;
                            ActionButton {
                                text: "Add another answer"; ghost: true; small: true; icon: @image-url("icons/circle-plus.svg");
                                clicked => { root.add-answer(); }
                            }
                        }
                        Text { text: "DURATION"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                        Choices {
                            label: "Duration"; options: ["1 hour", "4 hours", "8 hours", "1 day", "3 days", "1 week", "2 weeks"];
                            max-width: 460px; current: root.duration;
                            chosen(index) => { root.choose-duration(index); }
                        }
                        // Discord's "Allow Multiple Answers", a checkbox.
                        Rectangle {
                            accessible-role: checkbox;
                            accessible-checked: root.multiselect;
                            accessible-label: "Allow Multiple Answers";
                            accessible-action-default => { root.set-multiselect(!root.multiselect); }
                            HorizontalLayout {
                                spacing: 10px; padding-top: 4px;
                                Middle {
                                    Rectangle {
                                        width: 20px; height: 20px; border-radius: 5px;
                                        background: root.multiselect ? Theme.accent : transparent;
                                        border-width: root.multiselect ? 0px : 2px; border-color: Theme.faint;
                                        if root.multiselect: Image { source: @image-url("icons/check.svg"); width: 14px; height: 14px; colorize: Theme.on-accent; }
                                    }
                                }
                                Text { text: "Allow Multiple Answers"; color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.set-multiselect(!root.multiselect); }
                            }
                        }
                    }
                }
                foot := VerticalLayout {
                    spacing: 8px; padding-top: 12px;
                    if root.problem != "": Text { text: root.problem; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        ActionButton { text: "Cancel"; ghost: true; clicked => { root.close(); } }
                        ActionButton {
                            text: root.posting ? "Posting..." : "Post"; primary: true; enabled: root.can-post;
                            clicked => { root.post(); }
                        }
                    }
                }
            }
        }
    }
}
