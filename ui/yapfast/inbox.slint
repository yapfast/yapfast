import { Theme, Middle } from "../theme.slint";
import { Avatar } from "../controls.slint";

/// One line of the inbox: a channel or conversation with something waiting,
/// or a friend request. `kind` is 0 for a mention, 1 for an unread, 2 for a request.
export struct InboxRow {
    id: string, name: string, place: string, initial: string, tint: color, picture-url: string,
    count: int, kind: int, direct: bool,
}

component InboxTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: root.selected ? Theme.overlay.with-alpha(0.12) : pointer.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 12px; width: parent.width - 24px; text: root.text; font-size: 14px; font-weight: 600;
        color: root.selected ? Theme.text : Theme.secondary; vertical-alignment: center; horizontal-alignment: center;
        overflow: elide;
    }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component InboxLine inherits Rectangle {
    in property <InboxRow> entry;
    callback clicked;
    height: 56px;
    border-radius: 4px;
    background: pointer.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.entry.name + ", " + root.entry.place;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding: 8px; spacing: 12px;
        Middle {
            width: 32px;
            Avatar {
                size: 32px;
                initial: root.entry.initial; tint: root.entry.tint; picture-url: root.entry.picture-url;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: root.entry.name; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.entry.place; font-size: 12px; color: Theme.muted; overflow: elide; }
        }
        if root.entry.count > 0: Middle {
            Rectangle {
                width: max(16px, count-text.preferred-width + 10px); height: 16px; border-radius: 8px;
                background: root.entry.kind == 0 ? Theme.danger : Theme.accent;
                count-text := Text {
                    text: root.entry.count > 99 ? "99+" : "\{root.entry.count}"; font-size: 11px; font-weight: 700;
                    color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

/// The inbox popout under the title bar's Inbox button: For You (friend
/// requests), Unreads (channels and conversations with unread messages) and
/// Mentions (those that mention this account), as Discord's has.
export component InboxPopout inherits Rectangle {
    in property <[InboxRow]> rows;
    in property <string> title;
    in property <string> for-you-label;
    in property <string> unreads-label;
    in property <string> mentions-label;
    in property <string> empty-label;
    in property <string> request-label;
    in property <bool> has-for-you;
    in property <bool> has-unreads;
    in property <bool> has-mentions;
    in-out property <int> tab: 0;
    callback open(string, int);
    callback close;
    // Discord's popout: 440px wide, rounded, with its own outline.
    width: 440px; height: 560px;
    background: Theme.raised; border-radius: 8px;
    border-width: 1px; border-color: Theme.line;
    drop-shadow-blur: 16px; drop-shadow-color: #00000066; drop-shadow-offset-y: 4px;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        VerticalLayout {
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Middle { Text { text: root.title; font-size: 16px; font-weight: 700; color: Theme.text; } }
                    Rectangle { horizontal-stretch: 1; }
                    Middle { InboxTab { width: 72px; text: root.for-you-label; selected: root.tab == 0; clicked => { root.tab = 0; } } }
                    Middle { InboxTab { width: 80px; text: root.unreads-label; selected: root.tab == 1; clicked => { root.tab = 1; } } }
                    Middle { InboxTab { width: 92px; text: root.mentions-label; selected: root.tab == 2; clicked => { root.tab = 2; } } }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Flickable {
                content-height: max(self.height, shown.preferred-height + 16px);
                shown := VerticalLayout {
                    padding: 8px; spacing: 0px;
                    for row in root.rows: InboxLine {
                        entry: row;
                        visible: row.kind == (root.tab == 0 ? 2 : root.tab == 1 ? 1 : 0);
                        height: self.visible ? 56px : 0px;
                        clicked => { root.open(row.id, row.kind); }
                    }
                }
                Text {
                    visible: !root.rows-has-tab;
                    text: root.empty-label; color: Theme.muted; font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: 120px;
                }
            }
        }
    }
    property <bool> rows-has-tab: root.tab == 0 ? root.has-for-you : root.tab == 1 ? root.has-unreads : root.has-mentions;
}
