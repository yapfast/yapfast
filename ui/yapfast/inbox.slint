import { Theme, Middle } from "../theme.slint";
import { Avatar } from "../controls.slint";
import { ListView } from "../scrollview.slint";

/// One line of the inbox: a channel or conversation with something waiting,
/// and how many times it mentions this account.
export struct InboxRow {
    id: string, name: string, place: string, initial: string, tint: color, picture-url: string,
    mentions: int,
}

component InboxTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: root.selected ? Theme.overlay.with-alpha(0.12) : pointer.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 12px; width: parent.width - 24px; text: root.text; font-size: 14px; font-weight: 600;
        color: root.selected ? Theme.text : Theme.secondary; vertical-alignment: center; horizontal-alignment: center;
        overflow: elide;
    }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component InboxLine inherits Rectangle {
    in property <InboxRow> entry;
    callback clicked;
    height: 56px;
    border-radius: 4px;
    background: pointer.has-hover ? Theme.overlay.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.entry.name + ", " + root.entry.place;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding: 8px; spacing: 12px;
        Middle {
            width: 32px;
            Avatar {
                size: 32px;
                initial: root.entry.initial; tint: root.entry.tint; picture-url: root.entry.picture-url;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: root.entry.name; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
            if root.entry.place != "": Text { text: root.entry.place; font-size: 12px; color: Theme.muted; overflow: elide; }
        }
        if root.entry.mentions > 0: Middle {
            Rectangle {
                width: max(16px, count-text.preferred-width + 10px); height: 16px; border-radius: 8px;
                background: Theme.danger;
                count-text := Text {
                    text: root.entry.mentions > 99 ? "99+" : "\{root.entry.mentions}"; font-size: 11px; font-weight: 700;
                    color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

/// The inbox popout under the title bar's Inbox button, with Discord's first
/// two tabs: Unreads, the channels and conversations with unread messages, and
/// Mentions, those that mention this account.
export component InboxPopout inherits Rectangle {
    in property <[InboxRow]> rows;
    in-out property <int> tab: 0;
    callback changed-tab;
    callback open(string);
    callback close;
    // Discord's popout: 440px wide, rounded, with its own outline.
    width: 440px; height: 560px;
    background: Theme.raised; border-radius: 8px;
    border-width: 1px; border-color: Theme.line;
    drop-shadow-blur: 16px; drop-shadow-color: #00000066; drop-shadow-offset-y: 4px;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        VerticalLayout {
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Middle { Text { text: @tr("Inbox"); font-size: 16px; font-weight: 700; color: Theme.text; } }
                    Rectangle { horizontal-stretch: 1; }
                    Middle { InboxTab { width: 80px; text: @tr("Unreads"); selected: root.tab == 0; clicked => { root.tab = 0; root.changed-tab(); } } }
                    Middle { InboxTab { width: 92px; text: @tr("Mentions"); selected: root.tab == 1; clicked => { root.tab = 1; root.changed-tab(); } } }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle {
                vertical-stretch: 1;
                if root.rows.length == 0: Text {
                    text: root.tab == 0 ? @tr("Unread messages from your unmuted channels show up here.") : @tr("Nothing mentions you right now.");
                    color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                    x: 16px; width: parent.width - 32px; height: 120px; y: 16px;
                }
                ListView {
                    for row in root.rows: InboxLine {
                        entry: row;
                        clicked => { root.open(row.id); }
                    }
                }
            }
        }
    }
}
