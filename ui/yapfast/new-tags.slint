import { Theme, Middle } from "../theme.slint";

// Which settings are new to this person, set by src/ui/new_tags.rs: each is
// true until they have looked at the page it is on. To tag another new setting,
// add its key to NEW in that file, a property here, and `fresh:` on its row.
export global NewTags {
    /// Something on the About page is new: tags its entry in the list.
    in property <bool> about;
    in property <bool> check;
    in property <bool> nightlies;
    /// Settings left a section, so what was new in it has been seen.
    callback left(int);
}

// The small marigold NEW that follows a new setting's name.
export component NewTag inherits Rectangle {
    width: tag-text.preferred-width + 10px; height: 16px; border-radius: 4px; background: Theme.accent;
    accessible-role: text; accessible-label: "New";
    tag-text := Text {
        text: "NEW"; color: Theme.on-accent; font-size: 10px; font-weight: 800; letter-spacing: 0.4px;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
