import { Theme } from "../theme.slint";
import { IconButton } from "../controls.slint";

export component DmHeading inherits HorizontalLayout {
    in property <bool> discord-linked;
    callback add-friend;
    callback new-message;
    height: 40px; padding-left: 8px; spacing: 4px;
    Text {
        text: "Direct Messages"; font-size: 12px; font-weight: 600;
        color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1;
    }
    // Discord's heading holds the one "+", which starts a message; adding a friend lives on the Friends page.
    IconButton {
        icon: @image-url("../icons/plus.svg"); label: "Create DM"; size: 24px; glyph: 16px; tip-side: 2;
        clicked => { root.new-message(); }
    }
}
