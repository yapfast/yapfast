import { Theme, Tip, Middle } from "../theme.slint";

// Use the existing move/resize/close callbacks, including close-to-tray.
component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> close;
    callback clicked;
    width: 36px;
    background: pointer.has-hover || focus.has-focus ? (root.close ? Theme.danger : Theme.hover) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Image {
        source: root.icon; width: 12px; height: 12px;
        colorize: root.close && pointer.has-hover ? Theme.on-danger : Theme.secondary;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
        pointer := TouchArea { clicked => { root.clicked(); } }
    }
}

// A button in the bar's own row, before the window's: a 20px glyph on a 4px-rounded ground.
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked;
    width: 28px; height: 24px; border-radius: 4px;
    background: !root.enabled ? transparent : root.active ? Theme.overlay.with-alpha(0.12) : pointer.has-hover || focus.has-focus ? Theme.overlay.with-alpha(0.08) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Image {
        source: root.icon; width: 16px; height: 16px;
        colorize: !root.enabled ? Theme.faint : root.active || pointer.has-hover ? Theme.text : Theme.secondary;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
            // What the click opens may open under the tip.
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = 2;
                    Tip.x = root.absolute-position.x + root.width / 2;
                    Tip.y = root.absolute-position.y + root.height;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

export component WindowBar inherits Rectangle {
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> inbox-open;
    callback go-back;
    callback go-forward;
    callback toggle-inbox;
    callback open-help;
    /// The account's screens show; the inbox and help are for them.
    in property <bool> workspace;
    in property <string> place;
    in property <bool> focused;
    in property <bool> maximized;
    callback move-window;
    callback minimize-window;
    callback maximize-window;
    callback close-window;
    height: 32px; background: Theme.rail;
    property <bool> armed;
    TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { root.armed = true; }
                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.armed = false; }
            }
        }
        moved => {
            if root.armed && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
                root.armed = false; root.move-window();
            }
        }
        double-clicked => { root.maximize-window(); }
    }
    HorizontalLayout {
        x: (parent.width - self.width) / 2; width: min(label.preferred-width + 26px, parent.width - 460px);
        height: parent.height; spacing: 8px;
        Middle { width: 16px; Image { source: @image-url("../icons/message-circle.svg"); width: 16px; height: 16px; colorize: Theme.secondary; } }
        label := Text {
            text: root.place; font-size: 12px; font-weight: 600;
            color: root.focused ? Theme.secondary : Theme.faint;
            vertical-alignment: center; overflow: elide;
        }
    }
    HorizontalLayout {
        alignment: start; padding-left: 8px; spacing: 4px;
        Middle { BarButton { icon: @image-url("../icons/arrow-left.svg"); label: @tr("Back"); enabled: root.can-go-back; clicked => { root.go-back(); } } }
        Middle { BarButton { icon: @image-url("../icons/arrow-right.svg"); label: @tr("Forward"); enabled: root.can-go-forward; clicked => { root.go-forward(); } } }
    }
    HorizontalLayout {
        alignment: end; spacing: 0px;
        if root.workspace: Middle {
            HorizontalLayout {
                spacing: 4px; padding-right: 12px;
                BarButton { icon: @image-url("../icons/inbox.svg"); label: @tr("Inbox"); active: root.inbox-open; clicked => { root.toggle-inbox(); } }
                BarButton { icon: @image-url("../icons/help-circle.svg"); label: @tr("Help"); clicked => { root.open-help(); } }
            }
        }
        CaptionButton { icon: @image-url("../icons/minus.svg"); label: @tr("Minimize"); clicked => { root.minimize-window(); } }
        CaptionButton {
            icon: root.maximized ? @image-url("../icons/restore.svg") : @image-url("../icons/square.svg");
            label: root.maximized ? @tr("Restore") : @tr("Maximize");
            clicked => { root.maximize-window(); }
        }
        CaptionButton { icon: @image-url("../icons/x.svg"); label: @tr("Close"); close: true; clicked => { root.close-window(); } }
    }
}
