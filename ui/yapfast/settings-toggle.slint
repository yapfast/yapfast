import { ClientStyle } from "style.slint";
import { Theme } from "../theme.slint";

// Visual face only. SettingsSwitch retains focus, locked-state behavior and
// controlled callbacks, including updates arriving from its adapter.
// Off, its ground is a control's face, a step off any page it sits on, so it
// keeps its shape without an outline; locked, it shows its state, faded.
export component SettingsToggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled;
    in property <bool> hovered;
    in property <bool> focused;
    property <bool> lit: root.enabled && root.hovered;
    width: ClientStyle.enabled ? 48px : 40px;
    height: ClientStyle.enabled ? 24px : 22px;
    border-radius: self.height / 2;
    background: root.checked ? (root.lit ? Theme.accent-hover : Theme.accent) : (root.lit ? Theme.button-default-hover : Theme.button-default);
    opacity: root.enabled ? 1 : 0.5;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    animate background, opacity { duration: Theme.quick; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: ClientStyle.enabled ? 18px : 16px; height: self.width; border-radius: self.width / 2;
        background: root.checked ? Theme.on-accent : Theme.secondary;
        animate x, background { duration: Theme.quick; easing: Theme.glide; }
    }
}
