import { ClientStyle } from "yapfast/style.slint";
import { ScrollView, ListView } from "scrollview.slint";
import { Theme, Middle, Label } from "theme.slint";
import { ActionButton, IconButton, Avatar, Picture, Skeleton, SpoilerCover } from "controls.slint";
import { StatusDot } from "rail.slint";
import { ImageCell, PollCard, PollView, TextBlock, TextBlocks } from "messages.slint";

/// A pinned message or a search result: who wrote it, when, and what it says.
export struct FoundRow {
    item: string, author: string, initial: string, tint: color, picture-url: string,
    /// The author's Discord role colour, when they have one.
    color: color, has-color: bool,
    /// The day and time it was sent.
    when: string,
    /// A body with headings, quotes or code is in `blocks`.
    styled: styled-text, has-body: bool, blocks: [TextBlock],
    /// Its first pictures, laid out as the timeline's gallery but smaller.
    images: [ImageCell], gallery-width: int, gallery-height: int,
    /// Its other files, named, when it has any.
    files: string,
    /// The Discord poll it asks, which can't be voted in from here.
    poll: PollCard, has-poll: bool,
    /// A search result's room, and above the first of a run in one channel
    /// of a server, the channel's name.
    room: string,
    heading: string,
}

/// An entry of a channel's list of threads: a section's heading, or a
/// thread, as Discord's client shows them.
export struct ThreadRow {
    /// The thread's room id; empty for a heading.
    room: string,
    /// A heading, such as "2 joined threads", above the thread if it has
    /// a room.
    heading: string,
    name: string,
    private: bool,
    archived: bool,
    /// Who its line names, with their avatar and role colour: the newest
    /// message's author, or an archived thread's owner; empty for none.
    person: string, initial: string, tint: color, picture-url: string,
    color: color, has-color: bool,
    /// Before the person, such as "Started by ".
    lead: string,
    /// After the person: the message's text, or for no one, what to say.
    text: string,
    /// When it was last active, as "5m ago" or "Last active 5m ago".
    time: string,
    /// How many are in it, and a few of their avatars.
    members: string,
    member-pictures: [string],
}

/// A friend the picker can add to a DM.
export struct PickRow {
    id: string, name: string, initial: string, tint: color, picture-url: string,
    /// As in MemberRow: "online", "mobile", "idle", "dnd" or "offline".
    presence: string,
    chosen: bool,
}

// The conversation's search, in its header: Enter searches, and the cross,
// or Escape, ends the search.
export component HeaderSearch inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    /// Takes the keyboard as it shows.
    in property <bool> autofocus;
    callback search(string);
    callback clear;
    init => { if root.autofocus { input.focus(); } }
    // Discord's box: 243px with a faint outline, wider while it's used.
    width: input.has-focus || root.text != "" ? 300px : ClientStyle.enabled ? 240px : 180px;
    animate width { duration: Theme.quick; }
    height: ClientStyle.enabled ? 30px : 28px; border-radius: ClientStyle.enabled ? 8px : 6px;
    background: Theme.sunken;
    border-width: input.has-focus || ClientStyle.enabled ? 1px : 0px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.8) : Theme.line;
    Text {
        x: 8px; width: root.width - 36px; height: root.height;
        visible: root.text == "";
        text: root.placeholder; color: Theme.muted; font-size: 14px;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: 8px; width: root.width - 36px; height: root.height; clip: true;
        input := TextInput {
            property <length> scroll: 0px;
            x: min(0px, max(parent.width - self.width, self.scroll));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.text;
            single-line: true; vertical-alignment: center;
            font-size: 14px; color: Theme.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.placeholder;
            accepted => { root.search(self.text); }
            key-pressed(event) => {
                if event.text == Key.Escape && root.text != "" { root.clear(); return accept; }
                return reject;
            }
            cursor-position-changed(position) => {
                if position.x + self.scroll < 0px {
                    self.scroll = -position.x;
                } else if position.x + self.scroll > parent.width - self.text-cursor-width {
                    self.scroll = parent.width - self.text-cursor-width - position.x;
                }
            }
        }
    }
    if root.text == "": Image {
        x: root.width - (ClientStyle.enabled ? 28px : 24px); y: (root.height - self.height) / 2;
        width: ClientStyle.enabled ? 20px : 16px; height: ClientStyle.enabled ? 20px : 16px;
        source: @image-url("icons/search.svg"); colorize: ClientStyle.enabled ? Theme.secondary : Theme.muted;
    }
    if root.text != "": IconButton {
        x: root.width - 26px; size: 24px; glyph: 14px; tip-side: 2;
        icon: @image-url("icons/x.svg"); label: "Clear search";
        clicked => { root.clear(); }
    }
}

// A message found: its author, when, and what it says. Clicking it, or its
// Jump button, shows it in the conversation.
export component FoundCard inherits Rectangle {
    in property <FoundRow> found;
    callback jump;
    callback open-link(string);
    min-height: content.preferred-height;
    border-radius: 8px;
    background: pointer.has-hover ? Theme.hover : Theme.chat;
    border-width: 1px; border-color: Theme.line;
    accessible-role: button;
    accessible-label: root.found.author + ", " + root.found.when + ", jump to the message";
    accessible-action-default => { root.jump(); }
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.jump(); }
        content := HorizontalLayout {
            padding: 12px; spacing: 12px;
            VerticalLayout {
                alignment: start;
                Avatar { size: 36px; initial: root.found.initial; tint: root.found.tint; picture-url: root.found.picture-url; }
            }
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px; padding-right: 52px;
                    Text {
                        text: root.found.author; color: root.found.has-color ? root.found.color : Theme.text;
                        font-size: 15px; font-weight: 600; overflow: elide; horizontal-stretch: 0;
                    }
                    Text { text: root.found.when; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                if root.found.has-body && root.found.blocks.length == 0: StyledText {
                    // An overlong word breaks rather than widening every card.
                    min-width: 0px;
                    text: root.found.styled; default-color: Theme.text; link-color: Theme.link;
                    default-font-size: 15px; max-lines: 8;
                    link-clicked(link) => { root.open-link(link); }
                }
                if root.found.blocks.length > 0: TextBlocks {
                    blocks: root.found.blocks; font-size: 15px; max-lines: 8;
                    open-link(link) => { root.open-link(link); }
                }
                // Clicks go through to the card, which shows the message.
                if root.found.images.length > 0: HorizontalLayout {
                    padding-top: 4px;
                    Rectangle {
                        width: root.found.gallery-width * 1px; height: root.found.gallery-height * 1px;
                        for cell in root.found.images: Rectangle {
                            x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
                            border-radius: 8px; clip: true; background: Theme.sunken;
                            if cell.loading: Skeleton { width: parent.width; height: parent.height; }
                            if !cell.loading: Picture {
                                still: cell.image; frames: cell.frames; delays: cell.delays;
                                width: parent.width; height: parent.height; image-fit: cover;
                                accessible-role: image; accessible-label: cell.spoiler ? "Spoiler" : cell.name;
                            }
                            if cell.spoiler: SpoilerCover { }
                            if cell.video && !cell.spoiler && !cell.loading: Rectangle {
                                width: 40px; height: 40px; border-radius: 20px; background: #000000b3;
                                Image { source: @image-url("icons/play.svg"); width: 20px; height: 20px; colorize: #ffffff; }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Clicks go through to the card here too.
                if root.found.has-poll: PollView { poll: root.found.poll; item: root.found.item; }
                if root.found.files != "": HorizontalLayout {
                    spacing: 6px;
                    Middle { Image { source: @image-url("icons/file.svg"); width: 14px; height: 14px; colorize: Theme.muted; } }
                    Text { text: root.found.files; color: Theme.muted; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
        if pointer.has-hover: ActionButton {
            x: parent.width - self.width - 8px; y: 8px;
            width: self.min-width; height: self.min-height;
            text: "Jump"; label: "Jump to the message"; small: true;
            clicked => { root.jump(); }
        }
    }
}

// A popover's frame, under the header button that opened it: a heading,
// then what it holds. Clicks inside stay inside.
component Popover inherits Rectangle {
    in property <image> icon;
    in property <string> heading;
    in property <string> detail;
    callback close;
    background: Theme.sidebar;
    border-color: Theme.edge; border-width: 1px; border-radius: 10px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.heading;
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: root.detail != "" ? 64px : 48px; background: Theme.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                Middle { Image { source: root.icon; width: 20px; height: 20px; colorize: Theme.secondary; } }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                    Text { text: root.heading; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                    if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
        }
        @children
    }
}

// The DM's pinned messages, the latest pinned first, under the pin button.
export component PinsPopover inherits Rectangle {
    in property <[FoundRow]> pins;
    /// Said instead of the list: while it loads, when it fails, or when
    /// there are no pins.
    in property <string> note;
    callback jump(string);
    callback open-link(string);
    callback close;
    /// How tall it would be to show every pin.
    out property <length> fit: 49px + (root.note != "" ? 172px : list.preferred-height);
    width: 420px;
    Popover {
        icon: @image-url("icons/pin.svg");
        heading: "Pinned Messages";
        close => { root.close(); }
        if root.note != "": VerticalLayout {
            padding: 24px; spacing: 12px; alignment: center;
            Image { source: @image-url("icons/pin.svg"); height: 40px; image-fit: contain; colorize: Theme.faint; }
            Text { text: root.note; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
        }
        // Always there, so its height can be read; empty while a note shows.
        ScrollView {
            vertical-stretch: root.note == "" ? 1 : 0;
            max-height: root.note == "" ? 100000px : 0px;
            visible: root.note == "";
            list := VerticalLayout {
                padding: 12px; spacing: 8px; alignment: start;
                for pin in root.pins: FoundCard {
                    found: pin;
                    jump => { root.jump(pin.item); }
                    open-link(link) => { root.open-link(link); }
                }
            }
        }
    }
}

// A thread in a channel's list of threads, as a card: its name, then its
// newest message, or who started an archived one, and when it was last
// active, and on the right a few of those in it. Clicking opens it; with
// Shift, beside the channel. Sized as Discord's client sizes them: a 72px
// card in 80px, under a heading 32px tall for the first section and 64px
// for later ones, or 16px above the first of a search's results.
component ThreadEntry inherits Rectangle {
    in property <ThreadRow> entry;
    in property <bool> first;
    callback open(bool);
    property <bool> shift;
    height: (root.entry.heading != "" ? (root.first ? 32px : 64px) : (root.first ? 16px : 0px))
        + (root.entry.room != "" ? 80px : 0px);
    if root.entry.heading != "": Text {
        x: 16px; y: root.first ? 8px : 40px; height: 24px; width: root.width - 32px;
        text: root.entry.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.4px;
        vertical-alignment: center; overflow: elide;
    }
    if root.entry.room != "": Rectangle {
        y: root.height - 80px; height: 72px; x: 16px; width: root.width - 32px;
        border-radius: 8px; border-width: 1px;
        background: pointer.has-hover ? Theme.raised : Theme.hover;
        border-color: pointer.has-hover ? Theme.active : Theme.line;
        accessible-role: button;
        accessible-label: root.entry.name + ", " + root.entry.time;
        accessible-action-default => { root.open(false); }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { root.shift = event.modifiers.shift; }
            }
            clicked => { root.open(root.shift); }
        }
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 16px;
            VerticalLayout {
                alignment: center; spacing: 6px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 6px;
                    if root.entry.private: Middle { Image { source: @image-url("icons/lock.svg"); width: 14px; height: 14px; colorize: Theme.muted; } }
                    Text { text: root.entry.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 0px;
                    if root.entry.person != "": Middle { Avatar { size: 16px; initial: root.entry.initial; tint: root.entry.tint; picture-url: root.entry.picture-url; } }
                    if root.entry.person == "" && root.entry.archived: Middle { Image { source: @image-url("icons/thread.svg"); width: 14px; height: 14px; colorize: Theme.muted; } }
                    if root.entry.person != "" || root.entry.archived: Rectangle { width: 6px; }
                    if root.entry.lead != "": Text { text: root.entry.lead; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 0; }
                    if root.entry.person != "": Text {
                        text: root.entry.person; color: root.entry.has-color ? root.entry.color : Theme.secondary;
                        font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 0;
                    }
                    // As wide as it is, short of the row; the time follows it.
                    if root.entry.text != "": Text {
                        text: (root.entry.person != "" ? ": " : "") + root.entry.text;
                        color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide;
                        horizontal-stretch: 1; max-width: self.preferred-width;
                    }
                    Text {
                        text: (root.entry.person != "" || root.entry.text != "" ? " • " : "") + root.entry.time;
                        color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.entry.members != "": HorizontalLayout {
                spacing: 6px; horizontal-stretch: 0;
                Middle {
                    Rectangle {
                        width: root.entry.member-pictures.length == 0 ? 0px : 12px * root.entry.member-pictures.length + 8px;
                        height: 20px;
                        for picture[index] in root.entry.member-pictures: Rectangle {
                            x: index * 12px; width: 20px; height: 20px; border-radius: 10px;
                            background: pointer.has-hover ? Theme.raised : Theme.hover;
                            Avatar { x: 1px; y: 1px; size: 18px; picture-url: picture; }
                        }
                    }
                }
                Middle {
                    Text { text: root.entry.members; color: Theme.muted; font-size: 13px; font-weight: 600; }
                }
            }
        }
    }
}

// A channel's list of its threads, under the header's Threads button, as
// Discord's client has it: the active threads this account is in, the
// other active ones and older ones, a page at a time, or what a search of
// their names found. Enter searches, and clearing the search shows the
// list again.
export component ThreadsPopover inherits Rectangle {
    in property <[ThreadRow]> rows;
    /// Said instead of the list: while it loads, or why it failed.
    in property <string> note;
    /// There are none to show.
    in property <bool> empty;
    /// The threads' names can be searched, as with Read Message History.
    in property <bool> searchable;
    in-out property <string> query;
    /// Older threads are still to load, and a page is on its way.
    in property <bool> more;
    in property <bool> loading;
    /// Threads can start in the channel.
    in property <bool> can-create;
    /// How many of the rows are under a heading.
    in property <int> headings;
    /// How tall it would be to show every row.
    out property <length> fit: 49px + (root.headings > 0 ? 32px + (root.headings - 1) * 64px : 16px)
        + root.rows.length * 80px + (root.loading ? 34px : 0px);
    callback search(string);
    callback open(string, bool);
    callback more-threads;
    callback close;
    /// Start a thread, from the header's Create ("list") or the empty
    /// list's Create Thread ("list-empty").
    callback create(string);
    background: Theme.sidebar;
    border-color: Theme.edge; border-width: 1px; border-radius: 10px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Threads";
    /// The list was scrolled by hand since it opened.
    property <bool> scrolled-by-hand;
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 48px; background: Theme.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                Middle { Image { source: @image-url("icons/thread.svg"); width: 20px; height: 20px; colorize: Theme.secondary; } }
                Middle { Text { text: "Threads"; color: Theme.text; font-size: 16px; font-weight: 700; } }
                if root.searchable: Middle { Rectangle { width: 1px; height: 24px; background: Theme.line; } }
                if root.searchable: Middle {
                    HeaderSearch {
                        text <=> root.query;
                        placeholder: "Search for Thread Name"; autofocus: true;
                        search(text) => { root.search(text); }
                        clear => { root.query = ""; root.search(""); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.can-create: Middle {
                    ActionButton { text: "Create"; small: true; primary: true; clicked => { root.create("list"); } }
                }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
        }
        if root.note != "": VerticalLayout {
            padding: 24px; vertical-stretch: 1; alignment: center;
            Text { text: root.note; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
        }
        if root.note == "" && root.empty: VerticalLayout {
            padding: 32px; spacing: 8px; vertical-stretch: 1; alignment: center;
            Image { source: @image-url("icons/thread.svg"); height: 48px; image-fit: contain; colorize: Theme.faint; }
            Text { text: "There are no threads."; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
            Text {
                text: "Stay focused on a conversation with a thread - a temporary text channel.";
                color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center;
            }
            if root.can-create: HorizontalLayout {
                alignment: center; padding-top: 8px;
                ActionButton { text: "Create Thread"; primary: true; clicked => { root.create("list-empty"); } }
            }
        }
        if root.note == "" && !root.empty: Rectangle {
            vertical-stretch: 1;
            list := ListView {
                width: parent.width; height: parent.height;
                // Older threads load when a scroll ends near the end, as
                // Discord's do; a list too short to scroll loads no more.
                // The flag is set first, as a wheel scroll is reported
                // before its animation moves the list.
                scrolled => { root.scrolled-by-hand = true; }
                changed content-y => {
                    if root.scrolled-by-hand && root.more && !root.loading
                        && -self.content-y + self.visible-height >= self.content-height - 200px {
                        root.more-threads();
                    }
                }
                for row[index] in root.rows: ThreadEntry {
                    entry: row; first: index == 0;
                    open(beside) => { root.open(row.room, beside); }
                }
            }
        }
        if root.note == "" && !root.empty && root.loading: HorizontalLayout {
            padding: 8px; alignment: center;
            Text { text: "Loading..."; color: Theme.muted; font-size: 13px; }
        }
    }
}

// A server channel's topic in full, under the header's line of it.
export component TopicPopover inherits Rectangle {
    in property <string> name;
    in property <styled-text> topic;
    callback open-link(string);
    callback close;
    /// How tall it may grow before its text scrolls.
    in property <length> most: 400px;
    width: 440px;
    height: min(49px + body.preferred-height, root.most);
    Popover {
        icon: @image-url("icons/hash.svg");
        heading: root.name;
        close => { root.close(); }
        ScrollView {
            vertical-stretch: 1;
            body := VerticalLayout {
                padding: 16px;
                StyledText {
                    text: root.topic; default-color: Theme.text; link-color: Theme.link; default-font-size: 15px;
                    link-clicked(link) => { root.open-link(link); }
                }
            }
        }
    }
}

// Friends to add to the DM, under the add button: each is chosen with a
// click, up to the group's limit. Adding to a one-to-one DM makes a group.
export component AddPeoplePopover inherits Rectangle {
    in-out property <string> query;
    in property <[PickRow]> people;
    /// How many more the group can take.
    in property <int> room;
    in property <int> chosen;
    /// The DM is one-to-one, so adding makes a new group.
    in property <bool> one-to-one;
    in property <bool> adding;
    /// Why adding failed.
    in property <string> note;
    callback query-edited;
    callback choose(string);
    callback add;
    callback close;
    width: 440px;
    Popover {
        icon: @image-url("icons/user-plus.svg");
        heading: "Select Friends";
        detail: root.room - root.chosen > 0
            ? "You can add " + (root.room - root.chosen) + " more " + (root.room - root.chosen == 1 ? "friend." : "friends.")
            : "This group has no room for more.";
        close => { root.close(); }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 12px; spacing: 8px;
                Rectangle {
                    height: 36px; border-radius: 6px; background: Theme.sunken;
                    border-width: field.has-focus ? 1px : 0px; border-color: Theme.accent.with-alpha(0.8);
                    Text {
                        x: 10px; width: parent.width - 20px; visible: root.query == "";
                        text: "Type the name of a friend"; color: Theme.muted; font-size: 15px; vertical-alignment: center; overflow: elide;
                    }
                    field := TextInput {
                        x: 10px; width: parent.width - 20px;
                        init => { self.focus(); }
                        text <=> root.query; single-line: true; vertical-alignment: center;
                        font-size: 15px; color: Theme.text;
                        selection-background-color: Theme.accent.with-alpha(0.35);
                        selection-foreground-color: Theme.text;
                        accessible-label: "Find a friend";
                        edited => { root.query-edited(); }
                        accepted => { if root.chosen > 0 && !root.adding { root.add(); } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px; alignment: start;
                        for person in root.people: Rectangle {
                            property <bool> can-choose: !root.adding && (person.chosen || root.chosen < root.room);
                            height: 44px; border-radius: 6px;
                            background: pick-touch.has-hover && self.can-choose ? Theme.hover : transparent;
                            opacity: self.can-choose || person.chosen ? 1 : 0.5;
                            accessible-role: checkbox;
                            accessible-checked: person.chosen;
                            accessible-label: person.name;
                            accessible-action-default => { if self.can-choose { root.choose(person.id); } }
                            pick-touch := TouchArea {
                                enabled: parent.can-choose; mouse-cursor: MouseCursor.pointer;
                                clicked => { root.choose(person.id); }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 12px;
                                Middle {
                                    Rectangle {
                                        width: 32px; height: 32px;
                                        Avatar { size: 32px; initial: person.initial; tint: person.tint; picture-url: person.picture-url; }
                                        if person.presence != "" && person.presence != "offline": StatusDot { x: 20px; y: 20px; presence: person.presence; ring: Theme.sidebar; }
                                    }
                                }
                                Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Middle {
                                    Rectangle {
                                        width: 22px; height: 22px; border-radius: 6px;
                                        background: person.chosen ? Theme.accent : transparent;
                                        border-width: person.chosen ? 0px : 2px; border-color: Theme.faint;
                                        if person.chosen: Image { source: @image-url("icons/check.svg"); width: 16px; height: 16px; colorize: Theme.on-accent; }
                                    }
                                }
                            }
                        }
                        if root.people.length == 0: HorizontalLayout {
                            padding: 8px;
                            Label { text: root.query != "" ? "No friends match." : "All your friends are here already."; }
                        }
                    }
                }
                if root.note != "": Label { text: root.note; color: Theme.danger; }
                ActionButton {
                    text: root.adding ? "Adding..." : root.one-to-one ? "Create Group DM" : "Add to Group";
                    primary: true; enabled: root.chosen > 0 && !root.adding;
                    clicked => { root.add(); }
                }
            }
        }
    }
}

// What a search of the DM found, beside the conversation: the newest first,
// a page at a time.
export component SearchPanel inherits Rectangle {
    in property <[FoundRow]> results;
    /// How many it found, or that it's searching, or why it couldn't.
    in property <string> heading;
    in property <string> note;
    in property <bool> more;
    in property <bool> loading;
    /// Show a result: its room and its item.
    callback jump(string, string);
    callback open-link(string);
    callback more-results;
    callback close;
    background: Theme.sidebar;
    accessible-role: list;
    accessible-label: "Search results";
    Rectangle { x: 0; width: 1px; background: Theme.edge; }
    VerticalLayout {
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                Text { text: root.heading; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close search"; size: 28px; glyph: 18px; tip-side: 2; clicked => { root.close(); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        if root.note != "": HorizontalLayout { padding: 16px; Label { text: root.note; } }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px; spacing: 8px; alignment: start;
                for found in root.results: VerticalLayout {
                    spacing: 6px;
                    // The channel a run of results is in, as Discord heads them.
                    if found.heading != "": HorizontalLayout {
                        padding-top: 6px; spacing: 4px;
                        Middle { Image { source: @image-url("icons/hash.svg"); width: 14px; height: 14px; colorize: Theme.muted; } }
                        Text { text: found.heading; color: Theme.secondary; font-size: 13px; font-weight: 700; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    FoundCard {
                        found: found;
                        jump => { root.jump(found.room, found.item); }
                        open-link(link) => { root.open-link(link); }
                    }
                }
                if root.more: HorizontalLayout {
                    alignment: center; padding-top: 4px;
                    ActionButton {
                        text: root.loading ? "Loading..." : "Show more"; small: true; enabled: !root.loading;
                        clicked => { root.more-results(); }
                    }
                }
            }
        }
    }
}
