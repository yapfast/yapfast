import { ScrollView } from "scrollview.slint";
import { Theme, Tip, Middle, Label } from "theme.slint";
import { ClientStyle } from "yapfast/style.slint";

// A labelled action. Primary is marigold, danger red, ghost transparent until hovered.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> ghost;
    in property <bool> danger;
    /// Green, as a Discord app's button for a positive action.
    in property <bool> success;
    in property <bool> small;
    callback clicked;
    min-width: max(root.small ? 28px : 36px, content.preferred-width);
    min-height: root.small ? 28px : 36px;
    max-height: self.min-height;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? (root.primary ? Theme.accent.with-alpha(0.3) : root.success ? Theme.live.with-alpha(0.3) : root.ghost ? transparent : Theme.raised)
        : root.primary ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
        : root.success ? (pointer.has-hover ? Theme.live.brighter(0.1) : Theme.live)
        : root.danger ? (pointer.has-hover ? Theme.danger-hover : Theme.danger)
        : root.ghost ? (pointer.has-hover ? Theme.overlay.with-alpha(0.08) : transparent)
        : (pointer.has-hover ? Theme.button-default-hover : Theme.button-default);
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    property <color> ink: !root.enabled ? (root.primary || root.success ? Theme.on-accent.with-alpha(0.6) : Theme.faint)
        : root.primary || root.success ? Theme.on-accent : root.danger ? Theme.on-danger
        : root.ghost && !pointer.has-hover ? Theme.secondary : Theme.text;
    content := HorizontalLayout {
        padding-left: root.small ? 10px : 16px; padding-right: self.padding-left;
        spacing: 8px; alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon; width: root.small ? 16px : 18px; image-fit: contain;
            colorize: root.ink;
        }
        if root.text != "": Text {
            text: root.text; color: root.ink; font-size: root.small ? 14px : 15px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// The reply bar's switch for whether a reply mentions the person it replies
// to, as Discord's "@ ON".
export component PingToggle inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: label.preferred-width + 16px; height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: @tr("Mention the person you reply to");
    accessible-action-default => { root.toggled(); }
    label := Text {
        text: root.on ? @tr("@ On") : @tr("@ Off");
        color: root.on ? Theme.accent : Theme.muted;
        font-size: 13px; font-weight: 700; vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// An icon-only action with a tooltip naming it.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    /// A state worth warning about, such as a muted microphone: drawn in red.
    in property <bool> alert;
    in property <bool> danger;
    in property <bool> emphasis;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> tint: Theme.secondary;
    in property <color> fill: transparent;
    in property <int> tip-side: 0;
    in property <length> radius: 6px;
    out property <bool> hovered: pointer.has-hover;
    out property <bool> focused: focus.has-focus;
    callback clicked;
    // The root fills its row; the visible face stays square and centred.
    width: root.size; min-height: root.size;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    face := Rectangle {
        width: root.size; height: root.size;
        border-radius: root.radius;
        background: !root.enabled ? root.fill
            : root.emphasis ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
            : root.danger && pointer.has-hover ? Theme.danger.with-alpha(0.16)
            : pointer.has-hover ? root.fill.mix(Theme.overlay, 0.9) : root.fill;
        animate background { duration: Theme.quick; }
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        Image {
            source: root.icon; width: root.glyph; height: root.glyph;
            colorize: !root.enabled ? Theme.faint : root.emphasis ? Theme.on-accent
                : root.alert || (root.danger && pointer.has-hover) ? Theme.danger
                : pointer.has-hover ? Theme.text : root.tint;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = root.tip-side;
                    Tip.x = root.tip-side == 1 ? face.absolute-position.x + root.size : face.absolute-position.x + root.size / 2;
                    Tip.y = root.tip-side == 0 ? face.absolute-position.y : root.tip-side == 1 ? face.absolute-position.y + root.size / 2 : face.absolute-position.y + root.size;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

// A toggle with a caret beside it that opens its device menu. The pair shares one
// hover ground, so the caret reads as part of the control it configures.
export component DeviceToggle inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> menu-label;
    in property <bool> alert;
    in property <bool> enabled: true;
    in property <bool> open;
    in property <length> glyph: 20px;
    in property <color> tint: Theme.secondary;
    out property <bool> hovered: toggle.hovered || caret.has-hover;
    callback clicked;
    callback menu;
    width: 52px; min-height: 32px;
    // The ground is the visible pair only, centred in the row like IconButton's face.
    Rectangle {
        y: (parent.height - self.height) / 2; height: 32px;
        border-radius: 4px;
        // Only the open pair keeps a fill; each half lights itself when hovered.
        background: root.open ? Theme.overlay.with-alpha(0.12) : transparent;
        animate background { duration: Theme.quick; }
    }
    HorizontalLayout {
        toggle := IconButton {
            icon: root.icon; label: root.label; alert: root.alert; enabled: root.enabled; radius: 4px;
            glyph: root.glyph; tint: root.tint;
            clicked => { root.clicked(); }
        }
        Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: root.menu-label;
            accessible-action-default => { root.menu(); }
            Rectangle {
                y: (parent.height - self.height) / 2; width: 20px; height: 32px; border-radius: 4px;
                background: caret.has-hover ? Theme.overlay.with-alpha(0.1) : transparent;
                animate background { duration: Theme.quick; }
                border-width: caret-focus.has-focus ? 2px : 0px;
                border-color: Theme.accent;
                Image {
                    source: @image-url("icons/chevron-down.svg"); width: 16px; height: 16px;
                    colorize: caret.has-hover || root.open ? Theme.text : Theme.secondary;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.quick; }
                }
            }
            caret-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == "\n" || event.text == " " {
                        root.menu(); return accept;
                    }
                    return reject;
                }
                caret := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Tip.text = ""; root.menu(); }
                    changed has-hover => {
                        if self.has-hover && !root.open {
                            Tip.text = root.menu-label;
                            Tip.side = 0;
                            Tip.x = self.absolute-position.x + self.width / 2;
                            Tip.y = self.absolute-position.y + (self.height - 32px) / 2;
                        } else if Tip.text == root.menu-label {
                            Tip.text = "";
                        }
                    }
                }
            }
        }
    }
}

// What the account wears from Discord's shop, for the account card and its
// settings page, which show it without passing it down through each.
export global AccountLook {
    /// The address of the decoration around its avatar.
    in property <string> decoration-url;
    /// The address of its nameplate's picture and the plate's palette colours
    /// on a dark theme and a light one; empty for none.
    in property <string> nameplate-url;
    in property <color> nameplate-color;
    in property <color> nameplate-light;
}

// Virtualized components resolve pixels on demand and queue missing URLs.
// A picture's binding reads the revision of the slot its address falls in,
// which moves when a picture in that slot comes, changes or goes. So one
// that comes draws again the few pictures that share its slot rather than
// every picture in the window.
export global PictureStore {
    pure callback slot(string) -> int;
    pure callback picture(string, int) -> image;
    callback request(string);
    /// The address of the animated version of a still collectible picture,
    /// and the frames and delays of an animated picture once it has arrived.
    pure callback animated(string) -> string;
    pure callback frames(string, int) -> [image];
    pure callback delays(string, int) -> [int];
    /// How many times an animated picture plays before holding its last
    /// frame, as its file says; 0 for ever.
    pure callback plays(string, int) -> int;
    /// The revision to pass with an address.
    pure public function revision(url: string) -> int {
        return root.revision-at(root.slot(url));
    }
    public function bump(slot: int) {
        if slot == 0 { root.slot-0 += 1; }
        if slot == 1 { root.slot-1 += 1; }
        if slot == 2 { root.slot-2 += 1; }
        if slot == 3 { root.slot-3 += 1; }
        if slot == 4 { root.slot-4 += 1; }
        if slot == 5 { root.slot-5 += 1; }
        if slot == 6 { root.slot-6 += 1; }
        if slot == 7 { root.slot-7 += 1; }
        if slot == 8 { root.slot-8 += 1; }
        if slot == 9 { root.slot-9 += 1; }
        if slot == 10 { root.slot-10 += 1; }
        if slot == 11 { root.slot-11 += 1; }
        if slot == 12 { root.slot-12 += 1; }
        if slot == 13 { root.slot-13 += 1; }
        if slot == 14 { root.slot-14 += 1; }
        if slot == 15 { root.slot-15 += 1; }
        if slot == 16 { root.slot-16 += 1; }
        if slot == 17 { root.slot-17 += 1; }
        if slot == 18 { root.slot-18 += 1; }
        if slot == 19 { root.slot-19 += 1; }
        if slot == 20 { root.slot-20 += 1; }
        if slot == 21 { root.slot-21 += 1; }
        if slot == 22 { root.slot-22 += 1; }
        if slot == 23 { root.slot-23 += 1; }
        if slot == 24 { root.slot-24 += 1; }
        if slot == 25 { root.slot-25 += 1; }
        if slot == 26 { root.slot-26 += 1; }
        if slot == 27 { root.slot-27 += 1; }
        if slot == 28 { root.slot-28 += 1; }
        if slot == 29 { root.slot-29 += 1; }
        if slot == 30 { root.slot-30 += 1; }
        if slot == 31 { root.slot-31 += 1; }
    }
    property <int> slot-0;
    property <int> slot-1;
    property <int> slot-2;
    property <int> slot-3;
    property <int> slot-4;
    property <int> slot-5;
    property <int> slot-6;
    property <int> slot-7;
    property <int> slot-8;
    property <int> slot-9;
    property <int> slot-10;
    property <int> slot-11;
    property <int> slot-12;
    property <int> slot-13;
    property <int> slot-14;
    property <int> slot-15;
    property <int> slot-16;
    property <int> slot-17;
    property <int> slot-18;
    property <int> slot-19;
    property <int> slot-20;
    property <int> slot-21;
    property <int> slot-22;
    property <int> slot-23;
    property <int> slot-24;
    property <int> slot-25;
    property <int> slot-26;
    property <int> slot-27;
    property <int> slot-28;
    property <int> slot-29;
    property <int> slot-30;
    property <int> slot-31;
    pure function revision-at(slot: int) -> int {
        if slot == 0 { return root.slot-0; }
        if slot == 1 { return root.slot-1; }
        if slot == 2 { return root.slot-2; }
        if slot == 3 { return root.slot-3; }
        if slot == 4 { return root.slot-4; }
        if slot == 5 { return root.slot-5; }
        if slot == 6 { return root.slot-6; }
        if slot == 7 { return root.slot-7; }
        if slot == 8 { return root.slot-8; }
        if slot == 9 { return root.slot-9; }
        if slot == 10 { return root.slot-10; }
        if slot == 11 { return root.slot-11; }
        if slot == 12 { return root.slot-12; }
        if slot == 13 { return root.slot-13; }
        if slot == 14 { return root.slot-14; }
        if slot == 15 { return root.slot-15; }
        if slot == 16 { return root.slot-16; }
        if slot == 17 { return root.slot-17; }
        if slot == 18 { return root.slot-18; }
        if slot == 19 { return root.slot-19; }
        if slot == 20 { return root.slot-20; }
        if slot == 21 { return root.slot-21; }
        if slot == 22 { return root.slot-22; }
        if slot == 23 { return root.slot-23; }
        if slot == 24 { return root.slot-24; }
        if slot == 25 { return root.slot-25; }
        if slot == 26 { return root.slot-26; }
        if slot == 27 { return root.slot-27; }
        if slot == 28 { return root.slot-28; }
        if slot == 29 { return root.slot-29; }
        if slot == 30 { return root.slot-30; }
        if slot == 31 { return root.slot-31; }
        return 0;
    }
}

// Whether animations play: only while Yapfast's window has the focus, as in
// Discord, so GIFs on another screen hold still where they are.
export global Motion {
    in property <bool> playing: true;
    /// Animations are turned off in the settings: what would move into
    /// view shows at once, or always.
    in property <bool> never;
}

// A picture, or an animation's frames in turn while it shows.
export component Picture inherits Image {
    in property <image> still;
    in property <[image]> frames;
    in property <[int]> delays;
    /// How many times it plays before holding its last frame, as a browser
    /// plays an APNG; 0 for ever.
    in property <int> plays;
    property <int> frame;
    property <int> rounds;
    // Once it holds its last frame its timer stops, so it repaints nothing.
    property <bool> held: root.plays > 0 && root.rounds >= root.plays;
    changed frames => { root.frame = 0; root.rounds = 0; }
    source: root.frames.length > 1 ? root.frames[root.frame] : root.still;
    Timer {
        running: root.frames.length > 1 && Motion.playing && !root.held;
        interval: max(20, root.delays[root.frame]) * 1ms;
        triggered => {
            if root.frame + 1 < root.frames.length {
                root.frame += 1;
            } else if root.plays > 0 && root.rounds + 1 >= root.plays {
                root.rounds = root.plays;
            } else {
                root.rounds += 1;
                root.frame = 0;
            }
        }
    }
}

// Animated emoji's frames, drawn in place of a still while they play; see
// `yapfast_emoji` in the Slint core. `revision` moves with the shared
// clock, so a tick draws the cells that read it again.
export global EmojiAnimations {
    in property <int> revision;
    pure callback frame(string, int) -> image;
}

// The server tag someone wears by their name, as Discord's client draws it: a
// small grey chip with their server's badge, when it has one, before up to four
// letters.
export component ServerTagChip inherits Rectangle {
    in property <string> text;
    /// The address of the badge's picture, or empty for a tag without one.
    in property <string> badge;
    // Discord's chip: 12px text on a 16px line, 4px sides, 4px corners, a 14px
    // badge 2px before the text, a grey wash at 20%. Everything scales with the
    // text so the chip can be set smaller in messages.
    in property <length> font-size: 12px;
    in property <int> font-weight: 600;
    in property <length> chip-height: root.font-size * 1.3333;
    in property <length> pad: 4px;
    in property <length> radius: 4px;
    in property <color> fill: #97979f33;
    in property <color> outline: transparent;
    in property <length> outline-width: 0px;
    /// The text's colour, which a profile's theme sets on its card.
    in property <color> text-color: Theme.text;
    property <length> badge-size: root.font-size + 2px;
    property <length> gap: 2px;
    property <image> badge-picture: root.badge != "" ? PictureStore.picture(root.badge, PictureStore.revision(root.badge)) : @image-url("");
    function request() {
        if root.badge != "" && root.badge-picture.width == 0 {
            PictureStore.request(root.badge);
        }
    }
    init => { root.request(); }
    changed badge => { root.request(); }
    changed badge-picture => { root.request(); }
    // The badge's room is kept from the start, so that the row doesn't move
    // when its picture arrives; one that fails leaves the room empty, as Discord's does.
    width: tag-text.preferred-width + (root.badge != "" ? root.badge-size + root.gap : 0px) + root.pad * 2 + root.outline-width * 2;
    height: root.chip-height; border-radius: root.radius;
    background: root.fill;
    border-width: root.outline-width; border-color: root.outline;
    accessible-role: AccessibleRole.text; accessible-label: @tr("Server tag {}", root.text);
    HorizontalLayout {
        padding-left: root.pad; padding-right: root.pad; spacing: root.gap; alignment: center;
        if root.badge != "": Middle {
            Image { source: root.badge-picture; width: root.badge-size; height: root.badge-size; image-fit: contain; }
        }
        tag-text := Text {
            text: root.text; color: root.text-color; font-size: root.font-size; font-weight: root.font-weight;
            vertical-alignment: center;
        }
    }
}

// A person's picture, or a round initial in their own tint until it arrives;
// optionally ringed while they speak.
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint: Theme.avatar;
    in property <image> picture;
    in property <string> picture-url;
    property <image> shown-picture: root.picture-url != "" ? PictureStore.picture(root.picture-url, PictureStore.revision(root.picture-url)) : root.picture;
    function request-picture() {
        if root.picture-url != "" && root.shown-picture.width == 0 {
            PictureStore.request(root.picture-url);
        }
    }
    init => { root.request-picture(); root.request-decoration(); }
    changed picture-url => { root.request-picture(); }
    changed shown-picture => { root.request-picture(); }
    in property <length> size: 40px;
    /// A corner radius for a rounded square; negative is a circle.
    in property <length> corner: -1px;
    property <length> shape: root.corner >= 0px ? root.corner : root.size / 2;
    /// Corners that differ from `corner`, as Discord's folder previews have a
    /// large outer corner and small others; negative follows `corner`.
    in property <length> corner-tl: -1px;
    in property <length> corner-tr: -1px;
    in property <length> corner-bl: -1px;
    in property <length> corner-br: -1px;
    in property <bool> speaking;
    /// The address of the decoration around the avatar, which Discord draws
    /// a fifth larger than it, centred, over its edge.
    in property <string> decoration-url;
    /// It plays while this is set, and its animation is asked for only then:
    /// Discord's client animates a decoration while the pointer is on its row
    /// or message.
    in property <bool> animate;
    property <image> decoration: root.decoration-url != "" ? PictureStore.picture(root.decoration-url, PictureStore.revision(root.decoration-url)) : @image-url("");
    property <string> animated-url: root.animate && root.decoration-url != "" ? PictureStore.animated(root.decoration-url) : "";
    function request-decoration() {
        if root.decoration-url != "" && root.decoration.width == 0 {
            PictureStore.request(root.decoration-url);
        }
        if root.animated-url != "" {
            PictureStore.request(root.animated-url);
        }
    }
    changed decoration-url => { root.request-decoration(); }
    changed decoration => { root.request-decoration(); }
    changed animated-url => { root.request-decoration(); }
    width: root.size; height: root.size;
    border-top-left-radius: root.corner-tl >= 0px ? root.corner-tl : root.shape;
    border-top-right-radius: root.corner-tr >= 0px ? root.corner-tr : root.shape;
    border-bottom-left-radius: root.corner-bl >= 0px ? root.corner-bl : root.shape;
    border-bottom-right-radius: root.corner-br >= 0px ? root.corner-br : root.shape;
    background: root.shown-picture.width > 0 ? transparent : root.tint;
    if root.shown-picture.width == 0: Text {
        text: root.initial; color: #ffffff; font-size: root.size * 0.42; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.shown-picture.width > 0: Rectangle {
        width: root.size; height: root.size;
        border-top-left-radius: root.corner-tl >= 0px ? root.corner-tl : root.shape;
        border-top-right-radius: root.corner-tr >= 0px ? root.corner-tr : root.shape;
        border-bottom-left-radius: root.corner-bl >= 0px ? root.corner-bl : root.shape;
        border-bottom-right-radius: root.corner-br >= 0px ? root.corner-br : root.shape;
        clip: true;
        Image { source: root.shown-picture; width: root.size; height: root.size; image-fit: cover; }
    }
    if root.decoration.width > 0: Picture {
        x: -root.size / 10; y: -root.size / 10; width: root.size * 1.2; height: root.size * 1.2;
        still: root.decoration; image-fit: contain; accessible-role: none;
        frames: root.animated-url != "" ? PictureStore.frames(root.animated-url, PictureStore.revision(root.animated-url)) : [];
        delays: root.animated-url != "" ? PictureStore.delays(root.animated-url, PictureStore.revision(root.animated-url)) : [];
    }
    if root.speaking: Rectangle {
        x: -3px; y: -3px; width: root.size + 6px; height: root.size + 6px;
        border-radius: self.width / 2; border-width: 2px; border-color: Theme.live;
    }
}

// A nameplate behind a row, as Discord's client draws it: a gradient in its
// palette's colour, and its picture at the row's right end, faded out under
// the row's text. Fill the row with it, under the row's contents.
export component Nameplate inherits Rectangle {
    /// The address of the plate's picture, and its palette's colour.
    in property <string> picture-url;
    /// The palette's colour; a transparent one means a palette Yapfast
    /// doesn't know, and the picture shows without the tint.
    in property <color> palette;
    /// The account card's plate, which is stronger and isn't faded.
    in property <bool> account;
    /// A DM row's, whose colour stays under the pointer and whose picture
    /// starts fading in sooner, as Discord's placements differ.
    in property <bool> channel;
    in property <bool> hovered;
    in property <bool> selected;
    /// The plate plays while the pointer is on its row or the row is
    /// selected, as in Discord's client; otherwise its still picture shows.
    in property <bool> animate;
    /// What lies under the plate, which the fade lets through.
    in property <color> ground;
    /// How wide the row's text is; the picture fades in after it.
    in property <length> content-width;
    property <image> picture: root.picture-url != "" ? PictureStore.picture(root.picture-url, PictureStore.revision(root.picture-url)) : @image-url("");
    // The animated picture is asked for when it's to play, so that a list of
    // plates holds and downloads only their stills.
    property <string> animated-url: root.animate && root.picture.width > 0 ? PictureStore.animated(root.picture-url) : "";
    function request-picture() {
        if root.picture-url != "" && root.picture.width == 0 {
            PictureStore.request(root.picture-url);
        }
        if root.animated-url != "" {
            PictureStore.request(root.animated-url);
        }
    }
    init => { root.request-picture(); }
    changed picture-url => { root.request-picture(); }
    changed picture => { root.request-picture(); }
    changed animated-url => { root.request-picture(); }
    // Discord's opacities: .6 at rest, .9 selected or hovered; the account
    // card's .4 rises to .6 under the pointer.
    property <float> strength: root.account ? (root.hovered ? 0.6 : 0.4) : (root.selected || root.hovered) ? 0.9 : 0.6;
    property <length> fade-from: min(root.width, root.content-width + (root.channel ? -5px : 10px));
    property <length> fade-to: min(root.width, root.fade-from + 50px);
    /// The corners of the row it fills.
    in property <length> radius;
    clip: true;
    border-radius: root.radius;
    if root.picture.width > 0: Picture {
        still: root.picture;
        height: root.height; width: self.height * root.picture.width / root.picture.height;
        x: root.width - self.width;
        image-fit: fill; opacity: root.strength; accessible-role: none;
        frames: root.animated-url != "" ? PictureStore.frames(root.animated-url, PictureStore.revision(root.animated-url)) : [];
        delays: root.animated-url != "" ? PictureStore.delays(root.animated-url, PictureStore.revision(root.animated-url)) : [];
    }
    // The fade under the text: the picture shows at .3 of its strength there,
    // and in full a little after it.
    if !root.account && root.picture.width > 0: Rectangle {
        background: @linear-gradient(90deg, root.ground.with-alpha(0.7) 0%, root.ground.with-alpha(0.7) root.fade-from / root.width * 100%, root.ground.with-alpha(0) root.fade-to / root.width * 100%, root.ground.with-alpha(0) 100%);
    }
    // The palette's tint, from nothing at the left edge.
    if root.palette.alpha > 0: Rectangle {
        background: root.account
            ? @linear-gradient(90deg, root.palette.with-alpha(0.1) 0%, root.palette.with-alpha(0.4) 100%)
            : @linear-gradient(90deg, root.palette.with-alpha(0) 0%, root.palette.with-alpha(0.08) 20%, root.palette.with-alpha(0.08) 50%, root.palette.with-alpha(root.selected ? 0.5 : root.hovered && !root.channel ? 0.3 : 0.2) 100%);
    }
}

// How a person's display name is drawn: Discord's display name styles, which
// give it a font, an effect and up to five colours. `colors` are made to
// read against the dark ground and the shades are derived from the first, as
// the client does (src/ui/name_style.rs).
/// One letter of a gummy name and its colour.
export struct NameLetter { text: string, color: color }

export struct NameStyleRow {
    /// Discord's effect id: 0 for no style, then solid 1, gradient 2, neon 3,
    /// toon 4, pop 5, glow 6, prism 7 and gummy 8.
    effect: int,
    /// The font family and weight; the family is empty for the usual font.
    family: string, weight: int,
    count: int, colors: [color],
    main: color, light1: color, light2: color, dark1: color, dark2: color, toon: color, neon: color,
    /// A gummy name's letters, each in the colours in turn.
    letters: [NameLetter],
}

// What the profile editor's name style window asks of the Rust side: a style
// drawn as names are drawn everywhere else (src/ui/name_style.rs), from its
// font, effect and colours written as hex joined by commas; one of those
// colours; and whether a text holds a search.
export global NameStyles {
    pure callback row(int, int, string, string) -> [NameStyleRow];
    pure callback stripe(string, int) -> color;
    pure callback contains(string, string) -> bool;
}

// A name drawn with its style, as wide as its text: a line the width of the
// name, with a row's own colour when it has no style. A few effects stack
// the text twice, as Discord's `::before` copies do.
export component StyledName inherits Rectangle {
    in property <string> text;
    /// The style's palette on a dark theme and on a light one.
    in property <[NameStyleRow]> styles;
    in property <length> font-size: 16px;
    in property <int> font-weight: 500;
    in property <color> ink: Theme.text;
    in property <TextOverflow> overflow: TextOverflow.elide;
    property <NameStyleRow> style: root.styles[Theme.dark ? 0 : 1];
    property <int> effect: root.style.effect;
    property <string> family: root.effect > 0 ? root.style.family : "";
    property <int> weight: root.effect > 0 && root.style.family != "" ? root.style.weight : root.font-weight;
    property <bool> gummy-fits: root.effect == 8 && root.style.count > 0 && sizer.preferred-width <= root.width;
    // Discord's strokes and offsets scale with the text: 0.04em and so on.
    property <length> em: root.font-size;
    preferred-width: sizer.preferred-width;
    preferred-height: sizer.preferred-height;
    min-width: 0px;
    sizer := Text {
        text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
        overflow: root.overflow; color: transparent; width: 100%; height: 100%;
        horizontal-alignment: left; vertical-alignment: center;
    }
    // Without a style, or with a solid one, the plain colour; so is a gummy
    // name too long to show whole, as letters of their own don't elide.
    if root.effect == 0 || root.effect == 1 || root.style.count == 0 || (root.effect == 8 && !root.gummy-fits): Text {
        text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
        overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
        color: root.effect == 0 || root.style.count == 0 ? root.ink : root.style.colors[0];
    }
    // Gradient and glow: the colours across the name, from 10% to 90%.
    if (root.effect == 2 || root.effect == 6) && root.style.count > 0: Text {
        text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
        overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
        color: root.style.count == 1 ? root.style.colors[0]
            : root.style.count == 2 ? @linear-gradient(90deg, root.style.colors[0] 10%, root.style.colors[1] 90%)
            : root.style.count == 3 ? @linear-gradient(90deg, root.style.colors[0] 10%, root.style.colors[1] 50%, root.style.colors[2] 90%)
            : root.style.count == 4 ? @linear-gradient(90deg, root.style.colors[0] 10%, root.style.colors[1] 36.67%, root.style.colors[2] 63.33%, root.style.colors[3] 90%)
            : @linear-gradient(90deg, root.style.colors[0] 10%, root.style.colors[1] 30%, root.style.colors[2] 50%, root.style.colors[3] 70%, root.style.colors[4] 90%);
    }
    // Prism: the colours round once, back to the first.
    if root.effect == 7 && root.style.count > 0: Text {
        text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
        overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
        color: root.style.count == 1 ? root.style.colors[0]
            : root.style.count == 2 ? @linear-gradient(90deg, root.style.colors[0] 0%, root.style.colors[1] 50%, root.style.colors[0] 100%)
            : root.style.count == 3 ? @linear-gradient(90deg, root.style.colors[0] 0%, root.style.colors[1] 33.33%, root.style.colors[2] 66.67%, root.style.colors[0] 100%)
            : root.style.count == 4 ? @linear-gradient(90deg, root.style.colors[0] 0%, root.style.colors[1] 25%, root.style.colors[2] 50%, root.style.colors[3] 75%, root.style.colors[0] 100%)
            : @linear-gradient(90deg, root.style.colors[0] 0%, root.style.colors[1] 20%, root.style.colors[2] 40%, root.style.colors[3] 60%, root.style.colors[4] 80%, root.style.colors[0] 100%);
    }
    // Gummy: its letters take the colours in turn, with no kerning, as
    // Discord's letters are boxes of their own.
    if root.gummy-fits: HorizontalLayout {
        alignment: start;
        for letter in root.style.letters: Text {
            text: letter.text; color: letter.color; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
            vertical-alignment: center;
        }
    }
    // Neon: a halo in the colour, then white text edged in a lighter one.
    if root.effect == 3 && root.style.count > 0: Rectangle {
        Text {
            text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
            overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
            color: root.style.main.with-alpha(0.0); stroke: root.style.main.with-alpha(0.28); stroke-width: root.em * 0.24 + 6px; stroke-style: TextStrokeStyle.center;
        }
        Text {
            text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
            overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
            color: #ffffff; stroke: root.style.neon; stroke-width: root.em * 0.04 + 1px; stroke-style: TextStrokeStyle.outside;
        }
    }
    // Toon: the colour's light shades in bands, edged in its dark one.
    if root.effect == 4 && root.style.count > 0: Text {
        text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
        overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
        color: @linear-gradient(180deg, root.style.light2 0%, root.style.light1 45%, root.style.main 55%, root.style.dark1 100%);
        stroke: root.style.toon; stroke-width: root.em * 0.04 + 1.6px; stroke-style: TextStrokeStyle.outside;
    }
    // Pop: white text edged in the darkest shade, over a copy in the colour a
    // little lower, which looks like a shadow.
    if root.effect == 5 && root.style.count > 0: Rectangle {
        Text {
            y: root.em * 0.08 + root.em * 0.04 + 1.2px;
            text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
            overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
            color: root.style.main; stroke: root.style.dark2; stroke-width: root.em * 0.04 + 1.2px; stroke-style: TextStrokeStyle.outside;
        }
        Text {
            text: root.text; font-size: root.font-size; font-family: root.family; font-weight: root.weight;
            overflow: root.overflow; width: 100%; height: 100%; vertical-alignment: center;
            color: #ffffff; stroke: root.style.dark2; stroke-width: root.em * 0.04 + 1.2px; stroke-style: TextStrokeStyle.outside;
        }
    }
}

/// One picture of a profile effect: where it lies on the card and when it
/// plays, in milliseconds.
export struct EffectLayer {
    url: string, x: int, y: int, start: int, duration: int, looped: bool, loop-delay: int,
}

component EffectLayerView inherits Rectangle {
    in property <EffectLayer> layer;
    in property <int> time;
    in property <bool> active;
    property <int> since: root.time - root.layer.start;
    property <int> cycle: root.layer.duration + root.layer.loop-delay;
    property <bool> shown: root.since >= 0
        && (root.layer.looped || root.since <= root.layer.duration)
        && (!root.layer.looped || root.layer.loop-delay <= 0 || mod(root.since, root.cycle) <= root.layer.duration);
    // Starts again from its first frame each time it shows.
    if root.active && root.shown: Picture {
        property <image> first: PictureStore.picture(root.layer.url, PictureStore.revision(root.layer.url));
        x: root.layer.x * 1px; y: root.layer.y * 1px;
        width: root.width; height: self.width * self.first.height / max(1, self.first.width);
        still: self.first; image-fit: fill; accessible-role: none;
        frames: PictureStore.frames(PictureStore.animated(root.layer.url), PictureStore.revision(PictureStore.animated(root.layer.url)));
        delays: PictureStore.delays(PictureStore.animated(root.layer.url), PictureStore.revision(PictureStore.animated(root.layer.url)));
        plays: PictureStore.plays(PictureStore.animated(root.layer.url), PictureStore.revision(PictureStore.animated(root.layer.url)));
        init => { if self.first.width == 0 { PictureStore.request(root.layer.url); } }
    }
}

// A profile effect over a card: its picture at rest, and while `play` holds
// its layers, APNGs laid over the whole card, each shown from its start for
// its duration, and again after its delay when it loops. Each layer starts
// from its first frame every time it shows. The clock ticks 24 times a second
// while the window has the focus, and stops once nothing more will change.
export component ProfileEffect inherits Rectangle {
    in property <[EffectLayer]> layers;
    /// The picture that shows while it doesn't play.
    in property <string> still-url;
    in property <bool> play;
    /// When the last layer that doesn't loop ends, and whether any loops.
    in property <int> end;
    in property <bool> loops;
    property <int> time;
    property <bool> finished: !root.loops && root.time > root.end;
    property <bool> playing: root.play && Motion.playing && !root.finished;
    property <image> still: root.still-url != "" ? PictureStore.picture(root.still-url, PictureStore.revision(root.still-url)) : @image-url("");
    changed play => { root.time = 0; }
    clip: true;
    Timer {
        running: root.playing;
        interval: 1000ms / 24;
        triggered => { root.time += 41; }
    }
    if !root.playing && root.still.width > 0: Image {
        x: 0px; y: 0px; width: root.width; height: self.width * root.still.height / root.still.width;
        source: root.still; image-fit: fill; accessible-role: none;
    }
    for layer in root.layers: EffectLayerView {
        layer: layer; time: root.time; width: root.width; active: root.playing;
    }
}


// A custom status or what someone is doing: the picture of its custom emoji,
// asked for as it shows, then its words.
export component StatusText inherits HorizontalLayout {
    in property <string> text;
    in property <string> emoji-url;
    in property <color> color: Theme.muted;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    in property <TextWrap> wrap: no-wrap;
    /// What they're doing, as a small icon before the words: 1 a controller,
    /// 2 a music note, 3 a screen, 4 a camera, 5 a trophy; 0 for none.
    in property <int> icon;
    /// A bullet follows the icon, before a custom status.
    in property <bool> bullet;
    property <image> emoji: root.emoji-url != "" ? PictureStore.picture(root.emoji-url, PictureStore.revision(root.emoji-url)) : @image-url("");
    function request-emoji() {
        if root.emoji-url != "" && root.emoji.width == 0 {
            PictureStore.request(root.emoji-url);
        }
    }
    init => { root.request-emoji(); }
    changed emoji-url => { root.request-emoji(); }
    changed emoji => { root.request-emoji(); }
    alignment: start; spacing: 4px;
    if root.icon > 0: VerticalLayout {
        alignment: center;
        Image {
            source: root.icon == 1 ? @image-url("icons/gamepad.svg") : root.icon == 2 ? @image-url("icons/music.svg") : root.icon == 3 ? @image-url("icons/tv.svg") : root.icon == 4 ? @image-url("icons/video.svg") : @image-url("icons/trophy.svg");
            width: root.font-size * 1.25; height: root.font-size * 1.25;
            image-fit: contain; accessible-role: none;
            // Discord draws the game controller in its online green.
            colorize: root.icon == 1 && ClientStyle.enabled ? Theme.live : root.color;
        }
    }
    if root.icon > 0 && root.bullet: VerticalLayout {
        alignment: center;
        Text { text: "\u{2022}"; color: root.color; font-size: root.font-size; font-weight: root.font-weight; }
    }
    // The emoji keeps its place while its picture is on the way.
    if root.emoji-url != "": VerticalLayout {
        alignment: start;
        Image {
            source: root.emoji; width: root.font-size * 1.25; height: root.font-size * 1.25;
            image-fit: contain; accessible-role: none;
        }
    }
    if root.text != "": Text {
        text: root.text; color: root.color; font-size: root.font-size; font-weight: root.font-weight;
        wrap: root.wrap; overflow: elide; horizontal-stretch: 1;
    }
}

// The server voice channel someone is in: a green speaker, then the channel
// and its server; or, compact, the speaker alone with those in its tooltip,
// for a line their status fills. Clicking it goes to the channel.
export component VoiceSpot inherits Rectangle {
    in property <string> channel;
    in property <string> server;
    in property <bool> compact;
    in property <length> font-size: 13px;
    callback clicked;
    property <string> place: root.channel + " — " + root.server;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: @tr("Go to {0} in {1}", root.channel, root.server);
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        spacing: 4px;
        speaker := Image {
            source: @image-url("icons/volume-2.svg"); width: root.font-size + 1px; height: self.width;
            y: (parent.height - self.height) / 2; colorize: Theme.live;
        }
        if !root.compact: Text {
            text: root.place; color: pointer.has-hover ? Theme.text : Theme.muted;
            font-size: root.font-size; overflow: elide;
        }
    }
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.compact {
                Tip.text = root.place;
                Tip.side = 0;
                Tip.x = speaker.absolute-position.x + speaker.width / 2;
                Tip.y = speaker.absolute-position.y;
            } else if Tip.text == root.place {
                Tip.text = "";
            }
        }
    }
}

// A single-line text field. Long text scrolls to keep the cursor visible.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> password;
    in property <string> label;
    in property <length> text-size: 16px;
    in property <length> pad: 12px;
    in property <color> fill: Theme.sunken;
    in property <bool> ring: true;
    /// What the placeholder is drawn in.
    in property <color> placeholder-color: Theme.muted;
    /// The text's colour, for a field on another ground than Yapfast's own.
    in property <color> ink: Theme.text;
    /// A picture at the field's right end, such as a smiley, which the text
    /// stays clear of.
    in property <image> trailing-icon;
    in property <color> trailing-tint: Theme.secondary;
    property <length> trailing: root.trailing-icon.width > 0 ? 28px : 0px;
    /// The field has the keys.
    out property <bool> focused: input.has-focus;
    callback edited(string);
    callback accepted;
    public function focus-input() { input.focus(); }
    min-height: 40px; vertical-stretch: 0; horizontal-stretch: 1;
    border-radius: 6px;
    background: root.fill;
    border-width: root.ring && input.has-focus ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.8);
    Text {
        x: root.pad; width: root.width - 2 * root.pad - root.trailing; height: root.height;
        visible: root.text == "";
        text: root.placeholder; color: root.enabled ? root.placeholder-color : Theme.faint; font-size: root.text-size;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.pad; width: root.width - 2 * root.pad - root.trailing; height: root.height; clip: true;
        input := TextInput {
            property <length> scroll: 0px;
            x: min(0px, max(parent.width - self.width, self.scroll));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            font-size: root.text-size;
            color: root.enabled ? root.ink : Theme.muted;
            input-type: root.password ? InputType.password : InputType.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
            cursor-position-changed(position) => {
                if position.x + self.scroll < 0px {
                    self.scroll = -position.x;
                } else if position.x + self.scroll > parent.width - self.text-cursor-width {
                    self.scroll = parent.width - self.text-cursor-width - position.x;
                }
            }
        }
    }
    if root.trailing-icon.width > 0: Image {
        x: root.width - root.pad - 20px + 4px; y: (root.height - 20px) / 2; width: 20px; height: 20px;
        source: root.trailing-icon; colorize: root.trailing-tint;
    }
}

// A round button answering or ending a call.
export component CallButton inherits VerticalLayout {
    in property <image> icon;
    /// Said under the button, so its meaning doesn't rest on the icon.
    in property <string> label;
    in property <color> fill;
    in property <bool> enabled: true;
    callback clicked;
    spacing: 6px;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 64px; height: 48px; border-radius: 24px;
            background: touch.has-hover ? root.fill.darker(0.15) : root.fill;
            accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
            accessible-action-default => { if root.enabled { root.clicked(); } }
            Image { source: root.icon; width: 22px; height: 22px; colorize: Theme.on-danger; }
            touch := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
        }
    }
    Text {
        text: root.label; font-size: 13px; horizontal-alignment: center;
        color: touch.has-hover ? Theme.text : Theme.secondary;
        accessible-role: none;
    }
}

// Stands in for something on its way, such as a picture or the messages,
// with a light sweeping across it as in Discord.
export component Skeleton inherits Rectangle {
    background: Theme.raised;
    clip: true;
    accessible-role: image;
    accessible-label: @tr("Loading");
    Rectangle {
        width: max(120px, parent.width * 0.5); height: parent.height;
        x: Math.mod(animation-tick() / 1ms, 1500) / 1500 * (parent.width + self.width) - self.width;
        background: @linear-gradient(90deg, Theme.shimmer.with-alpha(0) 0%, Theme.shimmer 50%, Theme.shimmer.with-alpha(0) 100%);
    }
}

// Messages on their way: rows the shape of messages.
export component MessagesSkeleton inherits VerticalLayout {
    padding: 16px; spacing: 22px; alignment: end;
    for line in [
        { name: 92px, lines: [380px, 220px] },
        { name: 120px, lines: [300px] },
        { name: 76px, lines: [420px, 340px, 160px] },
        { name: 104px, lines: [260px] },
        { name: 88px, lines: [360px, 200px] },
    ]: HorizontalLayout {
        spacing: 16px; alignment: start;
        VerticalLayout {
            alignment: start;
            Skeleton { width: 40px; height: 40px; border-radius: 20px; }
        }
        VerticalLayout {
            spacing: 8px; padding-top: 4px; alignment: start;
            Skeleton { width: line.name; height: 12px; border-radius: 6px; }
            for width in line.lines: Skeleton { width: width; height: 12px; border-radius: 6px; }
        }
    }
}

// Lies over a spoiler's blurred picture until it's clicked.
export component SpoilerCover inherits Rectangle {
    background: #00000059;
    Rectangle {
        width: label.preferred-width + 24px; height: 28px; border-radius: 14px; background: #000000b3;
        label := Text { text: @tr("SPOILER"); color: #ffffff; font-size: 13px; font-weight: 800; letter-spacing: 0.5px; vertical-alignment: center; }
    }
}

// One choice in a menu, with a check beside the current one. It may have a
// second line under its text, a box to tick, or an arrow to its submenu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    /// A second line under the text, such as what a submenu has chosen.
    in property <string> subtitle;
    in property <image> icon;
    /// The current choice, marked with a check in place of its icon; or
    /// with `checkbox`, ticked.
    in property <bool> checked;
    /// It turns something on or off, with a box at its end ticked while on.
    in property <bool> checkbox;
    /// It opens a submenu, which an arrow at its end shows.
    in property <bool> submenu;
    /// A destructive choice, such as deleting: drawn in red.
    in property <bool> danger;
    /// Shown, greyed, but not to be chosen; a ContextMenu doesn't report it.
    in property <bool> disabled;
    /// No room for an icon when it has none, so the text starts at the edge.
    in property <bool> plain;
    /// Drawn as the pointer's choice; a ContextMenu moves it with the keys too.
    in property <bool> highlighted: pointer.has-hover;
    callback clicked;
    callback hovered;
    property <bool> current: root.checked && !root.checkbox;
    height: root.subtitle != "" ? 44px : 32px;
    border-radius: 4px;
    // Discord's focused row is filled with its accent, or with the danger
    // colour for a destructive choice, whose text and icon turn white.
    background: root.highlighted ? (root.danger ? Theme.danger : Theme.overlay.with-alpha(0.09)) : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.subtitle;
    accessible-checkable: root.checkbox;
    accessible-checked: root.checked;
    accessible-enabled: !root.disabled;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        opacity: root.disabled ? 0.45 : 1;
        if !root.plain || root.current || root.icon.width > 0: Image {
            source: root.current ? @image-url("icons/check.svg") : root.icon;
            width: 16px; image-fit: contain;
            colorize: root.current ? Theme.accent : root.danger ? (root.highlighted ? Theme.on-danger : Theme.danger-text) : root.highlighted ? Theme.text : Theme.secondary;
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text {
                text: root.text; color: root.danger ? (root.highlighted ? Theme.on-danger : Theme.danger-text) : Theme.text;
                font-size: 14px; font-weight: root.current ? 700 : 500;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle; color: Theme.muted; font-size: 12px; overflow: elide;
            }
        }
        if root.checkbox: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px; height: 18px; border-radius: 4px;
                background: root.checked ? Theme.accent : transparent;
                border-width: root.checked ? 0px : 1.5px; border-color: root.highlighted ? Theme.text : Theme.muted;
                if root.checked: Image {
                    width: 12px; height: 12px; image-fit: contain;
                    source: @image-url("icons/check.svg"); colorize: Theme.on-accent;
                }
            }
        }
        if root.submenu: Image {
            width: 24px; image-fit: contain;
            source: @image-url("icons/chevron-right.svg"); colorize: root.danger && root.highlighted ? Theme.on-danger : Theme.text;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
            clicked => { root.clicked(); }
            changed has-hover => { if self.has-hover { root.hovered(); } }
        }
    }
}

/// A choice in a ContextMenu.
export struct MenuRow {
    /// What the menu reports when it's chosen.
    id: string,
    /// What it reports when it's clicked, instead of its submenu opening,
    /// for a row whose submenu is a choice of how, as a mute for a time is;
    /// empty for a row whose click opens its submenu, as hovering does.
    click-id: string,
    text: string,
    /// A second line under the text, such as what its submenu has chosen.
    subtitle: string,
    icon: image,
    /// A destructive choice, drawn in red.
    danger: bool,
    /// It starts a group, under a line.
    separated: bool,
    /// It turns something on or off, with a box ticked while it's on.
    /// Choosing it leaves the menu open.
    checkbox: bool,
    /// Ticked, for a checkbox; otherwise the current choice, as a level in
    /// a submenu is, marked with a check in place of its icon.
    checked: bool,
    /// Greyed, and not to be chosen, such as a role this account may not
    /// give.
    disabled: bool,
    /// Without room for an icon, unless the row has one, as Discord's person
    /// menu has none on most rows.
    plain: bool,
}

// The rows of a ContextMenu or of a submenu.
component MenuRows inherits VerticalLayout {
    in property <[MenuRow]> rows;
    /// Each row's submenu, by the row's index; a row without one has none.
    in property <[[MenuRow]]> submenus;
    in property <int> current;
    /// The row whose submenu is open, drawn as chosen while the pointer is away.
    in property <int> holding: -1;
    callback hovered(int);
    callback clicked(int);
    /// A row became the current one: which, how far down the window, and
    /// how tall it is.
    callback lit(int, length, length);
    padding: 6px; spacing: 2px;
    for row[index] in root.rows: VerticalLayout {
        spacing: 2px;
        if row.separated && index > 0: Rectangle {
            height: 9px;
            Rectangle { height: 1px; background: Theme.line; }
        }
        MenuItem {
            text: row.text; subtitle: row.subtitle; icon: row.icon; danger: row.danger;
            checkbox: row.checkbox; checked: row.checked; disabled: row.disabled; plain: row.plain;
            submenu: root.submenus[index].length > 0;
            highlighted: root.current == index || root.holding == index;
            hovered => { root.hovered(index); }
            clicked => { root.clicked(index); }
            changed highlighted => { if self.highlighted { root.lit(index, self.absolute-position.y, self.height); } }
        }
    }
}

// A menu of choices, such as a right click opens, and the submenus its rows
// may open beside it, to its right or with `flip` its left. Each fits its
// rows' text, within limits. It takes the keyboard: Up and Down (or Tab)
// move through the choices, wrapping, Home and End go to the ends, Enter or
// Space chooses, Right opens a row's submenu and Left leaves it, and Escape
// closes the submenu, then the menu. A checkbox row reports `toggled`
// rather than `chose`, and the menu stays open; a disabled row reports
// neither. A row whose submenu is a choice of how, as a mute's times are,
// opens that submenu on hover; clicked itself, it reports its `click-id`
// and the menu closes. A menu or submenu taller than `tallest` scrolls.
//
// The menu stays where it opens. A submenu lines up with its row and moves
// up to stay within `room-below`, past the menu's top if it must, and
// `lift` says how far: the component's top is that far above the menu's.
export component ContextMenu inherits Rectangle {
    in property <[MenuRow]> rows;
    /// Each row's submenu, by the row's index: empty for a row without one,
    /// and empty altogether when no row has one.
    in property <[[MenuRow]]> submenus;
    /// The room right of where the menu opens; submenus that wouldn't fit
    /// there open on its left.
    in property <length> room: 100000px;
    in property <length> tallest: 100000px;
    /// The room below the menu's top; the rest of `tallest` is above it.
    in property <length> room-below: 100000px;
    // A menu and a submenu are as wide as their rows, within these.
    in property <length> narrowest: 255px;
    property <length> widest: 320px;
    out property <length> menu-width: max(root.narrowest, min(root.widest, main.preferred-width));
    property <length> submenu-width: max(root.narrowest, min(root.widest, sub.preferred-width));
    out property <bool> has-submenus: root.submenus.length > 0;
    // The component spans the menu and, with submenus, room for the widest
    // beside it, so a submenu opening moves nothing.
    out property <length> content-width: root.menu-width + (root.has-submenus ? 4px + root.widest : 0px);
    out property <bool> flip: root.has-submenus && root.content-width > root.room;
    out property <length> main-height: min(main.preferred-height, root.tallest);
    property <length> sub-height: min(sub.preferred-height, root.tallest);
    // Where the submenu's top is, from the menu's.
    property <length> sub-top: max(root.room-below - root.tallest, min(root.sub-y, root.room-below - root.sub-height));
    out property <length> lift: root.sub-open ? max(0px, -root.sub-top) : 0px;
    out property <length> content-height: root.lift + max(root.main-height, root.sub-open ? root.sub-top + root.sub-height : 0px);
    callback chose(string);
    callback toggled(string);
    callback close;
    property <int> current: -1;
    // The submenu: whether it's open, how far down, and its current choice,
    // -1 while the keys move through the menu.
    property <bool> sub-open;
    property <length> sub-y;
    property <int> sub-current: -1;
    // The row whose submenu shows, and its rows.
    property <int> sub-row: -1;
    property <[MenuRow]> subrows: root.sub-row >= 0 ? root.submenus[root.sub-row] : [];
    // The row last made current, and how far below the menu's top it is.
    property <int> lit-row: -1;
    property <length> lit-y;
    function step(by: int) {
        if root.sub-current >= 0 {
            root.sub-current = Math.mod(root.sub-current + by, root.subrows.length);
            return;
        }
        root.current = root.current < 0
            ? (by > 0 ? 0 : root.rows.length - 1)
            : Math.mod(root.current + by, root.rows.length);
    }
    pure function has-submenu(index: int) -> bool {
        return root.submenus[index].length > 0;
    }
    // A submenu lines up with its row; the row may report where it is
    // just before or just after it opens.
    function open-submenu(index: int) {
        root.sub-row = index;
        root.sub-current = -1;
        if root.lit-row == index { root.sub-y = root.lit-y; }
        root.sub-open = true;
    }
    function pick(row: MenuRow) {
        if row.disabled { return; }
        if row.checkbox { root.toggled(row.id); } else { root.chose(row.click-id == "" ? row.id : row.click-id); }
    }
    // Where a menu that scrolls goes to show the row lit `y` down it and
    // `height` tall, as the keys move to it.
    pure function reveal(shown: length, content: length, content-y: length, y: length, height: length) -> length {
        let top = y - 6px;
        let bottom = y + height + 6px;
        let moved = top < 0px ? content-y - top : bottom > shown ? content-y - (bottom - shown) : content-y;
        return max(min(0px, shown - content), min(0px, moved));
    }
    // Clicks between the menu and the submenu close it, as clicks outside do.
    TouchArea { clicked => { root.close(); } }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.DownArrow || (event.text == Key.Tab && !event.modifiers.shift) {
                root.step(1);
            } else if event.text == Key.UpArrow || event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.step(-1);
            } else if event.text == Key.Home {
                if root.sub-current >= 0 { root.sub-current = 0; } else { root.current = 0; }
            } else if event.text == Key.End {
                if root.sub-current >= 0 { root.sub-current = root.subrows.length - 1; } else { root.current = root.rows.length - 1; }
            } else if (event.text == Key.Return || event.text == " ") && root.sub-current >= 0 {
                root.pick(root.subrows[root.sub-current]);
            } else if (event.text == Key.Return || event.text == " " || (event.text == (root.flip ? Key.LeftArrow : Key.RightArrow))) && root.current >= 0 && root.sub-current < 0 {
                if root.has-submenu(root.current) {
                    root.open-submenu(root.current);
                    root.sub-current = 0;
                } else if event.text == Key.Return || event.text == " " {
                    root.pick(root.rows[root.current]);
                } else {
                    return reject;
                }
            } else if root.sub-open && (event.text == Key.Escape || event.text == (root.flip ? Key.RightArrow : Key.LeftArrow)) {
                root.sub-open = false;
                root.sub-current = -1;
            } else if event.text == Key.Escape {
                root.close();
            } else {
                return reject;
            }
            return accept;
        }
        main-panel := Rectangle {
            x: root.flip ? root.content-width - root.menu-width : 0px; y: root.lift;
            width: root.menu-width; height: root.main-height;
            background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            clip: true;
            TouchArea { }
            main-flick := Flickable {
            content-height: main.preferred-height;
            main := MenuRows {
                width: root.menu-width;
                rows: root.rows; submenus: root.submenus;
                current: root.sub-current >= 0 ? -1 : root.current;
                holding: root.sub-open ? root.sub-row : -1;
                hovered(index) => {
                    root.current = index;
                    root.sub-current = -1;
                    if root.has-submenu(index) {
                        root.open-submenu(index);
                    } else {
                        root.sub-open = false;
                    }
                }
                clicked(index) => {
                    if root.has-submenu(index) && root.rows[index].click-id == "" {
                        root.open-submenu(index);
                    } else {
                        root.pick(root.rows[index]);
                    }
                }
                lit(index, y, height) => {
                    let before = main-flick.content-y;
                    main-flick.content-y = root.reveal(main-flick.height, main-flick.content-height, main-flick.content-y, y - main-flick.absolute-position.y, height);
                    root.lit-row = index;
                    root.lit-y = max(0px, y + main-flick.content-y - before - main-panel.absolute-position.y - 6px);
                    if root.sub-row == index { root.sub-y = root.lit-y; }
                }
            }
            }
        }
        Rectangle {
            visible: root.sub-open;
            x: root.flip ? root.widest - root.submenu-width : root.menu-width + 4px;
            y: root.lift + root.sub-top;
            width: root.submenu-width; height: root.sub-height;
            background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            clip: true;
            TouchArea { }
            sub-flick := Flickable {
            content-height: sub.preferred-height;
            sub := MenuRows {
                width: root.submenu-width;
                rows: root.subrows; current: root.sub-current;
                hovered(index) => { root.sub-current = index; }
                clicked(index) => { root.pick(root.subrows[index]); }
                lit(index, y, height) => {
                    sub-flick.content-y = root.reveal(sub-flick.height, sub-flick.content-height, sub-flick.content-y, y - sub-flick.absolute-position.y, height);
                }
            }
            }
        }
    }
}

// How loud something sounds, from 0% to `maximum`: a marigold fill up to the
// value. Above 100%, as Discord allows for people, a mark shows 100%, and a
// drag snaps to it nearby. Dragging reports each step through `changed` and the
// last through `committed`; the arrow keys move 5% at a time. Other amounts
// set `shown`, `step` and `full-mark`.
export component VolumeSlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value: 100;
    in property <int> maximum: 200;
    /// The value as the slider says it.
    in property <string> shown: root.value + "%";
    in property <int> step: 5;
    /// Marks 100% and snaps to it.
    in property <bool> full-mark: root.maximum > 100;
    callback changed(int);
    callback committed(int);
    height: column.preferred-height;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.shown;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.move(root.step); }
    accessible-action-decrement => { root.move(-root.step); }
    forward-focus: focus;
    function set(value: int) {
        let clamped = max(0, min(root.maximum, value));
        if clamped != root.value {
            root.value = clamped;
            root.changed(clamped);
        }
    }
    function move(by: int) {
        root.set(root.value + by);
        root.committed(root.value);
    }
    function point(x: length) {
        let value = round(max(0, min(1, x / track.width)) * root.maximum);
        root.set(root.full-mark && abs(value - 100) <= 4 ? 100 : value);
    }
    column := VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text { text: root.label; color: Theme.secondary; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
            Text { text: root.shown; color: Theme.text; font-size: 13px; font-weight: 600; }
        }
        track := Rectangle {
            height: 18px;
            Rectangle { y: (parent.height - self.height) / 2; height: 4px; border-radius: 2px; background: Theme.field; }
            Rectangle {
                x: 0; y: (parent.height - self.height) / 2; width: parent.width * root.value / root.maximum; height: 4px;
                border-radius: 2px; background: Theme.accent;
            }
            if root.full-mark: Rectangle { x: parent.width * 100 / root.maximum - 1px; y: (parent.height - self.height) / 2; width: 2px; height: 10px; background: Theme.secondary; }
            Rectangle {
                x: parent.width * root.value / root.maximum - self.width / 2; y: (parent.height - self.height) / 2;
                width: 14px; height: 14px; border-radius: 7px; background: Theme.text;
                border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
            }
            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        focus.focus();
                        root.point(self.mouse-x);
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.committed(root.value);
                    }
                }
                moved => { if self.pressed { root.point(self.mouse-x); } }
            }
        }
    }
    focus := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.move(-root.step); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.move(root.step); return accept; }
            return reject;
        }
    }
}

// The menu behind a device toggle's caret, as Vesktop's: the device chosen,
// which opens the list of them in place, how loud it is, anything placed
// inside, then a way into the voice settings.
export component QuickDeviceMenu inherits Rectangle {
    /// "Output" or "Input".
    in property <string> kind;
    in property <[string]> devices;
    in property <int> current;
    in property <string> empty;
    in-out property <int> volume: 100;
    callback select(int);
    callback settings;
    callback volume-changed(int);
    callback volume-committed(int);
    property <bool> listing;
    // Five devices before the list scrolls.
    property <length> list-height: root.listing ? min(5, max(1, root.devices.length)) * 32px + 4px : 0px;
    animate list-height { duration: 180ms; easing: ease-out; }
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 6px; spacing: 4px;
        MenuItem {
            text: @tr("{} Device", root.kind); submenu: true;
            subtitle: root.devices.length == 0 ? @tr("None found")
                : root.current >= 0 && root.current < root.devices.length ? root.devices[root.current] : @tr("System default");
            clicked => { root.listing = !root.listing; }
        }
        Rectangle {
            height: root.list-height; clip: true;
            if root.devices.length > 0: ScrollView {
                height: min(5, root.devices.length) * 32px;
                VerticalLayout {
                    for device[index] in root.devices: MenuItem {
                        text: device; checked: index == root.current;
                        clicked => { root.select(index); root.listing = false; }
                    }
                }
            }
            if root.devices.length == 0: HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                Label { text: root.empty; }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px;
            VolumeSlider {
                label: @tr("{} Volume", root.kind); value <=> root.volume;
                changed(value) => { root.volume-changed(value); }
                committed(value) => { root.volume-committed(value); }
            }
        }
        @children
        Rectangle { height: 1px; background: Theme.line; }
        MenuItem { text: @tr("Voice Settings"); icon: @image-url("icons/settings.svg"); clicked => { root.settings(); } }
    }
}

// A header control with an icon and a short text that opens or closes a panel.
export component HeaderToggle inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> open;
    callback clicked;
    width: content.preferred-width; height: 32px;
    border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.open || pointer.has-hover ? Theme.text : Theme.muted;
    content := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px;
        Image { source: root.icon; width: 18px; image-fit: contain; colorize: root.ink; }
        Text { text: root.text; color: root.ink; font-size: 14px; font-weight: 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = 2;
                    Tip.x = root.absolute-position.x + root.width / 2;
                    Tip.y = root.absolute-position.y + root.height;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

// A dismissible message that applies to the whole window, such as a renderer fallback.
export component Banner inherits Rectangle {
    in-out property <string> text;
    callback dismissed;
    min-height: banner-content.preferred-height; vertical-stretch: 0; background: Theme.raised;
    banner-content := HorizontalLayout {
        padding-left: 16px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Image { source: @image-url("icons/triangle-alert.svg"); width: 18px; image-fit: contain; colorize: Theme.accent; }
        Text { text: root.text; color: Theme.text; font-size: 15px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        Middle { ActionButton { text: @tr("Dismiss"); ghost: true; small: true; clicked => { root.dismissed(); } } }
    }
}

// How loud something sounds, from 0% to 100%, on an upright track filled
// from the bottom, as Discord's desktop voice message player has it. Up and
// Down move 5% at a time, Page Up and Page Down 20%.
export component UprightVolumeSlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value: 100;
    callback changed(int);
    width: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.set(root.value + 5); }
    accessible-action-decrement => { root.set(root.value - 5); }
    forward-focus: focus;
    function set(value: int) {
        let clamped = max(0, min(100, value));
        if clamped != root.value {
            root.value = clamped;
            root.changed(clamped);
        }
    }
    function point(y: length) {
        root.set(round((1 - max(0, min(1, (y - track.y) / track.height))) * 100));
    }
    track := Rectangle {
        x: (parent.width - self.width) / 2; y: 8px; width: 4px; height: parent.height - 16px;
        border-radius: 2px; background: Theme.field;
        Rectangle {
            y: parent.height * (1 - root.value / 100); height: parent.height * root.value / 100;
            border-radius: 2px; background: Theme.accent;
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2; y: track.y + track.height * (1 - root.value / 100) - self.height / 2;
        width: 14px; height: 14px; border-radius: 7px; background: Theme.text;
        border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.set(root.value + 5); return accept; }
            if event.text == Key.DownArrow { root.set(root.value - 5); return accept; }
            if event.text == Key.PageUp { root.set(root.value + 20); return accept; }
            if event.text == Key.PageDown { root.set(root.value - 20); return accept; }
            return reject;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    focus.focus();
                    root.point(self.mouse-y);
                }
            }
            moved => { if self.pressed { root.point(self.mouse-y); } }
        }
    }
}

// The Discord voice gate's sensitivity, in dBFS from -80 to 0, over the
// microphone's level as the gate hears it: green up to -18 dBFS, orange to -6,
// red above. A handle marks the sensitivity. Dragging reports each step through
// `changed` and the last through `committed`; the arrow keys move 1 dB.
export component SensitivitySlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value: -60;
    /// dBFS; below -80 shows nothing.
    in property <float> level: -100;
    /// The gate is open: the microphone would be sent.
    in property <bool> sending;
    callback changed(int);
    callback committed(int);
    // Where a level in dBFS falls along the track, from 0 to 1.
    function at(decibels: float) -> float { return max(0, min(1, (decibels + 80) / 80)); }
    height: column.preferred-height;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: @tr("{} dB", root.value);
    accessible-value-minimum: -80;
    accessible-value-maximum: 0;
    accessible-value-step: 1;
    accessible-action-increment => { root.step(1); }
    accessible-action-decrement => { root.step(-1); }
    forward-focus: focus;
    function set(value: int) {
        let clamped = max(-80, min(0, value));
        if clamped != root.value {
            root.value = clamped;
            root.changed(clamped);
        }
    }
    function step(by: int) {
        root.set(root.value + by);
        root.committed(root.value);
    }
    function point(x: length) {
        root.set(round(max(0, min(1, x / track.width)) * 80) - 80);
    }
    column := VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: root.label; color: Theme.secondary; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
            Text { text: root.sending ? @tr("Sending") : @tr("Not sending"); color: root.sending ? Theme.live : Theme.muted; font-size: 13px; font-weight: 600; }
            Text { text: @tr("{} dB", root.value); color: Theme.text; font-size: 13px; font-weight: 600; }
        }
        track := Rectangle {
            height: 18px;
            property <float> level: root.at(root.level);
            property <float> orange: root.at(-18);
            property <float> red: root.at(-6);
            Rectangle {
                y: (parent.height - self.height) / 2; height: 8px; border-radius: 4px; background: Theme.field; clip: true;
                Rectangle { x: 0; width: parent.width * min(track.level, track.orange); background: Theme.live; }
                Rectangle {
                    x: parent.width * track.orange; width: parent.width * max(0, min(track.level, track.red) - track.orange);
                    background: Theme.loud;
                }
                Rectangle { x: parent.width * track.red; width: parent.width * max(0, track.level - track.red); background: Theme.danger; }
            }
            Rectangle {
                x: parent.width * root.at(root.value) - self.width / 2; y: (parent.height - self.height) / 2;
                width: 14px; height: 14px; border-radius: 7px; background: Theme.text;
                border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        focus.focus();
                        root.point(self.mouse-x);
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.committed(root.value);
                    }
                }
                moved => { if self.pressed { root.point(self.mouse-x); } }
            }
        }
    }
    focus := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.step(-1); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.step(1); return accept; }
            return reject;
        }
    }
}

// An icon whose meaning shows on hover, as Discord's signals have it.
export component TipIcon inherits Image {
    in property <string> tip;
    width: 18px; height: 18px;
    accessible-role: image; accessible-label: root.tip;
    TouchArea {
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.tip;
                Tip.side = 0;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = self.absolute-position.y;
            } else if Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }
}
