// A theme's icons and interface sounds (docs/themes.md, "Sounds and icons").
//
// Every stock icon is drawn through `IconPack`, whose properties start as the
// files in ui/icons/; a theme sets the ones it replaces from Rust
// (src/ui/theme_media.rs) and puts the others back. Every icon's colour goes
// through `IconPack.tint`, which is the place's own colour until a theme
// paints an icon another way: only then does it ask Rust, so a theme that
// replaces nothing costs one property read per icon.
export global IconPack {
    /// A theme replaced an icon whose colour isn't the place's own.
    in property <bool> active;
    /// Changes whenever the replaced icons do, so tints are asked again.
    in property <int> revision;
    /// The colour to draw `source` with, where the place would use `stock`:
    /// the stock colour, none (transparent: the SVG's own) or a theme colour.
    pure callback paint(image, brush, int) -> brush;
    public pure function tint(source: image, stock: brush) -> brush {
        root.active ? root.paint(source, stock, root.revision) : stock
    }
    in property <image> arrow-left: @image-url("icons/arrow-left.svg");
    in property <image> arrow-right: @image-url("icons/arrow-right.svg");
    in property <image> at-sign: @image-url("icons/at-sign.svg");
    in property <image> ban: @image-url("icons/ban.svg");
    in property <image> bell: @image-url("icons/bell.svg");
    in property <image> bell-off: @image-url("icons/bell-off.svg");
    in property <image> brush: @image-url("icons/brush.svg");
