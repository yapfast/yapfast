// Interface sounds a theme gives: which events have one, so a control asks
// Rust to play only when it does. Rust plays it only while the window is in
// front and the person isn't in Do Not Disturb, at the theme's own volume.
export global Cue {
    in property <bool> hover;
    in property <bool> press;
    in property <bool> menu;
    in property <bool> popup;
    in property <bool> toggle;
    /// One of the events, by its index in yapfast_core::themes::media::SoundSlot.
    callback play(int);
    public function hovered() { if root.hover { root.play(14); } }
    public function pressed() { if root.press { root.play(15); } }
    public function menu-opened() { if root.menu { root.play(16); } }
    public function menu-closed() { if root.menu { root.play(17); } }
    public function popped(open: bool) { if root.popup { root.play(open ? 18 : 19); } }
    public function toggled(on: bool) { if root.toggle { root.play(on ? 20 : 21); } }
}
